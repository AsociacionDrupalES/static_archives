INSERT INTO `locales_source` VALUES ('6701','','default','Label to use in the exposed items per page form element.','','7.12'),('6702','','default','Exposed items per page options','','7.12'),('6703','','default','Expose Offset','','7.12'),('6704','','default','Offset label','','7.12'),('6705','','default','Label to use in the exposed offset form element.','','7.12'),('6706','','default','Offset must be an number greather or equal than 0.','','none'),('6707','','default','Mini pager, @count item, skip @skip','','none'),('6708','','default','Mini pager, @count items, skip @skip','','none'),('6709','','default','Mini pager, @count item','','none'),('6710','','default','Mini pager, @count items','','7.10'),('6711','','default','All items, skip @skip','','none'),('6712','','default','All items','','7.12'),('6713','','default','@count item, skip @skip','','none'),('6714','','default','@count items, skip @skip','','none'),('6715','','default','@count item','','7.12'),('6716','','default','Group results together','','7.12'),('6717','','default','Authentication module','','7.12'),('6718','','default','In database','','7.12'),('6719','','default','Update preview','','7.12'),('6720','','default','@entity:@bundle','','7.12'),('6721','','default','Is not empty (NOT NULL)','','7.12'),('6722','','default','That view is created for the version @import_version of views, but you only have @api_version','','none'),('6723','','default','Broken/missing handler: @table > @field','','none'),('6724','','default','Display %display has set node/% as path. This will not produce what you want. If you want to have multiple versions of the node view, use panels.','','none'),('6725','','default','@category: @field-name','','none'),('6726','','default','Translate link','','none'),('6727','','default','Provide a simple link to translate the node.','','none'),('6728','','default','Authmap ID','','7.12'),('6729','','default','The Authmap ID.','','7.12'),('6730','','default','Authentication name','',