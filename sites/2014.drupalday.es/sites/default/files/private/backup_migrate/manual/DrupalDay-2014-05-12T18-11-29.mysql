INSERT INTO `locales_source` VALUES ('7175','/dday/?q=node&destination=node','default','View mode: Página de términos de taxonomía','','7.12'),('7176','/index.php','default','Drush bootstrap phase : !function()','','7.12'),('7177','/index.php','default','Successfully logged into Drupal as !name','','7.12'),('7178','/index.php','default','Found command: !command (commandfile=!commandfile)','','7.12'),('7179','/index.php','default','Initializing drush commandfile: !name','','7.12'),('7180','/index.php','default','Downloading project !name to !dir ...','','7.10'),('7181','/index.php','default','Using destination directory !dir','','7.10'),('7182','/index.php','default','Verifying signature for !vcs version control engine.','','7.10'),('7183','/index.php','default','Project !project (!version) downloaded to !dest.','','7.10'),('7184','/index.php','default','Command dispatch complete','','7.12'),('7185','/index.php','default','Peak memory usage was !peak','','7.12'),('7186','/index.php','default','Install location !location already exists. Do you want to overwrite it?','','7.10'),('7187','/index.php','default','Skip installation of !project to !dest.','','7.10'),('7188','/index.php','default','Project !project contains a !type named !found.','','7.10'),('7189','/index.php','default','The following extensions will be enabled: !extensions','','7.10'),('7190','/index.php','default','Do you really want to continue?','','7.12'),('7191','/index.php','default','Storage for the css array','','7.12'),('7192','/index.php','default','Table storing images.','','7.12'),('7193','/index.php','default','Table storing selector definitions.','','7.12'),('7194','/index.php','default','Table storing property definitions.','','7.12'),('7195','/index.php','default','Table storing type definitions.','','7.12'),('7196','/index.php','default','Administer Google Analytics','','7.12'),('7197','/index.php','default','Perform maintenance tasks for Google Analytics.','','7.12'),('7198','/index.php','