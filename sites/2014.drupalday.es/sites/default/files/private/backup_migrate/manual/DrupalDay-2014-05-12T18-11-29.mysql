DROP TABLE IF EXISTS `field_revision_field_body_teaser`;
CREATE TABLE `field_revision_field_body_teaser` (   `entity_type` varchar(128) NOT NULL DEFAULT '' COMMENT 'The entity type this data is attached to',   `bundle` varchar(128) NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned NOT NULL COMMENT 'The entity revision id this data is attached to',   `language` varchar(32) NOT NULL DEFAULT '' COMMENT 'The language for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `field_body_teaser_value` longtext,   `field_body_teaser_format` varchar(255) DEFAULT NULL,   PRIMARY KEY (`entity_type`,`entity_id`,`revision_id`,`deleted`,`delta`,`language`),   KEY `entity_type` (`entity_type`),   KEY `bundle` (`bundle`),   KEY `deleted` (`deleted`),   KEY `entity_id` (`entity_id`),   KEY `revision_id` (`revision_id`),   KEY `language` (`language`),   KEY `field_body_teaser_format` (`field_body_teaser_format`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Revision archive storage for field 25 (field_body_teaser)';
INSERT INTO `field_revision_field_body_teaser` VALUES ('node','noticia','0','51','155','und','0','Nos vamos acercando al Drupal Day 2013, que se celebrará en Santander el día 20 de Julio. Un evento diseñado para que los drupaleros disfruten de su pasión y compartan una jornada especial de aprendizaje y diversión.',null),('node','noticia','0','53','177','und','0','Están disponibles para los asistentes descuentos para todos los tipos de trayectos de tren en los días cercanos al Drupal Day. Para disponer del cupón de descuento tan solo debes inscribirte y recibirás instrucciones en el email para usarlo.',null),('node','noticia','0','56','188','und','0','El viernes se realizará una visita guiada al CPD del Instituto de Física de Cantabria, en el que se podrá ver el supercomputador Altamira perteneciente a la red española de supercomputación.',null),('node','noticia','0','58','210','und','0','A parte de las sesiones y talleres de las que podremos disfrutar durante el sábado, también podremos participar en el sprint que se llevará a cabo durante todo el día. Si ya conoces algo de Drupal 8 o quieres introducirte en esta nueva versión la mejor manera de hacerlo es participar en el sprint: no solo aprenderás, si no que además contribuirás a hacer este CMS mejor.',null),('node','noticia','0','64','223','und','0','Ya tenemos las camisetas oficiales del evento preparadas. Estarán a la venta durante todo el día.\r\nPrecio especial: 15€.',null),('node','noticia','0','67','230','und','0','El 21 de julio se realizará un paseo para los asistentes al Drupal Day. Los asistentes que se encuentren el domingo en Santander, podrán disfrutar de un paseo por la Península de la Magdalena, sin duda una de las visitas obligadas para cualquier visitante a Santander.',null),('node','noticia','0','70','236','und','0','Así de bien quedan las camisetas del Drupal Day Santander. Recordamos que se pueden adquirir durante todo el sábado en la recepción.',null);
