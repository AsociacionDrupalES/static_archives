INSERT INTO `locales_target` VALUES ('12046','Necesita revisión','es','0','0','0'),('12047','Un módulo llamado @name ya existe en su sitio. Por favor escoja un nombre diferente.','es','0','0','0'),('12048','Editar componentes','es','0','0','0'),('12049','Todo los componentes de este tipo son exportados por otras funcionalidades o módulos.','es','0','0','0'),('12050','Requerido por: !dependents','es','0','0','0'),('12051','Empieza con','es','0','0','0'),('12052','El feature !module no puede ser habilitado porque tiene dependencias sin cumplir.','es','0','0','0'),('12053','@module no parece incluir el archivo @include.','es','0','0','0'),('12054','El archivo @filename ha sido descontinuado y puede ser removido.','es','0','0','0'),('12055','Existe conflicto con otro feature','es','0','0','0'),('12056','Ejemplos: 7.x-1.0, 7.x-1.0-beta1','es','0','0','0'),('12057','Crear Feature','es','0','0','0'),('12065','Extensión para exportar datos de vistas en distintos formatos de archivo.','es','0','0','0'),('12066','Hacer seguimiento de las exportaciones en ejecución.','es','0','0','0'),('12067','Exportación de datos','es','0','0','0'),('12068','Exporta los resultados de la vista a un archivo. Puede manejar conjuntos muy grandes de resultados.','es','0','0','0'),('12069','Archivo CSV','es','0','0','0'),('12070','Muestra la vista como una lista separada por comas.','es','0','0','0'),('12071','Archivo DOC','es','0','0','0'),('12072','Presentar la vista como documento DOC.','es','0','0','0'),('12073','Archivo TXT','es','0','0','0'),('12074','Presentar la vista como un documento TXT.','es','0','0','0'),('12075','Archivo XLS','es','0','0','0'),('12076','Mostrar la vista como un archivo xls.','es','0','0','0'),('12077','Archivo XML','es','0','0','0'),('12078','Convertir la primera fila en una lista de encabezados de columna.','es','0','0','0'),('12079','Proporcionar como archivo','es','0','0','0'),('12080','Si lo deselecciona, el archivo XML se proporcionará  como un canal RSS en lugar de como un archivo descargable.','es','0','0','0'),('12081','Adjuntar texto','es','0','0','0'),('12082','Este texto se usa al construir el enlace del canal. Es el texto "alt" predeterminado para la imagen del canal.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12083','Ordenación superior','es','0','0','0'),('12084','Intentar aplicar un parámetro de ordenación adicional de la presentación adjunta como tabla de ordenación del canal exportado','es','0','0','0'),('12085','Recortar espacios en blanco de los campos representados. Puede ser útil para algunos temas en los que la salida produzca líneas extra.','es','0','0','0'),('12086','Guión','es','0','0','0'),('12087','Exportación de datos de vistas','es','0','0','0'),('12088','Exportación por lotes','es','0','0','0'),('12089','Exportar los datos en pequeños segmentos para construir una exportación completa. Recomendado para exportaciones de gran tamaño (>1.000 filas)','es','0','0','0'),('12090','Exportar todos los datos en un único segmento. Posibles errores de límite de tiempo y memoria.','es','0','0','0'),('12091','Construyendo exportación','es','0','0','0'),('12092','La exportación está comenzando.','es','0','0','0'),('12093','@percentage% de la exportación terminado.','es','0','0','0'),('12094','La exportación ha encontrado un error.','es','0','0','0'),('12095','Aquí se mostrarán un máximo de 20 elementos, al exportar se mostrarán todos los resultados.','es','0','0','0'),('12096','No se pudo crear el archivo temporal de salida para la exportación de resultados (@file). Compruebe los permisos.','es','0','0','0'),('12097','No se pudo escribir en el archivo temporal de salida para la exportación de resultados (@file). Compruebe los permisos.','es','0','0','0'),('12098','Exportación abortada','es','0','0','0'),('12099','Tiempo restante: alrededor de @interval.','es','0','0','0'),('12100','Separador utilizado para separar campos. CSV implica campos separados por comas, así que no debería cambiarlo a menos que tenga necesidades específicas.','es','0','0','0'),('12101','Entrecomillar valores. Útil para salidas que puedan contener su separador como parte de alguno de los valores.','es','0','0','0'),('12102','Transformar espacios','es','0','0','0'),('12103','Tipo de transformación','es','0','0','0'),('12104','camelCase','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12105','PascalCase','es','0','0','0'),('12106','Datos exportados correctamente','es','0','0','0'),('12107','Se ha creado su exportación. Vea/descarge el archivo <a href="@link">aquí</a> (se descargará automáticamente en 3 segundos).','es','0','0','0'),('12108','Volver a la página anterior','es','0','0','0'),('12109','No se pudo crear el directorio temporal para la exportación de resultados (@file). Compruebe los permisos.','es','0','0','0'),('12110','Transformar espacios a XML válido en las etiquetas de campo (los espacios crean marcado XML no válido). Tenga en cuenta que los caracteres XML no válidos se convertirán siempre.','es','0','0','0'),('12111','El nombre de archivo que se sugerirá al explorador para fines de descarga. Puede incluir patrones de reemplazo de la lista siguiente.','es','0','0','0'),('12112','<p>Para esta presentación dispone de los siguientes patrones de sustitución. Use el patrón de la izquierda para mostrar el valor indicado a la derecha.</p>','es','0','0','0'),('12113','valor de @argument','es','0','0','0'),('12114','filtros efectivos expuestos, como <em>filter1_foo-filter2_bar</em>','es','0','0','0'),('12115','(Advertencia: incomplatible)','es','0','0','0'),('12116','La base de datos subyacente  (!db_driver) no es compatible con la opción de exportación por lotes y se ha desactivado.','es','0','0','0'),('12129','-- Seleccione un Perfil de Configuración --','es','0','0','0'),('12130','Usted puede cargar un perfil. Los cambios que se presentan a continuación se perderán.','es','0','0','0'),('12131','Cargar opciones','es','0','0','0'),('12132','Cargar perfil','es','0','0','0'),('12133','Ver como casillas de selección','es','0','0','0'),('12134','Archivo de copia de seguridad','es','0','0','0'),('12135','Nombre del archivo de copia de seguridad','es','0','0','0'),('12136','Puede utilizar reemplazos en el nombre del archivo.','es','0','0','0'),('12137','Agregar un sello temporal','es','0','0','0'),('12138','Formato del sello temporal','es','0','0','0'),('12139','Debe ser una cadena de formato  <a href="!url">date()</a> de PHP.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12140','Puede omitir tablas específicas, o los datos de tablas específicas en el archivo de copia de seguridad. Omita únicamente datos que sepa que no necesitará, como datos de caché, o tablas de otras aplicaciones. Excluir tablas puede romper su instalación de Drupal, por tanto <strong>no cambie estas opciones a menos que sepa lo que está haciendo</strong>.','es','0','0','0'),('12141','Excluir las siguientes tablas por completo','es','0','0','0'),('12142','Las tablas seleccionadas no se añadirán al archivo de copia de seguridad.','es','0','0','0'),('12143','Excluir los datos de las tablas siguientes','es','0','0','0'),('12144','Las tablas seleccionadas tendrán una copia de seguridad de su estructura, pero no su contenido. Esto es útil para excluir los datos en caché para reducir el tamaño del archivo.','es','0','0','0'),('12145','Bloquear tablas durante el copiado','es','0','0','0'),('12146','Esto puede ayudar a reducir la corrupción de datos, pero hará que su sitio no responda.','es','0','0','0'),('12147','!name opciones de copia de seguridad','es','0','0','0'),('12148','Compresión','es','0','0','0'),('12149','Sin cifrado','es','0','0','0'),('12150','Cifrado de archivo','es','0','0','0'),('12151','Módulo de cifrado AES','es','0','0','0'),('12152','Instale el !link para habilitar el cifrado del archivo de la copia de seguridad.','es','0','0','0'),('12153','Enviar un correo electrónico si la copia tiene éxito','es','0','0','0'),('12154','Dirección de correo electrónico para notificaciones de éxito','es','0','0','0'),('12155','Enviar correo electrónico si la copia de seguridad falla','es','0','0','0'),('12156','Dirección de correo electrónico para notificaciones de error','es','0','0','0'),('12157','Pone el sitio fuera de línea durante la copia de seguridad y muestra un mensaje de mantenimiento. El sitio volverá a estar en línea una vez que la copia de seguridad se complete.','es','0','0','0'),('12158','Destino de la copia de seguridad','es','0','0','0'),('12159','Seleccione donde se guardará el archivo de copia de seguridad. Estos contienen datos sensibles, así que tenga cuidado donde serán guardados. Seleccione ''Descargar'' para descargar el archivo a su escritorio.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12160','Crear un nuevo destino','es','0','0','0'),('12161','Guardar esta configuración.','es','0','0','0'),('12162','Guardar la configuración como','es','0','0','0'),('12163','Reemplazar el perfil ''%profile''','es','0','0','0'),('12164','Crear un nuevo perfil','es','0','0','0'),('12165','Nombre del perfil','es','0','0','0'),('12166','Este será el nombre del nuevo perfil si selecciona ''Crear nuevo perfil'' de otro modo se convertirá en el nombre del perfil ''%profile''.','es','0','0','0'),('12167','Guardar sin realizar copia de seguridad','es','0','0','0'),('12171','Sustituto','es','0','0','0'),('12181','Relaciona cada @entity con un @field del fichero','es','0','0','0'),('12524','Las traducciones editadas se mantienen, sólo se sobreescriben las importadas previamente y las nuevas traducciones.','es','0','0','0'),('12525','Todas las traducciones existentes se mantienen, sólo se añaden las nuevas traducciones.','es','0','0','0'),('12526','@language: @version (!date)','es','0','0','0'),('12527','Disponible una traducción no instalada','es','0','0','0'),('12528','@language: <em>Traducción no instalada</em>','es','0','0','0'),('12529','Versión recomendada: @version (!date)','es','0','0','0'),('12531','Información obtenida del servidor sobre actualizaciones disponibles','es','0','0','0'),('12532','Campo de dirección de ejemplo','es','0','0','0'),('12533','Crear !type','es','0','0','0'),('12534','Esquema','es','0','0','0'),('12535','Dirección de correo electrónico','es','0','0','0'),('12536','Configuración avanzada','es','0','0','0'),('12537','Frecuencia','es','0','0','0'),('12538','Semanas','es','0','0','0'),('12539','Días','es','0','0','0'),('12540','Horas','es','0','0','0'),('12541','Segundos','es','0','0','0'),('12542','Última ejecución','es','0','0','0'),('12543','¿Seguro?','es','0','0','0'),('12544','Conservar','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12545','Nombre de destino','es','0','0','0'),('12546','Minutos','es','0','0','0'),('12547','Una vez cada hora','es','0','0','0'),('12548','Una vez al día','es','0','0','0'),('12549','Nombre del perfil','es','0','0','0'),('12550','hacer copia cada','es','0','0','0'),('12551','Cantidad de archivos de copia que se deben conservar','es','0','0','0'),('12552','No se puede abrir el archivo %file para restaurar la base de datos','es','0','0','0'),('12553','Aviso de seguridad: Backup and Migrate no pudo escribir un archivo de texto de prueba en el directorio de destino %directory, y por lo tanto no puede comprobar la seguridad del destino de la copia de seguridad. La copia de seguridad del servidor se desactivará hasta que el destino sea seguro y pueda ser escrito.','es','0','0','0'),('12554','Aviso de seguridad: Backup and Migrate no guardará los archivos de copia de seguridad en el servidor porque el directorio de destino es de acceso público. Si desea guardar los archivos en el servidor, por favor asegure el directorio %directory','es','0','0','0'),('12555','Ruta del directorio','es','0','0','0'),('12556','Editar !type','es','0','0','0'),('12557','Guardar !type','es','0','0','0'),('12558','Eliminar !type','es','0','0','0'),('12559','Contenido exportado','es','0','0','0'),('12560','¿Está seguro que desea eliminar este !type?','es','0','0','0'),('12561','Exportar !type','es','0','0','0'),('12562','El tipo de base de datos. Drupal sólo soporta un tipo de base de datos a la vez, por lo que este debe ser el mismo que el tipo de base de datos actual.','es','0','0','0'),('12563','El nombre de la base de datos. La base de datos debe existir, no será creada para usted.','es','0','0','0'),('12564','Ingrese el nombre del usuario que tiene acceso de escritura a la base de datos.','es','0','0','0'),('12565','El nombre de la base de datos no es válido.','es','0','0','0'),('12566','%num comandos SQL ejecutados.','es','0','0','0'),('12567','Ingrese la dirección de correo electrónico donde enviar las copias de seguridad. Asegurese que el servidor de correo electrónico sea capaz de manejar archivos adjuntos','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12568','Copia de seguridad !file de !site','es','0','0','0'),('12569','Copia de seguridad adjuntada','es','0','0','0'),('12570','Ingrese la ruta al directorio donde guardará las copias de seguridad. Use rutas relativas a la ruta raíz de Drupal. El servidor debe poder escribir en dicha ruta.','es','0','0','0'),('12571','Cambiar propiedades del archivo (chmod)','es','0','0','0'),('12572','Si ingresa un valor aquí, las copias de seguridad serán cambiadas mediante chmod al modo que especifique. Especifique el modo en forma octal (p. ej. 644 o 0644) o déjelo en blanco para desactivar esta característica.','es','0','0','0'),('12573','Cambiar el grupo del archivo (chgrp)','es','0','0','0'),('12574','Si ingresa un valor aquí, las copias de seguridad serán cambiadas mediante chgrp al grupo que especifique. Déjelo en blanco para desactivar esta característica.','es','0','0','0'),('12575','Debe ingresar un valor válido octal para chmod (p. ej. 644 o 0644) en el campo de cambio de modo, o dejarlo en blanco.','es','0','0','0'),('12576','No hay archivos de copia de seguridad que mostrar.','es','0','0','0'),('12577','Seleccionar la base de datos a restaurar. Cualquier base de datos creada en los Destinos o especificada en settings.php puede ser restaurada.','es','0','0','0'),('12578','¿Está seguro que desea restaurar el archivo de copia de seguridad?','es','0','0','0'),('12579','¿Está seguro que desea restaurar la base de datos desde el archivo de copia de seguridad %file_id? Esto eliminará alguno o todos sus datos y no puede deshacerse. <strong>¡Siempre pruebe sus copias de seguridad en un server que no esté en producción!</strong>','es','0','0','0'),('12580','¿Está seguro que desea eliminar el archivo de copia de seguridad?','es','0','0','0'),('12581','¿Está seguro que desea eliminar el archivo de copia de seguridad %file_id? <strong>Esta acción no puede deshacerse.</strong>','es','0','0','0'),('12582','Seleccionar la base de datos a guardar. Cualquier base de datos creada en los Destinos o especificada en settings.php puede ser guardada.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12583','destinos','es','0','0','0'),('12584','destino','es','0','0','0'),('12585','Agregar un nuevo @s de destino.','es','0','0','0'),('12586','Elija el tipo de destino que desea crear:','es','0','0','0'),('12587','No hay tipos de destino disponibles.','es','0','0','0'),('12588','¿Está seguro que desea eliminar el destino %name? <strong>Las copias de seguridad existentes en el destino no serán eliminadas.</strong>','es','0','0','0'),('12589',' No es necesario que ingrese una contraseña a menos que desee cambiar la contraseña actualmente guardada.','es','0','0','0'),('12590','Cifrado de archivo (EXPERIMENTAL)','es','0','0','0'),('12591','Los archivos encriptados sólo pueden ser restaurados por Backup and Migrate y sólo en sitios con la misma clave de encriptación. <strong>Esta funcionalidad es experimental, y sólo debería utilizarse para pruebas.</strong>','es','0','0','0'),('12592','Cifrado AES','es','0','0','0'),('12593','La copia de seguridad de !site tuvo éxito','es','0','0','0'),('12594','La copia de seguridad ha sido realizada con éxito, reportando lo siguiente:\r\n!messages','es','0','0','0'),('12595','La copia de seguridad ha sido realizada con éxito.\n','es','0','0','0'),('12596','La copia de seguridad de !site falló','es','0','0','0'),('12597','La copia de seguridad ha fallado, reportando lo siguiente:\r\n!messages','es','0','0','0'),('12598','La copia de seguridad ha fallado por motivos desconocidos.','es','0','0','0'),('12599','Desactivar el registro de consultas query','es','0','0','0'),('12600','Desactive el registro de consultas query del módulo de desarrollo durante la operación de copia de seguridad. Este será activado nuevamente cuando se haya completado la copia de seguridad. Esto es altamente recomendable.','es','0','0','0'),('12601','Desactive el registro de consultas query del módulo de desarrollo durante la operación de restauración. Este será activado nuevamente cuando se haya restaurado la copia de seguridad. Esto es altamente recomendable..','es','0','0','0'),('12602','perfiles','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12603','¿Está seguro que desea eliminar el perfil %name? Cualquier tarea programada que utilice este perfil será deshabilitada.','es','0','0','0'),('12604','No hay tablas excluidas','es','0','0','0'),('12605','Sin omitir datos','es','0','0','0'),('12606','Nombre de la tarea programada','es','0','0','0'),('12607','-- No disponible --','es','0','0','0'),('12608','El número de archivos de copia de seguridad a mantener antes de borrar los archivos antiguos. Use 0 para no borrar copias. <strong>Otros archivos en el directorio de destino serán borrados si usted especifica un límite.</strong>','es','0','0','0'),('12609','Seleccione donde se guardará el archivo de copia de seguridad. Los archivos de copia de seguridad contienen datos sensibles, así que tenga cuidado donde guardarlos.','es','0','0','0'),('12610','El período de copia de seguridad debe ser un número mayor que 0.','es','0','0','0'),('12611','Número a mantener debe ser un entero mayor o igual a 0.','es','0','0','0'),('12612','Una vez por segundo','es','0','0','0'),('12613','Cada @count segundos','es','0','0','0'),('12614','Cada minuto','es','0','0','0'),('12615','Cada @count minutos','es','0','0','0'),('12616','Cada @count horas','es','0','0','0'),('12617','Cada @count días','es','0','0','0'),('12618','Una vez por semana','es','0','0','0'),('12619','Cada @count semanas','es','0','0','0'),('12620','Usted no tiene permiso para hacer copia de seguridad de este sitio.','es','0','0','0'),('12621','El origen no puede copiarse sobre sí mismo. Por favor, elija un destino diferente para esta copia de seguridad.','es','0','0','0'),('12622','Elija un nombre para la configuración. La configuración se guardará como un perfil y aparecerá en la pestaña de <a href="!url">Perfiles</a>.','es','0','0','0'),('12623','Restaurar a','es','0','0','0'),('12624','<a href="!restoreurl">Restaurar nuevamente</a>','es','0','0','0'),('12625','La configuración de filtros del perfil','es','0','0','0'),('12626','La {backup_migrate_destination}.destination_id del origen de la copia de seguridad a restaurar.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12627','Tarea programada predeterminada','es','0','0','0'),('12628','El origen de la base de datos desde donde se realizará la copia de seguridad.','es','0','0','0'),('12629','No se puede mover el directorio de copias de seguridad a su carpeta privada, por favor verifique los permisos de archivos y mueva el directorio %from a %to','es','0','0','0'),('12630','Subdirectorio','es','0','0','0'),('12631','Debido a políticas almacenamiento de código de drupal.org, la librería S3 library necesaria para usar un destino S3 no es más distribuida con este módulo. Debe descargar la librería desde !link y ubicarla en el directorio includes dentro del directorio del módulo Backup and Migrate.','es','0','0','0'),('12632','Etiqueta del título','es','0','0','0'),('12633','Recuadro','es','0','0','0'),('12634','Principio','es','0','0','0'),('12635','Archivos adjuntos en el formulario de edición del nodo','es','0','0','0'),('12636','Archivos adjuntos en el formulario de edición del nodo.','es','0','0','0'),('12637','Nodo opciones forma de libro','es','0','0','0'),('12638','Términos hermanos','es','0','0','0'),('12639','Si está marcado, los términos se mostrarán en forma de árbol, sino en forma de lista plana.','es','0','0','0'),('12640','Introducir en la configuración del panel','es','0','0','0'),('12641','Añade un padre de libro desde un contexto de nodo.','es','0','0','0'),('12642','Añade un término de taxonomía desde un contexto de nodo; si seleccionan múltiples términos, sólo obtendrá el "primer" término.','es','0','0','0'),('12643','Añade un término padre de taxonomia desde un contexto de término.','es','0','0','0'),('12644','Argumento de simplecontext','es','0','0','0'),('12645','Agregar un relcontext para el contexto simple existente.','es','0','0','0'),('12646','Tipo de búsqueda','es','0','0','0'),('12647','h1','es','0','0','0'),('12648','h2','es','0','0','0'),('12649','h3','es','0','0','0'),('12650','h4','es','0','0','0'),('12651','h5','es','0','0','0'),('12652','h6','es','0','0','0'),('12653','Elemento de menú padre','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12654','¿Está seguro que desea eliminar esta página? Eliminar una página no se puede deshacer.','es','0','0','0'),('12655','El control de acceso por node_type.','es','0','0','0'),('12656','El menú de navegación al que pertenece el nodo del libro.','es','0','0','0'),('12657','Fecha de creación de "@s"','es','0','0','0'),('12658','Los enlaces a nodo van aquí.','es','0','0','0'),('12659','Enlaces de "@s"','es','0','0','0'),('12660','Título de "@s"','es','0','0','0'),('12661','Fecha de última actualización','es','0','0','0'),('12662','La fecha en la que "@s" se actualizó por última vez.','es','0','0','0'),('12663','node_form','es','0','0','0'),('12664','Opciones de publicación del formulario de edición del nodo de "@s"','es','0','0','0'),('12665','Opciones de libro para el nodo de "@s".','es','0','0','0'),('12666','Botones del formulario de edición del nodo.','es','0','0','0'),('12667','Ajustes de comentarios del formulario de edición del nodo "@s"','es','0','0','0'),('12668','Categoría del perfil','es','0','0','0'),('12669','Contenidos de una única categoría de perfil.','es','0','0','0'),('12670','Introduzca el ID de un nodo para este contexto','es','0','0','0'),('12671','''%title'' [id del nodo %nid]','es','0','0','0'),('12672','Introduzca el tipo de nodo de este contexto','es','0','0','0'),('12673','Introduzca el ID de un nodo para este argumento:','es','0','0','0'),('12674','Un contexto que es solo una cadena.','es','0','0','0'),('12675','cadena de primas','es','0','0','0'),('12676','Introduzca la cadena para este contexto.','es','0','0','0'),('12677','Actualment establecido a @term. Introduzca otro término si desea cambiar el término.','es','0','0','0'),('12678','Seleccione un término de @vocabulary.','es','0','0','0'),('12679','Restablecer el identificador al título del término.','es','0','0','0'),('12680','Si se selecciona, el identificador se restablecerá para el nombre del término del término seleccionado.','es','0','0','0'),('12681','Debe seleccionar un término.','es','0','0','0'),('12682','El término seleccionado no es válido','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12683','Múltiples términos de la taxonomía, como un grupo.','es','0','0','0'),('12684','El ID del primer término','es','0','0','0'),('12685','IDs de todos los términos, separados por + o ,','es','0','0','0'),('12686','El nombre del primer término','es','0','0','0'),('12687','Nombre del término de todos los términos, separados por + o ,','es','0','0','0'),('12688','ID del vocabulario del primer término','es','0','0','0'),('12689','Crea el autor de un nodo como un contexto de usuario.','es','0','0','0'),('12690','Confiugura las Vistas para ser utilizadas como contenido CTools.','es','0','0','0'),('12691','Paneles de contenido para Vistas','es','0','0','0'),('12692','Configurar vista','es','0','0','0'),('12693','La vista está rota, perdida o eliminada.','es','0','0','0'),('12694','Información de la vista','es','0','0','0'),('12695','@count artículos que se muestren.','es','0','0','0'),('12696','Saltando los primeros @count resultados','es','0','0','0'),('12697','Con enlace "más"','es','0','0','0'),('12698','Enviar argumentos','es','0','0','0'),('12699','Utilizando url: @url','es','0','0','0'),('12700','Paneles de vista','es','0','0','0'),('12701','Esta es la categoría del panel que aparecerá en uno de los dialogos de contenido agregado.','es','0','0','0'),('12702','Este es el peso de la categoría por defecto. Observe que si el peso de una categoría se define en varios lugares, sólo el primero de los Paneles verá esa definición, por lo que si el peso no parece estar funcionando, compruebe en otros lugares en que el peso podría establecerse.','es','0','0','0'),('12703','Ejemplo CTools relcontext tipo de contenido','es','0','0','0'),('12704','Tipo de contenido relcontext - trabaja con el contexto relcontext.','es','0','0','0'),('12705','Tipo de contenido simplecontext','es','0','0','0'),('12706','Tipo de contenido de contexto simple - trabaja con un contexto simple','es','0','0','0'),('12707','Config articulo 1 para el tipo de contenido de contexto simple','es','0','0','0'),('12708','Contexto de Relcontext para contexto simple','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12709','Un simple "contexto simple" contexto, o un elemento de dato.','es','0','0','0'),('12710','Ingrese algún dato para representar este "contexto simple".','es','0','0','0'),('12711','Configuración para el contexto simple','es','0','0','0'),('12712','Relcontext para contexto simple','es','0','0','0'),('12713','\n    Este es un bloque de datos creados por el tipo de contenido Relcontent.\n   Los datos en el bloque puede ser ensamblado a partir de texto estático (como este) o del tipo\n   de contenido forma la configuración ($ conf) para el tipo de contenido, o desde el contexto\n   que se pasa. <br />\n   En nuestro caso, el formulario de configuración ($ conf) tiene sólo un campo, ''config_item_1;\n   y de que está configurado con:\n    ','es','0','0','0'),('12714','\n    Este es un bloque de datos creados por el tipo de contenido de contexto simple.\n   Los datos en el bloque puede ser ensamblado a partir de texto estático (como este) o del tipo\n   de contenido forma la configuración ($ conf) para el tipo de contenido, o desde el contexto\n   que se pasa. <br />\n   En nuestro caso, el formulario de configuración ($ conf) tiene sólo un campo, ''config_item_1;\n   y de que está configurado con:\n    ','es','0','0','0'),('12715','Graba una entrada en el registro del watchdog cuando se realizan búsquedas','es','0','0','0'),('12716','Ningún resultado de texto','es','0','0','0'),('12717','Mostrar el texto si no se inroducen claves de búsqueda','es','0','0','0'),('12718','Control de acceso por la existencia o no de un contexto y si contiene información.','es','0','0','0'),('12719','Si se selecciona, el identificador se restablecerá al nombre de usuario del usuario.','es','0','0','0'),('12720','CTools necesita ciertas características sólo disponibles en PHP 5.2.0 o superior.','es','0','0','0'),('12721','Opcionalmente restringir los términos de un vocabulario específico, o permitir todos los términos de vocabularios.','es','0','0','0'),('12722','Marque aquí para hacer los términos enlazado hacia las rutas del término.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12723','Primaria y secundaria','es','0','0','0'),('12724','id CSS  para usar','es','0','0','0'),('12725','Multiples términos del nodo','es','0','0','0'),('12726','Añade un formulario de términos de taxonomía desde un contexto de nodo; si múltiples términos son seleccionados, serán concatenados.','es','0','0','0'),('12727','Cuando el valor de este contexto se pasa a una vista como argumento, los términos se pueden concatenar en forma de 1+2+3 (por OR) o 1,2,3 (para AND).','es','0','0','0'),('12728','Falta plugin','es','0','0','0'),('12729','Estilo personalizado','es','0','0','0'),('12730','El ID único para este @export.','es','0','0','0'),('12731','Codigo @plugin','es','0','0','0'),('12732','No se puede obtener una importación desde el código. Los errores registrados: @errors','es','0','0','0'),('12733','La Identificación de exportación sólo puede contener letras en minúsculas, guiones y números.','es','0','0','0'),('12734','Formulario de creación o edición de nodo','es','0','0','0'),('12735','Añade un formulario de edición de nodo desde un contexto de nodo.','es','0','0','0'),('12736','Estilos personalizados pueden ser aplicados al panel de regiones y panel de paneles.','es','0','0','0'),('12737','Actualmente no hay tipos de estilo disponibles para añadir. Debería habilitar un módulo que los utiliza, como Panels.','es','0','0','0'),('12738','Archivo adjunto','es','0','0','0'),('12739','Muestra los adjuntos en un contexto de vista.','es','0','0','0'),('12740','"Antes" de adjuntarlo','es','0','0','0'),('12741','"Despúes" de adjuntarlo','es','0','0','0'),('12742','Usted debe seleccionar al menos un archivo adjunto que se vea.','es','0','0','0'),('12743','Vista del texto vacío','es','0','0','0'),('12744','Mostrar la vista del texto vacío si no hay resultados.','es','0','0','0'),('12745','"@context" texto vacío','es','0','0','0'),('12746','Ver widgets expuestos','es','0','0','0'),('12747','"@context" widgets expuestos','es','0','0','0'),('12748','Menú desplegable','es','0','0','0'),('12749','Pulse para desplegar','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12750','"@s" @field','es','0','0','0'),('12751','Introduzca el título o ID de una entidad @entity','es','0','0','0'),('12752','''%title'' [%type id %id]','es','0','0','0'),('12753','[%type id %id]','es','0','0','0'),('12754','Debe seleccionar una entidad.','es','0','0','0'),('12755','Entidad seleccionada no válida.','es','0','0','0'),('12756','formulario "@s" @field','es','0','0','0'),('12757','@entity (tokens)','es','0','0','0'),('12758','"@s" @name','es','0','0','0'),('12759','@to_entity desde @from_entity (en @base_table.@relationship)','es','0','0','0'),('12760','<p>Para mostrar el nombre de un usuario registrado, utilice este código:</p>\r\n<pre>\r\nglobal $user;\r\nif ($user->uid) {\r\n  print t(''Bienvenido @name! Gracias por visitarnos.'', array(''@name'' => format_username($user)));\r\n}\r\nelse {\r\n  print t(''Bienvenido visitante! Gracias por visitarnos.'');\r\n}\r\n</pre>','es','0','0','0'),('12761','Cualquiera que sea seguro','es','0','0','0'),('12762','Utilidad de Syslog','es','0','0','0'),('12763','Esto se usa solamente cuando se configura el sitio para usar un tema gráfico de administración específico en la página <a href="@appearance-url">Apariencia</a>.','es','0','0','0'),('12764','No se pudo conectar con el servidor. El servidor da el siguiente mensaje: !message Para más ayuda en la instalación o actualización del código en su servidor, consulte el <a href="@handbook_url">Manual</a>.','es','0','0','0'),('12765','El índice de la búsqueda no se limpia, sino que se actualiza sistemáticamente para reflejar los cambios en la configuración. La búsqueda seguirá funcionando, pero el contenido nuevo no se indexará hasta que no se haya vuelto a indexar el contenido existente. Esta acción no se puede deshacer.','es','0','0','0'),('12766','La búsqueda utilizó demasiadas expresiones AND/OR. Sólo las primeros @count términos se incluyeron en esta búsqueda.','es','0','0','0'),('12767','Encontrado campo con nombre @name','es','0','0','0'),('12768','Encontrado campo con nombre @name y valor @value','es','0','0','0');
