INSERT INTO `locales_target` VALUES ('307','Descripción del término.','es','0','0','0'),('308','Descripción de término "@s"','es','0','0','0'),('309','Lista de términos relacionados','es','0','0','0'),('310','Términos de nivel superior','es','0','0','0'),('311','Que términos','es','0','0','0'),('312','Sin ordenar','es','0','0','0'),('313','Ordenado','es','0','0','0'),('314','La imagen de un usuario.','es','0','0','0'),('315','imagen de usuario "@s"','es','0','0','0'),('316','Perfil de usuario','es','0','0','0'),('317','El perfil de un usuario.','es','0','0','0'),('318','perfil de usuario "@s"','es','0','0','0'),('319','Términos de vocabulario','es','0','0','0'),('320','Todos los términos de un vocabulario.','es','0','0','0'),('321','términos "@s"','es','0','0','0'),('322','Profundidad máxima','es','0','0','0'),('323','Definir la profundidad máxima de los términos que se muestran.','es','0','0','0'),('324','Mostrar como árbol','es','0','0','0'),('325','Un objeto nodo.','es','0','0','0'),('326','Establecido actualmente a !link','es','0','0','0'),('327','Seleccionado nodo no válido.','es','0','0','0'),('328','Un formulario de nuevo nodo.','es','0','0','0'),('329','Seleccionar el tipo de nodo para este formulario.','es','0','0','0'),('330','Un formulario de edición de nodo.','es','0','0','0'),('331','Un único objeto de término de taxonomía.','es','0','0','0'),('332','Un único objeto de usuario.','es','0','0','0'),('333','Vocabulario de taxonomía','es','0','0','0'),('334','Un objeto único de vocabulario de taxonomía.','es','0','0','0'),('335','Seleccionar el vocabulario para este formulario.','es','0','0','0'),('336','argumento','es','0','0','0');
INSERT INTO `locales_target` VALUES ('337','Añadir argumento','es','0','0','0'),('338','relación','es','0','0','0'),('339','Añadir relación','es','0','0','0'),('340','Añadir contexto','es','0','0','0'),('341','Contextos necesarios','es','0','0','0'),('342','contexto necesario','es','0','0','0'),('343','Añadir contexto necesario','es','0','0','0'),('344','Cerrar ventana','es','0','0','0'),('345','Cerrar ventana','es','0','0','0'),('346','Añadir @type "@context"','es','0','0','0'),('347','Editar @type "@context"','es','0','0','0'),('348','Escriba un nombre para identificar este !type en las pantallas de administración.','es','0','0','0'),('349','Clave','es','0','0','0'),('350','Escriba una clave que se usará para sustituir en los títulos','es','0','0','0'),('351','Ignorarlo; el contenido que requiera este contexto no estará disponible.','es','0','0','0'),('352','Si falta el argumento o no es válido, seleccione cuál debería ser el comportamiento.','es','0','0','0'),('353','Argumento @count','es','0','0','0'),('354','Contexto @count','es','0','0','0'),('355','Configurar !subtype_title','es','0','0','0'),('356','Opciones de panel','es','0','0','0'),('357','Contexto desconocido','es','0','0','0'),('358','Sin contexto','es','0','0','0'),('359','Puede utilizar %keywords de contextos, así como %title para el título original.','es','0','0','0'),('360','Contexto %count','es','0','0','0'),('361','Nombre del módulo','es','0','0','0'),('362','Indique el nombre del módulo al que se va a exportar el código.','es','0','0','0'),('363','Local','es','0','0','0'),('364','Panel','es','0','0','0'),('365','Añadir un nodo de su sitio como contenido.','es','0','0','0'),('366','Para utilizar un NID de la URL, puede utilizar %0, %1, ..., %N para obtener los argumentos de la URL. O utilice @0, @1, ..., @N para utilizar argumentos pasados al panel.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('367','Mantener el título del nodo','es','0','0','0'),('368','Avanzado: si está marcado, no toque el título del nodo; esto puede provocar que el título del nodo aparezca dos veces a menos de que su tema se ocupe de ello.','es','0','0','0'),('369','Nodo no válido','es','0','0','0'),('370','Nodo cargado desde @var','es','0','0','0'),('371','Nodo eliminado/ausente @nid','es','0','0','0'),('372','La ruta es necesaria.','es','0','0','0'),('373','Comodín de argumento','es','0','0','0'),('374','Sin argumento','es','0','0','0'),('375','Del contexto','es','0','0','0'),('376','Del argumento de panel','es','0','0','0'),('377','Contexto necesario','es','0','0','0'),('378','Argumento de panel','es','0','0','0'),('379','Sexto','es','0','0','0'),('380','Argumento fijo','es','0','0','0'),('381','Usar paginador','es','0','0','0'),('382','Desplazamiento','es','0','0','0'),('383','Vínculo a vista','es','0','0','0'),('384','Enlace ''más...''','es','0','0','0'),('385','Enlazar título con la vista','es','0','0','0'),('386','Proporciona un enlace "más" que enlaza con la vista','es','0','0','0'),('387','Éste es independiente de cualquier otro enlace que presente la vista misma; si puede ver dos enlaces "más", desmarque esta opción. Las vistas sólo proveen un enlace "más" si está usando el tipo "bloque", sin embargo, si usa algún otro, utilice éste.','es','0','0','0'),('388','Mostrar íconos de canal de noticias','es','0','0','0'),('389','Número de envíos','es','0','0','0'),('390','Enviar argumentos','es','0','0','0'),('391','Vista @view perdida o eliminada','es','0','0','0'),('392','Libro padre','es','0','0','0'),('393','Padre inmediato','es','0','0','0'),('394','Nivel superior del libro','es','0','0','0'),('395','Término del nodo','es','0','0','0'),('396','Término padre','es','0','0','0');
