INSERT INTO `locales_source` VALUES ('6279','','default','User posted or commented','','7.12'),('6280','','default','Display nodes only if a user posted the node or commented on the node.','','7.12'),('6281','','default','Display the comment with standard comment view.','','7.12'),('6282','','default','Display the comment as RSS.','','7.12'),('6283','','default','Link to contact page','','7.12'),('6284','','default','Provide a simple link to the user contact page.','','7.12'),('6285','','default','Locale source','','7.12'),('6286','','default','A source string for translation, in English or the default site language.','','7.12'),('6287','','default','LID','','7.12'),('6288','','default','The ID of the source string.','','7.12'),('6289','','default','A description of the location or context of the string.','','7.12'),('6290','','default','The group the translation is in.','','7.12'),('6291','','default','The full original string.','','7.12'),('6292','','default','The version of Drupal core that this string is for.','','7.12'),('6293','','default','Provide a simple link to edit the translations.','','7.12'),('6294','','default','Locale target','','7.12'),('6295','','default','The full translation string.','','7.12'),('6296','','default','The language this translation is in.','','7.12'),('6297','','default','Singular LID','','7.12'),('6298','','default','The ID of the parent translation.','','7.12'),('6299','','default','Whether or not the translation is plural.','','7.12'),('6300','','default','Published or admin','','7.12'),('6301','','default','Created year + month','','7.12'),('6302','','default','Created year','','7.12'),('6303','','default','Created month','','7.12'),('6304','','default','Created day','','7.12'),('6305','','default','Created week','','7.12'),('6306','','default','Updated year + month','','7.12'),('6307','','default','Updated year','','7.12'),('6308','','default','Updated month','','7.12');
INSERT INTO `locales_source` VALUES ('6309','','default','Updated day','','7.12'),('6310','','default','Updated week','','7.12'),('6311','','default','Vid','','7.12'),('6312','','default','The log message entered when the revision was created.','','7.12'),('6313','','default','Revert link','','7.12'),('6314','','default','Provide a simple link to revert to the revision.','','7.12'),('6315','','default','Filter by access.','','7.12'),('6316','','default','Has new content','','7.12'),('6317','','default','Display %display has no access control but does not contain a filter for published nodes.','','none'),('6318','','default','Whether the poll is open for voting.','','none'),('6319','','default','Profile textfield','','none'),('6320','','default','Profile textarea','','none'),('6321','','default','Profile checkbox','','none'),('6322','','default','Profile URL','','none'),('6323','','default','Profile selection','','none'),('6324','','default','Profile freeform list %field-name.','','none'),('6325','','default','Profile date %field-name.','','none'),('6326','','default','The score of the search item. This will not be used if the search filter is not also present.','','7.12'),('6327','','default','Links from','','7.12'),('6328','','default','Other nodes that are linked from the node.','','7.12'),('6329','','default','Links to','','7.12'),('6330','','default','Other nodes that link to the node.','','7.12'),('6331','','default','Search Terms','','7.12'),('6332','','default','The terms to search for.','','7.12'),('6333','','default','Display the results with standard search view.','','none'),('6334','','default','Total views','','none'),('6335','','default','The total number of times the node has been viewed.','','none'),('6336','','default','The total number of times the node has been viewed today.','','none'),('6337','','default','Most recent view','','none'),('6338','','default','The most recent time the node has been viewed.','','none');
INSERT INTO `locales_source` VALUES ('6339','','default','Stores site access information.','','none'),('6340','','default','Browser session ID of user that visited page.','','none'),('6341','','default','Title of page visited.','','none'),('6342','','default','Internal path to page visited (relative to Drupal root.)','','none'),('6343','','default','Referrer URI.','','none'),('6344','','default','Hostname of user that visited the page.','','none'),('6345','','default','The user who visited the site.','','none'),('6346','','default','Time in milliseconds that the page took to load.','','none'),('6347','','default','Timestamp of when the page was visited.','','none'),('6348','','default','Files maintained by Drupal and various modules.','','7.12'),('6349','','default','The ID of the file.','','7.12'),('6350','','default','The name of the file.','','7.12'),('6351','','default','The path of the file.','','7.12'),('6352','','default','The mime type of the file.','','7.12'),('6353','','default','The status of the file.','','7.12'),('6354','','default','The date the file was uploaded.','','7.12'),('6355','','default','Name of the vocabulary a term is a member of. This will be the vocabulary that whichever term the "Taxonomy: Term" field is; and can similarly cause duplicates.','','7.12'),('6356','','default','Taxonomy terms are attached to nodes.','','7.12'),('6357','','default','Taxonomy term name.','','7.12'),('6358','','default','The term weight field','','7.12'),('6359','','default','The description associated with a taxonomy term.','','7.12'),('6360','','default','Filter the results of "Taxonomy: Term" to a particular vocabulary.','','7.12'),('6361','','default','Display all taxonomy terms associated with a node from specified vocabularies.','','7.12'),('6362','','default','The parent term of the term. This can produce duplicate entries if you are using a vocabulary that allows multiple parents.','','7.12'),('6363','','default','The parent term of the term.','','7.12'),('6364','','default','Node translation','','none'),('6365','','default','Translation set node ID','','none'),('6366','','default','The ID of the translation set the content belongs to.','','none');
INSERT INTO `locales_source` VALUES ('6367','','default','Source translation','','none'),('6368','','default','The source that this content was translated from.','','none'),('6369','','default','Versions of content in different languages.','','none'),('6370','','default','Child translation','','none'),('6371','','default','Outdated','','none'),('6372','','default','The user ID','','7.12'),('6373','','default','The user or author name.','','7.12'),('6374','','default','Email address for a given user. This field is normally not shown to users, so be cautious when using it.','','7.12'),('6375','','default','Language of the user','','7.12'),('6376','','default','The user''s picture, if allowed.','','7.12'),('6377','','default','The date the user was created.','','7.12'),('6378','','default','The user''s last access date.','','7.12'),('6379','','default','The user''s last login date.','','7.12'),('6380','','default','Whether a user is active or blocked.','','7.12'),('6381','','default','The user''s signature.','','7.12'),('6382','','default','Provide a simple link to edit the user.','','7.12'),('6383','','default','Roles that a user belongs to.','','7.12'),('6384','','default','User ID from URL','','7.12'),('6385','','default','User ID from logged in user','','7.12'),('6386','','default','Randomize the display order.','','7.12'),('6387','','default','Null','','7.12'),('6388','','default','Provide custom text or link.','','7.12'),('6389','','default','View result counter','','7.12'),('6390','','default','Displays the actual position of the view result','','7.12'),('6391','','default','Link this field to its aggregator category page','','none'),('6392','','default','No user','','none'),('6393','','default','Link this field to its comment','','none'),('6394','','default','Show teaser-style link','','none'),('6395','','default','Link this field to new comments','','none'),('6396','','default','Type of link','','none');
INSERT INTO `locales_source` VALUES ('6397','','default','Contact %user','','none'),('6398','','default','Unknown group','','none'),('6399','','default','Unknown language','','none'),('6400','','default','Current user''s language','','7.12'),('6401','','default','Current installed version','','none'),('6402','','default','Check for new comments as well','','none'),('6403','','default','Node IDs separated by , or +','','7.12'),('6404','','default','No alternate','','none'),('6405','','default','Alternative sort','','none'),('6406','','default','Alternate sort order','','none'),('6407','','default','On empty input','','none'),('6408','','default','Show None','','none'),('6409','','default','Display score','','none'),('6410','','default','Link this field to download the file','','none'),('6411','','default','Set the breadcrumb for the term parents','','none'),('6412','','default','If selected, the breadcrumb trail will include all parent terms, each one linking to this view. Note that this only works if just one term was received.','','none'),('6413','','default','The depth will match nodes tagged with terms in the hierarchy. For example, if you have the term "fruit" and a child term "apple", with a depth of 1 (or higher) then filtering for the term "fruit" will get nodes that are tagged with "apple" as well as "fruit". If negative, the reverse is true; searching for "apple" will also pick up nodes tagged with "fruit" if depth is -1 (or lower).','','none'),('6414','','default','No vocabulary','','none'),('6415','','default','Link this field to its taxonomy term page','','none'),('6416','','default','Link this field to its term page','','none'),('6417','','default','Limit terms by vocabulary','','7.12'),('6418','','default','Select which vocabulary to show terms for in the regular options.','','none'),('6419','','default','Dropdown','','7.10'),('6420','','default','Show hierarchy in dropdown','','7.10'),('6421','','default','An invalid vocabulary is selected. Please change it in the options.','','none'),('6422','','default','Select terms from vocabulary @voc','','7.12'),('6423','','default','Select terms','','none');
INSERT INTO `locales_source` VALUES ('6424','','default','Unable to find term: @terms','','none'),('6425','','default','Unable to find terms: @terms','','none'),('6426','','default','If you wish to validate for specific vocabularies, check them; if none are checked, all terms will pass.','','7.12'),('6427','','default','Term IDs separated by , or +','','7.12'),('6428','','default','Current language','','none'),('6429','','default','Translation option','','none'),('6430','','default','The translation options allows you to select which translation or translations in a translation set join on. Select "Current language" or "Default language" to join on the translation in the current or default language respectively. Select a specific language to join on a translation in that language. If you select "All", each translation will create a new row, which may appear to cause duplicates.','','none'),('6431','','default','To the user','','7.12'),('6432','','default','With a mailto:','','7.12'),('6433','','default','Is the logged in user','','none'),('6434','','default','Usernames','','7.12'),('6435','','default','Enter a comma separated list of user names.','','7.12'),('6436','','default','Unable to find user: @users','','7.12'),('6437','','default','Unable to find users: @users','','none'),('6438','','default','Also look for a node and use the node author','','7.12'),('6439','','default','Only allow numeric UIDs','','7.12'),('6440','','default','Only allow string usernames','','7.12'),('6441','','default','Allow both numeric UIDs and string usernames','','7.12'),('6442','','default','Restrict user based on role','','7.12'),('6443','','default','Restrict to the selected roles','','7.12'),('6444','','default','If no roles are selected, users from any role will be allowed.','','7.12'),('6445','','default','Unrestricted','','7.12'),('6446','','default','Only users with the selected permission flag will be able to access this display. Note that users with "access all views" can see any view, regardless of other permissions.','','7.12'),('6447','','default','No role(s) selected','','7.12');
INSERT INTO `locales_source` VALUES ('6448','','default','Multiple roles','','none'),('6449','','default','Only the checked roles will be able to access this display. Note that users with "access all views" can see any view, regardless of role.','','7.12'),('6450','','default','You must select at least one role if type is "by role"','','none'),('6451','','default','PHP validate code','','7.12'),('6452','','default','Never cache','','none'),('6453','','default','Query results','','none'),('6454','','default','The length of time raw query results should be cached.','','none'),('6455','','default','Rendered output','','none'),('6456','','default','The length of time rendered HTML output should be cached.','','none'),('6457','','default','Broken field','','none'),('6458','','default','Change the title that this display will use.','','7.12'),('6459','','default','Use AJAX','','7.12'),('6460','','default','Change whether or not this display will use AJAX.','','7.12'),('6461','','default','Mini','','7.12'),('6462','','default','Change this display''s pager setting.','','7.12'),('6463','','default','Specify whether this display will provide a "more" link.','','7.12'),('6464','','default','Specify access control type for this display.','','7.12'),('6465','','default','Change settings for this access type.','','7.12'),('6466','','default','Specify caching type for this display.','','7.12'),('6467','','default','Change settings for this caching type.','','none'),('6468','','default','Link display','','7.12'),('6469','','default','Exposed form in block','','7.12'),('6470','','default','Allow the exposed form to appear in a block instead of the view.','','7.12'),('6471','','default','Get information on how to theme this display','','7.12'),('6472','','default','The title of this view','','7.12'),('6473','','default','This title will be displayed with the view, wherever titles are normally displayed; i.e, as the page title, block title, etc.','','7.12'),('6474','','default','Use AJAX when available to load this view','','7.12'),('6475','','default','If set, this view will use an AJAX mechanism for paging, table sorting and exposed filters. This means the entire page will not refresh. It is not recommended that you use this if this view is the main content of the page as it will prevent deep linking to specific pages, but it is very useful for side content.','','7.12');
INSERT INTO `locales_source` VALUES ('6476','','default','Unless you''re experiencing problems with pagers related to this view, you should leave this at 0. If using multiple pagers on one page you may need to set this number to a higher value so as not to conflict within the ?page= array. Large values will add a lot of commas to your URLs, so avoid if possible.','','7.12'),('6477','','default','The number of items to display per page. Enter 0 for no limit.','','7.12'),('6478','','default','Add a more link to the bottom of the display.','','none'),('6479','','default','Create more link','','none'),('6480','','default','The text to display for the more link.','','none'),('6481','','default','This will make the view display only distinct items. If there are multiple identical items, each will be displayed only once. You can use this to try and remove duplicates from a view, though it does not always work. Note that this can slow queries down, so use it with caution.','','none'),('6482','','default','Access restrictions','','7.12'),('6483','','default','Access options','','7.12'),('6484','','default','Caching options','','none'),('6485','','default','Display even if view has no result','','7.12'),('6486','','default','How should this view be styled','','7.12'),('6487','','default','If the style you choose has settings, be sure to click the settings button that will appear next to it in the View summary.','','7.12'),('6488','','default','Style options','','7.12'),('6489','','default','Row style options','','7.12'),('6490','','default','How should each row in this view be styled','','7.12'),('6491','','default','Which display to use for path','','none'),('6492','','default','Which display to use to get this display''s path for things like summary links, rss feed links, more links, etc.','','none'),('6493','','default','Display output','','none'),('6494','','default','Alternative display output','','none'),('6495','','default','Style output','','none'),('6496','','default','Alternative style','','none'),('6497','','default','Row style output','','none'),('6498','','default','Alternative row style','','none');
INSERT INTO `locales_source` VALUES ('6499','','default','Field @field (ID: @id)','','none'),('6500','','default','This section lists all possible templates for the display plugin and for the style plugins, ordered roughly from the least specific to the most specific. The active template for each plugin -- which is the most specific template found on the system -- is highlighted in bold.','','none'),('6501','','default','Change theme','','none'),('6502','','default','Rescan template files','','none'),('6503','','default','<strong>Important!</strong> When adding, removing, or renaming template files, it is necessary to make Drupal aware of the changes by making it rescan the files on your system. By clicking this button you clear Drupal''s theme registry and thereby trigger this rescanning process. The highlighted templates above will then reflect the new state of your system.','','none'),('6504','','default','Theming information (display)','','none'),('6505','','default','Back to !info.','','none'),('6506','','default','theming information','','none'),('6507','','default','This display has no theming information','','none'),('6508','','default','This is the default theme template used for this display.','','none'),('6509','','default','This is an alternative template for this display.','','none'),('6510','','default','Theming information (style)','','none'),('6511','','default','This display has no style theming information','','none'),('6512','','default','This is the default theme template used for this style.','','none'),('6513','','default','This is an alternative template for this style.','','none'),('6514','','default','Theming information (row style)','','none'),('6515','','default','This display has no row style theming information','','none'),('6516','','default','This is the default theme template used for this row style.','','none'),('6517','','default','This is an alternative template for this row style.','','none'),('6518','','default','Put the exposed form in a block','','none'),('6519','','default','If set, any exposed widgets will not appear with this view. Instead, a block will be made available to the Drupal block administration system, and the exposed form will appear there. Note that this block must be enabled manually, Views will not enable it for you.','','none');
INSERT INTO `locales_source` VALUES ('6520','','default','File found in folder @template-path','','none'),('6521','','default','(File not found, in folder @template-path)','','none'),('6522','','default','Display "@display" uses fields but there are none defined for it or all are excluded.','','7.12'),('6523','','default','Display "@display" uses a path but the path is undefined.','','7.12'),('6524','','default','Display "@display" has an invalid style plugin.','','none'),('6525','','default','Exposed form: @view-@display_id','','none'),('6526','','default','Attachment settings','','none'),('6527','','default','Inherit exposed filters','','none'),('6528','','default','Multiple displays','','7.10'),('6529','','default','Should this display inherit its exposed filter values from the parent display to which it is attached?','','none'),('6530','','default','Attach before or after the parent display?','','none'),('6531','','default','Select which display or displays this should attach to.','','none'),('6532','','default','Block admin description','','7.12'),('6533','','default','Block caching type','','none'),('6534','','default','This sets the default status for Drupal''s built-in block caching method; this requires that caching be turned on in block administration, and be careful because you have little control over when this cache is flushed.','','none'),('6535','','default','Using the site name','','none'),('6536','','default','Use the site name for the title','','none'),('6537','','default','The feed icon will be available only to the selected displays.','','7.10'),('6538','','default','No menu','','7.12'),('6539','','default','Normal: @title','','7.12'),('6540','','default','Tab: @title','','none'),('6541','','default','Change settings for the parent menu','','none'),('6542','','default','The menu path or URL of this view','','7.12'),('6543','','default','Menu item entry','','7.12'),('6544','','default','If set to normal or tab, enter the text to use for the menu item''s description.','','7.12'),('6545','','default','Default tab options','','none'),('6546','','default','When providing a menu item as a tab, Drupal needs to know what the parent menu item of that tab will be. Sometimes the parent will already exist, but other times you will need to have one created. The path of a parent item will always be the same path with the last part left off. i.e, if the path to this view is <em>foo/bar/baz</em>, the parent path would be <em>foo/bar</em>.','','none');
INSERT INTO `locales_source` VALUES ('6547','','default','Already exists','','none'),('6548','','default','If creating a parent menu item, enter the description of the item.','','none'),('6549','','default','"$arg" is no longer supported. Use % instead.','','none'),('6550','','default','"%" may not be used for the first segment of a path.','','none'),('6551','','default','Views cannot create normal menu items for paths with a % in them.','','none'),('6552','','default','A display whose path ends with a % cannot be a tab.','','none'),('6553','','default','Title is required for this menu type.','','none'),('6554','','default','Inline fields','','7.12'),('6555','','default','The separator may be placed between inline fields to keep them from squishing up next to each other. You can use HTML in this field.','','7.12'),('6556','','default','Grouping field','','7.10'),('6557','','default','You may optionally specify a field by which to group the records. Leave blank to not group.','','7.12'),('6558','','default','Style @style requires a row style but the row plugin is invalid.','','none'),('6559','','default','Horizontal alignment will place items starting in the upper left and moving right. Vertical alignment will place items starting in the upper left and moving down.','','7.12'),('6560','','default','RSS description','','none'),('6561','','default','This will appear in the RSS feed itself.','','none'),('6562','','default','Display record count with link','','7.12'),('6563','','default','Override number of items to display','','7.12'),('6564','','default','Display items inline','','7.12'),('6565','','default','You need at least one field before you can configure your table settings','','none'),('6566','','default','Override normal sorting if click sorting is used','','7.12'),('6567','','default','Enable Drupal style "sticky" table headers (Javascript)','','7.12'),('6568','','default','(Sticky header effects will not be active for preview below, only on live output.)','','7.12'),('6569','','default','Place fields into columns; you may combine multiple fields into the same column. If you do, the separator in the column specified will be used to separate the fields. Check the sortable box to make that column click sortable, and check the default sort radio to determine which column will be sorted by default, if any. You may control column order and field labels in the fields section.','','7.12');
INSERT INTO `locales_source` VALUES ('6570','','default','The style selected does not utilize fields.','','none'),('6571','','default','None defined','','none'),('6572','','default','This view is being edited by user !user, and is therefore locked from editing by others. This lock is !age old. Click here to <a href="!break">break this lock</a>.','','7.10'),('6573','','default','New view','','none'),('6574','','default','Changed view','','none'),('6575','','default','View %name, displaying items of type <strong>@base</strong>.','','none'),('6576','','default','Live preview','','none'),('6577','','default','‹‹','','7.10'),('6578','','default','››','','7.10'),('6579','','default','@current of @max','','7.10'),('6580','','default','Allow multiple values','','7.12'),('6581','','default','Filter criteria','','7.12'),('6582','','default','Item ID','','none'),('6583','','default','Sort descending','','7.12'),('6584','','default','Sort ascending','','7.12'),('6585','','default','Style settings','','7.12'),('6586','','default','Taxonomy Term','','7.12'),('6587','','default','@label (!name)','','7.12'),('6588','','default','(first item is 0)','','7.12'),('6589','','default','(start from last values)','','7.12'),('6590','','default','Number of pages','','7.12'),('6591','','default','Content statistics','','none'),('6592','','default','Target of the link, such as _blank, _parent or an iframe''s name. This field is rarely used.','','7.12'),('6593','','default','@argument title','','7.12'),('6594','','default','@argument input','','7.12'),('6595','','default','The maximum number of characters this field can be.','','7.12'),('6596','','default','Count the number 0 as empty','','7.12'),('6597','','default','Hide if empty','','7.12'),('6598','','default','Starting value','','7.12'),('6599','','default','Specify the number the counter should start at.','','7.12');
INSERT INTO `locales_source` VALUES ('6600','','default','Does not start with','','7.12'),('6601','','default','not_begins','','7.12'),('6602','','default','Does not end with','','7.12'),('6603','','default','not_ends','','7.12'),('6604','','default','The view %name has been saved.','','7.12'),('6605','','default','This filter can cause items that have more than one of the selected options to appear as duplicate results. If this filter causes duplicate results to occur, this checkbox can reduce those duplicates; however, the more terms it has to search for, the less performant the query will be, so use this with caution. Shouldn''t be set on single-value fields, as it may cause values to disappear from display, if used on an incompatible field.','','7.12'),('6606','','default','Jump menu','','7.12'),('6607','','default','Puts all of the results into a select box and allows the user to go to a different page based upon the results.','','7.12'),('6608','','default','Hostname of user that posted the comment.','','7.12'),('6609','','default','Email of user that posted the comment. Will be empty if the author is a registered user.','','7.12'),('6610','','default','Relate nodes to taxonomy terms, specifiying which vocabulary or vocabularies to use. This relationship will cause duplicated records if there are multiple terms.','','7.12'),('6611','','default','The text of the profile item.','','none'),('6612','','default','The taxonomy term ID for the term.','','none'),('6613','','default','The taxonomy term name for the term.','','none'),('6614','','default','The name for the vocabulary the term belongs to.','','none'),('6615','','default','Choose which vocabularies you wish to relate. Remember that every term found will create a new record, so this relationship is best used on just one vocabulary that has only one term per node.','','none'),('6616','','default','The name of the role.','','7.12'),('6617','','default','The role ID of the role.','','7.12'),('6618','','default','Hide empty fields','','7.12'),('6619','','default','Do not display fields, labels or markup for fields that are empty.','','7.12');
INSERT INTO `locales_source` VALUES ('6620','','default','You need at least one field before you can configure your jump menu settings','','none'),('6621','','default','To properly configure a jump menu, you must select one field that will represent the path to utilize. You should then set that field to exclude. All other displayed fields will be part of the menu. Please note that all HTML will be stripped from this output as select boxes cannot show HTML.','','7.12'),('6622','','default','Path field','','7.12'),('6623','','default','If hidden, this button will only be hidden for users with javascript and the page will automatically jump when the select is changed.','','7.12'),('6624','','default','Monthly archive','','7.12'),('6625','','default','This identifier is used by another handler.','','none'),('6626','','default','Length is shorter than','','7.12'),('6627','','default','shorter than','','7.12'),('6628','','default','Length is longer than','','7.12'),('6629','','default','longer than','','7.12'),('6630','','default','SQL Query','','7.12'),('6631','','default','Query will be generated and run using the Drupal database API.','','7.12'),('6632','','default','revision user','','7.12'),('6633','','default','Exposed form','','7.12'),('6634','','default','This will display the more link even if there are no more items to display.','','none'),('6635','','default','The order of pages in the book hierarchy.','','none'),('6636','','default','Display the standard add comment link used on regular nodes, which will only display if the viewing user has access to add a comment.','','7.12'),('6637','','default','Inherit pager','','none'),('6638','','default','Render pager','','none'),('6639','','default','Render','','none'),('6640','','default','Entity ID','','none'),('6641','','default','The label for this area that will be displayed only administratively.','','7.12'),('6642','','default','Exposed','','none'),('6643','','default','Displays Reorder','','none'),('6644','','default','Remove this display','','none'),('6645','','default','Operator to use on all groups','','7.12'),('6646','','default','Either "group 0 AND group 1 AND group 2" or "group 0 OR group 1 OR group 2", etc','','7.12');
INSERT INTO `locales_source` VALUES ('6647','','default','Remove group @group','','7.12'),('6648','','default','Default group','','7.12'),('6649','','default','Group @group','','7.12'),('6650','','default','Ungroupable filters','','none'),('6651','','default','Configure group settings for @type %item','','7.12'),('6652','','default','Basic exposed form','','7.12'),('6653','','default','Input required','','7.12'),('6654','','default','An exposed form that only renders a view if the form contains user input.','','7.12'),('6655','','default','Display all items','','7.12'),('6656','','default','Display all items that this view might find','','7.12'),('6657','','default','Display a specified number of items','','7.12'),('6658','','default','Display a limited number items that this view might find.','','7.12'),('6659','','default','Paged output, full pager','','7.12'),('6660','','default','Paged output, full Drupal style','','7.12'),('6661','','default','Paged output, mini pager','','7.12'),('6662','','default','Use the mini pager output.','','7.12'),('6663','','default','The taxonomy vocabulary name','','7.12'),('6664','','default','Name (raw)','','7.12'),('6665','','default','The user or author name. This filter does not check if the user exists and allows partial matching. Does not utilize autocomplete.','','7.12'),('6666','','default','Provide markup text for the area.','','7.12'),('6667','','default','Machine Name','','7.12'),('6668','','default','Change the machine name of this display.','','7.12'),('6669','','default','Change settings for this pager type.','','7.12'),('6670','','default','Allow grouping and aggregation (calculation) of fields.','','7.12'),('6671','','default','Exposed form style','','7.12'),('6672','','default','Select the kind of exposed filter to use.','','7.12'),('6673','','default','Exposed form settings for this exposed form style.','','7.12'),('6674','','default','The machine name of this display','','none'),('6675','','default','This is machine name of the display.','','none'),('6676','','default','If enabled, some fields may become unavailable. All fields that are selected for grouping will be collapsed to one record per distinct value. Other fields which are selected for aggregation will have the function run on them. For example, you can group nodes on title and count the number of nids in order to get a list of duplicate titles.','','7.12');
INSERT INTO `locales_source` VALUES ('6677','','default','<strong>Important!</strong> You have changed the display''s machine name. Anything that attached to this display specifically, such as theming, may stop working until it is updated. To see theme suggestions for it, you need to save the view.','','none'),('6678','','default','Exposed Form','','7.12'),('6679','','default','Exposed form options','','7.10'),('6680','','default','Select which pager, if any, to use for this view','','7.12'),('6681','','default','Pager options','','7.12'),('6682','','default','Display id should be unique.','','none'),('6683','','default','Text to display in the submit button of the exposed form.','','7.10'),('6684','','default','Include reset button','','7.10'),('6685','','default','If checked the exposed form will provide a button to reset all the applied exposed filters','','7.10'),('6686','','default','Reset button label','','7.10'),('6687','','default','Text to display in the reset button of the exposed form.','','7.10'),('6688','','default','Exposed sorts label','','7.10'),('6689','','default','Text to display as the label of the exposed sort select box.','','7.10'),('6690','','default','Text to use when exposed sort is ordered ascending.','','7.10'),('6691','','default','Text to use when exposed sort is ordered descending.','','7.10'),('6692','','default','Select any filter and click on Apply to see results','','none'),('6693','','default','Text on demand','','none'),('6694','','default','The number of items to skip. For example, if this field is 3, the first 3 items will be skipped and not displayed.','','7.12'),('6695','','default','The total number of pages. Leave empty to show all pages.','','7.12'),('6696','','default','Exposed options','','7.12'),('6697','','default','Exposing this options allows users to define their values in a exposed form when view is displayed','','7.12'),('6698','','default','Expose items per page','','7.12'),('6699','','default','When checked, use