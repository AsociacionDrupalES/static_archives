ath by which the content can be accessed. For example, "about" for an about page. Use a relative path and do not add a trailing slash. Leave it empty to delete the URL alias.";s:8:"optional";b:1;}}s:15:"access callback";s:29:"rules_path_integration_access";s:6:"module";s:5:"rules";s:8:"provides";a:0:{}s:11:"faces_cache";a:1:{s:24:"RulesPluginImplInterface";a:2:{i:0;a:2:{s:7:"execute";a:1:{i:0;s:28:"rules_action_node_path_alias";}s:12:"dependencies";a:1:{i:0;s:23:"rules_path_dependencies";}}i:1;a:2:{s:7:"execute";s:17:"modules/path.eval";s:12:"dependencies";s:18:"modules/path.rules";}}}}s:24:"taxonomy_term_path_alias";a:7:{s:5:"label";s:44:"Create or delete a taxonomy term''s URL alias";s:5:"group";s:4:"Ruta";s:9:"parameter";a:2:{s:4:"node";a:3:{s:4:"type";s:13:"taxonomy_term";s:5:"label";s:22:"Término de taxonomía";s:4:"save";b:1;}s:5:"alias";a:4:{s:4:"type";s:4:"text";s:5:"label";s:12:"Alias de URL";s:11:"description";s:204:"Specify an alternative path by which the term can be accessed. For example, "content/drupal" for a Drupal term. Use a relative path and do not add a trailing slash. Leave it empty to delete the URL alias.";s:8:"optional";b:1;}}s:15:"access callback";s:29:"rules_path_integration_access";s:6:"module";s:5:"rules";s:8:"provides";a:0:{}s:11:"faces_cache";a:1:{s:24:"RulesPluginImplInterface";a:2:{i:0;a:2:{s:7:"execute";a:1:{i:0;s:28:"rules_action_node_path_alias";}s:12:"dependencies";a:1:{i:0;s:23:"rules_path_dependencies";}}i:1;a:2:{s:7:"execute";s:17:"modules/path.eval";s:12:"dependencies";s:18:"modules/path.rules";}}}}}}','0','1399808227','1');
