INSERT INTO `rules_config` VALUES ('25','rules_solo_un_producto_en_el_carro','Solo un producto en el carro','reaction rule','1','0','1','1','rules','O:17:"RulesReactionRule":14:{s:9:"\0*\0parent";N;s:2:"id";s:2:"25";s:12:"\0*\0elementId";i:1;s:6:"weight";s:1:"0";s:8:"settings";a:0:{}s:4:"name";s:34:"rules_solo_un_producto_en_el_carro";s:6:"module";s:5:"rules";s:6:"status";s:1:"1";s:5:"label";s:28:"Solo un producto en el carro";s:4:"tags";a:0:{}s:11:"\0*\0children";a:1:{i:0;O:11:"RulesAction":6:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0elementId";i:3;s:6:"weight";i:0;s:8:"settings";a:1:{s:21:"commerce_order:select";s:14:"commerce_order";}s:14:"\0*\0elementName";s:19:"commerce_cart_empty";}}s:7:"\0*\0info";a:0:{}s:13:"\0*\0conditions";O:8:"RulesAnd":8:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0elementId";i:2;s:6:"weight";i:0;s:8:"settings";a:0:{}s:11:"\0*\0children";a:0:{}s:7:"\0*\0info";a:0:{}s:9:"\0*\0negate";b:0;}s:9:"\0*\0events";a:1:{i:0;s:29:"commerce_cart_product_prepare";}}'),('26','rules_redirigir_a_finalizar_la_compra','Redirigir a finalizar la compra','reaction rule','1','0','1','1','rules','O:17:"RulesReactionRule":14:{s:9:"\0*\0parent";N;s:2:"id";s:2:"26";s:12:"\0*\0elementId";i:1;s:6:"weight";s:1:"0";s:8:"settings";a:0:{}s:4:"name";s:37:"rules_redirigir_a_finalizar_la_compra";s:6:"module";s:5:"rules";s:6:"status";s:1:"1";s:5:"label";s:31:"Redirigir a finalizar la compra";s:4:"tags";a:0:{}s:11:"\0*\0children";a:1:{i:0;O:11:"RulesAction":6:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0elementId";i:3;s:6:"weight";i:0;s:8:"settings";a:4:{s:3:"url";s:8:"checkout";s:5:"force";i:1;s:11:"destination";i:0;s:11:"url:process";O:22:"RulesURIInputEvaluator":2:{s:10:"\0*\0setting";b:1;s:12:"\0*\0processor";N;}}s:14:"\0*\0elementName";s:8:"redirect";}}s:7:"\0*\0info";a:0:{}s:13:"\0*\0conditions";O:8:"RulesAnd":8:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0elementId";i:2;s:6:"weight";i:0;s:8:"settings";a:0:{}s:11:"\0*\0children";a:0:{}s:7:"\0*\0info";a:0:{}s:9:"\0*\0negate";b:0;}s:9:"\0*\0events";a:1:{i:0;s:25:"commerce_cart_product_add";}}');
DROP TABLE IF EXISTS `rules_dependencies`;
CREATE TABLE `rules_dependencies` (   `id` int(10) unsigned NOT NULL COMMENT 'The primary identifier of the configuration.',   `module` varchar(255) NOT NULL COMMENT 'The name of the module that is required for the configuration.',   PRIMARY KEY (`id`,`module`),   KEY `module` (`module`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
INSERT INTO `rules_dependencies` VALUES ('22','commerce_cart'),('25','commerce_cart'),('26','commerce_cart'),('16','commerce_checkout'),('18','commerce_checkout'),('21','commerce_checkout'),('18','commerce_order'),('23','commerce_order'),('17','commerce_payment'),('19','commerce_payment'),('23','entity'),('16','rules'),('18','rules'),('21','rules'),('22','rules'),('23','rules'),('24','rules'),('26','rules');
DROP TABLE IF EXISTS `rules_tags`;
CREATE TABLE `rules_tags` (   `id` int(10) unsigned NOT NULL COMMENT 'The primary identifier of the configuration.',   `tag` varchar(255) NOT NULL COMMENT 'The tag string associated with this configuration',   PRIMARY KEY (`id`,`tag`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
DROP TABLE IF EXISTS `rules_trigger`;
CREATE TABLE `rules_trigger` (   `id` int(10) unsigned NOT NULL COMMENT 'The primary identifier of the configuration.',   `event` varchar(127) NOT NULL DEFAULT '' COMMENT 'The name of the event on which the configuration should be triggered.',   PRIMARY KEY (`id`,`event`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
INSERT INTO `rules_trigger` VALUES ('16','commerce_checkout_complete'),('17','commerce_payment_methods'),('18','commerce_checkout_complete'),('19','commerce_payment_methods'),('21','commerce_checkout_complete'),('22','commerce_cart_product_add'),('23','commerce_line_item_update'),('24','init'),('25','commerce_cart_product_prepare'),('26','commerce_cart_product_add');
DROP TABLE IF EXISTS `search_dataset`;
CREATE TABLE `search_dataset` (   `sid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'Search item ID, e.g. node ID for nodes.',   `type` varchar(16) NOT NULL COMMENT 'Type of item, e.g. node.',   `data` longtext NOT NULL COMMENT 'List of space-separated words from the item.',   `reindex` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'Set to force node reindexing.',   PRIMARY KEY (`sid`,`type`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores items that will be searched.';
DROP TABLE IF EXISTS `search_index`;
CREATE TABLE `search_index` (   `word` varchar(50) NOT NULL DEFAULT '' COMMENT 'The search_total.word that is associated with the search item.',   `sid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The search_dataset.sid of the searchable item to which the word belongs.',   `type` varchar(16) NOT NULL COMMENT 'The search_dataset.type of the searchable item to which the word belongs.',   `score` float DEFAULT NULL COMMENT 'The numeric score of the word, higher being more important.',   PRIMARY KEY (`word`,`sid`,`type`),   KEY `sid_type` (`sid`,`type`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores the search index, associating words, items and...';
DROP TABLE IF EXISTS `search_node_links`;
CREATE TABLE `search_node_links` (   `sid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The search_dataset.sid of the searchable item containing the link to the node.',   `type` varchar(16) NOT NULL DEFAULT '' COMMENT 'The search_dataset.type of the searchable item containing the link to the node.',   `nid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The node.nid that this item links to.',   `caption` longtext COMMENT 'The text used to link to the node.nid.',   PRIMARY KEY (`sid`,`type`,`nid`),   KEY `nid` (`nid`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores items (like nodes) that link to other nodes, used...';
INSERT INTO `search_node_links` VALUES ('20','node','31','libro forcontu');
DROP TABLE IF EXISTS `search_total`;
CREATE TABLE `search_total` (   `word` varchar(50) NOT NULL DEFAULT '' COMMENT 'Primary Key: Unique word in the search index.',   `count` float DEFAULT NULL COMMENT 'The count of the word in the index using Zipf’s law to equalize the probability distribution.',   PRIMARY KEY (`word`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores search totals for words.';
DROP TABLE IF EXISTS `semaphore`;
CREATE TABLE `semaphore` (   `name` varchar(255) NOT NULL DEFAULT '' COMMENT 'Primary Key: Unique name.',   `value` varchar(255) NOT NULL DEFAULT '' COMMENT 'A value for the semaphore.',   `expire` double NOT NULL COMMENT 'A Unix timestamp with microseconds indicating when the semaphore should expire.',   PRIMARY KEY (`name`),   KEY `value` (`value`),   KEY `expire` (`expire`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Table for holding semaphores, locks, flags, etc. that...';
DROP TABLE IF EXISTS `sequences`;
CREATE TABLE `sequences` (   `value` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'The value of the sequence.',   PRIMARY KEY (`value`) ) ENGINE=InnoDB AUTO_INCREMENT=169 DEFAULT CHARSET=utf8 COMMENT='Stores IDs.' AUTO_INCREMENT=169;
INSERT INTO `sequences` VALUES ('168');
DROP TABLE IF EXISTS `sessions`;
CREATE TABLE `sessions` (   `uid` int(10) unsigned NOT NULL COMMENT 'The users.uid corresponding to a session, or 0 for anonymous user.',   `sid` varchar(128) NOT NULL COMMENT 'A session ID. The value is generated by Drupal’s session handlers.',   `ssid` varchar(128) NOT NULL DEFAULT '' COMMENT 'Secure session ID. The value is generated by Drupal’s session handlers.',   `hostname` varchar(128) NOT NULL DEFAULT '' COMMENT 'The IP address that last used this session ID (sid).',   `timestamp` int(11) NOT NULL DEFAULT '0' COMMENT 'The Unix timestamp when this session last requested a page. Old records are purged by PHP automatically.',   `cache` int(11) NOT NULL DEFAULT '0' COMMENT 'The time of this user’s last post. This is used when the site has specified a minimum_cache_lifetime. See cache_get().',   `session` longblob COMMENT 'The serialized contents of $_SESSION, an array of name/value pairs that persists across page requests by this session ID. Drupal loads $_SESSION from here at the start of each request and saves it at the end.',   PRIMARY KEY (`sid`,`ssid`),   KEY `timestamp` (`timestamp`),   KEY `uid` (`uid`),   KEY `ssid` (`ssid`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Drupal’s session handlers read and write into the...';
DROP TABLE IF EXISTS `shortcut_set`;
CREATE TABLE `shortcut_set` (   `set_name` varchar(32) NOT NULL DEFAULT '' COMMENT 'Primary Key: The menu_links.menu_name under which the set’s links are stored.',   `title` varchar(255) NOT NULL DEFAULT '' COMMENT 'The title of the set.',   PRIMARY KEY (`set_name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores information about sets of shortcuts links.';
INSERT INTO `shortcut_set` VALUES ('shortcut-set-1','Default');
DROP TABLE IF EXISTS `shortcut_set_users`;
CREATE TABLE `shortcut_set_users` (   `uid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The users.uid for this set.',   `set_name` varchar(32) NOT NULL DEFAULT '' COMMENT 'The shortcut_set.set_name that will be displayed for this user.',   PRIMARY KEY (`uid`),   KEY `set_name` (`set_name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Maps users to shortcut sets.';
DROP TABLE IF EXISTS `spamicide`;
CREATE TABLE `spamicide` (   `form_id` varchar(128) NOT NULL,   `form_field` varchar(64) NOT NULL DEFAULT 'feed_me',   `enabled` tinyint(4) NOT NULL DEFAULT '0',   `removable` tinyint(4) NOT NULL DEFAULT '1',   PRIMARY KEY (`form_id`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
INSERT INTO `spamicide` VALUES ('comment_node_article_form','feed_me','1','0'),('comment_node_forum_form','feed_me','1','0'),('comment_node_page_form','feed_me','1','0'),('comment_node_session_form','feed_me','1','0'),('comment_node_sponsor_form','feed_me','1','0'),('contact_personal_form','feed_me','1','0'),('contact_site_form','feed_me','1','0'),('forum_node_form','feed_me','1','0'),('user_login','feed_me','1','0'),('user_login_block','feed_me','1','0'),('user_pass','feed_me','1','0'),('user_register_form','feed_me','1','0'),('webform_client_form_52','feed_me','1','1');
DROP TABLE IF EXISTS `sweaver_image`;
CREATE TABLE `sweaver_image` (   `fid` int(11) NOT NULL DEFAULT '0' COMMENT 'The image fid.',   `description` varchar(40) DEFAULT NULL COMMENT 'A human readable name of the image.' ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Table storing images.';
INSERT INTO `sweaver_image` VALUES ('3','twitterHashTag'),('4','TwitterHashTag120'),('112','Banner portada'),('113','Banner portada'),('114','Logo Drupal'),('117','Banner 2'),('118','Banner 2'),('119','twitter'),('120','Favicon'),('122','Twitter 4');
DROP TABLE IF EXISTS `sweaver_property`;
CREATE TABLE `sweaver_property` (   `oid` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'Primary ID field for the table. Not used for anything except internal lookups.',   `name` varchar(40) DEFAULT NULL COMMENT 'Unique ID for properties. Used to identify them programmatically.',   `description` varchar(60) DEFAULT NULL COMMENT 'A human readable name of a property.',   `property` varchar(255) DEFAULT NULL COMMENT 'The css property. Seperate multiple values by spaces.',   `property_parent` varchar(40) DEFAULT NULL COMMENT 'The parent of this property.',   `property_type` varchar(20) DEFAULT NULL COMMENT 'Type of the property',   `property_prefix` varchar(20) DEFAULT NULL COMMENT 'Prefix of the property',   `property_suffix` varchar(20) DEFAULT NULL COMMENT 'Suffix of the property',   `property_slider_min` int(11) NOT NULL DEFAULT '1' COMMENT 'Minimum value for the slider',   `property_slider_max` int(11) NOT NULL DEFAULT '72' COMMENT 'Maximum value for the slider',   `property_options` longtext COMMENT 'Options for this property',   PRIMARY KEY (`oid`),   UNIQUE KEY `name` (`name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Table storing property definitions.' AUTO_INCREMENT=1;
DROP TABLE IF EXISTS `sweaver_selector`;
CREATE TABLE `sweaver_selector` (   `oid` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'Primary ID field for the table. Not used for anything except internal lookups.',   `name` varchar(40) DEFAULT NULL COMMENT 'Unique ID for selectors. Used to identify them programmatically.',   `description` varchar(60) DEFAULT NULL COMMENT 'A human readable name of a selector.',   `selector_selector` varchar(120) DEFAULT NULL COMMENT 'The identifier of the selector',   `selector_highlight` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'Should this selector be highlighted by default',   PRIMARY KEY (`oid`),   UNIQUE KEY `name` (`name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Table storing selector definitions.' AUTO_INCREMENT=1;
DROP TABLE IF EXISTS `sweaver_style`;
CREATE TABLE `sweaver_style` (   `style_id` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The primary identifier for a theme style. Linked to style_id from the draft table.',   `theme` varchar(64) NOT NULL DEFAULT '' COMMENT 'The theme name',   `style` varchar(64) NOT NULL DEFAULT '' COMMENT 'The style name',   `css` longtext COMMENT 'The css object',   `customcss` longtext COMMENT 'Custom css',   `palette` varchar(64) NOT NULL DEFAULT '' COMMENT 'Palette',   `themesettings` longtext COMMENT 'Theme settings',   `active` int(11) NOT NULL DEFAULT '0' COMMENT 'Should this style be active?',   PRIMARY KEY (`style_id`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Storage for the css array';
INSERT INTO `sweaver_style` VALUES ('1','bartik','pruebas1','{"#name-and-slogan ":{"color":"2e2c2e","font-size":35,"margin-bottom":"15"},"#name-and-slogan a ":{"color":"2b2a2b"},"body ":{"font-family":"Arial, Helvetica,Sans-Serif"},"#main-menu ":{"font-size":22},"#block-block-1 ":{"width":242},"#block-block-1 .addthis_counter ":{"margin-top":"30"},"#secondary-menu a ":{"color":"2e2c2e"},"#secondary-menu li a ":{"color":"2e2c2e"},"#sidebar-second ":{"width":"375"},".one-sidebar #content ":{"text-align":"justify","width":"584","border-right-width":"1","border-style":"dashed","border-color":"2b2a2b","border-top-width":"0","border-left-width":"0","border-bottom-width":"0"},"#featured ":{"padding-bottom":0,"padding-top":"1"},"#main-menu ul ":{"padding-left":"0","padding-right":"0"},"#main-menu a ":{"font-size":"16"},"#logo ":{"padding-bottom":"0"},".region-header ":{"margin-top":"28"},"body .with-secondary-menu .region-header ":{"margin-bottom":"28"},"#block-block-1 .addthis_bubble_style ":{"margin-top":48},"#footer-wrapper .block ":{"border-style":"none","border-top-width":"0","border-left-width":"0","border-right-width":"0","border-bottom-width":"0"},"#block-views-noticias-block .ds-2col-stacked-fluid .group-left ":{"width":"55"},"#block-views-noticias-block .ds-2col-stacked-fluid .group-right ":{"width":"240","text-align":"justify"},".view-display-id-page .ds-2col-stacked-fluid .group-left ":{"width":"160"},".view-display-id-page .ds-2col-stacked-fluid .group-right ":{"width":"390"},"#triptych-wrapper ":{"background-color":"ffffff","border-top-width":"0"},"#triptych-wrapper td ":{"background-color":"ffffff"},"#triptych-wrapper .block ":{"border-bottom-width":"0"},"#triptych .region h2 ":{"color":"999999","font-size":"18"},"#triptych h2 ":{"border-top-width":"0","border-style":"solid","text-align":"left","border-left-width":"0","border-right-width":"0","border-bottom-width":"1","border-color":"cccccc","color":"cccccc","font-family":"Arial, Helvetica,Sans-Serif","width":""},"#triptych .region ":{"margin-top":"20","margin-left":"0"},"p ":{"font-size":"15","font-weight":"400"},"#block-block-9 p ":{"font-size":"15","line-height":"60","margin-bottom":"10"},"a ":{"font-size":"15","background-color":"transparent","color":"0071bd"},"#block-block-9 ":{"margin-bottom":"20","padding-bottom":"0"},"#block-block-9 a ":{"font-size":"25"},".session ":{"background-color":"b7c1c7","color":"ffffff"},".workshop ":{"background-color":"dce5e8"},".coffee ":{"background-color":"7ad147"},".lunch ":{"background-color":"ffb778"},".closure ":{"background-color":"7be8c0"},".opening ":{"background-color":"ffffff","color":"0071bd","font-weight":"800"},".time ":{"font-weight":"800"},"#block-views-sponsors-block a ":{"background-position":"left top"},"#block-views-sponsors-block img ":{"background-repeat":"no-repeat","background-position":"center center"},".field-content ":{"padding-top":0,"font-family":"''Palatino Linotype'',Palatino,Serif","font-weight":"800","font-size":34,"border-style":"none","border-top-width":0,"border-color":"f7f4f7"},".section ":{"background-repeat":"no-repeat","background-attachment":"scroll","background-position":"center top"},"li a ":{"background-color":"transparent"},"p a ":{"font-weight":"800"},"a:hover ":{"text-decoration":"underline"},".full ":{"color":"0071bd"},"ul ":{"color":"3175bd"},"#main-wrapper ":{"background-color":"transparent"}}','#logo {\r\n    padding-left: 21px;\r\n    padding-top: 8px;\r\n}\r\n\r\n.addthis_default_style .at300b {\r\n    padding: 56px 8px 0 0;\r\n}\r\n\r\n#header .section {\r\n    background: url(http://2013.drupalday.es/sites/default/files/sweaver/sweaver_image_118.jpg) no-repeat scroll 0 0 #dce4e7;\r\n}\r\n\r\n#main-menu-links a {\r\n    background: none;\r\n    color: #fff;\r\n    text-shadow: none;\r\n}\r\n\r\n\r\n#main-menu-links a:hover {\r\n    background: none;\r\n\r\n}\r\n\r\n#main-menu-links a.active {\r\n    background: none;\r\n    color: #b1bcbf;\r\n}\r\n\r\n.featured #main-menu-links li a.active {\r\n    background: none;\r\n}\r\n\r\n#main-menu-links li.active-trail a {\r\n    background: none;\r\n}\r\n\r\n#block-views-asistentes-block-3 .field-content,\r\n#block-block-2 .content a {\r\n    background: none repeat scroll 0 0 #E7E7E7;\r\n    border-radius: 6px 6px 6px 6px;\r\n    color: #2A4B6C;\r\n    display: block;\r\n    font-size: 166.7%;\r\n    font-weight: bold;\r\n    padding: 15px 10px;\r\n    text-align: center;\r\n    text-decoration: none;\r\n    text-transform: uppercase;\r\n}\r\n\r\n#block-block-3 .content a {\r\n    background: none repeat scroll 0 0 #ADC0D2;\r\n    border-radius: 6px 6px 6px 6px;\r\n    color: #2A4B6C;\r\n    display: block;\r\n    font-size: 166.7%;\r\n    font-weight: bold;\r\n    padding: 15px 10px;\r\n    text-align: center;\r\n    text-decoration: none;\r\n    text-transform: uppercase;\r\n}\r\n\r\n#block-block-2 .content a:hover {\r\n  background: none repeat scroll 0 0 #ADC0D2;\r\n}\r\n\r\n.without-secondary-menu .region-header {\r\n  margin-top: 28px;\r\n}\r\n\r\n#breadcrumb {\r\n  display:none;\r\n}\r\n\r\n.timetable p  {\r\n  margin: 0;\r\n}\r\n\r\n#site-name a {\r\n  font-size: 64px;\r\n  line-height: 1;\r\n}\r\n\r\n.view-id-sponsors .field-content {\r\n  text-align: center;\r\n}\r\n\r\n.inscribete a {\r\n color: #0071bd;\r\n}\r\n','','a:12:{s:11:"toggle_logo";i:1;s:11:"toggle_name";i:0;s:13:"toggle_slogan";i:0;s:24:"toggle_node_user_picture";i:1;s:27:"toggle_comment_user_picture";i:1;s:14:"toggle_favicon";i:1;s:12:"default_logo";i:0;s:9:"logo_path";s:40:"public://sweaver/logo_bartik_13_live.png";s:11:"logo_upload";s:0:"";s:15:"default_favicon";i:0;s:12:"favicon_path";s:43:"public://sweaver/favicon_bartik_13_live.png";s:14:"favicon_upload";s:0:"";}','0');
