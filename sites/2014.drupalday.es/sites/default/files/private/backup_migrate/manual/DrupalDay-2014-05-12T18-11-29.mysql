INSERT INTO `locales_target` VALUES ('10992','Evaluación de PHP','es','0','0','0'),('10993','reglas','es','0','0','0'),('10994','Conjuntos de reglas','es','0','0','0'),('10995','Agregar evento','es','0','0','0'),('10996','planificación','es','0','0','0'),('10997','Ordenar por','es','0','0','0'),('10998','¿Está seguro de que quiere habilitar el %plugin %label?','es','0','0','0'),('10999','¿Está seguro de que quiere deshabilitar el %plugin %label?','es','0','0','0'),('11000','¿Está seguro de que quiere revertir el %plugin %label?','es','0','0','0'),('11001','¿Está seguro de que quiere eliminar el %plugin %label?','es','0','0','0'),('11002','Se habilitó %plugin %label.','es','0','0','0'),('11003','Se deshabilitó %plugin %label.','es','0','0','0'),('11004','Se revirtió %plugin %label a los valores predeterminados.','es','0','0','0'),('11005','Se eliminó %plugin %label.','es','0','0','0'),('11006','Seleccione el %element a agregar','es','0','0','0'),('11007','¿Está seguro de que desea eliminar el %element_plugin %element_name?','es','0','0','0'),('11008','Reaccionar en evento','es','0','0','0'),('11009','Formato de fecha incorrecto. Especifique la fecha en el formato %format.','es','0','0','0'),('11010','Los nombres legibles por máquina deben contener solo letras minúsculas, números, y guiones bajos.','es','0','0','0'),('11011','Un nombre legible por humanos que describa brevemente la regla.','es','0','0','0'),('11012','Selectores de datos','es','0','0','0'),('11013','Eliminar datos','es','0','0','0'),('11014','Este formulario permite activar manualmente la ejecución del @plugin «%label». Si este componente requiere parámetros, escriba abajo los argumentos de ejecución correspondientes.','es','0','0','0'),('11015','Pegue una configuración exportada de Rules aquí.','es','0','0','0'),('11016','Si se marca, cualquier configuración existente con el mismo identificador será remplazada por la importación.','es','0','0','0'),('11017','La importación de @entity %label falló, ya existe un @entity con el mismo nombre de máquina. Marque la opción de sobreescritura para remplazarlo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('11018','La revisión de integridad para la configuración importada falló. Mensaje de error: %message.','es','0','0','0'),('11019','Usted no tiene suficientes permisos de acceso para importar esta configuración de Rules.','es','0','0','0'),('11020','Se importó @entity %label.','es','0','0','0'),('11021','rules_config','es','0','0','0'),('11022','Ordenar reglas que reaccionan en el mismo evento. Las reglas con mayor peso son evaluadas después de las reglas con menor peso.','es','0','0','0'),('11023','Agregar un nuevo !plugin','es','0','0','0'),('11024','Las tablas de base de datos para Rules 2.x han sido creadas. Las antiguas tablas de Rules 1.x todavía están disponibles y contienen sus reglas, las cuales aún no han sido actualizadas.','es','0','0','0'),('11025','Exportar %name','es','0','0','0'),('11026','Para importar, copie el contenido del área de texto y péguelo en la página de importación de la interfaz de administración de Rules. En caso de que la exportación no pase la revisión de integridad durante la importación, intente más bien usar el método de guardar a la base de datos y repare de forma manual su configuración después de la conversión.','es','0','0','0'),('11027','Este formulario permite convertir reglas o conjuntos de reglas de Rules 1.x a Rules 2.x.','es','0','0','0'),('11028','Después de la conversión, las antiguas reglas y conjuntos de reglas permanecerán en la base de datos hasta que las elimine de forma manual. De esa forma, puede asegurarse que la conversión haya salido bien antes de eliminar las antiguas reglas y conjuntos de reglas.','es','0','0','0'),('11029','Una vez que haya convertido con éxito su configuración, puede limpiar su base de datos y <a href="!url">eliminar</a> todas sus configuraciones de Rules 1.x.','es','0','0','0'),('11030','Moneda predeterminada','es','0','0','0'),('11031','Estado:','es','0','0','0'),('11032','Éxito','es','0','0','0'),('11033','Agregar a la cesta','es','0','0','0'),('11034','Enviado','es','0','0','0'),('11035','Fecha de vencimiento','es','0','0','0');
