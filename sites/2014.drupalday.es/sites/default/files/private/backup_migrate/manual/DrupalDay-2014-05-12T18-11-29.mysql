INSERT INTO `field_revision_body` VALUES ('node','page','0','66','227','und','0','<p>\r\n	<style type="text/css">\r\n.hoteles td {\r\n padding:5px;\r\n border:2px solid #ccc;\r\n vertical-align:middle;\r\n}	</style>\r\n</p>\r\n<p>Sitios cercanos para alimentaros para coger fuerzas.</p>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Bedoya 2</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.bedoya.com/Bedoya2.htm</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53F</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 9€</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<script src="http://maps.google.com/maps/api/js?sensor=false"  type="text/javascript"></script>\r\n<div id="map" style="width: 540px; height: 350px;">\r\n	&nbsp;</div>\r\n<script type="text/javascript">\r\n    var locations = [\r\n      [''Facultad de Ciencias'', 43.471359,-3.801144, 1],\r\n      [''Restaurante Santander Antiguo'', 43.469895,-3.804642, 2],\r\n      [''Restaurante Bedoya 2'', 43.471453,-3.796617, 3],\r\n    ];\r\n\r\n    var map = new google.maps.Map(document.getElementById(''map''), {\r\n      zoom: 13,\r\n      center: new google.maps.LatLng(43.471359,-3.801144),\r\n      mapTypeId: google.maps.MapTypeId.ROADMAP\r\n    });\r\n\r\n    var infowindow = new google.maps.InfoWindow();\r\n\r\n    var marker, i;\r\n\r\n    for (i = 0; i < locations.length; i++) {  \r\n      marker = new google.maps.Marker({\r\n        position: new google.maps.LatLng(locations[i][1], locations[i][2]),\r\n        map: map\r\n      });\r\n\r\n      google.maps.event.addListener(marker, ''click'', (function(marker, i) {\r\n        return function() {\r\n          infowindow.setContent(locations[i][0]);\r\n          infowindow.open(map, marker);\r\n        }\r\n      })(marker, i));\r\n    }\r\n  </script>','','full_html'),('node','page','0','66','231','und','0','<p>\r\n	<style type="text/css">\r\n.hoteles td {\r\n padding:5px;\r\n border:2px solid #ccc;\r\n vertical-align:middle;\r\n}	</style>\r\n</p>\r\n<p>Algunos sitios cercanos donde alimentarnos para coger fuerzas.</p>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Bedoya 2</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.bedoya.com/Bedoya2.htm</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53F</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 9€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Escudero</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53D</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 10€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Santander Antiguo</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.santanderantiguo.es/la-cafeteria-restaur-residencia-de-estudiantes-hotel.html</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 65A</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 10,50€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Parque de las Llamas</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				</td>\r\n			<td style="width: 120px;">\r\n				Parque de las Llamas, C/ Marino Fernández Fontecha, 4</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: </td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Cafetería ISAE</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.cafeteriaisae.com</td>\r\n			<td style="width: 120px;">\r\n				Calle Fernando de los Ríos, 56</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: </td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<script src="http://maps.google.com/maps/api/js?sensor=false"  type="text/javascript"></script>\r\n<div id="map" style="width: 540px; height: 350px;">\r\n	&nbsp;</div>\r\n<script type="text/javascript">\r\n    var locations = [\r\n      [''Facultad de Ciencias'', 43.471359,-3.801144, 1],\r\n      [''Restaurante Santander Antiguo'', 43.469895,-3.804642, 2],\r\n      [''Restaurante Bedoya 2'', 43.471453,-3.796617, 3],\r\n      [''Restaurante Escudero'', 43.471422,-3.797169, 4],\r\n      [''Restaurante Parque de las Llamas'', 43.47505,-3.800381, 5],\r\n      [''Cafetería ISAE'', 43.469247,-3.800951, 6],\r\n    ];\r\n\r\n    var map = new google.maps.Map(document.getElementById(''map''), {\r\n      zoom: 15,\r\n      center: new google.maps.LatLng(43.471359,-3.801144),\r\n      mapTypeId: google.maps.MapTypeId.ROADMAP\r\n    });\r\n\r\n    var infowindow = new google.maps.InfoWindow();\r\n\r\n    var marker, i;\r\n\r\n    for (i = 0; i < locations.length; i++) {  \r\n      marker = new google.maps.Marker({\r\n        position: new google.maps.LatLng(locations[i][1], locations[i][2]),\r\n        map: map\r\n      });\r\n\r\n      google.maps.event.addListener(marker, ''click'', (function(marker, i) {\r\n        return function() {\r\n          infowindow.setContent(locations[i][0]);\r\n          infowindow.open(map, marker);\r\n        }\r\n      })(marker, i));\r\n    }\r\n  </script>','','full_html');
INSERT INTO `field_revision_body` VALUES ('node','page','0','66','232','und','0','<p>\r\n	<style type="text/css">\r\n.hoteles td {\r\n padding:5px;\r\n border:2px solid #ccc;\r\n vertical-align:middle;\r\n}	</style>\r\n</p>\r\n<p>Durante el Drupal Day necesitaremos coger fuerzas para seguir con las charlas y sprints de la tarde, y os proponemos varias opciones:</p>\r\n<p>En Santander estaremos en plena Semana Grande, y las fiestas nos ofrecen la posibilidad de acercarnos a las <strong>casetas</strong> montadas para tan especial ocasión al lado de la feria, <strong>a tan solo 15 minutos andando de la Sede del Drupal Day</strong>. En ellas podremos degustar los mejores pinchos y platos de los restaurantes y cafeterías de la ciudad, por lo que es nuestra principal recomendación de cara a satisfacer vuestros estómagos.</p>\r\n<p>También os indicamos los restaurantes más cercanos donde poder comer un buen menú del día a precio económico o probar las raciones:</p>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Bedoya 2</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.bedoya.com/Bedoya2.htm</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53F</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 9€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Escudero</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53D</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 10€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Cafetería ISAE</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.cafeteriaisae.com</td>\r\n			<td style="width: 120px;">\r\n				Calle Fernando de los Ríos, 56</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 9,50€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Parque de las Llamas</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				</td>\r\n			<td style="width: 120px;">\r\n				Parque de las Llamas, C/ Marino Fernández Fontecha, 4</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 12€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Santander Antiguo</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.santanderantiguo.es/la-cafeteria-restaur-residencia-de-estudiantes-hotel.html</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 65A</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 10,50€</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<script src="http://maps.google.com/maps/api/js?sensor=false"  type="text/javascript"></script>\r\n<div id="map" style="width: 540px; height: 350px;">\r\n	&nbsp;</div>\r\n<script type="text/javascript">\r\n    var locations = [\r\n      [''Facultad de Ciencias'', 43.471359,-3.801144, 1],\r\n      [''Restaurante Santander Antiguo'', 43.469895,-3.804642, 2],\r\n      [''Restaurante Bedoya 2'', 43.471453,-3.796617, 3],\r\n      [''Restaurante Escudero'', 43.471422,-3.797169, 4],\r\n      [''Restaurante Parque de las Llamas'', 43.47505,-3.800381, 5],\r\n      [''Cafetería ISAE'', 43.469247,-3.800951, 6],\r\n      [''Casetas'', 43.475528,-3.793787, 7],\r\n    ];\r\n\r\n    var map = new google.maps.Map(document.getElementById(''map''), {\r\n      zoom: 15,\r\n      center: new google.maps.LatLng(43.472932,-3.799599),\r\n      mapTypeId: google.maps.MapTypeId.ROADMAP\r\n    });\r\n\r\n    var infowindow = new google.maps.InfoWindow();\r\n\r\n    var marker, i;\r\n\r\n    for (i = 0; i < locations.length; i++) {  \r\n      marker = new google.maps.Marker({\r\n        position: new google.maps.LatLng(locations[i][1], locations[i][2]),\r\n        map: map\r\n      });\r\n\r\n      google.maps.event.addListener(marker, ''click'', (function(marker, i) {\r\n        return function() {\r\n          infowindow.setContent(locations[i][0]);\r\n          infowindow.open(map, marker);\r\n        }\r\n      })(marker, i));\r\n    }\r\n  </script>','','full_html');
