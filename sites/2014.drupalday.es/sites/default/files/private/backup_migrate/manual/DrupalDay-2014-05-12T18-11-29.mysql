INSERT INTO `locales_source` VALUES ('470','','default','@type:@subtype will not display due to missing context','','none'),('471','','default','No info','','none'),('472','','default','No info available.','','none'),('473','','default','Configure new !subtype_title','','none'),('474','','default','All criteria must pass.','','none'),('475','','default','Only one criteria must pass.','','none'),('476','','default','Broken/missing access plugin %plugin','','none'),('477','','default','Configure settings for this item.','','none'),('478','','default','Remove this item.','','none'),('479','','default','No criteria selected, this test will pass.','','none'),('480','','default','Missing callback hooks.','','none'),('481','','default','Edit criteria','','none'),('482','','default','Invalid object name.','','none'),('483','','default','Invalid context type','','none'),('484','','default','Display page not found or display nothing at all.','','none'),('485','','default','Enter a title to use when this argument is present. You may use %KEYWORD substitution, where the keyword is specified below.','','none'),('486','','default','Unable to delete missing item!','','none'),('487','','default','Edit @type','','none'),('488','','default','Summary of contexts','','none'),('489','','default','Please choose which context and how you would like it converted.','','none'),('490','','default','@identifier (@keyword)','','none'),('491','','default',', and ','','none'),('492','','default',', or ','','none'),('493','','default','Built in context','','none'),('494','','default','Keyword: %@keyword','','none'),('495','','default','@keyword --&gt; @title','','none'),('496','','default','From "@title"','','none'),('497','','default','Unable to create CTools CSS cache directory. Check the permissions on your files directory.','','none'),('498','','default','Update and return','','none'),('499','','default','In code','','7.12');
INSERT INTO `locales_source` VALUES ('500','','default','Enabled, title','','none'),('501','','default','Get a summary of the information about this page.','','none'),('502','','default','Activate this page so that it will be in use in your system.','','none'),('503','','default','De-activate this page. The data will remain but the page will not be in use on your system.','','none'),('504','','default','Add variant','','none'),('505','','default','Add a new variant to this page.','','none'),('506','','default','Create variant','','none'),('507','','default','Import variant','','none'),('508','','default','Add a new variant to this page from code exported from another page.','','none'),('509','','default','Reorder variants','','none'),('510','','default','Change the priority of the variants to ensure that the right one gets selected.','','none'),('511','','default','Configure a newly created variant prior to actually adding it to the page.','','none'),('512','','default','Break the lock on this page so that you can edit it.','','none'),('513','','default','Variant operations','','none'),('514','','default','Get a summary of the information about this variant.','','none'),('515','','default','Make an exact copy of this variant.','','none'),('516','','default','Export this variant into code to import into another page.','','none'),('517','','default','Remove all changes to this variant and revert to the version in code.','','none'),('518','','default','Remove this variant from the page completely.','','none'),('519','','default','Activate this variant so that it will be in use in your system.','','none'),('520','','default','De-activate this variant. The data will remain but the variant will not be in use on your system.','','none'),('521','','default','No variants','','none'),('522','','default','This operation trail does not exist.','','none'),('523','','default','The page has been updated. Changes will not be permanent until you save.','','none'),('524','','default','Unable to update changes due to lock.','','none'),('525','','default','This setting contains unsaved changes.','','none');
INSERT INTO `locales_source` VALUES ('526','','default','You have unsaved changes to this page. You must select Save to write them to the database, or Cancel to discard these changes. Please note that if you have changed any form, you must submit that form before saving.','','none'),('527','','default','All pending changes have been discarded, and the page is now unlocked.','','none'),('528','','default','Administrative title of this variant. If you leave blank it will be automatically assigned.','','none'),('529','','default','Variant type','','none'),('530','','default','Optional features','','none'),('531','','default','Check any optional features you need to be presented with forms for configuring them. If you do not check them here you will still be able to utilize these features once the new page is created. If you are not sure, leave these unchecked.','','none'),('532','','default','Variant name','','none'),('533','','default','Enter the name of the new variant.','','none'),('534','','default','Paste variant code here','','none'),('535','','default','No variant found.','','none'),('536','','default','Unable to get a variant from the import. Errors reported: @errors','','none'),('537','','default','Reverting the variant will delete the variant that is in the database, reverting it to the original default variant. This deletion will not be made permanent until you click Save.','','none'),('538','','default','Are you sure you want to delete this variant? This deletion will not be made permanent until you click Save.','','none'),('539','','default','This variant is currently disabled. Enabling it will make it available in your system. This will not take effect until you save this page.','','none'),('540','','default','This variant is currently enabled. Disabling it will make it unavailable in your system, and it will not be used. This will not take effect until you save this page.','','none'),('541','','default','Breaking the lock on this page will <strong>discard</strong> any pending changes made by the locking user. Are you REALLY sure you want to do this?','','none');
INSERT INTO `locales_source` VALUES ('542','','default','The lock has been cleared and all changes discarded. You may now make changes to this page.','','none'),('543','','default','Enabling this page will immediately make it available in your system (there is no need to wait for a save.)','','none'),('544','','default','Disabling this page will immediately make it unavailable in your system (there is no need to wait for a save.)','','none'),('545','','default','This page has no variants and thus no output of its own.','','none'),('546','','default','Add a new variant','','none'),('547','','default','Unable to disable due to lock.','','none'),('548','','default','Unable to enable due to lock.','','none'),('549','','default','Add, edit and remove overridden system pages and user defined pages from the system.','','none'),('550','','default','Page manager','','none'),('551','','default','Provides a UI and API to manage pages within the site.','','7.12'),('552','','default','Node add/edit form','','none'),('553','','default','When enabled, this overrides the default Drupal behavior for adding or edit nodes at <em>node/%node/edit</em> and <em>node/add/%node_type</em>. If you add variants, you may use selection criteria such as node type or language or user access to provide different edit forms for nodes. If no variant is selected, the default Drupal node edit will be used.','','none'),('554','','default','Node being edited','','none'),('555','','default','When enabled, this overrides the default Drupal behavior for displaying nodes at <em>node/%node</em>. If you add variants, you may use selection criteria such as node type or language or user access to provide different views of nodes. If no variant is selected, the default Drupal node view will be used. This page only affects nodes viewed as pages, it will not affect nodes viewed in lists or at other locations. Also please note that if you are using pathauto, aliases may make a node to be somewhere else, but as far as Drupal is concerned, they are still at node/%node.','','none'),('556','','default','Node being viewed','','none');
INSERT INTO `locales_source` VALUES ('557','','default','Argument settings','','none'),('558','','default','A meaningless second page','','none'),('559','','default','Administrative title','','7.12'),('560','','default','The name of this page. This will appear in the administrative interface to easily identify it.','','none'),('561','','default','The machine readable name of this page. It must be unique, and it must contain only alphanumeric characters and underscores. Once created, you will not be able to change this value!','','none'),('562','','default','Administrative description','','none'),('563','','default','A description of what this page is, does or is for, for administrative use.','','none'),('564','','default','The URL path to get to this page. You may create named placeholders for variable parts of the path by using %name for required elements and !name for optional elements. For example: "node/%node/foo", "forum/%forum" or "dashboard/!input". These named placeholders can be turned into contexts on the arguments form.','','none'),('565','','default','Make this your site home page.','','none'),('566','','default','Visible menu item','','none'),('567','','default','Name is required.','','none'),('568','','default','That name is used by another page: @page','','none'),('569','','default','Page name must be alphanumeric or underscores only.','','none'),('570','','default','That path is used by another page: @page','','none'),('571','','default','You cannot have a dynamic path element after an optional path element.','','none'),('572','','default','You cannot have a static path element after an optional path element.','','none'),('573','','default','That path is currently assigned to be an alias for @alias. This system cannot override existing aliases.','','none'),('574','','default','You cannot make this page your site home page if it uses % placeholders.','','none'),('575','','default','Duplicated argument %arg','','none'),('576','','default','Invalid arg <em>%</em>. All arguments must be named with keywords.','','none'),('577','','default','When providing a menu item as a default tab, Drupal needs to know what the parent menu item of that tab will be. Sometimes the parent will already exist, but other times you will need to have one created. The path of a parent item will always be the same path with the last part left off. i.e, if the path to this view is <em>foo/bar/baz</em>, the parent path would be <em>foo/bar</em>.','','none');
INSERT INTO `locales_source` VALUES ('578','','default','Parent item title','','none'),('579','','default','Access rules are used to test if the page is accessible and any menu items associated with it are visible.','','none'),('580','','default','No context assigned','','none'),('581','','default','Position in path','','none'),('582','','default','Context assigned','','none'),('583','','default','The path %path has no arguments to configure.','','none'),('584','','default','Invalid keyword.','','none'),('585','','default','Change context type','','none'),('586','','default','Change argument','','none'),('587','','default','No context selected','','none'),('588','','default','Error: missing argument.','','none'),('589','','default','Context identifier','','none'),('590','','default','This is the title of the context used to identify it later in the administrative process. This will never be shown to a user.','','none'),('591','','default','Error: missing or invalid argument plugin %argument.','','none'),('592','','default','Import page','','none'),('593','','default','Enter the name to use for this page if it is different from the source page. Leave blank to use the original name of the page.','','none'),('594','','default','Enter the path to use for this page if it is different from the source page. Leave blank to use the original path of the page.','','none'),('595','','default','Allow overwrite of an existing page','','none'),('596','','default','If the name you selected already exists in the database, this page will be allowed to overwrite the existing page.','','none'),('597','','default','Paste page code here','','none'),('598','','default','No handler found.','','none'),('599','','default','Unable to get a page from the import. Errors reported: @errors','','none'),('600','','default','That page name is in use and locked by another user. You must <a href="!break">break the lock</a> on that page before proceeding, or choose a different name.','','none'),('601','','default','Enter the name to the new page It must be unique and contain only alphanumeric characters and underscores.','','none');
INSERT INTO `locales_source` VALUES ('602','','default','The URL path to get to this page. You may create named placeholders for variable parts of the path by using %name for required elements and !name for optional elements. For example: "node/%node/foo", "forum/%forum" or "dashboard/!input". These named placeholders can be turned into contexts on the arguments form. You cannot use the same path as the original page.','','none'),('603','','default','Clone variants','','none'),('604','','default','If checked all variants associated with the page will be cloned as well. If not checked the page will be cloned without variants.','','none'),('605','','default','Reverting the page will delete the page that is in the database, reverting it to the original default page. Any changes you have made will be lost and cannot be recovered.','','none'),('606','','default','The page has been reverted.','','none'),('607','','default','Administrator created pages that have a URL path, access control and entries in the Drupal menu system.','','none'),('608','','default','Create a new page','','none'),('609','','default','Edit name, path and other basic settings for the page.','','none'),('610','','default','Set up contexts for the arguments on this page.','','none'),('611','','default','Control what users can access this page.','','none'),('612','','default','Provide this page a visible menu or a menu tab.','','none'),('613','','default','Make a copy of this page','','none'),('614','','default','Export this page as code that can be imported or embedded into a module.','','none'),('615','','default','Remove all changes to this page and revert to the version in code.','','none'),('616','','default','Remove this page from your system completely.','','none'),('617','','default','This is your site home page.','','none'),('618','','default','This page is set to become your site home page.','','none'),('619','','default','Accessible only if @conditions.','','none'),('620','','default','This page is publicly accessible.','','none'),('621','','default','No menu entry.','','none'),('622','','default','Normal menu entry.','','none');
INSERT INTO `locales_source` VALUES ('623','','default','Menu tab.','','none'),('624','','default','Default menu tab.','','none'),('625','','default','Title: %title.','','none'),('626','','default','Parent title: %title.','','none'),('627','','default','Menu block: %title.','','none'),('628','','default','Taxonomy term template','','none'),('629','','default','When enabled, this overrides the default Drupal behavior for displaying taxonomy terms at <em>taxonomy/term/%term</em>. If you add variants, you may use selection criteria such as vocabulary or user access to provide different displays of the taxonomy term and associated nodes. If no variant is selected, the default Drupal taxonomy term display will be used. This page only affects items actually displayed ad taxonomy/term/%term. Some taxonomy terms, such as forums, have their displays moved elsewhere. Also please note that if you are using pathauto, aliases may make a taxonomy terms appear somewhere else, but as far as Drupal is concerned, they are still at taxonomy/term/%term.','','none'),('630','','default','Term(s) being viewed','','none'),('631','','default','Term being viewed','','none'),('632','','default','Allow multiple terms on taxonomy/term/%term','','none'),('633','','default','Single term','','none'),('634','','default','Multiple terms','','none'),('635','','default','By default, Drupal allows multiple terms as an argument by separating them with commas or plus signs. If you set this to single, that feature will be disabled.','','none'),('636','','default','Inject hierarchy of first term into breadcrumb trail','','none'),('637','','default','If checked, taxonomy term parents will appear in the breadcrumb trail.','','none'),('638','','default','Multiple terms may be used, separated by , or +.','','none'),('639','','default','Only a single term may be used.','','none'),('640','','default','%term','','none'),('641','','default','Breadcrumb trail will contain taxonomy term hierarchy','','none'),('642','','default','Breadcrumb trail will not contain taxonomy term hiearchy.','','none'),('643','','default','User profile template','','none');
INSERT INTO `locales_source` VALUES ('644','','default','When enabled, this overrides the default Drupal behavior for displaying user profiles at <em>user/%user</em>. If you add variants, you may use selection criteria such as roles or user access to provide different views of user profiles. If no variant is selected, the default Drupal user view will be used. Please note that if you are using pathauto, aliases may make a node to be somewhere else, but as far as Drupal is concerned, they are still at user/%user.','','none'),('645','','default','User being viewed','','none'),('646','','default','This page is being edited by another user and you cannot make changes to it.','','none'),('647','','default','This page is newly created and has not yet been saved to the database. It will not be available until you save it.','','none'),('648','','default','This page has been modified, but these modifications are not yet live. While modifying this page, it is locked from modification by other users.','','none'),('649','','default','No task handlers are defined for this task.','','none'),('650','','default','Variant','','none'),('651','','default','This page is being edited by user !user, and is therefore locked from editing by others. This lock is !age old. Click here to <a href="!break">break this lock</a>.','','none'),('652','','default','User: compare','','none'),('653','','default','Compare two users (logged-in user and user being viewed, for example)','','none'),('654','','default','First User','','none'),('655','','default','Second User','','none'),('656','','default','Grant access based on comparison of the two user contexts. For example, to grant access to a user to view their own profile, choose "logged in user" and "user being viewed" and say "grant access if equal". When they''re the same, access will be granted.','','none'),('657','','default','Grant access if user contexts are','','none'),('658','','default','Not equal','','none'),('659','','default','@id1 @comp @id2','','none'),('660','','default','Node: accessible','','none'),('661','','default','Control access with built in Drupal node access test.','','none');
INSERT INTO `locales_source` VALUES ('662','','default','Create nodes of the same type','','none'),('663','','default','Using built in Drupal node access rules, determine if the user can perform the selected operation on the node.','','none'),('664','','default','@user can view @node.','','none'),('665','','default','@user can edit @node.','','none'),('666','','default','@user can delete @node.','','none'),('667','','default','@user can create nodes of the same type as @node.','','none'),('668','','default','Node: language','','none'),('669','','default','Control access by node language.','','none'),('670','','default','Current site language','','none'),('671','','default','Pass only if the node is in one of the selected languages.','','none'),('672','','default','@identifier is in any language','','none'),('673','','default','@identifier language is "@languages"','','none'),('674','','default','@identifier language is one of "@languages"','','none'),('675','','default','Node: type','','none'),('676','','default','Only the checked node types will be valid.','','none'),('677','','default','@identifier is any node type','','none'),('678','','default','@identifier is type "@types"','','none'),('679','','default','@identifier type is one of "@types"','','none'),('680','','default','User: permission','','none'),('681','','default','Control access by permission string.','','none'),('682','','default','Error, unset permission','','none'),('683','','default','@identifier has "@perm"','','none'),('684','','default','Control access through arbitrary PHP code.','','none'),('685','','default','Administrative desc','','none'),('686','','default','A description for this test for administrative purposes.','','none'),('687','','default','Access will be granted if the following PHP code returns <code>TRUE</code>. Do not include &lt;?php ?&gt;. Note that executing incorrect PHP-code can break your Drupal site. All contexts will be available in the <em>$contexts</em> variable.','','none'),('688','','default','You do not have sufficient permissions to edit PHP code.','','none'),('689','','default','User: role','','none');
INSERT INTO `locales_source` VALUES ('690','','default','Control access by role.','','none'),('691','','default','Only the checked roles will be granted access.','','none'),('692','','default','@identifier can have any role','','none'),('693','','default','@identifier has role "@roles"','','none'),('694','','default','@identifier has one of "@roles"','','none'),('695','','default','User: language','','none'),('696','','default','Control access by the language the user or site currently uses.','','none'),('697','','default','Pass only if the current site language is one of the selected languages.','','none'),('698','','default','Site language is any language','','none'),('699','','default','Site language is "@languages"','','none'),('700','','default','Site language is one of "@languages"','','none'),('701','','default','Taxonomy: vocabulary','','none'),('702','','default','@identifier is any vocabulary','','none'),('703','','default','@identifier vocabulary is "@vids"','','none'),('704','','default','@identifier vocabulary is one of "@vids"','','none'),('705','','default','Creates a node context from a node ID argument.','','none'),('706','','default','Enter the node ID of a node for this argument','','none'),('707','','default','Creates a node add form context from a node type argument.','','none'),('708','','default','Creates a node edit form context from a node ID argument.','','none'),('709','','default','A string is a minimal context that simply holds a string that can be used for some other purpose.','','none'),('710','','default','Enter a value for this argument','','none'),('711','','default','Creates a single taxonomy term from a taxonomy ID or taxonomy term name.','','none'),('712','','default','Inject hierarchy into breadcrumb trail','','none'),('713','','default','Enter a taxonomy term ID.','','none'),('714','','default','Enter a taxonomy term name.','','none'),('715','','default','Creates a group of taxonomy terms from a list of tids separated by a comma or a plus sign. In general the first term of the list will be used for panes.','','none'),('716','','default','Enter a term ID or a list of term IDs separated by a + or a ,','','none');
INSERT INTO `locales_source` VALUES ('717','','default','Creates a user context from a user ID argument.','','none'),('718','','default','Enter the user ID of a user for this argument','','none'),('719','','default','Creates a vocabulary context from a vocabulary ID argument.','','none'),('720','','default','Enter the vocabulary ID for this argument','','none'),('721','','default','Use context keywords','','none'),('722','','default','If checked, context keywords will be substituted in this content.','','none'),('723','','default','Substitutions','','none'),('724','','default','@identifier: @title','','none'),('725','','default','Everything in the form that is not displayed by other content.','','7.12'),('726','','default','The author of the referenced node.','','7.12'),('727','','default','Link to author profile','','none'),('728','','default','Check here to link to the node author profile.','','none'),('729','','default','"@s" author','','none'),('730','','default','The body of the referenced node.','','7.12'),('731','','default','"@s" body','','none'),('732','','default','Make all views available as panes','','none'),('733','','default','If checked, all views will be made available as content panes to be added to content types. If not checked, only Views that have a ''Content pane'' display will be available as content panes. Uncheck this if you want to be able to more carefully control what view content is available to users using the panels layout UI.','','none'),('734','','default','Select display','','none'),('735','','default','Choose which display of this view you wish to use.','','none'),('736','','default','Configure view @view (@display)','','none'),('737','','default','View: @name','','none'),('738','','default','Using display @display.','','none'),('739','','default','With pager.','','none'),('740','','default','Without pager.','','none'),('741','','default','With feed icon.','','none'),('742','','default','Using arguments: @args','','none'),('743','','default','Link title to page','','none'),('744','','default','Provide a "more" link.','','none'),('745','','default','Num items','','none');
INSERT INTO `locales_source` VALUES ('746','','default','Content pane','','none'),('747','','default','Pane settings','','none'),('748','','default','Use view name','','none'),('749','','default','Admin desc','','none'),('750','','default','Argument input','','none'),('751','','default','Allow settings','','none'),('752','','default','Pager offset','','none'),('753','','default','Panel pages can be used as landing pages. They have a URL path, accept arguments and can have menu entries.','','none'),('754','','default','Panel page','','none'),('755','','default','Go to list','','none'),('756','','default','Selection rules','','none'),('757','','default','Control the criteria used to decide whether or not this variant is used.','','none'),('758','','default','Add additional context objects to this variant that can be used by the content.','','none'),('759','','default','This panel will be selected if @conditions.','','none'),('760','','default','This panel will always be selected.','','none'),('761','','default','Selection rule','','none'),('762','','default','Panel: @title','','none'),('763','','default','Administrative title of this variant.','','none'),('764','','default','Demonstration code, advanced help, and a demo panel to show how to build ctools plugins.','','none'),('765','','default','The CTools Plugin Example is simply a developer''s demo of how to create plugins for CTools. It provides no useful functionality for an ordinary user.','','none'),('766','','default','There is a demo panel demonstrating much of the functionality provided at\n    <a href="@demo_url">CTools demo panel</a>, and you can find documentation on the examples at\n    !ctools_plugin_example_help.\n    CTools itself provides documentation at !ctools_help. Mostly, though, the code itself is intended to be the teacher.\n    You can find it in %path.','','none'),('767','','default','CTools plugin example','','none'),('768','','default','Chaos Tools (CTools) Plugin Example','','none'),('769','','default','Shows how an external module can provide ctools plugins (for Panels, etc.).','','7.12'),('770','','default','Arg length','','none');
INSERT INTO `locales_source` VALUES ('771','','default','Control access by length of simplecontext argument.','','none'),('772','','default','Grant access if simplecontext argument length is','','none'),('773','','default','Length of simplecontext argument','','none'),('774','','default','Access/visibility will be granted based on arg length.','','none'),('775','','default','Simpletext argument must be !comp @length characters','','none'),('776','','default','CTools example: role','','none'),('777','','default','@identifier must have role "@roles"','','none'),('778','','default','@identifier can be one of "@roles"','','none'),('779','','default','Creates a "simplecontext" from the arg.','','none'),('780','','default','Enter the simplecontext arg','','none'),('781','','default','CTools example no context content type','','none'),('782','','default','No context content type - requires and uses no context.','','none'),('783','','default','CTools Examples','','none'),('784','','default','The setting for item 1.','','none'),('785','','default','The setting for item 2','','none'),('786','','default','Config Item 1 (relcontext)','','none'),('787','','default','Setting for relcontext.','','none'),('788','','default','Relcontext setting','','none'),('789','','default','Just an example setting.','','none'),('790','','default','An example setting that could be used to configure a context','','none'),('791','','default','See the getting started guide for more information.','','none'),('792','','default','Before this variant can be added, it must be configured. When you are finished, click "Create variant" at the end of this wizard to add this to your page.','','none'),('793','','default','Page manager module is unable to enable node/%node/edit because some other module already has overridden with %callback.','','none'),('794','','default','Page manager module is unable to override @path because some other module already has overridden with %callback. Node edit will be enabled but that edit path will not be overridden.','','none'),('795','','default','Page manager module is unable to enable node/%node because some other module already has overridden with %callback.','','none');
INSERT INTO `locales_source` VALUES ('796','','default','Paths with non optional placeholders cannot be used as normal menu items unless the selected argument handler provides a default argument to use for the menu item.','','none'),('797','','default','Page manager module is unable to enable user/%user because some other module already has overridden with %callback.','','none'),('798','','default','Existing node','','7.12'),('799','','default','Enter the title or NID of a node','','none'),('800','','default','Include node links for "add comment", "read more" etc.','','none'),('801','','default','Template identifier','','none'),('802','','default','Add the slogan trail as content.','','7.12'),('803','','default','Add the tabs (local tasks) as content.','','7.12'),('804','','default','Add the page title as content.','','7.12'),('805','','default','Manage pages','','none'),('806','','default','This page is currently locked for editing by you. Nobody else may edit this page until these changes are saved or canceled.','','none'),('807','','default','This page is currently locked for editing by another user. You may not edit this page without breaking the lock.','','none'),('808','','default','When enabled, this overrides the default Drupal behavior for the all blogs at <em>/blog</em>. If no variant is selected, the default Drupal most recent blog posts will be shown.','','none'),('809','','default','Page manager module is unable to enable blog because some other module already has overridden with %callback.','','none'),('810','','default','User blog','','none'),('811','','default','When enabled, this overrides the default Drupal behavior for displaying user blogs at <em>blog/%user</em>. If no variant is selected, the default Drupal user blog will be used.','','none'),('812','','default','Page manager module is unable to enable blog/%user because some other module already has overridden with %callback.','','none'),('813','','default','Site contact page','','none'),('814','','default','When enabled, this overrides the default Drupal behavior for the site contact page at <em>/contact</em>. If no variant is selected, the default Drupal contact form will be used.','','none');
INSERT INTO `locales_source` VALUES ('815','','default','Page manager module is unable to enable contact because some other module already has overridden with %callback.','','none'),('816','','default','User contact','','none'),('817','','default','When enabled, this overrides the default Drupal behavior for displaying the user contact form at <em>user/%user/contact</em>. If no variant is selected, the default Drupal user contact form will be used.','','none'),('818','','default','Page manager module is unable to enable user/%user/contact because some other module already has overridden with %callback.','','none'),('819','','default','You cannot have an unnamed placeholder (% or ! by itself). Please name your placeholder by adding a short piece of descriptive text to the % or !, such as %user or %node.','','none'),('820','','default','All polls','','none'),('821','','default','When enabled, this overrides the default Drupal behavior for the polls at <em>/poll</em>. If no variant is selected, the default Drupal most recent polls will be shown.','','none'),('822','','default','Page manager module is unable to enable poll because some other module already has overridden with %callback.','','none'),('823','','default','Search @type','','none'),('824','','default','Taxonomy: term','','none'),('825','','default','Control access by a specific term.','','none'),('826','','default','Select a term or terms from @vocabulary.','','none'),('827','','default','@term can be the term "@terms"','','none'),('828','','default','@term can be one of these terms: @terms','','none'),('829','','default','Node add form: node type','','none'),('830','','default','Node edit form: node ID','','none'),('831','','default','Get all arguments after this one','','none'),('832','','default','If checked, this string will include all arguments. For example, if the path is "path/%" and the user visits "path/foo/bar", if this is not checked the string will be "foo". If it is checked the string will be "foo/bar".','','none'),('833','','default','Taxonomy term: ID','','none'),('834','','default','Taxonomy term (multiple): ID','','none');
INSERT INTO `locales_source` VALUES ('835','','default','User: name','','none'),('836','','default','Creates a user context from a user name.','','none'),('837','','default','Enter the username of a user for this argument','','none'),('838','','default','Vocabulary: ID','','none'),('839','','default','The site contact form that allows users to send a message to site administrators.','','7.12'),('840','','default','The site contact form that allows users to contact other users.','','7.12'),('841','','default','Contact @name','','none'),('842','','default','Custom: @title','','none'),('843','','default','This title will be used administratively to identify this pane. If blank, the regular title will be used.','','none'),('844','','default','Advanced search form','','7.12'),('845','','default','A search form with advanced options.','','7.12'),('846','','default','Same page','','none'),('847','','default','@type search form','','none'),('848','','default','Override "no result" text','','none'),('849','','default','@type search result','','none'),('850','','default','HTML-safe string','','none'),('851','','default','Custom pager settings','','none'),('852','','default','Use different pager settings from view settings','','none'),('853','','default','The number of items to skip and not display.','','none'),('854','','default','Select this to send all arguments from the panel directly to the view. If checked, the panel arguments will come after any context arguments above and precede any additional arguments passed in through the Arguments field below. Note that arguments do not include the base URL; only values after the URL or set as placeholders are considered arguments.','','none'),('855','','default','Additional arguments to send to the view as if they were part of the URL in the form of arg1/arg2/arg3. You may use %0, %1, ..., %N to grab arguments from the URL. Or use @0, @1, @2, ..., @N to use arguments passed into the panel. Note: use these values only as a last resort. In future versions of Panels these may go away.','','none'),('856','','default','Context is optional','','none');
INSERT INTO `locales_source` VALUES ('857','','default','styles','','none'),('858','','default','Thickness','','none'),('859','','default','Lighter','','7.10'),('860','','default','Bolder','','7.10'),('861','','default','Searched %type for %keys.','','none'),('862','','default','Unable to complete operation. Fatal error in @file on line @line: @message','','none'),('863','','default','no real context','','none'),('864','','default','- Choose -','','7.12'),('865','','default','Update and save','','none'),('866','','default','The page has been updated and saved.','','none'),('867','','default','There are currently no variants available and a page may not be added. Perhaps you need to install the Panels module to get a variant?','','none'),('868','','default','To set this panel as your home page you must create a unique path name with no % placeholders in the path. The site home page is currently set to %homepage on the !siteinfo configuration form.','','none'),('869','','default','This page is currently set to be your site home page. This can be modified on the !siteinfo configuration form.','','none'),('870','','default','That path is already in use. This system cannot override existing paths.','','none'),('871','','default','Context exists','','none'),('872','','default','Check to see if the context exists (contains data) or does not exist (contains no data). For example, if a context is optional and the path does not contain an argument for that context, it will not exist.','','none'),('873','','default','Doesn''t exist','','none'),('874','','default','@identifier exists','','none'),('875','','default','@identifier does not exist','','none'),('876','','default','String: comparison','','none'),('877','','default','Control access by string match.','','none'),('878','','default','Not equal to regular expression','','none'),('879','','default','If using a regular expression, you should enclose the pattern in slashes like so: <em>/foo/</em>. If you need to compare against slashes you can use another character to enclose the pattern, such as @. See <a href="http://www.php.net/manual/en/reference.pcre.pattern.syntax.php">PHP regex documentation</a> for more.','','none');
