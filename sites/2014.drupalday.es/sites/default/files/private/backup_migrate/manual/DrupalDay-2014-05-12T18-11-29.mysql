INSERT INTO `locales_source` VALUES ('6824','','default','Show the comment link in the form used on standard node teasers, rather than the full node form.','','none'),('6825','','default','Click sort column','','7.12'),('6826','','default','Used by Style: Table to determine the actual column to click sort the field on. The default is usually fine.','','7.12'),('6827','','default','Group column','','none'),('6828','','default','Select the column of this field to apply the grouping function selected above.','','none'),('6829','','default','Group columns (additional)','','none'),('6830','','default','Select any additional columns of this field to include in the query and to group on.','','none'),('6831','','default','Display download path instead of file storage URI','','none'),('6832','','default','This will provide the full download URL rather than the internal filestream address.','','none'),('6833','','default','The machine name for the vocabulary the term belongs to.','','none'),('6834','','default','Display error message','','7.10'),('6835','','default','Term name converted to Term ID','','7.12'),('6836','','default','No comment','','7.12'),('6837','','default','Comment or document this display.','','7.12'),('6838','','default','Query settings','','7.12'),('6839','','default','Allow to set some advanced settings for the query plugin','','7.12'),('6840','','default','The name and the description of this display','','7.12'),('6841','','default','This name will appear only in the administrative interface for the View.','','7.12'),('6842','','default','This description will appear only in the administrative interface for the View.','','7.12'),('6843','','default','This display''s comments','','none'),('6844','','default','This value will be seen and used only within the Views UI and can be used to document this display. You can use this to provide notes for other or future maintainers of your site about how or why this display is configured.','','none'),('6845','','default','Query options','','none'),('6846','','default','Display name must be letters, numbers, or underscores only.','','none');
INSERT INTO `locales_source` VALUES ('6847','','default','Should this display inherit its paging values from the parent display to which it is attached?','','none'),('6848','','default','Should this display render the pager values? This is only meaningful if inheriting a pager.','','none'),('6849','','default','This will appear as the name of this block in administer >> structure >> blocks.','','7.12'),('6850','','default','Text to display instead of results until the user selects and applies an exposed filter.','','none'),('6851','','default','Include all items option','','7.12'),('6852','','default','If checked, an extra item will be included to items per page to display all items','','7.12'),('6853','','default','All items label','','7.12'),('6854','','default','Which label will be used to display all items','','7.12'),('6855','','default','Disable SQL rewriting','','none'),('6856','','default','WARNING: Disabling SQL rewriting means that node access security is disabled. This may allow users to see data they should not be able to see if your view is misconfigured. Please use this option only if you understand and accept this security risk.','','none'),('6857','','default','Use Slave Server','','none'),('6858','','default','This will make the query attempt to connect to a slave server if available.  If no slave server is defined or available, it will fall back to the default server.','','none'),('6859','','default','Field Language','','7.12'),('6860','','default','All fields which support translations will be displayed in the selected language.','','7.12'),('6861','','default','The class to provide on each row.','','7.12'),('6862','','default','Table summary','','7.12'),('6863','','default','This value will be displayed as table-summary attribute in the html. Set this for better accessiblity of your site.','','7.12'),('6864','','default','If checked, the current path will be displayed as the default option in the jump menu, if applicable.','','7.12'),('6865','','default','The class to provide on the wrapper, outside the list.','','none'),('6866','','default','List class','','none');
INSERT INTO `locales_source` VALUES ('6867','','default','The class to provide on the list element itself.','','none'),('6868','','default','Define the base path for links in this summary\n        view, i.e. http://example.com/<strong>your_view_path/archive</strong>.\n        Do not include beginning and ending forward slash. If this value\n        is empty, views will use the first path found as the base path,\n        in page displays, or / if no path could be found.','','7.12'),('6869','','default','Content access','','7.12'),('6870','','default','Content revisions','','7.12'),('6871','','default','Machine name: ','','7.12'),('6872','','default','Bypass views access control','','7.12'),('6873','','default','No results behavior','','7.12'),('6874','','default','Edit @section','','7.12'),('6875','','default','Edit this view to add a display.','','none'),('6876','','default','Add view from template','','7.12'),('6877','','default','View to insert','','none'),('6878','','default','The view to insert into this area.','','none'),('6879','','default','Inherit contextual filters','','none'),('6880','','default','If checked, this view will receive the same contextual filters as its parent.','','none'),('6881','','default','Recursion detected in view @view display @display.','','none'),('6882','','default','When the filter value is <em>NOT</em> in the URL','','7.10'),('6883','','default','Exception value','','7.12'),('6884','','default','If this value is received, the filter will be ignored; i.e, "all values"','','7.12'),('6885','','default','Override the view and other argument titles. Use "%1" for the first argument, "%2" for the second, etc.','','7.12'),('6886','','default','When the filter value <em>IS</em> in the URL or a default is provided','','7.10'),('6887','','default','Provide title','','7.12'),('6888','','default','Override breadcrumb','','7.12'),('6889','','default','Provide breadcrumb','','7.12'),('6890','','default','Enter a breadcrumb name you would like to