CREATE TABLE `tracker_node` (   `nid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The node.nid this record tracks.',   `published` tinyint(4) DEFAULT '0' COMMENT 'Boolean indicating whether the node is published.',   `changed` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The Unix timestamp when the node was most recently saved or commented on.',   PRIMARY KEY (`nid`),   KEY `tracker` (`published`,`changed`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Tracks when nodes were last changed or commented on.';
