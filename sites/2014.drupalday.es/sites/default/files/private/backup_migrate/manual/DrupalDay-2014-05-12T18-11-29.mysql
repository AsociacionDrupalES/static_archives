INSERT INTO `locales_source` VALUES ('10095','','default','Defines menu items common to the various Drupal Commerce UI modules.','','7.12'),('10096','/admin/modules','default','Defines the Customer entity with Address Field integration.','','7.12'),('10097','/admin/modules','default','Exposes a default UI for Customers through profile edit forms and default Views.','','7.12'),('10098','/admin/modules','default','Defines the Line Item entity and associated features.','','7.12'),('10099','/admin/modules','default','Exposes a default UI for Line Items through line item type forms and default Views.','','7.12'),('10100','/admin/modules','default','Defines the Order entity and associated features.','','7.12'),('10101','/admin/modules','default','Exposes a default UI for Orders through order edit forms and default Views.','','7.12'),('10102','/admin/modules','default','Implement core payment features for Drupal commerce.','','7.12'),('10103','/admin/modules','default','Provides an example payment method for testing and development.','','7.12'),('10104','/admin/modules','default','Exposes a default UI for payment method configuration and payment transaction administration.','','7.12'),('10105','/admin/modules','default','Defines the price field and a price alteration system.','','7.12'),('10106','/admin/modules','default','Defines the Product entity and associated features.','','7.12'),('10107','/admin/modules','default','Enables Rules based product sell price calculation for dynamic product pricing.','','7.12'),('10108','/admin/modules','default','Exposes a UI for managing product pricing rules and pre-calculation settings.','','7.12'),('10109','/admin/modules','default','Defines a product reference field and default display formatters.','','7.12'),('10110','/admin/modules','default','Exposes a default UI for Products through product edit forms and default Views.','','7.12'),('10111','/admin/modules','default','Define tax rates and configure tax rules for applicability an