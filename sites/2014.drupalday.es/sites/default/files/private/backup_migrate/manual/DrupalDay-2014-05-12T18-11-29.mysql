INSERT INTO `locales_source` VALUES ('5713','','default','Existing block regions','','none'),('5714','','default','Manage your views templates.','','7.12'),('5715','','default','You have not defined any styles which can be used on regions.','','7.12'),('5716','','default','Manage layout','','7.12'),('5717','','default','Fluid two column stacked','','7.12'),('5718','','default','Fluid three column stacked - 25/50/25','','7.12'),('5719','','default','Configure styles which you can add to regions on the "manage display" screens. Add multiple styles line per line.<br />If you want to have a friendly name, separate class and friendly name by |, but this is not required. eg:<br /><em>class_name_1<br />class_name_2|Friendly name<br />class_name_3</em>','','7.10'),('5720','','default','Field display','','none'),('5721','','default','Choose a field style','','none'),('5722','','default','Outer wrapper','','none'),('5723','','default','Field items','','none'),('5724','','default','Field item','','none'),('5725','','default','Classes: !classes','','none'),('5726','','default','Expert','','7.10'),('5727','','default','Field Templates','','7.10'),('5728','','default','Enable Field Templates','','7.10'),('5729','','default','Customize the labels and the HTML output of your fields.','','7.10'),('5730','','default','Extra fields','','7.10'),('5731','','default','Enable extra fields','','7.10'),('5732','','default','Make fields from other modules available on the "Manage display" screens.','','7.10'),('5733','','default','Add contextual links (if possible) to manage the layout.','','7.10'),('5734','','default','Create additional regions exposed as block. Note: this will not work on the default view mode.','','7.10'),('5735','','default','Manage view modes','','7.12'),('5736','','default','Check this to have the page disable all sidebar regions displayed in the theme. Note that some themes support this setting better than others. If in doubt, try with stock themes to see.','','7.12')