INSERT INTO `variable` VALUES ('update_last_check','i:1337341208;'),('update_notify_emails','a:1:{i:0;s:24:"ldotlopez+dday@gmail.com";}'),('user_admin_role','s:1:"3";'),('user_cancel_method','s:17:"user_cancel_block";'),('user_default_timezone','s:1:"0";'),('user_email_verification','i:1;'),('user_mail_cancel_confirm_body','s:385:"[user:name],\r\n\r\nSe ha realizado una petición para cancelar su cuenta en [site:name].\r\n\r\nPuede cancelar su cuenta en [site:url-brief] haciendo clic en este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:cancel-url]\r\n\r\nNOTA: La cancelación de su cuenta no es reversible.\r\n\r\nEste enlace caduca al cabo de un día y no pasa nada si no se usa.\r\n\r\n--  El equipo de [site:name]";'),('user_mail_cancel_confirm_subject','s:65:"Petición de cancelación de cuenta de [user:name] en [site:name]";'),('user_mail_password_reset_body','s:452:"[user:name],\r\n\r\nRecibimos en [site:name] una solicitud para restablecer la contraseña de su cuenta\r\n\r\nAhora puede iniciar una sesión haciendo clic en este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace es para un único inicio de sesión y le llevará a una página donde podrá establecer su contraseña. El enlace caduca al cabo de un día y no pasa nada si no se usa.\r\n\r\n--  El equipo de [site:name]";'),('user_mail_password_reset_subject','s:78:"Información de reemplazo de inicio de sesión para [user:name] en [site:name]";'),('user_mail_register_admin_created_body','s:555:"[user:name],\r\n\r\nMuchas gracias por comprar tu entrada para el Drupal Day Valencia 2012. Ahora puede iniciar una sesión haciendo clic en este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace es para un único inicio de sesión y le llevará a una página donde podrá establecer su contraseña.\r\n\r\nTras establecer su contraseña, en el futuro podrá iniciar sesión identificándose en [site:login-url] con los datos:\r\n\r\nUsuario: [user:name]\r\nContraseña: Su contraseña\r\n\r\n¡Nos vemos el día 28 en Valencia!";');
INSERT INTO `variable` VALUES ('user_mail_register_admin_created_subject','s:63:"Un administrador ha creado para usted una cuenta en [site:name]";'),('user_mail_register_no_approval_required_body','s:523:"[user:name],\r\n\r\nGracias por hacer tu preinscripción en el [site:name]. Ahora puede iniciar sesión pulsando este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace es para un único inicio de sesión y le llevará a una página donde podrá establecer su contraseña.\r\n\r\nTras establecer su contraseña, en el futuro podrá iniciar sesión identificándose en [site:login-url]:\r\n\r\nNombre de usuario: [user:name]\r\ncontraseña: Su contraseña\r\n\r\n¡Nos vemos el día 28 en Valencia!";'),('user_mail_register_no_approval_required_subject','s:51:"Detalles de la cuenta de [user:name] en [site:name]";'),('user_mail_register_pending_approval_body','s:311:"[user:name],\r\n\r\nGracias por registrarse en [site:name]. Su petición de una cuenta de usuario está pendiente de aprobación. Una vez haya sido aprobada, recibirá un nuevo correo electrónico con la información necesaria para iniciar sesión, disponer su clave y otros detalles.\r\n\r\n-- El equipo de [site:name]";'),('user_mail_register_pending_approval_subject','s:93:"Detalles de la cuenta de [user:name] en [site:name] (pendiente de aprobación administrativa)";'),('user_mail_status_activated_body','s:479:"[user:name],\r\n\r\nSu cuenta en [site:name] ha sido activada.\r\n\r\nAhora ya puede conectarse pulsando este enlace o pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace sólo puede usarse una vez para conectarse y le llevará a una página en la que podrá establecer su contraseña.\r\n\r\nDespués de establecer su contraseña, podrá conectarse a [site:login-url] en el futuro usando:\r\n\r\nUsuario: [user:name]\r\nContraseña: Su contraseña\r\n\r\n--  El equipo [site:name]";'),('user_mail_status_activated_notify','i:1;'),('user_mail_status_activated_subject','s:62:"Detalles de la cuenta de [user:name] en [site:name] (aprobada)";');
INSERT INTO `variable` VALUES ('user_mail_status_blocked_body','s:91:"[user:name],\r\n\r\nSu cuenta en [site:name] ha sido bloqueada.\r\n\r\n--  El equipo de [site:name]";'),('user_mail_status_blocked_notify','i:0;'),('user_mail_status_blocked_subject','s:63:"Detalles de la cuenta de [user:name] en [site:name] (bloqueada)";'),('user_mail_status_canceled_body','s:91:"[user:name],\r\n\r\nSu cuenta en [site:name] ha sido cancelada.\r\n\r\n--  El equipo de [site:name]";'),('user_mail_status_canceled_notify','i:0;'),('user_mail_status_canceled_subject','s:63:"Detalles de la cuenta de [user:name] en [site:name] (cancelada)";'),('user_pictures','i:1;'),('user_picture_default','s:0:"";'),('user_picture_dimensions','s:9:"1024x1024";'),('user_picture_file_size','s:3:"800";'),('user_picture_guidelines','s:0:"";'),('user_picture_path','s:8:"pictures";'),('user_picture_style','s:9:"thumbnail";'),('user_register','s:1:"0";'),('user_signatures','i:0;'),('views_exposed_filter_any_label','s:7:"new_any";'),('views_show_additional_queries','i:0;'),('views_ui_always_live_preview','i:1;'),('views_ui_custom_theme','s:8:"_default";'),('views_ui_show_advanced_column','i:0;'),('views_ui_show_advanced_help_warning','i:0;'),('views_ui_show_listing_filters','i:0;'),('views_ui_show_master_display','i:0;'),('views_ui_show_performance_statistics','i:0;'),('views_ui_show_preview_information','i:1;'),('views_ui_show_sql_query','i:0;'),('views_ui_show_sql_query_where','s:5:"above";'),('webform_node_types','a:1:{i:0;s:7:"webform";}'),('xmlsitemap_generated_last','i:1326448529;'),('xmlsitemap_regenerate_needed','b:0;');
INSERT INTO `variable` VALUES ('xmlsitemap_settings_node_archivo','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_article','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_imagen','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_noticia','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_page','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_productos_vp','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_session','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_sponsor','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_node_webform','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_taxonomy_term_session_type','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}'),('xmlsitemap_settings_taxonomy_term_talla','a:2:{s:6:"status";s:1:"0";s:8:"priority";s:3:"0.5";}');
DROP TABLE IF EXISTS `views_data_export`;
CREATE TABLE `views_data_export` (   `eid` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'Unique id for each on-going export.',   `view_name` varchar(32) NOT NULL DEFAULT '' COMMENT 'The unique name of the view. This is the primary field views are loaded from, and is used so that views may be internal and not necessarily in the database. May only be alphanumeric characters plus underscores.',   `view_display_id` varchar(32) NOT NULL DEFAULT '' COMMENT 'The unique name of the view. This is the primary field views are loaded from, and is used so that views may be internal and not necessarily in the database. May only be alphanumeric characters plus underscores.',   `time_stamp` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The time this export started',   `fid` int(10) unsigned NOT NULL COMMENT 'Files ID.',   `batch_state` varchar(32) NOT NULL DEFAULT 'init' COMMENT 'The current state of the batch.',   `sandbox` longblob,   PRIMARY KEY (`eid`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Keep track of currently executing exports.' AUTO_INCREMENT=1;
DROP TABLE IF EXISTS `views_data_export_object_cache`;
CREATE TABLE `views_data_export_object_cache` (   `eid` varchar(64) DEFAULT NULL COMMENT 'The export ID this view equates too.',   `updated` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The time this cache was created or updated.',   `data` longtext COMMENT 'Serialized data being stored.',   KEY `eid` (`eid`),   KEY `updated` (`updated`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='A modified version of the views_object_cache that ignores...';
DROP TABLE IF EXISTS `views_display`;
CREATE TABLE `views_display` (   `vid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The view this display is attached to.',   `id` varchar(64) NOT NULL DEFAULT '' COMMENT 'An identifier for this display; usually generated from the display_plugin, so should be something like page or page_1 or block_2, etc.',   `display_title` varchar(64) NOT NULL DEFAULT '' COMMENT 'The title of the display, viewable by the administrator.',   `display_plugin` varchar(64) NOT NULL DEFAULT '' COMMENT 'The type of the display. Usually page, block or embed, but is pluggable so may be other things.',   `position` int(11) DEFAULT '0' COMMENT 'The order in which this display is loaded.',   `display_options` longtext COMMENT 'A serialized array of options for this display; it contains options that are generally only pertinent to that display plugin type.',   PRIMARY KEY (`vid`,`id`),   KEY `vid` (`vid`,`position`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores information about each display attached to a view.';
