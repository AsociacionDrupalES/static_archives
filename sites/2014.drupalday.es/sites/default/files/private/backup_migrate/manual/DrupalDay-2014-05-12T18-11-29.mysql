INSERT INTO `locales_source` VALUES ('12555','','default','Directory path','','none'),('12556','','default','Edit !type','','none'),('12557','','default','Save !type','','none'),('12558','','default','Delete !type','','none'),('12559','','default','Exported content','','none'),('12560','','default','Are you sure you want to delete this !type?','','none'),('12561','','default','Export !type','','none'),('12562','','default','The type of the database. Drupal only supports one database type at a time, so this must be the same as the current database type.','','none'),('12563','','default','The name of the database. The database must exist, it will not be created for you.','','none'),('12564','','default','Enter the name of a user who has write access to the database.','','none'),('12565','','default','The database name is not valid.','','none'),('12566','','default','%num SQL commands executed.','','none'),('12567','','default','Enter the email address to send the backup files to. Make sure the email sever can handle large file attachments','','none'),('12568','','default','Database backup from !site: !file','','none'),('12569','','default','Database backup attached.','','none'),('12570','','default','Enter the path to the directory to save the backups to. Use a relative path to pick a path relative to your Drupal root directory. The web server must be able to write to this path.','','none'),('12571','','default','Change file mode (chmod)','','none'),('12572','','default','If you enter a value here, backup files will be chmoded with the mode you specify. Specify the mode in octal form (e.g. 644 or 0644) or leave blank to disable this feature.','','none'),('12573','','default','Change file group (chgrp)','','none'),('12574','','default','If you enter a value here, backup files will be chgrped to the group you specify. Leave blank to disable this feature.','','none'),('12575','','default','You must enter a valid chmod octal value (e.g. 644 or 0644) in the change mode fie