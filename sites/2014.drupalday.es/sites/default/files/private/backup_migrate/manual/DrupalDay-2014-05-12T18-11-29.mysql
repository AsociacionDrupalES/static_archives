INSERT INTO `locales_source` VALUES ('12825','','default','Default base URL','','none'),('12826','','default','Update cached files','','none'),('12827','','default','Rebuild links','','none'),('12828','','default','The front page path can be changed in the <a href="@url-frontpage">site information configuration</a>.','','none'),('12829','/admin/structure/views/ajax/config-item/imagen/block_1/argument/nid','default','Enter PHP code that returns a value to use for this filter. Do not use &lt;?php ?&gt;. You must return only a single value for just this filter. Some variables are available: the view object will be "$view". The argument handler will be "$argument", for example you may change the title used for substitutions for this argument by setting "argument->validated_title"".','','7.12'),('12830','/admin/structure/views/ajax/config-item/imagen/block_1/argument/nid','default','Enter PHP code that returns TRUE or FALSE. No return is the same as FALSE, so be SURE to return something if you do not want to declare the argument invalid. Do not use &lt;?php ?&gt;. The argument to validate will be "$argument" and the view will be "$view". You may change the argument by setting "$handler->argument". You may change the title used for substitutions for this argument by setting "$handler->validated_title".','','7.12'),('12831','/admin/structure/views/view/sponsors/edit/block?destination=user/1','default','_blank','','7.12'),('12832','','default','Enables the creation of forms and questionnaires.','','7.12'),('12833','','default','Webform','','7.12'),('12834','','default','Webform client form.','','7.12'),('12835','','default','Access all webform results','','7.12'),('12836','','default','Grants access to the "Results" tab on all webform content. Generally an administrative permission.','','7.12'),('12837','','default','Access own webform results','','7.12'),('12838','/admin/modules/list/confirm','default','Grants access to the "Results" tab to the author of webform content they have created.','','7.12'),('12839','','default','Edit all webform submissions','','7.12');
