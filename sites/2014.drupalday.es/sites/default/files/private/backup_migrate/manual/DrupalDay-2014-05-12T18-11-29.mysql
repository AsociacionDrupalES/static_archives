INSERT INTO `locales_target` VALUES ('6067','Saltándose la vista deteriorada @view','es','0','0','0'),('6068','Función callback Ajax para la carga de vista.','es','0','0','0'),('6069','No se pueden hacer cambios en una vista bloqueada.','es','0','0','0'),('6070','Crear listas y consultas personalizadas de la base de datos.','es','0','0','0'),('6071','Interfaz administrativa de vistas. Sin este módulo no podrá crear o editar sus vistas.','es','0','0','0'),('6072','Manejador deteriorado o ausente','es','0','0','0'),('6073','El manejador de este argumento falta o está deteriorado y no se puede usar. Si lo proporcionó un módulo que ha sido desactivado, reactivarlo podría restaurar el manejador. De otro modo, probablemente debería borrar este elemento.','es','0','0','0'),('6074','Fecha actual','es','0','0','0'),('6075','Hora de creación del nodo actual','es','0','0','0'),('6076','Hora de modificación del nodo actual','es','0','0','0'),('6077','No mostrar elementos sin valor en el resumen','es','0','0','0'),('6078','Entrada no válida','es','0','0','0'),('6079','Fallar validación básica si se da cualquier argumento','es','0','0','0'),('6080','al marcar este campo, lo puede usar para asegurarse de que las vistas con más argumentos de los necesarios no pasan la validación.','es','0','0','0'),('6081','Modo glosario','es','0','0','0'),('6082','Límite de caracteres','es','0','0','0'),('6083','No transformar','es','0','0','0'),('6084','Mayúsculas','es','0','0','0'),('6085','Minúsculas','es','0','0','0'),('6086','Poner en mayúscula la primera letra de todas las palabras','es','0','0','0'),('6087','Mayúsculas/Minúsculas en la ruta','es','0','0','0'),('6088','Transformar espacios en guiones en la URL','es','0','0','0'),('6089','Excluir de la presentación','es','0','0','0'),('6090','Rescribir la salida de este campo','es','0','0','0'),('6091','El texto para mostrar en este campo. Puede incluir HTML. Tiene que indicar los datos de esta vista siguiendo los "patrones de remplazo" de más abajo.','es','0','0','0'),('6092','Producir este campo como enlace','es','0','0','0'),('6093','Si se marca. este campo se convertirá en enlace. El destino debe indicarse a continuación.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6094','Ruta del enlace','es','0','0','0'),('6095','La URL relativa a este sistema Drupal o absoluta para este enlace. Puede especificar datos de esta vista siguiendo los "patrones de remplazo" de más abajo.','es','0','0','0'),('6096','La clase CSS que se aplicará al enlace.','es','0','0','0'),('6097','Texto prefijo','es','0','0','0'),('6098','Cualquier texto que se quiera poner delante del enlace. Puede incluir HTML.','es','0','0','0'),('6099','Texto sufijo','es','0','0','0'),('6100','Cualquier texto que se quiera poner después del enlace. Puede incluir HTML.','es','0','0','0'),('6101','<p>Debe añadir algunos campos adicionales a esta presentación antes de usar este campo. Estos campos se pueden marcar con <em>Excluir de la presentación</em> si lo prefiere. Tenga en cuenta que debido al orden de construcción, no puede usar campos después de este campo. Si necesita un campo no listado aquí, reordene sus campos.</p>','es','0','0','0'),('6102','Recortar este campo a una longitud máxima','es','0','0','0'),('6103','Recortar sólo entre palabras','es','0','0','0'),('6104','Si se marca, este campo se recortará sólo entre palabras. Esto garantiza un máximno de caracteres igual o menor al marcado. Si no existen espacios entre palabras, el campo podría recortarse hasta quedar vacío.','es','0','0','0'),('6105','Añadir puntos suspensivos','es','0','0','0'),('6106','si se marca, se añadirá un "..." si se recorta el campo.','es','0','0','0'),('6107','Eliminar etiquetas HTML','es','0','0','0'),('6108','Si se marca, todas las etiquetas HTML se eliminarán.','es','0','0','0'),('6109','El campo puede contener HTML','es','0','0','0'),('6110','Si se marca, se activará el corrector HTML para asegurarse de que las etiquetas quedan correctamente cerradas después del recorte.','es','0','0','0'),('6111','Mostrar tamaño de archivo','es','0','0','0'),('6112','Formateado (en Kb o Mb)','es','0','0','0'),('6113','Bytes en bruto','es','0','0','0'),('6114','Si se marca, verdadero se mostrará como falso.','es','0','0','0'),('6115','Desde hace (con "hace" adjunto)','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6116','Periodo de tiempo (con "ago/hence" adjunto)','es','0','0','0'),('6117','Redondear','es','0','0','0'),('6118','Si se marca, la cifra se redondeará.','es','0','0','0'),('6119','Especifica cuántas cifras deben mostrarse después de la coma decimal.','es','0','0','0'),('6120','El signo que se debe usar para indicar cifras decimales.','es','0','0','0'),('6121','El signo que se debe usar para indicar los miles en las cifras.','es','0','0','0'),('6122','Texto para colocar delante del número, como un símbolo de divisa.','es','0','0','0'),('6123','Texto para poner detrás del número, como un símbolo de divisa.','es','0','0','0'),('6124','Separador simple','es','0','0','0'),('6125','Mostrar como enlace','es','0','0','0'),('6126','Identificador del operador','es','0','0','0'),('6127','Esto aparecerá en la URL después del ? para identificar el operador.','es','0','0','0'),('6128','Identificador de filtro','es','0','0','0'),('6129','Esto aparecerá en la URL después del signo ? para identificar este filtro. No puede dejarlo en blanco.','es','0','0','0'),('6130','El identificador es necesario si el filtro esta expuesto.','es','0','0','0'),('6131','Este identificador no está permitido.','es','0','0','0'),('6132','- Cualquiera -','es','0','0','0'),('6133','expuesto','es','0','0','0'),('6134','Tipo del valor','es','0','0','0'),('6135','Una fecha en cualquier formato para sistema. DD-MM-SSAA HH:MM:SS son preferidos.','es','0','0','0'),('6136','Formato de fecha no válido.','es','0','0','0'),('6137','limitar lista a los elementos seleccionados','es','0','0','0'),('6138','Si se marca, sólo los elementos presentados al usuario serán los que se seleccionen aquí.','es','0','0','0'),('6139','no en','es','0','0','0'),('6140','<>','es','0','0','0'),('6141','Es la totalidad de','es','0','0','0'),('6142','No es uno de','es','0','0','0'),('6143','no','es','0','0','0'),('6144','<','es','0','0','0'),('6145','<=','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6146','>=','es','0','0','0'),('6147','>','es','0','0','0'),('6148','Está entre','es','0','0','0'),('6149','entre','es','0','0','0'),('6150','No está entre','es','0','0','0'),('6151','no entre','es','0','0','0'),('6152','Min','es','0','0','0'),('6153','Y máximo','es','0','0','0'),('6154','Y','es','0','0','0'),('6155','Contiene cualquier palabra','es','0','0','0'),('6156','tiene palabra','es','0','0','0'),('6157','Contiene todas las palabras','es','0','0','0'),('6158','contiene todos','es','0','0','0'),('6159','empieza','es','0','0','0'),('6160','termina en','es','0','0','0'),('6161','!has','es','0','0','0'),('6162','Exigir esta relación','es','0','0','0'),('6163','asc','es','0','0','0'),('6164','desc','es','0','0','0'),('6165','La granularidad es la unidad más pequeña que se usará al determinar qué fechas son iguales; por ejemplo: Si la granularidad es "Año", todas las fechas que caigan en 1999 serán consideradas la misma, sin importar cuándo ocurrieron.','es','0','0','0'),('6166','si activa <a href="@modules">el módulo de ayuda avanzada</a>, vistas le proporcionará más y mejor ayuda. <a href="@hide">Ocultar este mensaje.</a>','es','0','0','0'),('6167','Si instala el módulo de ayuda avanzada desde !ref, views le proporcionará más y mejor ayuda. <a href="@hide">Ocultar este mensaje.</a>','es','0','0','0'),('6168','Deteriorado','es','0','0','0'),('6169','Presentaciones','es','93','1','0'),('6170','Estas consultas se ejecutaron durante la representación de la vista','es','0','0','0'),('6171','[@time ms]','es','0','0','0'),('6172','Esta presentación no tiene ruta.','es','0','0','0'),('6173','Tiempo de construcción de la consulta','es','0','0','0'),('6174','@time ms','es','0','0','0'),('6175','Tiempo de ejecución de la consulta','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6176','Tiempo de generación de la vista','es','0','0','0'),('6177','No se realizó consulta','es','0','0','0'),('6178','No se puede previsualizar por errores de validación.','es','0','0','0'),('6179','Nombre de vista','es','0','0','0'),('6180','Descripción de vista','es','0','0','0'),('6181','Esta descripción aparecerá en las páginas de administración de vistas para informar en qué consiste la vista.','es','0','0','0'),('6182','Etiqueta de vista','es','0','0','0'),('6183','La vista ha sido eliminada.','es','0','0','0'),('6184','No hay bloqueo que quitar en la vista %view.','es','0','0','0'),('6185','¿Está seguro de que quiere desbloquear la vista %name?','es','0','0','0'),('6186','¡Desbloqueando esta vista cualquier cambio hecho por !user se perderá!','es','0','0','0'),('6187','El bloqueo se ha eliminado y ahora puede editar esta vista.','es','0','0','0'),('6188','Escriba el nombre que se usará para esta vista si fuera distinto del de la vista original. Déje el campo vacío si desea usar el nombre original de la vista.','es','0','0','0'),('6189','Pegue aquí el código de la vista','es','0','0','0'),('6190','No se ha podido interpretar el código de la vista.','es','0','0','0'),('6191','Ya existe una vista con ese enlace. Elija un nombre diferente, por favor.','es','0','0','0'),('6192','La extensión de presentación @plugin no está disponible.','es','0','0','0'),('6193','La extensión de estilo @plugin no está disponible.','es','0','0','0'),('6194','La extensión de fila @plugin no está disponible.','es','0','0','0'),('6195','El manejador @type de @table.@field no está disponible.','es','0','0','0'),('6196','No se pudo importar la vista.','es','0','0','0'),('6197','Haga clic en un elemento para editar sus detalles.','es','0','0','0'),('6198','Ir a la verdadera página de esta presentación','es','0','0','0'),('6199','No válido','es','0','0','0'),('6200','Falta extensión de estilo','es','0','0','0'),('6201','Cambiar opciones para este estilo','es','0','0','0'),('6202','Análisis de vista','es','0','0','0'),('6203','Configurar @type','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6204','Redistribuir @type','es','0','0','0'),('6205','Campo deteriorado @id','es','0','0','0'),('6206','No hay @types disponibles para añadir.','es','0','0','0'),('6207','Copfigurar opciones extra para @type %item','es','0','0','0'),('6208','Configurar estilo de resumen para @type %item','es','0','0','0'),('6209','Limpiar la caché de vistas','es','0','0','0'),('6210','Añadir un sello de vistas a todas las consultas SQL','es','0','0','0'),('6211','Todas las consultas incluiran el texto ''VIEWS'' = ''VIEWS'' en las clausulas WHERE. Esto simplifica la identificación de las consultas de vistas en los registros de la base de datos, pero sólo se debe usar si hay problemas.','es','0','0','0'),('6212','Desactivar la caché de datos de vistas','es','0','0','0'),('6213','Las vistas ponen en la caché los datos sobre las tablas, los módulos y las vistas disponibles para mejorar el funcionamiento. Al marcar esta casilla, las vistas se saltarán esta caché y siempre reconstruirán estos datos cuando haga falta. <strong>Hacer esto puede tener un impacto bastante evidente en el rendimiento de este sitio.</strong>','es','0','0','0'),('6214','Mostrar otras consultas ejecutadas mientras se preparaba la vista previa','es','0','0','0'),('6215','Drupal tiene la capacidad de ejecutar muchas consultas mientras prepara el resultado de una vista. Si se marca esta casilla, se mostrarán como parte de la vista previa todas las consultas efectuadas durante esa preparación.','es','0','0','0'),('6216','Error: Falta @component','es','0','0','0'),('6217','El análisis de vistas no encontró nada de lo que informar.','es','0','0','0'),('6218','Esta vista sólo tiene una presentación predeterminada y por eso no se colocará en ninguna parte de su sitio. Quizás querría añadir una presentación de página o bloque.','es','0','0','0'),('6219','Eliminar duplicados','es','0','0','0'),('6220','Opciones predefinidas para esta vista.','es','0','0','0'),('6221','Mostrar la vista como página, con una URL y enlaces de menú.','es','0','0','0'),('6222','Presentar la vista como bloque.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6223','Adjuntos añadidos a otras presentaciones para conseguir vistas múltiples en la misma vista.','es','0','0','0'),('6224','Presentar la vista como canal del tipo de un canal RSS.','es','0','0','0'),('6225','Presenta las filas una detrás de otra.','es','0','0','0'),('6226','Presentar filas como una lista HTML.','es','0','0','0'),('6227','Presentar filas en una cuadrícula.','es','0','0','0'),('6228','Presentar filas en una tabla.','es','0','0','0'),('6229','Presenta el resumen predeterminado como lista.','es','0','0','0'),('6230','Presenta el resumen sin formatear, con la opción de uno después de otro o en línea.','es','0','0','0'),('6231','Crea un canal de noticias RSS a partir de una vista.','es','0','0','0'),('6232','Presenta los campos con una plantilla opcional.','es','0','0','0'),('6233','Estará disponible para todos los usuarios.','es','0','0','0'),('6234','Se concederá acceso a los usuarios con cualquiera de los roles especificados.','es','0','0','0'),('6235','Sin caché de datos de vistas','es','0','0','0'),('6236','Con base temporal','es','0','0','0'),('6237','Caché de datos simple de base temporal.','es','0','0','0'),('6238','criterios de ordenación','es','0','0','0'),('6239','Criterio de ordenación','es','0','0','0'),('6240','criterio de ordenación','es','0','0','0'),('6241','Los elementos de agregador se importan desde canales de noticias externos RSS y Atom.','es','0','0','0'),('6242','El título del elemento de agregador.','es','0','0','0'),('6243','El enlace a la URL de la fuente original del elemento.','es','0','0','0'),('6244','El autor del elemento original importado.','es','0','0','0'),('6245','El contenido del elemento importado.','es','0','0','0'),('6246','La fecha en la que el elemento original del canal se publicó (con algunos canales esta será la fecha en la que se importó).','es','0','0','0'),('6247','ID de canal','es','0','0','0'),('6248','El ID único del canal de agregador.','es','0','0','0'),('6249',