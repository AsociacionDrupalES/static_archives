INSERT INTO `locales_source` VALUES ('6090','','default','Rewrite the output of this field','','7.12'),('6091','','default','The text to display for this field. You may include HTML. You may enter data from this view as per the "Replacement patterns" below.','','7.12'),('6092','','default','Output this field as a link','','7.12'),('6093','','default','If checked, this field will be made into a link. The destination must be given below.','','7.12'),('6094','','default','Link path','','7.12'),('6095','','default','The Drupal path or absolute URL for this link. You may enter data from this view as per the "Replacement patterns" below.','','7.12'),('6096','','default','The CSS class to apply to the link.','','7.12'),('6097','','default','Prefix text','','7.12'),('6098','','default','Any text to display before this link. You may include HTML.','','7.12'),('6099','','default','Suffix text','','7.12'),('6100','','default','Any text to display after this link. You may include HTML.','','7.12'),('6101','','default','<p>You must add some additional fields to this display before using this field. These fields may be marked as <em>Exclude from display</em> if you prefer. Note that due to rendering order, you cannot use fields that come after this field; if you need a field not listed here, rearrange your fields.</p>','','7.12'),('6102','','default','Trim this field to a maximum length','','7.12'),('6103','','default','Trim only on a word boundary','','7.12'),('6104','','default','If checked, this field be trimmed only on a word boundary. This is guaranteed to be the maximum characters stated or less. If there are no word boundaries this could trim a field to nothing.','','7.12'),('6105','','default','Add an ellipsis','','7.12'),('6106','','default','If checked, a "..." will be added if a field was trimmed.','','7.12'),('6107','','default','Strip HTML tags','','7.12'),('6108','','default','If checked, all HTML tags will be stripped.','','7.12'),('6109','','default','Field can co