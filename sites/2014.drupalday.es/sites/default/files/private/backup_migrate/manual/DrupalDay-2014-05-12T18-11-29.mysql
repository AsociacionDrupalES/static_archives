INSERT INTO `field_config_instance` VALUES ('98','49','field_files','node','session','a:6:{s:5:"label";s:8:"Archivos";s:6:"widget";a:5:{s:6:"weight";s:1:"5";s:4:"type";s:12:"file_generic";s:6:"module";s:4:"file";s:6:"active";i:1;s:8:"settings";a:1:{s:18:"progress_indicator";s:8:"throbber";}}s:8:"settings";a:5:{s:14:"file_directory";s:0:"";s:15:"file_extensions";s:29:"ppt odp zip tar.gz tar gz pdf";s:12:"max_filesize";s:0:"";s:17:"description_field";i:1;s:18:"user_register_form";b:0;}s:7:"display";a:1:{s:7:"default";a:5:{s:5:"label";s:5:"above";s:4:"type";s:12:"file_default";s:8:"settings";a:0:{}s:6:"module";s:4:"file";s:6:"weight";i:4;}}s:8:"required";i:0;s:11:"description";s:0:"";}','0'),('99','1','comment_body','comment','comment_node_webform','a:6:{s:5:"label";s:7:"Comment";s:8:"settings";a:2:{s:15:"text_processing";i:1;s:18:"user_register_form";b:0;}s:8:"required";b:1;s:7:"display";a:1:{s:7:"default";a:5:{s:5:"label";s:6:"hidden";s:4:"type";s:12:"text_default";s:6:"weight";i:0;s:8:"settings";a:0:{}s:6:"module";s:4:"text";}}s:6:"widget";a:4:{s:4:"type";s:13:"text_textarea";s:8:"settings";a:1:{s:4:"rows";i:5;}s:6:"weight";i:0;s:6:"module";s:4:"text";}s:11:"description";s:0:"";}','0'),('100','2','body','node','webform','a:6:{s:5:"label";s:4:"Body";s:6:"widget";a:4:{s:4:"type";s:26:"text_textarea_with_summary";s:8:"settings";a:2:{s:4:"rows";i:20;s:12:"summary_rows";i:5;}s:6:"weight";s:2:"31";s:6:"module";s:4:"text";}s:8:"settings";a:3:{s:15:"display_summary";b:1;s:15:"text_processing";i:1;s:18:"user_register_form";b:0;}s:7:"display";a:2:{s:7:"default";a:5:{s:5:"label";s:6:"hidden";s:4:"type";s:12:"text_default";s:6:"weight";s:1:"0";s:8:"settings";a:0:{}s:6:"module";s:4:"text";}s:6:"teaser";a:5:{s:5:"label";s:6:"hidden";s:4:"type";s:23:"text_summary_or_trimmed";s:8:"settings";a:1:{s:11:"trim_length";i:600;}s:6:"module";s:4:"text";s:6:"weight";i:0;}}s:8:"required";b:0;s:11:"description";s:0:"";}','0'),('102','51','field_adjunto','node','webform','a:6:{s:5:"label";s:7:"Adjunto";s:6:"widget";a:5:{s:6:"weight";s:2:"32";s:4:"type";s:12:"file_generic";s:6:"module";s:4:"file";s:6:"active";i:1;s:8:"settings";a:1:{s:18:"progress_indicator";s:8:"throbber";}}s:8:"settings";a:5:{s:14:"file_directory";s:0:"";s:15:"file_extensions";s:3:"pdf";s:12:"max_filesize";s:0:"";s:17:"description_field";i:0;s:18:"user_register_form";b:0;}s:7:"display";a:1:{s:7:"default";a:4:{s:5:"label";s:5:"above";s:4:"type";s:6:"hidden";s:6:"weight";s:1:"1";s:8:"settings";a:0:{}}}s:8:"required";i:0;s:11:"description";s:0:"";}','0');
INSERT INTO `field_config_instance` VALUES ('103','1','comment_body','comment','comment_node_archivo','a:6:{s:5:"label";s:7:"Comment";s:8:"settings";a:2:{s:15:"text_processing";i:1;s:18:"user_register_form";b:0;}s:8:"required";b:1;s:7:"display";a:1:{s:7:"default";a:5:{s:5:"label";s:6:"hidden";s:4:"type";s:12:"text_default";s:6:"weight";i:0;s:8:"settings";a:0:{}s:6:"module";s:4:"text";}}s:6:"widget";a:4:{s:4:"type";s:13:"text_textarea";s:8:"settings";a:1:{s:4:"rows";i:5;}s:6:"weight";i:0;s:6:"module";s:4:"text";}s:11:"description";s:0:"";}','0'),('105','52','field_archivo','node','archivo','a:6:{s:5:"label";s:7:"Archivo";s:6:"widget";a:5:{s:6:"weight";s:2:"31";s:4:"type";s:12:"file_generic";s:6:"module";s:4:"file";s:6:"active";i:1;s:8:"settings";a:1:{s:18:"progress_indicator";s:8:"throbber";}}s:8:"settings";a:5:{s:14:"file_directory";s:0:"";s:15:"file_extensions";s:12:"pdf doc docx";s:12:"max_filesize";s:0:"";s:17:"description_field";i:0;s:18:"user_register_form";b:0;}s:7:"display";a:1:{s:7:"default";a:5:{s:5:"label";s:5:"above";s:4:"type";s:12:"file_default";s:8:"settings";a:0:{}s:6:"module";s:4:"file";s:6:"weight";i:0;}}s:8:"required";i:0;s:11:"description";s:0:"";}','0'),('106','53','field_galeria','node','imagen','a:7:{s:5:"label";s:8:"Galería";s:6:"widget";a:5:{s:6:"weight";s:1:"3";s:4:"type";s:13:"options_onoff";s:6:"module";s:7:"options";s:6:"active";i:1;s:8:"settings";a:1:{s:13:"display_label";i:1;}}s:8:"settings";a:1:{s:18:"user_register_form";b:0;}s:7:"display";a:1:{s:7:"default";a:5:{s:5:"label";s:5:"above";s:4:"type";s:12:"list_default";s:8:"settings";a:0:{}s:6:"module";s:4:"list";s:6:"weight";i:1;}}s:8:"required";i:0;s:11:"description";s:0:"";s:13:"default_value";a:1:{i:0;a:1:{s:5:"value";i:0;}}}','0');
DROP TABLE IF EXISTS `field_data_body`;
CREATE TABLE `field_data_body` (   `entity_type` varchar(128) NOT NULL DEFAULT '' COMMENT 'The entity type this data is attached to',   `bundle` varchar(128) NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned DEFAULT NULL COMMENT 'The entity revision id this data is attached to, or NULL if the entity type is not versioned',   `language` varchar(32) NOT NULL DEFAULT '' COMMENT 'The language for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `body_value` longtext,   `body_summary` longtext,   `body_format` varchar(255) DEFAULT NULL,   PRIMARY KEY (`entity_type`,`entity_id`,`deleted`,`delta`,`language`),   KEY `entity_type` (`entity_type`),   KEY `bundle` (`bundle`),   KEY `deleted` (`deleted`),   KEY `entity_id` (`entity_id`),   KEY `revision_id` (`revision_id`),   KEY `language` (`language`),   KEY `body_format` (`body_format`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Data storage for field 2 (body)';
INSERT INTO `field_data_body` VALUES ('node','page','0','2','150','und','0','La Facultad de Ciencias de la Universidad de Cantabria será el punto de reunión del <strong>Drupal Day 2013</strong>. ¿Cómo llegar a ella?\r\n\r\n<ul><li><strong>Bus</strong>: Las líneas 7C1 y 7C2 te dejarán justo al lado de la Facultad, bajando en la parada de la Escuela de Caminos.</li>\r\n\r\n<li><strong>Coche</strong>: La Universidad de Cantabria ofrece un amplio aparcamiento gratuito, por lo que no hay problema para traer el coche. El acceso a la Facultad es sencillo tanto <a href="http://goo.gl/maps/KRTWx">si llegas desde la zona de Bilbao (A8)</a> como <a href="http://goo.gl/maps/S3Blb">si vienes desde Torrelavega (A67)</a>.</li>\r\n\r\n<li><strong>Bici</strong>: Si prefieres contribuir al medio ambiente y hacer deporte, la bici es tu solución ideal. Además, en Santander tenemos un servicio de bicicletas municipal perfecto para ti, <a href="http://www.tusbic.es/">tusbic</a>.</li></ul>\r\n\r\n\r\nPara venir en avión, tienes dos posibilidades:\r\n\r\n<ul><li><strong>Aeropuerto de Santander</strong>: Si tu vuelo es directo a <a href="http://www.aena-aeropuertos.es/csee/Satellite/Aeropuerto-Santander/es/">Santander</a>, lo tienes fácil. Cada 30 minutos sale un autobús hacia el centro de la ciudad, desde las 07:00 hasta las 23:00; existiendo un primer servicio a las 06:40 horas. Desde ahí, las líneas 7C1 y 7C2 te acercarán a la Facultad</li>\r\n\r\n<li><strong>Aeropuerto de Bilbao</strong>: Puede que tengas que volar hasta <a href="http://www.aena-aeropuertos.es/csee/Satellite/Aeropuerto-Bilbao/es/">Bilbao</a>; en ese caso, no te preocupes; porque tardarás poco más de una hora en llegar en bus hasta Santander.</li></ul>\r\n\r\nSi decides llegar en <strong>tren</strong>, las estaciones de Renfe y FEVE de Santander están justo al lado de la Estación de Autobuses, por lo que solo tendrás que cruzar la calle para subirte en el bus que te acerque hasta la sede del Drupal Day.\r\n\r\nFacultad de Ciencias\r\nUniversidad de Cantabria\r\nAvenida de los Castros, S/Nº\r\n39005 (Santander - España)\r\n\r\n<iframe width="554" height="400" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="https://maps.google.es/maps?f=q&amp;source=s_q&amp;hl=es&amp;geocode=&amp;q=Facultad+de+Ciencias,+Santander&amp;aq=1&amp;oq=Facultad+de+ciencias&amp;sll=43.454165,-3.824787&amp;sspn=0.06779,0.169086&amp;ie=UTF8&amp;hq=Facultad+de+Ciencias,+Santander&amp;t=m&amp;ll=43.472854,-3.80054&amp;spn=0.012457,0.023732&amp;z=15&amp;iwloc=A&amp;output=embed"></iframe><br /><small><a href="https://maps.google.es/maps?f=q&amp;source=embed&amp;hl=es&amp;geocode=&amp;q=Facultad+de+Ciencias,+Santander&amp;aq=1&amp;oq=Facultad+de+ciencias&amp;sll=43.454165,-3.824787&amp;sspn=0.06779,0.169086&amp;ie=UTF8&amp;hq=Facultad+de+Ciencias,+Santander&amp;t=m&amp;ll=43.472854,-3.80054&amp;spn=0.012457,0.023732&amp;z=15&amp;iwloc=A" style="color:#0000FF;text-align:left">Ver mapa más grande</a></small>','','full_html');
INSERT INTO `field_data_body` VALUES ('node','page','0','4','4','und','0','Ea mei nullam facete, omnis oratio offendit ius cu. Doming takimata repudiandae usu an, mei dicant takimata id, pri eleifend inimicus euripidis at. His vero singulis ea, quem euripidis abhorreant mei ut, et populo iriure vix. Usu ludus affert voluptaria ei, vix ea error definitiones, movet fastidii signiferumque in qui.\r\n\r\nVis prodesset adolescens adipiscing te, usu mazim perfecto recteque at, assum putant erroribus mea in. Vel facete imperdiet id, cum an libris luptatum perfecto, vel fabellas inciderint ut. Veri facete debitis ea vis, ut eos oratio erroribus. Sint facete perfecto no vel, vim id omnium insolens. Vel dolores perfecto pertinacia ut, te mel meis ullum dicam, eos assum facilis corpora in.\r\n\r\nEa mei nullam facete, omnis oratio offendit ius cu. Doming takimata repudiandae usu an, mei dicant takimata id, pri eleifend inimicus euripidis at. His vero singulis ea, quem euripidis abhorreant mei ut, et populo iriure vix. Usu ludus affert voluptaria ei, vix ea error definitiones, movet fastidii signiferumque in qui.\r\n\r\nVis prodesset adolescens adipiscing te, usu mazim perfecto recteque at, assum putant erroribus mea in. Vel facete imperdiet id, cum an libris luptatum perfecto, vel fabellas inciderint ut. Veri facete debitis ea vis, ut eos oratio erroribus. Sint facete perfecto no vel, vim id omnium insolens. Vel dolores perfecto pertinacia ut, te mel meis ullum dicam, eos assum facilis corpora in.','','filtered_html'),('node','page','0','7','258','und','0','<h2 id="charlas-confirmadas">Charlas</h2>\r\n<ul>\r\n\r\n<li id="symfony"><p><strong><a href="">Drupal y Symfony</a>, por <a href="https://drupal.org/user/682736">Juan Pablo Novillo (juampy)</a></strong></p>\r\n<p>En marzo de 2012 se hizo oficial la incorporación de componentes de Symfony 2 en Drupal 8. Desde entonces, ambas comunidades han trabajado unidas en un proceso en el que antiguos componentes de Drupal están siendo reemplazados por modernos y mucho más flexibles componentes de Symfony.</p>\r\n<p>En esta charla se revisarán algunos de estos componentes explicando cómo han reducido la deuda técnica que Drupal arrastraba y resaltando los beneficios que se obtienen de cada uno de ellos. Entre ellos están Twig, HTTP Foundation, HTTP Kernel, Event Dispatcher y Routing. También se verán las relaciones que se han establecido entre ambas comunidades y los retos a los que se enfrenta la comunidad de Drupal ante la nueva versión, la cuál saldrá a la luz en 2014.</p>\r\n<iframe src="//player.vimeo.com/video/74181767" width="500" height="281" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>\r\n<br>\r\n</li>\r\n<li id="intro-drupal"><p><strong><a href="">Introducción a Drupal</a>, por <a href="https://drupal.org/user/2104056">Francisco Alonso</a> y <a href="https://drupal.org/user/2398554">Pedro Palomera</a></strong></p>\r\n<p><a href="https://drupal.org/user/2104056">Francisco Alonso</a> es director de desarrollo para <a href="http://drfutbol.com/">Drfutbol.com</a>. Ingeniero en informática y apasionado de Drupal desde hace algo más de un año, cuando lo descubrió por casualidad al obtener una beca de la <a href="http://www.unican.es">Universidad de Cantabria</a> para la realización de unas prácticas en la empresa <a href="http://suomitech.com">Suomitech</a>. Desde ese momento todo lo que ha hecho ha estado ligado al popular CMS.</p>\r\n<p><a href="https://drupal.org/user/2398554">Pedro Palomera</a> es director de desarrollo en <a href="http://denoe.es/">Denoe, Servicios SaaS</a>. Ingeniero en informático, emigró a Madrid en busca de una oportunidad laboral, pero no dudo en regresar a su tierra natal para dedicarse integramente al desarrollo de aplicaciones bajo el modelo SaaS en cuanto se le presento la ocasión. </p>\r\n<p>Entre ambos ofrecerán una primera introducción a Drupal, alejada de tecnicismos, y que permita al público asistente hacerse una idea acerca del poder de Drupal. Al realizarse la jornada dentro de las instalaciones de la Facultad de Ciencias de la Universidad de Cantabria, donde se cursa en la actualidad la carrera de Ingeniería en Informática creemos que esta charla puede ser interesante para aquellos alumnos que no tengan muy claro hacia que rama orientar su vida laboral o aquellos que hayan oido hablar del poder de los CMS pero no sepan muy bien qué son o cómo funcionan.</p>\r\n</li>\r\n<li id="drupal8"><p><strong><a href="#">Drupal 8</a>, por <a href="https://drupal.org/user/4299">Jose Reyero</a></strong></p>\r\n<p><a href="https://drupal.org/user/4299">Jose Reyero</a> trabaja como consultor freelance y es el autor, entre otros, de módulos tan populares como <a href="https://drupal.org/project/i18n">Internationalization</a></p>\r\n<p>En esta ocasión, Jose nos hablará de Drupal 8, cuyo lanzamiento definitivo está cada vez más cercano. Nos contará qué cosas van a cambiar, cómo lo van a hacer, y en que nos van a afectar estos cambios. Una charla altamente recomendable si aún no sabes muy bien a que te vas a enfrentar en la nueva versión de Drupal.</p>\r\n<iframe src="//player.vimeo.com/video/74188418" width="500" height="281" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>\r\n<br>\r\n</li>\r\n<li id="internacionalizacion"><p><strong><a href="#">Internacionalización en Drupal 8</a>, por <a href="https://drupal.org/user/959536">Christian López</a></strong></p>\r\n<p><a href="https://drupal.org/user/959536">Christian López (penyaskito)</a> trabaja como desarrollador en <a href="http://www.cocomore.com/">Cocomore</a>.</p>\r\n<p>La charla versará sobre <a href="http://drupal.org/project/i18n">Internationalization</a> en Drupal 8, módulo con el que, todo desarrollador que se precie, habrá tenido sus más y sus menos. Christian tratará de contarnos las mejoras que la próxima versión de Drupal acarreará en este módulo. Muy interesante si sueles trabajar con sitios multi-idioma.</p>\r\n<iframe src="//player.vimeo.com/video/74192663" width="500" height="281" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>\r\n<br>\r\n</li>\r\n<li id="behat"><p><strong><a href="#">Behat</a>, por <a href="https://drupal.org/user/397132">Ricardo Sanz</a></strong></p>\r\n<p><a href="https://drupal.org/user/397132">Ricardo Sanz</a>, forma parte del plantel de <a href="http://metadrop.com">Metadrop</a>.</p>\r\n<p>Ricardo viene dispuestos a contarnos todo lo que sabe (o todo lo que le de tiempo) acerca de <a href="http://behat.org">Behat</a>, una herramienta de testing orientado a BDD fuertemente basada en Cucumber. Behat se emplea para escribir test de aceptación en en lenaguaje cercano al natural, de forma que el cliente pueda entenderlos o incluso escribirlos</p>\r\n</li>\r\n<iframe src="//player.vimeo.com/video/74200464" width="500" height="281" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>\r\n<br>\r\n</li>\r\n<li id="d8undercover"><p><strong><a href="#">Drupal 8: Undercover initiatives</a>, por <a href="https://drupal.org/user/122101">Pedro Cambra</a></strong></p>\r\n<p>Drupal 8 no solamente está ocasionando un brutal cambio en el código, el proceso de desarrollo ha variado mucho con respecto a Drupal 7. Las iniciativas han focalizado mucho más las contribuciones y los intereses de los contribuidores. Pero hay otras iniciativas tanto o más importantes que las oficiales que pueden pasar desapercibidas y aportan muchísimo valor al proceso de desarrollo.</p>\r\n<p>En esta sesión repasaremos los cambios producidos en las "iniciativas encubiertas", Field API, Entity API, Typed data y más para ponernos al día de cómo nos afectaran todos estos cambios cuando afrontemos proyectos en Drupal 8</p>\r\n<iframe src="//player.vimeo.com/video/74200463" width="500" height="281" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>\r\n<br>\r\n</li>\r\n\r\n</li>\r\n<li id="drush6"><p><strong><a href="#">Un vistazo a Drush 6</a>, por <a href="https://drupal.org/user/49817">Jonathan Araña Cruz</a></strong></p>\r\n<p>Drush 6 incorpora soporte para Drupal 8, además de algunas nuevas funcionalidades. En esta sesión se hará un repaso a los comandos y funcionalidades introducidos, y también a otros comandos ya existentes\r\npero menos conocidos. Por último, se comentarán los cambios y perspectivas futuras tras la publicación de Drush 6.</p>\r\n<iframe src="//player.vimeo.com/video/74609562" width="500" height="281" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>\r\n</li>\r\n\r\n<!--\r\n<li id="bootstrap"><p><strong><a href="#">Bootstrap y Drupal</a>, por <a href="#">Luis Manuel Mazorra</a></strong></p>\r\n<p><a href="">Luisma</a> trabaja como freelance, es especialista en maquetación web y SEO. Le gustar estar siempre atento a las úlitmas tecnologías que van surgiendo y últimamente se ha especializado en el framework Bootstrap para maquetación web.</p>\r\n<p>¿Qué es <a href="http://twitter.github.io/bootstrap/">Bootstrap</a>? Pues en pocas palabras es el framework de Twitter que permite crear interfaces web con CSS y Javascript que adaptan la interfaz dependiendo del tamaño del dispositivo en el que se visualice de forma nativa, es decir, automáticamente se adapta al tamaño de un ordenador o de una Tablet sin que el usuario tenga que hacer nada, esto se denomina diseño adaptativo o Responsive Design y ... está de moda!</p>\r\n</li>\r\n-->\r\n</ul>\r\n\r\n<!--\r\n<ul>\r\n<li><p><strong><a href="http://2012.drupalday.es/node/27">Migrate</a>, por <a href="http://2012.drupalday.es/user/74">Javier Carranza</a></strong></p>\r\n<p><a href="http://drupal.org/user/50717">Javier Carranza (trunks)</a> es director del equipo de producción en Alquimia Proyectos Digitales. Su trayectoria profesional ha estado siempre ligada al software libre. Comenzó su carrera como desarrollador y empaquetador debian para el proyecto Guadalinex. Lideró el desarrollo del primer instalador gráfico para distribuciones debian (ubiquity), que finalmente sería implantado en Ubuntu. En los últimos años, Javier ha orientado su carrera a entornos web, contribuyendo y promoviendo el proyecto Drupal. Ha contribuido más de una decena de módulos y colaborado con parches en el core y en módulos como Views o Migrate.</p>\r\n<p>Javier nos propone un taller del módulo <a href="http://drupal.org/project/migrate">Migrate</a>, que facilita la migración de contenidos hacia Drupal desde otros orígenes.</p>\r\n</li>\r\n<li><p><strong><a href="http://2012.drupalday.es/node/28">Selenium</a>, por <a href="http://2012.drupalday.es/user/68">Oskar Calvo</a></strong></p>\r\n<p><a href="http://drupal.org/user/87203">Oskar Calvo</a> es licenciado en Historia moderna y contemporánea por la universidad de Deusto. Dirigió sus estudios hacia la arquitectura de la información y la gestión, difusión y recuperación de contenidos. Es un miembro muy activo de la comunidad Drupal, especialmente en Madrid, desde donde trabaja por la difusión de Drupal e impulsa la organización de eventos que fomenten el crecimiento de la comunidad. Disfruta tanto con el contacto directo con el código como con la búsqueda de técnicas para optimizar la organización de los grupos de trabajo.</p>\r\n<p>Oskar nos tiene preparado un taller de <a href="http://seleniumhq.org/">Selenium</a>, una herramienta que permite la automatización de navegadores web y un aliado para las pruebas de regresión y aceptación.</p>\r\n</li>\r\n<li><p><strong><a href="http://2012.drupalday.es/node/29">SimpleTest</a>, por <a href="http://2012.drupalday.es/user/67">Juan Pablo Novillo</a> y <a href="http://2012.drupalday.es/user/87">Ricardo Sanz Ante</a></strong></p>\r\n<p><a href="http://drupal.org/user/682736">Juan Pablo Novillo (juampy)</a> comenzó a crear webs en PHP profesionalmente en Londres tras finalizar sus estudios en 2006. Pasó un tiempo utilizando Symfony y Ruby on Rails hasta que en 2010, de vuelta en España, creó su primera web en Drupal. Su compromiso con la Comunidad comenzó un año más tarde tras descubrir lo divertido que era contribuír. Actualmente mantiene varios módulos como <a href="http://drupal.org/project/twitter">Twitter</a> u <a href="http://drupal.org/project/oauth">OAuth</a> entre otros; envía y revisa parches para otros módulos; participa activamente en el grupo de Drupal Madrid y es autor del libro <a href="http://www.packtpub.com/drush-drupal-command-line-interface-users-guide/book">Drush User''s Guide</a>. En definitiva, disfruta ayudando a que Drupal evolucione y llegue a una mayor audiencia.</p>\r\n<p><a href="http://drupal.org/user/397132">Ricardo Sanz Ante (tunic)</a> ha estado trabajando con Drupal desde hace cuatro años, los dos últimos a tiempo completo. Colabora activamente con la comunidad, mantiene el módulo <a href="http://drupal.org/project/uc_ajax_cart">UC Ajax Cart</a> y es administrador del <a href="http://groups.drupal.org/spanish">grupo Spanish de groups.drupal.org</a>. Ha asistido a las Drupalcamp Spain 2010 y 2011, dando una charla en 2010. Forma parte de la <a href="http://asociaciondrupal.es/">AED</a> y la <a href="http://drupalmadrid.org/">Asociación Madrileña de Drupal</a>.\r\n\r\n<p>Juampy y tunic organizarán un taller de <a href="http://drupal.org/project/simpletest">SimpleTest</a>, el framework de testing de Drupal.</p>\r\n\r\n</li>\r\n<li><p><strong><a href="http://2012.drupalday.es/node/30">Varnish</a>, por <a href="http://2012.drupalday.es/user/26">Pedro González Serrano</a></strong>\r\n<p><a href="http://drupal.org/user/39078">Pedro González Serrano (NITEMAN)</a>, es cofundador de las comunidades <a href="http://www.scenebeta.com">SceneBeta.com</a> así como de la empresa <a href="http://sbitmedia.com">SB IT Media</a>. Miembro activo de la comunidad de Drupal, empezó a trabajar con él en 2005 contando con una amplia experiencia en instalaciones de alto rendimiento, principalmente desde la perspectiva de sistemas. En la actualidad forma parte del comité que organiza la <a href="http://2012.drupalcamp.es">Drupalcamp Spain 2012</a>.</p>\r\n<p>NITEMAN nos tiene preparado en esta ocasión un taller sobre <a href="http://drupal.org/project/varnish">Varnish</a> y su uso con Drupal 7 o <a href="http://pressflow.org/">Pressflow.</a></p>\r\n</li>\r\n</ul>-->\r\n\r\n\r\n<h2 id="talleres">Talleres</h2>\r\n<ul>\r\n<li id="taller_oskar"><p><strong><a href="">Webgrind y Pinba/Pinboard</a>, por <a href="https://drupal.org/user/87203">Oskar Calvo (oskar)</a></strong></p>\r\n<p>Webgrind: Herramienta de depuración de código PHP</p>\r\n<p>Pinba: Profiling de monitorización de procesos php en servidores</p>\r\n</li>\r\n</ul>','','full_html');
INSERT INTO `field_data_body` VALUES ('node','page','0','11','172','und','0','<p><strong>Protección de datos personales</strong></p><p>Los datos recabados a través de la web&nbsp;se incorporan a un fichero titularidad de&nbsp;La Asociación Española de Drupal que&nbsp;es&nbsp;el responsable del citado fichero. Esos datos se utilizan con la finalidad de gestionar el servicio solicitado y siempre conforme a lo dispuesto en la Ley Orgánica 15/1999, de 13 de diciembre, de Protección de Datos de Carácter Personal.</p><p>La cumplimentación del formulario&nbsp;en&nbsp;la web con los datos requeridos,&nbsp;en&nbsp;su caso, y el&nbsp;envío de correos postales y correos electrónicos u otras comunicaciones a&nbsp;www.drupalday.es&nbsp;y&nbsp; de&nbsp;La Asociación Española de Drupal implica el consentimiento expreso del cliente a la inclusión de sus datos de carácter personal,&nbsp;en&nbsp;el referido fichero automatizado titularidad de&nbsp;La Asociación Española de Drupal.</p><p><strong>Derecho de acceso, oposición, rectificación y cancelación</strong></p><p>Cualquier persona interesada podrá ejercitar sus derechos de acceso, rectificación, cancelación y oposición con arreglo a lo previsto&nbsp;en&nbsp;las Leyes Orgánicas vigentes&nbsp;en&nbsp;España y demás normativas aplicables al efecto, mediante el&nbsp;envío de una solicitud firmada por el titular de los datos, acompañada de una fotocopia&nbsp;de su&nbsp;DNI a: asociacion@drupal.es o por cualquier otro medio&nbsp;que permita reconocer la identidad de la persona&nbsp;que&nbsp;ejercita cualquiera de los derechos anteriores.<br>Enlaces</p><p>Esta política de privacidad sólo es de aplicación a la página web&nbsp;www.drupalday.es,&nbsp;no se garantiza&nbsp;en&nbsp;los accesos a través de&nbsp;enlaces con este sitio, ni a los&nbsp;enlaces desde este sitio con otras&nbsp;webs.</p><p><strong>AVISO LEGAL</strong></p><p>Para dar cumplimento con lo establecido&nbsp;en&nbsp;las Leyes&nbsp;Vigentes&nbsp;en&nbsp;España, los&nbsp;datos de información general de este sitio Web son los siguientes:</p><p>Titular: Asociación Española de Drupal<br>Dirección:&nbsp;<span style="color: #222222; font-family: arial, sans-serif; line-height: normal;">C/ Alcalá 20, Oficina 209. CP 28014 Madrid</span><br>Contacto: Tesorero:&nbsp;<span style="color: #222222; font-family: arial, sans-serif; line-height: normal;">Pedro González</span>&nbsp;y&nbsp; Presidente:&nbsp;<span style="color: #222222; font-family: arial, sans-serif; line-height: normal;">David Hernández</span><br>C.I.F: G86023439<br>Nombre dominio registrado: www.drupalday.es</p>','','filtered_html');
INSERT INTO `field_data_body` VALUES ('node','productos_vp','0','20','72','und','0','<p>Si quieres ayudarnos a hacer un evento mejor, puedes hacerlo con esta entrada especial que incluye una donación. ¡Y llévate una camiseta y <a href="/node/31">un libro de Forcontu</a> de regalo!</p><p><strong>Precio: 35 €</strong></p>','','filtered_html'),('node','page','0','41','229','und','0','<h2>19 de julio de 2013</h2><table class="timetable"><tbody><tr class="slot"><td class="time"><p>15:00 - 17:30</p></td><td class="workshop" rowspan="3"><p>Sprint</p><p><a href="/sprint_viernes">ver mapa</a></p></td></tr><tr class="slot"><td class="time"><p>17:30 - 18:00</p></td><td class="session"><p>Visita al CPD del<br>supercomputador Altamira del<br>Instituto de Física de Cantabria</p></td></tr><tr class="slot"><td class="time"><p>18:00 - 20:00</p></td></tr><tr class="slot"><td class="time"><p>21:45</p></td><td colspan="2"><p>Chupinazo inicio de la "Semana Grande de Santander 2013" en la plaza del Ayuntamiento</p></td></tr></tbody></table><p>&nbsp;</p><h2>20 de julio de 2013</h2><table class="timetable"><tbody><tr class="slot"><td class="time"><p>9:30 - 10:00</p></td><td class="session" colspan="3"><p>Sesión de bienvenida</p></td></tr><tr class="slot"><td class="time"><p>10:00 - 10:30</p></td><td class="session" rowspan="2"><p><a href="http://2013.drupalday.es/sesiones#symfony">Drupal y Symfony - Juan Pablo Novillo (juampy)</a></p></td><td class="session" rowspan="2">&nbsp;</td><td class="workshop" rowspan="4" colspan="1"><p>Sprint</p></td></tr><tr class="slot"><td class="time"><p>10:30 - 11:00</p></td></tr><tr class="slot"><td class="time"><p>11:00 - 11:30</p></td><td class="session" rowspan="2"><p><a id="blanco" href="http://2013.drupalday.es/sesiones#drupal8">Drupal 8 - José Reyero - (reyero)</a></p></td><td class="session" rowspan="2"><a id="blanco" href="http://2013.drupalday.es/sesiones#intro-drupal">Introducción a Drupal - Pedro Palomera y Francisco Alonso</a></td></tr><tr class="slot"><td class="time"><p>11:30 - 12:00</p></td></tr><tr class="slot"><td class="time"><p>12:00 - 12:30</p></td><td class="full coffee" colspan="3"><p>Pausa para el café</p></td></tr><tr class="slot"><td class="time"><p>12:30 - 13:00</p></td><td class="session" rowspan="2"><p><a id="blanco" href="http://2013.drupalday.es/sesiones#internacionalizacion">Internacionalización en Drupal 8 - Christian López (penyaskito)</a></p></td><td class="session" rowspan="2"><a id="blanco" href="http://2013.drupalday.es/sesiones#taller_oskar">Taller Webgrind y Pinba/Pinboard - Oskar Calvo (oskar)</a></td><td class="workshop" rowspan="3"><p>Sprint</p></td></tr><tr class="slot"><td class="time"><p>13:00 - 13:30</p></td></tr><tr class="slot"><td class="time"><p>13:30 - 14:00</p></td><td>&nbsp;</td><td>&nbsp;</td></tr><tr class="slot"><td class="time"><p>14:00 - 15:30</p></td><td class="full lunch" colspan="3"><p>Pausa para comer</p></td></tr><tr class="slot"><td class="time"><p>15:30 - 16:00</p></td><td class="session" rowspan="2"><p><a id="blanco" href="http://2013.drupalday.es/sesiones#behat">Behat - Ricardo Sanz (sanzante)</a></p></td><td class="session" rowspan="2">&nbsp;</td><td class="workshop" rowspan="6" colspan="1"><p>Sprint</p><p>&nbsp;</p><p>&nbsp;</p></td></tr><tr class="slot"><td class="time"><p>16:00 - 16:30</p></td></tr><tr class="slot"><td class="time"><p>16:30 - 17:00</p></td><td class="session" rowspan="2"><p><a id="blanco" href="http://2013.drupalday.es/sesiones#d8undercover">Drupal 8: Undercover initiatives - Pedro Cambra (pcambra)</a></p></td><td class="session" rowspan="2">&nbsp;</td></tr><tr class="slot"><td class="time"><p>17:00 - 17:30</p></td></tr><tr class="slot"><td class="time"><p>17:30 - 18:00</p></td><td class="session" rowspan="2"><p><a href="http://2013.drupalday.es/sesiones#drush6">Un vistazo a Drush 6 - Jonathan Araña Cruz (jonhattan)</a></p></td><td class="session" rowspan="2">&nbsp;</td></tr><tr class="slot"><td class="time"><p>18:00 - 18:30</p></td></tr><tr class="slot"><td class="time"><p>18:30 - 19:00</p></td><td class="full closure" colspan="3"><p>Sesión de despedida</p></td></tr><tr class="slot"><td class="time"><p>19:00 - 20:00</p></td><td class="session" colspan="3"><p><a href="http://asociaciondrupal.es/">Sesión ordinaria de la Asociación Española de Drupal</a></p></td></tr></tbody></table><p>&nbsp;</p><h2>21 de julio de 2013</h2><table class="timetable"><tbody><tr class="slot"><td class="time"><p>10:00</p></td><td class="session"><p>Paseo por la Península de La Magdalena (Pendiente de confirmar horario)</p></td></tr></tbody></table>','','full_html');
INSERT INTO `field_data_body` VALUES ('node','noticia','0','51','155','und','0','<p>Nos vamos acercando al <strong>Drupal Day 2013</strong>, que se celebrará en Santander el día <strong>20 de Julio</strong>. Un evento diseñado para que los drupaleros disfruten de su pasión y compartan una jornada especial de aprendizaje y diversión.</p><p>La <strong>Facultad de Ciencias de la Universidad de Cantabria</strong> acogerá este evento, con la ciudad de Santander en plena semana de fiestas como contexto. Poco a poco se irán añadiendo los contenidos, ideas y posibilidades que ofrecerá este nuevo Drupal Day; así que permaneced atentos a esta web.</p><p>También podeis seguir la actualidad del Drupal Day 2013 y compartir vuestras impresiones e ideas en <strong>Twitter</strong>, bajo el hashtag <a href="https://twitter.com/#!/search?q=%23DdaySan2013">#DdaySan2013</a>.</p><p>¡Bienvenidos!</p><p>&nbsp;</p>','','filtered_html'),('node','webform','0','52','168','und','0','<p>Para formalizar el registro tan solo debéis rellenar el formulario, <strong>no hay cuota de inscripción</strong>.</p>','','filtered_html'),('node','noticia','0','53','177','und','0','<p>Están disponibles para los asistentes descuentos para todos los tipos de trayectos de tren en los días cercanos al Drupal Day. Para disponer del cupón de descuento tan solo debes inscribirte y recibirás instrucciones en el email para usarlo.</p>','','filtered_html'),('node','noticia','0','56','188','und','0','<p>El viernes se realizará una visita guiada al CPD del <a href="http://www.ifca.unican.es/" target="_blank">Instituto de Física de Cantabria</a>, en el que se podrá ver el supercomputador <a href="http://es.wikipedia.org/wiki/Altamira_(supercomputador)" target="_blank">Altamira</a> perteneciente a la <a href="http://es.wikipedia.org/wiki/Red_Espa%C3%B1ola_de_Supercomputaci%C3%B3n" target="_blank">red española de supercomputación</a>. El lugar de encuentro es la entrada del&nbsp;<a style="line-height: 1.538em;" href="http://www.ifca.unican.es/" target="_blank">Instituto de Física de Cantabria</a>&nbsp;a las 17:30 del viernes, este edificio se encuentra detras de la <a href="http://www.unican.es/index.html" target="_blank">Facultad de Ciencias</a> de la <a href="http://www.unican.es/index.html" target="_blank">Universidad de Cantabra</a> (sede del Drupal Day).</p>','','filtered_html');
INSERT INTO `field_data_body` VALUES ('node','page','0','57','209','und','0','<p>\r\n	<style type="text/css">\r\n.hoteles td {\r\n padding:5px;\r\n border:2px solid #ccc;\r\n vertical-align:middle;\r\n}	</style>\r\n</p>\r\n<p>Aquí teneis algunas opciones para alojaros en Santander.</p>\r\n<h4>Lo más cercano</h4>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Hotel Santander Antiguo (*)</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.santanderantiguo.es</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 65A</td>\r\n		</tr>\r\n                 <tr>\r\n			<td>\r\n				Hostal La Torre</td>\r\n			<td>\r\n				942 27 50 71</td>\r\n			<td>\r\n				Av. de Los Castros, 53</td>\r\n		</tr>\r\n                 <tr>\r\n			<td>\r\n				Hostal Rocamar (**)</td>\r\n			<td>\r\n				www.hostalrocamar.com</td>\r\n			<td>\r\n				Av. de Los Castros, 41</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Pensión Soledad</td>\r\n			<td>\r\n				www.pensionsoledad.com</td>\r\n			<td>\r\n				Av. de Los Castros, 17</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Le Petit Boutique Hotel (*)</td>\r\n			<td>\r\n				www.lepetithotelsantander.com/</td>\r\n			<td>\r\n				Av. de Los Castros,  10</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Colón (*)</td>\r\n			<td>\r\n				942 27 23 00</td>\r\n			<td>\r\n				Plaza de Las Brisas, 1</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Boutique Las Brisas (*)</td>\r\n			<td>\r\n				www.hotellasbrisas-santander.com</td>\r\n			<td>\r\n				Calle La Braña, 14</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<h4>Zona Sardinero</h4>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Eurostars Hotel Real (*****)</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.hotelreal.es</td>\r\n			<td style="width: 120px;">\r\n				Av. Pérez Galdós, 28</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Sercotel Palacio del Mar (****)</td>\r\n			<td>\r\n				www.hotel-palaciodelmar.com</td>\r\n			<td>\r\n				Av. de Cantabria, 5</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Hoyuela (****)</td>\r\n			<td>\r\n				www.hotelhoyuela.es</td>\r\n			<td>\r\n				Av. de los Hoteles, 7</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Gran Hotel Sardinero (****)</td>\r\n			<td>\r\n				www.hotelsardinero.es</td>\r\n			<td>\r\n				Plaza de Italia, 1</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Silken Rio Santander (****)</td>\r\n			<td>\r\n				www.hoteles-silken.com/hoteles/rio-santander</td>\r\n			<td>\r\n				Av. de la Reina Victoria, 153</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Gran Hotel Victoria (****)</td>\r\n			<td>\r\n				www.granhotelvictoria.com</td>\r\n			<td>\r\n				Calle de María Luisa Pelayo, 38</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Santemar (****)</td>\r\n			<td>\r\n				www.santemarhotelsantander.com</td>\r\n			<td>\r\n				Calle Joaquín Costa, 28</td>\r\n		</tr>\r\n                 <tr>\r\n			<td>\r\n				Hotel Chiqui (***)</td>\r\n			<td>\r\n				www.hotelchiqui.com</td>\r\n			<td>\r\n                                Av. de Manuel García Lago, 9</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hostal Carlos III (**)</td>\r\n			<td>\r\n				www.hostalcarlos3.com</td>\r\n			<td>\r\n				Av. de la Reina Victoria, 135</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<h4>Zona Centro</h4>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Hotel Silken Coliseum Santander (****)</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				http://www.hoteles-silken.com/hoteles/coliseum-santander/</td>\r\n			<td style="width: 120px;">\r\n				Plaza de los Remedios, 1</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Bahía (****)</td>\r\n			<td>\r\n				www.hotelbahiasantander.com</td>\r\n			<td>\r\n				Av. Alfonso XIII, 6</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				NH Ciudad de Santander (***)</td>\r\n			<td>\r\n				www.nh-hoteles.es/nh/es/hoteles/espana/santander/nh-ciudad-de-santander.html</td>\r\n			<td>\r\n				Paseo Menéndez Pelayo, 13-15</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Central (***)</td>\r\n			<td>\r\n				www.elcentral.com</td>\r\n			<td>\r\n				Calle del General Mola, 5</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hotel Abba Santander (***)</td>\r\n			<td>\r\n				www.abbasantanderhotel.com</td>\r\n			<td>\r\n				Calle de Calderón de la Barca, 3</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hostal La Mexicana (**)</td>\r\n			<td>\r\n				www.hostallamexicana.com</td>\r\n			<td>\r\n				Calle de Juan de Herrera, 3</td>\r\n		</tr>\r\n		<tr>\r\n			<td>\r\n				Hostal Menéndez Pelayo</td>\r\n			<td>\r\n				www.hostalmenendezpelayo.es</td>\r\n			<td>\r\n				Paseo Menéndez Pelayo, 16</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<script src="http://maps.google.com/maps/api/js?sensor=false"  type="text/javascript"></script>\r\n<div id="map" style="width: 540px; height: 350px;">\r\n	&nbsp;</div>\r\n<script type="text/javascript">\r\n    var locations = [\r\n      [''Facultad de Ciencias'', 43.471359,-3.801144, 1],\r\n      [''Hotel Santander Antiguo'', 43.469895,-3.804642, 2],\r\n      [''Hostal Rocamar'', 43.47226,-3.79247, 3],\r\n      [''Hotel Boutique Las Brisas'', 43.474559,-3.786841, 4],\r\n      [''Le Petit Boutique Hotel'', 43.473687,-3.786895, 5],\r\n      [''NH Ciudad de Santander'', 43.465465,-3.7989, 6],\r\n      [''Hotel Hoyuela'', 43.471749,-3.783708, 7],\r\n      [''Hotel Sercotel Palacio del Mar'', 43.478226,-3.793977, 8],\r\n      [''Hostal La Torre'', 43.471305,-3.797334, 9],\r\n      [''Pensión Soledad'', 43.473656,-3.787013, 10],\r\n      [''Hotel Colón'', 43.474014,-3.785886, 11],\r\n      [''Eurostars Hotel Real'', 43.466018,-3.782455, 12],\r\n      [''Gran Hotel Sardinero'', 43.472465,-3.782948, 13],\r\n      [''Hotel Silken Rio Santander'', 43.471375,-3.780781, 14],\r\n      [''Gran Hotel Victoria'', 43.470254,-3.778764, 15],\r\n      [''Hotel Santemar'', 43.470051,-3.782905, 16],\r\n      [''Hotel Chiqui'', 43.481138,-3.787369, 17],\r\n      [''Hostal Carlos III'', 43.471048,-3.780051, 18],\r\n      [''Hostal Menéndez Pelayo'', 43.465701,-3.797957, 19],\r\n      [''Hotel Central'', 43.462077,-3.804839, 20],\r\n      [''Hotel Silken Coliseum Santander'', 43.462809,-3.808461, 21],\r\n      [''Hostal La Mexicana'', 43.462171,-3.809041, 22],\r\n      [''Hotel Bahía'', 43.46009,-3.806227, 23],\r\n      [''Hotel Abba Santander'', 43.45929,-3.809082, 24],\r\n    ];\r\n\r\n    var map = new google.maps.Map(document.getElementById(''map''), {\r\n      zoom: 13,\r\n      center: new google.maps.LatLng(43.471359,-3.801144),\r\n      mapTypeId: google.maps.MapTypeId.ROADMAP\r\n    });\r\n\r\n    var infowindow = new google.maps.InfoWindow();\r\n\r\n    var marker, i;\r\n\r\n    for (i = 0; i < locations.length; i++) {  \r\n      marker = new google.maps.Marker({\r\n        position: new google.maps.LatLng(locations[i][1], locations[i][2]),\r\n        map: map\r\n      });\r\n\r\n      google.maps.event.addListener(marker, ''click'', (function(marker, i) {\r\n        return function() {\r\n          infowindow.setContent(locations[i][0]);\r\n          infowindow.open(map, marker);\r\n        }\r\n      })(marker, i));\r\n    }\r\n  </script>','','full_html');
INSERT INTO `field_data_body` VALUES ('node','noticia','0','58','210','und','0','<p>A parte de las sesiones y talleres de las que podremos disfrutar durante el sábado, también podremos participar en el sprint que se llevará a cabo durante todo el día. Si ya conoces algo de Drupal 8 o quieres introducirte en esta nueva versión la mejor manera de hacerlo es participar en el sprint: no solo aprenderás, si no que además contribuirás a hacer este CMS mejor.</p><p>Hay muchas maneras de participar en un sprint y a pesar de lo que mucha gente cree, no es necesario saber programar: traducciones, revisión de parches, creación de nuevas issues... Podrás colaborar independientemente de tu área de trabajo y contarás con la ayuda y experiencia de otros drupaleros que ya han participado en otros sprints.</p><p>Además, gracias a la sponsorización de <a href="http://www.suomitech.com/">Suomitech</a>, que nos ceden un lugar de trabajo, podremos empezar el sprint el viernes por la tarde de 15:00 a 21:00.</p>','','filtered_html'),('node','page','0','59','218','und','0','<script src="http://maps.google.com/maps/api/js?sensor=false"  type="text/javascript"></script>\r\n<div id="map" style="width: 924px; height: 350px;">\r\n	&nbsp;</div>\r\n<script type="text/javascript">\r\n    var locations = [\r\n      [''Edificio CDTUC'', 43.47236, -3.798896, 1]\r\n    ];\r\n\r\n    var map = new google.maps.Map(document.getElementById(''map''), {\r\n      zoom: 14,\r\n      center: new google.maps.LatLng(43.47236, -3.798896),\r\n      mapTypeId: google.maps.MapTypeId.ROADMAP\r\n    });\r\n\r\n    var infowindow = new google.maps.InfoWindow();\r\n\r\n    var marker, i;\r\n\r\n    for (i = 0; i < locations.length; i++) {  \r\n      marker = new google.maps.Marker({\r\n        position: new google.maps.LatLng(locations[i][1], locations[i][2]),\r\n        map: map\r\n      });\r\n\r\n      google.maps.event.addListener(marker, ''click'', (function(marker, i) {\r\n        return function() {\r\n          infowindow.setContent(locations[i][0]);\r\n          infowindow.open(map, marker);\r\n        }\r\n      })(marker, i));\r\n    }\r\n  </script>\r\n<br>\r\n<p>Edificio CDTUC, Fase A, 2ª Planta (Módulo 208)</p>\r\n<p>Preguntar por la oficina de la empresa "Suomitech"</p>\r\n<p>Avenida de los Castros, s/n - 39005 - Santander - Cantabria</p>','','full_html');
INSERT INTO `field_data_body` VALUES ('node','noticia','0','64','223','und','0','<style>\r\n.izquierda {\r\n  float: left;\r\n margin: 10px;\r\n}\r\n.izquierda img {\r\n  width:250px;\r\n}\r\n</style>\r\n<p>Ya tenemos listas las camisetas oficiales del evento preparadas. Estarán a la venta durante todo el día.\r\nPrecio especial: 15€.</p>\r\n<div class="izquierda">\r\n  <a href="http://2013.drupalday.es/sites/default/files/IMG_0140.JPG"><img src="http://2013.drupalday.es/sites/default/files/IMG_0140.JPG"/></a>\r\n</div>\r\n<div class="izquierda">\r\n  <a href="http://2013.drupalday.es/sites/default/files/IMG_0141.JPG"><img src="http://2013.drupalday.es/sites/default/files/IMG_0141.JPG"/></a>\r\n</div>\r\n<div class="izquierda">\r\n  <a href="http://2013.drupalday.es/sites/default/files/IMG_0142.JPG"><img src="http://2013.drupalday.es/sites/default/files/IMG_0142.JPG"/></a>\r\n</div>\r\n<div class="izquierda">\r\n  <a href="http://2013.drupalday.es/sites/default/files/IMG_0143.JPG"><img src="http://2013.drupalday.es/sites/default/files/IMG_0143.JPG"/></a>\r\n</div>','','full_html'),('node','page','0','66','237','und','0','<p>\r\n	<style type="text/css">\r\n.hoteles td {\r\n padding:5px;\r\n border:2px solid #ccc;\r\n vertical-align:middle;\r\n}	</style>\r\n</p>\r\n<p>Durante el Drupal Day necesitaremos coger fuerzas para seguir con las charlas y sprints de la tarde, y os proponemos varias opciones:</p>\r\n<p>En Santander estaremos en plena Semana Grande, y las fiestas nos ofrecen la posibilidad de acercarnos a las <strong>casetas</strong> montadas para tan especial ocasión al lado de la feria, <strong>a tan solo 15 minutos andando de la Sede del Drupal Day</strong>. En ellas podremos degustar los mejores pinchos y platos de los restaurantes y cafeterías de la ciudad, por lo que es nuestra principal recomendación de cara a satisfacer vuestros estómagos. La promoción que ofrece cada caseta es: bebida + pincho de feria = 2,50€</p>\r\n<p>También os indicamos los restaurantes más cercanos donde poder comer un buen menú del día a precio económico o probar las raciones:</p>\r\n<table border="1" cellpadding="1" cellspacing="1" class="hoteles">\r\n	<tbody>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Bedoya 2</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.bedoya.com/Bedoya2.htm</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53F</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 9€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Escudero</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 53D</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 10€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Cafetería ISAE</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.cafeteriaisae.com</td>\r\n			<td style="width: 120px;">\r\n				Calle Fernando de los Ríos, 56</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 9,50€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Parque de las Llamas</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				</td>\r\n			<td style="width: 120px;">\r\n				Parque de las Llamas, C/ Marino Fernández Fontecha, 4</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 12€</td>\r\n		</tr>\r\n		<tr>\r\n			<td style="width: 90px;">\r\n				Restaurante Santander Antiguo</td>\r\n			<td class="rtejustify" style="width: 288px;">\r\n				www.santanderantiguo.es/la-cafeteria-restaur-residencia-de-estudiantes-hotel.html</td>\r\n			<td style="width: 120px;">\r\n				Av. de Los Castros, 65A</td>\r\n			<td style="width: 120px;">\r\n				Menú del Día: 10,50€</td>\r\n		</tr>\r\n	</tbody>\r\n</table>\r\n\r\n<script src="http://maps.google.com/maps/api/js?sensor=false"  type="text/javascript"></script>\r\n<div id="map" style="width: 540px; height: 350px;">\r\n	&nbsp;</div>\r\n<script type="text/javascript">\r\n    var locations = [\r\n      [''Facultad de Ciencias'', 43.471359,-3.801144, 1],\r\n      [''Restaurante Santander Antiguo'', 43.469895,-3.804642, 2],\r\n      [''Restaurante Bedoya 2'', 43.471453,-3.796617, 3],\r\n      [''Restaurante Escudero'', 43.471422,-3.797169, 4],\r\n      [''Restaurante Parque de las Llamas'', 43.47505,-3.800381, 5],\r\n      [''Cafetería ISAE'', 43.469247,-3.800951, 6],\r\n      [''Casetas'', 43.475528,-3.793787, 7],\r\n    ];\r\n\r\n    var map = new google.maps.Map(document.getElementById(''map''), {\r\n      zoom: 15,\r\n      center: new google.maps.LatLng(43.472932,-3.799599),\r\n      mapTypeId: google.maps.MapTypeId.ROADMAP\r\n    });\r\n\r\n    var infowindow = new google.maps.InfoWindow();\r\n\r\n    var marker, i;\r\n\r\n    for (i = 0; i < locations.length; i++) {  \r\n      marker = new google.maps.Marker({\r\n        position: new google.maps.LatLng(locations[i][1], locations[i][2]),\r\n        map: map\r\n      });\r\n\r\n      google.maps.event.addListener(marker, ''click'', (function(marker, i) {\r\n        return function() {\r\n          infowindow.setContent(locations[i][0]);\r\n          infowindow.open(map, marker);\r\n        }\r\n      })(marker, i));\r\n    }\r\n  </script>','','full_html');
INSERT INTO `field_data_body` VALUES ('node','noticia','0','67','230','und','0','<p>El 21 de julio se realizará un paseo para los asistentes al Drupal Day. Los asistentes que se encuentren el domingo en Santander, podrán disfrutar de un paseo por la <a href="http://es.wikipedia.org/wiki/Pen%C3%ADnsula_de_La_Magdalena" target="_blank">Península de la Magdalena</a>, sin duda una de las visitas obligadas para cualquier visitante a Santander.&nbsp;</p>','','filtered_html'),('node','noticia','0','70','236','und','0','<p>Así de bien quedan las camisetas del Drupal Day Santander. Recordamos que se pueden adquirir durante todo el sábado en la recepción.</p><p>En las primeras imágenes que mostramos de las camisetas se generó confusión con los colores debido a las fotografías tomadas con la cámara del móvil. En estas imágenes se muestran con los colores reales.</p><p>&nbsp;</p><p>&nbsp;</p>\r\n<img width="100%" src="http://2013.drupalday.es/sites/default/files/camiseta_modelo1.jpg"/>\r\n<img width="100%" src="http://2013.drupalday.es/sites/default/files/camiseta_modelo2.jpg"/>','<p>Así de bien quedan las camisetas del Drupal Day Santander. Recordamos que se pueden adquirir durante todo el sábado en la recepción.</p>','full_html'),('node','page','0','88','259','und','0','<p>Comming soon...</p><p>Pronto más información.</p>','','filtered_html');
DROP TABLE IF EXISTS `field_data_comment_body`;
CREATE TABLE `field_data_comment_body` (   `entity_type` varchar(128) NOT NULL DEFAULT '' COMMENT 'The entity type this data is attached to',   `bundle` varchar(128) NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned DEFAULT NULL COMMENT 'The entity revision id this data is attached to, or NULL if the entity type is not versioned',   `language` varchar(32) NOT NULL DEFAULT '' COMMENT 'The language for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `comment_body_value` longtext,   `comment_body_format` varchar(255) DEFAULT NULL,   PRIMARY KEY (`entity_type`,`entity_id`,`deleted`,`delta`,`language`),   KEY `entity_type` (`entity_type`),   KEY `bundle` (`bundle`),   KEY `deleted` (`deleted`),   KEY `entity_id` (`entity_id`),   KEY `revision_id` (`revision_id`),   KEY `language` (`language`),   KEY `comment_body_format` (`comment_body_format`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Data storage for field 1 (comment_body)';
