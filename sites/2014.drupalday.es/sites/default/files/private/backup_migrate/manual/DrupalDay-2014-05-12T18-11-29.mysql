INSERT INTO `locales_source` VALUES ('7457','/dday/?q=admin/config/user-interface/sweaver','default','Allowed Properties','','7.12'),('7458','/dday/?q=admin/config/user-interface/sweaver','default','Define which properties can be used in css besides the default ones defined by CTools. That list is found in ctools_css_filter_default_allowed_properties() in ctools/includes/css.inc. Enter one selector per line.','','7.12'),('7459','','default','Editor','','7.12'),('7460','/dday/?q=admin/config/user-interface/sweaver','default','Plugins','','7.12'),('7461','/dday/?q=admin/config/user-interface/sweaver','default','Selectors','','7.12'),('7462','','default','Properties','','7.12'),('7463','/dday/?q=admin/config/user-interface/sweaver/plugins','default','Following modules or plugins are disabled or missing: @module','','7.10'),('7464','/dday/?q=admin/config/user-interface/sweaver/plugins','default','Enable or disable plugins and select the order of the tabs on the frontend. Some plugins do not provide tabs in the frontend, but only add extra functionality.','','7.10'),('7465','','default','Plugin','','7.12'),('7466','/index.php','default','Project !project contains !count !types: !found.','','7.10'),('7467','','default','administer @font-your-face','','7.12'),('7468','/index.php','default','Change which fonts are enabled using the admin interface.','','7.12'),('7469','/index.php','default','Manages web fonts.','','7.12'),('7470','','default','Administrative interface for managing fonts.','','7.12'),('7471','/index.php','default','Defines a field type for referencing a font from a node.','','7.12'),('7472','/index.php','default','@font-your-face provider with Font Squirrel fonts.','','7.12'),('7473','/index.php','default','@font-your-face provider of fonts from Fontdeck.com.','','7.12'),('7474','/index.php','default','@font-your-face provider of fonts from Fonts.com.','','7.12'),('7475','/index.php','default','@font-your-face provider with Google fonts.','','7.12'),('7476',