INSERT INTO `locales_source` VALUES ('13270','/admin/modules/list/confirm','default','Edit Mime Mail user settings','','7.12'),('13271','/admin/modules/list/confirm','default','Edit user specific settings for Mime Mail.','','7.12'),('13272','/admin/modules/list/confirm','default','Send HTML e-mail','','7.12'),('13273','/admin/modules/list/confirm','default','The mail''s recipient address. The formatting of this string must comply with RFC 2822.','','7.12'),('13274','/admin/modules/list/confirm','default','CC Recipient','','7.12'),('13275','/admin/modules/list/confirm','default','The mail''s carbon copy address. You may separate multiple addresses with comma.','','7.12'),('13276','/admin/modules/list/confirm','default','BCC Recipient','','7.12'),('13277','/admin/modules/list/confirm','default','The mail''s blind carbon copy address. You may separate multiple addresses with comma.','','7.12'),('13278','','default','Sender name','','7.12'),('13279','/admin/modules/list/confirm','default','The sender''s name. Leave it empty to use the site-wide configured name.','','7.12'),('13280','/admin/modules/list/confirm','default','Sender e-mail address','','7.12'),('13281','/admin/modules/list/confirm','default','The sender''s address. Leave it empty to use the site-wide configured address.','','7.12'),('13282','/admin/modules/list/confirm','default','The mail''s message HTML body.','','7.12'),('13283','/admin/modules/list/confirm','default','Plain text body','','7.12'),('13284','/admin/modules/list/confirm','default','The mail''s message plaintext body.','','7.12'),('13285','','default','Attachments','','7.12'),('13286','/admin/modules/list/confirm','default','The mail''s attachments, one file per line e.g. "files/images/mypic.png" without quotes.','','7.12'),('13287','/admin/modules/list/confirm','default','Send HTML mail to all users of a role','','7.12'),('13288','/admin/modules/list/confirm','default','Plaintext body','','7.12'),('13289','/admin/modules/list/confirm','defau