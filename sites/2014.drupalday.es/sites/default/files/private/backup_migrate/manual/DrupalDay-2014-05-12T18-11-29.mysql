INSERT INTO `locales_source` VALUES ('12972','','default','Average uploaded file size','','none'),('12973','','default','Questions','','none'),('12974','','default','Randomize Options','','none'),('12975','','default','Randomizes the order of options on the top when they are displayed in the form.','','none'),('12976','','default','Randomize Questions','','none'),('12977','','default','Randomize the order of the questions on the side when they are displayed in the form.','','none'),('12978','','default','Non-empty','','none'),('12979','','default','Markup allows you to enter custom HTML or PHP logic into your form.','','none'),('12980','','default','Check this option if the user should be allowed to choose multiple values.','','7.12'),('12981','','default','Listbox','','7.12'),('12982','','default','Full node','','none'),('12983','','default','Submission settings','','7.12'),('12984','','default','From name','','7.12'),('12985','','default','From address','','7.12'),('12986','','default','E-mail template','','7.12'),('12987','','default','Export format','','7.12'),('12988','','default','Values','','7.12'),('12989','','default','Validation','','7.12'),('12990','','default','Available as block','','7.12'),('12991','','default','Step','','none'),('12992','','default','Redirect URL','','7.12'),('12993','','default','Resizable','','none'),('12994','','default','Custom template','','7.12'),('12995','','default','E-mail to','','7.12'),('12996','','default','Delimited text','','7.12'),('12997','','default','Delimited text format','','7.12'),('12998','','default','Comma (,)','','7.12'),('12999','','default','Tab (\\t)','','7.12'),('13000','','default','Semicolon (;)','','7.12'),('13001','','default','Colon (:)','','7.12');
INSERT INTO `locales_source` VALUES ('13002','','default','Period (.)','','7.12'),('13003','','default','Space ( )','','7.12'),('13004','','default','Save Draft','','7.12'),('13005','','default','12-hour (am/pm)','','none'),('13006','','default','24-hour','','none'),('13007','','default','There are no submissions for this form. <a href="!url">View this form</a>.','','none'),('13008','','default','New component name','','7.12'),('13009','','default','When adding a new component, the name field is required.','','none'),('13010','','default','Optional. You may organize your form by placing this component inside another fieldset.','','7.12'),('13011','','default','Component %name cloned.','','none'),('13012','','default','Component %name updated.','','7.12'),('13013','','default','Submissions for %user','','none'),('13014','','default','Showing all results.','','7.12'),('13015','','default','@total results total.','','7.12'),('13016','','default','This is the delimiter used in the CSV/TSV file when downloading Webform results. Using tabs in the export is the most reliable method for preserving non-latin characters. You may want to change this to another character depending on the program with which you anticipate importing results.','','7.12'),('13017','','default','These permissions affect which roles can submit this webform. It does not prevent access to the webform page. If needing to prevent access to the webform page entirely, use a content access module such as <a href="http://drupal.org/project/taxonomy_access">Taxonomy Access</a> or <a href="http://drupal.org/project/node_privacy_byrole">Node Privacy by Role</a>.','','7.12'),('13018','','default','Roles that can submit this webform','','7.12'),('13019','','default','Show complete form in teaser','','7.12'),('13020','','default','Display the entire form in the teaser display of this node.','','7.12'),('13021','','default','By default the submit button on this form will have the label <em>Submit</em>. Enter a new title here to override the default.','','7.12'),('13022','','default','Submissions for this form are closed.','','none');
INSERT INTO `locales_source` VALUES ('13023','','default','You must <a href="!login">login</a> or <a href="!register">register</a> to view this form.','','none'),('13024','','default','You do not have permission to view this form.','','none'),('13025','','default','You have submitted this form the maximum number of times (@count).','','none'),('13026','','default','You have already submitted this form.','','7.12'),('13027','','default','You may not submit another entry at this time.','','none'),('13028','','default','<a href="!url">View your previous submissions</a>.','','7.12'),('13029','','default','Available components','','7.12'),('13030','','default','These are the available field types for your installation of Webform. You may disable any of these components by unchecking its corresponding box. Only checked components will be available in existing or new webforms.','','7.12'),('13031','','default','Default e-mail values','','7.12'),('13032','','default','The default sender address for emailed webform results; often the e-mail address of the maintainer of your forms.','','7.12'),('13033','','default','The default sender name which is used along with the default from address.','','7.12'),('13034','','default','Default subject','','7.12'),('13035','','default','Form submission from: %title','','7.12'),('13036','','default','The default subject line of any e-mailed results.','','7.12'),('13037','','default','Allow cookies for tracking submissions','','7.12'),('13038','','default','<a href="http://www.wikipedia.org/wiki/HTTP_cookie">Cookies</a> can be used to help prevent the same user from repeatedly submitting a webform. This feature is not needed for limiting submissions per user, though it can increase accuracy in some situations. Besides cookies, Webform also uses IP addresses and site usernames to prevent repeated submissions.','','7.12'),('13039','','default','Default export format','','7.12'),('13040','','default','Default export delimiter','','7.12'),('13041','','default','Submission access control','','7.12'),('13042','','default','Select the user roles that may submit each individual webform','','7.12');
INSERT INTO `locales_source` VALUES ('13043','','default','Disable Webform submission access control','','7.12'),('13044','','default','By default, the configuration form for each webform allows the administrator to choose which roles may submit the form. You may want to allow users to always submit the form if you are using a separate node access module to control access to webform nodes themselves.','','7.12'),('13045','','default','Submission updated.','','none'),('13046','','default','Thank you, your submission has been received.','','7.12'),('13047','','default','You may use special tokens in this field that will be replaced with dynamic values.','','7.12'),('13048','','default','Token values','','7.12'),('13049','','default','Form components','','7.12'),('13050','','default','Website timezone','','none'),('13051','','default','User timezone','','none'),('13052','','default','Use a textfield for year','','none'),('13053','','default','If checked, the generated date field will use a textfield for the year. Otherwise it will use a select list.','','none'),('13054','','default','Entered !name is not a valid date.','','none'),('13055','','default','Leaving blank will use the default size.','','7.12'),('13056','','default','%value is not a valid email address.','','none'),('13057','','default','%field field is required.','','none'),('13058','','default','Filesize (KB)','','none'),('13059','','default','Options within the select list must be unique. The following keys have been used multiple times:','','none'),('13060','','default','Make this field resizable by the user.','','none'),('13061','','default','Examples: lb, kg, %.','','7.12'),('13062','','default','Entered %name is not a valid time.','','none'),('13063','','default','Compact','','7.12'),('13064','','default','Days of the week','','7.12'),('13065','','default','Form settings','','7.12'),('13066','','default','Unique','','7.12'),('13067','','default','Accepts any date in any <a href="http://www.gnu.org/software/tar/manual/html_chapter/Date-input-formats.html">GNU Date Input Format</a>. Strings such as today, +2 months, and Dec 9 2004 are all valid.','','none');
INSERT INTO `locales_source` VALUES ('13068','','default','Accepts a time in any <a href="http://www.gnu.org/software/tar/manual/html_chapter/Date-input-formats.html">GNU Date Input Format</a>. Strings such as now, +2 hours, and 10:30pm are all valid.','','none'),('13069','','default','Webform enables nodes to have attached forms and questionnaires.','','7.12'),('13070','','default','To add one, create a !types piece of content.','','7.12'),('13071','','default','Webform is currently not enabled on any content types.','','none'),('13072','','default','To use Webform, please enable it on at least one content type on this page.','','none'),('13073','','default','This page lists all of the content on the site that may have a webform attached to it.','','7.12'),('13074','','default','Webform-enabled piece of content','','none'),('13075','','default','Visit the <a href="!url">Webform settings</a> page and enable Webform on at least one content type.','','none'),('13076','','default','Optional: Enable Webform on multiple types by visiting the <a href="!url">Webform settings</a> page.','','7.12'),('13077','','default','Value of !component','','none'),('13078','','default','Value of "!component"','','7.12'),('13079','','default','Webform settings','','7.12'),('13080','','default','Edit e-mail settings','','7.12'),('13081','','default','Delete e-mail settings','','none'),('13082','','default','Check that all entered values for this field are unique. The same value is not allowed to be used twice.','','7.12'),('13083','','default','Other...','','7.12'),('13084','','default','Allow "Other..." option','','none'),('13085','','default','Check this option if you want to allow users to enter an option not on the list.','','none'),('13086','','default','Text for "Other..." option','','none'),('13087','','default','If allowing other options, enter text to be used for other-enabling option.','','none'),('13088','','default','Randomize options','','7.12'),('13089','','default','Randomizes the order of the options when they are displayed in the form.','','7.12'),('13090','','default','Maximum length of the textfield value.','','7.12');
INSERT INTO `locales_source` VALUES ('13091','','default','Webform-enabled content types','','7.12'),('13092','','default','Webform allows you to enable the webform components for any content type.  Choose the types on which you would like to associate webform components.','','7.12'),('13093','','default','E-mail address format','','7.12'),('13094','','default','Long format: "Example Name" &lt;name@example.com&gt;','','7.12'),('13095','','default','Short format: name@example.com','','7.12'),('13096','','default','Most servers support the "long" format which will allow for more friendly From addresses in e-mails sent. However many Windows-based servers are unable to send in the long format. Change this option if experiencing problems sending e-mails with Webform.','','7.12'),('13097','','default','There are currently no webforms on your site. Create a !types piece of content.','','none'),('13098','','default','Create a rule to control whether or not to show this form element.','','7.12'),('13099','','default','Conditional rules','','7.12'),('13100','','default','Determines whether the list below is inclusive or exclusive.','','7.12'),('13101','','default','Include all components','','7.12'),('13102','','default','The value %value has already been submitted once for the %title field. You may have already submitted this form, or you need to use a different value.','','none'),('13103','','default','Component value','','7.12'),('13104','','default','Currently not sending e-mails, add an e-mail recipient below.','','7.12'),('13105','','default','email@example.com','','7.12'),('13106','','default','Form submissions will be e-mailed to this address. Any email, select, or hidden form element may be selected as the recipient address. Multiple e-mail addresses may be separated by commas.','','7.12'),('13107','','default','Any textfield, select, or hidden form element may be selected as the subject for e-mails.','','7.12'),('13108','','default','Any email, select, or hidden form element may be selected as the sender''s e-mail address.','','7.12'),('13109','','default','Any textfield, select, or hidden form element may be selected as the sender''s name for e-mails.','','7.12');
INSERT INTO `locales_source` VALUES ('13110','','default','No available components','','none'),('13111','','default','An e-mail template can customize the display of e-mails.','','7.12'),('13112','','default','Included e-mail values','','7.12'),('13113','','default','The selected components will be included in the %email_values token. Individual values may still be printed if explicitly specified as a %email[key] in the template.','','7.12'),('13114','','default','Save e-mail settings','','7.12'),('13115','','default','E-mail header details','','7.12'),('13116','','default','Confirmation message','','7.12'),('13117','','default','Limit the number of submissions <em>per user</em>. A user is identified by their user login if logged-in, or by their IP Address and Cookie if anonymous. Use of cookies may be modified in the global <a href="!url">Webform settings</a>.','','7.12'),('13118','','default','Submission access','','7.12'),('13119','','default','Show the notification about previous submissions.','','7.12'),('13120','','default','Show the previous submissions notification that appears when users have previously submitted this form.','','7.12'),('13121','','default','Select list options','','7.12'),('13122','','default','Select list format','','7.12'),('13123','','default','Submission ID','','7.12'),('13124','','default','Included export components','','7.12'),('13125','','default','Option A','','7.12'),('13126','','default','Option B','','7.12'),('13127','','default','Option C','','7.12'),('13128','','default','Submitted by user: %username','','7.12'),('13129','','default','draft','','none'),('13130','','default','@name form','','none'),('13131','','default','You must <a href="!login">login</a> to view this form.','','none'),('13132','','default','Default: %value','','7.12'),('13133','','default','Default value timezone','','none'),('13134','','default','Load a pre-built option list','','7.12'),('13135','','default','Use a pre-built list of options rather than entering options manually. Options will not be editable if using pre-built list.','','7.12'),('13136','','default','Every option must have a key specified. Specify each option as "safe_key|Some readable option".','','none');
INSERT INTO `locales_source` VALUES ('13137','','default','Option keys must be less than 128 characters. The following keys exceed this limit:','','none'),('13138','','default','Edit component: @name','','7.12'),('13139','','default','Enable popup calendar','','none'),('13140','','default','Enable a JavaScript date picker next to the date field.','','none'),('13141','','default','Webform: !title','','none'),('13142','','default','Form only','','none'),('13143','','default','The display mode determines how much of the webform to show within the block.','','none'),('13144','','default','The default format for new e-mail settings. Webform e-mail options take precedence over the settings for system-wide e-mails configured in MIME mail.','','7.12'),('13145','','default','Send all e-mails in the default format','','7.12'),('13146','','default','Force all webform e-mails to be sent in the default format.','','7.12'),('13147','','default','No available components.','','none'),('13148','','default','Are you sure you want to revert any changes to your template back to the default?','','7.12'),('13149','','default','Message to be shown upon successful submission. If the redirection location is set to <em>Confirmation page</em> it will be shown on its own page, otherwise this displays as a message.','','7.12'),('13150','','default','Redirection location','','7.12'),('13151','','default','Choose where to redirect the user upon successful submission.','','7.12'),('13152','','default','Confirmation page','','7.12'),('13153','','default','No redirect (reload current page)','','7.12'),('13154','','default','If enabled this webform will be available as a block.','','7.12'),('13155','','default','Select keys','','7.12'),('13156','','default','Full, human-readable options (values)','','7.12'),('13157','','default','Short, raw options (keys)','','7.12'),('13158','','default','Enter a machine readable key for this form element. May contain only alphanumeric characters and underscores. This key will be used as the name attribute of the form element. This value has no effect on the way data is saved, but may be helpful if doing custom form processing.','','7.12');
INSERT INTO `locales_source` VALUES ('13159','','default','Status of this form','','7.12'),('13160','','default','Closing a form prevents any further submissions by any users.','','7.12'),('13161','','default','The %authenticated role applies to any user signed into the site, regardless of other assigned roles.','','7.12'),('13162','','default','This form may be used to resend e-mails configured for this webform. Check the e-mails that need to be sent and click <em>Resend e-mails</em> to send these e-mails again.','','none'),('13163','','default','Resend e-mails','','7.12'),('13164','','default','Submission saved. You may return to this form later and it will restore the current values.','','none'),('13165','','default','Questions list down the side of the grid. One question per line. <strong>Key-value pairs MUST be specified as "safe_key|Some readable option"</strong>. Use of only alphanumeric characters and underscores is recommended in keys.','','none'),('13166','','default','<strong>Key-value pairs MUST be specified as "safe_key|Some readable option"</strong>. Use of only alphanumeric characters and underscores is recommended in keys. One option per line. Option groups may be specified with &lt;Group Name&gt;. &lt;&gt; can be used to insert items at the root of the menu after specifying a group.','','7.12'),('13167','','default','Show "Save draft" button','','7.12'),('13168','','default','Allow your users to save and finish the form later. This option is available only for authenticated users.','','7.12'),('13169','','default','Automatically save as draft between pages','','7.12'),('13170','','default','Automatically save partial submissions when users click the "Next" or "Previous" buttons in a multipage form.','','7.12'),('13171','','default','The IP address of the user.','','7.12'),('13172','','default','The current date, formatted according to the site settings.','','7.12'),('13173','','default','The node title.','','7.12'),('13174','','default','Tokens may be populated from the URL by creating URLs of the form http://example.com/my-form?foo=bar. Using the token %get[foo] would print "bar".','','7.12');
INSERT INTO `locales_source` VALUES ('13175','','default','All included components in a hierarchical structure.','','7.12'),('13176','','default','If using relative dates for a default value (e.g. "today") base the current day on this timezone.','','none'),('13177','','default','The default value of the field identified by its key. For multiple selects use commas to separate multiple defaults.','','7.12'),('13178','','default','If using relative dates for a default value (e.g. "now") base the current time on this timezone.','','none'),('13179','','default','Label display','','7.12'),('13180','','default','Determines the placement of the component''s label.','','7.12'),('13181','','default','Hide label','','none'),('13182','','default','Do not display the label of this component.','','none'),('13183','','default','Save component','','7.12'),('13184','','default','The <em>Custom URL</em> option supports Webform token replacements.','','7.12'),('13185','','default','Show all webform pages in block','','none'),('13186','/admin/modules','default','<p>This module lets you create forms or questionnaires and define their content. Submissions from these forms are stored in the database and optionally also sent by e-mail to a predefined address.</p>\n      <p>Here is how to create one:</p>\n      <ul>\n        <li>!webform-types-message</li>\n        <li>Go to <a href="!create-content">Create content</a> and add a !types piece of content.</li>\n        <li>After saving the new content, you will be redirected to the main field list of the form that will be created. Add the fields you would like on your form.</li>\n        <li>Once finished adding fields, you may want to send e-mails to administrators or back to the user who filled out the form. Click on the <em>Emails</em> sub-tab underneath the <em>Webform</em> tab on the piece of content.</li>\n        <li>Finally, visit the <em>Form settings</em> sub-tab under the <em>Webform</em> tab to configure remaining configurations options for your form.\n          <ul>\n          <li>Add a confirmation message and/or redirect URL that is to be displayed after successful submission.</li>\n          <li>Set a submission limit.</li>\n          <li>Determine which roles may submit the form.</li>\n          <li>Advanced configuration options such as allowing drafts or show users a message indicating how they can edit their submissions.</li>\n          </ul>\n        </li>\n        <li>Your form is now ready for viewing. After receiving submissions, you can check the results users have submitted by visiting the <em>Results</em> tab on the piece of content.</li>\n      </ul>\n      <p>Help on adding and configuring the components will be shown after you add your first component.</p>\n      ','','7.12');
INSERT INTO `locales_source` VALUES ('13187','/admin/config/content/webform','default','Format override','','7.12'),('13188','/admin/config/content/webform','default','Per-webform configuration of e-mail format','','7.12'),('13189','/admin/config/content/webform','default','Include webform forms in search index','','7.12'),('13190','/admin/config/content/webform','default','When selected, all Webform nodes will have their form components indexed by the search engine.','','7.12'),('13191','/admin/config/content/webform','default','A plain text file delimited by commas, tabs, or other characters.','','7.12'),('13192','/admin/config/content/webform','default','Microsoft Excel','','7.12'),('13193','/admin/config/content/webform','default','A file readable by Microsoft Excel.','','7.12'),('13194','/admin/config/content/webform','default','Pipe (|)','','7.12'),('13195','/admin/config/spamicide/spamicide_form/add/webform_node_form','default','Set Spamicide form','','7.12'),('13196','/admin/config/spamicide/spamicide_form/add/webform_node_form','default','Add or edit form_id''s to protect with Spamicide.','','7.12'),('13197','/admin/config/spamicide/spamicide_form/add/webform_node_form','default','The Drupal form_id of the form to add the Spamicide to.','','7.12'),('13198','/admin/config/spamicide/spamicide_form/add/webform_node_form','default','Form field','','7.12'),('13199','/admin/config/spamicide/spamicide_form/add/webform_node_form','default','The name you want for the field. Use only letters, numbers, and the underscore character(_).','','7.12'),('13200','/node/add/webform','default','The new webform %title has been created. Add new fields to your webform with the form below.','','7.12'),('13201','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','Basic tokens','','7.12'),('13202','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','The name of the user if logged in. Blank for anonymous users.','','7.12'),('13203','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','The e-mail address of the user if logged in. Blank for anonymous users.','','7.12');
INSERT INTO `locales_source` VALUES ('13204','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','The name of the site (i.e. %site_name)','','7.12'),('13205','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','Node tokens','','7.12'),('13206','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','Special tokens','','7.12'),('13207','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','Any user profile field or value, such as %profile[name] or %profile[profile_first_name]','','7.12'),('13208','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','Tokens may also be populated from POST values that are submitted by forms.','','7.12'),('13209','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','In addition to %get and %post, the following super tokens may be used, though only with logged-in users: %server, %cookie, and %request. For example %server[HTTP_USER_AGENT] or %session[id].','','7.12'),('13210','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','E-mail tokens','','7.12'),('13211','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','A formatted value and field label. Elements may be accessed such as <em>%email[fieldset_a][key_b]</em>. Do not include quotes.','','7.12'),('13212','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','The URL for viewing the completed submission.','','7.12'),('13213','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','Submission tokens','','7.12'),('13214','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','The unique submission ID.','','7.12'),('13215','/node/52/webform/components/new/textfield?name=Nick&mandatory=1&pid=0&weight=0','default','A value without additional formatting. Elements may be accessed such as <em>%value[fieldset_a][key_b]</em>. Do not include quotes.','','7.12');
