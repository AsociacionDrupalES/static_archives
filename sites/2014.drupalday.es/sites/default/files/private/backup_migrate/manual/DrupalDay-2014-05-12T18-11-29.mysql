INSERT INTO `locales_source` VALUES ('12577','','default','Choose the database to restore to. Any database destinations you have created and any databases specified in your settings.php can be restored to.','','none'),('12578','','default','Are you sure you want to restore the database?','','none'),('12579','','default','Are you sure you want to restore the database from the backup file %file_id? This will delete some or all of your data and cannot be undone. <strong>Always test your backups on a non-production server!</strong>','','none'),('12580','','default','Are you sure you want to delete the backup file?','','none'),('12581','','default','Are you sure you want to delete the backup file %file_id? <strong>This action cannot be undone.</strong>','','none'),('12582','','default','Choose the database to backup. Any database destinations you have created and any databases specified in your settings.php can be backed up.','','none'),('12583','','default','destinations','','none'),('12584','','default','destination','','none'),('12585','','default','Add a new @s destination.','','none'),('12586','','default','Choose the type of destination you would like to create:','','none'),('12587','','default','No destination types available.','','none'),('12588','','default','Are you sure you want to delete the destination %name? Backup files already saved to this destination will not be deleted.','','none'),('12589','','default',' You do not need to enter a password unless you wish to change the currently saved password.','','none'),('12590','','default','File Encryption (EXPERIMENTAL)','','none'),('12591','','default','Encrypted files can only be restored by Backup and Migrate and only on sites with the same encryption key. <strong>This functionality is experimental, and should only be used for testing.</strong>','','none'),('12592','','default','AES Encryption','','none'),('12593','','default','!site backup succeeded','','none'),('12594','','default','The site backup has completed successfully with the following messages:\n!messages','','none'),('12595','','default','The site backup has completed successfully.\n','','none');
