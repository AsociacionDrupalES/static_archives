INSERT INTO `locales_source` VALUES ('441','','default','Menu selection requires the activation of menu module.','','none'),('442','','default','The lower the weight the higher/further left it will appear.','','7.12'),('443','','default','If creating a parent menu item, enter the title of the item.','','none'),('444','','default','If the parent menu item is a tab, enter the weight of the tab. The lower the number, the more to the left it will be.','','none'),('445','','default','- All -','','7.12'),('446','','default','Import code','','none'),('447','','default','Contact form','','7.12'),('448','','default','Equal','','none'),('449','','default','HTTP response code','','none'),('450','','default','Search form','','7.12'),('451','','default','Styles','','7.12'),('452','','default','Hello world!','','none'),('453','','default','The item has been deleted.','','7.12'),('454','','default','Greater than or equal to','','none'),('455','','default','Less than or equal to','','none'),('456','','default','The name of the site.','','7.12'),('457','','default','CTools CSS Cache','','7.12'),('458','','default','The CTools CSS cache directory, %path could not be created due to a misconfigured files directory. Please ensure that the files directory is correctly configured and that the webserver has permission to create directories.','','7.12'),('459','','default','Unable to create','','7.12'),('460','','default','A special cache used to store objects that are being edited; it serves to save state in an ordinarily stateless environment.','','7.12'),('461','','default','Chaos tools','','none'),('462','','default','A library of helpful tools by Merlin of Chaos.','','7.12'),('463','','default','Bulk export results','','none'),('464','','default','Place this in @file','','none'),('465','','default','There are no objects to be exported at this time.','','none'),('466','','default','Bulk Exporter','','none'),('467','','default','Bulk-export multiple CTools-handled data objects to code.',