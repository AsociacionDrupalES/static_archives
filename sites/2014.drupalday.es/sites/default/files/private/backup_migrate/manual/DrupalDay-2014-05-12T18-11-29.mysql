INSERT INTO `locales_source` VALUES ('12190','/index.php','default','The generator version number to store in the MANIFEST file. The default is 5.4.','','7.12'),('12191','/index.php','default','Preserve symbolic links.','','7.12'),('12192','/index.php','default','Specify where the Drupal site should be expanded, including the docroot. Defaults to the current working directory.','','7.12'),('12193','/index.php','default','Allow drush to overwrite any files in the destination.','','7.12'),('12194','/index.php','default','Backup the site''s database with Backup and Migrate.','','7.12'),('12195','/index.php','default','Restore the site''s database with Backup and Migrate.','','7.12'),('12196','/index.php','default','Get a list of available destinations.','','7.12'),('12197','/index.php','default','Get a list of available sources.','','7.12'),('12198','/index.php','default','Get a list of available settings profiles.','','7.12'),('12199','/index.php','default','Get a list of previously created backup files.','','7.12'),('12200','/index.php','default','Optional. The id of the source (usually a database) to backup. Use ''drush bam-sources'' to get a list of sources. Defaults to ''db''','','7.12'),('12201','/index.php','default','Optional. The id of destination to send the backup file to. Use ''drush bam-destinations'' to get a list of destinations. Defaults to ''manual''','','7.12'),('12202','/index.php','default','Optional. The id of a settings profile to use. Use ''drush bam-profiles'' to get a list of available profiles. Defaults to ''default''','','7.12'),('12203','/index.php','default','Backup the default databse to the manual backup directory using the default settings.','','7.12'),('12204','/index.php','default','Backup the database to the scheduled directory using a settings profile called "mysettings"','','7.12'),('12205','/index.php','default','Backup the files directory to the manual directory using the default settings. The Backup and Migrate Files module is required for files backups.','','7.12'),('12206','/index.php','default','Required. The id of the source (usually a database) to restore the backup to. Use ''drush bam-sources'' to get a list of sources. Defaults to ''db''','','7.12');
INSERT INTO `locales_source` VALUES ('12207','/index.php','default','Required. The id of destination to send the backup file to. Use ''drush bam-destinations'' to get a list of destinations. Defaults to ''manual''','','7.12'),('12208','/index.php','default','Required. The id of a backup file restore. Use ''drush bam-backups'' to get a list of available backup files.','','7.12'),('12209','/index.php','default','Required. The id of destination to list backups from. Use ''drush bam-destinations'' to get a list of destinations.','','7.12'),('12210','/index.php','default','A command name, or command alias.','','7.12'),('12211','/index.php','default','Restrict command list to those commands defined in the specified file. Omit value to choose from a list of names.','','7.12'),('12212','/index.php','default','Check for pending updates to Drush itself.','','7.12'),('12213','/index.php','default','Check to see if there is a newer Drush release available.','','7.12'),('12214','/index.php','default','Edit drushrc, site alias, and Drupal settings.php files.','','7.12'),('12215','/index.php','default','A substring for filtering the list of files. Omit this argument to choose from loaded files.','','7.12'),('12216','/index.php','default','Pick from a list of config/alias/settings files. Open selected in editor.','','7.12'),('12217','/index.php','default','Edit the global configuration file.','','7.12'),('12218','/index.php','default','Edit a particular alias file.','','7.12'),('12219','/index.php','default','Edit settings.php for the current Drupal site.','','7.12'),('12220','/index.php','default','Edit the second file in the choice list.','','7.12'),('12221','/index.php','default','Show all drush aliases in the report, even if there are a lot.','','7.12'),('12222','/index.php','default','Provides information about things that may be wrong in your Drupal installation, if any.','','7.12'),('12223','/index.php','default','Only show status report messages with a severity greater than or equal to the specified value.','','7.12'),('12224','/index.php','default','Comma-separated list of requirements to remove from output. Run with --pipe to see key values to use.','','7.12');
INSERT INTO `locales_source` VALUES ('12225','/index.php','default','Show all status lines from the Status Report admin page.','','7.12'),('12226','/index.php','default','Show only the red lines from the Status Report admin page.','','7.12'),('12227','/index.php','default','Print out a short report in the format "identifier: severity", where severity 2=error, 1=warning, and 0/-1=OK','','7.12'),('12228','/index.php','default','Execute a shell command. Usually used with a site alias.','','7.12'),('12229','/index.php','default','The shell command to be executed.','','7.12'),('12230','/index.php','default','A string of extra options that will be passed to the ssh command (e.g. "-p 100")','','7.12'),('12231','/index.php','default','Create a tty (e.g. to run an interactive program).','','7.12'),('12232','/index.php','default','Command string already escaped; do not add additional quoting.','','7.12'),('12233','/index.php','default','Retrieve latest code from git','','7.12'),('12234','/index.php','default','The unary flags to pass to rsync; --mode=rultz implies rsync -rultz.  Default is -akz.','','7.12'),('12235','/index.php','default','the install profile you wish to run. defaults to ''default'' in D6, ''standard'' in D7+','','7.12'),('12236','/index.php','default','any additional settings you wish to pass to the profile. Fully supported on D7+, partially supported on D6 (single step configure forms only). The key is in the form [form name].[parameter name] on D7 or just [parameter name] on D6.','','7.12'),('12237','/index.php','default','A Drupal 6 style database URL. Only required for initial install - not re-install.','','7.12'),('12238','/index.php','default','Account to use when creating a new database. Must have Grant permission (mysql only). Optional.','','7.12'),('12239','/index.php','default','uid1 name. Defaults to admin','','7.12'),('12240','/index.php','default','uid1 pass. Defaults to a randomly generated password. If desired, set a fixed password in drushrc.php.','','7.12'),('12241','/index.php','default','uid1 email. Defaults to admin@example.com','','7.12');
INSERT INTO `locales_source` VALUES ('12242','/index.php','default','Install using SQLite (D7+ only).','','7.12'),('12243','/index.php','default','Pass additional arguments to the profile (D7 example shown here - for D6, omit the form id).','','7.12'),('12244','/index.php','default','The batch id that will be processed.','','7.12'),('12245','/index.php','default','Default type engine.','','7.12'),('12246','/index.php','default','Download, install, serve and login to Drupal with minimal configuration and dependencies.','','7.12'),('12247','/index.php','default','Short name for the site to be created - used as a directory name and as sqlite file name. Optional - if omitted timestamped "quick-drupal" directory will be used instead.','','7.12'),('12248','/index.php','default','A list of projects to download into the new site. If projects contain extensions (modules or themes) with the same name they will be enabled by default. See --enable option to control this behaviour further.','','7.12'),('12249','/index.php','default','Drupal core to download. Defaults to "drupal" (latest stable version).','','7.12'),('12250','/index.php','default','Use an existing Drupal root, specified with --root. Overrides --core.','','7.12'),('12251','/index.php','default','The install profile to use. Defaults to standard.','','7.12'),('12252','/index.php','default','Specific extensions (modules or themes) to enable. By default, extensions with the same name as requested projects will be enabled automatically.','','7.12'),('12253','/index.php','default','Runserver option: Which http server to use - either: "cgi" for a CGI based httpserver (default, requires php 5.3 and php-cgi binary) or "builtin" for php 5.4 built in http server.','','7.12'),('12254','/index.php','default','Avoid starting runserver (and browser) for the created Drupal site.','','7.12'),('12255','/index.php','default','Runserver option: If opening a web browser, which browser to user (defaults to operating system default).','','7.12'),('12256','/index.php','default','Overrides "name" argument.','','7.12');
INSERT INTO `locales_source` VALUES ('12257','/index.php','default','Download option: Show release notes after each project is downloaded.','','7.12'),('12258','/index.php','default','Download option: Only useful for install profiles. Possible values: ''full'', ''projects'', ''profile-only''.','','7.12'),('12259','/index.php','default','Download option: Select the version to download interactively from a list of available releases.','','7.12'),('12260','/index.php','default','Download option: Skip automatic downloading of libraries (c.f. devel).','','7.12'),('12261','/index.php','default','Download option: Returns a list of the names of the extensions (modules and themes) contained in the downloaded projects.','','7.12'),('12262','/index.php','default','Site install option: A Drupal 6 style database URL. Only required for initial install - not re-install.','','7.12'),('12263','/index.php','default','Site install option: An optional table prefix to use for initial install.  Can be a key-value array of tables/prefixes in a drushrc file (not the command line).','','7.12'),('12264','/index.php','default','Site install option: Account to use when creating a new database. Must have Grant permission (mysql only). Optional.','','7.12'),('12265','/index.php','default','Site install option: Password for the "db-su" account. Optional.','','7.12'),('12266','/index.php','default','Site install option: uid1 name. Defaults to admin','','7.12'),('12267','/index.php','default','Site install option: uid1 pass. Defaults to a randomly generated password. If desired, set a fixed password in drushrc.php.','','7.12'),('12268','/index.php','default','Site install option: uid1 email. Defaults to admin@example.com','','7.12'),('12269','/index.php','default','Site install option: A short language code. Sets the default site language. Language files must already be present. You may use download command to get them.','','7.12'),('12270','/index.php','default','Site install option: Defaults to 1','','7.12'),('12271','/index.php','default','Site install option: Defaults to Site-Install','','7.12');
INSERT INTO `locales_source` VALUES ('12272','/index.php','default','Site install option: From: for system mailings. Defaults to admin@example.com','','7.12'),('12273','/index.php','default','Runserver option: Name of the php-cgi binary. If it is not on your current $PATH you should include the full path. You can include command line parameters to pass into php-cgi.','','7.12'),('12274','/index.php','default','Runserver option: Key-value array of variables to override in the $conf array for the running site. By default disables drupal_http_request_fails to avoid errors on Windows (which supports only one connection at a time). Comma delimited list of name=value pairs (or array in drushrc).','','7.12'),('12275','/index.php','default','Runserver option: A default addr:port/path to use for any values not specified as an argument.','','7.12'),('12276','/index.php','default','Runserver option: Resolve hostnames/IPs using DNS/rDNS (if possible) to determine binding IPs and/or human friendly hostnames for URLs and browser.','','7.12'),('12277','/index.php','default','Default <em class="placeholder">version_control</em> engine. Backup all project files before updates.','','7.12'),('12278','/index.php','default','Quickly add/remove/commit your project changes to Bazaar.','','7.12'),('12279','/index.php','default','Quickly add/remove/commit your project changes to Subversion.','','7.12'),('12280','/index.php','default','Cache release XML and tarballs or git clones. Git clones use git''s --reference option.','','7.12'),('12281','/index.php','default','Default <em class="placeholder">package_handler</em> engine. Download project packages using wget or curl.','','7.12'),('12282','/index.php','default','Use git.drupal.org to checkout and update projects.','','7.12'),('12283','/index.php','default','Work with development releases solely.','','7.12'),('12284','/index.php','default','Download and install stable release of Drupal into a timestamped directory, start server, and open the site logged in as admin.','','7.12'),('12285','/index.php','default','Fire up dev release of Drupal site with minimal install profile.','','7.12');
INSERT INTO `locales_source` VALUES ('12286','/index.php','default','Fire up stable release (using the cache) of Drupal site called "testsite", download and enable devel module, start a server on port 8081 and open /admin in firefox.','','7.12'),('12287','/index.php','default','Download and install the "Commerce Kickstart" distribution/install profile, display watchdog messages on the server console.','','7.12'),('12288','/index.php','default','Bashrc customization examples for Drush.','','7.12'),('12289','/index.php','default','Configuration overview with examples from example.drushrc.php.','','7.12'),('12290','/index.php','default','Site aliases overview on creating your own aliases for commonly used Drupal sites with examples from example.aliases.drushrc.php.','','7.12'),('12291','/index.php','default','php.ini or drush.ini configuration to set PHP values for use with Drush.','','7.12'),('12292','/index.php','default','Bastion server configuration: remotely operate on a Drupal sites behind a firewall.','','7.12'),('12293','/index.php','default','Bootstrap explanation: how Drush starts up and prepared the Drupal envionment for use with the command.','','7.12'),('12294','/index.php','default','Crontab instructions for running your Drupal cron tasks via `drush cron`.','','7.12'),('12295','/index.php','default','Shell script overview on writing simple sequences of Drush statements.','','7.12'),('12296','/index.php','default','Shell alias overview on creating your own aliases for commonly used Drush commands.','','7.12'),('12297','/index.php','default','Drush command instructions on creating your own Drush commands.','','7.12'),('12298','/index.php','default','Error code list containing all identifiers used with drush_set_error.','','7.12'),('12299','/index.php','default','Contexts overview explaining how Drush manages command line options and configuration file settings.','','7.12'),('12300','/index.php','default','Example Drush script.','','7.12'),('12301','/index.php','default','Example Drush command file.','','7.12'),('12302','/index.php','default','Example Drush commandfile that extends sql-sync to enable development modules in the post-sync hook.','','7.12');
INSERT INTO `locales_source` VALUES ('12303','/index.php','default','Example Drush commandfile that extends sql-sync to allow transfer of the sql dump file via http rather than ssh and rsync.','','7.12'),('12304','/index.php','default','Strict option handling, and how commands that use it differ from regular Drush commands.','','7.12'),('12305','/index.php','default','List all the available features for your site.','','7.12'),('12306','/index.php','default','Export a feature from your site into a module.','','7.12'),('12307','/index.php','default','Feature name to export.','','7.12'),('12308','/index.php','default','Patterns of components to include, see features-components for the format of patterns.','','7.12'),('12309','/index.php','default','Destination path (from Drupal root) of the exported feature. Defaults to ''sites/all/modules''','','7.12'),('12310','/index.php','default','Add a component to a feature module. (DEPRECATED: use features-export)','','7.12'),('12311','/index.php','default','Feature name to add to.','','7.12'),('12312','/index.php','default','List of components to add.','','7.12'),('12313','/index.php','default','List features components.','','7.12'),('12314','/index.php','default','The features components type to list. Omit this argument to list all components.','','7.12'),('12315','/index.php','default','Show only components that have been exported.','','7.12'),('12316','/index.php','default','Show only components that have not been exported.','','7.12'),('12317','/index.php','default','Update a feature module on your site.','','7.12'),('12318','/index.php','default','A space delimited list of features.','','7.12'),('12319','/index.php','default','Update all feature modules on your site.','','7.12'),('12320','/index.php','default','A space-delimited list of features to exclude from being updated.','','7.12'),('12321','/index.php','default','Revert a feature module on your site.','','7.12'),('12322','/index.php','default','Force revert even if Features assumes components'' state are default.','','7.12'),('12323','/index.php','default','Revert all enabled feature module on your site.','','7.12');
INSERT INTO `locales_source` VALUES ('12324','/index.php','default','A space-delimited list of features to exclude from being reverted.','','7.12'),('12325','/index.php','default','Show the difference between the default and overridden state of a feature.','','7.12'),('12326','/index.php','default','The feature in question.','','7.12'),('12327','/index.php','default','Turns a makefile into a working Drupal codebase.','','7.12'),('12328','/index.php','default','Filename of the makefile to use for this build.','','7.12'),('12329','/index.php','default','The path at which to build the makefile.','','7.12'),('12330','/index.php','default','Print the make API version and exit.','','7.12'),('12331','/index.php','default','Limits the number of concurrent projects that will be processed at the same time. The default is 4.','','7.12'),('12332','/index.php','default','Specify a path under which modules and themes should be placed. Defaults to sites/all.','','7.12'),('12333','/index.php','default','Force a complete build even if errors occur.','','7.12'),('12334','/index.php','default','Ignore md5 checksums for downloads.','','7.12'),('12335','/index.php','default','Output an md5 hash of the current build after completion. Use --md5=print to print to stdout.','','7.12'),('12336','/index.php','default','The default location to load the XML update information from.','','7.12'),('12337','/index.php','default','Do not use the pm-download caching (defaults to using this).','','7.12'),('12338','/index.php','default','Leave temporary build directories in place instead of cleaning up after completion.','','7.12'),('12339','/index.php','default','Do not require a Drupal core project to be specified.','','7.12'),('12340','/index.php','default','Do not write a PATCHES.txt file in the directory of each patched project.','','7.12'),('12341','/index.php','default','Do not modify .info files when cloning from Git.','','7.12'),('12342','/index.php','default','Prepare the built site for installation. Generate a properly permissioned settings.php and files directory.','','7.12'),('12343','/index.php','default','Generate a tar archive of the build. The output filename will be [build path].tar.gz.','','7.12');
INSERT INTO `locales_source` VALUES ('12344','/index.php','default','Run a temporary test build and clean up.','','7.12'),('12345','/index.php','default','Retrieve translations for the specified comma-separated list of language(s) if available for all projects.','','7.12'),('12346','/index.php','default','Preserves VCS directories, like .git, for projects downloaded using such methods.','','7.12'),('12347','/index.php','default','How to download files. Should be autodetected, but this is an override if it doesn''t work. Options are "curl" and "make" (a native download method).','','7.12'),('12348','/index.php','default','Restrict the make to this comma-separated list of projects. To specify all projects, pass *.','','7.12'),('12349','/index.php','default','Restrict the make to this comma-separated list of libraries. To specify all libraries, pass *.','','7.12'),('12350','/index.php','default','Build the example.make makefile in the example directory.','','7.12'),('12351','/index.php','default','Build an installation profile within an existing Drupal site','','7.12'),('12352','/index.php','default','Build the remote example.make makefile in the example directory.','','7.12'),('12353','/index.php','default','Generate a makefile from the current Drupal site.','','7.12'),('12354','/index.php','default','Exclude all version numbers (default is include all version numbers) or optionally specify a list of projects to exclude from versioning','','7.12'),('12355','/index.php','default','Include a specific list of projects, while all other projects remain unversioned in the makefile (so implies --exclude-versions)','','7.12'),('12356','/index.php','default','Generate a makefile with ALL projects versioned (should a project have a known version number)','','7.12'),('12357','/index.php','default','Generate a makefile with NO projects versioned','','7.12'),('12358','/index.php','default','Generate a makefile with ALL projects versioned EXCEPT core, Views and CCK','','7.12'),('12359','/index.php','default','Generate a makefile with NO projects versioned EXCEPT Admin Menu, OG and CTools.','','7.12');
INSERT INTO `locales_source` VALUES ('12360','/index.php','default','The temporary working directory to use','','7.12'),('12361','/index.php','default','The project array as generated by make_projects()','','7.12'),('12362','/index.php','default','Drush Make overview with examples','','7.12'),('12363','/index.php','default','Drush Make example makefile','','7.12'),('12364','/index.php','default','Attempt to download any missing dependencies. At the moment, only works when the module name is the same as the project name.','','7.12'),('12365','/index.php','default','Skip automatic downloading of libraries (c.f. devel).','','7.12'),('12366','/index.php','default','Filter by extension status. Choices: enabled, disabled and/or ''not installed''. You can use multiple comma separated values. (i.e. --status="disabled,not installed").','','7.12'),('12367','/index.php','default','Returns a whitespace delimited list of the names of the resulting extensions.','','7.12'),('12368','/index.php','default','Returns a whitespace delimited list of projects with any of its extensions enabled and their respective version and update information, one project per line. Order: project name, current version, recommended version, update status.','','7.12'),('12369','/index.php','default','A list of project names, with optional version. Defaults to ''drupal''','','7.12'),('12370','/index.php','default','Download webform. Fetch and populate the download cache as needed.','','7.12'),('12371','/index.php','default','Run a specific queue by name','','7.12'),('12372','/index.php','default','The name of the queue to run, as defined in either hook_queue_info or hook_cron_queue_info.','','7.12'),('12373','/index.php','default','Returns a list of all defined queues','','7.12'),('12374','/index.php','default','Return a comma delimited list of queues.','','7.12'),('12375','/index.php','default','Runs a lightweight built in http server for development.','','7.12'),('12376','/index.php','default','Host IP address and port number to bind to and path to open in web browser. Format is addr:port/path, default 127.0.0.1:8888, all elements optional. See examples for shorthand.','','7.12');
INSERT INTO `locales_source` VALUES ('12377','/index.php','default','Which http server to use - either: "cgi" for a CGI based httpserver (default, requires php 5.3 and php-cgi binary) or "builtin" for php 5.4 built in http server.','','7.12'),('12378','/index.php','default','Name of the php-cgi binary. If it is not on your current $PATH you should include the full path. You can include command line parameters to pass into php-cgi.','','7.12'),('12379','/index.php','default','Key-value array of variables to override in the $conf array for the running site. By default disables drupal_http_request_fails to avoid errors on Windows (which supports only one connection at a time). Comma delimited list of name=value pairs (or array in drushrc).','','7.12'),('12380','/index.php','default','A default addr:port/path to use for any values not specified as an argument.','','7.12'),('12381','/index.php','default','If opening a web browser, automatically log in as this user (user ID or username).','','7.12'),('12382','/index.php','default','If opening a web browser, which browser to user (defaults to operating system default).','','7.12'),('12383','/index.php','default','Resolve hostnames/IPs using DNS/rDNS (if possible) to determine binding IPs and/or human friendly hostnames for URLs and browser.','','7.12'),('12384','/index.php','default','Start runserver on 127.0.0.1, port 8080.','','7.12'),('12385','/index.php','default','Start runserver on 10.0.0.28, port 80.','','7.12'),('12386','/index.php','default','Start runserver on localhost (using rDNS to determine binding IP), port 8888, and open /user in browser. Use "php5-cgi" as the php-cgi binary.','','7.12'),('12387','/index.php','default','Start runserver on default IP/port (127.0.0.1, port 8888), and open / in browser.','','7.12'),('12388','/index.php','default','Use a default (would be specified in your drushrc) that starts runserver on port 8080, and opens a browser to the front page. Set path to a single hyphen path in argument to prevent opening browser for this session.','','7.12'),('12389','/index.php','default','Start builtin php 5.4 runserver on 127.0.0.1, port 9000, and open /admin in browser. Note that you need a colon when you specify port and path, but no IP.','','7.12');
INSERT INTO `locales_source` VALUES ('12390','/index.php','default','Print all known shell alias records.','','7.12'),('12391','/index.php','default','Shell alias to print','','7.12'),('12392','/index.php','default','Print the value of the shell alias ''pull''.','','7.12'),('12393','/index.php','default','Site specification to print','','7.12'),('12394','/index.php','default','Display the alias name, root, uri and host in a table.','','7.12'),('12395','/index.php','default','Print only the site alias name.  Default when no command line arguments are specified.','','7.12'),('12396','/index.php','default','For a single alias, set the name to use in the output.','','7.12'),('12397','/index.php','default','Only display sites that are available on the local system (remote-site not set, and Drupal root exists).','','7.12'),('12398','/index.php','default','Set a site alias to work on that will persist for the current session.','','7.12'),('12399','/index.php','default','Site specification to use, or "-" for previous site.','','7.12'),('12400','/index.php','default','Set the current session to use the @dev alias.','','7.12'),('12401','/index.php','default','Set the current session to use a site specification.','','7.12'),('12402','/index.php','default','Go back to the previously-set site (like `cd -`).','','7.12'),('12403','/index.php','default','Reset a persistently set site.','','7.12'),('12404','/index.php','default','Omit DROP TABLE statements. Postgres and Oracle only.  Used by sql-sync, since including the DROP TABLE statements interfere with the import when the database is created.','','7.12'),('12405','/index.php','default','Dump data without statements to create any of the schema.','','7.12'),('12406','/index.php','default','Skip standard tables. @see example.drushrc.php','','7.12'),('12407','/index.php','default','Enable replacement of braces in your query.','','7.12'),('12408','/index.php','default','Browse user record. Table prefixes, if used, must be added to table names by hand.','','7.12'),('12409','/index.php','default','Browse user record. Table prefixes are honored.  Caution: curly-braces will be stripped from all portions of the query.','','7.12');
INSERT INTO `locales_source` VALUES ('12410','/index.php','default','Copy the DB defined in sites/prod to the DB in sites/dev.','','7.12'),('12411','/index.php','default','The pattern for test email addresses in the sanitization operation, or "no" to keep email addresses unchanged.  May contain replacement patterns %uid, %mail or %name.  Default is "user+%uid@localhost".','','7.12'),('12412','/index.php','default','Connect to a Drupal site''s server via SSH for an interactive session or to run a shell command','','7.12'),('12413','/index.php','default','A remote site alias. Can be an alias list.','','7.12'),('12414','/index.php','default','Bash to execute on target. Optional, except when site-alias is a list.','','7.12'),('12415','/index.php','default','Open an interactive shell on @mysite''s server.','','7.12'),('12416','/index.php','default','Run "ls /tmp" on @prod site. If @prod is a site list, then ls will be executed on each site.','','7.12'),('12417','/index.php','default','Show Drush usage information that has been logged but not sent.  Usage statistics contain the Drush command name and the Drush option names, but no arguments or option values.','','7.12'),('12418','/index.php','default','Show cached usage statistics.','','7.12'),('12419','/index.php','default','Specify in a .drushrc.php file that usage information should be logged locally in a usage statistics file.','','7.12'),('12420','/index.php','default','Send anonymous Drush usage information to statistics logging site.  Usage statistics contain the Drush command name and the Drush option names, but no arguments or option values.','','7.12'),('12421','/index.php','default','Immediately send cached usage statistics.','','7.12'),('12422','/index.php','default','Specify in a .drushrc.php file that usage information should be sent.','','7.12'),('12423','/index.php','default','Specify the frequency (file size) that usage information should be sent.','','7.12'),('12424','/index.php','default','The name of the account to modify.','','7.12'),('12425','/index.php','default','The new password for the account.','','7.12');
INSERT INTO `locales_source` VALUES ('12426','/index.php','default','Set the password for the username someuser. @see xkcd.com/936','','7.12'),('12427','/index.php','default','A synonym for --format=export. Useful for pasting into code.','','7.12'),('12428','/index.php','default','The value to assign to the variable. Use ''-'' to read the object from STDIN.','','7.12'),('12429','/index.php','default','Format to parse the object. Use "auto" to detect format from value (default), "string", "integer" or "boolean" for corresponding primitive type, and "json" for JSON.','','7.12'),('12430','/index.php','default','Take the site offline; skips confirmation even if maintenance_mode variable does not exist. Variable is rewritten to site_offline for Drupal 6.','','7.12'),('12431','/index.php','default','Choose from a list of variables beginning with "pr" to set to (bool)true.','','7.12'),('12432','/index.php','default','Set a variable to a complex value (e.g. array)','','7.12'),('12433','/index.php','default','Only delete the one variable that exactly matches the specified name.','','7.12'),('12434','/index.php','default','Bring the site back online, skipping confirmation. Variable is rewritten to site_offline for Drupal 6.','','7.12'),('12435','/index.php','default','List all Views Bulk Operations (VBO) views, along with the operations associated with each.','','7.12'),('12436','/index.php','default','Execute a bulk operation based on a Views Bulk Operations (VBO) view.','','7.12'),('12437','/index.php','default','ID or name of the view to be executed.','','7.12'),('12438','/index.php','default','ID of the operation to be applied on the view results.','','7.12'),('12439','/index.php','default','Parameters to be passed as view input filters, view arguments or operation arguments, where type is respectively {input, argument, operation}.','','7.12'),('12440','/index.php','default','Publish nodes returned by view admin_content.','','7.12'),('12441','/index.php','default','Change node ownership on nodes returned by view #44, passing argument owner_uid=3 to the action.','','7.12');
INSERT INTO `locales_source` VALUES ('12442','/index.php','default','Unpublish nodes returned by view admin_content, filtering results of type expense and passing value 3 as first view argument.','','7.12'),('12443','/index.php','default','Fully executes a views_data_export display of a view and writes the output to file.','','7.12'),('12444','/index.php','default','The name of the view','','7.12'),('12445','/index.php','default','The id of the views_data_export display to execute on the view','','7.12'),('12446','/index.php','default','The file to write the results to - will be overwritten if it already exists','','7.12'),('12447','/index.php','default','csv,doc,txt,xls or xml. These options are ignored if the display_id passed is a "views_data_export" display.','','7.12'),('12448','/index.php','default','csv only: What character separates the fields (default:,)','','7.12'),('12449','/index.php','default','csv only: Trim whitespace from either side of fields (default:1)','','7.12'),('12450','/index.php','default','csv only: Make the first row a row of headers (default:1)','','7.12'),('12451','/index.php','default','csv only: Surround each field in quotes (default:1)','','7.12'),('12452','/index.php','default','Export myviewname:views_data_export_1 and write the output to output.csv in the current directory','','7.12'),('12453','/index.php','default','Return extended information about each message','','7.12'),('12454','/index.php','default','Show a listing of most recent 10 messages with extended information about each one and continue showing messages as they are registered in the watchdog.','','7.12'),('12455','/index.php','default','Cron run successful.','','7.12'),('12456','/admin/commerce/customer-profiles/types/billing/fields','default','Archivos','','7.12'),('12457','/admin/config','default','Update notifications are not enabled. It is <strong>highly recommended</strong> that you enable the update manager module from the <a href="@module">module administration page</a> in order to stay up-to-date on new releases. For more information, <a href="@update">Update status handbook page</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('12458','/admin/config/workflow/rules/reaction/manage/22/export','default','Export of !plugin "!label"','','7.12'),('12459','/admin/config/workflow/rules/reaction/manage/22/export','default','For importing copy the content of the text area and paste it into the import page.','','7.12'),('12460','/index.php','default','The generator version number to store in the MANIFEST file. The default is 5.9.','','7.12'),('12461','/index.php','default','Exclude Drupal core, so the backup only contains the site specific stuff.','','7.12'),('12462','/index.php','default','Options passed thru to the tar command.','','7.12'),('12463','/index.php','default','Omits any .git directories found in the tree as well as sites/default/files.','','7.12'),('12464','/index.php','default','Placeholder %files is replaced with the real path for the current site, and that path is excluded.','','7.12'),('12465','/index.php','default','Format to output . Allowed values are: json, export, html.','','7.12'),('12466','/index.php','default','Print help for all commands in HTML format. Deprecated - see --format option.','','7.12'),('12467','/index.php','default','Check for pending updates to Drush itself. Set to 0 to disable.','','7.12'),('12468','/index.php','default','Run editor in the background. Does not work with editors such as `vi` that run in the terminal.','','7.12'),('12469','/index.php','default','Return to shell prompt as soon as the editor window opens.','','7.12'),('12470','/index.php','default','Replace {rsync-option-name} with the rsync option (or option=''value'') that you would like to pass through to rsync. Examples include --delete, --exclude=*.sql, --filter=''merge /etc/rsync/default.rules'', etc. See the rsync documentation for a complete explaination of all the rsync options and values.','','7.12'),('12471','/index.php','default','Rsync Drupal root from Drush alias dev to the alias stage (one of which must be local).','','7.12'),('12472','/index.php','default','Rsync all files in the current directory to the ''img'' directory in the file storage folder on the Drush alias stage.','','7.12');
INSERT INTO `locales_source` VALUES ('12473','/index.php','default','Simulate Rsync Drupal root from the Drush alias dev to the alias stage (one of which must be local), excluding all files that match the filter ''*.sql'' and delete all files on the destination that are no longer on the source.','','7.12'),('12474','/index.php','default','Disable email notification during install and later. If your server has no smtp, this gets rid of an error during install.','','7.12'),('12475','/index.php','default','Makefile to use. Makefile must specify which version of Drupal core to build.','','7.12'),('12476','/index.php','default','Path to Drupal root.','','7.12'),('12477','/index.php','default','Create and install a site from a makefile.','','7.12'),('12478','/index.php','default','Do not use the pm-download caching (defaults to cache enabled).','','7.12'),('12479','/index.php','default','Add a persistent lock to remove the specified projects from consideration during updates.  Locks may be removed with the --unlock parameter, or overridden by specifically naming the project as a parameter to pm-update or pm-updatecode.  The lock does not affect pm-download.  See also the update_advanced project for similar and improved functionality.','','7.12'),('12480','/index.php','default','Create a database.','','7.12'),('12481','/index.php','default','Create the database for the current site.','','7.12'),('12482','/index.php','default','Create the database as specified for @site.test.','','7.12'),('12483','/index.php','default','Create the database as specified in the db-url option.','','7.12'),('12484','/index.php','default','A comma-separated list of tables to exclude completely. Optional.','','7.12'),('12485','/index.php','default','A comma-separated list of tables to include for structure, but not data. Optional.','','7.12'),('12486','/index.php','default','A key in the $db_url (D6) or $databases (D7+) array which provides the data.','','7.12'),('12487','/index.php','default','An optional uid, user name, or email address for the user to log in as. Default is to log in as uid 1. The uid/name/mail options take priority if specified.','','7.12');
