INSERT INTO `locales_target` VALUES ('2988','Lingala','es','0','0','0'),('2989','Laosiano','es','0','0','0'),('2990','Letón','es','0','0','0'),('2991','Malgache','es','0','0','0'),('2992','Marshallés','es','0','0','0'),('2993','Macedonio','es','0','0','0'),('2994','Malayalam','es','0','0','0'),('2995','Mongol','es','0','0','0'),('2996','Moldavo','es','0','0','0'),('2997','Márata','es','0','0','0'),('2998','Malayo','es','0','0','0'),('2999','Maltés','es','0','0','0'),('3000','Birmano','es','0','0','0'),('3001','Ndebele (septentrional)','es','0','0','0'),('3002','Nepalí','es','0','0','0'),('3003','Ndonga','es','0','0','0'),('3004','Noruego Bokmål','es','0','0','0'),('3005','Noruego Nynorsk','es','0','0','0'),('3006','Ndebele (meridional)','es','0','0','0'),('3007','Chichewa','es','0','0','0'),('3008','Occitano','es','0','0','0'),('3009','Oromo','es','0','0','0'),('3010','Oriya','es','0','0','0'),('3011','Osetio','es','0','0','0'),('3012','Punjabí','es','0','0','0'),('3013','Pali','es','0','0','0'),('3014','Pashto','es','0','0','0'),('3015','Portugués (Portugal)','es','0','0','0'),('3016','Portugués (brasileño)','es','0','0','0'),('3017','Quechua','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3018','Retorrománico','es','0','0','0'),('3019','Kirundi','es','0','0','0'),('3020','Kinyarwanda','es','0','0','0'),('3021','Sánscrito','es','0','0','0'),('3022','Sardo','es','0','0','0'),('3023','Sindhi','es','0','0','0'),('3024','Sami (septentrional)','es','0','0','0'),('3025','Sango','es','0','0','0'),('3026','Serbocroata','es','0','0','0'),('3027','Cingalés','es','0','0','0'),('3028','Esloveno','es','0','0','0'),('3029','Samoano','es','0','0','0'),('3030','Sonés','es','0','0','0'),('3031','Albanés','es','0','0','0'),('3032','Serbio','es','0','0','0'),('3033','Suazi','es','0','0','0'),('3034','Sesotés','es','0','0','0'),('3035','Sudanés','es','0','0','0'),('3036','Suajili','es','0','0','0'),('3037','Tamil','es','0','0','0'),('3038','Telugo','es','0','0','0'),('3039','Tayiko','es','0','0','0'),('3040','Tailandés','es','0','0','0'),('3041','Tigriña','es','0','0','0'),('3042','Turcomano','es','0','0','0'),('3043','Tagalo','es','0','0','0'),('3044','Setsuana','es','0','0','0'),('3045','Tsonga','es','0','0','0'),('3046','Tártaro','es','0','0','0'),('3047','Tui','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3048','Tahitiano','es','0','0','0'),('3049','Uighur','es','0','0','0'),('3050','Ucraniano','es','0','0','0'),('3051','Urdu','es','0','0','0'),('3052','Uzbeko','es','0','0','0'),('3053','Venda','es','0','0','0'),('3054','Vietnamita','es','0','0','0'),('3055','Uolof','es','0','0','0'),('3056','Xhosa','es','0','0','0'),('3057','Yidish','es','0','0','0'),('3058','Yoruba','es','0','0','0'),('3059','Zhuang','es','0','0','0'),('3060','Chino, simplificado','es','0','0','0'),('3061','Chino, tradicional','es','0','0','0'),('3062','Zulú','es','0','0','0'),('3063','Error enviando correo electrónico (de %from para %to).','es','0','0','0'),('3064','ordenar ascendente','es','0','0','0'),('3065','orden descendente','es','0','0','0'),('3066','Las operaciones con textos Unicode se emulan basándose en un esfuerzo óptimo. Puede instalar la <a href="@url">extensión mbstring de PHP</a> para mejorar el funcionamiento de Unicode.','es','0','0','0'),('3067','La sobrecarga de la función de cadenas multibyte en PHP está activa y se debe desactivar. Debe revisar la opción <em>mbstring.func_overload</em> de php.ini. Tiene más información en la <a href="@url">documentación mbstring de PHP</a>.','es','0','0','0'),('3068','La conversión de cadenas de entrada multibyte en PHP está activa y se debe desactivar. Debe revisar la opción <em>mbstring.encoding_translation</em> de php.ini. Tiene más información en la <a href="@url">documentación mbstring de PHP</a>.','es','0','0','0'),('3069','La conversión de cadenas de entrada multibyte en PHP está activa y se debe desactivar. Debe revisar la opción <em>mbstring.http_input</em> de php.ini. Tiene más información en la <a href="@url">documentación mbstring de PHP</a>.','es','0','0','0'),('3070','La conversión de cadenas de salida multibyte en PHP está activa y se debe desactivar. Debe revisar la opción <em>mbstring.http_output</em> de php.ini. Tiene más información en la <a href="@url">documentación mbstring de PHP</a>.','es','0','0','0'),('3071','PHP estándar','es','0','0','0'),('3072','Extensión Mbstring de PHP','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3073','Biblioteca Unicode','es','0','0','0'),('3074','No fue posible convertir la codificación de XML %s a UTF-8.','es','0','0','0'),('3075','Codificación %s no admitida. Haga el favor de instalar iconv, GNU recode o mbstring para PHP.','es','0','0','0'),('3076','Error al analizar. No está bien formado','es','0','0','0'),('3077','Error al analizar. La petición no está bien formada.','es','0','0','0'),('3078','Error del servidor. XML-RPC no válido. La petición puede ser la llamada a unmétodo.','es','0','0','0'),('3079','Error del servidor. El método @methodname no está especificado.','es','0','0','0'),('3080','Error del servidor. Número incorrecto de parámetros del método.','es','0','0','0'),('3081','Error del servidor. Parámetros del método no válidos.','es','0','0','0'),('3082','Error en el servidor. La función requerida @method no existe.','es','0','0','0'),('3083','Sintaxis no válida para system.multicall.','es','0','0','0'),('3084','Las llamadas recursivas a system.multicall están prohibidas.','es','0','0','0'),('3085','Error del servidor. Firma del método @methodname no especificada.','es','0','0','0'),('3086','El nombre del canal de noticias (o el nombre del sitio web que provee el canal).','es','0','0','0'),('3087','Categorizar elementos de noticias','es','0','0','0'),('3088','¿Está seguro de que quiere eliminar todo los elementos del canal de noticias %feed?','es','0','0','0'),('3089','casillas de selección','es','0','0','0'),('3090','selector múltiple','es','0','0','0'),('3091','Miles de sitios, en particular sitios de noticias y blog, publican sus titulares y entradas más recientes en canales, usando varios formatos estandarizados basados en XML. Los formatos que admite el agregador incluyen <a href="@rss">RSS</a>, <a href="@rdf">RDF</a> y <a href="@atom">Atom</a>.','es','0','0','0'),('3092','A continuación se listan los canales de noticias externos activos. Además se pueden <a href="@addfeed">añadir otros nuevos</a>. A cada canal o categoría de canal, se le puede activar su bloque de elementos más recientes en la <a href="@block">página de administración de bloques</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3093','Añada un canal de noticias en formato RSS, RDF o Atom. Cada canal de noticias sólo puede tener una entrada.','es','0','0','0'),('3094','Las categorías permiten agrupar elementos de canales de diferentes canales de noticias. Por ejemplo, varios canales relacionados con deportes pueden pertenecer a una categoría llamada <em>Deportes</em>. Los elementos de canal pueden agruparse automáticamente (eligiendo una categoría al crear o editar un canal) o manualmente (a través de la página para <em>Categorizar</em> disponible en los listados de elementos de canales). Cada categoría ofrece su propia página de canales de noticias y su bloque.','es','0','0','0'),('3095','Configurar qué contenido agrega su sitio desde otros sitios, la frecuencia de actualización y su categorización.','es','0','0','0'),('3096','Actualizar elementos','es','0','0','0'),('3097','Editar canal de noticias','es','0','0','0'),('3098','No hay bloques en esta región','es','0','0','0'),('3099','El bloque %info se asignó a la región %region no válida y se ha desactivado.','es','0','0','0'),('3100','Los cambios sobre estos bloques no se guardarán hasta que no pulse el botón <em>Guardar bloques</em>.','es','0','0','0'),('3101','Envía una entrada nueva al blog.','es','0','0','0'),('3102','No se le permite enviar una entrada nueva al blog.','es','0','0','0'),('3103','Usted no ha creado ninguna entrada en el blog.','es','0','0','0'),('3104','!author no ha creado ninguna entrada en el blog.','es','0','0','0'),('3105','No se han creado entradas en el blog.','es','0','0','0'),('3106','Entrada de blog','es','0','0','0'),('3107','Ver entradas de blog recientes','es','0','0','0'),('3108','Leer últimas entradas al blog de !username.','es','0','0','0'),('3109','blog de !username','es','0','0','0'),('3110','Leer las últimos entradas de blog.','es','0','0','0'),('3111','El tipo de contenido para el enlace %add-child debe ser uno de los seleccionados como tipos permitidos en índices de libros.','es','0','0','0'),('3112','Guardar las páginas de libro','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3113','Este libro ha sido modificado por otro usuario, los cambios no se pudieron guardar.','es','0','0','0'),('3114','El titulo ha sido cambiado de %original a %current.','es','0','0','0'),('3115','Actualizado el libro %title.','es','0','0','0'),('3116','libro: actualizado %title','es','0','0','0'),('3117','Actualizar el índice del libro','es','0','0','0'),('3118','Eliminar del índice del libro','es','0','0','0'),('3119','No se hicieron cambios','es','0','0','0'),('3120','Esta entrada ha sido añadida al libro seleccionado. Ahora puede ordenarlo en relación con otras páginas.','es','0','0','0'),('3121','Se ha actualizado el índice del libro.','es','0','0','0'),('3122','Hubo un error al añadir el envío al libro','es','0','0','0'),('3123','%title tiene páginas hijas asociadas, las cuales serán reubicadas automáticamente para mantener su conexión con el libro. Para recrear la jerarquía (como estaba antes de remover esta página), puede agregarse %title otra vez usando la pestaña Índice, y cada una de sus páginas hijas anteriores tendrán que ser recolocadas manualmente.','es','0','0','0'),('3124','%title puede agregarse otra vez a la jerarquía usando la pestaña Índice.','es','0','0','0'),('3125','¿Está seguro de que desea eliminar %title del índice del libro?','es','0','0','0'),('3126','El envío se ha eliminado del libro.','es','0','0','0'),('3127','Muestra una versión para impresión de esta página del libro y de sus sub páginas.','es','0','0','0'),('3128','Mostrar el bloque en todas las páginas.','es','0','0','0'),('3129','Mostrar el bloque solo en las páginas del libro','es','0','0','0'),('3130','Si se selecciona <em>Mostrar el bloque en todas las páginas</em>, el bloque contendrá los menús generados automáticamente para todos los libros del sitio. Si se selecciona <em>Mostrar el bloque sólo en las páginas de libros</em>, el bloque sólo contendrá el menú correspondiente al libro de la página actual. En este caso, si la página actual no está en un libro, no se desplegará ningún bloque. Pueden usarse las <em>Opciones de visibilidad específicas de página</em> u otras opciones de visibilidad además de desplegar selectivamente este bloque.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3131','Ésta es la pagina del nivel más alto de este libro.','es','0','0','0'),('3132','No se ha seleccionado ningún libro.','es','0','0','0'),('3133','La página padre en el libro. La profundidad máxima para un libro y todas sus páginas hijas es de !maxdepth. Algunas páginas en el libro elegido pueden no estar disponibles como padres si elegirlas hace que este límite se exceda.','es','0','0','0'),('3134','%title es parte del índice de un libro y tiene páginas subordinadas. Si procede a borrar, dichas páginas serán reubicadas automáticamente.','es','0','0','0'),('3135','Reordena las páginas del libro y cambia títulos','es','0','0','0'),('3136','Página de libro','es','0','0','0'),('3137','Color base','es','0','0','0'),('3138','Zona superior del encabezado','es','0','0','0'),('3139','Zona inferior del encabezado','es','0','0','0'),('3140','No hay suficiente memoria disponible para que PHP cambie el esquema de color del tema. Necesita al menos %size más. Tiene más información en la <a href="@url">documentación de PHP</a>.','es','0','0','0'),('3141','Eliminar los comentarios seleccionados','es','0','0','0'),('3142','Permite a los usuarios comentar y discutir contenido publicado.','es','0','0','0'),('3143','Ejemplo: "retroalimentación del sitio web" o "información del producto".','es','0','0','0'),('3144','Cuando se muestra la lista de categorías, las que tienen pesos ligeros (pequeños) se presentan por encima de de las categorías más pesadas (grandes). Las categorías con pesos iguales se ordenan alfabéticamente.','es','0','0','0'),('3145','El formulario de contacto no ha sido configurado. <a href="@add">Agregue una o más categorías</a> al formulario.','es','0','0','0'),('3146','Formulario de contacto personal','es','0','0','0'),('3147','Crear un formulario de contacto del sistema y configurar categorías para el uso del formulario.','es','0','0','0'),('3148','Editar categoría de contacto','es','0','0','0'),('3149','Habilita el uso de formularios de contacto personal y a nivel sitio.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3150','Registro en base de datos','es','0','0','0'),('3151','Ver los eventos registrados recientemente.','es','0','0','0'),('3152','Principales errores de "página no encontrada"','es','0','0','0'),('3153','Ver los errores de "página no encontrada" (404).','es','0','0','0'),('3154','Principales errores de "acceso denegado"','es','0','0','0'),('3155','Ver los errores de "acceso denegado" (403).','es','0','0','0'),('3156','Anota y registra eventos del sistema en la base de datos.','es','0','0','0'),('3157','Ningún rol puede usar este formato','es','0','0','0'),('3158','Etiquetas HTML permitidas: @tags','es','0','0','0'),('3159','Las anclas se usan para hacer enlaces a otras páginas.','es','0','0','0'),('3160','De forma predefinida, las etiquetas de saltos de líneas se añaden automáticamente, aunque puede usar esta etiqueta para añadir algunos saltos adicionales. Usar esta etiqueta es diferente, porque no se usa con un par de apertura y cierre como las demás. Use el « /» extra en la etiqueta para mantener la compatibilidad con XHTML 1.0.','es','0','0','0'),('3161','Texto con <br />salto de línea','es','0','0','0'),('3162','De forma predefinida, las etiquetas de párrafo se añaden automáticamente, aunque puede añadir etiquetas adicionales.','es','0','0','0'),('3163','Párrafo uno.','es','0','0','0'),('3164','Párrafo dos.','es','0','0','0'),('3165','Fuerte','es','0','0','0'),('3166','Enfatizado','es','0','0','0'),('3167','Citado','es','0','0','0'),('3168','Texto codificado que se usa para mostrar código fuente de programación','es','0','0','0'),('3169','Codificado','es','0','0','0'),('3170','Negrita','es','0','0','0'),('3171','Cursiva','es','0','0','0'),('3172','Superíndice','es','0','0','0'),('3173','<sup>Super</sup>índice','es','0','0','0'),('3174','Subíndice','es','0','0','0'),('3175','<sub>Sub</sub>índice','es','0','0','0'),('3176','<abbr title="Abbreviation">Abrev.</abbr>','es','0','0','0'),('3177','<acronym title="Three-Letter Acronym">ATL</acronym>','es','0','0','0'),('3178','Bloque de cita','es','0','0','0'),('3179','Citado en línea','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3180','Encabezado de tabla','es','0','0','0'),('3181','Celda de tabla','es','0','0','0'),('3182','Lista ordenada: utilice &lt;li&gt; para comenzar cada elemento de la lista','es','0','0','0'),('3183','Primer elemento','es','0','0','0'),('3184','Segundo elemento','es','0','0','0'),('3185','Lista desordenada: use &lt;li&gt; para comenzar cada elemento de la lista','es','0','0','0'),('3186','Las listas de definiciones son similares a otras listas HTML. &lt;dl&gt; da comienzo a la lista de definiciones, &lt;dt&gt; da comienzo a cada término definido y &lt;dd&gt; da comienzo a la descripción de la definición.','es','0','0','0'),('3187','Primer término','es','0','0','0'),('3188','Primera definición','es','0','0','0'),('3189','Segundo término','es','0','0','0'),('3190','Segunda definición','es','0','0','0'),('3191','Subtítulo tres','es','0','0','0'),('3192','Subtítulo cuatro','es','0','0','0'),('3193','Subtítulo cinco','es','0','0','0'),('3194','Subtítulo seis','es','0','0','0'),('3195','Descripción de la etiqueta','es','0','0','0'),('3196','Cuando escribe','es','0','0','0'),('3197','Obtiene','es','0','0','0'),('3198','No hay ayuda disponible para la etiqueta %tag.','es','0','0','0'),('3199','Ampersand','es','0','0','0'),('3200','Comillas','es','0','0','0'),('3201','Descripción del carácter','es','0','0','0'),('3202','Saltos automáticos de líneas y de párrafos.','es','0','0','0'),('3203','Las líneas y los párrafos se reconocen automáticamente. Las etiquetas &lt;br /&gt; para el salto de línea y &lt;p&gt; y &lt;/p&gt; para abrir y cerrar el párrafo se insertan automáticamente. Si los párrafos no se reconocen, simplemente añada unas cuantas líneas vacías.','es','0','0','0'),('3204','Las direcciones de las páginas web y las de correo se convierten en enlaces automáticamente.','es','0','0','0'),('3205','Configurar cómo se procesa el contenido introducido por los usuarios, incluidas las etiquetas HTML permitidas. También permite activar formatos de entrada proporcionados por módulos.','es','0','0','0'),('3206','Consejos de redacción','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3207','Un nombre breve y significativo para esta agrupación de temas de discusión.','es','0','0','0'),('3208','Descripción y directrices para los temas de este foro.','es','0','0','0'),('3209','Los foros son mostrados en orden ascendente por su peso (los foros con igual peso se muestran en orden alfabético).','es','0','0','0'),('3210','Un nombre breve y significativo para esta agrupación de foros relacionados.','es','0','0','0'),('3211','Descripción y directrices para los foros de este contenedor.','es','0','0','0'),('3212','Los contenedores son mostrados de forma ascendente por su peso (los del mismo peso se muestran por orden alfabético).','es','0','0','0'),('3213','Borrando un foro o su contenedor borrará los subforos, si los hay. Para borrar entradas en este foro, visite antes <a href="@content">Administración de contenido</a>. Esta acción no se puede deshacer.','es','0','0','0'),('3214','El número predefinido de temas de discusión que se muestra en  cada página.','es','0','0','0'),('3215','Sistema predefinido de ordenación de los temas de discusión.','es','0','0','0'),('3216','Los contenedores se suelen colocar a la cabeza (nivel raiz), pero se pueden colocar dentro de otro contenedor o foro.','es','0','0','0'),('3217','Los foros pueden ubicarce en el novel más alto (raíz), o dentro de otro contenedor o foro.','es','0','0','0'),('3218','Para más información, consulte la entrada del manual en pantalla del <a href="@forum">módulo Foro</a>.','es','0','0','0'),('3219','Tema del foro','es','0','0','0'),('3220','No está autorizado a publicar nuevos contenidos en el foro.','es','0','0','0'),('3221','Administra la presentación de la ayuda en pantalla.','es','0','0','0'),('3222','Esta página ofrece información general de los textos disponibles para su traducción. Drupal muestra los textos traducibles en grupos; los módulos pueden definir grupos de texto adicionales que contienen otros textos traducibles. Como los grupos de texto son un método para agrupar textos relacionados, generalmente son usados para dirigir los esfuerzos de traducción en áreas específicas de la interfaz de Drupal.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3223','Tenga en cuenta que los archivos <em>.po</em> dentro de un paquete de traducción se importan automáticamente (si está disponible) para nuevos módulos o temas que estén activados, o cuando se agregan nuevos idiomas. Desde esta página sólo permite la importación de un archivo <em>.po</em> a la vez, ésto hace más sencillo descargar y extraer una traducción de su paquete en el directorio de instalación de Drupal y <a href="@language-add">añadir el idioma</a> (que importará automáticamente todos archivos <em>.po</em> en el paquete). Los paquetes de traducción están disponibles para descargar en la <a href="@translations">página de traducciones de Drupal</a>.','es','0','0','0'),('3224','Esta página exporta los textos traducidos utilizados por su sitio. Un archivo de exportación puede ser en formato Gettext Portable Object (<em>.po</em>), que incluye el texto original y la traducción (que se utiliza para compartir con otras traducciones), o en formato Gettext Portable Object Template (<em>.pot</em>), que incluye sólo los textos originales (y que se utiliza para crear nuevas traducciones con un editor de traducción Gettext).','es','0','0','0'),('3225','Interfaz incorporada','es','0','0','0'),('3226','El idioma predeterminado de esta cuenta para mensajes de correo, y el idioma preferido para la presentación del sitio.','es','0','0','0'),('3227','El idioma predeterminado de esta cuenta para mensajes de correo.','es','0','0','0'),('3228','Un alias especificado para un idioma determinado será usado siempre al mostrar la página en ese idioma, y tiene preferencia sobre los alias definidos para <em>Todos los idiomas</em>','es','0','0','0'),('3229','Active el funcionamiento multi idioma para este tipo de contenido. Si está habilitado, se agregará al formulario de edición un campo selector de idioma, lo que le permitirá elegir entre uno de los <a href="!languages">idiomas habilitados</a>. Si está inhabilitado, los mensajes nuevos se salvan en el idioma predeterminado. El contenido existente no se verá afectado por cambios en esta opción.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3230','Configurar los idiomas para el contenido y la interfaz de usuario.','es','0','0','0'),('3231','Traducir la interfaz interna y otro textos.','es','0','0','0'),('3232','Agrega la capacidad de gestionar idiomas y permite la traducción de la interfaz de usuario a idiomas que no son inglés.','es','0','0','0'),('3233','Opciones del formulario de envío','es','0','0','0'),('3234','Este tipo de contenido no tiene un campo de título.','es','0','0','0'),('3235','El nombre de sistema sólo puede tener letras en minúsculas, números y guiones bajos.','es','0','0','0'),('3236','El nombre para los usuarios %name ya está asignado.','es','0','0','0'),('3237','¿Está seguro de que quiere eliminar el tipo de contenido %type?','es','0','0','0'),('3238','Añadido el tipo de contenido %name.','es','0','0','0'),('3239','Cambiado el tipo de contenido de 1 envío desde %old-type a %type.','es','0','0','0'),('3240','Cambiado el tipo de contenido de @count envíos desde %old-type a %type.','es','3239','1','0'),('3241','¿Está seguro de querer reconstruir los permisos del contenido de este sitio?','es','0','0','0'),('3242','Esta acción reconstruye todos los permisos en los contenidos del sitio, y puede ser un proceso largo. Esta acción no se puede deshacer.','es','0','0','0'),('3243','idioma','es','0','0','0'),('3244','Hubo un error y no se ejecutó el proceso por completo.','es','0','0','0'),('3245','La versión abreviada de sus entradas muestra cómo se verá la entrada cuando se lleve a la página principal o cuando se exporte para su sindicación.<span class="no-js"> Puede insertar el delimitador «&lt;!--break--&gt;» (sin las comillas) para ajustar el lugar a partir del que se cortará el envío.</span>','es','0','0','0'),('3246','Copia de la revisión de %date.','es','0','0','0'),('3247','@type %title ha sido revertido a la revisión de %revision-date','es','0','0','0'),('3248','Revisión del %revision-date de @type %title ha sido borrada','es','0','0','0'),('3249','@type: devuelto %title a la revisión %revision.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3250','Es necesario reconstruir los permisos de acceso al contenido.','es','0','0','0'),('3251','<strong>Configure su sitio web</strong> Cuando inicie sesión, visite la <a href="@admin">sección de administración</a>, en la que puede <a href="@config">personalizar y configurar</a> todos los aspectos de su sitio web.','es','0','0','0'),('3252','<strong>Habilite funcionalidad adicional</strong> Luego, visite la <a href="@modules">lista de módulos</a> y active las características que se ajusten a sus necesidades específicas. Puede encontrar módulos adicionales en la <a href="@download_modules">sección de descarga de módulos de Drupal</a>.','es','0','0','0'),('3253','<strong>Personalice el diseño de su sitio web</strong> Para cambiar la "apariencia" de su sitio web, visite la <a href="@themes">sección temas</a>. Puede elegir uno de los temas incluidos o descargar temas adicionales de la <a href="@download_themes">sección de descarga de temas de Drupal</a>.','es','0','0','0'),('3254','Reconstruyendo los permisos de acceso al contenido.','es','0','0','0'),('3255','Los permisos del contenido se han reconstruido.','es','0','0','0'),('3256','Los permisos de acceso al contenido no han sido correctamente reconstruidos.','es','0','0','0'),('3257','Añadir tipo de contenido','es','0','0','0'),('3258','Volver a una versión anterior','es','0','0','0'),('3259','Eliminar revisión anterior','es','0','0','0'),('3260','Permite que se envíe contenido al sitio y que se despliegue en páginas.','es','0','0','0'),('3261','Para usar OpenID usted primero debe establecer una identidad en un servidor OpenID público o privado. Si no tiene un OpenID y desea obtener uno, visite uno de los <a href="@openid-providers">proveedores públicos gratuitos</a>. Encuentre mayor información acerca de OpenID en <a href="@openid-net">este sitio</a>.','es','0','0','0'),('3262','Identidades OpenID','es','0','0','0'),('3263','Permite a los usuarios el inicio de sesión usando OpenID.','es','0','0','0'),('3264','El alias %alias ya se está usando en este idioma.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3265','Se ha guardado el alias.','es','0','0','0'),('3266','¿Está seguro de que quiere eliminar el alias a la ruta %title?','es','0','0','0'),('3267','Filtras alias','es','0','0','0'),('3268','Introduzca la ruta para la que desea crear un alias, seguida por el nombre del nuevo alias.','es','0','0','0'),('3269','Alias de URL','es','0','0','0'),('3270','Cambiar las rutas de URL del sitio creando alias.','es','0','0','0'),('3271','Editar alias','es','0','0','0'),('3272','Eliminar alias','es','0','0','0'),('3273','Añadir alias','es','0','0','0'),('3274','Permite a los usuarios renombrar URL.','es','0','0','0'),('3275','<a href="@drupal">Drupal.org</a> ofrece <a href="@php-snippets">algunos fragmentos de código PHP de ejemplo</a>, o usted puede crear los suyos propios con algo de experiencia en PHP y conociendo su sistema Drupal.','es','0','0','0'),('3276','Puede agregar código PHP. Debe incluir las etiquetas &lt;?php ?&gt;.','es','0','0','0'),('3277','Usando código PHP personalizado','es','0','0','0'),('3278','Es posible incluir código PHP personalizado en algunos tipos de contenido del sitio, incluyendo entradas y bloques. Si bien incluir código PHP dentro de un mensaje o bloque es una característica flexible y poderosa si la emplea un usuario confiable con experiencia en PHP, es un riesgo de seguridad importante y peligroso cuando se usa de manera inapropiada. Incluso un error pequeño al publicar código PHP puede accidentalmente comprometer su sitio.','es','0','0','0'),('3279','Si no está familiarizado con PHP. SQL o Drupal, evite usar código PHP personalizado en sus entradas. Experimentar con PHP puede corromper su base de datos, hacer que su sitio deje de funcionar o comprometer la seguridad de modo importante.','es','0','0','0'),('3280','Notas:','es','0','0','0'),('3281','Recuerde verificar dos veces cada línea en busca de errores de sintaxis y lógica <strong>antes</strong> de guardar.','es','0','0','0'),('3282','Las declaraciones deben terminarse correctamente con punto y coma.','es','0','0','0'),('3283','Las variables globales usadas en su código PHP conservan sus valores después de que se ejecuta su script.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3284','<code>register_globals</code> está <strong>desactivado</strong>. Si necesita usar formularios, comprenda y use las funciones disponibles en la <a href="@formapi">API para formularios de Drupal</a>.','es','0','0','0'),('3285','Use una declaración <code>print</code> o <code>return</code> en su código para devolver contenido.','es','0','0','0'),('3286','Desarrolle y pruebe su código PHP usando un script de prueba separado y una base de datos de pruebas antes de desplegarlo en un sitio en funcionamiento real.','es','0','0','0'),('3287','Considere incluir su código PHP personalizado dentro de un módulo específico del sitio o de un archivo <code>template.php</code> en vez de insertarlo directamente en un mensaje o bloque.','es','0','0','0'),('3288','Tenga presente que la capacidad de incluir código PHP en el contenido es ofrecida por el módulo Filtro PHP. Si este módulo es desactivado o borrado, los bloques y mensajes que incluyan PHP podrían desplegar el código PHP en vez de ejecutarlo.','es','0','0','0'),('3289','Ejemplo básico: <em>Cómo crear un bloque «Bienvenido» que reciba a los visitantes con un mensaje sencillo.</em>','es','0','0','0'),('3290','Evaluador de PHP','es','0','0','0'),('3291','Ejecuta un fragmento de código PHP. ¡Sólo los administradores deberían poder usar este filtro!','es','0','0','0'),('3292','Permite la evaluación de fragmentos de código PHP.','es','0','0','0'),('3293','Total de votos: @votes','es','0','0','0'),('3294','Encuesta más reciente','es','0','0','0'),('3295','Una <em>encuesta</em> es una pregunta con un grupo de respuestas posibles. Una <em>encuesta</em>, una vez creada, proporciona automáticamente un sencillo contador del número de votos que ha recibido cada respuesta.','es','0','0','0'),('3296','Estado de la encuesta','es','0','0','0'),('3297','Cuando una encuesta está cerrada, los visitantes ya no pueden votar en ella.','es','0','0','0'),('3298','Tras este período, la encuesta se cierra automáticamente.','es','0','0','0'),('3299','No se permiten valores negativos.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3300','Su voto no puede ser registrado porque no ha seleccionado ninguna de las opciones.','es','0','0','0'),('3301','Conteo de votos','es','0','0','0'),('3302','Encuestas','es','0','0','0'),('3303','Los campos del perfil han sido actualizados.','es','0','0','0'),('3304','No hay campos en esta categoría. Si esta categoría sigue vacía al guardar, será removida.','es','0','0','0'),('3305','El nombre del campo. El nombre del formulario no se le muestra al usuario pero se utiliza internamente en el código HTML y en las URL.\r\nA menos que sepa lo que hace, se le recomienda encarecidamente que use el prefijo &amp;lt;code&amp;gt;profile_&amp;lt;/code&amp;gt; en el nombre del formulario para evitar conflictos de nombres con otros campos. Espacios y cualquier otro caracter especial excepto el guión corto (-) y el guión bajo (_) no están permitidos. Un ejemplo de nombre es "perfil_color_favorito" o quizás sólo "perfil_color".','es','0','0','0'),('3306','Una lista de todas las opciones. Ponga cada opción en una línea separada. Ejemplos de opciones son "rojo", "azul", "verde", etc.','es','0','0','0'),('3307','Campo oculto del perfil. Sólo pueden acceder a él los administradores, los módulos y los temas.','es','0','0','0'),('3308','Campo privado, contenido sólo disponible para usuarios con privilegios.','es','0','0','0'),('3309','Campo público, contenido mostrado en la página del perfil pero no en las páginas con listas de miembros.','es','0','0','0'),('3310','Campo público, contenido mostrado en la página del perfil y en las páginas con listas de miembros.','es','0','0','0'),('3311','Los pesos definen el orden en el que se muestran los campos del formulario. Los campos más ligeros «flotan» hacia la parte superior de la categoría.','es','0','0','0'),('3312','El formulario se completa automáticamente mientras el usuario escribe.','es','0','0','0'),('3313','Por seguridad, la opción auto-completar estará desactivada si el usuario no tiene acceso a los perfiles de usuario.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3314','El nombre del formulario especificado contiene uno o más caracteres ilegales. No se permiten los espacios ni los caracteres especiales, sólo los guiones (-) y los guiones bajos (_).','es','0','0','0'),('3315','El nombre de formulario especificado está reservado para su uso por Drupal.','es','0','0','0'),('3316','El nombre de categoría especificado está reservado para su uso por Drupal.','es','0','0','0'),('3317','El título especificado ya está en uso.','es','0','0','0'),('3318','El nombre especificado ya se está usando.','es','0','0','0'),('3319','Un campo oculto no puede ser obligatorio.','es','0','0','0'),('3320','Un campo oculto no puede definirse como visible en el formulario de registro del usuario.','es','0','0','0'),('3321','Se ha creado el campo.','es','0','0','0'),('3322','¿Está seguro de que quiere eliminar el campo %field?','es','0','0','0'),('3323','Esta acción no se puede deshacer. Si los usuarios han introducido valores en este campo en su perfil, estas entradas también se eliminan. Si quiere mantener los datos introducidos por el usuario en lugar de eliminar el campo, quizás quiera <a href="@edit-field">editar este campo</a> y establecerlo como un «campo oculto del perfil» para que sólo puedan acceder a él los administradores.','es','0','0','0'),('3324','Se ha eliminado el campo %field.','es','0','0','0'),('3325','Campo de perfil %field añadido a la categoría %category.','es','0','0','0'),('3326','Campo del perfil %field eliminado.','es','0','0','0'),('3327','Lista de usuarios','es','0','0','0'),('3328','campo de texto de una línea','es','0','0','0'),('3329','campo de texto de varias líneas','es','0','0','0'),('3330','casilla de verificación','es','0','0','0'),('3331','lista de selección','es','0','0','0'),('3332','lista libre','es','0','0','0'),('3333','Información del autor','es','0','0','0'),('3334','Enlace al perfil completo del usuario','es','0','0','0'),('3335','Campos del perfil que se muestran','es','0','0','0'),('3336','Seleccione qué campos del perfil quiere mostrar en el bloque. Sólo están disponibles los campos designados como públicos en la<a href="@profile-admin">configuración de campos del perfil</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3337','Ver el perfil completo del usuario','es','0','0','0'),('3338','Acerca de %name','es','0','0','0'),('3339','Ponga cada elemento en una línea aparte o sepárelos por comas. No se permite HTML.','es','0','0','0'),('3340','El valor que proporcionó en %field no es una URL válida.','es','0','0','0'),('3341','Crear campos personalizables para sus usuarios.','es','0','0','0'),('3342','Autocompletado de categoría de perfil','es','0','0','0'),('3343','Editar campo','es','0','0','0'),('3344','Eliminar campo','es','0','0','0'),('3345','Autocompletado de perfil','es','0','0','0'),('3346','Admite perfiles de usuario configurables.','es','0','0','0'),('3347','Se reconstruirá el índice.','es','0','0','0'),('3348','Estado de indexación','es','0','0','0'),('3349','Regulación de la indexación','es','0','0','0'),('3350','Número de elementos a indexar en cada ejecución de cron','es','0','0','0'),('3351','El número máximo de elementos indexados en cada ejecución de una <a href="@cron">tarea de mantenimiento cron</a>. De ser necesario, reduzca el número de elementos para evitar tiempos agotados y errores de memoria durante la indexación.','es','0','0','0'),('3352','Opciones de indexación','es','0','0','0'),('3353','<p><em>Cambiar las opciones siguientes hara que se reconstruya el índice del sitio. El índice de búsqueda no es limpiado, sino que se actualiza sistemáticamente para reflejar las nuevas opciones. La búsqueda seguirá funcionando pero el nuevo contenido no será indexado hasta que todo el contenido existente haya sido reindexado.</em></p><p><em>Las opciones predeterminadas deberían ser adecuadas para la mayoría de los sitios.</em></p>','es','0','0','0'),('3354','Longitud mínima de la palabra que se va a indexar','es','0','0','0'),('3355','El número de caracteres que tiene que tener una palabra para que se pueda indexar. Un número más bajo mejora el ranking, pero también hace que la base de datos sea mayor. Cada consulta de búsqueda debe contener al menos una palabra de este tamaño (o mayor).','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3356','Gestión sencilla de CJK','es','0','0','0'),('3357','Si aplicar un separador silábico de chino sencillo, japonés o coreano basado en secuencias que se solapan. Desactívelo si quiere usar un preprocesador externo para esto. No afecta a otros idiomas.','es','0','0','0'),('3358','El motor de búsqueda mantiene un índice de las palabras encontradas en el contenido de su sitio. Para construir y mantener este índice, se requiere una <a href="@cron">tarea de mantenimiento cron</a> correctamente configurada. La conducta del indexamiento puede ajustarse usando las siguientes opciones.','es','0','0','0'),('3359','Frases principales en las búsquedas','es','0','0','0'),('3360','Ver las frases más populares en las búsquedas.','es','0','0','0'),('3361','Permite la búsqueda de palabras en todo el sitio.','es','0','0','0'),('3362','Tiempo total de generación de páginas','es','0','0','0'),('3363','%time ms','es','0','0','0'),('3364','Páginas más visitadas en %interval','es','0','0','0'),('3365','Visitantes más asiduos en %interval','es','0','0','0'),('3366','Referentes principales en %interval','es','0','0','0'),('3367','Registra el acceso a cada página. Necesario para las estadísticas de referente.','es','0','0','0'),('3368','Las entradas del registro de acceso más antiguas (incluyendo estadísticas de referentes) serán descartadas automáticamente. (Requiere de una <a href="@cron">tarea de mantenimiento cron</a> correctamente configurada.)','es','0','0','0'),('3369','Opciones de los contadores de impresiones del contenido','es','0','0','0'),('3370','Contar las impresiones del contenido','es','0','0','0'),('3371','Incrementa un contador cada vez que se muestra el contenido.','es','0','0','0'),('3372','Opciones para la información estadística que mantiene Drupal acerca del sitio. En las <a href="@statistics">estadísticas de sitio</a> tiene la información real.','es','0','0','0'),('3373','Esta página muestra las visitas más recientes a este sitio.','es','0','0','0'),('3374','Esta página muestra todos los referentes externos o las referencias externas a su sitio web.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3375','Cuando usted prohíbe a un visitante, evita que la dirección de IP del visitante tenga acceso a su sitio. A diferencia de bloquear a un usuario, prohibir a un visitante funciona incluso para los usuarios anónimos. Esto es más comúnmente usado para bloquear bots o web crawlers intensivos en recursos.','es','0','0','0'),('3376','Contenido popular','es','0','0','0'),('3377','Cuántos elementos de contenido se deben mostrar en la lista «siempre».','es','0','0','0'),('3378','Cuántos elementos de contenido se debe mostrar en la lista «impresiones recientes»,','es','0','0','0'),('3379','Hoy:','es','0','0','0'),('3380','Siempre:','es','0','0','0'),('3381','Últimas impresiones:','es','0','0','0'),('3382','Ver las páginas que se han visitado recientemente.','es','0','0','0'),('3383','Ver qué páginas que se visitan con frecuencia.','es','0','0','0'),('3384','Visitantes principales','es','0','0','0'),('3385','Ver los visitantes que visitan muchas páginas.','es','0','0','0'),('3386','Referentes principales','es','0','0','0'),('3387','Ver los principales sitios de referencia.','es','0','0','0'),('3388','Ve el registro de acceso.','es','0','0','0'),('3389','Sigue las visitas a páginas','es','0','0','0'),('3390','Guarda estadísticas de acceso al sitio.','es','0','0','0'),('3391','Anota y registra eventos del sistema en el syslog.','es','0','0','0'),('3392','Imágenes de los usuarios en los envíos','es','0','0','0'),('3393','Imágenes de los usuarios en los comentarios','es','0','0','0'),('3394','Icono de acceso rápido','es','0','0','0'),('3395','Opciones de la imagen del logo','es','0','0','0'),('3396','Si está activado, se muestra el logo siguiente.','es','0','0','0'),('3397','Usar el logo predefinido','es','0','0','0'),('3398','Márquelo si quiere que el tema use el logo que viene con él.','es','0','0','0'),('3399','La ruta al archivo que quiera usar como archivo de logo, en lugar del logo predefinido.','es','0','0','0'),('3400','Cargar la imagen del logo','es','0','0','0'),('3401','Opciones de iconos de acceso rápido','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3402','Su icono de acceso rápido, o "favicon", se muestra en la barra de direcciones y los marcadores de la mayoría de los navegadores.','es','0','0','0'),('3403','Usar el icono de acceso rápido predefinido.','es','0','0','0'),('3404','Márquelo si quiere que el tema use el icono de acceso rápido predefinido.','es','0','0','0'),('3405','La ruta al archivo de imagen que quiera utilizar como icono de acceso rápido personalizado.','es','0','0','0'),('3406','Subir imagen del icono','es','0','0','0'),('3407','Si no tiene acceso directo a los archivos del servidor, use este campo para cargar el icono de acceso rápido.','es','0','0','0'),('3408','@module (<span class="admin-missing">ausente</span>)','es','0','0','0'),('3409','Los siguientes módulos se desinstalarán completamente de su sitio, y <em>se perderán todos los datos de estos módulos</em>!','es','0','0','0'),('3410','Confirmar la desinstalación','es','0','0','0'),('3411','¿Quiere continuar con la desinstalación de lo de arriba?','es','0','0','0'),('3412','No seleccionó ningún módulo','es','0','0','0'),('3413','Los módulos seleccionados han sido desinstalados.','es','0','0','0'),('3414','Página 403 predefinida (acceso denegado)','es','0','0','0'),('3415','Página 404 predefinida (no encontrada)','es','0','0','0'),('3416','Cachés vaciadas.','es','0','0','0'),('3417','Seleccione un juego de herramientas para procesar imágenes','es','0','0','0'),('3418','Número de elementos de cada canal de noticias','es','0','0','0'),('3419','Número predeterminado de elementos para incluir en cada canal.','es','0','0','0'),('3420','Contenido sindicado','es','0','0','0'),('3421','Títulos y resúmenes','es','0','0','0'),('3422','Opción global para la presentación predefinida de los elementos de contenido en cada canal de noticias.','es','0','0','0'),('3423','La ejecución de cron tuvo éxito.','es','0','0','0'),('3424','La ejecución de Cron ha fallado.','es','0','0','0'),('3425','No hay módulos disponibles para desinstalar.','es','0','0','0'),('3426','Este tema gráfico requiere PHP versión @php_required y es incompatible con PHP versión !php_version.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3427','Esta página le muestra todas las tareas de administración disponibles para cada módulo.','es','0','0','0'),('3428','Estas opciones controlan las opciones predefinidas de visualización para todo el sitio y para todos los temas. A no ser que se alteren en un tema en concreto, son las opciones que se emplean.','es','0','0','0'),('3429','El bloque <em>Sitio elaborado con Drupal</em> es un enlace opcional a la página inicial del proyecto Drupal. Si bien no hay en absoluto un requerimiento de que los sitios presenten este enlace, puede usarse para evidenciar el apoyo a Drupal.','es','0','0','0'),('3430','Aquí puede encontrar un breve resumen de los parámetros de su sitio así como los problemas detectados en su instalación. Podría serle útil copiar y pegar esta información en las peticiones de soporte que haga a los foros de drupal.org o a las listas de reportes de los proyectos.','es','0','0','0'),('3431','Sitio elaborado con Drupal','es','0','0','0'),('3432','No se pudo borrar el archivo temporal "%path" durante la recolección de basura.','es','0','0','0'),('3433','Modo compacto','es','0','0','0'),('3434','Indicar a Drupal dónde se deben almacenar los archivos y cómo se accede a ellos.','es','0','0','0'),('3435','Juego de herramientas de imágenes','es','0','0','0'),('3436','Elegir qué juego de herramientas de imágenes quiere usar si ha instalado otros opcionales.','es','0','0','0'),('3437','Publicación RSS','es','0','0','0'),('3438','Fecha y hora','es','0','0','0'),('3439','Búsqueda de fecha y hora','es','0','0','0'),('3440','Activar o desactivar URL limpias en su sitio.','es','0','0','0'),('3441','Comprobación de URL limpia','es','0','0','0'),('3442','Recibir un informe del estado funcional de su sitio y de cualquier problema detectado.','es','0','0','0'),('3443','-1 (Ilimitado)','es','0','0','0'),('3444','Su instalación de PHP es demasiado antigua. Drupal necesita al menos PHP %version.','es','0','0','0'),('3445','Variable register globals de PHP','es','0','0','0'),('3446','<em>register_globals</em> está activado. Drupal requiere que esta directiva de configuración esté desactivada. Su sitio podría no ser seguro si <em>register_globals</em> está activado. El manual de PHP tiene instrucciones acerca de <a href="http://php.net/configuration.changes">cómo cambiar las opciones de configuración</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3447','(''@value'') habilitado','es','0','0','0'),('3448','Límite de memoria PHP','es','0','0','0'),('3449','Considere la posibilidad de incrementar el límite de su memoria PHP a %memory_minimum_limit  para prevenir errores en el proceso de instalación.','es','0','0','0'),('3450','Considere la opción de incrementar el límite de su memoria PHP en %memory_minimum_limit para prevenir errores en el proceso de actualización.','es','0','0','0'),('3451','Dependiendo de su configuración, Drupal puede ejecutarse con un límite de memoria de PHP %memory_limit. Sin embargo, se recomienda tener un límite de memoria de PHP de %memory_minimum_limit, especialmente si su sitio emplea módulos de terceros o módulos personalizados adicionales.','es','0','0','0'),('3452','Aumente el límite de memoria editando el parámetro memory_limit en el archivo %configuration-file y luego reinicialice su servidor web (o póngase en contacto con su administrador de sistemas o con su proveedor de hospedaje para que le brinden asistencia).','es','0','0','0'),('3453','Contacte con su administrador de sistemas o proveedor de alojamiento para que le ayude a incrementar su límite de memoria PHP.','es','0','0','0'),('3454','Para más información consulte <a href="@url">Los requisitos de Drupal</a>','es','0','0','0'),('3455','No protegido','es','0','0','0'),('3456','El archivo %file no está protegido contra modificaciones y supone un riesgo de seguridad. Debe cambiar los permisos del archivo para que no se pueda escribir en él.','es','0','0','0'),('3457','Para más información, vea la entrada del manual en línea sobre <a href="@cron-handbook">cómo configurar tareas cron</a>.','es','0','0','0'),('3458','Cron no se ha ejecutado recientemente.','es','0','0','0'),('3459','Tareas de mantenimiento de cron','es','0','0','0'),('3460','Puede <a href="@cron">ejecutar cron manualmente</a>.','es','0','0','0'),('3461','No es posible escribir en la carpeta %directory.','es','0','0','0'),('3462','Puede que tenga que definir el directorio correcto en la <a href="@admin-file-system">página de opciones del sistema de archivos</a> o cambiar los permisos del directorio actual, para que se pueda escribir en él.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3463','Se puede escribir (método <em>público</em> de descarga)','es','0','0','0'),('3464','Se puede escribir (método <em>privado</em> de descarga)','es','0','0','0'),('3465','Actualizaciones de la base de datos','es','0','0','0'),('3466','Algunos módulos tienen que instalar actualizaciones al esquema de la base de datos. Debe ejecutar inmediatamente el <a href="@update">guión de actualización de la base de datos</a>.','es','0','0','0'),('3467','El guión ("script") update.php es accesible para todos sin comprobar la autenticación, lo que es un riesgo de seguridad. Debe cambiar el valor de $update_free_access en su archivo settings.php para que sea otra vez FALSE.','es','0','0','0'),('3468','Acceso a update.php','es','0','0','0'),('3469','Gestión de la configuración general del sitio por administradores.','es','0','0','0'),('3470','Restablecer a alfabético','es','0','0','0'),('3471','Los términos se muestran en orden ascendente por su peso.','es','0','0','0'),('3472','El valor del peso debe ser numérico.','es','0','0','0'),('3473','¿Está seguro de que desea restablecer el vocabulario %title al orden alfabético?','es','0','0','0'),('3474','Restablecer un vocabulario descartará todo ordenamiento personalizado y ordenará sus elementos alfabéticamente.','es','0','0','0'),('3475','Restablecer el vocabulario %name al orden alfabético.','es','0','0','0'),('3476','Las traducciones de un fragmento de contenido son administradas con grupos de traducción. Cada grupo de traducción tiene una entrada fuente y un número variable de traducciones en cualquiera de los <a href="!languages">idiomas activados</a>. Todas las traducciones son rastreadas para indicar si están actualizadas u obsoletas, sobre la base de si la entrada fuente se modificó de manera importante.','es','0','0','0'),('3477','Opciones de traducción','es','0','0','0'),('3478','Marcar traducciones como caducadas','es','0','0','0'),('3479','Si realizó un cambio importante, que significa que deben actualizarse las traducciones, puede marcar todas las traducciones de esta entrada como caducadas. Esto no cambiará otras propiedades de estas entradas, estén publicadas o no.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3480','Esta traducción necesita ser actualizada','es','0','0','0'),('3481','Cuando esta opción está marcada, la traducción necesita actualizarse porque el mensaje fuente ha cambiado. Desmárquela cuando la traducción vuelva a estar actualizada.','es','0','0','0'),('3482','Traducción del contenido','es','0','0','0'),('3483','Permite que el contenido sea traducido a diferentes idiomas.','es','0','0','0'),('3484','Fecha de versión desconocida','es','0','0','0'),('3485','Última comprobación: hace @time','es','0','0','0'),('3486','Nunca se ha comprobado','es','0','0','0'),('3487','Incluye: %includes','es','0','0','0'),('3488','Módulos desactivados','es','0','0','0'),('3489','Temas desactivados','es','4700','1','0'),('3490','Seleccionar con qué frecuencia quiere comprobar automáticamente si hay nuevas versiones de los módulos y temas gráficos que tiene instalados.','es','0','0','0'),('3491','Umbral de correos electrónicos de aviso','es','0','0','0'),('3492','Puede elegir enviar un correo electrónico sólo si hay disponible una actualización de seguridad o que le avisen de todas las versiones nuevas. Si hay actualizaciones disponibles del núcleo de Drupal o de cualquiera de sus módulos y temas instalados, su sitio mostrará siempre un mensaje en la <a href="@status_report">página de informe de estado</a> y, si hubiera una actualización de seguridad, además mostrará un mensaje de error en las páginas de administración.','es','0','0','0'),('3493','Aquí puede encontrar información sobre actualizaciones disponibles para sus módulos y temas gráficos instalados. Tome en cuenta que cada módulo o tema gráfico es parte de un "proyecto", que puede tener o no el mismo nombre, y que podría incluir múltiples módulos o temas gráficos en su interior.','es','0','0','0'),('3494','Estado de actualización de módulos y temas gráficos','es','0','0','0'),('3495','Hay actualizaciones de seguridad disponibles para uno o más de sus módulos o temas gráficos. Para garantizar la seguridad de su servidor, ¡debería actualizarlos inmediatamente!','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3496','Hay actualizaciones disponibles para uno o más de sus módulos o temas gráficos. Para asegurar el funcionamiento apropiado de su sitio, debería actualizarlos tan pronto como sea posible.','es','0','0','0'),('3497','Obtener un informe de estado sobre las actualizaciones disponibles para los módulos y temas visuales instalados.','es','0','0','0'),('3498','Avisar al usuario cuando su cuenta se active.','es','0','0','0'),('3499','Avisar al usuario cuando su cuenta esté bloqueada.','es','0','0','0'),('3500','Directrices para imágenes de usuarios','es','0','0','0'),('3501','Este texto se muestra en el formulario de carga de imágenes, además de las directrices predefinidas. Es útil para ayudar o para orientar a los usuarios.','es','0','0','0'),('3502','El nombre de este rol. Ejemplos: «moderador», «grupo editorial», «arquitecto del sitio».','es','0','0','0'),('3503','Se ha cambiado el nombre del rol.','es','0','0','0'),('3504','Se ha eliminado el rol.','es','0','0','0'),('3505','Nueva contraseña por correo electrónico','es','0','0','0'),('3506','Lo siento, %name no se reconoce como nombre de usuario o dirección de correo electrónico.','es','0','0','0'),('3507','Se le han enviado más instrucciones a su dirección de correo-e.','es','0','0','0'),('3508','Se ha eliminado %name.','es','0','0','0'),('3509','Debe especificar un nombre de usuario.','es','0','0','0'),('3510','El nombre del usuario no puede comenzar con un espacio.','es','0','0','0'),('3511','El nombre del usuario no puede finalizar con un espacio.','es','0','0','0'),('3512','El nombre de usuario no puede contener múltiples espacios seguidos','es','0','0','0'),('3513','El nombre de usuario contiene un carácter no permitido.','es','0','0','0'),('3514','El nombre de usuario %name es demasiado largo: debe tener %max caracteres o menos.','es','0','0','0'),('3515','Debe proporcionar una dirección de correo electrónico.','es','0','0','0'),('3516','Quién está conectado','es','0','0','0'),('3517','Tamaño de la lista de usuarios','es','0','0','0'),('3518','Escriba la contraseña asignada a su nombre de usuario.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3519','Opciones de la firma','es','0','0','0'),('3520','Eliminar imagen','es','0','0','0'),('3521','Marque esta casilla para borrar su imagen actual.','es','0','0','0'),('3522','Desbloquear a los usuarios seleccionados','es','0','0','0'),('3523','Bloquear a los usuarios seleccionados','es','0','0','0'),('3524','Esta página web permite que los administradores registren nuevos usuarios. Sus correos electrónicos y nombres de usuario deben ser únicos.','es','0','0','0'),('3525','Escriba un patrón sencillo (puede usar "*" como comodín) para buscar un nombre de usuario o una dirección de correo electrónico. Por ejemplo, podría buscar "br" y Drupal podría devolver "brian", "brad" y "brenda@example.com".','es','0','0','0'),('3526','Usuario eliminado: %name %email.','es','0','0','0'),('3527','Determina el acceso a las características mediante selección de permisos para roles.','es','0','0','0'),('3528','Editar rol','es','0','0','0'),('3529','Administra el registro de usuarios y el sistema de inicio de sesión.','es','0','0','0'),('3530','Garland','es','0','0','0'),('3531','Realizar la prueba de URL limpias','es','0','0','0'),('3532','El título se usa como etiqueta emergente de ayuda cuando el usuario pasa el cursor por encima de la imagen.','es','0','0','0'),('3533','Indicador de progreso','es','0','0','0'),('3534','Barra con medidor de progreso','es','0','0','0'),('3535','Pulsador','es','0','0','0'),('3536','La subida del archivo falló. %upload','es','0','0','0'),('3537','URL al archivo','es','0','0','0'),('3538','Ha ocurrido un error irrecuperable. El archivo subido probablemente excede el tamaño de archivo máximo (@size) que admite este servidor.','es','0','0','0'),('3539','Comenzando subida...','es','0','0','0'),('3540','Subiendo... (@current de @total)','es','0','0','0'),('3541','Su servidor es capaz de mostrar progreso de subida de archivo, pero no tiene las bibliotecas necesarias. Se recomienda instalar la <a href="http://pecl.php.net/package/uploadprogress">biblioteca uploadprogress de PECL</a> (preferida) o instalar <a href="http://us2.php.net/apc">APC</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3542','Su servidor es capaz de mostrar progreso de subida de archivo usando APC RFC1867. Tenga en cuenta que solo se admite una subida a la vez. Se recomienda  usar la <a href="http://pecl.php.net/package/uploadprogress">biblioteca uploadprogress de PECL</a> de ser posible.','es','0','0','0'),('3543','Su servidor no es capaz de mostrar progreso de subida de archivo. El progreso de subida de archivo requiere que PHP sea ejecutado con mod_php y no como FastCGI.','es','0','0','0'),('3544','Su servidor es capaz de mostrar progreso de subida de archivo mediante APC, pero el mismo no se encuentra habilitado. Añada <code>apc.rfc1867 = 1</code> a su configuración de php.ini. Alternativamente, es recomendado utilizar <a href="http://pecl.php.net/package/uploadprogress">uploadprogress de PECL</a>, la cual soporta más de una subida simultánea.','es','0','0','0'),('3545','Habilitado (<a href="http://php.net/manual/en/apc.configuration.php#ini.apc.rfc1867">APC RFC1867</a>)','es','0','0','0'),('3546','Habilitado (<a href="http://pecl.php.net/package/uploadprogress">uploadprogress de PECL</a>)','es','0','0','0'),('3547','Progreso de subida','es','0','0','0'),('3548','Interfaz','es','0','0','0'),('3549','@size KB','es','0','0','0'),('3550','@size MB','es','0','0','0'),('3551','@size GB','es','0','0','0'),('3552','@size TB','es','0','0','0'),('3553','@size PB','es','0','0','0'),('3554','@size EB','es','0','0','0'),('3555','@size ZB','es','0','0','0'),('3556','@size YB','es','0','0','0'),('3557','Todos los mensajes','es','0','0','0'),('3558','(vacío)','es','0','0','0'),('3559','Formato de texto','es','0','0','0'),('3560','No hay entradas nuevas','es','0','0','0'),('3561','Discusión fija en cabeza de las listas','es','0','0','0'),('3562','Ruta URL','es','0','0','0'),('3563','El archivo de traducción %filename contiene un error: "msgctxt" inesperado en la línea %line.','es','0','0','0'),('3564','Opciones de región','es','0','0','0'),('3565','Formato de texto','es','0','0','0'),('3566','¿Está seguro de que quiere eliminar el formato %format?','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3567','Se ha eliminado el formato de fecha %format.','es','0','0','0'),('3568','Añadir formato','es','0','0','0'),('3569','Permitir a los usuarios añadir formatos de fecha adicionales.','es','0','0','0'),('3570','Borrar formato de fecha','es','0','0','0'),('3571','Permitir a los usuarios borrar un formato de fecha configurado.','es','0','0','0'),('3572','Configurar formatos de fecha para cada región','es','0','0','0'),('3573','Nombre de tipo de contenido','es','0','0','0'),('3574','Pizarra','es','0','0','0'),('3575','gestionar campos','es','0','0','0'),('3576','@field_name (Bloqueado)','es','0','0','0'),('3577','- Seleccione un tipo de campo -','es','0','0','0'),('3578','- Seleccione un control -','es','0','0','0'),('3579','Nombre del campo (a-z, 0-9, _)','es','0','0','0'),('3580','Tipo de datos a almacenar.','es','0','0','0'),('3581','Elemento de formulario para editar los datos.','es','0','0','0'),('3582','- Seleccione un campo existente -','es','0','0','0'),('3583','Campo a compartir','es','0','0','0'),('3584','Añadir un nuevo campo: debe indicar una etiqueta.','es','0','0','0'),('3585','Añadir campo nuevo: debe dar un nombre al campo.','es','0','0','0'),('3586','Añadir nuevo campo: El nombre de campo %field_name no es válido. El nombre sólo puede incluir letras minúsculas (sin signos diacríticos), números y guiones bajos.','es','0','0','0'),('3587','Anadir nuevo campo: El nombre del campo %field_name es demasiado largo. El límite es de 32 caracteres, incluido el prefijo ''field-''.','es','0','0','0'),('3588','Añadir nuevo campo: El nombre de campo %field_name ya existe.','es','0','0','0'),('3589','Añadir nuevo campo: Tiene que seleccionar un tipo de campo.','es','0','0','0'),('3590','Añadir nuevo campo: Tiene que seleccionar un control.','es','0','0','0'),('3591','Añadir nuevo campo: Control no válido.','es','0','0','0'),('3592','Añadir nuevo campo: Tiene que especificar una etiqueta.','es','0','0','0'),('3593','Añadir nuevo campo: Tiene que seleccionar un campo.','es','0','0','0'),('3594','Añadir nuevo campo: Tiene que seleccionar un control.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3595','Añadir campo existente: Control no válido.','es','0','0','0'),('3596','@type: @field (@label)','es','0','0','0'),('3597','El campo %field esta bloqueado y no se puede editar.','es','0','0','0'),('3598','El número máximo de valores que los usuarios pueden entrar en este campo.','es','0','0','0'),('3599','''Sin límite'' proporcionará un botón ''Añadir más'' con el que los usuarios podrán añadir tantos valores como deseen.','es','0','0','0'),('3600','%name debe ser un entero.','es','0','0','0'),('3601','%name debe ser un entero positivo.','es','0','0','0'),('3602','%name debe ser un número.','es','0','0','0'),('3603','Solo se permiten números en %field.','es','0','0','0'),('3604','Opciones regionales','es','0','0','0'),('3605','update.php','es','0','0','0'),('3606','Girar','es','0','0','0'),('3607','Parte superior de la página','es','0','0','0'),('3608','Zona inferior de la página','es','0','0','0'),('3609','Bienvenido, <strong>@username</strong>','es','0','0','0'),('3610','ancho @width','es','0','0','0'),('3611','alto @height','es','0','0','0'),('3612','se permiten ampliaciones','es','0','0','0'),('3613','Aleatorio entre -@degrees&deg y @degrees&deg','es','0','0','0'),('3614','@degrees&deg','es','0','0','0'),('3615','Primera barra lateral','es','0','0','0'),('3616','La base de datos está codificada en UTF-8','es','0','0','0'),('3617','Drupal no pudo determinar si la codificación de la base de datos está establecida como UTF-8','es','0','0','0'),('3618','PostgreSQL se ha inicializado.','es','0','0','0'),('3619','Estructura','es','0','0','0'),('3620','Creado el rol llamado: @name, de id: @rid','es','0','0','0'),('3621','El usuario %name ha iniciado sesión sin problemas.','es','0','0','0'),('3622','Se ha encontrado "@text"','es','0','0','0'),('3623','"@text" no encontrado','es','0','0','0'),('3624','Patrón "@pattern" encontrado','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3625','Patrón "@pattern" no encontrado','es','0','0','0'),('3626','La casilla del campo @id está seleccionada.','es','0','0','0'),('3627','La casilla del campo @id no está seleccionada.','es','0','0','0'),('3628','Mensaje explícito','es','0','0','0'),('3629','Seleccione la prueba o pruebas que desea efectuar y pulse <em>ejecutar pruebas</em>.','es','0','0','0'),('3630','Total (@count)','es','0','0','0'),('3631','Pase (@count)','es','0','0','0'),('3632','Fallo (@count)','es','0','0','0'),('3633','Volver al listado','es','0','0','0'),('3634','Vaciar los resultados después de cada ejecución completa del conjunto de pruebas','es','0','0','0'),('3635','Proporcionar información detallada al ejecutar pruebas','es','0','0','0'),('3636','Los datos detallados se mostrarán además de las afirmaciones estándar, lo que sirve para la depuración. La información detallada se eliminará entre cada ejecución de un conjunto de pruebas. La salida explícita de datos es bastante detallada y sólo se debería usar en depuraciones.','es','0','0','0'),('3637','@pass, @fail, @exception, y @debug','es','0','0','0'),('3638','La ejecución de prueba no se terminó adecuadamente.','es','0','0','0'),('3639','La limpieza de resultados está desactivada por lo que los resultados de la prueba no se eliminarán.','es','0','0','0'),('3640','No hay tablas sobrantes que eliminar.','es','0','0','0'),('3641','1 mensaje de depuración','es','0','0','0'),('3642','@count mensajes de depuración','es','3641','1','0'),('3643','Se ha eliminado 1 resultado de prueba.','es','0','0','0'),('3644','Se han eliminado @count resultados de pruebas.','es','3643','1','0'),('3645','Eliminada 1 tabla sobrante.','es','0','0','0'),('3646','Eliminada @count tablas sobrantes.','es','3645','1','0'),('3647','Eliminado 1 directorio temporal.','es','0','0','0'),('3648','Eliminados @count directorios temporales.','es','3647','1','0'),('3649','Resultado de la prueba','es','0','0','0'),('3650','Ver resultados de las pruebas.','es','0','0','0'),('3651','hash','es','0','0','0'),('3652','Enlace permanente del comentario','es','0','0','0');
