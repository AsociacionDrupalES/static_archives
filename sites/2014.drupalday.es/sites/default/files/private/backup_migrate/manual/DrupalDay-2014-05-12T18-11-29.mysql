INSERT INTO `locales_source` VALUES ('8450','/index.php','default','Add tags to the archive manifest. Delimit multiple by commas.','','7.12'),('8451','/index.php','default','The full path and filename in which the archive should be stored. If omitted, it will be saved to the drush-backups directory and a filename will be generated.','','7.12'),('8452','/index.php','default','Do not fail if the destination file exists; overwrite it instead.','','7.12'),('8453','/index.php','default','The generator name to store in the MANIFEST file. The default is "Drush archive-dump".','','7.12'),('8454','/index.php','default','The generator version number to store in the MANIFEST file. The default is 4.5.','','7.10'),('8455','/index.php','default','Only print the destination of the archive. Useful for scripts that don''t pass --destination.','','7.12'),('8456','/index.php','default','Write an archive containing 3 sites in it.','','7.12'),('8457','/index.php','default','Save archive containing all sites in a multi-site.','','7.12'),('8458','/index.php','default','Save archive to custom location.','','7.12'),('8459','/index.php','default','Examples','','7.12'),('8460','/index.php','default','Expand a site archive into a Drupal web site.','','7.12'),('8461','/index.php','default','The site archive file that should be expanded.','','7.12'),('8462','/index.php','default','Optional. Which site within the archive you want to restore. Defaults to all.','','7.12'),('8463','/index.php','default','Specify where the Drupal site should be expanded. Defaults to the current working directory.','','7.10'),('8464','/index.php','default','An optional table prefix to use during restore.','','7.12'),('8465','/index.php','default','A Drupal 6 style database URL indicating the target for database restore. If not provided, the archived settings.php is used.','','7.12'),('8466','/index.php','default','Account to use when creating the new database. Optional.','','7.12'),('8467','/index.php','default','Password for the "db-su" account. Optional.','','7.12'),('8468','/index.php','default','Allow drush to overwrite any files in the destinion.','','7.10');
INSERT INTO `locales_source` VALUES ('8469','/index.php','default','Restore the files and databases for all sites in the archive.','','7.12'),('8470','/index.php','default','Restore the files and database for example.com site.','','7.12'),('8471','/index.php','default','Restore archive to a custom location.','','7.12'),('8472','/index.php','default','Restore archive to a new database (and customize settings.php to point there.).','','7.12'),('8473','/index.php','default','Fetch a cached object and display it.','','7.12'),('8474','/index.php','default','The id of the object to fetch.','','7.12'),('8475','/index.php','default','Optional. The cache bin to fetch from.','','7.12'),('8476','/index.php','default','Format to output the object. Use "print_r" for print_r (default), "export" for var_export, and "json" for JSON.','','7.12'),('8477','/index.php','default','Display the data for the cache id "schema" from the "cache" bin.','','7.12'),('8478','/index.php','default','Display the data for the cache id "update_available_releases" from the "update" bin.','','7.12'),('8479','/index.php','default','Clear a specific cache, or all drupal caches.','','7.12'),('8480','/index.php','default','The particular cache to clear. Omit this argument to choose from available caches.','','7.12'),('8481','/index.php','default','Cache an object expressed in JSON or var_export() format.','','7.12'),('8482','/index.php','default','The id of the object to set.','','7.12'),('8483','/index.php','default','The object to set in the cache. Use ''-'' to read the object from STDIN.','','7.12'),('8484','/index.php','default','Optional. The cache bin to store the object in.','','7.12'),('8485','/index.php','default','Optional. CACHE_PERMANENT, CACHE_TEMPORARY, or a Unix timestamp.','','7.12'),('8486','/index.php','default','Format to parse the object. Use "string" for string (default), and "json" for JSON.','','7.12'),('8487','/index.php','default','If the object is the result a previous fetch from the cache, only store the value in the "data" property of the object in the cache.','','7.12');
INSERT INTO `locales_source` VALUES ('8488','/index.php','default','Print this help message. See `drush help help` for more options.','','7.12'),('8489','/index.php','default','Sort commands in alphabetical order. drush waits for full bootstrap before printing any commands when this option is used.','','7.12'),('8490','/index.php','default','Restrict command list to those commands defined in the specified file.','','7.10'),('8491','/index.php','default','Print help for all commands in HTML format.','','7.12'),('8492','/index.php','default','A list of available commands, one per line.','','7.12'),('8493','/index.php','default','List all commands.','','7.12'),('8494','/index.php','default','Show only commands defined in devel_generate.drush.inc','','7.12'),('8495','/index.php','default','Show help for one command.','','7.12'),('8496','/index.php','default','Show help for one command using an alias.','','7.12'),('8497','/index.php','default','Show drush version.','','7.12'),('8498','/index.php','default','Print just the version number, and nothing else.','','7.12'),('8499','/index.php','default','Check for pending updates to drush itself. Set to 0 to avoid check.','','7.12'),('8500','/index.php','default','Update drush to the latest version, if available.','','7.10'),('8501','/index.php','default','Allow updates to latest dev release.','','7.10'),('8502','/index.php','default','Run all cron hooks in all active modules for specified site.','','7.12'),('8503','/index.php','default','Apply any database updates required (as with running update.php).','','7.12'),('8504','/index.php','default','Provides a birds-eye view of the current Drupal installation, if any.','','7.12'),('8505','/index.php','default','Optional.  The status item line(s) to display.','','7.12'),('8506','/index.php','default','Show database password.','','7.12'),('8507','/index.php','default','Show all status lines that contain version information.','','7.12'),('8508','/index.php','default','A list key=value items separated by line breaks.','','7.12'),('8509','/index.php','default','Emit just the drush version with no label.','','7.12');
INSERT INTO `locales_source` VALUES ('8510','/index.php','default','Evaluate arbitrary php code after bootstrapping Drupal (if available).','','7.12'),('8511','','default','PHP code','','7.12'),('8512','/index.php','default','Sets the hello variable using Drupal API.','','7.12'),('8513','/index.php','default','Run php script(s).','','7.12'),('8514','/index.php','default','Optional. The file you wish to execute (without extension). If omitted, list files ending in .php in the current working directory and specified script-path. Some might not be real drush scripts. Beware.','','7.12'),('8515','/index.php','default','Additional paths to search for scripts, separated by : (Unix-based systems) or ; (Windows).','','7.12'),('8516','/index.php','default','Run scratch.php script. See commands/core directory.','','7.12'),('8517','/index.php','default','Run script from specified paths','','7.12'),('8518','/index.php','default','List all available scripts.','','7.12'),('8519','/index.php','default','Execute php code with a full Drupal bootstrap directly from a shell script.','','7.12'),('8520','/index.php','default','Show how many items remain to be indexed out of the total.','','7.12'),('8521','/index.php','default','Display in the format remaining/total for processing by scripts.','','7.12'),('8522','/index.php','default','Index the remaining search items without wiping the index.','','7.12'),('8523','/index.php','default','Force the search index to be rebuilt.','','7.12'),('8524','/index.php','default','Rebuild the index immediately, instead of waiting for cron.','','7.12'),('8525','/index.php','default','Rsync the Drupal tree to/from another server using ssh.','','7.12'),('8526','/index.php','default','May be rsync path or site alias. See rsync documentation and example.aliases.drushrc.php.','','7.12'),('8527','/index.php','default','The unary flags to pass to rsync; --mode=rultz implies rsync -rultz.  Default is -az.','','7.10'),('8528','/index.php','default','Most rsync flags passed to drush sync will be passed on to rsync.  See rsync documentation.','','7.12');
INSERT INTO `locales_source` VALUES ('8529','/index.php','default','Excludes settings.php from being rsynced.  Default.','','7.12'),('8530','/index.php','default','Allow settings.php to be rsynced. Default is to exclude settings.php.','','7.12'),('8531','/index.php','default','Include special version control directories (e.g. .svn).  Default is to exclude vcs files.','','7.12'),('8532','/index.php','default','Exclude the files directory.','','7.12'),('8533','/index.php','default','Exclude all directories in "sites/" except for "sites/all".','','7.12'),('8534','/index.php','default','Exclude all directories in "sites/" except for "sites/all" and the site directory for the site being synced.  Note: if the site directory is different between the source and destination, use --exclude-sites followed by "drush rsync @from:%site @to:%site"','','7.12'),('8535','/index.php','default','List of paths to exclude, seperated by : (Unix-based systems) or ; (Windows).','','7.12'),('8536','/index.php','default','List of paths to include, seperated by : (Unix-based systems) or ; (Windows).','','7.12'),('8537','/index.php','default','Rsync Drupal root from dev to stage (one of which must be local).','','7.12'),('8538','/index.php','default','Rsync all files in the current directory to the ''img'' directory in the file storage folder on stage.','','7.12'),('8539','/index.php','default','Install Drupal along with modules/themes/configuration using the specified install profile.','','7.12'),('8540','/index.php','default','the install profile you wish to run. defaults to ''default'' in D6, ''standard'' in D7','','7.10'),('8541','/index.php','default','any additional settings you wish to pass to the profile. Only support on D7. The key is in the form [form name].[parameter name].','','7.10'),('8542','/index.php','default','uid1 name. defaults to admin','','7.10'),('8543','/index.php','default','uid1 pass. defaults to admin','','7.10'),('8544','/index.php','default','uid1 email. defaults to admin@example.com','','7.10'),('8545','/index.php','default','A Drupal 5/6 style database URL. Only required for initial install - not re-install.','','7.10');
INSERT INTO `locales_source` VALUES ('8546','/index.php','default','An optional table prefix to use for initial install.  Can be a key-value array of tables/prefixes in a drushrc file (not the command line).','','7.12'),('8547','/index.php','default','Account to use when creating a new database. Optional.','','7.12'),('8548','/index.php','default','A short language code. Sets the default site language. Language files must already be present. You may use download command to get them.','','7.12'),('8549','/index.php','default','Defaults to 1','','7.12'),('8550','/index.php','default','Defaults to Site-Install','','7.12'),('8551','/index.php','default','From: for system mailings. Defaults to admin@example.com','','7.12'),('8552','/index.php','default','Name of directory under ''sites'' which should be created. Only needed when the subdirectory does not already exist. Defaults to ''default''','','7.12'),('8553','/index.php','default','(Re)install using the expert install profile. Set default language to Ukranian.','','7.12'),('8554','/index.php','default','Install using the specified DB params.','','7.12'),('8555','/index.php','default','Install using SQLite (D7 only).','','7.10'),('8556','/index.php','default','Re-install with specified uid1 credentials.','','7.12'),('8557','/index.php','default','Pass additional arguments to the profile (D7 only).','','7.10'),('8558','/index.php','default','Return path to a given module/theme directory.','','7.12'),('8559','/index.php','default','A module/theme name, or special names like root, files, private, or an alias : path alias string such as @alias:%files. Defaults to root.','','7.12'),('8560','/index.php','default','The portion of the evaluated path to return.  Defaults to ''path''; ''name'' returns the site alias of the target.','','7.12'),('8561','/index.php','default','Reject any target that specifies a remote site.','','7.12'),('8562','/index.php','default','Navigate into the devel module directory','','7.12'),('8563','/index.php','default','Navigate to the root of your Drupal site','','7.12'),('8564','/index.php','default','Navigate to the files directory.','','7.12');
INSERT INTO `locales_source` VALUES ('8565','/index.php','default','Print the path to the files directory on the site @alias.','','7.12'),('8566','/index.php','default','Open devel module in your editor (customize ''edit'' for your editor)','','7.12'),('8567','/index.php','default','Enter a new shell optimized for drush use.','','7.10'),('8568','/index.php','default','List of drush commands or aliases that should override built-in shell functions and commands; otherwise, built-ins override drush commands. Defaults to dd,help,sa.','','7.10'),('8569','/index.php','default','Additional drush overrides that function ONLY when the prompt is "@alias>".  Defaults to cc,cron,rsync,status,sync,updatedb.','','7.10'),('8570','/index.php','default','Drush commands or aliases that should not be usable from core-cli. Takes precedence over override and contextual options. Defaults to core-cli,cli.','','7.10'),('8571','/index.php','default','Print the generated .bashrc file and exit.','','7.10'),('8572','/index.php','default','Print available drush commands','','7.10'),('8573','/index.php','default','Navigate to the root of the site indicated by @alias; subsequent commands will target that site.','','7.10'),('8574','/index.php','default','Navigate back to your $HOME directory.','','7.10'),('8575','/index.php','default','List all files in the Drupal files directory.','','7.10'),('8576','/index.php','default','Run the command "core-status" on the site indicated by @alias','','7.10'),('8577','/index.php','default','An even shorter form that also runs "core-status" on the site @alias','','7.10'),('8578','/index.php','default','Run subsequent commands on the site indicated by @alias','','7.10'),('8579','/index.php','default','Switch back to the last alias "used".','','7.10'),('8580','/index.php','default','Use the default alias.','','7.10'),('8581','/index.php','default','Revert to an ordinary prompt; do not use an alias.','','7.10'),('8582','/index.php','default','Convert your default 