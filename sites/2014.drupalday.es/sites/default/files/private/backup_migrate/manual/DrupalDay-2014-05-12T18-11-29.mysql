INSERT INTO `locales_source` VALUES ('7538','/index.php','default','The user authoring the content. If you need more fields than the uid add the content: author relationship','','7.12'),('7539','','default','User who uploaded','','7.12'),('7540','','default','The user that uploaded the file.','','7.12'),('7541','','default','The taxonomy vocabulary description','','7.12'),('7542','','default','The tid of a taxonomy term.','','7.12'),('7543','/index.php','default','Taxonomy term chosen from autocomplete or select widget.','','7.12'),('7544','','default','Representative node','','7.12'),('7545','','default','Obtains a single representative node for each term, according to a chosen sort criterion.','','7.12'),('7546','','default','The taxonomy term name.','','7.12'),('7547','','default','Content with term','','7.12'),('7548','','default','Relate all content tagged with a term.','','7.12'),('7549','','default','Has taxonomy term ID','','7.12'),('7550','','default','Display content if it has the selected taxonomy terms.','','7.12'),('7551','','default','Has taxonomy term','','7.12'),('7552','/index.php','default','Obtains a single representative node for each user, according to a chosen sort criterion.','','7.12'),('7553','/index.php','default','The user permissions.','','7.12'),('7554','','default','Comments of the node','','7.12'),('7555','/index.php','default','Relate all comments on the node. This will create 1 duplicate record for every comment. Usually if you need this it is better to create a comment view.','','7.12'),('7556','/index.php','default','Relate each @entity with a @field set to the term.','','7.12'),('7557','/index.php','default','Relate each @entity with a @field set to the image.','','7.12'),('7558','/index.php','default','Taxonomy terms on node','','7.12'),('7559','','default','All taxonomy terms','','7.12'),('7560','/index.php','default','Display content if it has the selected taxonomy terms, or children of the selected terms. Due to additional complexity, this has fewer options than the versions without depth.','','7.12'),('7561','/index.php','default','Has taxonomy term ID (with depth)','','7.12');
INSERT INTO `locales_source` VALUES ('7562','/index.php','default','Has taxonomy terms (with depth)','','7.12'),('7563','/index.php','default','Has taxonomy term ID depth modifier','','7.12'),('7564','/index.php','default','Nombre','','7.12'),('7565','/index.php','default','Vista previa','','7.12'),('7566','/index.php','default','Todo(s)','','7.12'),('7567','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Save style popup','','7.12'),('7568','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Load style popup','','7.12'),('7569','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Publish style popup','','7.12'),('7570','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Delete style popup','','7.12'),('7571','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Close popup','','7.12'),('7572','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','This theme is currently selected','','7.12'),('7573','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Switch to @theme','','7.12'),('7574','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','Apply theme settings','','7.12'),('7575','/dday/?q=es/admin/config/user-interface/sweaver/plugins','default','<p>No styles found.</p>','','7.12'),('7576','sites/all/modules/sweaver/plugins/sweaver_plugin_customcss/sweaver_plugin_customcss.js','default','Your custom css has been succesfully applied.','','none'),('7577','','default','@font-your-face settings','','7.12'),('7578','/dday/?q=admin/config','default','Manage settings for how font providers work. (Apply site fonts <a href="/dday/?q=admin/appearance/fontyourface">under themes</a>.)','','7.10'),('7579','/dday/?q=admin/config/user-interface/sweaver','default','Keyboard','','7.12'),('7580','/dday/?q=admin/config/user-interface/sweaver/editor','default','Spacing','','7.10'),('7581','/dday/?q=admin/config/user-interface/sweaver/styles','default','Show delete tab','','7.10'),('7582','/dday/?q=admin/config/user-interface/sweaver/styles','default','Show the delete tab in the frontend editor.','','7.10');
INSERT INTO `locales_source` VALUES ('7583','/dday/?q=admin/config/user-interface/sweaver/styles','default','Autosave','','7.12'),('7584','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every 5 seconds','','7.10'),('7585','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every 10 seconds','','7.10'),('7586','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every 15 seconds','','7.10'),('7587','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every 30 seconds','','7.10'),('7588','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every 45 seconds','','7.10'),('7589','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every minute','','7.10'),('7590','/dday/?q=admin/config/user-interface/sweaver/styles','default','Every two minutes','','7.10'),('7591','/dday/?q=admin/config/user-interface/sweaver/styles','default','Check for changes on your style and custom CSS every x seconds. If a change has been identified, sweaver will save those settings in a temporary cache table with AJAX. So leaving a page - or even worse, a browser crash - will make sure you keep your current configuration.','','7.10'),('7592','/dday/?q=admin/config/user-interface/sweaver/styles','default','No styles found.','','7.10'),('7593','/dday/?q=admin/config/user-interface/sweaver/images','default','Editor tab','','7.10'),('7594','/dday/?q=admin/config/user-interface/sweaver/images','default','Toggle this checkbox if you want to enable the images tab on the editor.','','7.10'),('7595','/dday/?q=admin/config/user-interface/sweaver/images','default','Allow to see styled version of images','','7.10'),('7596','/dday/?q=admin/config/user-interface/sweaver/images','default','Toggle this checkbox if you want to create styled versions of the images uploaded by the Image plugin.','','7.10'),('7597','/dday/?q=admin/config/user-interface/sweaver/images','default','Add new image','','7.10'),('7598','/dday/?q=admin/config/user-interface/sweaver/images','default','No images uploaded.','','7.10'),('7599','/dday/?q=admin/config/user-interface/sweaver/themeclasses','default','Theme groups','','7.10');
INSERT INTO `locales_source` VALUES ('7600','/dday/?q=admin/config/user-interface/sweaver/themeclasses','default','Enter a group which is available in your theme(s) info file. This plugin will try to fetch all classes from it and make them available in a separate tab. Enter one group per line. This is inspired by the skinr way of theming, so we need to find a key called ''class'' to get a list of styles. If you have added new classes and the editor does not pick them up yet, click on submit button to reset the cache.','','7.10'),('7601','/dday/?q=admin/config/user-interface/sweaver/kb','default','Select keys for every event possible. Note, there is no validation when saving this form, so make sure every event has a unique key.','','7.10'),('7602','/dday/?q=admin/config/system/globalredirect','default','Deslash','','7.10'),('7603','/dday/?q=admin/config/system/globalredirect','default','If enabled, this option will remove the trailing slash from requests. This stops requests such as <code>example.com/node/1/</code> failing to match the corresponding alias and can cause duplicate content. On the other hand, if you require certain requests to have a trailing slash, this feature can cause problems so may need to be disabled.','','7.10'),('7604','/dday/?q=admin/config/system/globalredirect','default','Non-clean to Clean','','7.10'),('7605','/dday/?q=admin/config/system/globalredirect','default','If enabled, this option will redirect from non-clean to clean URL (if Clean URL''s are enabled). This will stop, for example, node 1  existing on both <code>example.com/node/1</code> AND <code>example.com?q=node/1</code>.','','7.10'),('7606','/dday/?q=admin/config/system/globalredirect','default','Remove Trailing Zero Argument','','7.10'),('7607','/dday/?q=admin/config/system/globalredirect','default','If enabled, any instance of "/0" will be trimmed from the right of the URL. This stops duplicate pages such as "taxonomy/term/1" and "taxonomy/term/1/0" where 0 is the default depth. There is an option of limiting this feature to taxonomy term pages ONLY or allowing it to effect any page. <strong>By default this feature is disabled to avoid any unexpected behavior. Also of note, the trailing /0 "depth modifier" was removed from Drupal 7.</strong>','','7.10');
INSERT INTO `locales_source` VALUES ('7608','/dday/?q=admin/config/system/globalredirect','default','Enabled for taxonomy term pages only','','7.10'),('7609','/dday/?q=admin/config/system/globalredirect','default','If enabled, the module will check the user has access to the page before redirecting. This helps to stop redirection on protected pages and avoids giving away <em>secret</em> URL''s. <strong>By default this feature is disabled to avoid any unexpected behavior</strong>','','7.10'),('7610','/dday/?q=admin/config/system/globalredirect','default','Case Sensitive URL Checking','','7.10'),('7611','/dday/?q=admin/config/system/globalredirect','default','If enabled, the module will compare the current URL to the alias stored in the system. If there are any differences in case then the user will be redirected to the correct URL.','','7.10'),('7612','/dday/?q=admin/config/system/globalredirect','default','If enabled, the module will check that the page being viewed matches the language in the URL or the system default. For example, viewing a French node while the site is in English will cause a redirect to the English node.','','7.10'),('7613','/dday/?q=admin/config/system/globalredirect','default','If enabled, will add a <a href="!canonical">canonical link</a> to each page.','','7.10'),('7614','/dday/?q=admin/config/system/globalredirect','default','If enabled, will add a <a href="!canonical">Content-Location</a> header.','','7.10'),('7615','/dday/?q=admin/config/system/globalredirect','default','Taxonomy Term Path Handler','','7.10'),('7616','/dday/?q=admin/config/system/globalredirect','default','Frontpage Redirect Handler','','7.10'),('7617','/dday/?q=admin/config/system/globalredirect','default','If enabled, any request to the frontpage path will redirect to the site root.<br />\n                         Whatever you set as the path of the front page on the !link settings page will redirect to the site root (e.g. "node" or "node/1" and also its alias (e.g. in case you have set "node/1" as your home page but that page also has an alias "home")).','','7.10');
