INSERT INTO `locales_source` VALUES ('11900','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=admin/commerce/config/order/fields%3Frender%3Doverlay&render=overlay','default','If set to ''0'', all date values on every entity will be cached. Note that caching every date on fields that may have a large number of multiple or repeating values may create a significant performance penalty when the cache is cleared. The suggested setting for multiple value and repeating fields is no more than 4 values per field.','','7.12'),('11901','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=admin/commerce/config/order/fields%3Frender%3Doverlay&render=overlay','default','Date part','','7.12'),('11902','/checkout/20','default','NIF/CIF/NIE number is not correct','','7.12'),('11903','/checkout/20','default','Errors on form','','7.12'),('11904','/checkout/20','default','There are errors on the page. Please correct them and resubmit the form.','','7.12'),('11905','/index.php','default','Order Fieldgroup: @group_label','','7.12'),('11906','/admin/modules','default','Commerce (contrib)','','7.12'),('11907','','default','There are no !items to display.','','7.12'),('11908','/admin/reports/dblog','default','Successfully sent email to %recipient','','7.12'),('11909','/admin/reports/dblog','default','Unable to evaluate %name.','','7.12'),('11910','/admin/commerce/customer-profiles/16/delete?destination=admin/commerce/customer-profiles','default','@entity_label: @count','','7.12'),('11911','/admin/commerce/customer-profiles/16/delete?destination=admin/commerce/customer-profiles','default','This customer profile is referenced by the following entities: !entity_list','','7.12'),('11912','/checkout/25','default','NIF/CIF/NIE number needs to be 9 characters long','','7.12'),('11913','/admin/reports/dblog','default','The @plugin %label (%name) fails the integrity check and cannot be executed. Error: !message','','7.12'),('11914','/admin/reports/dblog','default'