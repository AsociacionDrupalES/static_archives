DROP TABLE IF EXISTS `filter`;
CREATE TABLE `filter` (   `format` varchar(255) NOT NULL COMMENT 'Foreign key: The filter_format.format to which this filter is assigned.',   `module` varchar(64) NOT NULL DEFAULT '' COMMENT 'The origin module of the filter.',   `name` varchar(32) NOT NULL DEFAULT '' COMMENT 'Name of the filter being referenced.',   `weight` int(11) NOT NULL DEFAULT '0' COMMENT 'Weight of filter within format.',   `status` int(11) NOT NULL DEFAULT '0' COMMENT 'Filter enabled status. (1 = enabled, 0 = disabled)',   `settings` longblob COMMENT 'A serialized array of name value pairs that store the filter settings for the specific format.',   PRIMARY KEY (`format`,`name`),   KEY `list` (`weight`,`module`,`name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Table that maps filters (HTML corrector) to text formats ...';
