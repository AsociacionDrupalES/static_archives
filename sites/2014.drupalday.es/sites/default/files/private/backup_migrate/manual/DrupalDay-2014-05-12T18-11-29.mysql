INSERT INTO `locales_target` VALUES ('12946','Una pequeña descripción del campo, usada para ayudar al usuario cuando usa el formulario.','es','0','0','0'),('12947','Seleccione esta opción si el usuario debe ingresar un valor.','es','0','0','0'),('12948','El tipo de componente @type no tiene función de edición definida.','es','0','0','0'),('12949','La clave de campo %field_key no es válida. Por favor utilice solemante caracteres alfanuméricos en minúscula y guiones bajos.','es','0','0','0'),('12950','La clave (key) %field_key ya está siendo usada por el campo %existing_field. Por favor, indique otra.','es','0','0','0'),('12951','Envío #@sid','es','0','0','0'),('12952','Envío Anterior','es','0','0','0'),('12953','Envío Siguiente','es','0','0','0'),('12954','Enviado por !name','es','0','0','0'),('12955','Página siguiente >','es','0','0','0'),('12956','< Página anterior','es','0','0','0'),('12957','El componente de webform @type no se puede mostrar','es','0','0','0'),('12958','Información ilegal. Datos no enviados.','es','0','0','0'),('12959','Volver al formulario','es','0','0','0'),('12960','El valor predeterminado del campo.','es','0','0','0'),('12961','Dejado en blanco','es','0','0','0'),('12962','Valor especificado por el usuario','es','0','0','0'),('12963','Ancho del campo de texto.','es','0','0','0'),('12964','Email del usuario como valor por defecto','es','0','0','0'),('12965','Usar e-mail del usuario como valor por defecto, si es que está identificado.','es','0','0','0'),('12966','Hacer este campo no editable. Esto es útil para configurar un valor predefinido que no puede ser modificado.','es','0','0','0'),('12967','Longitud promedio de los envíos, en palabras (excluyendo espacios en blanco)','es','0','0','0'),('12968','Si este conjunto de campos es plegable, el usuario puede abrir o cerrar el conjunto de campos.','es','0','0','0'),('12969','Colapsado por defecto','es','0','0','0'),('12970','Los conjuntos de campos plegables están «abiertos» de forma predefinida. Seleccione esta opción para cambiar el valor predefinido de los grupos de campos a «cerrado».','es','0','0','0');
INSERT INTO `locales_target` VALUES ('12971','Fichero subido por usuario','es','0','0','0'),('12972','Tamaño medio de los ficheros','es','0','0','0'),('12973','Preguntas','es','0','0','0'),('12974','Aleatorizar opciones','es','0','0','0'),('12975','Hace aleatorio el orden de las opciones en la parte superior cuando se muestran en el formulario.','es','0','0','0'),('12976','Aleatorizar preguntas','es','0','0','0'),('12977','Hace aleatorio el orden de las preguntas en la parte lateral cuando se muestran en el formulario.','es','0','0','0'),('12978','No vacío','es','0','0','0'),('12979','Markup permite entroducir HTML o PHP en tu formulario.','es','0','0','0'),('12980','Seleccione esta opción si se le debe permitir al usuario escoger múltiples valores.','es','0','0','0'),('12981','Listbox','es','0','0','0'),('12982','Nodo completo','es','0','0','0'),('12983','Opciones de envío','es','0','0','0'),('12984','Nombre del remitente','es','0','0','0'),('12985','Dirección Desde','es','0','0','0'),('12986','Plantilla de correo electrónico','es','0','0','0'),('12987','Formato de exportación','es','0','0','0'),('12988','Valores','es','0','0','0'),('12989','Validación','es','0','0','0'),('12990','Disponible como bloque','es','0','0','0'),('12991','Paso','es','0','0','0'),('12992','URL de redirección','es','0','0','0'),('12993','Redimensionable','es','0','0','0'),('12994','Plantilla personalizada','es','0','0','0'),('12995','Enviar por correo electrónico a','es','0','0','0'),('12996','Texto delimitado','es','0','0','0'),('12997','Formato de texto delimitado','es','0','0','0'),('12998','Coma (,)','es','0','0','0'),('12999','Tabulador(\\t)','es','0','0','0'),('13000','Punto y coma (;)','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13001','Dos puntos (:)','es','0','0','0'),('13002','Punto (.)','es','0','0','0'),('13003','Espacio ( )','es','0','0','0'),('13004','Guardar borrador','es','0','0','0'),('13005','12-horas (am/pm)','es','0','0','0'),('13006','24 horas','es','0','0','0'),('13007','No hay envíos de este formulario. <a href="!url">Ver este formulario</a>.','es','0','0','0'),('13008','Nombre del nuevo componente','es','0','0','0'),('13009','Al agregar un nuevo componente, el campo de nombre es requerido.','es','0','0','0'),('13010','Opcional. Puede organizar el formulario ubicando este componente dentro de otro grupo de campos.','es','0','0','0'),('13011','Componente %name clonado.','es','0','0','0'),('13012','Componente %name actualizado.','es','0','0','0'),('13013','Envíos de %user','es','0','0','0'),('13014','Mostrando todos los resultados.','es','0','0','0'),('13015','@total resultados en total.','es','0','0','0'),('13016','Éste es el delimitador que se utiliza en el archivo CSV/TSV cuando se descargan los resultados del Webform. Usar tabuladores en la exportación es el método más fiable para conservar los caracteres no latinos. Podría querer cambiarlo por algún otro caracter dependiendo del programa al que prevee importar los resultados.','es','0','0','0'),('13017','Estos permisos determinan qué roles pueden enviar este formulario. No evitan el acceso a la página del formulario. Si necesita prevenir el acceso a la página del formulario completa, utilice un módulo de acceso al contenido como <a href="http://drupal.org/project/taxonomy_access">Taxonomy Access</a> ó <a href="http://drupal.org/project/node_privacy_byrole">Node Privacy by Role</a>.','es','0','0','0'),('13018','Roles que pueden enviar este formulario','es','0','0','0'),('13019','Mostrar el formulario completo en la vista resumen','es','0','0','0'),('13020','Mostrar el formulario completo en la vista resumen de este nodo.','es','0','0','0'),('13021','Por defecto el botón de envío de este formulario tendrá una etiqueta <em>Enviar</em>. Introduzca un nuevo título aquí para sobreescribir la etiqueta por defecto.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13022','Está cerrado el envío para este formulario.','es','0','0','0'),('13023','Debe <a href="!login">iniciar sesión</a> o <a href="!register">registrarse</a> para ver este formulario.','es','0','0','0'),('13024','No tiene permisos para ver este formulario.','es','0','0','0'),('13025','Ha enviado este formulario el máximo número de veces posible (@count).','es','0','0','0'),('13026','Ya ha enviado este formulario.','es','0','0','0'),('13027','No puede realizar otro envío en este momento.','es','0','0','0'),('13028','<a href="!url">Ver sus envíos anteriores</a>.','es','0','0','0'),('13029','Componentes disponibles','es','0','0','0'),('13030','Estos son los tipos de campos disponibles para su instalación de Webform. Puede deshabilitar cualquiera de estos componentes desmarcando su casilla correspondiente. Solamente los componentes marcados estarán disponibles en los nuevos formularios.','es','0','0','0'),('13031','Valores predeterminados de correo electŕonico','es','0','0','0'),('13032','El remitente predeterminado para los resultados de formularios enviados por correo electrónico; suele ser la dirección de correo del administrador de los formularios.','es','0','0','0'),('13033','El nombre predeterminado del remitente, que será usado junto con la dirección remitente predeterminada.','es','0','0','0'),('13034','Asunto predeterminado','es','0','0','0'),('13035','Envío de formulario desde: %title','es','0','0','0'),('13036','La línea de asunto predeterminada para resultados enviados por correo electrónico.','es','0','0','0'),('13037','Permitir cookies para el seguimiento de envíos','es','0','0','0'),('13038','Las <a href="http://www.wikipedia.org/wiki/HTTP_cookie">Cookies</a> pueden usarse para evitar que el mismo usuario envíe repetidamente el mismo formulario. Esta característica no se necesita para limitar los envíos del formulario por usuario, pero puede incrementar la precisión en algunas situaciones. Además de las cookies, Webform también utiliza las direciones IP y los nombres de usuario para prevenir los envíos repetidos.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13039','Formato de exportación predeterminado','es','0','0','0'),('13040','Delimitador de exportación predeterminado','es','0','0','0'),('13041','Control de acceso al envío del formulario','es','0','0','0'),('13042','Seleccionar los roles de usuario que pueden enviar cada webform individual.','es','0','0','0'),('13043','Deshabilitar el control de acceso a los envíos de Webform','es','0','0','0'),('13044','Por defecto, la configuración para cada Webform permite al administrador elegir qué roles pueden enviar el formulario. Puede querer permitir a los usuarios enviar siempre el formulario si está utilizando un módulo separado de acceso a los nodos para controlar el acceso a los nodos Webform.','es','0','0','0'),('13045','Envío actualizado.','es','0','0','0'),('13046','Gracias, su envío ha sido recibido.','es','0','0','0'),('13047','Puede utlizar «tokens» especiales en este campo, que serán reemplazados con valores dinámicos.','es','0','0','0'),('13048','Valores de «token»','es','0','0','0'),('13049','Componentes de formulario','es','0','0','0'),('13050','Zona horaria del sitio web','es','0','0','0'),('13051','Zona horaria del usuario','es','0','0','0'),('13052','Usar un campo de texto para el año','es','0','0','0'),('13053','Si se marca, el campo de fecha generado usará un campo de texto para el año. Si no, se utiliazará una lista de selección.','es','0','0','0'),('13054','El !name especificado no es una fecha válida.','es','0','0','0'),('13055','Dejándolo en blanco se utilizará el tamaño por defecto.','es','0','0','0'),('13056','%value no es una dirección de correo electrónico válida.','es','0','0','0'),('13057','El campo %field es obligatorio.','es','0','0','0'),('13058','Tamaño de archivo (KB)','es','0','0','0'),('13059','Las opciones en la lista de selección deben ser únicas. Las siguientes claves se han usado más de una vez:','es','0','0','0'),('13060','El usuario puede redimensionar este campo.','es','0','0','0'),('13061','Ejemplos: lb, kg, %.','es','0','0','0'),('13062','%name no es una hora válida.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13063','Compacto','es','0','0','0'),('13064','Días de la semana','es','0','0','0'),('13065','Opciones de formulario','es','0','0','0'),('13066','Unico','es','0','0','0'),('13067','Acepta cualquier fecha en cualquier <a href="http://www.gnu.org/software/tar/manual/html_chapter/Date-input-formats.html">Formato de entrada de fecha de GNU</a>. Son válidas cadenas de caracteres como «today», «+2 months» y «Dec 9 2004».','es','0','0','0'),('13068','Acepta una hora en cualquier <a href="http://www.gnu.org/software/tar/manual/html_chapter/Date-input-formats.html">formato de entrada de fecha GNU</a>. Cadenas como «now», «+2 hours», y «10:30pm» son válidas.','es','0','0','0'),('13069','Webform posibilita que los nodos tengan adjuntos formularios y cuestionarios.','es','0','0','0'),('13070','Para agregar uno, cree una pieza de contenido de tipo !types .','es','0','0','0'),('13071','En este momento, Webform no está habilitado para ningún tipo de contenido.','es','0','0','0'),('13072','Para usar Webform, por favor habilítelo en al menos un tipo de contenido en esta página.','es','0','0','0'),('13073','Esta página lista todo el contenido del sitio que puede tener un formulario adjunto.','es','0','0','0'),('13074','Contenido habilitado para Webform','es','0','0','0'),('13075','Visite la página <a href="!url">Configuración de Webform</a> y habilite Webform en al menos un tipo de contenido.','es','0','0','0'),('13076','Opcional: Habilite Webform en múltiples tipos visitando la página <a href="!url">Configuración de Webform</a>.','es','0','0','0'),('13077','Valor de !component','es','0','0','0'),('13078','Valor de "!component"','es','0','0','0'),('13079','Configuración de Webform','es','0','0','0'),('13080','Editar la configuración de correo electrónico','es','0','0','0'),('13081','Borrar la configuración de correo electrónico','es','0','0','0'),('13082','Verificar que todos los valores ingresados en este campo son únicos. El mismo valor no se podrá usar una segunda vez.','es','0','0','0'),('13083','Otro...','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13084','Permitir la opción "Otro..."','es','0','0','0'),('13085','Marque esta opción si quiere permitir a los usuarios escribir una opción que no esté en la lista.','es','0','0','0'),('13086','Texto para la opción «Otro...»','es','0','0','0'),('13087','Si se permiten otras opciones, escriba el texto que se usará para la opción «otro».','es','0','0','0'),('13088','Aleatorizar las opciones','es','0','0','0'),('13089','Hace aleatorio el orden de las opciones cuando se muestran en el formulario.','es','0','0','0'),('13090','Longitud máxima del valor del campo de texto.','es','0','0','0'),('13091','Tipos de contenido habilitados para webform','es','0','0','0'),('13092','Webform le permite habilitar los componentes de formulario para cualquier tipo de contenido. Escoja los tipos en los que quiere asociar componentes webform.','es','0','0','0'),('13093','Formato de dirección de correo electrónico','es','0','0','0'),('13094','Formato largo: «Nombre de Ejemplo» &lt;nombre@ejemplo.com&gt;','es','0','0','0'),('13095','Formato corto: nombre@ejemplo.com','es','0','0','0'),('13096','La mayoría de los servidores soportan el formato "largo" que permite direcciones del remitente más amigables en los correos electrónicos enviados. Sin embargo la mayoría de los servidores basados en Windows son incapaces de enviarlos con el formato largo. Cambie esta opción si está teniendo problemas enviando correos electrónicos con Webform.','es','0','0','0'),('13097','Actualmente no hay formularios en su sitio. Cree una pieza de contenido de tipo !types .','es','0','0','0'),('13098','Crear una regla para controlar si se muestra o no este elemento de formulario.','es','0','0','0'),('13099','Reglas condicionales','es','0','0','0'),('13100','Determina si la lista de abajo es inclusiva o exclusiva.','es','0','0','0'),('13101','Incluir todos los componentes','es','0','0','0'),('13102','El valor %value ya se ha enviado una vez para el campo %title . Puede que ya haya enviado este formulario, o que sea necesario utilizar un valor diferente.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13103','Valor de componente','es','0','0','0'),('13104','Sin envíos de e-mails actualmente, añadir destinatarios de e-mails debajo.','es','0','0','0'),('13105','correo@ejemplo.com','es','0','0','0'),('13106','Los envíos del formulario se enviarán a esta dirección de correo electrónico. Cualquier campo correo electrónico, opciones de selección u oculto puede seleccionarse como la dirección del destinatario. Los valores múltiples de direcciones de correo pueden separarse por comas.','es','0','0','0'),('13107','Se puede seleccionar como asunto de los correos electrónicos cualquier campo de texto, opciones de selección o elemento oculto.','es','0','0','0'),('13108','Se puede seleccionar como dirección del remitente de los correos electrónicos cualquier campo de texto, opciones de selección o elemento oculto.','es','0','0','0'),('13109','Se puede seleccionar como nombre del remitente de los correos electrónicos cualquier campo de texto, opciones de selección o elemento oculto.','es','0','0','0'),('13110','No hay componentes disponibles','es','0','0','0'),('13111','Una plantilla de correo electrónico puede personalizar la manera de mostrar los correos.','es','0','0','0'),('13112','Valores de correo electrónico incluidos','es','0','0','0'),('13113','Los componentes seleccionados serán incluidos en el token %email_values. Los valores individuales pueden aún mostrarse si se especifican como %email[key] en la plantilla.','es','0','0','0'),('13114','Guardar configuración de correo electrónico','es','0','0','0'),('13115','Detalles de la cabecera del correo electrónico','es','0','0','0'),('13116','Mensaje de confirmación','es','0','0','0'),('13117','Limitar el número de envíos <em>por usuario</em>. Un usuario se identifica por su nombre de usuario si ha inciado sesión, o por su dirección IP y «Cookie» si es anónimo. El uso de «cookies» puede modificarse en la página global de <a href="!url">Configuraciones de Webform</a>.','es','0','0','0'),('13118','Acceso a los envíos','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13119','Mostrar las notificaciones sobre envíos anteriores.','es','0','0','0'),('13120','Mostrar las notificaciones sobre envíos anteriores que aparecen cuando los usuarios ya han enviado este formulario previamente.','es','0','0','0'),('13121','Opciones de lista de selección','es','0','0','0'),('13122','Formato de lista de selección','es','0','0','0'),('13123','ID del envío','es','0','0','0'),('13124','Componentes a incluir en la exportación','es','0','0','0'),('13125','Opción','es','0','0','0'),('13126','Opción B','es','0','0','0'),('13127','Opción C','es','0','0','0'),('13128','Enviado por el usuario: %username','es','0','0','0'),('13129','borrador','es','0','0','0'),('13130','formulario @name','es','0','0','0'),('13131','Debe <a href="!login">iniciar sesión</a> para ver este formulario.','es','0','0','0'),('13132','Por defecto: %value','es','0','0','0'),('13133','Valor predeterminado de zona horaria','es','0','0','0'),('13134','Cargar una lista de opciones creada previamente','es','0','0','0'),('13135','Usa una lista preelaborada de opciones en lugar de escribir las opciones manualmente. Las opciones no serán editables si se usa una lista preelaborada.','es','0','0','0'),('13136','Cada opción debe tener una clave especificada. Especifique cada opción como «clave_segura|Alguna opción legible».','es','0','0','0'),('13137','Las claves de opción deben tener menos de 128 caracteres. Las siguientes claves superan este límite:','es','0','0','0'),('13138','Editar componente: @name','es','0','0','0'),('13139','Activar un calendario en una ventana emergente','es','0','0','0'),('13140','Activar un selector de fecha de JavaScript al lado del campo de fecha.','es','0','0','0'),('13141','Webform: !title','es','0','0','0'),('13142','Solo formulario','es','0','0','0'),('13143','El modo de visualización determina cuánto del formulario mostrar en el bloque.','es','0','0','0'),('13144','El formato predeterminado para la nueva configuración de correo. Las opciones de correo electrónico de Webform tienen prioridad sobre las opciones globales de correo electrónico configuradas en correo MIME.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13145','Enviar todos los correos electrónicos en el formato predeterminado','es','0','0','0'),('13146','Forzar a que se envíen todos los correos electrónicos de webform en el formato predeterminado.','es','0','0','0'),('13147','No hay componentes disponibles.','es','0','0','0'),('13148','¿Está seguro que desea deshacer cualquier cambio y volver a la plantilla predeterminada?','es','0','0','0'),('13149','Mensaje que se mostrará luego de un envío exitoso. Si la dirección de redirección se establece como <em>Página de confirmación</em> será mostrado en su propia página. De otra forma, se desplegará como un mensaje.','es','0','0','0'),('13150','Dirección de redirección','es','0','0','0'),('13151','Elegir a dónde redirigir al usuario una vez que se ha enviado el formulario con éxito.','es','0','0','0'),('13152','Página de confirmación','es','0','0','0'),('13153','No redireccionar (recargar la página actual)','es','0','0','0'),('13154','Si está activado este formulario estará disponible como un bloque.','es','0','0','0'),('13155','Claves de selección','es','0','0','0'),('13156','Opciones completas y legibles para un humano (valores)','es','0','0','0'),('13157','Opciones cortas y sin formato (claves)','es','0','0','0'),('13158','Introduzca una clave de sistema para este elemento de formulario. Puede contener solo caracteres alfanuméricos y guiones bajos. Esta clave será usada como atributo de nombre del elemento del formulario. Este valor no tiene ningún efecto en la forma en que los datos se almacenan, pero puede ser útil al realizar un procesamiento personalizado del formulario.','es','0','0','0'),('13159','Estado de este formulario','es','0','0','0'),('13160','Cerrar el formulario evita los posibles envíos de cualquier usuario.','es','0','0','0'),('13161','El rol %authenticated se aplica a todos los usuarios que han ingresado en el sitio, además de otros roles que tengan asignados.','es','0','0','0'),('13162','Este formulario puede ser usado para reenviar correos electrónicos configurados por este formulario web. Verifique los correos electrónicos que deben ser enviados y haga click en <em>Reenviar correos electrónicos</em> para enviarlos de nuevo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13163','Reenviar correos electrónicos','es','0','0','0'),('13164','Envío guardado. Usted puede volver a este formuario luego y recuperará sus valores actuales.','es','0','0','0'),('13165','Lista descendente de preguntas al lado de la parrilla. Una pregunta por línea. <strong>Parejas de clave-valor se DEBEN especificar de la forma «clave_segura|Alguna opción legible»</strong>. Se recomienda usar sólo caracteres alfanuméricos y guiones bajos en las claves.','es','0','0','0'),('13166','<strong>Los pares clave-valor DEBEN especificarse como "clave_válida|Opción legible"</strong>. Se recomienda en las claves sólo caracteres alfanuméricos y guiones bajos. Una opción por línea. Los grupos de opciones deben especificarse con &lt;Nombre del grupo&gt;. &lt;&gt; puede utilizarse para insertar elementos en la raíz del menú después de especificar un grupo.','es','0','0','0'),('13167','Mostrar botón de "Guardar borrador"','es','0','0','0'),('13168','Permite a los usuarios guardar y terminar el formulario más tarde. Esta opción sólo está disponible para los usuarios autenticados.','es','0','0','0'),('13169','Guardar automáticamente como borrador entre páginas','es','0','0','0'),('13170','Guardar automáticamente los envíos parciales cuando los usuarios utilicen los botones "Siguiente" o "Anterior" en un formulario multipágina.','es','0','0','0'),('13171','La dirección IP del usuario.','es','0','0','0'),('13172','La fecha actual, formateada de acuerdo a la configuración del sitio.','es','0','0','0'),('13173','El título del nodo.','es','0','0','0'),('13174','Los «tokens» pueden llenarse a partir de la URL creando URLs de la forma http://ejemplo.com/mi-formulario?foo=bar. Al usar el «token» %get[foo] se imprimirá «bar».','es','0','0','0'),('13175','Todos los componentes incluidos en estructura jerárquica.','es','0','0','0'),('13176','Si se utilizan fechas relativas para el valor predefinido (e.g. «today»), el día actual se basará en esta zona horaria.','es','0','0','0'),('13177','El valor predefinido del campo identificado por su clave. Para selecciones múltiples, use comas para separar varios valores predefinidos.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('13178','Si se están utilizando fechas relativas como hora por defecto (por ejemplo, "now") basará la hora actual en esta zona horaria.','es','0','0','0'),('13179','Despliegue de la etiqueta','es','0','0','0'),('13180','Determina la ubicación de la etiqueta del componente.','es','0','0','0'),('13181','Ocultar etiqueta','es','0','0','0'),('13182','No desplegar la etiqueta de este componente.','es','0','0','0'),('13183','Guardar el componente','es','0','0','0'),('13184','La opción <em>URL personalizada</em> permite los reemplazos de Webform.','es','0','0','0'),('13185','Muestra todos los formularios en un bloque','es','0','0','0'),('13278','Nombre del Remitente','es','0','0','0'),('13285','Adjuntos','es','0','0','0'),('13290','Tema de dominio','es','0','0','0'),('13291','Ajustes del sistema de correos','es','0','0','0'),('13292','Configuración de correo electrónico','es','0','0','0');
DROP TABLE IF EXISTS `menu_custom`;
CREATE TABLE `menu_custom` (   `menu_name` varchar(32) NOT NULL DEFAULT '' COMMENT 'Primary Key: Unique key for menu. This is used as a block delta so length is 32.',   `title` varchar(255) NOT NULL DEFAULT '' COMMENT 'Menu title; displayed at top of block.',   `description` text COMMENT 'Menu description.',   PRIMARY KEY (`menu_name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Holds definitions for top-level custom menus (for example...';
INSERT INTO `menu_custom` VALUES ('features','Características','Menu items for any enabled features.'),('main-menu','Main menu','The <em>Main</em> menu is used on many sites to show the major sections of the site, often in a top navigation bar.'),('management','Management','The <em>Management</em> menu contains links for administrative tasks.'),('navigation','Navigation','The <em>Navigation</em> menu contains links intended for site visitors. Links are added to the <em>Navigation</em> menu automatically by some modules.'),('user-menu','User menu','The <em>User</em> menu contains links related to the user''s account, as well as the ''Log out'' link.');
DROP TABLE IF EXISTS `menu_links`;
CREATE TABLE `menu_links` (   `menu_name` varchar(32) NOT NULL DEFAULT '' COMMENT 'The menu name. All links with the same menu name (such as ’navigation’) are part of the same menu.',   `mlid` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'The menu link ID (mlid) is the integer primary key.',   `plid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The parent link ID (plid) is the mlid of the link above in the hierarchy, or zero if the link is at the top level in its menu.',   `link_path` varchar(255) NOT NULL DEFAULT '' COMMENT 'The Drupal path or external path this link points to.',   `router_path` varchar(255) NOT NULL DEFAULT '' COMMENT 'For links corresponding to a Drupal path (external = 0), this connects the link to a menu_router.path for joins.',   `link_title` varchar(255) NOT NULL DEFAULT '' COMMENT 'The text displayed for the link, which may be modified by a title callback stored in menu_router.',   `options` blob COMMENT 'A serialized array of options to be passed to the url() or l() function, such as a query string or HTML attributes.',   `module` varchar(255) NOT NULL DEFAULT 'system' COMMENT 'The name of the module that generated this link.',   `hidden` smallint(6) NOT NULL DEFAULT '0' COMMENT 'A flag for whether the link should be rendered in menus. (1 = a disabled menu item that may be shown on admin screens, -1 = a menu callback, 0 = a normal, visible link)',   `external` smallint(6) NOT NULL DEFAULT '0' COMMENT 'A flag to indicate if the link points to a full URL starting with a protocol, like http:// (1 = external, 0 = internal).',   `has_children` smallint(6) NOT NULL DEFAULT '0' COMMENT 'Flag indicating whether any links have this link as a parent (1 = children exist, 0 = no children).',   `expanded` smallint(6) NOT NULL DEFAULT '0' COMMENT 'Flag for whether this link should be rendered as expanded in menus - expanded links always have their child links displayed, instead of only when the link is in the active trail (1 = expanded, 0 = not expanded)',   `weight` int(11) NOT NULL DEFAULT '0' COMMENT 'Link weight among links in the same menu at the same depth.',   `depth` smallint(6) NOT NULL DEFAULT '0' COMMENT 'The depth relative to the top level. A link with plid == 0 will have depth == 1.',   `customized` smallint(6) NOT NULL DEFAULT '0' COMMENT 'A flag to indicate that the user has manually created or edited the link (1 = customized, 0 = not customized).',   `p1` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The first mlid in the materialized path. If N = depth, then pN must equal the mlid. If depth > 1 then p(N-1) must equal the plid. All pX where X > depth must equal zero. The columns p1 .. p9 are also called the parents.',   `p2` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The second mlid in the materialized path. See p1.',   `p3` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The third mlid in the materialized path. See p1.',   `p4` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The fourth mlid in the materialized path. See p1.',   `p5` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The fifth mlid in the materialized path. See p1.',   `p6` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The sixth mlid in the materialized path. See p1.',   `p7` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The seventh mlid in the materialized path. See p1.',   `p8` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The eighth mlid in the materialized path. See p1.',   `p9` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The ninth mlid in the materialized path. See p1.',   `updated` smallint(6) NOT NULL DEFAULT '0' COMMENT 'Flag that indicates that this link was generated during the update from Drupal 5.',   PRIMARY KEY (`mlid`),   KEY `path_menu` (`link_path`(128),`menu_name`),   KEY `menu_plid_expand_child` (`menu_name`,`plid`,`expanded`,`has_children`),   KEY `menu_parents` (`menu_name`,`p1`,`p2`,`p3`,`p4`,`p5`,`p6`,`p7`,`p8`,`p9`),   KEY `router_path` (`router_path`(128)) ) ENGINE=InnoDB AUTO_INCREMENT=1359 DEFAULT CHARSET=utf8 COMMENT='Contains the individual links within a menu.' AUTO_INCREMENT=1359;
