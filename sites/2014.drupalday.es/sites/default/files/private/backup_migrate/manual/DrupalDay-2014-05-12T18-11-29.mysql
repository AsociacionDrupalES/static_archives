INSERT INTO `locales_target` VALUES ('2799','Entradas de blog recientes','es','0','0','0'),('2800','Usuarios nuevos','es','0','0','0'),('2801','Nombre del idioma','es','0','0','0'),('2802','Editar idioma','es','0','0','0'),('2803','listar enlaces','es','0','0','0'),('2804','Editar categoría','es','0','0','0'),('2805','Se ha actualizado el tipo de contenido %name.','es','0','0','0'),('2806','Se ha añadido el tipo de contenido %name.','es','0','0','0'),('2807','Catalán','es','0','0','0'),('2808','Laguna azul (predeterminado)','es','0','0','0'),('2809','No se ha encontrado la página solicitada.','es','0','0','0'),('2810','La cuenta de usuario %id no existe.','es','0','0','0'),('2811','Se intentó cancelar una cuenta de usuario no existente: %id.','es','0','0','0'),('2812','Problema de requerimientos','es','0','0','0'),('2813','Configuración de la base de datos','es','0','0','0'),('2814','El tipo de base de datos donde se almacenarán los datos de @drupal.','es','0','0','0'),('2815','El nombre de la base de datos donde se almacenarán los datos de @drupal. Debe existir en el servidor antes de instalar @drupal.','es','0','0','0'),('2816','Si más de una aplicación está utilizando la base de datos, introduzca un prefijo, como %prefix, para su sitio @drupal.','es','0','0','0'),('2817','Seleccionar un perfil de instalación','es','0','0','0'),('2818','Elegir un idioma','es','0','0','0'),('2819','Ver cómo instalar Drupal en otros idiomas','es','0','0','0'),('2820','(interno)','es','0','0','0'),('2821','No hay perfiles disponibles','es','0','0','0'),('2822','Drupal ya está instalado','es','0','0','0'),('2823','<ul><li>Para recomenzar, debe vaciar la base de datos existente.</li><li>Para instalar a una base de datos diferente, edite el archivo <em>settings.php</em> apropiado en la carpeta <em>sites</em>.</li><li>Para actualizar una instalación existente, proceda al <a href="@base-url/update.php">script de actualización</a>.</li><li>Vea su <a href="@base-url">sitio actual</a>.</li></ul>','es','0','0','0'),('2824','Instalando @drupal','es','0','0','0'),('2825','Se ha encontrado un error en la instalación.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('2826','Configurar sitio','es','0','0','0'),('2827','Instalación de @drupal completa','es','0','0','0'),('2828','Instalado el módulo %module.','es','0','0','0'),('2829','Elegir perfil','es','0','0','0'),('2830','Verificar requisitos','es','0','0','0'),('2831','Configurar base de datos','es','0','0','0'),('2832','Configurar traducciones','es','0','0','0'),('2833','Instalar sitio','es','0','0','0'),('2834','Terminar traducciones','es','0','0','0'),('2835','Correo electrónico del sitio','es','0','0','0'),('2836','La dirección <em>De</em> en los correos automáticos enviados durante el registro y tras la solicitud de nueva contraseña, y otros avisos. (Use una dirección que termine con el dominio de su sitio para ayudarle a evitar que su correo sea etiquetado como spam.)','es','0','0','0'),('2837','Las fechas en este sitio se mostrarán en la zona horaria seleccionada de forma predeterminada.','es','0','0','0'),('2838','Avisos de actualización','es','0','0','0'),('2839','Verificar actualizaciones automáticamente','es','0','0','0'),('2840','Eliminada de la base de datos la acción huérfana ''%action''.','es','0','0','0'),('2841','La ejecución de cron excedió su límite de tiempo y fue abortada.','es','0','0','0'),('2842','1 byte','es','0','0','0'),('2843','@count bytes','es','2842','1','0'),('2844','!name no puede superar los %max caracteres, pero actualmente tiene una longitud de %length.','es','0','0','0'),('2845','Opción ilegal %choice en el elemento %name.','es','0','0','0'),('2846','Juego de herramienas GD2 para la manipulación de imágenes','es','0','0','0'),('2847','El juego de herramientas GD está instalado y funciona apropiadamente.','es','0','0','0'),('2848','Definir la calidad de la imagen para las manipulaciones JPEG. Rangos desde 0 hasta 100. Los valores más altos generan imágenes de mejor calidad pero archivos más grandes.','es','0','0','0'),('2849','El juego de herramientas de imagen GD requiere que esté instalado y configurado apropiadamente el módulo GD para PHP. Para más información vea la <a href="@url">documentación de imagen de PHP</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('2850','La calidad JPEG debe ser un número entre 0 y 100','es','0','0','0'),('2851','Derecha a izquierda','es','0','0','0'),('2852','Izquierda a derecha','es','0','0','0'),('2853','Idioma predefinido','es','0','0','0'),('2854','Idioma personalizado','es','0','0','0'),('2855','Añadir idioma personalizado','es','0','0','0'),('2856','Guardar idioma','es','0','0','0'),('2857','Identificador de idioma de conformidad con <a href="@rfc4646">RFC 4646</a>. Los códigos de idioma por lo regular usan un código de país y, opcionalmente, el nombre de un script o una variante regional. <em>Ejemplos: "en", "en-US" y "zh-Hant".</em>','es','0','0','0'),('2858','Nombre del idioma en inglés','es','0','0','0'),('2859','Nombre del idioma en inglés. Estará disponible para ser traducido a todos los idiomas.','es','0','0','0'),('2860','Nombre nativo del idioma','es','0','0','0'),('2861','Nombre del idioma en el idioma que se está agregando.','es','0','0','0'),('2862','Dominio del idioma','es','0','0','0'),('2863','Dirección en la que se escribe este idioma.','es','0','0','0'),('2864','El idioma %language (%code) ya existe.','es','0','0','0'),('2865','Código de idioma no válido.','es','0','0','0'),('2866','El idioma %language ha sido creado y ahora puede usarse. Hay más información disponible en la <a href="@locale-help">pantalla de ayuda</a>.','es','0','0','0'),('2867','No deben fijarse al mismo tiempo valores para el dominio y para el prefijo de ruta.','es','0','0','0'),('2868','El dominio (%domain) ya está relacionado con un idioma (%language).','es','0','0','0'),('2869','Sólo el idioma predeterminado puede tener en blanco tanto el dominio como el prefijo.','es','0','0','0'),('2870','El prefijo (%prefix) ya está relacionado con un idioma (%language).','es','0','0','0'),('2871','El idioma inglés no puede ser eliminado','es','0','0','0'),('2872','El idioma predeterminado no se puede eliminar.','es','0','0','0'),('2873','Borrar un idioma eliminará todas las traducciones de la interfaz que tenga asociadas y las entradas escritas en ese idioma pasarán a ser sin idioma específico. Esta acción es irreversible.','es','0','0','0');
