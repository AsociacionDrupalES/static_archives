INSERT INTO `locales_source` VALUES ('6753','','default','The name of the item; e.g. node.','','7.12'),('6754','','default','The type of the item, either module, theme, or theme_engine.','','7.12'),('6755','','default','Boolean indicating whether or not this item is enabled.','','7.12'),('6756','','default','Schema version','','7.12'),('6757','','default','The module''s database schema version number. -1 if the module is not installed (its tables do not exist); 0 or the largest N of the module''s hook_update_N() function that has either been run or existed when the module was first installed.','','7.12'),('6758','','default','Human-readable name','','7.12'),('6759','','default','Fixed value','','7.12'),('6760','','default','Asc','','7.12'),('6761','','default','Access the views administration pages.','','7.12'),('6762','','default','Bypass access control when accessing views.','','7.12'),('6763','','default','Add new view','','7.12'),('6764','','default','- Basic validation -','','7.12'),('6765','','default','HTML element','','7.12'),('6766','','default','Label HTML element','','7.12'),('6767','','default','Place a colon after the label','','7.12'),('6768','','default','Wrapper HTML element','','7.12'),('6769','','default','Wrapper class','','none'),('6770','','default','Add default classes','','7.12'),('6771','','default','Use default Views classes to identify the field, field label and field content.','','7.12'),('6772','','default','Use absolute path','','7.12'),('6773','','default','Rel Text','','7.12'),('6774','','default','Include Rel attribute for use in lightbox2 or other javascript utility.','','7.12'),('6775','','default','Preserve certain tags','','7.12'),('6776','','default','List the tags that need to be preserved during the stripping process. example &quot;&lt;p&gt; &lt;br&gt;&quot; which will preserve all p and br elements','','7.12'),('6777','','default','Enter mathematical expressions such as 2 + 2 or sqrt(5). You my assign variables and create mathematical functions and evaluate them. Use the ; to separate these. For example: f(x) = x + 2; f(2).','','7.10');
INSERT INTO `locales_source` VALUES ('6778','','default','Format plural','','7.12'),('6779','','default','If checked, special handling will be used for plurality.','','7.12'),('6780','','default','Singular form','','7.12'),('6781','','default','Text to use for the singular form.','','7.12'),('6782','','default','Plural form','','7.12'),('6783','','default','Text to use for the plural form, @count will be replaced with the value.','','7.12'),('6784','','default','An offset from the current time such as "!example1" or "!example2"','','none'),('6785','','default','A unique machine-readable name for this View. It must only contain lowercase letters, numbers, and underscores.','','7.12'),('6786','','default','Weight for @display','','none'),('6787','','default','Translation method','','none'),('6788','','default','Select a translation method to use for Views data like header, footer, and empty text.','','none'),('6789','','default','This title will be displayed on the views edit page instead of the default one. This might be useful if you have the same item twice.','','7.12'),('6790','','default','Do not pass admin strings for translation.','','7.12'),('6791','','default','Use Drupal core t() function. Not recommended, as it doesn''t support updates to existing strings.','','7.12'),('6792','','default','Feed Item ID','','none'),('6793','','default','The guid of the original imported item.','','none'),('6794','','default','Date and time of when the comment was created.','','7.12'),('6795','','default','Date and time of when the comment was last updated.','','7.12'),('6796','','default','Whether the comment is approved (or still in the moderation queue).','','7.12'),('6797','','default','Approved comment','','7.12'),('6798','','default','Last comment CID','','7.12'),('6799','','default','Display the last comment of a node','','7.12'),('6800','','default','Last Comment','','7.12'),('6801','','default','The last comment of a node.','','7.12'),('6802','','default','Some roles