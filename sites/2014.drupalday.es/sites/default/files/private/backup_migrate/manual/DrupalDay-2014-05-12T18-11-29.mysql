INSERT INTO `locales_source` VALUES ('8891','/index.php','default','The number of messages to show. Defaults to 10.','','7.12'),('8892','/index.php','default','Restrict to messages of a given severity level.','','7.12'),('8893','/index.php','default','Restrict to messages of a given type.','','7.12'),('8894','/index.php','default','Continuously show new watchdog messages until interrupted.','','7.12'),('8895','/index.php','default','To be used in conjunction with --tail. This is the number of seconds to wait between each poll to the database. Delay is 1 second by default.','','7.12'),('8896','/index.php','default','Show a listing of most recent 10 messages.','','7.12'),('8897','/index.php','default','Show in detail message with id 64.','','7.12'),('8898','/index.php','default','Show a listing of most recent 10 messages containing the string "cron run succesful".','','7.12'),('8899','/index.php','default','Show a listing of most recent 46 messages.','','7.12'),('8900','/index.php','default','Show a listing of most recent 10 messages with a severity of notice.','','7.12'),('8901','/index.php','default','Show a listing of most recent 10 messages of type php.','','7.12'),('8902','/index.php','default','Show a listing of most recent 10 messages and continue showing messages as they are registered in the watchdog.','','7.10'),('8903','/index.php','default','Do a tail of the watchdog with a delay of two seconds between each poll to the database.','','7.12'),('8904','/index.php','default','Delete watchdog messages.','','7.12'),('8905','/index.php','default','Delete messages of a given severity level.','','7.12'),('8906','/index.php','default','Delete messages of a given type.','','7.12'),('8907','/index.php','default','Delete all messages.','','7.12'),('8908','/index.php','default','Delete messages with id 64.','','7.12'),('8909','/index.php','default','Delete messages containing the string "cron run succesful".','','7.12'),('8910','/index.php','default','Delete all message