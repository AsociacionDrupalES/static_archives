INSERT INTO `locales_source` VALUES ('8997','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','When printing url paths, how to transform the case of the filter value.','','7.12'),('8998','','default','Title text','','7.12'),('8999','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','Text to place as "title" text which most browsers display as a tooltip when hovering over the link.','','7.12'),('9000','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','<p>The following tokens are available for this field. Note that due to rendering order, you cannot use fields that come after this field; if you need a field not listed here, rearrange your fields.\nIf you would like to have the characters %5B and %5D please use the html entity codes ''%5B'' or  ''%5D'' or they will get replaced with empty space.</p>','','7.12'),('9001','','default','Remove whitespace','','7.12'),('9002','','default','If checked, all whitespaces at the beginning and the end of the output will be removed.','','7.12'),('9003','','default','Convert newlines to HTML &lt;br&gt; tags','','7.12'),('9004','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','Provide text to display if this field returns no results. You may include HTML. You may enter data from this view as per the "Replacement patterns" in the "Rewrite Results" section below.','','7.12'),('9005','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','Enable to hide this field if it is empty. Note that the field label or rewritten output may still be displayed. To hide labels, check the style or row style settings for empty fields. To hide rewritten content, check the "Hide rewriting if empty" checkbox.','','7.12'),('9006','','default','Hide rewriting if empty','','7.12'),('9007','','default','Do not display rewritten content if this field is empty.','','7.12'),('9008','/dday/admin/structure/views/ajax/display/imagen/block_1/title','default'