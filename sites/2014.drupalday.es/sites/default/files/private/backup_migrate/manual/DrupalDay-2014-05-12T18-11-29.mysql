INSERT INTO `locales_target` VALUES ('2571','Mensaje de advertencia','es','0','0','0'),('2572','Alerta de seguridad: No fue posible escribir el archivo .htaccess. Por favor cree un archivo .htacess en su carpeta %directory e incluya en él las líneas siguientes: <code>!htaccess</code>','es','0','0','0'),('2573','El archivo especificado %file no se pudo copiar porque no existe ninguno con ese nombre. Por favor, compruebe si proporcionó el nombre de archivo correcto.','es','0','0','0'),('2574','El archivo especificado %file no se pudo copiar ya que no se puede sobrescribir a si mismo.','es','0','0','0'),('2575','El archivo %file no se pudo guardar, porque es mayor que %maxsize, el tamaño máximo permitido para subidas.','es','0','0','0'),('2576','El archivo %file no se pudo guardar, porque el proceso de subirlo no se completó.','es','0','0','0'),('2577','El archivo %file no se pudo guardar. Ha ocurrido un error desconocido.','es','0','0','0'),('2578','El archivo especificado %name no se pudo subir.','es','0','0','0'),('2579','El nombre de archivo está vacío. Dé un nombre al archivo, por favor.','es','0','0','0'),('2580','Sólo se permiten archivos con las siguientes extensiones: %files-allowed.','es','0','0','0'),('2581','El archivo ocupa %filesize excediendo el máximo permitido por archivo que es %maxsize.','es','0','0','0'),('2582','El tamaño del archivo ocupa %filesize lo que puede provocar que exceda el espacio que tiene adjudicado en el disco que es de %quota.','es','0','0','0'),('2583','Sólo se permiten imágenes JPEG, PNG y GIF.','es','0','0','0'),('2584','Se ha redimensionado la imagen para ajustarla a las dimensiones máximas permitidas de %dimensions pixeles.','es','0','0','0'),('2585','La imagen es muy grande; las dimensiones máximas son %dimensions pixeles.','es','0','0','0'),('2586','La imagen es demasiado pequeña. Las dimensiones mínimas son %dimensions píxeles.','es','0','0','0'),('2587','El archivo %path no se pudo borrar porque no existe.','es','0','0','0'