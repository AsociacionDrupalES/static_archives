INSERT INTO `locales_target` VALUES ('9252','La primera letra del nombre','es','0','0','0'),('9253','Las dos primeras letras del nombre','es','0','0','0'),('9254','Nombre abreviado','es','0','0','0'),('9255','Mostrar números de la semana','es','0','0','0'),('9256','3 elementos','es','0','0','0'),('9257','5 elementos','es','0','0','0'),('9258','1o elementos','es','0','0','0'),('9259','Demasiados elementos','es','0','0','0'),('9260','Mostrar el máximo, agregar un enlace «más»','es','0','0','0'),('9261','Ocultar todos, añadir un enlace al día','es','0','0','0'),('9262','Comportamiento cuando hay más elementos que el máximo en un sólo día. Cuando hay más elementos que el máximo, se mostrará un enlace al día.','es','0','0','0'),('9263','Próximos','es','0','0','0'),('9264','Ver el calendario.','es','0','0','0'),('9265','Seleccione el periodo de tiempo para esta pantalla de calendario.','es','0','0','0'),('9266','La forma en la que los nombres de los días de la semana deberían mostrarse en el calendario.','es','0','0','0'),('9267','Indica si se debe mostrar o no los números de semana en la columna izquierda de los calendarios de semana y mes.','es','0','0','0'),('9268','Agrupamiento por tiempo','es','0','0','0'),('9269','Agrupar los elementos en períodos de tiempo basándose en su hora de inicio.','es','0','0','0'),('9270','Media hora','es','0','0','0'),('9271','Agrupamiento personalizado por tiempo','es','0','0','0'),('9272','Cuando elija la agrupación por tiempo ''personalizada'', cree agrupaciones de tiempo personalizadas como una lista separada por comas de tiempos de 24 horas en la forma HH:MM:SS, como ''00:00:00,08:00:00,18:00:00''. Asegúrese de empezar con ''00:00:00''. Todos los elementos posteriores a la última agrupación aparecerán al final.','es','0','0','0'),('9273','Agrupación de campos','es','0','0','0'),('9274','A cualquier hora','es','0','0','0'),('9275','Antes de @time','es','0','0','0'),('9276','Estilo multidía','es','0','0','0'),('9277','Mostrar elemento multidía como una sola columna','es','0','0','0'),('9278','Mostrar elemento multidía como una fila de múltiples columnas','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9279','Si se marca, se mostrarán los elementos que abarquen varios días como una fila de múltiples columnas. Si no se marca, se mostrarán los elementos como una columna individual.','es','0','0','0'),('9280','Estilo de tiempo traslapado','es','0','0','0'),('9281','No mostrar elementos solapados.','es','0','0','0'),('9282','Todo el día','es','0','0','0'),('9283','Número máximo de elementos a mostrar en las celdas del calendario, utilizado para impedir que el calendario se expanda a un tamaño demasiado grande cuando haya muchos elementos en un solo día.','es','0','0','0'),('9291','Navegador de fecha','es','0','0','0'),('9292','Navegación atrás/adelante para adjuntar a otras visualizaciones. Requiere el argumento Date.','es','0','0','0'),('9295','Estilo de navegación de fecha.¡','es','0','0','0'),('9296','Crea navegación atrás/adelante.','es','0','0','0'),('9299','Fecha (!base_table)','es','0','0','0'),('9301','Sin fechar','es','0','0','0'),('9304','todo','es','0','0','0'),('9305','días','es','0','0','0'),('9306','Fecha de Fin','es','0','0','0'),('9307','Ahora','es','0','0','0'),('9308','Fecha de inicio','es','0','0','0'),('9309','Fecha final','es','0','0','0'),('9310','Repetir','es','0','0','0'),('9311','Simple','es','0','0','0'),('9312','Duración','es','0','0','0'),('9313','Semana de @date','es','0','0','0'),('9314','Zona horaria del sitio','es','0','0','0'),('9315','Zona horaria de Date','es','0','0','0'),('9316','Sin conversión de la zona horaria','es','0','0','0'),('9317','Las fechas sin granularidad de horas no deben usar ninguna gestión de zona horaria.','es','0','0','0'),('9318','Tratamiento de zona horaria','es','0','0','0'),('9319','en curso','es','0','0','0'),('9320','Date API','es','0','0','0'),('9321','Limpio','es','0','0','0'),('9322','Intervalo','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9323','Tipo de contenido','es','0','0','0'),('9324','Hace falta una fecha válida para %title.','es','0','0','0'),('9325','El valor por defecto de Srttotime es inválido','es','0','0','0'),('9326','Relativo','es','0','0','0'),('9327','strtotime','es','0','0','0'),('9328','Dentro','es','0','0','0'),('9329','Posición de las partes de la fecha','es','0','0','0'),('9330','Zona horaria del usuario','es','0','0','0'),('9331','Almacenar la fecha en la base de datos como una fecha ISO; recomendado para fechas históricas o parciales.','es','0','0','0'),('9332','Almacenar la fecha en la base de datos como un campo datetime; recomendado para fechas y horas completas que podrían necesitar conversiones horarias.','es','0','0','0'),('9333','!time desde la actualidad','es','0','0','0'),('9334','Calendario emergente','es','0','0','0'),('9335','Hasta','es','0','0','0'),('9336','Date Repeat API','es','0','0','0'),('9337','Formato predeterminado','es','0','0','0'),('9338','Emergente','es','0','0','0'),('9339','Mostrar @count valor(es)','es','0','0','0'),('9340','Rango de años de la fecha','es','0','0','0'),('9341','Formato: @date','es','0','0','0'),('9342','fecha ical','es','0','0','0'),('9343','!timezone','es','0','0','0'),('9344','Las fechas no son válidas.','es','0','0','0'),('9345','Repeticiones','es','0','0','0'),('9346','!repeats_every_interval en el !date_order !day_of_week','es','0','0','0'),('9347','!repeats_every_interval cada !day_of_week','es','0','0','0'),('9348','!repeats_every_interval en los !month_days de !month_names','es','0','0','0'),('9349','!repeats_every_interval en !month_names','es','0','0','0'),('9350','!repeats_every_interval !count veces','es','0','0','0'),('9351','!repeats_every_interval hasta !until_date','es','0','0','0'),('9352','!repeats_every_interval excepto !except_dates','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9353','!repeats_every_interval cuando la semana empieza en !day_of_week','es','0','0','0'),('9354','cada semana','es','0','0','0'),('9355','cada @count semanas','es','9354','1','0'),('9356','cada mes','es','0','0','0'),('9357','cada @count meses','es','9356','1','0'),('9358','cada año','es','0','0','0'),('9359','cada @count años','es','9358','1','0'),('9360','cada día','es','0','0','0'),('9361','cada @count días','es','9360','1','0'),('9362','Campo(s) de fecha','es','0','0','0'),('9363','Método para manejar múltiples campos de fecha en la misma consulta. Devuelve los elementos que tienen cualquier campo de fecha coincidente (fecha = campo_1 Ó campo_2), o solo aquellos que coincidan con todos los campos de fecha seleccionados (fecha = campo_1 Y campo_2).','es','0','0','0'),('9364','Debe seleccionar al menos un campo de fecha para este filtro.','es','0','0','0'),('9365','!Faltan campos de fecha!','es','0','0','0'),('9366','(@field) <strong>Expuesto</strong> @widget @format','es','0','0','0'),('9367','%title no es válido.','es','0','0','0'),('9368','Error de petición HTTP al importar %filename: @error','es','0','0','0'),('9369','Ha fallado la apertura del fichero: %filename','es','0','0','0'),('9370','Fichero de calendario inválido: %filename','es','0','0','0'),('9371','Fichero de calendario inválido.','es','0','0','0'),('9372','Formato de entrada personalizado','es','0','0','0'),('9373','Mostrar regla de repetición','es','0','0','0'),('9374','Ocultar regla de repetición','es','0','0','0'),('9375','Hay errores en el valor de @field_name #@delta:','es','0','0','0'),('9376','Hay errores en @field_name:','es','0','0','0'),('9377','La documentación completa de los módulos Date y Date API está disponible en <a href="@link">http://drupal.org/node/92460</a>.','es','0','0','0'),('9378','Utilice el selector de hora predeterminado de jQuery.','es','0','0','0'),('9379','Excepciones actuales','es','0','0','0'),('9380','Herramientas para la creación e importación de fechas y calendarios.','es','0','0','0'),('9381','Asistente de fecha','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9382','eliminar !view','es','0','0','0'),('9383','¿Seguro que desea eliminar la vista %view?','es','0','0','0'),('9384','Etiqueta de tipo de contenido','es','0','0','0'),('9385','El nombre para los usuarios de este tipo de contenido. Sólo es necesario cuando se crea un nuevo tipo de contenido.','es','0','0','0'),('9386','Un tipo de contenido de fecha que está vinculado con un calendario de vistas.','es','0','0','0'),('9387','Descripción de tipo de contenido','es','0','0','0'),('9388','Una descripción del tipo de contenido. Solo necesario cuando se cree un nuevo tipo de contenido.','es','0','0','0'),('9389','Nombre de campo de fecha','es','0','0','0'),('9390','Nombre legible por máquina. Valores permitidos: (a-z, 0-9, _). No debe coincidir con ningún nombre de un tipo de contenido existente.','es','0','0','0'),('9391','Etiqueta de campo de fecha','es','0','0','0'),('9392','La etiqueta para los usuarios de este campo','es','0','0','0'),('9393','Mostrar opciones de repetición de fecha','es','0','0','0'),('9394','Tipo de campo de fecha','es','0','0','0'),('9395','Crear un calendario para este campo de fecha','es','0','0','0'),('9396','Este nombre de campo ya existe.','es','0','0','0'),('9397','Date Tools','es','0','0','0'),('9398','Eliminar calendario','es','0','0','0'),('9399','Seleccione el tipo de valor de fecha a ser usado por defecto, en resúmenes y navegación. Por ejemplo, una granularidad de mes fijará la fecha actual al mes actual, resumido por mes en las vistas resumen, y enlazado al mes anterior y siguiente cuando se use la navegación de fecha.','es','0','0','0'),('9400','Debe seleccionar al menos un campo de fecha para este argumento.','es','0','0','0'),('9401','Ir al año anterior','es','0','0','0'),('9402','Ir al año siquiente','es','0','0','0'),('9403','Ir al mes anterior','es','0','0','0'),('9404','Ir al mes siguiente','es','0','0','0'),('9405','Ir a la semana anterior','es','0','0','0'),('9406','Ir a la semana siguiente','es','0','0','0'),('9407','Ir al día anterior','es','0','0','0'),('9408','Ir al día siguiente','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9409','Mostrar fecha final','es','0','0','0'),('9410','Valores predeterminados','es','0','0','0'),('9411','Usar los números de la semana de ISO-8601','es','0','0','0'),('9412','¡IMPORTANTE! Si está marcado, el primer día de la semana debe ser lunes.','es','0','0','0'),('9413','Cuando se usan los números de la semana de ISO-8601, se debe establecer el primer día de la semana a lunes.','es','0','0','0'),('9414','Se repite !interval !bymonth !byday !count !until !except. !additional','es','0','0','0'),('9415','Año','es','0','0','0'),('9416','Mes','es','0','0','0'),('9417','Semana','es','0','0','0'),('9418','Día','es','0','0','0'),('9419','Todo el día','es','0','0','0'),('9481','1 minuto','es','0','0','0'),('9482','5 minutos','es','0','0','0'),('9483','10 minutos','es','0','0','0'),('9484','15 minutos','es','0','0','0'),('9485','30 minutos','es','0','0','0'),('9576','Archivo subido.','es','0','0','0'),('9584','falso','es','0','0','0'),('9585','verdadero','es','0','0','0'),('9586','Ninguno/a.','es','0','0','0'),('9587','La importación falló.','es','0','0','0'),('9588','Sin publicar','es','0','0','0'),('9589','clonar','es','0','0','0'),('9590','exportar','es','0','0','0'),('9591','Sobreescribir','es','0','0','0'),('9592','La cantidad de votos que se han realizado en un nodo de encuesta.','es','0','0','0'),('9593','El tiempo de vigencia establecido para la encuesta.','es','0','0','0'),('9594','El tamaño del archivo, en kilobytes.','es','0','0','0'),('9595','la URL de la página de edición de la cuenta.','es','0','0','0'),('9596','Todos los términos padres.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9597','Colocado en la página principal','es','0','0','0'),('9598','Un módulo ofrece esta configuración.','es','0','0','0'),('9599','Página actual','es','0','0','0'),('9600','Manejo de lista','es','0','0','0'),('9601','Mostrar primero (si existe)','es','0','0','0'),('9602','Mostrar cantidad de elementos','es','0','0','0'),('9603','Separador de lista','es','0','0','0'),('9604','Vincular este campo con su entidad','es','0','0','0'),('9605','Añadir @entity_type','es','0','0','0'),('9606','Editar @label','es','0','0','0'),('9607','Importar @entity_type','es','0','0','0'),('9610','Tipo destino','es','0','0','0'),('9611','Dirección de ordenamiento','es','0','0','0'),('9612','Concordancia de autocompletar','es','0','0','0'),('9613','Seleccionar el método para recopilar las sugerencias de autocompletar. Tenga en cuenta que <em>Contiene</em> puede causar problemas de rendimiento en sitios con miles de nodos.','es','0','0','0'),('9614','Campo de ordenamiento','es','0','0','0'),('9624','Campo "@name"','es','0','0','0'),('9634','Es nuevo','es','0','0','0'),('9640','Nodo de origen para la traducción.','es','0','0','0'),('9642','En caso de guardar una nueva revisión, la entrada del registro explica los cambios para esta versión.','es','0','0','0'),('9643','Crea revisión','es','0','0','0'),('9657','Comentarios permitidos','es','0','0','0'),('9660','(No hay información disponible)','es','0','0','0'),('9664','El tipo de entidad que puede ser referenciado a través de este campo.','es','0','0','0'),('9668','Paquetes de destino','es','0','0','0'),('9669','Los paquetes del tipo de entidad que pueden ser referenciados. Dejar en blanco para todos los paquetes','es','0','0','0'),('9670','No ordenar','es','0','0','0'),('9672','Un campo asociado a esta entidad','es','0','0','0'),('9674','@label (columna @column)','es','0','0','0'),('9675','Autocompletado de Refrencia de Entidad','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9676','@entity entidad referenciada de !field_name','es','0','0','0'),('9680','Referenciando entidad','es','0','0','0'),('9694','Ocultar botón de enviar','es','0','0','0'),('9695','Ocultar botón de envío si javascript está activado.','es','0','0','0'),('9722','Haga copia de seguridad de su base de datos Drupal o trasládela rápidamente y sin datos innecesarios.','es','0','0','0'),('9723','Acceder a Backup and Migrate','es','0','0','0'),('9724','Acceder a la sección de administración de Backup and Migrate','es','0','0','0'),('9725','Realizar una copia de seguridad','es','0','0','0'),('9726','Hacer copia de seguridad de cualquiera de las bases de datos disponibles.','es','0','0','0'),('9727','Acceder a los archivos de copia de seguridad','es','0','0','0'),('9728','Acceder y descargar los archivos de copia de seguridad creados previamente.','es','0','0','0'),('9729','Eliminar achivos de copia de seguridad','es','0','0','0'),('9730','Eliminar los archivos de copia de seguridad creados anteriormente.','es','0','0','0'),('9731','Restaurar el sitio','es','0','0','0'),('9732','Restaurar la base de datos del sitio desde un archivo de copia de seguridad.','es','0','0','0'),('9733','Administrar Backup and Migrate','es','0','0','0'),('9734','Editar los perfiles, las planificaciones y los destinos de Backup and Migrate.','es','0','0','0'),('9735','Destinos','es','0','0','0'),('9736','Destino','es','0','0','0'),('9737','Sin Compresión','es','0','0','0'),('9738','GZip','es','0','0','0'),('9739','BZip','es','0','0','0'),('9740','Zip','es','0','0','0'),('9741','Configuración del file system','es','0','0','0'),('9742','Guardar los archivos de copia de serguridad en un directorio del servidor en el que el servidor web puede escribir.','es','0','0','0'),('9743','Directorio del servidor','es','0','0','0'),('9744','Base de datos','es','0','0','0'),('9745','Importar la copia de seguridad directamente en otra base de datos. Los destinos de la base de datos también pueden ser usados como origen.','es','0','0','0'),('9746','Base de datos MySQL','es','0','0','0'),('9747','Importar la base de datos directamente en otra base de datos MySQL. Los destinos de base de datos pueden usarse también como fuente para hacer copias de seguridad.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9748','Guardar los archivos en un directorio de un servidor FTP.','es','0','0','0'),('9749','Directorio FTP','es','0','0','0'),('9750','Cuenta Amazon S3','es','0','0','0'),('9751','Guardar los archivos de copia de seguridad en un espacio en su !link.','es','0','0','0'),('9753','Enviar la copia de seguridad como archivo adjunto en un correo a las direcciones de correo electrónico especificadas.','es','0','0','0'),('9754','Directorio de copias de seguridad manuales','es','0','0','0'),('9755','Directorio de copias de seguridad programadas','es','0','0','0'),('9756','Base de datos predeterminada','es','0','0','0'),('9757','Perfil sin nombre','es','0','0','0'),('9758','Tarea programada sin nombre','es','0','0','0'),('9759','Tareas programadas','es','0','0','0'),('9760','Planificación','es','0','0','0'),('9761','restaurar característica','es','0','0','0'),('9762','"Backup and Migrate" simplifica las tareas de salvaguardado y migración de sus bases de datos Drupal. Proporciona una función para salvaguardar la base de datos completa a un fichero o descargarla, asi como de restaurar desde una copia de seguridad anterior. Puede también programar las operaciones de copia de seguridad. Ofrece soporte para la compresión de las mismas.\r\nPueden ser importadas en esta u otra instalación de Drupal usando con !restorelink, o bien puede usar una herramienta de bases de datos como  <a href="!phpmyadminurl">phpMyAdmin</a> o incluso desde la línea de comandos de mysql.','es','0','0','0'),('9763','Pestaña de Copia de Seguridad Rápida','es','0','0','0'),('9764','página de ayuda','es','0','0','0'),('9765','Use este formulario para realizar copias de seguridad sencillas de su base de datos en forma manual. Visite la !helppage para más ayuda en el uso de este módulo','es','0','0','0'),('9766','Pestaña de copia de seguridad avanzada','es','0','0','0'),('9767','perfiles de configuración','es','0','0','0'),('9768','Utilice este formulario para ejecutar copias de seguridad manuales de su base de datos con opciones más avanzadas. Si tiene algún !profilelink guardado puede cargar sus parámetros. Puede guardar cualquiera de los cambios que haga a estas parámetros como un nuevo perfil.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9769','Restaurar Pestaña','es','0','0','0'),('9770','Subir una copia de seguridad generada con Backup and Migrate. La función de restauración no funcionará con archivos de copia de seguridad de otras fuentes como ser phpMyAdmin.','es','0','0','0'),('9771','Los destinos son las ubicaciones donde puede guardar sus archivos de copias de seguridad o desde donde puede recuperarlas/restaurarlas.','es','0','0','0'),('9772','Los archivos pueden ser almacenados en un directorio en su servidor web, descargados a su escritorio o enviados por correo electrónico a su cuenta de correo. Desde la pestaña Destinos usted puede crear, borrar o editar los destinos o listar los archivos que ya han sido copiados en los destinos disponibles.','es','0','0','0'),('9773','tareas programadas','es','0','0','0'),('9774','copias de seguridad manuales','es','0','0','0'),('9775','Los perfiles son configuraciones de copia de seguridad guardadas. Los perfiles almacenan sus opciones de exclusión de tablas así como el nombre del archivo de copia de seguridad, la compresión y las opciones del sello temporal. Usted puede utilizar perfiles tanto en !schedulelink como para realizar !manuallink.','es','0','0','0'),('9776','Puede crear nuevos perfiles usando la pestaña de agregar perfiles o marcando la opción "Guardar esta configuración" en la página de copia de seguridad avanzada.','es','0','0','0'),('9777','Planificación','es','0','0','0'),('9778','Hacer periódicamente una copia de seguridad automática de su base de datos utilizando <a href="!cronurl">cron</a>','es','0','0','0'),('9779','Cada tarea programada se ejecutará un máximo de una vez por cada ejecución del cron, por lo que no se ejecutará con mayor frecuencia que la establecida para cron. Si se especifica un número de copias de seguridad a mantener, las copias de seguridad antiguas se borrarán a medida que las nuevas sean creadas. <strong>Si se especifica un número de archivos para conservar, los otros archivos de copia de seguridad en el destino de esa tarea programada serán borrados</strong>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9780','Backup and Migrate','es','0','0','0'),('9781','Copie o restaure su base de datos y traslade los datos a o desde otro sitio Drupal.','es','0','0','0'),('9782','Copia de seguridad rápida','es','0','0','0'),('9784','Origen de la copia de seguridad','es','0','0','0'),('9785','Opciones por defecto','es','0','0','0'),('9786','Opciones del perfil','es','0','0','0'),('9787','Hacer copia de seguridad ahora','es','0','0','0'),('9788','Para más opciones de copia de seguridad, visite <a href="!advancedurl">página de copia de seguridad avanzada</a>.','es','0','0','0'),('9789','Copia de seguridad','es','0','0','0'),('9790','Hacer copia de seguridad de la base de datos.','es','0','0','0'),('9792','Copia de seguridad avanzada','es','0','0','0'),('9793','Lista de !type','es','0','0','0'),('9794','Restaurar','es','0','0','0'),('9795','Restaurar la base de datos de una copia de seguridad previa','es','0','0','0'),('9797','Copia de seguridad de !from a !to utilizando !profile !submit','es','0','0','0'),('9798','sobrescribir','es','0','0','0'),('9799','listar archivos','es','0','0','0'),('9800','descargar','es','0','0','0'),('9801','restaurar','es','0','0','0'),('9817','Ranura','es','0','0','0'),('9840','Grupo de campos','es','0','0','0'),('9862','Adicionar nuevo grupo.','es','0','0','0'),('9864','Nombre del grupo (a-z, 0-9, _)','es','0','0','0'),('9865','Grupos de campos','es','0','0','0'),('9870','Etiqueta de grupo de campos','es','0','0','0'),('9873','Clases CSS extra','es','0','0','0'),('9889','Control de mensajes basura','es','0','0','0'),('9901','registro','es','0','0','0'),('9924','Configurar los editores del lado del cliente.','es','0','0','0'),('9925','Sin editor','es','0','0','0');
INSERT INTO `locales_target` VALUES ('9926','<a href="!vendor-url">@editor</a> (<a href="!download-url">Descargar</a>)','es','0','0','0'),('9927','No instalado.','es','0','0','0'),('9928','Extraiga el archivo y copie su contenido dentro de una nueva carpeta en la siguiente ubicación:<br /><code>@editor-path</code>','es','0','0','0'),('9930','Instrucciones de instalación','es','0','0','0'),('9931','Actualmente no hay librerías de editor instaladas. Esta es una lista de los editores admitidos en este momento.','es','0','0','0'),('9932','Un perfil Wysiwyg se asocia con un formato de texto. Un perfil Wysiwyg define qué editor se muestra para un formato de texto concreto, qué botones o temas están habilitados para el editor, cómo se muestra y algunas otras funciones específicas del editor.','es','0','0','0'),('9933','Para asignar un editor distinto a un formato de texto, haga clic en "eliminar" para quitar primero el existente.','es','0','0','0'),('9934','Formato de entrada','es','0','0','0'),('9936','Opciones básicas','es','0','0','0'),('9937','Activado de forma prestablecida','es','0','0','0'),('9938','El estado predeterminado del editor para los usuarios que tengan acceso a este perfil. Los usuarios pueden sobrescribir este estado si se habilita la siguiente opción.','es','0','0','0'),('9939','Permitir a los usuarios elegir el editor predefinido','es','0','0','0'),('9940','Si se permite, los usuarios podrán elegir su propio editor predeterminado en las opciones de sus cuentas de usuario.','es','0','0','0'),('9941','Mostrar enlace alternador de <em>activar/desactivar texto con formato</em>','es','0','0','0'),('9942','Determina si se muestra el enlace alternador de <em>activar/desactivar texto con formato</em> debajo de una área de texto. Si se deshabilita, se utiliza la configuración de usuario o el valor predeterminado global (ver arriba).','es','0','0','0'),('9943','Idioma de la interfaz','es','0','0','0'),('9944','Botones y extensiones','es','0','0','0'),('9945','Tachado','es','0','0','0'),('9946','Alinear a la izquierda','es','0','0','0'),('9947','Centrado','es','0','0','0');
