INSERT INTO `locales_target` VALUES ('3739','la fecha en la que se creó la cuenta de usuario.','es','0','0','0'),('3740','Su OpenID','es','0','0','0'),('3741','Este OpenID se adjuntará a su cuenta tras el proceso de registro.','es','0','0','0'),('3742','Contenido de la página principal','es','0','0','0'),('3743','No está autorizado para acceder a esta página.','es','0','0','0'),('3744','Autorizar cambios en el sistema de archivos','es','0','0','0'),('3745','Parece que ha llegado a esta página por error.','es','0','0','0'),('3746','authorize.php','es','0','0','0'),('3747','Cron no pudo ejecutarse porque se utilizó una clave inválida','es','0','0','0'),('3748','Cron no se pudo ejecutar porque el sitio está desconectado en modo de mantenimiento.','es','0','0','0'),('3749','País predefinido','es','0','0','0'),('3750','Compobar los mensajes de error y <a href="!url">continuar con la instalación</a>.','es','0','0','0'),('3751','En su archivo %settings_file file ha configurado @drupal para que use un servidor %driver. Sin embargo, su instalación PHP actualmente no admite este tipo de base de datos.','es','0','0','0'),('3752','Disculpe, debe elegir un idioma para continuar la instalación.','es','0','0','0'),('3753','No se pudo encontrar ningún perfil de instalación. Los perfiles de instalación informan de qué módulos activar y qué esquema de basos instalar. Hace falta in perfil para proseguir con el perfil de instalación.','es','0','0','0'),('3754','Lo sentimos, el perfil que ha elegido no se puede cargar.','es','0','0','0'),('3755','Se han hecho todos los cambios necesarios en %dir y %file, por lo que debería eliminar los permisos de escritura que tengan para evitar riesgos de seguridad. Si no está seguro de cómo hacerlo, consulte el <a href="@handbook_url">manual en pantalla</a>.','es','0','0','0'),('3756','¡Felicidades! Usted ha instalado Drupal.','es','0','0','0'),('3757','Revise los mensajes anteriores antes de visitar <a href="@url">su nuevo sitio</a>.','es','0','0','0'),('3758','<a href="@url">Visite su nuevo sitio</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3759','Archivo de configuración','es','0','0','0'),('3760','El archivo de configuración no existe.','es','0','0','0'),('3761','El instalador de @drupal requiere que usted cree un archivo de configuración como parte del proceso de instalación. Copie el archivo %default_file a %file. Más detalles sobre la instalación de Drupal están disponibles en <a href="@install_txt">INSTALL.txt</a>.','es','0','0','0'),('3762','El archivo %file ya existe.','es','0','0','0'),('3763','No se puede escribir en el archivo de configuración.','es','0','0','0'),('3764','El instalador de @drupal necesita permisos de escritura en %file durante el proceso de instalación. Si no estás seguro  de cómo otorgar permisos, consulta el <a href="@handbook_url">manual en pantalla</a>.','es','0','0','0'),('3765','Los correos electrónicos automáticos, como la información de registro, se enviarán desde esta dirección de correo. Use una dirección que tenga como terminación el dominio de su sitio para evitar que estos correos sean considerados spam.','es','0','0','0'),('3766','Cuenta de mantenimiento del sitio','es','0','0','0'),('3767','Elija el país predeterminado del sitio.','es','0','0','0'),('3768','Recibir avisos por correo electrónico','es','0','0','0'),('3769','El sistema le avisará cuando haya actualizaciones de seguridad e importantes para los componentes instalados. Se envía información anónima a <a href="@drupal">Drupal.org</a>.','es','0','0','0'),('3770','No hay actualizaciones pendientes.','es','0','0','0'),('3771','1 actualización pendiente','es','0','0','0'),('3772','@count actualizaciones pendientes','es','3771','1','0'),('3773','Un error ha ocurrido mientras se procesaba la solicitud: El servidor ha recibido una entrada inválida.','es','0','0','0'),('3774','Datos POST de formulario no válidos.','es','0','0','0'),('3775','No se puede proseguir. No hay disponibles métodos de transferencia de archivos.','es','0','0','0'),('3776','ADVERTENCIA: No está usando una conexión encriptada, su clave será enviada en texto sin formato. <a href="@https-link">Saber más</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3777','Para continuar, indique los detalles de conexión de su servidor','es','0','0','0'),('3778','Método de conexión','es','0','0','0'),('3779','Escriba la configuración de conexión','es','0','0','0'),('3780','Configuración de conexión de @backend','es','0','0','0'),('3781','Cambiar tipo de conexión','es','0','0','0'),('3782','Error. Este tipo de protocolo de conexión (%backend) no existe.','es','0','0','0'),('3783','No hay lote activo.','es','0','0','0'),('3784','Sitio desconectado en mantenimiento','es','0','0','0'),('3785','Los archivadores sólo pueden operar con archivos locales: %file no admitido.','es','0','0','0'),('3786','El archivo no se pudo subir debido a que el destino %destination no es válido.','es','0','0','0'),('3787','El archivo %source no se pudo subir porque un documento con ese nombre ya existe en la ubicación de destino %directory.','es','0','0','0'),('3788','El nombre de archivo excede el límite de 240 caracteres. Renombrelo y vuelva a probar, por favor.','es','0','0','0'),('3789','%path es un directorio y no se puede eleminar usando file_unmanaged_delete().','es','0','0','0'),('3790','El archivo %path no es de un tipo reconocido por lo que no fue eliminado.','es','0','0','0'),('3791','No se pudieron establecer los permisos en %uri.','es','0','0','0'),('3792','Se completaron @current de @total.','es','0','0','0'),('3793','No se pudieron ejecutar todas las tareas en la base de datos del servidor. La tarea %task no se encontró.','es','0','0','0'),('3794','No se pudo modificar %settings. Compruebe los permisos del archivo.','es','0','0','0'),('3795','No se pudo abrir %settings. Compruebe los permisos del archivo.','es','0','0','0'),('3796','Módulos necesarios','es','0','0','0'),('3797','Módulos necesarios no encontrados.','es','0','0','0'),('3798','Los módulos siguientes son necesarios pero no se encontraron. Trasládelos al subdirectorio apropiado para los módulos, como <em>sites/all/modules</em>. Módulos que faltan: !modules','es','0','0','0'),('3799','sistema','es','0','0','0'),('3800','Módulo %module desinstalado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3801','San Bartolomé','es','0','0','0'),('3802','San Martín (parte francesa)','es','0','0','0'),('3803','Usar el idioma predeterminado del sitio (@language_name).','es','0','0','0'),('3804','El archivo de traducción %filepath contiene un error: La fórmula de plural no se pudo interpretar.','es','0','0','0'),('3805','No hay textos disponibles.','es','0','0','0'),('3806','@count fragmentos HTML no permitidos en %file.','es','0','0','0'),('3807','El archivo de traducción JavaScript %file.js se ha perdido.','es','0','0','0'),('3808','No se pudo enviar el correo electrónico. Contacte con la administración del sitio si persiste el problema.','es','0','0','0'),('3809','La clase %class no implementa la interfaz %interface','es','0','0','0'),('3810','Funcionando en modo de mantenimiento. <a href="@url">Volver en línea.</a>','es','0','0','0'),('3811','Funcionando en modo de mantenimiento.','es','0','0','0'),('3812','módulo %module activado.','es','0','0','0'),('3813','módulo %module desactivado.','es','0','0','0'),('3814','Mensaje de estado','es','0','0','0'),('3815','Suscribirse a @feed-title','es','0','0','0'),('3816','Clave del tema "@key" no encontrada.','es','0','0','0'),('3817','Imposible determinar el tipo de directorio de origen.','es','0','0','0'),('3818','No se pudo determinar el tipo de proyecto.','es','0','0','0'),('3819','Error irrecuperable al actualizar. El sistema se niega cobardemente a eliminar el directorio de instalación.','es','0','0','0'),('3820','La transferencia de archivos falló. Causa: !reason.','es','0','0','0'),('3821','No se pudo crear %directory debido a: %reason','es','0','0','0'),('3822','Drupal no se pudo configurar correctamente con la base de datos existente. Revise cualquier error.','es','0','0','0'),('3823','Ninguna fuente disponible. <a href="@link">Agregar fuente</a>.','es','0','0','0'),('3824','No hay categorías disponibles. <a href="@link">Añadir categoría</a>.','es','0','0','0'),('3825','El lapso entre actualizaciones de las fuentes. Es necesario que la <a href="@cron">tarea de mantenimiento cron</a> esté correctamente configurada.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3826','Elementos de noticias en bloque','es','0','0','0'),('3827','Drupal puede crear un bloque con las noticias mas recientes de este canal. Puede <a href="@block-admin">configurar los bloques</a> para mostrarlos en la barra lateral de su página. Estas opciones le permiten configurar el número de artículos de noticias a mostrar en este bloque de canal. Si selecciona ''0'', este bloque de canal de noticias quedará desactivado.','es','0','0','0'),('3828','La URL %url no es válida. Escriba una URL válida, tal como http://www.ejemplo.com/feed.xml.','es','0','0','0'),('3829','Un canal de noticias llamado %feed ya existe. Escriba un nombre único.','es','0','0','0'),('3830','Una fuente con esta URL %url ya existe. Especifique una URL única.','es','0','0','0'),('3831','Suba un archivo OPML que contenga el listado de las fuentes a ser importadas.','es','0','0','0'),('3832','URL remota del OPML','es','0','0','0'),('3833','Indique la URL de un archivo OPML. Este archivo se descargará y procesará sólo una vez al enviar el formulario.','es','0','0','0'),('3834','Drupal puede hacer un bloque con los elementos de un canal de noticias más reciente. Puede <a href="@block-admin">configurar los bloques</a> para que se muestren en el la zona lateral de su página. Esta opción le permite configurar la cantidad de elementos que se deben mostrar en un bloque de canal de noticias. Si elije ''0'', estos bloques de canales quedarán desactivados.','es','0','0','0'),('3835','Debe subir un archivo o indicar una URL.','es','0','0','0'),('3836','Esta URL no es válida.','es','0','0','0'),('3837','No se ha añadido ningún canal de noticias.','es','0','0','0'),('3838','La URL %url no es válida.','es','0','0','0'),('3839','Un canal de noticias llamado %title ya existe.','es','0','0','0'),('3840','Ya existe un canal con la URL %url.','es','0','0','0'),('3841','Los recuperadores descargan información de una fuente externa. Elija un recuperador adecuado para la fuente externa de la cual desea descargar.','es','0','0','0'),('3842','Los intérpretes transforman los datos descargados en estructuras estándar. Elija uno adecuado para el tipo de canales de noticias que le gustaría agregar.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3843','Los procesadores actuan sobre datos de canales de noticias interpretados; por ejemplo, almacenando elementos de canal. Elija los procesadores adecuados para su tarea.','es','0','0','0'),('3844','Para la mayoría de las tareas de agregación, la configuración predeterminada es suficiente.','es','0','0','0'),('3845','Una categoría llamada %category ya existe. Escriba un título único.','es','0','0','0'),('3846','Recuperador predeterminado','es','0','0','0'),('3847','Descarga datos de una URL usando el manejador de peticiones HTTP de Drupal.','es','0','0','0'),('3848','Intérprete predeterminado','es','0','0','0'),('3849','Interpreta canales de noticias RSS, Atom y RDF.','es','0','0','0'),('3850','Procesador predeterminado','es','0','0','0'),('3851','Crea registros de poco peso a partir de elementos de canales de noticias.','es','0','0','0'),('3852','Opciones del procesador predeterminado','es','0','0','0'),('3853','Número de elementos que se muestran en las páginas de listados','es','0','0','0'),('3854','Requiere una correcta configuración de la<a href="@cron">tarea de mantenimiento cron</a>.','es','0','0','0'),('3855','Seleccionar categorías usando','es','0','0','0'),('3856','Para un número reducido de categorías, las casillas de selección son más fáciles de usar, mientras que un selector múltiple funciona bien con categorías cuando hay muchas categorías.','es','0','0','0'),('3857','Longitud de la descripción recortada','es','0','0','0'),('3858','El número máximo de caracteres que se debe usar en la versión recortada del contenido.','es','0','0','0'),('3859','El módulo Agregador es un sindicador y lector de noticias en su propio sitio web que recupera y muestra contenido reciente de canales de noticias basados en RSS, RDF y Atom disponibles a lo largo y ancho de toda la web. Miles de sitios (en especial sitios de noticias y blogs) publican sus últimos titulares en canales, usando algunos formatos XML estandarizados. Para más información, vea la entrada del manual en pantalla del <a href="@aggregator-module">módulo Agregador</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3860','Viendo canales de noticias','es','0','0','0'),('3861','Las fuentes contienen contenido publicado y puede ser agrupado en categorías, usualmente por tema. Los usuarios ven el contenido de la fuente en la <a href="@aggregator">pantalla principal de agregación</a>, o mediante <a href="@aggregator-sources">su fuente</a> (generalmente mediante un lector de fuentes RSS). El contenido más reciente de una fuente o categoría puede mostrarse como un bloque a través de la <a href="@admin-block">página de administración de bloques</a>.','es','0','0','0'),('3862','Añadiendo, editando y eliminando canales de noticias','es','0','0','0'),('3863','Los administradores pueden añadir, editar y eliminar canales de noticias, y decidir con qué frecuencia comprobar cada uno de ellos en búsqueda de nuevos elementos en la <a href="@feededit">página de administración del agregador de canales de noticias</a>.','es','0','0','0'),('3864','Integración OPML','es','0','0','0'),('3865','Un <a href="@aggregator-opml">archivo OPML para el sistema</a> de todos los canales disponibles. OPML es un archivo con formato basado en XML usado para compartir información en esquemas estructurados como una lista de canales RSS. Los canales también pueden ser <a href="@import-opml">importados a través de un archivo OPML</a>.','es','0','0','0'),('3866','Configurando cron','es','0','0','0'),('3867','Hace falta una <a href="@cron">tarea de mantenimiento cron</a> correctamente configurada para actualizar los canales de noticias automáticamente.','es','0','0','0'),('3868','<acronym title="Outline Processor Markup Language">OPML</acronym> és un formato XML utilizado para intercambiar múltiples canales entre agregadores. Un simple documento OPML puede contener una colección de muchos canales. Drupal puede analizar el fichero e importar todos los canales de una sola vez, ahorrándote el trabajo de añadirlos manualmente. Puedes cargar un fichero local de tu ordenador o introducir una URL desde donde  Drupal puede descargarlo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3869','Administrar canales de noticias','es','0','0','0'),('3870','Acceder a canales de noticias','es','0','0','0'),('3871','Configurar comportamiento del agregador de noticias, incluyendo cuando descartar elementos de esos canales y como presentar los elementos y categorías de los canales de noticias.','es','0','0','0'),('3872','Sobrescribir el título predeterminado del bloque. Use <em>!placeholder</em> para no mostrar título o déjelo en blanco para usar el título predefinido del bloque.','es','0','0','0'),('3873','Especificar en qué temas y regiones se muestra este bloque.','es','0','0','0'),('3874','Todas las páginas excepto las que se enumeran','es','0','0','0'),('3875','Sólo las páginas enumeradas','es','0','0','0'),('3876','Especificar páginas usando sus rutas. Escriba una ruta por línea. El carácter ''*'' se usa como comodín. Ejemplos de rutas son %blog para la página de blog y %blog-wildcard  para cada blog personal. %front es la página principal.','es','0','0','0'),('3877','Páginas en las que este código PHP devuelva <code>Verdadero</code> (sólo para expertos)','es','0','0','0'),('3878','Páginas o código PHP','es','0','0','0'),('3879','Si se elige la opción PHP, escribar el código PHP ebtre %php. Tenga en cuenta que la ejecución de código PHP incorrecto puede inutilizar su sitio Drupal.','es','0','0','0'),('3880','Personalizable por usuario','es','0','0','0'),('3881','No personalizable','es','0','0','0'),('3882','Personalizable, visible de forma predeterminada','es','0','0','0'),('3883','Personalizable, oculto de forma predeterminada','es','0','0','0'),('3884','Asegúrese de que cada descripción de bloque es única.','es','0','0','0'),('3885','El módulo Bloques (Blocks) le permite crear cajas de contenido que se muestran en un área o región de una o más páginas de un sitio web. El tema de administración Seven, que viene con el núcleo, incluye las regiones "contenido", "Ayuda", "Panel de control principal" y "Lateral del Panel de control", por lo que un bloque puede aparecer en cualquiera de ellas. La <a href="@blocks">página de administración de bloques</a> proporciona una interfaz de arrastrar y soltar para asignar un bloque a una región y para controlar el orden de los bloques dentro de las regiones. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@block">módulo Bloques</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3886','Posicionando contenido','es','0','0','0'),('3887','Al trabajar con bloques, recuerde que <em>no</em> todos los temas tienen las mismas regiones <em>ni</em> las muestran del mismo modo. Los bloques se colocan dependiendo de cada tema. Los usuarios con permiso para <em>administrar bloques</em> pueden desactivar bloques. Los bloques desactivados se enumeran en la <a href="@blocks">página de administración de bloques</a> pero no se muestran en ninguna región.','es','0','0','0'),('3888','Controlando visibilidad','es','0','0','0'),('3889','Los bloques se pueden configurar para que sean visibles sólo en algunas páginas, para usuarios con roles determinados o en páginas que tengan <a href="@content-type">tipos de contenido</a> específicos. Los administradores pueden permitir a los usuarios activar o desactivar algunos bloques al editar su página <a href="@user">"Mi cuenta"</a>. Algunos bloques dinámicos, como los creados por los módulos, sólo se muestran en algunas páginas.','es','0','0','0'),('3890','Creando bloques personalizados','es','0','0','0'),('3891','Los usuarios con permisos para <em>administrar bloques</em> pueden <a href="@block-add">agregar los bloques personalizados</a> listados en la <a href="@blocks">página de administración de bloques</a>. Tras su creación, los bloques personalizados se comportan exactamente igual que los módulos predeterminados y los creados por los módulos.','es','0','0','0'),('3892','Esta página proporciona una interfaz de arrastrar y soltar para asignar un bloque a una región y controlar el orden de los bloques dentro de las regiones. Como no todos los textos ponen en práctica las mismas regiones, los bloques se ubican dependiendo del tema. Recuerde que los cambios que haga no se registrarán hasta que pulse el botón <em>Guardar Bloques</em> en la zona inferior de la página. Pulse el enlace <em>configurar</em> al lado de cada bloque para especificar sus opciones de visibilidad y su título.','es','0','0','0'),('3893','Demostrar regiones de bloques (@theme)','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3894','Administrar bloques','es','0','0','0'),('3895','Una breve descripción de su bloque. Se usa en la <a href="@overview">página de administración de bloques</a>.','es','0','0','0'),('3896','Personalizar bloques','es','0','0','0'),('3897','Los bloques son contenido o información que complementa el contenido principal de la página. Active o desactive bloques opcionales usando las casillas a continuación.','es','0','0','0'),('3898','Caché de bloques','es','0','0','0'),('3899','La caché de bloques está inactiva porque ha activado módulos que definen restricciones de acceso al contenido.','es','0','0','0'),('3900','Controla el montaje visual de los bloques con los que se construye una página. Los bloques son cajas de contenido que se representan en una zona o región de una página web.','es','0','0','0'),('3901','Restringido a algunas páginas','es','0','0','0'),('3902','El bloque no se puede colocar en esta región.','es','0','0','0'),('3903','Úselo para blogs multi-usuarios. Cada usuario obtiene un blog personal.','es','0','0','0'),('3904','Blogs de un solo usuario','es','0','0','0'),('3905','Cada una de las entradas del blog del usuario se muestra automáticamente con un enlace a la página principal de ese blog. Puede crear tantos blogs de un sólo usuario como usuarios con permiso para crear contenido de blog tenga en su sitio.','es','0','0','0'),('3906','Blogs multi usuario','es','0','0','0'),('3907','Las entradas de blog de cada usuario se agregan también a un blog central multi usuario, que muestra el contenido de todos los usuarios en una única lista.','es','0','0','0'),('3908','Existe un elemento de menú opcional <em>Blogs</em> en la zona Navegación que muestra todos los blogs disponibles en su sitio. y un elemento <em>Mi Blogv</em> que muestra las entradas del blog del usuario actualmente identificado.','es','0','0','0'),('3909','El módulo Blog también crea un bloque predeterminado <em>Envíos recientes a blogs</em> que se puede activar en la <a href="@blocks">página de administración de bloques</a>','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3910','Crear nueva entrada de blog','es','0','0','0'),('3911','Activa los blogs multi usuario.','es','0','0','0'),('3912','No hay libros disponibles.','es','0','0','0'),('3913','Tipos de contenido permitidos en índices de libros','es','0','0','0'),('3914','Los usuarios con el permiso %outline-perm pueden añadir todos los tipos de contenido.','es','0','0','0'),('3915','Administrar índices de libros','es','0','0','0'),('3916','El módulo de libro se usa para crear contenido estructurado y multi página, como guías de recursos de un sitio, manuales o wikis. Le permite crear contenido con capítulos, secciones y subsecciones, o cualquier otro tipo de estructura jerarquizada. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@block">módulo Libro</a>.','es','0','0','0'),('3917','Añadiendo y administrando el contenido del libro','es','0','0','0'),('3918','Puede asignar diferentes permisos para <em>crear</em>, <em>editar</em> y <em>eliminar</em> contenido de los libros, además de <em>añadir contenido a libros</em>, y <em>crear nuevos libros</em>. Usuarios con el permiso <em>Administrar estructura de libros</em> pueden añadir<em>cualquier</em> contenido a un libro seleccionando la ubicación apropiada del libro cuando editan el contenido. También podrán ver un listado de todos los libros, y editar y reordenar los títulos de sección en la <a href="@admin-book">Página de administración de libros</a>.','es','0','0','0'),('3919','Las páginas de libros tienen un bloque de navegación por libro predeterminado. Este bloque de navegación contiene enlaces que llevan a las páginas anterior y siguiente del libro, y al nivel superior de la estructura del libro. Este bloque se puede activar en la <a href=''@admin-block''>página de administración de bloques</a>. Para que las páginas se muestren en la navegación del libro, deben añadirse al esquema o índice del libro.','es','0','0','0'),('3920','Los libros se pueden crear entre varias personas ya que permiten a los usuarios con permisos adecuados añadir páginas a los libros existentes y añadir esas páginas a un menú de índice personalizado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3921','Imprimiendo libros','es','0','0','0'),('3922','Usuarios con permiso para <em>Ver libros en versión de impresión</em> pueden seleccionar el link de <em>versión de impresión</em> visible al final del contenido de cada página de un libro para generar una vista apropiada para impresión de la página y todas sus sub-secciones.','es','0','0','0'),('3923','El módulo Libro ofrece un método para organizar un grupo de páginas con contenido relacionado en un conjunto que se denomina ''libro''. Al acceder a él, este contenido muestra de forma automática enlaces a las páginas contiguas del libro, lo que proporciona un sistema de navegación sencillo para crear y revisar contenidos estructurados.','es','0','0','0'),('3924','La opción de índice permite incluir páginas en la <a href="@book">jerarquía del libro</a>, recolocarlas dentro de ella o <a href="@book-admin">reordenar un libro por completo</a>.','es','0','0','0'),('3925','Crear nuevos libros','es','0','0','0'),('3926','Añadir contenido y páginas hijas a los libros','es','0','0','0'),('3927','Ver versiones para imprimir de libros','es','0','0','0'),('3928','Ver una página de un libro y todas sus páginas subordinadas como un único documento para facilitar su impresión. Puede afectar al rendimiento.','es','0','0','0'),('3929','<em>Los libros</em> tienen una navegación interna jerarquizada. Úselos para cosas como manuales o tutoriales.','es','0','0','0'),('3930','Permite a los usuarios crear y organizar los contenidos relacionados en un índice.','es','0','0','0'),('3931','El módulo Color permite a los usuarios con permiso para <em>administrar la configuración del sitio </em> cambiar de forma rápida y sencilla los esquemas de color de los temas gráficos compatibles con él. Para más información, consultes las páginas del manual en pantalla sobre el <a href="@color">Módulo color</a>.','es','0','0','0'),('3932','Cambiando colores','es','0','0','0'),('3933','Usar el módulo Color le permite cambiar fácilmente el color de los enlaces, fondos, textos y otros elementos del tema. Para cambiar los colores de un tema compatible, pulse el enlace de <em>Configuración</em> de ese tema en la <a href=''@configure''>Página de administración del tema</a>. Si no ve un selector de colores en esa página es porque su tema no es compatible con el módulo Color. Si está seguro de que el tema es compatible con el módulo Color, pero ese selector no aparece, entonces siga estos <a href=''@troubleshoot''>procedimientos de solución de problemas</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3934','El módulo Color guarda una copia modificada de las hojas de estilo especificadas por el tema en el directorio de archivos (files). Esto quiere decir que si hace cualquier cambio manual en las hojas de estilo del tema <em>debe guardar de nuevo la configuración de color incluso aunque no la haya altrado.</em> Este paso es necesario para que las hojas de estilo del módulo (dentro del directorio de archivos) deben reconstruirse para incluir esos cambios.','es','0','0','0'),('3935','La biblioteca GD para PHP está activa pero se compiló sin funcionalidad PNG. Consulte la <a href="@url">documentación sobre imágenes en PHP</a> para saber cómo corregirlo.','es','0','0','0'),('3936','La biblioteca GD para PHP falta o está caducada. Compruebe la <a href="@url">documentación de imagen PHP</a> para más información sobre cómo corregir esto.','es','0','0','0'),('3937','Permite a los administradores cambiar el esquema de color de los temas compatibles con él..','es','0','0','0'),('3938','Seleccione uno o más comentarios para actualizarlos.','es','0','0','0'),('3939','No parece haber comentarios para eliminar o el comentario que seleccionó ya ha sido borrado por otro administrador.','es','0','0','0'),('3940','Borrados @count comentarios.','es','5552','1','0'),('3941','Eliminado el comentario @cid y sus respuestas.','es','0','0','0'),('3942','Comentario aprobado.','es','0','0','0'),('3943','Comodines para los comentarios enviados al sitio.','es','0','0','0'),('3944','El módulo Comentario (Comment) permite a los usuarios comentar el contenido de un sitio, establecer los permisos y valores predeterminados y la moderación de comentarios. Para más información, consulte las páginas del manual sobre el <a href="@comment">módulo Comentario</a>.','es','0','0','0'),('3945','Opciones predeterminadas y personalizadas','es','0','0','0'),('3946','Cada <a href=''@content-type''>tipo de contenido</a> puede tener su propia configuración predeterminada de comentarios como: <em>Abierto</em> para permitir nuevos comentarios, <em>Oculto</em> para ocultar los comentarios existentes y no permitir nuevos o <em>Cerrado</em> para ver los comentarios existentes pero no permitir nuevos. Esta configuración predeterminada se aplicará a todos los nuevos contenidos creados (los cambios de configuración de contenidos ya existentes tendrán que hacerse manualmente). Otros ajustes de comentarios también pueden ser personalizados según el tipo de contenido, y pueden ser reemplazados en cualquier elemento de contenido específico. Cuando un comentario no tiene respuestas, se mantiene editable por su autor, siempre que el autor tenga cuenta de usuario y haya iniciado una sesión.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3947','Comentario completo','es','0','0','0'),('3948','Comentarios sin aprobar (@count)','es','0','0','0'),('3949','Administrar comentarios y opciones de comentarios','es','0','0','0'),('3950','Editar comentarios propios','es','0','0','0'),('3951','Cantidad de comentarios recientes','es','0','0','0'),('3952','Hilos de comentarios','es','0','0','0'),('3953','Mostrar las respuestas a los comentarios en una lista de hilos.','es','0','0','0'),('3954','Opción predeterminada de comentarios para el nuevo contenido','es','0','0','0'),('3955','Permitir título de comentario','es','0','0','0'),('3956','Mostrar el formulario de respuesta en la misma página que los comentarios','es','0','0','0'),('3957','Los usuarios con el permiso "Enviar comentarios" pueden comentar.','es','0','0','0'),('3958','Los usuarios no pueden comentar pero se mostrarán los comentarios existentes.','es','0','0','0'),('3959','Los comentarios están ocultos a la vista.','es','0','0','0'),('3960','Los usuarios no pueden publicar comentarios.','es','0','0','0'),('3961','Su comentario ha pasado a la lista de pendientes de revisión de los administradores del sitio y se publicará tras su aprobación.','es','0','0','0'),('3962','Su comentario ha sido enviado.','es','0','0','0'),('3963','<a href="@login">Inicie sesión</a> o <a href="@register">regístrese</a> para comentar','es','0','0','0'),('3964','<a href="@login">Inicie sesión</a> para comentar','es','0','0','0'),('3965','Lista sencilla','es','0','0','0'),('3966','Lista de hilos','es','0','0','0'),('3967','Guardar comentario','es','0','0','0'),('3968','El comentario se retirará de la publicación si contiene cualquiera de las frases de arriba. Use una lista de frases (que distinguen mayúsculas de minúsculas) separada por comas; por ejemplo: Divertido, puenting, "Compañía, Co.".','es','0','0','0'),('3969','Publicado el comentario %subject.','es','0','0','0'),('3970','Guardado el comentario %title','es','0','0','0'),('3971','Enumerar y editar los comentarios del sitio y la cola de aprobación de comentarios.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3972','Comentarios sin aprobar','es','0','0','0'),('3973','Por ejemplo: ''webmaster@ejemplo.com'' o ''ventas@ejemplo.com,servicio@ejemplo.com''. Para especificar varios destinatarios, separe cada dirección de correo electrónico con una coma.','es','0','0','0'),('3974','Se ha guardado la categoría %category.','es','0','0','0'),('3975','No le está permitido enviar más de %limit mensajes en @interval. Inténtelo después.','es','0','0','0'),('3976','Contactar con @username','es','0','0','0'),('3977','%sender-name (@sender-form) envió un mensaje acerca de %category.','es','0','0','0'),('3978','%sender-name (@sender-from) envío on correo electrónico a %recipient-name.','es','0','0','0'),('3979','El módulo de contacto permite a los visitantes comunicarse con los administradores y usuarios del sitio. Los usuarios especifican un tema, escriben su mensaje y pueden recibir una copia del mensale en su propia cuenta de correo electrónico. Para más información, consulte la entrada en el manual en pantalla sobre el <a href="@contact">módulo de Contacto</a>','es','0','0','0'),('3980','Formularios de contacto de usuarios','es','0','0','0'),('3981','Se puede contactar con los usuarios del sitio utilizando un formulario de contacto que preserva la privacidad de su dirección de correo electrónico. Los usuarios pueden activar o desactivar sus formularios de contacto personales editando su página <em>Mi cuenta</em>. Si se activa, se muestra una solapa <em>Contactar</em> que lleva al formulario personal que se muestra en su perfil de usuario. Los administradores del sitio pueden usar estos formularios de contacto incluso aunque hayan sido desactivados. La solapa <em>Contactar</em> no se muestra al ver el propio perfil.','es','0','0','0'),('3982','Formularios de contacto generales del sitio','es','0','0','0'),('3983','La <a href="@contact">página de contacto</a> proporciona un formulario simple para enviar comentarios, sugerencias y otras peticiones. Únicamente podrán utilizarlo los usuarios con el permiso <em>Usar el formulario de contacto del sitio</em>. Puede crear categorías para dirigir los mensajes del formulario de contacto a un conjunto de destinatarios predefinido. Las categorías comunes para un lugar comercial pueden incluir, por ejemplo, "Sugerencias del sitio web" (mensajes que son dirigidos a los administradores del sitio web) e "Información sobre los productos" (mensajes que son enviados al departamento comercial). Las direcciones de correo electrónico definidas en una categoría no son públicas.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3984','Cuando se activa la página de contacto del sitio, se crea un enlace en el menú de navegación principal, pero en principio este enlace está desactivado. Se puede activar el enlace en la <a href=''@menu''>página de administración de menús</a>.','es','0','0','0'),('3985','Personalización','es','0','0','0'),('3986','Si quiere que en la página de contacto del sitio o del usuario aparezca un texto adicional, use un bloque. Puede crear o editar bloques en la <a href="@blocks">página de administración de bloques</a>.','es','0','0','0'),('3987','Añada en esta página una o más categorías para configurar el <a href="@form">formulario de contacto</a> del sitio.','es','0','0','0'),('3988','El elemento de menú <em>Contacto</em> (desactivado por defecto) es añadido al menú de Navegación, el cual se puede modificar en la <a href="@menu-settings">Página de administración de menús</a>','es','0','0','0'),('3989','Si quiere que en la página de contacto del sitio aparezca un texto adicional, use un bloque. puede crear o editar bloques en la <a href="@blocks">página de administración de bloques</a>.','es','0','0','0'),('3990','Administrar formularios de contacto y opciones de formularios de contacto','es','0','0','0'),('3991','Usar el formulario de contacto del sitio','es','0','0','0'),('3992','Usar los formularios de contacto personal de los usuarios','es','0','0','0'),('3993','!sender-name  (!sender-url) envió un mensaje usando el formulario de contacto situado en !form-url.','es','0','0','0'),('3994','[!site-name] !subject','es','0','0','0'),('3995','!sender-name  (!sender-url) le ha enviado un mensaje a traves del formulario de contacto (!form-url) de !site-name.','es','0','0','0'),('3996','Si no quiere recibir estos correos, puede cambiar sus preferencias en !recipient-edit-url.','es','0','0','0'),('3997','Permitir que otros usuarios se pongan en contacto con usted mediante un <a href="@url">formulario de contacto personal</a> que mantiene oculta su dirección de correo. Tenga en cuenta que usuarios con privilegios tales como los administradores del sitio pueden comunicarse con usted incluso si desactiva esta característica.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('3998','Activar el formulario de contacto personal para los nuevos usuarios de forma predeterminada.','es','0','0','0'),('3999','Cambiar esta configuración no afectará a los usuarios ya existentes.','es','0','0','0'),('4000','El módulo de enlaces contextuales muestra enlaces relacionados con las regiones de las páginas en su sitio a los usuarios con permiso para <em>acceder a enlaces contextuales (access contextual links)</em>. Para más información, vea la entrada en el libro de ayuda en linea para <a href="@contextual">el módulo de enlaces contextuales</a>','es','0','0','0'),('4001','Presentando enlaces contextuales','es','0','0','0'),('4002','Los enlaces contextuales los crean los módulos para darle acceso rápido a tareas asociadas con regiones de las páginas de su sitio; por ejemplo: Si tiene un bloque de menú personalizado que se muestra en un lateral de su sitio, los módulos Bloques y Menús le proporcionan enlaces para configurar el bloque y editar el menú. El módulo Enlaces contextuales reune esos enlaces en una lista para mostrarla con su tema visual y añade código JavaScript a la página para ocultar inicialmente los enlaces y mostrarlos cuando el cursor pasa por encima del bloque.','es','0','0','0'),('4003','Usar enlaces contextuales','es','0','0','0'),('4004','Usar enlaces contextuales para ejecutar acciones relacionadas con los elementos de una página.','es','0','0','0'),('4005','Enlaces contextuales','es','0','0','0'),('4006','Proporciona enlaces contextuales para ejecutar acciones relacionadas con los elementos de una página.','es','0','0','0'),('4007','Monitorizando la actividad de usuario','es','0','0','0'),('4008','Al activar bloques como <em>Usuarios conectados</em> y <em>Usuarios nuevos</em>, los usuarios pueden ver quién está en ese momento y quienes se han unido recientemente en un sólo sitio centralizado.','es','0','0','0'),('4009','Monitorizando la actividad de contenido','es','0','0','0'),('4010','Al activar bloques como <em>Envíos de blog recientes</em>, <em>Nuevas conversaciones de foros</em> y <em>Comentarios recientes</em>, los usuarios pueden ver el contenido recientemente añadido de un sólo golpe de vista.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4011','Ver el panel de control administrativo','es','0','0','0'),('4012','Esta región del panel de control está vacía. Pulse <em>Personalizar panel de control<em> para añadirle bloques.','es','0','0','0'),('4013','ARRASTRAR AQUÍ','es','0','0','0'),('4014','Proporciona una página de panel de control en la interfaz administrativa para organizar las tareas administrativas y monitorizar la información de su sitio.','es','0','0','0'),('4015','Personalizar panel de control','es','0','0','0'),('4016','Limpiar mensajes del registro','es','0','0','0'),('4017','Esto eliminará de forma permanente los mensajes del registro de la base de datos.','es','0','0','0'),('4018','Registro de la base de datos limpiados.','es','0','0','0'),('4019','El módulo de Registro de la base de datos registra todos los sucesos del sistema en la base de datos de Drupal. Para más información, consulte las páginas del manual en pantalla sobre <a href="@dblog"> módulo de Registro de la base de datos</a>.','es','0','0','0'),('4020','Monitorizando su sitio','es','0','0','0'),('4021','Depurando problemas del sitio.','es','0','0','0'),('4022','Errores de validación de campo','es','0','0','0'),('4023','Se intentó crear un campo con un nombre de más de 32 caracteres: %name','es','0','0','0'),('4024','Se intentó crear un campo de nombre %name que ya existe y está activo.','es','0','0','0'),('4025','Se ha intentado crear un campo con nombre %name que ya existe, aunque está inactivo.','es','0','0','0'),('4026','Intento de crear un campo llamado %name, que está reservado por la entidad de tipo %type.','es','0','0','0'),('4027','Se intentó crear un campo de tipo desconocido %type.','es','0','0','0'),('4028','Se intentó crear un campo con un tipo de almacenamiento desconocido %type.','es','0','0','0'),('4029','Se ha intentado crear una instancia del campo @field_name sin un paquete.','es','0','0','0'),('4030','Activando tipos de campo','es','0','0','0'),('4031','El módulo Campos proporciona la infraestructura para campos y adición de campos. Además, módulos adicionales proporcionan tipos de campos y controles de entrada. Algunos de los módulos son imprescindibles. Los módulos opcionales se pueden activar en la <a href="@modules">página de administración de módulos </a>. El núcleo de Drupal incluye los siguientes tipos de módulos de campos: Número (imprescindible), Texto (imprescindible), Lista (imprescindible), Taxonomía (opcional), Imagen (opcional) y Archivo (opcional). El módulo Opciones (imprescindible) proporciona controles de entrada para otros módulos de campos. Los módulos aportados por terceros  pueden proporcionar campos y controles adicionales , y se pueden hallar en la <a href="@contrib"> sección de módulos contrubuidos de Drupal.org</a> Los módulos de campos y controles de entrada actualmente activados son','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4032','Gestionando el almacenamiento de datos de campo','es','0','0','0'),('4033','Los desarrolladores de módulos de campo pueden utilizar el <a href="@sql-store">módulo de almacenamiento Field SQL</a> predeterminado para almacenar datos en sus campos, o bien un módulo personalizado o de terceros ya desarrollado usando el <a href="@storage-api">API de almacenamiento de campos</a>.','es','0','0','0'),('4034','El módulo de almacenamiento SQL de Field almacena datos de campos en la base de datos. Es el módulo predeterminado de almacenamiento de campos; otros mecanismos de almacenamiento de campos pueden estar disponibles como módulos de terceros. Ver la <a href="@field-help">página de ayuda del módulo Field</a> para más información acerca de campos.','es','0','0','0'),('4035','Almacenamiento SQL predeterminado','es','0','0','0'),('4036','Almacena campos en la base SQL local, usando tablas por campos.','es','0','0','0'),('4037','Almacenamiento de campo SQL','es','0','0','0'),('4038','Almacena los datos del campo en una base de datos SQL.','es','0','0','0'),('4039','El módulo List define varios campos para almacenar una lista de elementos, para usar con el módulo Field. Normalmente, estos elementos son elegidos a través de una lista de selección, casillas de verificación, o botones de radio. Ver la <a href="@field-help">página de ayuda del módulo Field</a> para más información acerca de campos.','es','0','0','0'),('4040','Este campo guarda valores sencillos como activado/desactivado o sí/no.','es','0','0','0'),('4041','Lista (de texto)','es','0','0','0'),('4042','Etiquetas HTML admitidas en etiquetas: @tags','es','0','0','0'),('4043','El valor de este campo se determina mediante la función %function y no se puede cambiar.','es','0','0','0'),('4044','Lista de valores permitidos: Cada clave debe ser un número entero o decimal.','es','0','0','0'),('4045','Lista de valores permitidos: Cada clave debe ser una cadena de un máximo de 255 caracteres.','es','0','0','0'),('4046','Lista de valores admitidos: Las claves deben ser números enteros.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4047','Define tipos de campos de listas. Uselo con opciones para crear listas de selección.','es','0','0','0'),('4048','Este campo almacena un número en la base de datos como un número entero.','es','0','0','0'),('4049','Este campo almacena un número en la base de datos en un formato decimal fijo.','es','0','0','0'),('4050','Este campo almacena en la base de datos un número en formato de coma flotante.','es','0','0','0'),('4051','El valor mínimo que se debe permitir en este campo. Déjelo vacío para que no haya un mínimo.','es','0','0','0'),('4052','El valor máximo que se debe permitir en este campo. Déjelo vacío para que no haya un máximo.','es','0','0','0'),('4053','Defina un texto que se debe anteponer al valor, como ''$ '' o ''&euro; ''. Déjela en blanco para no anteponer nada. Separe el singular del plural con una barra vertical (''libra|libras'').','es','0','0','0'),('4054','En %field sólo se permiten números y el marcador de decimales (@separator).','es','0','0','0'),('4055','El módulo de Opciones (Options) define casillas, botones de selección y otros controles para el módulo Campos. Consulte la <a href="@field-help">página de ayuda del módulo Campos</a> para obtener más información sobre los campos.','es','0','0','0'),('4056','Este campo almacena texto varchar en la base de datos.','es','0','0','0'),('4057','Texto largo','es','0','0','0'),('4058','Este campo almacena texto largo en la base de datos.','es','0','0','0'),('4059','Texto largo y resumen','es','0','0','0'),('4060','Este campo guarda un texto largo en la base de datos con un texto de resumen opcional.','es','0','0','0'),('4061','Texto filtrado (el usuario selecciona el formato de texto)','es','0','0','0'),('4062','Resumen de la entrada','es','0','0','0'),('4063','Esto permite a los autores crear manualmente un resumen que se mostrará en lugar del texto recortado automáticamente cuando se use la forma de presentación "Resumen o recortado".','es','0','0','0'),('4064','%name: El texto no puede tener más de %max caracteres.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4065','%name: el resumen no debe ser más largo de %max caracteres.','es','0','0','0'),('4066','Resumen o recortado','es','0','0','0'),('4067','Área de texto con un resumen','es','0','0','0'),('4068','Déjelo en blanco para usar como resumen un fragmento recortado del texto completo.','es','0','0','0'),('4069','Ocultar resumen','es','0','0','0'),('4070','Editar resumen','es','0','0','0'),('4071','el campo %field (@field_name) requiere el control %widget_type proporcionado por el módulo %widget_module','es','0','0','0'),('4072','Los campos inactivos no se muestran a menos que los módulos que los proporcionan estén activos. Los siguientes campos no están activados: !list','es','0','0','0'),('4073','Editar opciones de campo.','es','0','0','0'),('4074','Cambiar tipo de control.','es','0','0','0'),('4075','Editar opciones de instancia.','es','0','0','0'),('4076','Eliminar instancia.','es','0','0','0'),('4077','El campo %label no se puede añadir porque está bloqueado.','es','0','0','0'),('4078','Hubo un problema al crear la instancia del campo %label: @message.','es','0','0','0'),('4079','Aun no se han agregado campos. Puede añadir nuevos campos en la página de <a href="@link">gestionar campos</a>.','es','0','0','0'),('4080','Estas opciones se aplican al campo %field en todos los sitios en los que se use. Estas opciones influyen en el modo en el que se almacenan los datos en la base de datos y no se pueden alterar una vez que se han creado los datos.','es','0','0','0'),('4081','%field no tiene opciones de campo.','es','0','0','0'),('4082','Actualizadas las opciones del campo %label.','es','0','0','0'),('4083','Falló el intento de actualizar el campo %label: %message.','es','0','0','0'),('4084','Cambiar control','es','0','0','0'),('4085','El tipo de formulario que quiere mostrar al usuario cuando cree este campo en el tipo %type.','es','0','0','0'),('4086','Cambiado el control para el campo %label.','es','0','0','0'),('4087','Hubo un problema al cambiar el control para el campo %label.','es','0','0','0'),('4088','Este campo está <strong>bloqueado</strong> y no se puede borrar.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4089','El campo %field ha sido eliminado del tipo de contenido %type.','es','0','0','0'),('4090','Hubo un problema en la eliminación de %field del tipo de contenido %type.','es','0','0','0'),('4091','Estas opciones se aplican sólo en el campo %field cuando se utiliza en el tipo %type.','es','0','0','0'),('4092','Campo necesario','es','0','0','0'),('4093','Estas opciones se aplican al campo %field en todos los sitios en los que se use. Como el campo ya contiene datos, algunas opciones ya no se pueden cambiar.','es','0','0','0'),('4094','Estas opciones se aplican al campo %field en todos los sitios en los que se usa.','es','0','0','0'),('4095','Opciones del campo %field','es','0','0','0'),('4096','El valor predeterminado para este campo. Se usa cuando se crea nuevo contenido.','es','0','0','0'),('4097','Guardada la configuración de %label.','es','0','0','0'),('4098','Esta lista muestra todos los campos actualmente en uso como referencia rápida.','es','0','0','0'),('4099','Guardar y añadir campos','es','0','0','0'),('4100','Lista de campos','es','0','0','0'),('4101','Gestionar presentación','es','0','0','0'),('4102','IU de campo','es','0','0','0'),('4103','Este campo alamacena la ID de un archivo como un valor de número entero.','es','0','0','0'),('4104','Activar campo <em>Presentación</em>','es','0','0','0'),('4105','La opción de presentación permite a los usuarios elegir si un archivo se debe mostrar al presentar el contenido.','es','0','0','0'),('4106','Archivos mostrados de forma predeterminada','es','0','0','0'),('4107','Esta opción sólo tiene efecto si la opción de presentación está activada.','es','0','0','0'),('4108','Destino de la subida al servidor','es','0','0','0'),('4109','Seleccionar dónde se deben almacenar los archivos finales. El almacenamiento privado de archivos es notablemente más gravoso que el de archivos públicos, pero permite la restricción de acceso a los archivos dentro de este campo.','es','0','0','0'),('4110','Subdirectorio opcional dentro del destino de subidas donde se almacenarán los archivos. No escriba barras ni al inicio ni al final.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4111','Escriba un valor como "512" (bytes), "80 KB" (kilobytes) o "50 MB" (megabytes) para restringir el tamaño permitido de archivo. Si se deja vacío, los tamaños de archivo estarán limitados únicamente por los tamaños máximos definidos en PHP para envíos y subida de archivos (el límite actual es <strong>%limit</strong>).','es','0','0','0'),('4112','Activar campo <em>Descripción</em>','es','0','0','0'),('4113','El campo de descripción permite a los usuarios porporcionar una descripción del fichero subido al servidor.','es','0','0','0'),('4114','La opcion "!name" debe contener un valor válido. Puede dejar el campo de texto vacío o introducir un textol como "512" (bytes), "80 KB" (kilobytes) o "50 MB" (megabytes).','es','0','0','0'),('4115','La lista de extensiones permitidas no es válida. Asegúrese de excluir los puntos del principio y de separar las extensiones con una coma o espacio en blanco.','es','0','0','0'),('4116','Archivo genérico','es','0','0','0'),('4117','Tabla de archivos','es','0','0','0'),('4118','Añadir archivo nuevo','es','0','0','0'),('4119','Incluir archivo en presentación','es','0','0','0'),('4120','La descipción se puede usar como etiqueta del enlace al archivo.','es','0','0','0'),('4121','Los archivos deben ser menores que !size.','es','0','0','0'),('4122','Tipos de archivo permitidos: !extensions.','es','0','0','0'),('4123','Las imágenes deben medir exactamente !size píxeles.','es','0','0','0'),('4124','Las imágenes deben tener entre !min y !max píxeles.','es','0','0','0'),('4125','Las imágenes deben medir más de !min píxeles.','es','0','0','0'),('4126','Las imágenes deben ser menores que !max píxeles.','es','0','0','0'),('4127','El módulo Archivo (File) define un tipo de campo <em>Archivo</em> (file) que le permite gestionar y validar los archivos subidos al servidor y adjuntados al contenido de su sitio (consulte las <a href="@field-help">páginas de ayuda del módulo Campos</a> para tener más información sobre los campos). Para más información, consulte las <a href="@file">páginas sobre el módulo Campos</a> del manual en pantalla.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4128','Anexando archivos al contenido','es','0','0','0'),('4129','Gestionando presentación de los adjuntos','es','0','0','0'),('4130','Cuando adjunta un archivo al contenido, puede elegir si se debe <em>listar</em> o no. Los archivos listados se muestran automáticamente en una sección en la zona inferior del contenido. Los archivos no listados están disponibles para su uso con el contenido pero no se incluyen en una lista en la zona inferior.','es','0','0','0'),('4131','Gestionando ubicación de archivos','es','0','0','0'),('4132','Hubo un error irrecuperable. El uso de este formulario ha caducado. Pruebe a recargar la página y reenviarla.','es','0','0','0'),('4133','El archivo referenciado en el campo !name no existe.','es','0','0','0'),('4134','No se pudo subir el archivo en el campo !name.','es','0','0','0'),('4135','El directorio de subida de archivos %directory para el campo de archivo !name no se pudo crear o no es accesible. Por eso, un archivo que se estaba subiendo al servidor no se ha podido guardar allí y la subida se ha cancelado.','es','0','0','0'),('4136','Su servidor no puede mostrar el progreso de subida de archivos. Para ello necesita que el servidor web Apache se esté ejecutando con mod_php.','es','0','0','0'),('4137','Todos los roles deben usar este formato.','es','0','0','0'),('4138','El orden de los formatos de texto se ha guardado.','es','0','0','0'),('4139','Añadir formato de texto','es','0','0','0'),('4140','Todos los roles para este formato de texto deben estar activos y no se pueden cambiar','es','0','0','0'),('4141','Orden de procesamiento de los filtros','es','0','0','0'),('4142','Los nombres de formatos de texto deben ser únicos. Un formato de nombre %name ya existe.','es','0','0','0'),('4143','Se ha añadido el formato de texto %format.','es','0','0','0'),('4144','Se ha actualizado el formato de texto %format.','es','0','0','0'),('4145','Formatos de texto','es','0','0','0'),('4146','El módulo Filtro permite a los administradores configurar formatos de texto. Un formato de texto define que etiquetas HTML, código y otros tipos de entrada se admiten en el contenido y en los comentarios. Es un elemento clave en la protección contra la entrada de datos potencialmente peligrosos por parte de usuarios malintencionados. para más información, consulte el manual en pantalla sobre el <a href="@filter">módulo Filtro</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4147','Aplicando filtros al texto','es','0','0','0'),('4148','Definiendo formatos de texto','es','0','0','0'),('4149','Un formato se incluye de forma predeterminada: <em>Texto puro</em> (donde se eliminan todas las etiquetas HTML). Su perfil de instalación podría crear más formatos al instalar Drupal, y sus administradores podrían crear aún otros más en la <a href="@text-formats">página de formatos de texto</a>.','es','0','0','0'),('4150','eligiendo un formato de texto','es','0','0','0'),('4151','Un formato de texto contiene los filtros que cambian lo que proporciona el usuario; eliminando, por ejemplo un posible HTML dañino o haciendo que las URL sean pulsables. Los filtros se ejecutan de arriba abajo, por lo que su orden es importante ya que un filtro puede impedir que otro haga su trabajo; por ejemplo: Si las URL se convierten en enlaces antes de que las etiquetas de HTML no permitidas sean eliminadas, todos los enlaces se pueden perder. Cuando esto ocurre es posible que haya que modificar el orden de los filtros.','es','0','0','0'),('4152','Advertencia: Este permiso puede tener implicaciones de seguridad dependiendo de cómo se haya configurado el formato de texto.','es','0','0','0'),('4153','Use el formato de texto !text_format','es','0','0','0'),('4154','Más información sobre los formatos de texto','es','0','0','0'),('4155','Limitar las etiquetas HTML permitidas','es','0','0','0'),('4156','Convertir saltos de línea en HTML (es decir: i.e. <code>&lt;br&gt;</code> y <code>&lt;p&gt;</code>)','es','0','0','0'),('4157','Convertir las URL en enlaces','es','0','0','0'),('4158','Corregir HTML defectuoso o incompleto','es','0','0','0'),('4159','Mostrar cualquier HTML como texto sin formato.','es','0','0','0'),('4160','Una lista de etiquetas HTML que se pueden emplear. Los atributos de sucesos JavaScript, Las URL JavaScript y el CSS siempre se eliminan.','es','0','0','0'),('4161','Mostrar ayuda HTML básica en los consejos largos de filtros','es','0','0','0'),('4162','Añadir rel="nofollow" a todos los enlaces','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4163','Este sitio permite contenido con HTML. Aunque aprender HTML puede intimidar, saber cómo usar un conjunto limitado de las etiquetas HTML más básicas es muy sencillo. Esta tabla proporciona ejemplos de como se usa cada etiqueta admitida en este sitio.','es','0','0','0'),('4164','Para más información, consulte las <a href="@html-specifications">especificaciones HTML</a> del W3C o use su buscador preferido para encontrar otros sitios que le expliquen el HTML.','es','0','0','0'),('4165','La mayoría de los caracteres inusuales se pueden escribir directamente sin ningún problema.','es','0','0','0'),('4166','No se permiten etiquetas HTML.','es','0','0','0'),('4167','Filtra el contenido preparándolo para presentación.','es','0','0','0'),('4168','Por !author hace @time','es','0','0','0'),('4169','El foro %term y todos sus subforos ha sido borrado.','es','0','0','0'),('4170','La cantidad de réspuestas que una conversación debe tener para que se considere "candente".','es','0','0','0'),('4171','No hay contenedores o foros disponibles.  <a href="@container">Añadir contenedor</a> o <a href="@forum">Añadir foro</a>.','es','0','0','0'),('4172','foro: eliminado %term y todos sus subforos.','es','0','0','0'),('4173','El módulo de Foro le permite crear foros de discusión con comentarios ligados similares a los de otros sistemas de mensajes de foros. Los foros son útiles porque permiten a los miembros de la comunidad discutir sobre temas con la seguridad de que esas conversaciones se archivan para su consulta posterior. En un foro, los usuarios publican temas y conversaciones ligadas en jerarquías anidades, lo que permite que las discusiones se categoricen y agrupen. La jerarquía de un foro consiste en:','es','0','0','0'),('4174','Contenedores opcionales (por ejemplo, <em>Servicio técnico</em>), que pueden contener:','es','0','0','0'),('4175','Foros (por ejemplo, <em>Instalación de Drupal</em>), que pueden contener:','es','0','0','0'),('4176','Conversaciones de foros enviadas por los usuarios; por ejemplo: <em>Cómo comenzar un sitio múltiple con Drupal 6,</em> lo que da lugar a discusiones y dirve de punto de partida para:','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4177','Comentarios anidados enviados por los usuarios (por ejemplo, <em>Tiene estas opciones...</em>).','es','0','0','0'),('4178','Estableciendo la estructura del foro','es','0','0','0'),('4179','Visite la página de foros para disponer contenedores y foros que abarquen sus conversaciones de foros.','es','0','0','0'),('4180','Comenzando una discusión','es','0','0','0'),('4181','El enlace <a href="@create-topic">Conversación de foro</a> en la página <a href="@content-add">Añadir nuevo contenido</a> crea el primer mensaje en una conversación de foro ligada, llamada también "hilo".','es','0','0','0'),('4182','Activar el módulo Foro proporciona un elemento de menú <em>Foros</em> predeterminado  dentro del menú de navegación que enlaza con la <a href="@forums">página de foros</a>.','es','0','0','0'),('4183','Trasladando temas de foro','es','0','0','0'),('4184','Una conversación de foro y todos sus comentarios se puede llevar de un foro a otro si se selecciona un foro distinto cuando se está editando una conversación de foro. Al trasladar una conversación entre foros, la opción de <em>dejar copia fantasma</em> crea un nuevo enlace en el foro original apuntando a la nueva ubicación.','es','0','0','0'),('4185','Bloqueando y desactivando comentarios','es','0','0','0'),('4186','Seleccionar <em>Cerrado</em> debajo de <em>Opciones de comentarios</em> al editar una conversación de foro bloqueará la cadena de respuestas, impidiendo nuevos comentarios. Seleccionar <em>Oculto</em> debajo de <em>Opciones de comentarios</em> al editar una conversación de foro ocultará todos los comentarios de la conversación e impedirá los nuevos.','es','0','0','0'),('4187','Los foros contienen conversaciones de foros. Use contenedores para agrupar foros relacionados.','es','0','0','0'),('4188','Usar contenedores para agrupar foros relacionados.','es','0','0','0'),('4189','Un foro abarca conversaciones de foro relacionadas.','es','0','0','0'),('4190','Ajustar la presentación de sus conversaciones de foros. Organice los foros en la <a href="@forum-structure">página de estructura de foros</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4191','Añadir @node_type nuevo','es','0','0','0'),('4192','<a href="@login">Inicie sesión</a> para enviar contenido nuevo al foro.','es','0','0','0'),('4193','El elemento %forum es un contenedor de foro, no un foro. Seleccione uno de los foros a continuación en su lugar.','es','0','0','0'),('4194','Una <em>conversación de foro</em> comienza una nueva línea de discusión dentro de un foro.','es','0','0','0'),('4195','Controlar las opciones de jerarquía de foro.','es','0','0','0'),('4196','Vocabulario de navegación de foro','es','0','0','0'),('4197','Proporciona foros de discusión.','es','0','0','0'),('4198','Siga estos pasos para configurar su sitio y comenzar a usarlo.','es','0','0','0'),('4199','<strong>Comenzar a enviar contenido</strong> Para terminar, puede <a href="@content">añadir nuevo contenido</a> en su sitio web.','es','0','0','0'),('4200','Para mayor información, refiérase a los temas específicos enumerados en la siguiente sección o a la <a href="@handbook">documentación en línea de Drupal</a>. También puede publicar en el <a href="@forum">foro de Drupal</a> o ver la amplia gama de <a href="@support">opciones de soporte</a> disponibles.','es','0','0','0'),('4201','Proporciona ayuda de referencia','es','0','0','0'),('4202','El módulo de Ayuda (Help) presenta explicaciones para el uso de cada módulo presente en la lista de la principal <a href="@help">página de ayuda de referencia</a>.','es','0','0','0'),('4203','Proporciona ayuda dependiente del contexto','es','0','0','0'),('4204','El módulo de Ayuda presenta consejos dependientes del contexto y explicaciones sobre distintas páginas.','es','0','0','0'),('4205','Editar estilo %name','es','0','0','0'),('4206','Este estilo de imagen está siendo proporcionado por un módulo. Haga clic en el botón «Sobrescribir valores predeterminados» para cambiar su configuración.','es','0','0','0'),('4207','Nombre de estilo de imagen','es','0','0','0'),('4208','Este estilo de imagen está siendo proporcionado por el módulo %module y no puede ser renombrado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4209','El nombre es usado en las URL para las imágenes generadas. Use solamente caracteres alfanuméricos en minúscula, guiones bajos (_) y guiones (-).','es','0','0','0'),('4210','Seleccionar un efecto nuevo','es','0','0','0'),('4211','Sobrescribir valores predeterminados','es','0','0','0'),('4212','Actualizar estilo','es','0','0','0'),('4213','Seleccionar un efecto para adñadirlo.','es','0','0','0'),('4214','El efecto de imagen se aplicó correctamente.','es','0','0','0'),('4215','El estilo %style ha sido sobrescrito, lo que le permite cambiar su configuración.','es','0','0','0'),('4216','Nombre de estilo','es','0','0','0'),('4217','Crear estilo nuevo','es','0','0','0'),('4218','Se creo el estilo %name.','es','0','0','0'),('4219','El nombre de estilo de imagen %style ya está en uso.','es','0','0','0'),('4220','Por favor, para los nombres de estilos, use sólo caracteres alfanuméricos, guiones bajos (_) y normales (-).','es','0','0','0'),('4221','No remplazar, sólo borrar','es','0','0','0'),('4222','Estilo de remplazo','es','0','0','0'),('4223','Si no, puede seleccionar un estilo antes de borrar %style.','es','0','0','0'),('4224','Si este estilo se usa en el sitio, puede seleccionar otro estilo para remplazarlo. Todas las imágenes que se hayan creado con este estilo se borrarán permanentemente.','es','0','0','0'),('4225','El estilo %name fue eliminado.','es','0','0','0'),('4226','¿Restablecer los valores de inicio del estilo %style?','es','0','0','0'),('4227','Restablecer este estilo eliminará todos los ajustes personalizados y lo devolverá a los valores de origen proporcionados por el módulo @module.','es','0','0','0'),('4228','Se ha devuelto el estilo %style a sus valores predeterminados.','es','0','0','0'),('4229','Editar efecto %label','es','0','0','0'),('4230','Añadir efecto %lavel.','es','0','0','0'),('4231','Actualizar efecto','es','0','0','0'),('4232','Añadir efecto','es','0','0','0'),('4233','¿Seguro que quiere eliminar el efecto @effect del estilo %style?','es','0','0','0'),('4234','El efecto de imagen %name ha sido eliminado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4235','!name debe ser un número entero.','es','0','0','0'),('4236','!name debe ser un número entero positivo.','es','0','0','0'),('4237','!name debe se un valor de color hexadecimal.','es','0','0','0'),('4238','No se pueden dejar a la vez en blanco ancho y alto.','es','0','0','0'),('4239','La parte de la imagen que se conservará al recortar.','es','0','0','0'),('4240','El color de fondo que se usará en las áreas expuestas de la imagen. Use valores de color hexadecimal (#ffffff para blanco y #000000 para negro). Déjelo en blanco para tener transparencia en aquellos formatos de imagen que la admiten.','es','0','0','0'),('4241','Actualmente no hay estilos. <a href="!url">Añadir uno nuevo</a>.','es','0','0','0'),('4242','No hay actualmente efectos en este estilo. Añada uno seleccionando una de las opciones de abajo.','es','0','0','0'),('4243','ver tamaño real','es','0','0','0'),('4244','Imagen de ejemplo original','es','0','0','0'),('4245','Imagen de ejemplo modificada','es','0','0','0'),('4246','El redimensionado hará que las imágenes tomen unas dimensiones precisas. Esto puede hacer que las imágenes se estrechen o estiren desproporcionadamente.','es','0','0','0'),('4247','El escalado mantiene la relación de proporciones de la imagen original. Si sólo se especifica una dimensión, la otra se calculará.','es','0','0','0'),('4248','Escalar y recortar','es','0','0','0'),('4249','Escalar y recortar mantendrán la relación de proporciones de la imagen original y se desechará lo que sobre por el lado mayor. Esto es especialmente útil para crear miniaturas perfectamente cuadradas sin deformar la imagen.','es','0','0','0'),('4250','El recorte eliminará partes de una imagen para que tenga las dimensiones especificadas.','es','0','0','0'),('4251','Desaturar','es','0','0','0'),('4252','Desaturar convierte una imagen en escala de grises.','es','0','0','0'),('4253','Girar una imagen hara que sus dimensiones aumenten para encajar la diagonal.','es','0','0','0'),('4254','Falló el redimensionado de la imagen usando el juego de herramientas %toolkit en %path (%mimetype, %dimensions)','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4255','Falló el escalado de la imagen usando el juego de herramientas %toolkit en %path (%mimetype, %dimensions)','es','0','0','0'),('4256','Falló el recorte de la imagen usando el juego de herramientas %toolkit en %path (%mimetype, %dimensions)','es','0','0','0'),('4257','Falló el escalado y recorte de la imagen usando el juego de herramientas %toolkit en %path (%mimetype, %dimensions)','es','0','0','0'),('4258','Falló la desaturación de la imagen usando el juego de herramientas %toolkit en %path (%mimetype, %dimensions)','es','0','0','0'),('4259','Falló la rotación de la imagen usando el juego de herramientas %toolkit en %path (%mimetype, %dimensions)','es','0','0','0'),('4260','Este campo almacena el ID de un archivo de imagen como un valor de número entero.','es','0','0','0'),('4261','Si no se sube una imagen, ésta será la imagen que se muestre.','es','0','0','0'),('4262','El tamaño máximo permitido para imágenes, expresado como ANCHOxALTO (por ejemplo, 640x480). Déjelo vacío para no especificar límites. Si se sube una imagen más grande, será reducida para reflejar el ancho y alto especificados. Cambiar el tamaño de una imagen subida causará la pérdida de los <a href="http://es.wikipedia.org/wiki/Exchangeable_image_file_format">datos EXIF</a> en la imagen.','es','0','0','0'),('4263','Resolución mínima de imagen','es','0','0','0'),('4264','El tamaño mínimo permitido para imágenes, expresado como ANCHOxALTO (por ejemplo, 640x480). Déjelo vacío para no especificar límites. Si se sube una imagen más pequeña, será rechazada.','es','0','0','0'),('4265','Activar campo <em>Alt</em>','es','0','0','0'),('4266','El atributo <em>alt</em> puede ser usado por los motores de búsqueda, los lectores de pantalla y cuando no se logra cargar la imagen.','es','0','0','0'),('4267','Activar campo <em>Título</em>','es','0','0','0'),('4268','El atributo título se usa como pequeño mensaje emergente cuando se pasa el cursor por encima de la imagen.','es','0','0','0'),('4269','Los valores ancho y alto deben ser números.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4270','Deben especificarse los valores de ancho y alto en el campo !name.','es','0','0','0'),('4271','Vista previa de estilo de imagen','es','0','0','0'),('4272','sin vista previa','es','0','0','0'),('4273','La vista previa de la imagen se mostrará al editar el contenido.','es','0','0','0'),('4274','Manipulando imágenes','es','0','0','0'),('4275','Basándose en dónde se usará; por ejemplo: <em>imagen-de_perfil</em>','es','0','0','0'),('4276','Describiendo su apariencia; por ejemplo: <em>cuadrado - 85×85</em>','es','0','0','0'),('4277','Adjuntando imágenes al contenido como campos','es','0','0','0'),('4278','Administrar estilos de imagen','es','0','0','0'),('4279','Crear y modificar estilos para hacer modificaciones de imagen como las miniaturas.','es','0','0','0'),('4280','Sin estilos definidos','es','0','0','0'),('4281','Creación de imagen en progreso. Inténtelo dentro de un instante.','es','0','0','0'),('4282','Error al crear la imagen','es','0','0','0'),('4283','No se pudo generar la imagen derivada ubicada en %path.','es','0','0','0'),('4284','No se pudo crear el directorio de estilo: %directory','es','0','0','0'),('4285','Crear estilo de imagen','es','0','0','0'),('4286','Estilos de imagen','es','0','0','0'),('4287','Configurar estilos que se pueden usar para redimensionar o ajustar la presentación de imágenes.','es','0','0','0'),('4288','Enumerar los actuales estilos de imagen del sitio.','es','0','0','0'),('4289','Añadir estilo','es','0','0','0'),('4290','Agregar nuevo estilo de imagen.','es','0','0','0'),('4291','Configurar un estilo de imagen.','es','0','0','0'),('4292','Eliminar un estilo de imagen.','es','0','0','0'),('4293','Restablecer estilo','es','0','0','0'),('4294','Restablecer un estilo de imagen.','es','0','0','0'),('4295','Editar efecto de imagen','es','0','0','0'),('4296','Elminar efecto de imagen','es','0','0','0'),('4297','Añadir efecto de imagen','es','0','0','0'),('4298','Agregar un efecto nuevo a un estilo.','es','0','0','0'),('4299','Proporciona herramientas de manipulación de imágenes.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4300','Use la sección <em>Idioma personalizado</em> a continuación si el idioma que desea no aparece en esta lista.','es','0','0','0'),('4301','Código de idioma del prefijo de ruta','es','0','0','0'),('4302','Método de detección','es','0','0','0'),('4303','Parte de la URL que determina el idioma','es','0','0','0'),('4304','<em>Prefijo de ruta:</em> Las URL como http://ejemplo.com/de/contact fijan el idioma en alemán (de). <em>Dominio:</em> las URL como http://de.example.com/contact lo establecen en alemán. <strong>Advertencia: Cambiar esta opción puede destruir las URL entrantes. Úsela con precaución en un ambiente en funcionamiento real.</strong>','es','0','0','0'),('4305','Parámetro de petición o sesión','es','0','0','0'),('4306','Nombre del parámetro de petición o sesión usado para determinar el idioma deseado.','es','0','0','0'),('4307','Filtrar textos traducibles','es','0','0','0'),('4308','Tipo de fecha','es','0','0','0'),('4309','¿Está seguro de querer restablecer los valores globales en los formatos de fecha para %language?','es','0','0','0'),('4310','El restablecimiento eliminará todos los formatos de fecha regionalizados para este idioma. Esta acción no se puede deshacer.','es','0','0','0'),('4311','El módulo de regionalización (Locale) permite presentar su sitio Drupal en idiomas distintos al inglés (predeterminado) y ser multi idioma. El módulo de regionalización funciona manteniendo una base de datos de traducciones y examinando los textos que se van a mostrar. Cuando hay disponible una traducción el el idioma que se debe presentar, se muestra esa traducción en vez del texto original. Cuando no hay traducción disponible, se muestra el texto original, que se almacena para su revisión por un traductor. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@locale">módulo de regionalización</a>.','es','0','0','0'),('4312','Traduciendo texto de la interfaz','es','0','0','0'),('4313','Las traducciones del texto de la interfaz de Drupal las pueden proporcionar:','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4314','Traduciendo el interior de su sitio usando la <a href=''@translate''>interfaz de traducción</a> integrada en el módulo de regionalización (Locale).','es','0','0','0'),('4315','Configurando un sitio multi idioma','es','0','0','0'),('4316','La negociación de idioma permite a su sitio cambiar el idioma automáticamente basándose en el dominio o ruta usado para cada petición. Los usuarios pueden opcionalmente seleccionar su idioma preferido en su página <em>Mi cuenta</em> y su sitio se puede configurar para respetar la configuración de idioma preferido de un navegador web. El contenido del sitio se puede traducir usando el <a href=''@content-help''>Módulo de traducción de contenido</a>.','es','0','0','0'),('4317','Con varios idiomas activos, la interfaz se puede traducir, los usuarios registrados pueden seleccionar su idioma preferido y los autores pueden asignar idiomas concretos a sus contenidos. <a href="@translations">Descargue las traducciones</a> contribuidas a Drupal.org','es','0','0','0'),('4318','Añadir un idioma para que lo admita su sitio. Si el idioma que desea no está disponible en el menú descendente <em>Nombre del idioma,</em> pulse <em>Idioma personalizado</em> y proporcione un código de idioma y otros detalles manualmente. Cuando provea manualmente un código de idioma, asegúrese de emplear un código de idioma estandarizado, ya que este código podría ser usado por navegadores para determinar un idioma de presentación apropiado.','es','0','0','0'),('4319','Determinar el idioma a partir de un parámetro de petición o sesión; por ejemplo: "http://ejemplo.com?language=de" establece que el idioma es alemán basándose en el uso de "de" dentro del parámetro "language".','es','0','0','0'),('4320','Consulte la <a href="@languages">página de idiomas</a> para obtener más información sobre cómo añadir funcionamiento en otros idiomas.','es','0','0','0'),('4321','Esta página importa los textos traducidos incluidos en un único archivo de tipo Gettext Portable Object (<em>.po</em>). Se suelen distribuir como parte de un paquete de traducción (cada paquete de traducción puede contener numerosos archivos <em>.po</em>) y cada archivo <em>.po</em> debe importarse después de hacer una traducción en un programa de edición de tipo Gettext. La importación de un archivo </em>.po</em> puede llevar un tiempo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4322','Esta página permite a un traductor buscar textos concretos traducidos y sin traducir y se usa para crear o editar traducciones. (Advertencia: Para tareas de traducción que impliquen muchos textos, suele ser más conveniente <a href="@export">exportar</a> los textos para editarlos en su ordenador en un editor de traducciones de tipo Gettext). Las búsquedas se pueden restringir a textos encontrados dentro de un grupo de texto concreto o un idioma determinado.','es','0','0','0'),('4323','Administrar idiomas','es','0','0','0'),('4324','Traducir textos de la interfaz','es','0','0','0'),('4325','Orden de los métodos de detección de idioma para el contenido. Si hay una vesión disponible en el idioma detectado, será la que se muestre.','es','0','0','0'),('4326','Orden de los métodos de detección de idioma para el texto de la interfaz de usuario. Si hay una traducción del texto de la interfaz de usuario disponible en el idioma detectado, será la que se muestre.','es','0','0','0'),('4327','Determinar el idioma a partir de la URL (prefijo de ruta o dominio).','es','0','0','0'),('4328','Determinar el idioma a partir de un parámetro de petición o sesión.','es','0','0','0'),('4329','Seguir las preferencias de idioma del usuario.','es','0','0','0'),('4330','Determinar el idioma a partir de la configuración de idioma del navegador.','es','0','0','0'),('4331','Alternador de idioma (@type)','es','0','0','0'),('4332','Detección y selección','es','0','0','0'),('4333','Configuración de la detección de idioma de URL','es','0','0','0'),('4334','Configuración de la detección de idioma de la sesión','es','0','0','0'),('4335','Regionalizar','es','0','0','0'),('4336','Regionalizar formatos de fecha','es','0','0','0'),('4337','Restablecer formatos de fecha','es','0','0','0'),('4338','Restablecer los valores globales de los formatos de fecha regionalizados','es','0','0','0'),('4339','Enero','es','0','0','0'),('4340','Febrero','es','0','0','0'),('4341','Marzo','es','0','0','0'),('4342','Abril','es','0','0','0'),('4343','Mayo','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4344','Junio','es','0','0','0'),('4345','Julio','es','0','0','0'),('4346','Agosto','es','0','0','0'),('4347','Septiembre','es','0','0','0'),('4348','Octubre','es','0','0','0'),('4349','Noviembre','es','0','0','0'),('4350','Diciembre','es','0','0','0'),('4351','añadir enlace','es','0','0','0'),('4352','Aun no hay enlaces de menú. <a href="@link">Añadir enlace</a>','es','0','0','0'),('4353','El texto que se usará en el menú para este enlace.','es','0','0','0'),('4354','La ruta para este enlace de menú. Puede ser una ruta interna de Drupal como %add-node o una URL externa como %drupal. Escriba %front para enlazar con la página principal.','es','0','0','0'),('4355','Los enlaces de menú que no estén activados no se mostrarán en ningún menú.','es','0','0','0'),('4356','Mostrar expandido','es','0','0','0'),('4357','Si se selecciona y este enlace de menú tiene hijos, el menú aparecerá siempre expandido.','es','0','0','0'),('4358','Enlace padre','es','0','0','0'),('4359','La profundidad máxima de un enlace y de todos sus hijos se establece en !maxdepth. Algunos enlaces de menú podrían no estar disponibles como padres si al seleccionarlos se excede ese límite.','es','0','0','0'),('4360','Opcional. En los menús, los enlaces más pesados se pondrán más abajo mientras que los más ligeros se colocarán más arriba.','es','0','0','0'),('4361','¿Seguro que desea eliminar el enlace de menú personalizado %item?','es','0','0','0'),('4362','El enlace de menú %title ha sido eliminado.','es','0','0','0'),('4363','¿Está seguro de querer reiniciar el enlace %item a sus valores predeterminados?','es','0','0','0'),('4364','Se restablecieron los valores originales del enlace de menú.','es','0','0','0'),('4365','Sin enlaces principales','es','0','0','0'),('4366','Fuente de los enlaces principales','es','0','0','0'),('4367','Seleccione lo que se debería mostrar como enlaces principales (usualmente en la parte superior de la página).','es','0','0','0'),('4368','Sin enlaces secundarios','es','0','0','0'),('4369','Fuente de los enlaces secundarios','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4370','Seleccione la fuente para los enlaces secundarios. Una opción avanzada le permite utilizar la misma fuente, tanto para los enlaces principales (actualmente %main) como para los enlaces secundarios: Si su menú tiene dos niveles de jerarquía, los enlaces de nivel superior del menú aparecerán en los enlaces principales, y los descendientes del enlace activo aparecerán en los enlaces secundarios.','es','0','0','0'),('4371','Eliminado el menú personalizado %title y todos sus enlaces de menú.','es','0','0','0'),('4372','Eliminado el enlace de menú %title.','es','0','0','0'),('4373','<strong>Aviso:</strong> Actualmente hay 1 enlace de menú en %title. Será eliminado (se reiniciarán los elementos definidos por el sistema).','es','0','0','0'),('4374','<strong>Aviso:</strong> Actualmente hay @count enlaces de menú en %title. Serán eliminados (se reiniciarán los elementos definidos por el sistema).','es','4373','1','0'),('4375','Gestionando menús','es','0','0','0'),('4376','Presentando menús','es','0','0','0'),('4377','Después de que haya creado un menú, debe activar y posicionar el bloque asociado en la <a href="@blocks">Página de administración de bloques</a>.','es','0','0','0'),('4378','Puede activar el bloque recien creado para este menú en la <a href="@blocks">Página de administración de bloques</a>.','es','0','0','0'),('4379','Cada menú tiene un bloque correspondiente que se gestiona en la <a href="@blocks">página de administración de bloques</a>.','es','0','0','0'),('4380','Administrar menús y elementos de menú','es','0','0','0'),('4381','Proporciona un enlace de menú','es','0','0','0'),('4382','Los enlaces de menú con pesos menores se muestran antes que los enlaces con pesos mayores.','es','0','0','0'),('4383','Menú disponible','es','0','0','0'),('4384','Los menús disponibles para situar enlaces para este tipo de contenido.','es','0','0','0'),('4385','Elemento de menú padre predeterminado','es','0','0','0'),('4386','Elija el elemento de menú que será el padre predeterminado de un enlace nuevo en el formulario de creación de contenido.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4387','Añadir nuevos menús a su sitio, editar menús existentes y renombrar o reorganizar enlaces de menús.','es','0','0','0'),('4388','Elementos de menú padre','es','0','0','0'),('4389','Editar enlace de menú','es','0','0','0'),('4390','Reiniciar enlace de menú','es','0','0','0'),('4391','Eliminar enlace de menú','es','0','0','0'),('4392','El menú de <em>Navegación</em> contiene enlaces para los visitantes al sitio. Algunos módulos agregan enlaces al menú de <em>Navegación</em> automáticamente.','es','0','0','0'),('4393','El menú <em>Usuario</em> contiene enlaces relacionados con la cuenta del usuario, como el enlace ''Cerrar sesión''.','es','0','0','0'),('4394','El menú <em>Administrar</em> contiene enlaces a tareas administrativas.','es','0','0','0'),('4395','El menú <em>Principal</em> se usa en muchos sitios web para mostrar las secciones principales del sitio, generalmente en una barra de navegación superior.','es','0','0','0'),('4396','gestionar presentación','es','0','0','0'),('4397','Ningún tipo de contenido disponible. <a href="@link">Agregar tipo de contenido</a>.','es','0','0','0'),('4398','El nombre legible para humanos de este tipo de contenido. Este texto será mostrado como parte del listado en la página <em>Agregar nuevo contenido</em>. Es recomendable que este nombre comience con una letra mayúscula y contenga sólamente letras, números y espacios. Este nombre debe ser único.','es','0','0','0'),('4399','Describir este tipo de contenido. Este texto es lo que se muestra en la página <em>Añadir nuevo contenido</em>.','es','0','0','0'),('4400','Previsualizar antes de enviar','es','0','0','0'),('4401','Este texto será mostrado en la parte superior de la página cuando cree o edite contenido de este tipo.','es','0','0','0'),('4402','Usuarios con el permiso de <em>Administrar contenido</em> podrán sobrescribir estas opciones.','es','0','0','0'),('4403','Mostrar información del autor y fecha.','es','0','0','0'),('4404','Se mostrarán el nombre del autor y la fecha de publicación.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4405','Nombre de sistema no válido. Indique un nombre distinto de %invalid.','es','0','0','0'),('4406','%type está siendo usado por 1 elemento de contenido en su sitio web. Si usted elimina este tipo de contenido, no podrá editar el contenido %type y podría no mostrarse correctamente.','es','0','0','0'),('4407','%type está siendo usado por @count elementos de contenido en su sitio web. Si usted elimina %type, no podrá editar el contenido %type y podría no mostrarse correctamente.','es','4406','1','0'),('4408','Publicar el contenido seleccionado','es','0','0','0'),('4409','Retirar de la publicación el contenido seleccionado','es','0','0','0'),('4410','Llevar lo seleccionado a la página principal','es','0','0','0'),('4411','Retirar el contenido seleccionado de la página principal','es','0','0','0'),('4412','Hacer que el contenido seleccionado quede fijo en cabeza de las listas','es','0','0','0'),('4413','Hacer que el contenido seleccionado no sea fijo en cabeza de las listas','es','0','0','0'),('4414','Eliminar el contenido seleccionado','es','0','0','0'),('4415','Eliminados @count envíos.','es','5554','1','0'),('4416','¿Seguro que quiere borrar este elemento?','es','0','0','0'),('4417','¿Seguro que quiere borrar estos elementos?','es','4416','1','0'),('4418','<em>Editar @type</em> @title','es','0','0','0'),('4419','Aun no ha creado ningún tipo de contenido. Vaya a la <a href="@create-content">página de creación de tipos de contenido</a> para añadir nuevos tipos de contenido.','es','0','0','0'),('4420','Mensaje del historial de revisiones','es','0','0','0'),('4421','Proporcionar una explicación de los cambios realizados para que otros autores comprendan las razones.','es','0','0','0'),('4422','Comodines relacionados con elementos individuales de contenido o "nodos".','es','0','0','0'),('4423','El ID único del elemento de contenido o "nodo".','es','0','0','0'),('4424','El texto del cuerpo principal del nodo.','es','0','0','0'),('4425','El resumen del texto del cuerpo principal del nodo.','es','0','0','0'),('4426','Los permisos de acceso al contenido deben reconstruirse.  <a href="@node_access_rebuild">Reconstruir permisos</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4427','El módulo Node se encarga de la creación, edición, eliminación, configuración y visualización del contenido principal del sitio. Los elementos de contenido que administra el módulo Node suelen mostarse en páginas en su sitio, e incluyen un título, algunos metadatos (autor, fecha, tipo de contenido, etc.), y campos adicionales que pueden contener texto u otros tipos de datos (los campos son administrados a través del <a href="@field">módulo Field</a>). Para más información, consulte la entrada del manual del <a href="@node">módulo Nodo</a>.','es','0','0','0'),('4428','Creando contenido','es','0','0','0'),('4429','Cuando se crea contenido nuevo, el módulo Node registra información básica acerca del contenido, incluyendo el autor, la fecha de creación y el <a href="@content-type">tipo de contenido</a>. También, administra las <em>opciones de publicación</em>, que definen si el contenido se publica, se promueve a la página principal, y/o se establece como fijo en la cabeza de las listas de contenido. Se puede establecer una configuración predeterminada para cada <a href="@content-type">tipo de contenido</a> en su sitio.','es','0','0','0'),('4430','Creando tipos de contenido personalizados','es','0','0','0'),('4431','Administrando contenido','es','0','0','0'),('4432','La <a href="@content">Página de administración de contenido</a> le permite revisar y gestionar en masa el contenido del conjunto de su sitio.','es','0','0','0'),('4433','Creando revisiones','es','0','0','0'),('4434','El módulo Node también le permite crear múltiples versiones de cualquier contenido, y volver a versiones anteriores usando la configuración de <em>Información de revisiones</em>.','es','0','0','0'),('4435','Permisos de usuario','es','0','0','0'),('4436','El módulo Nodo pone a disposición de cada tipo de contenido una serie de permisos, que se pueden adjudicar por rol en la <a href="@permissions">página de permisos </a>.','es','0','0','0'),('4437','Los tipos de contenido individuales pueden tener diferentes campos, comportamientos y permisos asignados.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4438','Los elementos de contenido se pueden mostrar usando distintos modos de presentación: Resumen, Contenido completo, Impresión, RSS, etc. <em>Resumen</em> es una versión resumida que se usa en las listas de distintos elementos de contenido. <em>Contenido completo</em> se suele usar al mostrar el contenido en su propia página.','es','0','0','0'),('4439','Aquí puede definir qué campos se muestra y ocultan cuando se muestra el contenido de tipo %type en cada modo de presentación y cómo se muestran los campos en cada modo de presentación.','es','0','0','0'),('4440','Las revisiones permiten trazar las diferencias entre las distintas versiones del contenido y recuperar versiones anteriores.','es','0','0','0'),('4441','Contenido completo','es','0','0','0'),('4442','Resultados de la búsqueda','es','0','0','0'),('4443','El contenido de esta página ha sido modificado por otro usuario o usted ya ha enviado modificaciones con este mismo formulario. En consecuencia, sus cambios no se pueden guardar.','es','0','0','0'),('4444','Administrar tipos de contenido','es','0','0','0'),('4445','Advertencia: Proporcionar sólo a los roles de confianza. Este permiso implica riesgos de seguridad.','es','0','0','0'),('4446','Ver contenido publicado','es','0','0','0'),('4447','Acceder a la página de resumen de contenido','es','0','0','0'),('4448','Sortear el control de acceso al contenido','es','0','0','0'),('4449','Ver revisiones del contenido','es','0','0','0'),('4450','Restablecer revisiones del contenido','es','0','0','0'),('4451','Eliminar revisiones del contenido','es','0','0','0'),('4452','Ver el contenido propio sin publicar','es','0','0','0'),('4453','El contenido está fijo en cabeza de las listas','es','0','0','0'),('4454','El contenido esta colocado en la página principal','es','0','0','0'),('4455','Contenido reciente','es','0','0','0'),('4456','Cantidad de elementos de contenido recientes a mostrar','es','0','0','0'),('4457','Mostrar bloques para tipos de contenido específicos','es','0','0','0'),('4458','Mostrar este bloque sólo en las páginas que muestran contenido de tipos concretos. Si no ha seleccionado tipos de contenido, no habrá limitaciones por tipo específico de contenido.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4459','Bienvenido a @site-name','es','0','0','0'),('4460','Aun no se ha creado contenido para la página principal.','es','0','0','0'),('4461','Retirar contenido de la publicación','es','0','0','0'),('4462','Hacer que el contenido quede fijo en cabeza de las listas','es','0','0','0'),('4463','Hacer que el contenido no sea fijo en cabeza de las listas','es','0','0','0'),('4464','Llevar contenido a la página principal','es','0','0','0'),('4465','Quitar contenido de la página principal','es','0','0','0'),('4466','Cambiar autoría del contenido','es','0','0','0'),('4467','Guardar contenido','es','0','0','0'),('4468','Retirar de la publicación el contenido que contenga las palabras clave','es','0','0','0'),('4469','El contenido quedará sin publicar si contiene alguna de las frasees de arriba. Use una lista de frases separadas por comas (se distingue minúsculas de mayúsculas); por ejemplo: Divertido, saltos en paracaídas,','es','0','0','0'),('4470','Si el sitio experimenta problemas de permisos sobre el contenido, debería reconstruir la caché de permisos. la recostrucción eliminará todos los privilegios sobre el contenido, reemplazándolos con los permisos basados en los módulos y opciones actuales. la reconstrucción lleva algo de tiempo si hay mucho contenido o las opciones de permisos son complejas. Al terminar la reconstrucción, el contenido pasará a usar automáticamente los nuevos permisos.','es','0','0','0'),('4471','Permisos de acceso al nodo','es','0','0','0'),('4472','Un permiso en uso','es','0','0','0'),('4473','@count permisos en uso','es','4472','1','0'),('4474','Encontrar y gestionar contenido.','es','0','0','0'),('4475','Gestionar tipos de contenido, incluyendo estado predefinido, promoción a la página principal, opciones de comentarios, etc.','es','0','0','0'),('4476','Editar tipo de contenido','es','0','0','0'),('4477','No mostrar información del envío','es','0','0','0'),('4478','Este sitio admite OpenID, una forma segura de identificarse en muchos sitios web usando los mismos nombre de usuario y clave. OpenID puede reducir la necesidad de gestionar numerosos nombres y claves de usuarios en distintos sitios web.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4479','Si ya tiene un OpenID, escriba la URL de su servidor de OpenID más abajo; por ejemplo: minombredeusuario.proveedordeopenid.com. La próxima vez que inicie sesión, podrá usar esta URL en vez de un nombre y clave de usuario normales. Puede tener varios servidores de OpenID si lo desea; simplemente añádalos aquí.','es','0','0','0'),('4480','El módulo OpenID permite a los usuarios iniciar sesión usando el servicio de firma única <a href="@openid-net">OpenID</a>. Éste es un método seguro de iniciar sesión en muchos sitios web con los mismos nombre y clave de usuario. No necesita ningún prograna especial ni comparte claves con ningún sitio al que se asocie, incluidos los sitios en los que se inicia sesión. La principal ventaja para los usuarios es que pueden tener una única clave que pueden usar en muchos sitios web. Eso quiere decir que pueden actualizar fácilmente su clave única por medio de una ubicación centralizada en vez de tener docenas de claves individuales. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@handbook">módulo OpenID</a>.','es','0','0','0'),('4481','Iniciar sesión con OpenID','es','0','0','0'),('4482','Para iniciar sesión usando OpenID, un usuario debe tener previamente una cuenta de OpenID. Los usuarios pueden crear cuentas en el sitio usando su OpenID, asignando uno o más OpenID a una cuenta ya existente e iniciar sesión usando un OpenID. Esto reduce las barreras para registrarse, lo que ayuda a aumentar la base de usuarios. Como OpenID no puede garatizar que un usuario es quien dice ser, la verificación de cuenta por correo electrónico sigue siendo necesaria. Al iniciar sesión, se muestra a los usuarios la posibilidad de proporcionar la URL de su OpenID, que se parecerá a <em>minombredeusuario.proveedordeopenid.com</em>. El sitio se comunicará entonces con su servidor de OpenID, pidiéndole que verifique la identidad del usuario. Si el usuario se ha identificado en su servidor de OpenID, éste volverá a comunicarse con su sitio y verificará al usuario. Si no se ha identificado, el servidor de OpenID pedirá al usuario su clave. El sitio en el que se inicia sesión no registra en ningún momento la clave OpenID del usuario.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4483','Una vez que haya verificado su dirección de correo electrónico podra iniciar sesión a través de OpenID.','es','0','0','0'),('4484','Lo sentimos, no es una OpenID válida. Asegúrese de haberla escrito adecuadamente.','es','0','0','0'),('4485','Termine el registro rellenando el formulario a continuación. Si ya tiene una cuenta, <a href="@login">ahora puede añadir su OpenID</a> debajo de "Mi cuenta".','es','0','0','0'),('4486','Ha fallado el registro de su cuenta usando la información proporcionada por su proveedor de OpenID por una de las razones enumeradas a continuación. Complete su inscripción rellenando el siguiente formulario. Si ya tiene una cuenta aquí, puede <a href="@login">iniciar sesión</a> ahora y añadir su OpenID en "Mi cuenta".','es','0','0','0'),('4487','El módulo Superposición (Overlay) hace que las páginas de administración de su sitio se muestren en una capa JavaScript superpuesta encima de la página que esté viendo en el momento que haya pulsado el enlace administrativo, en vez de remplazar dicha página en la ventana de su navegador. Use el enlace de cierre de la capa superpuesta para volver a esa página. Para más información, consulte las páginas del manual en pantalla sobre el módulo <a href="@overlay">Superposición</a>','es','0','0','0'),('4488','Acceder a la capa de administración superpuesta.','es','0','0','0'),('4489','Ver las páginas administrativas en la capa superpuesta.','es','0','0','0'),('4490','Presenta la interfaz administrativa de Drupal en una capa superpuesta.','es','0','0','0'),('4491','Especifique la ruta existente para la que desea crear un alias; por ejemplo: nodo/28, forum/1, taxonomia/term/1.','es','0','0','0'),('4492','Creando alias','es','0','0','0'),('4493','Los usuarios con <a href="@permissions">permisos</a> suficientes pueden crear alias en la sección opciones de <em>ruta de URL</em> cuando crean o editan contenido. Algunos ejemplos de alias son: ','es','0','0','0'),('4494','<em>miembro/juana-garcia</em> es el alias de la ruta interna <em>user/123</em>','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4495','<em>sobre-nosotros/equipo</em> es el alias de la ruta interna <em>nodo/456</em>','es','0','0','0'),('4496','Gestionando alias','es','0','0','0'),('4497','El módulo Path proporciona una manera de buscar y visualizar una <a href="@aliases">lista de todos los alias</a> que están en uso en su sitio web. Se pueden añadir, editar y eliminar alias a través de esta lista.','es','0','0','0'),('4498','Un alias define un nombre distinto para una ruta de URL ya existente; por ejemplo, el alias ''acerca de'' para la ruta de URL ''node/1''. Una ruta de URL puede tener varios alias.','es','0','0','0'),('4499','Administrar alias de URL','es','0','0','0'),('4500','Crear y editar alias de URL','es','0','0','0'),('4501','Ese alias ya está en uso.','es','0','0','0'),('4502','Especifique de forma opcional una URL alternativa a mediante la que acceder a este término. Use una ruta relativa y no añada la barra final o el alias de URL no funcionará.','es','0','0','0'),('4503','Activando ejecución de PHP en los campos de texto','es','0','0','0'),('4504','USar PHP para la configuración','es','0','0','0'),('4505','El módulo PHP se ha desactivado. Cualquier contenido existente que usase el filtro PHP se verá como texto sin formato. Esto podría ser un riesgo de seguridad al dejar al descubierto información delicada —que se haya usado dentro del código PHP, si ese hubiera sido el caso.','es','0','0','0'),('4506','El módulo de encuestas se puede usar para  crear encuestas o cuestionarios simples que muestran resultados acumulativos. Una encuesta es una buena manera de recibir información de los usuarios del sitio y de los miembros de su comunidad. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@poll">módulo de encuestas</a>.','es','0','0','0'),('4507','Creando una encuesta','es','0','0','0'),('4508','Los usuarios pueden crear una encuesta pulsando en el enlace “Encuesta” en la página de <a href="@add-content">agregar nuevo contenido</a> y escribiendo la pregunta que se plantea, las posibles respuestas y la cantidad de votos de partida para cada opción. También se pueden especificar su estado (activa o cerrada) y duración (la cantidad de tiempo en la que se puede seguir votando).','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4509','Viendo encuestas','es','0','0','0'),('4510','Puede visitar la <a href="@poll">página de encuestas</a>  para consultar las encuestas existentes o activar el bloque de <em>encuestas más recientes</em> en la <a href="@blocks">página de administración de bloques</a>. Para votar en una encuesta concreta o ver sus resultados, puede pulsar sobre el enlace de la encuesta misma.','es','0','0','0'),('4511','Votar en encuestas','es','0','0','0'),('4512','Cancelar y cambiar los propios votos','es','0','0','0'),('4513','Ver resultados de votaciones','es','0','0','0'),('4514','Su voto fue cancelado.','es','0','0','0'),('4515','El módulo Profile permite a los administradores del sitio definir campos personalizados (como país, nombre completo o edad) en los perfiles de usuarios, que luego se muestran en la sección <a href="@user">Mi cuenta</a>. Esto permite a los usuarios de un sitio compartir más información sobre ellos mismos y ayuda a los usuarios de sitios basados en comunidades a organizarse en torno a información concreta.  Para más información, consulte la documentación en línea del<a href="@profile">módulo Profile</a>.','es','0','0','0'),('4516','Añadiendo campos al perfil predeterminado','es','0','0','0'),('4517','Para permitir a los usuarios proporcionar más información sobre si mismos, el módulo Perfil (Profile) permite añadir campos adicionales al perfil de usuario predeterminado. Ejemplos de añadidos usuales son <em>Ubicación, Empresa, Edad</em> o <em>Acerca de mi.</em>','es','0','0','0'),('4518','Páginas de información de usuario','es','0','0','0'),('4519','Bloque de información del autor','es','0','0','0'),('4520','El bloque <em>Información del autor</em> es un bloque prestablecido creado por el módulo Perfil que se puede activar en la <a href="@blocks">página de administración de bloques</a>. Muestra a los visitantes de su sitio información sobre el autor de la página que están leyendo.','es','0','0','0'),('4521','Esta página muestra una lista de los campos de perfil personalizados existentes que se mostrarán en la página <em>Mi Cuenta</em> de un usuario. Para permitir una ordenación, los campos similares o relacionados se pueden agrupar dentro de una categoría. Para añadir una categoría nueva (o editar una ya existente), edite un campo de perfil y proporcione un nombre de categoría nuevo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4522','Enriquece su contenido con metadatos para que otros programas (como motores de búsqueda o agregadores) entiendan mejor sus relaciones y atributos.','es','0','0','0'),('4523','Los módulos de búsqueda activa se han cambiado.','es','0','0','0'),('4524','Debe incluir al menos una palabra clave positiva con uno o más caracteres.','es','0','0','0'),('4525','Debe incluir al menos una palabra clave positiva con @count o más caracteres.','es','4524','1','0'),('4526','El módulo Búsqueda (Search) porporciona la capacidad de indexar y buscar el contenido usando palabras exactas y, en caso de usuarios, por su nombre de usuario o correos electrónicos. Para más información, consulte las páginas de manual sobre el <a href="@search-module">módulo de Búsqueda</a>','es','0','0','0'),('4527','Buscando contenido y usuarios','es','0','0','0'),('4528','Indexando contenido con cron','es','0','0','0'),('4529','Configurando opciones de búsqueda','es','0','0','0'),('4530','El módulo Búsqueda incluye un bloque de <em>fórmulario de búsqueda</em> que se puede activar y configurar en la <a href="@blocks">página de administración de bloques</a>. Este bloque está disponible para los usuarios con permiso para <em>buscar contenido.</em>','es','0','0','0'),('4531','Ampliando el módulo de búsqueda','es','0','0','0'),('4532','<ul>\r\n<li>Verifique que las palabras estén bien escritas.</li>\r\n<li>No encierre la frase entre comillas si desea buscar por cada palabra individualmente. <em>fabulosa búsqueda</em> generalmente devolverá más resultados que <em>&quot;fabulosa búsqueda&quot;</em>.</li>\r\n<li>Considere relajar su búsqueda con <em>OR</em>. <em>fabulosa OR búsqueda</em> generalmente devolverá más resultados que <em>fabulosa búsqueda</em>.</li>\r\n</ul>','es','0','0','0'),('4533','Administrar búsqueda','es','0','0','0'),('4534','Usar búsqueda','es','0','0','0'),('4535','Usar búsqueda avanzada','es','0','0','0'),('4536','Configurar opciones de relevancia para la búsqueda y itras opciones de indexación.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4537','Elija un conjunto de atajos para usar','es','0','0','0'),('4538','Elija un conjunto de atahos para este usuario','es','0','0','0'),('4539','Ahora usted está usando el nuevo conjunto de atajos %set_name. Puede editarlo en esta página o <a href="@switch-url">cambiarlo por otro diferente</a>.','es','0','0','0'),('4540','%user esta usando ahora un conjunto de atajos llamado %set_name. Se puede editar desde esta página.','es','0','0','0'),('4541','Ahora está usando el conjunto de atajos %set_name.','es','0','0','0'),('4542','%user está usando ahora el conjunto de atajos %set_name..','es','0','0','0'),('4543','Cambiar conjunto','es','0','0','0'),('4544','El conjunto de atajos ha sido actualizado.','es','0','0','0'),('4545','Añadir nuevo atajo','es','0','0','0'),('4546','Editando @shorcurt','es','0','0','0'),('4547','El nombre del atajo','es','0','0','0'),('4548','La ruta al atajo','es','0','0','0'),('4549','El enlace debe corresponderse con una ruta válida en el sitio.','es','0','0','0'),('4550','El atajo %link ha sido actualizado.','es','0','0','0'),('4551','Se ha añadido un atajo para %title.','es','0','0','0'),('4552','¿Seguro que desea eliminar el acceso directo %title?','es','0','0','0'),('4553','El acceso directo %title ha sido eliminado.','es','0','0','0'),('4554','No se pudo agregar un acceso directo para %title.','es','0','0','0'),('4555','Añadiendo y eliminando atajos','es','0','0','0'),('4556','Mostrando atajos','es','0','0','0'),('4557','Administrar atajos','es','0','0','0'),('4558','Atajos @shortcut_set','es','0','0','0'),('4559','Agregar a atajos %shortcut_set','es','0','0','0'),('4560','Añadir a atajos','es','0','0','0'),('4561','Eliminar de atajos %shortcut_set','es','0','0','0'),('4562','Eliminar de los atajos','es','0','0','0'),('4563','Editar atajos','es','0','0','0'),('4564','Añadir atajo','es','0','0','0'),('4565','Editar atajo','es','0','0','0'),('4566','Eliminar atajo','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4567','Permitir a los usuarios gestionar las listas personalizables de enlaces de atajos,','es','0','0','0'),('4568','El valor @value es VERDADERO.','es','0','0','0'),('4569','El valor @value es FALSO.','es','0','0','0'),('4570','El valor @value es NULO.','es','0','0','0'),('4571','El valor @value no es NULO.','es','0','0','0'),('4572','El valor "@first" es igual a "@second".','es','0','0','0'),('4573','El valor "@first" no es igual a "@second".','es','0','0','0'),('4574','El valor "@first" es idéntico a "@second".','es','0','0','0'),('4575','El valor "@first" no es idéntico a "@second".','es','0','0','0'),('4576','La prueba no se pudo completar debido a un error irrecuperable.','es','0','0','0'),('4577','Encontrado enlace con la etiqueta %label.','es','0','0','0'),('4578','Enlace con la etiqueta %label no encontrado.','es','0','0','0'),('4579','Enlace con href %href encontrado.','es','0','0','0'),('4580','No se ha encontrado ningún enlace que contenga el destino %href.','es','0','0','0'),('4581','Enlace %label (@url_target) pulsado desde @url_before','es','0','0','0'),('4582','La opción @option para el campo @id está seleccionada.','es','0','0','0'),('4583','La opción @option para el campo @id no está seleccionada.','es','0','0','0'),('4584','De forma predeterminada, SimpleTest eliminará los resultados después de que se hayan mostrado en la página de resultados. Sin embargo, en algunos casos, puede ser útil anotarlos en la base de datos. En ese caso, los resultados se pueden consultar en <em>admin/config/development/testing/[test_id]</em>. El ID de una prueba se puede encontrar en la tabla simpletest de la base de datos y se puede hacer un seguimiento de él al ver los resultados por primera vez. Algunos módulos pueden proporcionar más análisis o características que obliguen a desactivar ésta opción.','es','0','0','0'),('4585','Negociación GSS','es','0','0','0'),('4586','NTLM','es','0','0','0'),('4587','El módulo de Pruebas proporciona un entorno para la realización automatizada de unidades de pruebas . Se puede emplear para verificar el estado operativo de Drupal antes y después de cualquier cambio de código, o como método de que los desarrolladores escriban y ejecuten pruebas para sus módulos. Para más información, consulte el manual en pantalla sobre el <a href="@simpletest">módulo de Pruebas</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4588','Ejecutando pruebas','es','0','0','0'),('4589','Visite la <a href="@admin-simpletest">página de pruebas</a> para ver una lista de las pruebas disponibles. Para una prueba a fondo, seleccione <em>Todas</em> las pruebas o seleccione sólo algunas pruebas concretas si quiere hacer una comprobación más afinada. Tenga en cuenta que la ejecución de todas las pruebas puede llevar algunos minutos. Para más información sobre cómo crear y modificar sus propias pruebas, consulte la <a href="@simpletest-api">documentación de la API de pruebas</a> en el manual de Drupal.','es','0','0','0'),('4590','Administrar pruebas','es','0','0','0'),('4591','La ejecución de la prueba terminó en @elapsed.','es','0','0','0'),('4592','Utilice el botón <em>Limpiar entorno</em> para eliminar archivos y tablas temporales.','es','0','0','0'),('4593','El entorno de pruebas necesita que la restricción PHP <a href="@open_basedir-url">open_basedir</a> esté desactivada. Compruebe la configuración de su servidor web o comúniquese con su alojamiento web.','es','0','0','0'),('4594','El entorno de pruebas no se pudo instalar debido a que la biblioteca PHP <a href="@curl_url">cURL</a> no está disponible.','es','0','0','0'),('4595','El entorno de pruebas no se pudo instalar porque la extensión PHP <a href="@hash_url">hash</a> está desactivada.','es','0','0','0'),('4596','Restricción PHP open_basedir','es','0','0','0'),('4597','desbloquear dirección IP','es','0','0','0'),('4598','bloquear dirección IP','es','0','0','0'),('4599','Gestionando registros','es','0','0','0'),('4600','Viendo el uso del sitio','es','0','0','0'),('4601','El módulo Estadísticas puede ayudarle a conocer detalles de sus  usuarios y cómo usan su sitio. El módulo ofrece cuatro informes:','es','0','0','0'),('4602','<a href="@recent-hits">Accesos recientes</a> muestra información acerca de la actividad más reciente en el sitio, incluyendo la URL y el título de la página que fue accesada, el nombre del usuario (si está disponible) y la dirección IP del visitante.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4603','<a href="@top-referrers">Referentes principales</a> muestra de dónde provienen los visitantes (URL del referente).','es','0','0','0'),('4604','<a href="@top-pages">Páginas principales</a> muestra una lista de páginas ordenadas por la frecuencia con la que se han visitado.','es','0','0','0'),('4605','<a href="@top-visitors">Visitantes principales</a> le muestra quiénes son los visitantes más áctivos en su sitio y le permite expulsar a los visitantes inapropiados.','es','0','0','0'),('4606','Presentando el contenido popular','es','0','0','0'),('4607','Contador de impresiones de página','es','0','0','0'),('4608','Administrar estadísticas','es','0','0','0'),('4609','Ver estadísticas de acceso al contenido','es','0','0','0'),('4610','Ver accesos al contenido','es','0','0','0'),('4611','Controlar detalles sobre qué y cómo se registra en las estadísticas de acceso de su sitio.','es','0','0','0'),('4612','Inicio de sesión en UNIX, Linux y Mac OS X','es','0','0','0'),('4613','Inicio de sesión en Microsoft Windows','es','0','0','0'),('4614','En Microsoft Windows los enlaces se envían siempre al registro de sucesos usando el código <code>LOG_USER</code>.','es','0','0','0'),('4615','Dependiendo de la configuración del sistema, Syslog y otras herramientas de registro usan este código para identificar y filtrar los mensales dentro de todo el registro de sistema.','es','0','0','0'),('4616','El archivo %file no se pugo girar porque la funcion imagerotate() no está disponible en esta instalación de PHP.','es','0','0','0'),('4617','No se ha podido desaturar la imagen %file porque la función imagefilter() no está disponible en esta instalación de PHP.','es','0','0','0'),('4618','Miniatura del tema !theme','es','0','0','0'),('4619','Opciones para el tema !theme','es','0','0','0'),('4620','Desactivar tema !theme','es','0','0','0'),('4621','Establecer !theme como tema predeterminado','es','0','0','0'),('4622','Activar tema !theme','es','0','0','0'),('4623','Activar y establecer como predeterminado','es','0','0','0'),('4624','Activar !theme como tema gráfico predeterminado','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4625','tema predeterminado','es','0','0','0'),('4626','Elija "Tema predeterminado" para usar siempre el mismo tema que el resto del sitio.','es','0','0','0'),('4627','Usar el tema de administración al editar o crear contenido','es','0','0','0'),('4628','El tema %theme ha sido activado.','es','0','0','0'),('4629','El tema %theme no se encontró.','es','0','0','0'),('4630','%theme es el tema predeterminado y no puede ser desactivado.','es','0','0','0'),('4631','El tema %theme ha sido desactivado.','es','0','0','0'),('4632','%theme es ahora el tema predeterminado.','es','0','0','0'),('4633','Estado de verificación de usuario en los comentarios','es','0','0','0'),('4634','Estas opciones sólo existen para los temas basados en el motor de tema %engine.','es','0','0','0'),('4635','El logo no se pudo subir','es','0','0','0'),('4636','El icono de acceso rápido no se pudo subir.','es','0','0','0'),('4637','La ruta al logo personalizado no es válida.','es','0','0','0'),('4638','La ruta al icono de acceso rápido no es válida.','es','0','0','0'),('4639','@module (<span class="admin-missing">incompatible con</span> la version @version)','es','0','0','0'),('4640','Esta versión no es compatible con Drupal !core_version y debe ser reemplazada.','es','0','0','0'),('4641','¿Quiere continuar con lo anterior?','es','0','0','0'),('4642','Especifique una dirección IP válida.','es','0','0','0'),('4643','Esa dirección IP ya está bloqueada.','es','0','0','0'),('4644','No puede bloquear su propia dirección IP.','es','0','0','0'),('4645','La dirección IP %ip ha sido bloqueada.','es','0','0','0'),('4646','¿Seguro que quiere eliminar %ip?','es','0','0','0'),('4647','La dirección IP %ip ha sido eliminada.','es','0','0','0'),('4648','Cömo se use esto depende del tema gráfico de su sitio.','es','0','0','0'),('4649','Cantidad de envíos en la página principal','es','0','0','0'),('4650','El número máximo de envíos que se muestran en las páginas de resúmenes como la página principal.','es','0','0','0'),('4651','Esta página se muestra cuando no se permite al usuario el acceso a un documento. Déjelo en blanco para mostrar una página genérica de "acceso denegado".','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4652','Esta página se muestra cuando no hay contenido que encaje con el documento solicitado. Déjelo vacío para mostrar una página genérica de "página no encontrada".','es','0','0','0'),('4653','Errores y advertencias','es','0','0','0'),('4654','Vaciar todas las cachés','es','0','0','0'),('4655','<strong class="error">Configure el <a href="!file-system">directorio público de archivos</a> para que estas optimizaciones estén disponibles.</strong>','es','0','0','0'),('4656','Optimización de ancho de banda','es','0','0','0'),('4657','Comprimir páginas en caché.','es','0','0','0'),('4658','Ruta del sistema público de archivos','es','0','0','0'),('4659','Una ruta del sistema de archivos local donde se almacenarán los archivos públicos. Este directorio debe existir y Drupal debe poder escribir en él. Este directorio debe ser relativo al directorio de la instalación de Drupal y debe ser accesible desde la web.','es','0','0','0'),('4660','Ruta al sistema privado de archivos','es','0','0','0'),('4661','Una ruta del sistema de archivos local donde se almacenarán los archivos temporales. Este directorio no debe ser accesible desde la web.','es','0','0','0'),('4662','Método predeterminado de descarga','es','0','0','0'),('4663','Esta opción se usa preferentemente como método de descarga. El uso de archivos públicos es más eficiente pero no proporciona ningún control de acceso.','es','0','0','0'),('4664','La descripción de su sitio, incluida en cada canal de noticias.','es','0','0','0'),('4665','Zonas horarias','es','0','0','0'),('4666','Los usuarios pueden establecer su zona horaria.','es','0','0','0'),('4667','Recordar a los usuarios cuando se identifiquen si su zona horaria no se ha especificado .','es','0','0','0'),('4668','Sólo se aplica si los usuarios pueden establecer su propia zona horaria.','es','0','0','0'),('4669','Zona horaria para usuarios nuevos.','es','0','0','0'),('4670','Zona horaria predeterminada.','es','0','0','0'),('4671','Zona horaria vacía.','es','0','0','0'),('4672','Los usuarios pueden establecer su propia zona horaria al registrarse.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4673','No hay tipos de fecha disponibles. <a href="@link">Añadir nuevo tipo de fecha</a>','es','0','0','0'),('4674','Añadir tipo de fecha','es','0','0','0'),('4675','El tipo de fecha sólo ede contener caracteres alfanuméricos y guiones bajos.','es','0','0','0'),('4676','Este tipo de fecha ya existe. Especifique un tipo único.','es','0','0','0'),('4677','Nuevo tipo de fecha añadido satisfactoriamente.','es','0','0','0'),('4678','Pasar el sitio a modo de mantenimiento','es','0','0','0'),('4679','Mensaje del modo de mantenimiento','es','0','0','0'),('4680','Mensaje que se presenta a los visitantes cuando el sitio está desconectado en modo de mantenimiento.','es','0','0','0'),('4681','Utilizar URLs como <code>example.com/user</code> en lugar de <code>example.com/?q=user</code>.','es','0','0','0'),('4682','Necesita: !module-list','es','0','0','0'),('4683','Necesitado por: !module-list','es','0','0','0'),('4684','¿Seguro que quiere eliminar el tipo de fecha %type?','es','0','0','0'),('4685','Eliminado el tipo de fecha %type.','es','0','0','0'),('4686','No hay formatos de fecha personalizados disponibles. href="@link">Agregar formato de fecha</a>.','es','0','0','0'),('4687','Se muestra como','es','0','0','0'),('4688','Se muestra como %date','es','0','0','0'),('4689','Un formato de fecha definido por el usuario. Consulte el <a href="@url">manual de PHP</a> para ver las opciones disponibles.','es','0','0','0'),('4690','Guardar formato','es','0','0','0'),('4691','Este formato ya existe. Indique un nombre de formato único.','es','0','0','0'),('4692','Formato de fecha personalizado actualizado.','es','0','0','0'),('4693','Formato de fecha personalizado añadido.','es','0','0','0'),('4694','Acciones disponibles:','es','0','0','0'),('4695','Crear una acción avanzada','es','0','0','0'),('4696','Una etiqueta única para esta acción avanzada. Esta etiqueta se mostrará en la interfaz de los módulos que se integren con acciones, como el módulo Disparador.','es','0','0','0'),('4697','Se ha borrado %ip','es','0','0','0'),('4698','Tema activado','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4699','Temas activados','es','4698','1','0'),('4700','Tema desactivado','es','0','0','0'),('4701','Debe activar el módulo @required para instalar @module.','es','0','0','0'),('4702','Debe activar los módulos @required para instalar @module.','es','4701','1','0'),('4703','Comodines relacionados con la configuración de todo el sitio y otra información global.','es','0','0','0'),('4704','Comodines relacionados con horas y tiempo.','es','0','0','0'),('4705','Comodines relacionados con los archivos subidos.','es','0','0','0'),('4706','URL (corta)','es','0','0','0'),('4707','La URL de la página principal del sitio, sin el protocolo.','es','0','0','0'),('4708','Formato corto','es','0','0','0'),('4709','Una fecha en formato ''breve'' (%date).','es','0','0','0'),('4710','Formato medio','es','0','0','0'),('4711','Una fecha en formato ''medio'' (%date).','es','0','0','0'),('4712','Formato largo','es','0','0','0'),('4713','Una fecha en formato ''largo'' (%date).','es','0','0','0'),('4714','Una fecha en formato personalizado. Vea !php-date para más detalles.','es','0','0','0'),('4715','La documentación PHP','es','0','0','0'),('4716','Tiempo desde','es','0','0','0'),('4717','Sello temporal sin filtrar','es','0','0','0'),('4718','Una fecha en formato de sello temporal UNIX (%date)','es','0','0','0'),('4719','Gestionando módulos','es','0','0','0'),('4720','Gestionando temas','es','0','0','0'),('4721','Gestionando cachés','es','0','0','0'),('4722','Efectuando mantenimiento del sistema','es','0','0','0'),('4723','Configurando opciones básicas del sitio','es','0','0','0'),('4724','Configurando acciones','es','0','0','0'),('4725','Las acciones son tareas individuales que el sistema puede hacer, como publicar una pieza de contenido o suspender a un usuario. Módulos, como el <a href="@trigger-help">módulo Trigger</a>, pueden activar estas acciones cuando ocurren ciertos eventos del sistema; por ejemplo, cuando se agrega una nueva entrada o cuando un usuario inicia sesión. Los módulos también pueden proporcionar acciones adicionales. Visite la <a href="@actions">página de Acciones</a> para configurar las acciones.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4726','Seleccionar y configurar el tema predeterminado para su sitio web. Hay <a href="@themes">temas</a> alternativos disponibles.','es','0','0','0'),('4727','Descargár <a href="@modules">módulos contribuidos</a> para ampliar el funcionamiento de Drupal.','es','0','0','0'),('4728','Revise e instale regularmente <a href="@updates">las actualizaciones disponibles</a> para mantener un sitio seguro y actualizado. Ejecute el <a href="@update-php">script de actualización</a> siempre que un módulo es actualizado.','es','0','0','0'),('4729','Si está actualizando a una nueva versión de Drupal o actualizando módulos o temas de terceros, puede que tenga que ejecutar el <a href="@update-php">guión de actualización</a>.','es','0','0','0'),('4730','Existen dos tipos de acciones: simples y avanzadas. Las acciones simples no necesitan ninguna configuración adicional y aparecen en esta lista de forma automática. Las acciones avanzadas deben crearse y configurarse antes de poderse usar, ya que incluyen opciones que deben ser especificadas. Por ejemplo, enviar un mensaje de correo electrónico a direcciones específicas, o deshacer la publicación de un contenido que incluya determinadas palabras. Para crear una acción avanzada, seleccione la acción de la lista desplegable que se muestra en la parte inferior y haga clic en el botón <em>Crear</em>.','es','0','0','0'),('4731','Administrar módulos','es','0','0','0'),('4732','Administrar configuración del sitio','es','0','0','0'),('4733','Administrar temas','es','0','0','0'),('4734','Administrar acciones','es','0','0','0'),('4735','Usar las páginas y ayuda de administrción','es','0','0','0'),('4736','Usar el sitio en modo de mantenimiento','es','0','0','0'),('4737','Ver informes del sitio','es','0','0','0'),('4738','Bloquear direcciones IP','es','0','0','0'),('4739','Archivos públicos','es','0','0','0'),('4740','Archivos locales públicos servidos por el servidor web.','es','0','0','0'),('4741','Archivos privados locales servidos por Drupal.','es','0','0','0'),('4742','Archivos temporales','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4743','Archivos locales temporales para subidas y vistas previas.','es','0','0','0'),('4744','Actualizar módulos','es','0','0','0'),('4745','Actualizar temas','es','0','0','0'),('4746','SSH','es','0','0','0'),('4747','Su contraseña no se guarda en la base de datos y sólo se usa para establecer una conexión.','es','0','0','0'),('4748','Se creará la conexión entre su servidor de web y la máquina en donde están los archivos del servidor web. En la gran mayoría de los casos, esta será la misma máquina y "localhost" es correcto.','es','0','0','0'),('4749','Configurar las <a href="@user-edit">opciones de zona horaria de su cuenta de usuario</a>.','es','0','0','0'),('4750','Seleccione la zona horaria local deseada. Las fechas y horas dentro del sitio se mostrarán usando esta zona horaria.','es','0','0','0'),('4751','Si es posible, su elección de zona horaria se detectará automáticamente. Confirme la selección y pulse guardar.','es','0','0','0'),('4752','Ayuda del sistema','es','0','0','0'),('4753','La carpeta %directory no existe y no se pudo crear.','es','0','0','0'),('4754','El directorio %directory existe pero ni se puede escribir en él ni se puede cambiar a ese estado.','es','0','0','0'),('4755','El mensaje que se mostrará al usuario identificado en ese momento. Puede incluir comodines como  [node:title], [user:name], y [comment:body] para representar datos que variarán dependiendo de cuando los envíe el sistema. No todos los comodines están disponibles para todos los casos.','es','0','0','0'),('4756','@zone: @date','es','0','0','0'),('4757','Funciona con <a href="@poweredby">Drupal</a>','es','0','0','0'),('4758','AHAH callback','es','0','0','0'),('4759','Administrar bloques, tipos de contenido, menús, etc.','es','0','0','0'),('4760','Seleccionar y configurar su tema','es','0','0','0'),('4761','Activar tema','es','0','0','0'),('4762','Desactivar tema','es','0','0','0'),('4763','Establecer tema predefinido','es','0','0','0'),('4764','Configurar las opciones predeterminadas y específicas de los temas.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4765','Bloqueo de dirección IP','es','0','0','0'),('4766','Gestionar direcciones IP bloqueadas.','es','0','0','0'),('4767','Borrar dirección IP','es','0','0','0'),('4768','Herramientas multimedia','es','0','0','0'),('4769','Herramientas relacionadas con servicios web.','es','0','0','0'),('4770','Configurar la descripcion del sitio web. la cantidad de elementos por canal de noticias y si estos canales deben ser títulos, resúmenes o todo el texto completo.','es','0','0','0'),('4771','Herramientas de desarrollo.','es','0','0','0'),('4772','Modo de mantenimiento','es','0','0','0'),('4773','Desconectar el sitio para su mantenimiento o volverlo a conectar.','es','0','0','0'),('4774','Registro y errores','es','0','0','0'),('4775','Opciones para los módulos de registro y alertas. Distintos módulos pueden enfocar diferentes sucesos del sistema a diversos destinos, como el registro del sistema, la base de datos, un correo electrónico, etc...','es','0','0','0'),('4776','Regional e idioma','es','0','0','0'),('4777','Configuración regional y traducción.','es','0','0','0'),('4778','Opciones para la zona horaria y país predeterminados del sitio.','es','0','0','0'),('4779','Configurar formatos de presentación para fecha y hora.','es','0','0','0'),('4780','Añadir nuevo tipo de fecha.','es','0','0','0'),('4781','eliminar tipo de fecha','es','0','0','0'),('4782','Permitir a los usuarios eliminar un tipo de fecha configurado.','es','0','0','0'),('4783','Configurar formato de cadenas para fecha y hora.','es','0','0','0'),('4784','Editar formato de fecha','es','0','0','0'),('4785','Permite a los usuarios editar un formato de fecha configurado.','es','0','0','0'),('4786','Búsqueda y meta datos','es','0','0','0'),('4787','Búsqueda interna del sitio, meta datos y SEO.','es','0','0','0'),('4788','Configuración relacionada con el sistema general.','es','0','0','0'),('4789','Herramientas que mejoran la interfaz de usuario.','es','0','0','0'),('4790','Flujo de trabajo del contenido, herramientas del flujo de trabajo editorial.','es','0','0','0'),('4791','Autoría del contenido','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4792','Opciones relacionadas con formato y autoría de contenido.','es','0','0','0'),('4793','El servidor !host ya no está bloqueado porque no es una dirección IP válida.','es','0','0','0'),('4794','Permisos para la ID de rol !id insertados en {role_permission}','es','0','0','0'),('4795','%profile_name (%profile-%version)','es','0','0','0'),('4796','más información','es','0','0','0'),('4797','Para ejecutar cron fuera del sitio, vaya a <a href="!cron">!cron</a>','es','0','0','0'),('4798','Su configuración ha sido guardada.','es','0','0','0'),('4799','No hay vocabularios disponibles. <a href="@link">Agregar vocabulario</a>.','es','0','0','0'),('4800','No hay términos disponibles. <a href="@link">Agregar término</a>.','es','0','0','0'),('4801','Actualemente no hay contenido clasificado con este término.','es','0','0','0'),('4802','Comodines relacionados con términos de taxonomía.','es','0','0','0'),('4803','Comodines relacionados con los vocabularios de taxonomía.','es','0','0','0'),('4804','Creando vocabularios','es','0','0','0'),('4805','<em>vocabulario</em>: Música','es','0','0','0'),('4806','<em>término</em>: Jazz','es','0','0','0'),('4807','<em>subtérmino</em>: Swing','es','0','0','0'),('4808','<em>subtérmino</em>: Fusión','es','0','0','0'),('4809','<em>término</em>: Rock','es','0','0','0'),('4810','<em>subtérmino</em>: Country rock','es','0','0','0'),('4811','<em>subtérmino</em>: Hard rock','es','0','0','0'),('4812','Puede asignar un subtérmino a varios padres; por ejemplo: <em>fusión</em> se puede asignar a <em>rock</em> y a <em>jazz</em>.','es','0','0','0'),('4813','Los términos en un <em>vocabulario de etiquetado libre</em> se pueden construir gradualmente al crear o editar contenido. Esto se suele hacer para aplicaciones de blogs o fotografía.','es','0','0','0'),('4814','Asignando vocabularios a tipos de contenido','es','0','0','0'),('4815','Clasificando contenido','es','0','0','0'),('4816','Después que el vocabulario se asigne al tipo de contenido, puede comenzar a clasificar el contenido. El campo con los términos aparecerá en la pantalla de edición de contenido cuando usted edite o <a href="@addnode">agregue un nuevo contenido</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4817','Ver los lostados y los canales de noticias RSS por término','es','0','0','0'),('4818','Cada término de taxonomía proporciona automáticamente una página enumerando el contenido que tenga su clasificación y un canal de noticias RSS correspondiente; por ejemplo: Si el término de taxonomía <em>country rock</em> tiene un ID 123 (lo que puede ver mirando la URL que sale cuando pasa el cursor sobre el término enlazado, que se puede pulsar para navegar a la página con el listado), verá esa lista en la ruta <em>taxonomy/term/123</em>. El canal de noticias RSS usará la ruta <em>taxonomy/term/123/feed</em> (el icono RSS para el listado de este término se mostrará de forma automática en la barra de direcciones de su navegador al visitar la página del listado).','es','0','0','0'),('4819','Ampliando el módulo de taxonomía','es','0','0','0'),('4820','Existen <a href="@taxcontrib">bastantes módulos de terceros</a> que amplían el comportamiento del módulo Taxonomía en la presentación y organización de términos.','es','0','0','0'),('4821','La taxonomía se usa para categorizar el contenido. Los términos se agrupan en vocabularios; por ejemplo: Un vocabulario llamado "fruta" contendría términos como "manzana" y "plátano".','es','0','0','0'),('4822','Puede reorganizar los términos en %capital_name usando sus iconos de arrastrar y soltar, y agrupar términos bajo un término padre deslizándolos debajo y a la derecha del padre.','es','0','0','0'),('4823','Los %capital_name contienen términos agrupados bajo sus términos padres. Puede reorganizar los términos de %capital_name usando sus iconos de arrastrar y soltar.','es','0','0','0'),('4824','Administrar vocabularios y términos','es','0','0','0'),('4825','Editar términos en %vocabulary','es','0','0','0'),('4826','Eliminar términos de %vocabulary','es','0','0','0'),('4827','Página de términos de taxonomía','es','0','0','0'),('4828','Referencia de término','es','0','0','0'),('4829','Este campo almacena una referencia a un término de taxonomía.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4830','Control de autocompletar término (etiquetado)','es','0','0','0'),('4831','El vocabulario que proporciona las opciones para este campo.','es','0','0','0'),('4832','El módulo Barra de Herramientas presenta los enlaces de los elementos de menú administrativos de nivel superior y los enlaces de otros módulos en la zona superior de la pantalla. Para más información, consulte el manual en pantalla sonbre el módulo <a href="@toolbar">Barra de Herramientas</a>.','es','0','0','0'),('4833','Mostrando enlaces administrativos','es','0','0','0'),('4834','Usar la barra de herramientas de administración','es','0','0','0'),('4835','Alternar visibilidad del cajón','es','0','0','0'),('4836','Proporciona una barra de herramientas que muestra los elementos de menú de administración y los enlaces de otros módulos.','es','0','0','0'),('4837','El módulo de Seguimiento (Tracker) presenta el contenido añadido o actualizado más recientemente en su sitio, y le permite seguir el contenido nuevo creado por cada usuario. Este módulo no tiene opciones de configuración. Para más información, vea las páginas del manual en pantalla sobre el <a href="@tracker">módulo de Seguimiento</a>.','es','0','0','0'),('4838','El módulo Seguimiento agrega un nuevlo elemento de menú al menú de navegación llamado <em>Contenido reciente</em>. Pued econfigurar los elementos de mení a través de la página de <a href="@menus">administración de menús</a>.','es','0','0','0'),('4839','Monitorizando el contenido nuevo y actualizado del sitio','es','0','0','0'),('4840','La página de <a href=''@recent''>Contenido reciente</a> muestra contenido nuevo y actualizado en orden cronológico inverso, listando el tipo de contenido, título, nombre del autor, número de comentarios, y hora de la última actualización. El contenido se considera actualizado cuando ocurren cambios en el texto, o cuando se agregan nuevos comentarios. La solapa<em>Mi contenido reciente</em> limita las listas al usuario actualmente identificado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4841','Seguimiento de contenido por usuario concreto','es','0','0','0'),('4842','Para seguir el contenido nuevo o actualizado de un usuario concreto, seleccione la sopapa <em>Seguimiento</em> en la página del perfil de ese usuario.','es','0','0','0'),('4843','Todo el contenido reciente','es','0','0','0'),('4844','Mi contenido reciente','es','0','0','0'),('4845','Monitorizar contenido','es','0','0','0'),('4846','Activa el seguimiento del contenido reciente para los usuarios.','es','0','0','0'),('4847','El módulo de Traducción de contenido (Content translation) permite la traducción del contenido a distintos idiomas. Trabajando junto al <a href="@locale">módulo Regionalización</a> (Locale) (que gestiona los idiomas instalados y permite la traducción de la interfaz del sitio), el módulo de Traducción de contenido es esencial en la creación y mantenimiento del contenido traducido del sitio. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@translation">módulo de Traducción de contenido</a>.','es','0','0','0'),('4848','Configurando tipos de contenido para traducción','es','0','0','0'),('4849','To configure a particular content type for translation, visit the <a href="@content-types">Content types</a> page, and click the <em>edit</em> link for the content type. In the <em>Publishing options</em> section, select <em>Enabled, with translation</em> under <em>Multilingual support</em>.','es','0','0','0'),('4850','Asignando idioma al contenido','es','0','0','0'),('4851','Usar el menú desplegable de <em>Idioma</em> para seleccionar el idioma apropiado al crear o editar contenido.','es','0','0','0'),('4852','Traduciendo contenido','es','0','0','0'),('4853','Los usuarios con el permiso de <em>Traducir contenido</em> pueden traducir el contenido siempre que ese tipo de contenido se haya configurado de modo que se pueda traducir. Para traducir un contenido, seleccione la solapa <em>Traducción</em> al ver es econtenido','es','0','0','0'),('4854','Manteniendo traducciones','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4855','Si la edición del contenido en un idioma necesitase que las versiones traducidas se actualizasen también para reflejar el cambio, use la casilla <em>Marcar traducciones como caducadas</em> para indicar que las traducciones no están al día y necesitan revisarse. Las traducciones individuales también se pueden marcar para su revisión seleccionando la casilla "Esta traducción necesita actualizarse" en el formulario de edición de la traducción.','es','0','0','0'),('4856','Traducir contenido','es','0','0','0'),('4857','Ya existe una traducción en este idioma.','es','0','0','0'),('4858','Disparador: !description','es','0','0','0'),('4859','No hay acciones disponibles para este disparador. <a href="@link">Añadir acción</a>.','es','0','0','0'),('4860','Falta/no está definida la acción de guardado (%save_aid) para la acción %aid.','es','0','0','0'),('4861','Se ha adjuntado la acción %label, lo que es necesario para guardar el cambio de propiedad.','es','0','0','0'),('4862','la acción %label ha sido trasladada para guardar el cambio de propiedad.','es','0','0','0'),('4863','El módulo Disparador (Trigger) proporciona la capacidad de que ciertas acciones se ejecuten cuando algunos <em>disparadores</em> aparecen en su sitio. Esos disparadores son sucesos como la adición de nuevo contenido, el inicio de sesión de un usuario. Las acciones son tareas como la retirada de la publicación de contenidos o el envío de un correo electrónico a un administrador. para más información, consulte las páginas del manual en pantalla sobre el <a href="@trigger">módulo Disparador.</a>','es','0','0','0'),('4864','Configurando disparadores y acciones','es','0','0','0'),('4865','Después de guardar nuevo contenido o de actualizar contenido existente.','es','0','0','0'),('4866','Después de guardar contenido actualizado','es','0','0','0'),('4867','Al guardar contenido nuevo o al actualizar uno ya existente.','es','0','0','0'),('4868','Después de crear una nueva cuenta de usuario.','es','0','0','0'),('4869','Después de actualizar una cuenta de usuario','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4870','Configurar cuándo ejecutar acciones.','es','0','0','0'),('4871','Instalando actualizaciones','es','0','0','0'),('4872','Preparando la actualización de su sitio','es','0','0','0'),('4873','Instalando %project','es','0','0','0'),('4874','Preparandose a instalar','es','0','0','0'),('4875','Error al instalar o actualizar','es','0','0','0'),('4876','Se ha instalado %project_name con éxito','es','0','0','0'),('4877','La actualización se completó correctamente. Su sitio ya no está en modo de mantenimiento.','es','0','0','0'),('4878','La actualización se terminó correctamente.','es','0','0','0'),('4879','¡La actualización ha fallado! Consulte el registro a continuación para más detalles.','es','0','0','0'),('4880','¡La actualización ha fallado! Consulte el registro a continuación para más detalles. Su sitio está aun en modo de mantenimiento.','es','0','0','0'),('4881','La actualización se terminó correctamente. Su sitio ya no está en modo de mantenimiento.','es','0','0','0'),('4882','La instalación se completó correctamnente.','es','0','0','0'),('4883','¡La actualización ha fallado! Consulte el registro a continuación para más detalles.','es','0','0','0'),('4884','¡La actualización ha fallado! Consulte el registro a continuación para más detalles. Su sitio está aun en modo de mantenimiento.','es','0','0','0'),('4885','No se pudo acceder a los datos de actualización disponibles.','es','0','0','0'),('4886','No hay datos de actualización disponibles','es','0','0','0'),('4887','Comprobando datos de actualización disponibles','es','0','0','0'),('4888','Intentando comprobar los datos de actualización disponibles ...','es','0','0','0'),('4889','Error al comprobar los datos de actualización disponibles.','es','0','0','0'),('4890','Comprobando los datos de actualización disponibles ...','es','0','0','0'),('4891','datos de actualización disponibles para %title comprobados.','es','0','0','0'),('4892','No se pudieron comprobar los datos de actualización disponibles para %title.','es','0','0','0'),('4893','Sucedió un error al intentar acceder a los datos de actualización disponibles.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4894','Comprobados los datos de actualización disponibles para un proyecto.','es','0','0','0'),('4895','Comprobados los datos de actualización disponibles para @count proyectos.','es','4894','1','0'),('4896','No se pudieron conseguir los datos de actualización disponibles para un proyecto.','es','0','0','0'),('4897','No se pudieron conseguir los datos de actualización disponibles para @count proyectos.','es','4896','1','0'),('4898','Hubo un problema para conseguir la información de actualización. Vuelva a intentarlo más tarde.','es','0','0','0'),('4899','(Tema)','es','0','0','0'),('4900','(notas de la versión)','es','0','0','0'),('4901','Esta actualización es un cambio relevante de versión, lo que significa que no tiene compatibilidad reversible con la versión que tiene funcionando actualmente. Se le recomienda que lea las notas de la versión y que continue sólo bajo su propia responsabilidad.','es','0','0','0'),('4902','(Actualización de seguridad)','es','0','0','0'),('4903','(Sin mantenimiento)','es','0','0','0'),('4904','Todos los proyectos están actualizados.','es','0','0','0'),('4905','Descargar estas actualizaciones','es','0','0','0'),('4906','Hacen falta actualizaciones manuales','es','0','0','0'),('4907','Las actualizaciones del núcleo de Drupal no tienen mantenimiento en este momento.','es','0','0','0'),('4908','Debe seleccionar al menos un proyecto para actualizar.','es','0','0','0'),('4909','Descargando actualizaciones','es','0','0','0'),('4910','Preparando la descarga de las actualizaciones seleccionadas','es','0','0','0'),('4911','Falló la descarga de las actualizaciones:','es','0','0','0'),('4912','Actualizaciones descargadas correctamente.','es','0','0','0'),('4913','Error irrecuperable al intentar descargar.','es','0','0','0'),('4914','Haga una copia de seguridad de su sitio y base de datos antes de proseguir. <a href="@backup_url">Aprenda cómo</a>.','es','0','0','0'),('4915','Realizar las actualizaciones con el sitio en modo de mantenimiento (se recomienda vivamente).','es','0','0','0'),('4916','Instalar desde una URL','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4917','Por ejemplo: %url','es','0','0','0'),('4918','Subir un archivo de módulo o tema para instalar','es','0','0','0'),('4919','Por ejemplo: %filename desde su máquina local.','es','0','0','0'),('4920','Debe indicar una URL o subir un archivo al servidor para la instalación.','es','0','0','0'),('4921','La URL especificada no es válida.','es','0','0','0'),('4922','No se pudo recuperar un proyecto de Drupal de %url.','es','0','0','0'),('4923','El archivo proporcionado no contiene documentos.','es','0','0','0'),('4924','No se pudo determinar el nombre de %project.','es','0','0','0'),('4925','%project ya está instalado.','es','0','0','0'),('4926','No se pudo extraer %file. No es un archivo válido.','es','0','0','0'),('4927','Descargando %project','es','0','0','0'),('4928','No se pudo descargar %project de %url','es','0','0','0'),('4929','Incluye:','es','0','0','0'),('4930','Activado: %includes','es','0','0','0'),('4931','Desactivado: %disabled','es','0','0','0'),('4932','%base_theme (!base_label)','es','0','0','0'),('4933','Depende de: !basethemes','es','0','0','0'),('4934','Necesario para: %subthemes','es','0','0','0'),('4935','El modulo de actualización comprueba periódicamente la existencia de nuevas versiones para el código de su sitio (incluyendo los módulos y temas contribuidos por terceros) y advierte a los administradores de su existencia. Para obtener la información necesaria de actualización, se envían estadísticas anónimas a Drupal.org. Si lo desea, puede desactivar el módulo gestor de actualizaciones desde la <a href=''@modules''>página de administración de módulos</a>. Para más información, consulte las páginas del manual en pantalla sobre el <a href=''@update''>Módulo gestor de actualizaciones </a>.','es','0','0','0'),('4936','El gestor de actualizaciones también permite a los administradores actualizar e instalar módulos y temas por medio de la interfaz de administración.','es','0','0','0'),('4937','Buscando actualizaciones disponibles','es','0','0','0'),('4938','Un informe sobre las <a href="@update-report">actualizaciones disponibles</a> le avisará cuando haya nuevas versiones disponibles para su descarga. Puede configurar las opciones de frecuencia de comprobación de actualizaciones (que se realizan al ejecutar <a href="@cron">cron</a>) y de los avisos por correo electrónico en la página de <a href="@update-settings">opciones del gestor de actualizaciones</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4939','Actualizando a través de la interfaz de usuario','es','0','0','0'),('4940','El modulo gestor de actualizaciones permite a los administradores realizar actualizaciones directamente a través de la interfaz de administración. En la parte superior de las páginas de <a href="@modules_page">módulos</a> y <a href="@themes_page">temas</a> verá un enlace para actualizarse a las nuevas versiones. Éste enlace lo llevará a la <a href="@update-page">página de actualizaciones</a>, donde verá una lista de las actualizaciones pendientes y podrá confirmar cuáles quiere efectuar. Desde allí, se le pedirá su clave FTP/SSH, tras lo cual se transferirán los archivos a su instalación de Drupal, sobrescribiendo los antiguos. Instrucciones más detalladas están disponibles en el <a href="@update">manual en pantalla</a>.','es','0','0','0'),('4941','Instalando nuevos módulos y temas a través de la interfaz de usuario','es','0','0','0'),('4942','También puede instalar del mismo modo nuevos módulos y temas a través de la <a href="@install">página de instalación</a>, o pulsando sobre el enlace <em>instalar nuevo módulo/tema</em>, en la parte superior de las páginas de <a href="@modules_page">módulos</a> y <a href="@themes_page">temas</a>. En ese caso, se le pedirá que proporcione la URL de la descarga o que suba desde su máquina una versión.','es','0','0','0'),('4943','No hay información de actualización disponible. Ejecutar <a href="@run_cron">cron</a> o <a href="@check_manually">comprobar manualmente</a>.','es','0','0','0'),('4944','Puede instalar automáticamente las actualizaciones que le faltan usando el gestor de actualizaciones:','es','0','0','0'),('4945','Su sitio está actualmente configurado para enviar estos correos electrónicos cuando haya actualizaciones disponibles. para recibir avisos únicamente de las actualizaciones de seguridad, !url.','es','0','0','0'),('4946','Su sitio está configurado para enviar estos correos electrónicos sólo cuando hay disponibles actualizaciones de seguridad. Para recibir avisos de cualquier actualización disponible, !url.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4947','La versión instalada de al menos uno de los módulos o temas ya no tiene mantenimiento. Se le recomienda vivamente actualizarlo o desactivarlo. Consulte la página del proyecto para más detalles.','es','0','0','0'),('4948','Hubo un problema al intentar comprobar las <a href="@update-report">actualizaciones disponibles</a> para Drupal.','es','0','0','0'),('4949','Hubo un problema en la comprobación de las <a href="@update-report">actualizaciones disponibles</a> para sus módulos o temas.','es','0','0','0'),('4950','Consulte la página de <a href="@available_updates">actualizaciones disponibles</a> para más información e instalar las actualizaciones pendientes.','es','0','0','0'),('4951','Listo para actualizar','es','0','0','0'),('4952','Gestor de actualización','es','0','0','0'),('4953','Comprueba las actualizaciones disponibles y puede instalar módulos y temas de forma segura a través de una interfaz web.','es','0','0','0'),('4954','No hay personas disponibles.','es','0','0','0'),('4955','Este rol recibirá nuevos permisos de forma automática cada vez que se active un módulo. Cambiar esta opción no alterará los permisos ya existentes.','es','0','0','0'),('4956','Creación y cancelación de cuentas','es','0','0','0'),('4957','¿Quién puede crear cuentas?','es','0','0','0'),('4958','Sólo los administradores','es','0','0','0'),('4959','Visitantes, pero es necesaria la aprobación de los administradores','es','0','0','0'),('4960','Pedir una verificación por correo electrónico sólo cuando un visitante crea una cuenta.','es','0','0','0'),('4961','Se obligará a los nuevos usuarios a validar su dirección de correo electrónico antes de iniciar sesión en el sitio y se les asignará una clave creada por el sistema. Cuando esta opción se desactiva, los usuarios iniciarán sesión nada más registrarse y podrán seleccionar su propia clave durante el proceso de registro.','es','0','0','0'),('4962','Al cancelar una cuenta de usuario','es','0','0','0'),('4963','Los usuarios con los <a href="@permissions-url">permisos</a> de %select-cancel-method o %administer-users pueden anular este método predeterminado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4964','Seleccionar el método para cancelar la cuenta.','es','0','0','0'),('4965','Administrar usuarios','es','0','0','0'),('4966','Personalización','es','0','0','0'),('4967','Permitir firmas.','es','0','0','0'),('4968','El directorio %directory no existe o no se puede escribir en él.','es','0','0','0'),('4969','Activar imágenes de usuario.','es','0','0','0'),('4970','Directorio de imágenes','es','0','0','0'),('4971','Estilo de presentación de imagen','es','0','0','0'),('4972','El estilo seleccionado se usará en la presentación y la imagen original se mantendrá. Los estilos se pueden configurar en el área de administración</a> de <a href="!url">estilos de imagen</a>.','es','0','0','0'),('4973','Dimensiones de imágen a subir','es','0','0','0'),('4974','Tamaño de archivo de imagen a subir','es','0','0','0'),('4975','Correos electrónicos','es','0','0','0'),('4976','Bienvenida (nuevo usuario creado por un administrador)','es','0','0','0'),('4977','Editar los correos electrónicos de bienvenida que se envían a los nuevos miembros de cuentas creadas por un administrador.','es','0','0','0'),('4978','Bienvenida (pendiente de aprobación)','es','0','0','0'),('4979','Editar los mensajes de bienvenida que se envían a los nuevos miembros cuando hace falta aprobación administrativa.','es','0','0','0'),('4980','Bienvenida (sin necesidad de aprobación)','es','0','0','0'),('4981','Editar los mensajes de correo electrónico que se envían a los nuevos miembros cuando se registran cuando no hace falta aprobación de los administradores.','es','0','0','0'),('4982','Recuperación de clave','es','0','0','0'),('4983','Editar los mensajes de correo electrónico que se envían a los usuarios cuando solicitan una nueva clave.','es','0','0','0'),('4984','Activación de cuenta','es','0','0','0'),('4985','Activar y editar los mensajes de correo electrónico que se envían a los usuarios al activar su cuenta (cuando un administrador activa la cuenta de un usuario que ya se ha registrado en un sitio donde la aprobación administrativa del registro es necesaria).','es','0','0','0');
INSERT INTO `locales_target` VALUES ('4986','Activar y editar los mensajes de correo electrónico que se envían a los usuarios cuando sus cuentas quedan bloqueadas.','es','0','0','0'),('4987','Confirmación de cancelación de cuenta','es','0','0','0'),('4988','Editar los mensajes de correo electrónico que se envían a los usuarios cuando intentan cancelar sus cuentas.','es','0','0','0'),('4989','Cuenta cancelada','es','0','0','0'),('4990','Activar y editar los mensajes de correo electrónico que se envían a los usuarios cuando se cancelan sus cuentas.','es','0','0','0'),('4991','Avisar al usuario cuando se cancela la cuenta.','es','0','0','0'),('4992','El nombre de rol %name ya existe. Elija otro nombre de rol.','es','0','0','0'),('4993','Ha iniciado sesión como %user. <a href="!user_edit">Cambie su contraseña.</a>','es','0','0','0'),('4994','Otro usuario (%other_user) ya se ha identificado en el sitio en esta máquina, pero usted ha intentado usar un enlace de inicio de sesión para el usuario %resetting_user. Por favor, <a href="!logout">cierre sesión</a> e intente usar el enlace de nuevo.','es','0','0','0'),('4995','El enlace de inicio de sesión de un sólo uso que ha pulsado no es válido.','es','0','0','0'),('4996','Ya ha usado el enlace para iniciar sesión válido para un solo uso. Ya no hace falta que lo use para identificarse. Cambie su clave, por favor.','es','0','0','0'),('4997','<p>Este es un inicio de sesión de un solo uso para %user_name y caducará en %expiration_date.</p><p>Pulse este botón para iniciar sesión en el sitio y cambiar su contraseña.</p>','es','0','0','0'),('4998','Ha intentado usar un enlace para inicio de sesión de un solo uso qque ya no es válido o ha sido usado. Por favor, pida uno nuevo usando el siguiente formulario.','es','0','0','0'),('4999','Al cancelar su cuenta','es','0','0','0'),('5000','Al cancelar la cuenta','es','0','0','0'),('5001','Es necesaria una confirmación por correo electrónico para cancelar la cuenta.','es','0','0','0'),('5002','Si se activa, el usuario debe confirmar por correo electrónico. la cancelación de la cuenta.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5003','Al activarse, el usuario recibirá un aviso por correo electrónico después de que la cuenta haya sido cancelada.','es','0','0','0'),('5004','¿Seguro que quiere cancelar la cuenta?','es','0','0','0'),('5005','¿Seguro que quiere cancelar la cuenta %name?','es','0','0','0'),('5006','Seleccione el método para cancelar la cuenta de arriba.','es','0','0','0'),('5007','Se ha enviado a su dirección de correo electrónico una confirmación de petición de cancelación de su cuenta.','es','0','0','0'),('5008','Su cuenta ha sido bloqueada y ya no podrá iniciar sesión. Todo su contenido quedará atribuido a su nombre de usuario.','es','0','0','0'),('5009','Su cuenta quedará bloqueada y ya no podrá iniciar sesión. Todo el contenido quedará oculto para todo el mundo salvo los administradores.','es','0','0','0'),('5010','Su cuenta se eliminará y se borrará toda la información de esa cuenta. Todo la autoría de su contenido se asignará al usuario %anonymous-name.','es','0','0','0'),('5011','Su cuenta se eliminará y se borrará toda la información de esa cuenta. Todo el contenido creado por usted será eliminado.','es','0','0','0'),('5012','Ha intentado usar un enlace de cancelación de cuenta que ha caducado. Por favor, pida uno nuevo usando el formulario a continuación.','es','0','0','0'),('5013','Enviada la petición de cancelación de cuenta a %name %email.','es','0','0','0'),('5014','Comodines relacionados con cuentas individuales de usuario.','es','0','0','0'),('5015','comodines relacionados con el usuario actualmente identificado.','es','0','0','0'),('5016','El módulo Usuario (User) permite a los usuarios registrarse e iniciar sesión y cerrarla. También permite a aquellos usuarios que tienen los permisos necesarios gestionar los roles de usuario (que se usan para clasificar usuarios) y los permisos asociados con esos roles. Para más información, consulte las páginas del manual en pantalla sobre el <a href="@user">módulo usuario</a>.','es','0','0','0'),('5017','Creando y gestionando usuarios','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5018','El módulo Usuario permite a los usuarios con los <a href="@permissions">permisos</a> apropiados crear cuentas de usuario a través de la página de <a href="@people">administración de personas</a>, donde también pueden asignar uno o más roles a los usuarios y bloquear cuentas de usuario. Si se permite, los usuarios sin cuenta (usuarios anónimos) pueden crear sus propias cuentas en la página <a href="@register">crear nueva cuenta</a>.','es','0','0','0'),('5019','Roles y permisos de usuarios','es','0','0','0'),('5020','Los <em>roles</em> se usan para agrupar y clasificar usuarios. A cada usuario se puede asignar uno o más roles. De partida hay dos roles: <em>Usuario anónimo</em> (un visitante que no se ha identificado iniciando sesión como usuario) y <em>usuario registrado</em> (usuarios que se han inscrito y que sí han iniciado sesión identificándose como usuarios). Dependiendo de las opciones que eligió cuando instaló Drupal, se pueden haber definido más roles durante el proceso de instalación y puede crear más roles en la <a href="@roles">página de roles</a>. Después de crear roles, puede especificar permisos para cualquier rol en la <a href="@permissions_user">página de permisos</a>. La concesión de un permiso capacita a los usuarios con un rol concreto realizar una acción en el sitio, como por ejemplo poder ver un tipo de contenido, crear o editar contenido, administrar opciones de un módulo concreto o ser capaz de usar una función concreta del sitio (como las búsquedas).','es','0','0','0'),('5021','La página de configuración de cuenta</a> le permite gestionar las opciones del nombre que se muestra para el rol de usuario anónimo, los formularios de contacto personales, el registro de usuarios y la cancelación de cuentas. En esta página también puede gestionar las opciones de personalización de cuentas (incluyendo las firmas y las imágenes de usuarios) y adaptar el texto de los mensajes de correo electrónico que se envían automáticamente durante el proceso de inscripción como usuario).','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5022','De forma predefinida, Drupal viene con dos roles de usuario:','es','0','0','0'),('5023','Usuario anónimo: este rol se emplea para los usuarios que no tienen cuenta o que no se han identificado.','es','0','0','0'),('5024','Usuario registrado: este rol es el que se asigna automáticamente a todos los usuarios que inician sesión.','es','0','0','0'),('5025','Este formulario permite a los administradores añadir, editar y reordenar los campos para almacenar datos de los usuarios.','es','0','0','0'),('5026','Este formulario permite a los administradores configurar cómo se deben mostrar los campos al presentar una página de perfil de usuario.','es','0','0','0'),('5027','Elemento del formulario de la zona horaria del módulo de usuario.','es','0','0','0'),('5028','Elemento de vista de historial del módulo de usuario.','es','0','0','0'),('5029','Administrar permisos','es','0','0','0'),('5030','Ver pefiles de usuario','es','0','0','0'),('5031','Cambiar nombre de usuario propio','es','0','0','0'),('5032','Cancelar cuenta propia','es','0','0','0'),('5033','Advertencia: El contenido se puede conservar, retirar de la publicación o transferirse al usuario %anonymous-name dependiendo de la configuración de las <a href="@user-settings-url">opciones de usuario</a>.','es','0','0','0'),('5034','Seleccionar el método de cancelación de la propia cuenta','es','0','0','0'),('5035','Se permiten espacios en blanco. Salvo los puntos, guiones cortos, apóstrofos y guiones bajos, no se permiten signos de puntuación.','es','0','0','0'),('5036','La firma es demasiado larga: Debe tener %max caracteres o menos.','es','0','0','0'),('5037','Lo sentimos. Ha habido demasiados intentos de identificación desde su dirección IP. Esta dirección IP ha quedado temporalmente bloqueada. Vuelva a intentarlo más tarde o <a href="@url">solicite una nueva clave</a>.','es','0','0','0'),('5038','Cancelando cuenta','es','0','0','0'),('5039','Cancelando la cuenta de usuario','es','0','0','0'),('5040','%name se ha desactivado.','es','0','0','0'),('5041','Detalles de la cuenta de [user:name] en [site:name]','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5042','Un administrador ha creado para usted una cuenta en [site:name]','es','0','0','0'),('5043','Detalles de la cuenta de [user:name] en [site:name] (pendiente de aprobación administrativa)','es','0','0','0'),('5044','[user:name],\r\n\r\nGracias por registrarse en [site:name]. Su petición de una cuenta de usuario está pendiente de aprobación. Una vez haya sido aprobada, recibirá un nuevo correo electrónico con la información necesaria para iniciar sesión, disponer su clave y otros detalles.\r\n\r\n-- El equipo de [site:name]','es','0','0','0'),('5045','[user:name] ha solicitado una cuenta\r\n\r\n[user:edit-url]','es','0','0','0'),('5046','Información de reemplazo de inicio de sesión para [user:name] en [site:name]','es','0','0','0'),('5047','Detalles de la cuenta de [user:name] en [site:name] (aprobada)','es','0','0','0'),('5048','Detalles de la cuenta de [user:name] en [site:name] (bloqueada)','es','0','0','0'),('5049','Petición de cancelación de cuenta de [user:name] en [site:name]','es','0','0','0'),('5050','Detalles de la cuenta de [user:name] en [site:name] (cancelada)','es','0','0','0'),('5051','Cancelar las cuentas de usuario seleccionadas','es','0','0','0'),('5052','La cuenta de usuario %name no se puede cancelar.','es','0','0','0'),('5053','Al cancelar estas cuentas','es','0','0','0'),('5054','¿Seguro que quiere cancelar estas cuentas de usuario?','es','0','0','0'),('5055','Cancelar cuentas','es','0','0','0'),('5056','Para que su clave sea más robusta:','es','0','0','0'),('5057','Darle al menos seis caracteres','es','0','0','0'),('5058','Añadir letras minúsculas','es','0','0','0'),('5059','Añadir letras mayúsculas','es','0','0','0'),('5060','Añadir cifras','es','0','0','0'),('5061','Añadir signos de puntuación','es','0','0','0'),('5062','Hacer que sea distinta de su nombre de usuario','es','0','0','0'),('5063','Débil','es','0','0','0'),('5064','Razonable','es','0','0','0'),('5065','Usuario bloqueado: %name %email.','es','0','0','0'),('5066','Hay actualmente 1 usuario conectado.','es','0','0','0'),('5067','Hay actualmente @count usuarios conectados.','es','5066','1','0');
INSERT INTO `locales_target` VALUES ('5068','Lo sentimos, ha habido más de un intento fallido de iniciar sesión con esta cuenta. Ha quedado temporalmente bloqueada. Inténtelo de nuevo más tarde o <a href="@url">solicite una nueva contraseña</a>.','es','0','0','0'),('5069','Lo sentimos, ha habido más de @count intentos fallidos de iniciar sesión con esta cuenta. Ha quedado temporalmente bloqueada. Inténtelo de nuevo más tarde o <a href="@url">solicite una nueva contraseña</a>.','es','5068','1','0'),('5070','Encontrar y gestionar qué personas interactúan con su sitio.','es','0','0','0'),('5071','Confirmar cancelación de cuenta','es','0','0','0'),('5072','Las contraseñas de usuario se han rencriptado para mejorar la seguridad','es','0','0','0'),('5073','Zonas horarias de usuario migradas','es','0','0','0'),('5074','Mínimo','es','0','0','0'),('5075','Comenzar sólo con unos pocos módulos activos.','es','0','0','0'),('5076','Página básica','es','0','0','0'),('5077','Use las <em>páginas básicas</em> para su contenido estático, como una página "Acerca de...".','es','0','0','0'),('5078','Use etiquetas para agrupar artículos sobre temas similares en categorías.','es','0','0','0'),('5079','Escriba una lista de palabras separadas por comas para describir su contenido.','es','0','0','0'),('5080','Instalar con las características de uso más común preconfiguradas.','es','0','0','0'),('5081','Anchura del contenido','es','0','0','0'),('5082','Ancho fluido','es','0','0','0'),('5083','Ancho fijo','es','0','0','0'),('5084','Especificar si el contenido debe adaptarse a una anchura fija o adaptarse y fluir conforme a la anchura de la ventana del navegador.','es','0','0','0'),('5085','Un tema multicolumna que se puede configurar para modificar los colores y alternar entre diseños fijo y fluido.','es','0','0','0'),('5086','Un tema visual para admistración de una columna, sin tablas, de anchura variable.','es','0','0','0'),('5087','Este tema muestra el código HTML y los estilos predeterminados de Drupal. Para aprender a construir su propio tema y sobrescribir el código original de Drupal, consulte la <a href="http://drupal.org/theme-guide">Guía de temas gráficos</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5088','Estilo de imagen','es','0','0','0'),('5089','1 actualización pendiente (@number_applied por aplicar, @number_incompatible sin compatibilidad)','es','0','0','0'),('5090','@count actualizaciones pendientes (@number_applied por aplicar, @number_incompatible sin compatibilidad)','es','5089','1','0'),('5091','El módulo Blog permite a los usuarios registrados mantener un diario electrónico o <em>blog.</em> Los blogs están formados por envíos individuales que, en principio, se muestran por orden cronológico descendente basándose en su creación, con posibilidad de hacer comentarios y publicados en la página principal. Para saber más, consulte las páginas sobre el <a href=''@blog''>módulo Blog</a> del manual en pantalla.','es','0','0','0'),('5092','Campo de texto autor','es','0','0','0'),('5093','Campo de texto asunto','es','0','0','0'),('5094','Un formulario de contacto con la categoría %category ya existe.','es','0','0','0'),('5095','Hola, !recipient-name,','es','0','0','0'),('5096','Se intentó crear una instancia de un campo field @field_name que no existe o está inactivo.','es','0','0','0'),('5097','Se ha intentado crear una instancia del campo @field_name en el paquete @bundle que ya dispone de una instancia de dicho campo.','es','0','0','0'),('5098','API para añadir campos a entidades tales como nodos y usuarios.','es','0','0','0'),('5099','Información general de los campos en todos los tipos de entidades.','es','0','0','0'),('5100','Configurando formatos de texto','es','0','0','0'),('5101','Mostrar más contenido','es','0','0','0'),('5102','Plegar','es','0','0','0'),('5103','El entorno de pruebas requiere que la clase DOMDocument esté disponible. Compruebe el comando de configuración en la <a href="@link-phpinfo">página de información de PHP</a>.','es','0','0','0'),('5104','Mensajes de error que se deben mostrar','es','0','0','0'),('5105','Se recomienda no mostrar mensajes de error en los sitios en funcionamiento real.','es','0','0','0'),('5106','No se puede abrir %file_path','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5107','Campo de texto del nombre del término','es','0','0','0'),('5108','Área de texto de la descripción del término','es','0','0','0'),('5109','Las instrucciones para reiniciar la contraseña se enviarán al correo %email. Debe cerrar la sesión para utilizar el enlace de reinicio de contraseña que verá en el correo.','es','0','0','0'),('5110','Escriba su contraseña actual para modificar %mail o %pass. !request_new.','es','0','0','0'),('5111','Clave actual','es','0','0','0'),('5112','Su contraseña actual es incorrecta o bien la ha olvidado; es necesario cambiar el %name.','es','0','0','0'),('5113','Un mensaje de bienvenida con más instrucciones se le ha enviado por correo electrónico al nuevo usuario <a href="@url">%name</a>.','es','0','0','0'),('5114','Un mensaje de bienvenida con instrucciones adicionales se ha enviado a su dirección de correo electrónico.','es','0','0','0'),('5115','Configurar cuentas de usuario.','es','0','0','0'),('5116','Configurar el comportamiento predeterminado de los usuarios, incluyendo los requisitos para darse de alta, correos electrónicos, campos e imágenes de los usuarios.','es','0','0','0'),('5117','Módulo %module instalado.','es','0','0','0'),('5118','La tabla %name ya existe.','es','0','0','0'),('5119','No se pudo renombrar %table como %table_new: la tabla %table no existe.','es','0','0','0'),('5120','No se pudo cambiar el nombre de %table a %table_new: La tabla %table_new ya existe.','es','0','0','0'),('5121','No se pudo añadir el campo %table.%field: La tabla no existe.','es','0','0','0'),('5122','No se pudo añadir el campo %table.%field: El campo ya existe.','es','0','0','0'),('5123','No se pudo establecer el valor predeterminado del campo %table.%field: el campo no existe.','es','0','0','0'),('5124','No se puedo eliminar el valor predeterminado del campo %table.%field: el campo no existe.','es','0','0','0'),('5125','No se pudo añadir la clave principal a la tabla %table: la tabla no existe.','es','0','0','0'),('5126','No se pudo añadir una clave primaria a la tabla %table: La clave primaria ya existe.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5127','No se pudo añadir la clave única %name a la tabla %table: La tabla no existe.','es','0','0','0'),('5128','No se pudo añadir la clave única %name a la tabla %table: Ya existe una clave única.','es','0','0','0'),('5129','No se pudo añadir el índice %name a la tabla %table: la tabla no existe.','es','0','0','0'),('5130','No se pudo añadire el índice %name a la tabla %table: El índice ya existe.','es','0','0','0'),('5131','No se pudo modificar la definición del campo %table.%name: el campo no existe.','es','0','0','0'),('5132','Imposible renombrar el campo %table.%name como %name_new: el campo ya existe.','es','0','0','0'),('5133','Use esta página para crear un nuevo bloque personalizado.','es','0','0','0'),('5134','Cantidad de entradas recientes de blog a mostrar','es','0','0','0'),('5135','comentario de @node_type','es','0','0','0'),('5136','Editar comentario %comment','es','0','0','0'),('5137','Planeando de campos','es','0','0','0'),('5138','Cómo se llamará el campo','es','0','0','0'),('5139','Un campo tiene una <em>etiqueta</em> (el nombre mostrado en la interfaz de usuario) y un <em>nombre máquina</em> (el nombre usado internamente). La etiqueta se podrá cambiar después de crear el campo si fuera necesario, pero el nombre máquina no podrá modificarse una vez creado.','es','0','0','0'),('5140','Tipo de datos que almacenará el campo','es','0','0','0'),('5141','Cada campo pude almacenar un tipo de datos (texto, números, ficheros, etc.). Cuando define un campo, tiene que elegir un <em>tipo de campo</em> específico que corresponderá con el tipo de datos que desea almacenar. El tipo de campo no podrá modificarse una vez creado el campo.','es','0','0','0'),('5142','Como se introducirán y mostrarán los datos','es','0','0','0'),('5143','Número de valores que almacenará el campo','es','0','0','0'),('5144','Reutilizando campos','es','0','0','0'),('5145','Una vez que ha definido un campo, puede reutilizarlo; por ejemplo: Si define un campo de imagen personalizado para un tipo de contenido y necesita un campo de imagen con los mismos parámetros en otro tipo de contenido, puede añadir ese mismo campo al segundo tipo de contenido en el área <em>Agregar campo existente</em> de la interfaz de usuario. Además, puede agregar este campo a vocabularios de taxonomía, comentarios, cuentas de usuario, etc.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5146','Algunas opciones de un campo reutilizado son únicas para cada uso del campo; otras son compartidas en todos los lugares donde se use el campo. Por ejemplo, la etiqueta de un campo de texto es única para cada uso, mientras que la configuración para el número de valores se comparte.','es','0','0','0'),('5147','Hay dos razones principales para reutilizar campos. Primero, reutilizar campos puede ahorrarle tiempo de definición de nuevos campos. Segundo, reutilizar campos además le permite visualizar, filtrar, agrupar y ordenar contenido por campo, en diferentes tipos de contenido a la vez. Por ejemplo, el módulo contribuido Views le permite crear listas y tablas de contenido. Así, si usa el mismo campo en distintos tipos de contenido, puede crear una Vista que contenga todos los tipos de contenidos juntos que muestran el campo, ordenados por ese campo, y/o filtrados por ese campo.','es','0','0','0'),('5148','Campos en los elementos de contenido','es','0','0','0'),('5149','Campos en términos de taxonomía','es','0','0','0'),('5150','Campos en cuentas de usuarios','es','0','0','0'),('5151','Los campos en cuentas de usuario son definidos a nivel de sitio en la  <a href="@fields">pestaña Administrar campos</a> de la página de <a href="@accounts">Configuración de la cuenta</a>. Cuando se defina un campo para una cuenta de usuario, se agregará ese campo a cada cuenta de usuario. Por ejemplo, podría agregar un campo de texto largo para permitir a los usuarios incluir su biografía.','es','0','0','0'),('5152','Campos en comentarios','es','0','0','0'),('5153','Administrar formatos de texto y filtros','es','0','0','0'),('5154','detección de idioma de @type','es','0','0','0'),('5155','Los textos del archivo subido reemplazarán a los ya existentes, los nuevos se añadirán. Las formas plurales se actualizarán.','es','0','0','0'),('5156','Se mantendrán los textos y los plurales existentes. Sólo se añadirán los textos nuevos.','es','0','0','0'),('5157','Definir cómo se decide qué lenguaje se utilizará para mostrar elementos de la página (principalmente el texto ofrecido por Drupal y módulos, como etiquetas de texto y texto de ayuda). Esta decisión se realizará evaluando una serie de métodos de detección de idiomas; el primer método que obtenga un resultado determinará el idioma que se utilizará para ese texto. Defina el orden de evaluación de los métodos de detección de idioma en esta página.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5158','Texto de la interfaz del usuario','es','0','0','0'),('5159','Utilizar el idioma de interfaz detectado.','es','0','0','0'),('5160','Agregar nuevo %type','es','0','0','0'),('5161','El nuevo conjunto se creará copiando elementos de su conjunto predeterminado de atajos.','es','0','0','0'),('5162','El nuevo conjunto se creará copiando elementos del conjunto %default.','es','0','0','0'),('5163','Actualmente está utilizando el conjunto de atajos %set-name.','es','0','0','0'),('5164','editar nombre del conjunto','es','0','0','0'),('5165','eliminar conjunto','es','0','0','0'),('5166','Crear conjunto nuevo','es','0','0','0'),('5167','El conjunto de atajos %set_name ha sido creado. Puede editarlo desde esta página.','es','0','0','0'),('5168','Se ha actualizado el nombre del conjunto a %set-name.','es','0','0','0'),('5169','Si ha elegido este conjunto de atajos como conjunto predeterminado para todos o algunos usuarios, podrían verse afectados al eliminarlo.','es','0','0','0'),('5170','¿Seguro que desea eliminar el conjunto de atajos %title?','es','0','0','0'),('5171','El conjunto de atajos %title ha sido eliminado.','es','0','0','0'),('5172','1 usuario ha elegido o se le ha asignado este juego de accesos directos.','es','0','0','0'),('5173','@ usuarios han elegido o se les ha asignado este juego de accesos directos.','es','5172','1','0'),('5174','El módulo de atajos permite a los usuarios crear conjuntos de <em>enlaces directos</em> a las páginas más vistadas del sitio. Los atajos estan incluidos en <em>conjuntos</em>. Cada usuario con permisos de <em>Select any shortcut set</em>puede seleccionar un conjunto de atajos creados por cualquier persona en el sitio. Para obtener más información, consulte la documentación en linea para <a href="@shortcut">Shortcut module</a>.','es','0','0','0'),('5175','Administrando atajos','es','0','0','0'),('5176','Los usuarios con el permiso de <em>administrar atajos</em> pueden gestionar los conjuntos de atajos y editar los atajos incluidos en ellos desde la <a href="@shortcuts">página de administración de atajos</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5177','Eligiendo conjuntos de atajos','es','0','0','0'),('5178','Los usuarios con permiso para intercambiar los conjuntos de atajos pueden elegir un conjunto de atajos para utilizarlo desde la pestaña de atajos de su página de usuario.','es','0','0','0'),('5179','Definir qué conjunto de atajos se usará en la <a href="@shortcut-link">solapa de atajos</a> de su página de usuario.','es','0','0','0'),('5180','Editar el actual conjunto de atajos','es','0','0','0'),('5181','Si edita este atajo afectará a aquellos usuarios que lo hayan seleccionado o hayan sido asignados al mismo. Si concede el permiso de "Seleccionar cualquier conjunto de atajos" junto con este permiso permitirá la edición de cualquier conjunto de atajos.','es','0','0','0'),('5182','Seleccionar cualquier conjunto de atajos','es','0','0','0'),('5183','Seleccionar uno de los conjuntos de atajos como activo. Sin este permiso un administrador seleccionará los conjuntos de atajos para los usuarios.','es','0','0','0'),('5184','Agregar y modificar conjuntos de atajos.','es','0','0','0'),('5185','Agregar conjunto de atajos','es','0','0','0'),('5186','Editar nombre de conjunto','es','0','0','0'),('5187','Eliminar conjunto de atajos','es','0','0','0'),('5188','No se ha podido guardar @remote en @path','es','0','0','0'),('5189','Drupal necesita que tenga habilitadas las extensiones PHP de la lista siguiente (vea la <a href="@system_requirements">página de requisitos del sistema</a> para más información):','es','0','0','0'),('5190','Funcionalidad de bases de datos','es','0','0','0'),('5191','Parece que su servidor web no admite ninguna de las extensiones de bases de datos PDO. Consulte con su proveedor de alojamiento web si admiten PDO (Objetos de Datos PHP) y si disponen de alguna de las bases de datos que <a href="@drupal-databases">admite Drupal</a>.','es','0','0','0'),('5192','Primera columna del pie de página','es','0','0','0'),('5193','Segunda columna del pie de página','es','0','0','0'),('5194','Tercera columna del pie de página','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5195','Cuarta columna del pie de página','es','0','0','0'),('5196','Kirguís','es','0','0','0'),('5197','No debe llamar a la función theme() hasta que se hayan cargado todos los módulos.','es','0','0','0'),('5198','Funcionalidad PNG de la biblioteca GD','es','0','0','0'),('5199','La fecha en la que se actualizó por última vez el comentario.','es','0','0','0'),('5200','Comentario enviado: %subject.','es','0','0','0'),('5201','Valor para activado','es','0','0','0'),('5202','Si lo deja en blanco, se utilizará "1".','es','0','0','0'),('5203','Valor para desactivado','es','0','0','0'),('5204','Si lo deja en blanco, se utilizará "0".','es','0','0','0'),('5205','Este campo está desactivado porque no tiene permisos suficientes para editarlo.','es','0','0','0'),('5206','Seleccione un foro.','es','0','0','0'),('5207','Efectos de rotado y desaturado de la biblioteca GD','es','0','0','0'),('5208','Ver, editar y borrar todo el contenido sin tener en cuenta las restricciones de los permisos.','es','0','0','0'),('5209','Debe validar su dirección de correo electrónico para esta cuenta antes de acceder a través de OpenID.','es','0','0','0'),('5210','El identificador HTML %id es único.','es','0','0','0'),('5211','Formato del archivo de registro del sistema','es','0','0','0'),('5212','Especifica el formato de la entrada del archivo de registro del sistema. Las siguientes variables están disponibles: <dl><dt><code>!base_url</code></dt><dd>URL base del sitio.</dd><dt><code>!timestamp</code></dt><dd>Sello temporal Unix de la entrada de registro.</dd><dt><code>!type</code></dt><dd>La categoría a la cual pertenece este mensaje.</dd><dt><code>!ip</code></dt><dd>Dirección IP del usuario que provoca el mensaje.</dd><dt><code>!request_uri</code></dt><dd>El URI solicitado.</dd><dt><code>!referer</code></dt><dd>Si estuviera disponible, referente HTTP.</dd><dt><code>!uid</code></dt><dd>ID de Usuario.</dd><dt><code>!link</code></dt><dd>Un enlace para asociar con este mensaje.</dd><dt><code>!message</code></dt><dd>El mensaje a almacenar en el registro.</dd></dl>','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5213','Los recursos externos pueden ser optimizados automáticamente, lo que reducirá tanto el tamaño como el número de peticiones a su sitio web.','es','0','0','0'),('5214','Fecha en formato ''tiempo-desde''. (%date)','es','0','0','0'),('5215','Localización del fichero relativa a la raiz de Drupal.','es','0','0','0'),('5216','Ha ocurrido un error HTTP @errorcode al acceder a @remote','es','0','0','0'),('5217','La configuración de su sistema o red no permite a Drupal acceder a páginas web, lo que produce un funcionamiento limitado. Esto se puede deber a la configuración de su servidor web o a las opciones de su PHP. Debe resolverlo para poder descargar información sobre informaciones disponibles, obtener información de los canales de noticias, iniciar sesión a través de OpenID o usar servicios que dependan de la conexión de red. Si está seguro de que Drupal puede acceder a páginas web y aún así sigue viendo este mensaje, puede agregar add <code>$conf[''drupal_http_request_fails''] = FALSE;</code> al final de su archivo settings.php.','es','0','0','0'),('5218','La traducción de %title en %language ya existe, se creará un nuevo %type en lugar de una traducción.','es','0','0','0'),('5219','Sus módulos han sido descargados y actualizados.','es','0','0','0'),('5220','<a href="@update">Ejecutar actualizaciónes de la base de datos</a>','es','0','0','0'),('5221','@name <em>(bloqueado)</em>','es','0','0','0'),('5222','¿Seguro que quiere eliminar el rol %name?','es','0','0','0'),('5223','Los permisos le dan el control sobre lo que los usuarios pueden hacer y ver en su sitio. Usted puede definir un grupo específico de permisos para cada rol. (Vea la página de <a href="@role">Roles</a> para crear un rol). Dos roles importantes a considerar son usuarios registrados y administradores. Cualquier permiso otorgado al rol de usuarios registrados se dará a cualquier usuario que pueda iniciar sesión en su sitio. Puede convertir a cualquier rol en el rol administrador del sitio, lo que significa que todos los nuevos permisos se le asignarán automáticamente. Puede hacer esto en la página de <a href="@settings">Opciones de Usuario</a>. Debe tener cuidado y asegurarse que sólo los usuarios de confianza obtengan este acceso y este nivel de control del sitio.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5224','Los roles le permiten optimizar la seguridad y administración de Drupal. Un rol define un grupo de usuarios que tienen ciertos privilegios definidos en la <a href="@permissions">página de permisos</a>. Ejemplos de roles son usuario anónimo, usuario registrado, moderador, administrador, etcétera. En esta sección puede definir los nombres y orden de los roles de su sitio. Es recomendable que ordene los roles desde el que tiene menos permisos (usuario anónimo) al que tiene más (administrador). Para eliminar un rol seleccione "editar rol".','es','0','0','0'),('5225','Utilice <em>artículos</em> para tipos de contenido que dependan de fecha y hora como noticias, artículos de prensa o entradas de blogs.','es','0','0','0'),('5226','Filipino','es','0','0','0'),('5227','Alemán suizo','es','0','0','0'),('5228','Scots','es','0','0','0'),('5229','El archivo seleccionado %filename no puede ser subido. Solo se permiten archivos con las siguientes extensiones: %extensions.','es','0','0','0'),('5230','Caché de páginas para usuarios anónimos','es','0','0','0'),('5231','Bartik','es','0','0','0'),('5232','Un tema flexible con muchas regiones al que se le pueden cambiar los colores.','es','0','0','0'),('5233','Resaltado','es','0','0','0'),('5234','Segunda barra lateral','es','0','0','0'),('5235','Tríptico primero','es','0','0','0'),('5236','Tríptico al medio','es','0','0','0'),('5237','Tríptico al final','es','0','0','0'),('5238','Fondo principal','es','0','0','0'),('5239','Fondo de la barra lateral','es','0','0','0'),('5240','Bordes de la barra lateral','es','0','0','0'),('5241','Fondo del pie de página','es','0','0','0'),('5242','Ciruela','es','0','0','0'),('5243','!local-task-title!active','es','0','0','0'),('5244','Una lista separada por espacios de las etiquetas HTML permitidas en el contenido de los artículos de los canales. Las etiquetas no permitidas son eliminadas del contenido.','es','0','0','0'),('5245','%field sólo puede contener letras a-z, guiones bajos o guiones.','es','0','0','0'),('5246','%field no puede contener marcas.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5247','No hay de alias de URL. <a href="@link">Agregar alias de URL</a>.','es','0','0','0'),('5248','Reindexando el contenido','es','0','0','0'),('5249','Las paginas en cache no serán recreadas hasta que no haya transcurrido  al menos este periodo.','es','0','0','0'),('5250','Caducidad de las páginas en caché','es','0','0','0'),('5251','El tiempo máximo que una caché externa puede utilizar una versión antigua de una página.','es','0','0','0'),('5252','Estas opciones controlan las opciones de presentación del tema %name. Cuando su sitio se muestre con este tema visual, se usarán estas opciones.','es','0','0','0'),('5253','Administrar actualizaciones de software','es','0','0','0'),('5254','Indique una dirección de correo electronico o use un token como %autor.','es','0','0','0'),('5255','@required_name (Falta)','es','0','0','0'),('5256','@required_name (Se necesita la versión @compatibility)','es','0','0','0'),('5257','@name necesita al menos PHP @version.','es','0','0','0'),('5258','Dependencia no determinada','es','0','0','0'),('5259','@name requiere este módulo.','es','0','0','0'),('5260','@name requiere este modulo y versión. Actualmente se esta utilizando @required_name version @version','es','0','0','0'),('5261','Detalles del sitio','es','0','0','0'),('5262','Título y lema','es','0','0','0'),('5263','Cuartel de bomberos','es','0','0','0'),('5264','Hielo','es','0','0','0'),('5265','No se puede usar mas de un motor de almacenamiento de campos.','es','0','0','0'),('5266','No se encuentra el motor de almacenamiento de campos.','es','0','0','0'),('5267','Debe especificarse un tipo de entidad para esta consulta.','es','0','0','0'),('5268','La entidad %entity no tiene tabla base.','es','0','0','0'),('5269','No se sabe cómo ordenar @key en @entity_type','es','0','0','0'),('5270','El prefijo de la tabla de la base de datos que ha indicado, %prefix, no es válido. El prefijo de la tabla sólo puede contener caracteres alfanuméricos, puntos o guiones bajos.','es','0','0','0'),('5271','Archivo de configuración predeterminado','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5272','El archivo de configuración predeterminado no existe','es','0','0','0'),('5273','El instalador de @drupal necesita que el archivo %default-file no se modifique de ninguna forma con respecto a la descarga original.','es','0','0','0'),('5274','Maorí','es','0','0','0'),('5275','Intento de crear una instancia del campo @field_name sin un tipo de entidad.','es','0','0','0'),('5276','Intento de crear una instancia del campo @field_name en el tipo de entidad @entity_type, que está prohibida.','es','0','0','0'),('5277','Intento de actualizar una instancia de campo inexistente @field','es','0','0','0'),('5278','Se intentó actualizar una instancia del campo @field en el paquete @bundle que no existe','es','0','0','0'),('5279','Intento de purgar un campo @field_name que todavia tiene instancias','es','0','0','0'),('5280','%name: el valor no puede ser menor que %min.','es','0','0','0'),('5281','%name: el valor no puede ser mayor que %min.','es','0','0','0'),('5282','No hay campos definidos todavía.','es','0','0','0'),('5283','Peso del nuevo campo','es','0','0','0'),('5284','Peso del campo agregado','es','0','0','0'),('5285','Opciones de presentación personalizada','es','0','0','0'),('5286','Usar las opciones de presentación personalizada para los siguientes modos de vistas','es','0','0','0'),('5287','El modo %view_mode usa ahora sus propias opciones de presentación. Quizá quiera <a href="@url">configurarlas</a>.','es','0','0','0'),('5288','Interfaz de usuario para el API de campos.','es','0','0','0'),('5289','Separe las extensiones con un espacio o una coma y no escriba el punto que las precede.','es','0','0','0'),('5290','Editar un efecto existente dentro de un estilo.','es','0','0','0'),('5291','Eliminar un efecto existente de un estilo','es','0','0','0'),('5292','Elemento del módulo Nodo','es','0','0','0'),('5293','Cerrar superposición','es','0','0','0'),('5294','Opciones del módulo de encuestas','es','0','0','0'),('5295','Voto en encuesta','es','0','0','0'),('5296','Resultados de la encuesta','es','0','0','0'),('5297','Es necesario un nombre para el nuevo conjunto.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5298','El atajo %name ya existe. Elija otro nombre.','es','0','0','0'),('5299','Texto esperado encontrado en @field del correo electrónico: "@expected".','es','0','0','0'),('5300','Se envió un correo electrónico en esta prueba.','es','0','0','0'),('5301','Se enviaron @count correos electrónicos en esta prueba.','es','5300','1','0'),('5302','Direcciones IP bloqueadas','es','0','0','0'),('5303','Las direcciones IP listadas aquí están bloqueadas en su sitio. Estas direcciones bloqueadas tienen completamentente prohibido el acceso al sitio y, en su lugar, recibirán un breve mensaje explicando la situación.','es','0','0','0'),('5304','El tipo de contenido %rowtype tiene la subida de archivos desactivada pero contiene datos de archivos subidos. Las subidas se reactivarons para migrar los datos ya existentes. Si los datos no son necesarios, puede eliminar el campo "Adjuntar archivos" en el tipo %rowtype','es','0','0','0'),('5305','El módulo Upload ha sido migrado al módulo File.','es','0','0','0'),('5306','Las variables disponibles son: [site:name], [site:url], [user:name], [user:mail], [site:login-url], [site:url-brief], [user:edit-url], [user:one-time-login-url], [user:cancel-url].','es','0','0','0'),('5307','sin asignar todavía','es','0','0','0'),('5308','no creado todavía','es','0','0','0'),('5309','[user:name],\r\n\r\nGracias por registrarse en [site:name]. Ahora puede iniciar sesión pulsando este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace es para un único inicio de sesión y le llevará a una página donde podrá establecer su contraseña.\r\n\r\nTras establecer su contraseña, en el futuro podrá iniciar sesión identificándose en [site:login-url]:\r\n\r\nNombre de usuario: [user:name]\r\ncontraseña: Su contraseña\r\n\r\n-- El equipo de [site:name]','es','0','0','0'),('5310','[user:name],\r\n\r\nUn administrador del Sitio [site:name] ha creado una cuenta para usted. Ahora puede iniciar una sesión haciendo clic en este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace es para un único inicio de sesión y le llevará a una página donde podrá establecer su contraseña.\r\n\r\nTras establecer su contraseña, en el futuro podrá iniciar sesión identificándose en [site:login-url] con los datos:\r\n\r\nUsuario: [user:name]\r\nContraseña: Su contraseña\r\n\r\n--  El equipo de [site:name]','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5311','[user:name],\r\n\r\nRecibimos en [site:name] una solicitud para restablecer la contraseña de su cuenta\r\n\r\nAhora puede iniciar una sesión haciendo clic en este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:one-time-login-url]\r\n\r\nEste enlace es para un único inicio de sesión y le llevará a una página donde podrá establecer su contraseña. El enlace caduca al cabo de un día y no pasa nada si no se usa.\r\n\r\n--  El equipo de [site:name]','es','0','0','0'),('5312','[user:name],\r\n\r\nSu cuenta en [site:name] ha sido bloqueada.\r\n\r\n--  El equipo de [site:name]','es','0','0','0'),('5313','[user:name],\r\n\r\nSe ha realizado una petición para cancelar su cuenta en [site:name].\r\n\r\nPuede cancelar su cuenta en [site:url-brief] haciendo clic en este enlace o copiándolo y pegándolo en su navegador:\r\n\r\n[user:cancel-url]\r\n\r\nNOTA: La cancelación de su cuenta no es reversible.\r\n\r\nEste enlace caduca al cabo de un día y no pasa nada si no se usa.\r\n\r\n--  El equipo de [site:name]','es','0','0','0'),('5314','[user:name],\r\n\r\nSu cuenta en [site:name] ha sido cancelada.\r\n\r\n--  El equipo de [site:name]','es','0','0','0'),('5315','La capacidad de enviar a los usuarios sus contraseñas en texto sin cifrar se han eliminado en Drupal 7. Sus plantillas de correo electrónico se han modificado para eliminar esa posibilidad. Debería usted <a href="@template-url">revisar esas plantillas</a> para asegurase de que se leen correctamente.','es','0','0','0'),('5316','Ninguno (imagen original)','es','0','0','0'),('5317','La URL de la página de edición de la cuenta.','es','0','0','0'),('5318','La palabra clave de @endpoint ha sido rechazada debido a que no tiene un formato correcto. Palabra clave: @nonce.','es','0','0','0'),('5319','La palabra clave recibida desde @endpoint está fuera del límite (diferencia de tiempo: @intervals). Compruebe posibles diferencias de reloj.','es','0','0','0'),('5320','Intento de respuesta de palabra clave bloqueado desde @ip. Palabra clave: @nonce.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5321','Presentación de comentarios','es','0','0','0'),('5322','Nombre de campo nuevo','es','0','0','0'),('5323','Error al abrir el socket @socket','es','0','0','0'),('5324','callback de entrega no encontrada','es','0','0','0'),('5325','callback %callback no encontrada: %q','es','0','0','0'),('5326','El archivo especificado %file no se pudo copiar, porque el destino no es válido. Hay más información disponible en el registro del sistema.','es','0','0','0'),('5327','El archivo especificado %file no se pudo copiar, porque el directorio de destino no está configurado correctamente. la causa puede ser un problema de derechos en el directorio o los archivos. Hay más información disponible en el registro del sistema.','es','0','0','0'),('5328','El archivo %file no se pudo copiar porque ya existe uno con el mismo nombre en el directorio de destino.','es','0','0','0'),('5329','El archivo especificado %file no se pudo eliminar, por que el destino no es válido. Hay más información disponible en el registro del sistema.','es','0','0','0'),('5330','El archivo %file especificado no pudo ser eliminado debido a que no es una URI valida. Más información disponible en el registro del sistema.','es','0','0','0'),('5331','La información no se pudo guardar porque el destino es invalido. Más información disponible en el registro del sistema.','es','0','0','0'),('5332','El archivo %file (%realpath) no pudo ser copiado debido a que el destino %destino es inválido. Esto es causado comúnmente por uso inapropiado de file_copy() o la falta de un contenedor de flujo.','es','0','0','0'),('5333','El archivo %file (%realpath) no se pudo copiar porque no existe.','es','0','0','0'),('5334','El archivo %file no se pudo copiar porque ya existe uno con el mismo nombre en el directorio destino (%directory)','es','0','0','0'),('5335','El archivo %file no se pudo copiar porque se sobrescribiría a si mismo.','es','0','0','0'),('5336','El archivo %file especificado no se pudo copiar a %destination.','es','0','0','0'),('5337','El archivo %file (%realpath) no se pudo mover porque el destino %destino no es válido. La causa usual de esto es el uso inapropiado de file_copy() o la falta de un contenedor de flujo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5338','El archivo %file (%realpath) no se pudo eliminar porque el destino %destino no es válido. La causa usual de esto es el uso inapropiado de file_copy() o la falta de un contenedor de flujo.','es','0','0','0'),('5339','Los datos no pudieron ser guardados por que el destino %destination no es válido. Esto puede ser causado por uso indebido de file_save_data() o un contenedor de flujo ausente.','es','0','0','0'),('5340','Su configuración de PHP sólo admite un único tipo de base de datos, por lo que se ha seleccionado automáticamente.','es','0','0','0'),('5341','No se pudo conectar con el servidor de base de datos. El servidos informa del siguiente mensaje: %error. <ul><li>¿Está operativo el servidor?</li><li>¿Existe la base de datos y ha escrito bien su nombre?</li><li>¿Ha puesto bien el usuario y contraseña?</li><li>¿Ha puesto bien el nombre del servidor?</li></ul>','es','0','0','0'),('5342','La versión de PHP que está usando tiene problemas conocidos con PostgreSQL. Necesita actualizar PHP a 5.2.11, 5.3.1 o mayor.','es','0','0','0'),('5343','Salir de la demostración de la región de bloque','es','0','0','0'),('5344','Para personalizar el panel de control se requiere el permiso !permission-name.','es','0','0','0'),('5345','Para personalizar la página del panel de control, mueva los bloques a las regiones en la <a href="@dashboard">página de administración de Dashboard</a>, o active JavaScript en esta página para poder usar la interfaz de arrastrar y soltar.','es','0','0','0'),('5346','Configurar los bloques de panel de control disponibles','es','0','0','0'),('5347','Arrastre y suelte estos bloques a las columnas inferiores. Los cambios se guardan automáticamente. Más opciones disponibles en la <a href="@dashboard-url"> página de configuración</a>','es','0','0','0'),('5348','Configurar los bloques que se pueden mostrar en el panel de control.','es','0','0','0'),('5349','El módulo de registro de base de datos le permite ver un registro de eventos en la página de <a href="@dblog">Mensajes recientes de registro</a>. El registro es una lista cronológica de eventos guardados que contienen información de uso y de rendimiento, errores, advertencias e información operacional. Los administradores deberían revisar el registro regularmente para asegurarse de que el sitio está funcionando de forma correcta.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5350','En caso de errores o problemas en el sitio, la página de <a href="@dblog">Mensajes recientes de registro</a> puede ser útil para depurar errores, ya que muestra la secuencia de eventos. Los mensajes de registro contienen información de uso, advertencias y errores.','es','0','0','0'),('5351','El módulo de registro de base de datos monitorea el sitio web, capturando eventos del sistema en un registro (mostrado aquí) para ser revisado por personas autorizadas posteriormente. Este registro es una lista de eventos que contiene datos de uso y de rendimiento, errores, advertencias e información operacional. Es vital revisar regularmente el reporte de mensajes recientes del registro, ya que con frecuencia es la única forma de saber qué ocurre.','es','0','0','0'),('5352','Mensajes de registro de la base de datos a mantener','es','0','0','0'),('5353','El número máximo de mensajes a mantener en el registro de la base de datos. Requiere una <a href="@cron">tarea de mantenimiento cron</a>.','es','0','0','0'),('5354','Mensajes recientes del registro','es','0','0','0'),('5355','Defina una cadena como sufijo del valor, como «m», «kb/s». Deje en blanco para no utilizar ninguna. Separe el singular y el plural con una barra vertical («libra|libras»).','es','0','0','0'),('5356','Indicador de millares','es','0','0','0'),('5357','Mosttrar prefijo y sufijo','es','0','0','0'),('5358','Mostrar con prefijo y sufijo.','es','0','0','0'),('5359','- Seleccione un valor -','es','0','0','0'),('5360','Recortar longitud','es','0','0','0'),('5361','No se muestra ningún campo.','es','0','0','0'),('5362','No hay ningún campo oculto.','es','0','0','0'),('5363','Opciones de formato:','es','0','0','0'),('5364','El archivo usado en el campo !name no puede ser referenciado.','es','0','0','0'),('5365','Los formatos de texto son presentados en páginas de edición de contenido en el orden establecido en esta página. El primer formato disponible para un usuario será seleccionado de forma predeterminada.','es','0','0','0'),('5366','Falta el formato de texto: %format.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5367','Vincular imagen a','es','0','0','0'),('5368','Estilo de imagen: @style','es','0','0','0'),('5369','Vinculado a contenido','es','0','0','0'),('5370','Vinculado a archivo','es','0','0','0'),('5371','Mostrra cuando se pase el cursor por encima del enlace de menú.','es','0','0','0'),('5372','El módulo menú le permite la creación sobre la marcha de enlaces de menú en los formularios de envío de contenido. Para configurar estas opciones para un tipo de contenido en particular, visite la página <a href="@content-types">Tipos de contenido</a>, haga clic en el enlace <em>editar</em> para ese tipo de contenido, y diríjase a la sección <em>Opciones del menú</em>.','es','0','0','0'),('5373','Idioma no definido (@langcode)','es','0','0','0'),('5374','Formato: %time. El formato de la fecha es YYYY-MM-DD y %timezone es la zona horaria con respecto a UTC. Deje en blanco para usar la hora del envío del formulario.','es','0','0','0'),('5375','Capa administrativa','es','0','0','0'),('5376','Usar la capa superpuesta para las páginas administrativas.','es','0','0','0'),('5377','Mostrar las páginas administrativas encima de la página en la que comenzó.','es','0','0','0'),('5378','Se ha creado un formato de texto de <a href="@php-code">código PHP</a>.','es','0','0','0'),('5379','Elegir qué módulos de búsqueda están activados de los módulos disponibles.','es','0','0','0'),('5380','Módulo de búsqueda predeterminado','es','0','0','0'),('5381','Eligir qué módulo de búsqueda es el predeterminado.','es','0','0','0'),('5382','Su módulo de búsqueda predeterminado no está seleccionado como un módulo activo.','es','0','0','0'),('5383','La búsqueda está desactivada.','es','0','0','0'),('5384','... !excerpt ... !excerpt ...','es','0','0','0'),('5385','Identidad de Syslog','es','0','0','0'),('5386','Si lo desea, puede especificar una URL relativa para mostrarla como página principal. Déjelo en blanco para mostrar el canal de noticias de contenido predeterminado.','es','0','0','0'),('5387','Páginas de error','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5388','La ruta ''%path'' no es válida o usted no tiene permisos para acceder a ella.','es','0','0','0'),('5389','Última ejecución hace %cron-last.','es','0','0','0'),('5390','ejecutar cron cada','es','0','0','0'),('5391','Si se activa, solo los usuarios con el <a href="@permissions-url">permiso</a> «Usar sitio en modo de mantenimiento» pueden entrar y realizar el mantenimiento; el resto de los visitantes verán el aviso de modo de mantenimiento configurado abajo. Los usuarios autorizados pueden entrar en la página de <a href="@user-login">iniciar sesión</a>.','es','0','0','0'),('5392','Para que el sitio y sus módulos continúen operando correctamente, un conjunto de operaciones administrativas rutinarias tienen que ejecutarse de forma regular. El módulo System gestiona esta tarea haciendo uso de cron. Usted puede verificar el estado de las tareas de cron visitando la <a href="@status">página de Informe de estado</a>. Para más información, consulte la entrada del manual en línea <a href="@handbook">configuración de tareas de cron</a>. Usted puede configurar una tarea de cron visitando la página <a href="@cron">Configuración de cron</a>','es','0','0','0'),('5393','Cambiar nombre del sitio, dirección de correo electrónico, eslogan, página de inicio predeterminada, cantidad de envíos por página y páginas de error.','es','0','0','0'),('5394','Administrar tareas de mantenimiento automáticas.','es','0','0','0'),('5395','No se borró el archivo temporal "%path" al eliminar la basura, porque lo están usando los siguientes módulos: %modules.','es','0','0','0'),('5396','Peso del término agregado','es','0','0','0'),('5397','Subdirectorio de la carpetas de archivos subidos en el que se guardarán las imágenes.','es','0','0','0'),('5398','Las imágenes que excedan este tamaño serán reducidas.','es','0','0','0'),('5399','Tamaño máximo de archivo para las imágenes subidas. El tamaño de subidas normalmente está limitado por la configuración de PHP, y las imágenes se reducen automáticamente a las dimensiones especificadas arriba.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5400','Su foto o imagen virtual. Las imágenes que excedan @dimensions píxeles serán reducidas.','es','0','0','0'),('5401','[user:name],\n\nSu cuenta en [site:name] ha sido activada.\n\nAhora ya puede conectarse pulsando este enlace o pegándolo en su navegador:\n\n[user:one-time-login-url]\n\nEste enlace sólo puede usarse una vez para conectarse y le llevará a una página en la que podrá establecer su contraseña.\n\nDespués de establecer su contraseña, podrá conectarse a [site:login-url] en el futuro usando:\n\nUsuario: [user:name]\nContraseña: Su contraseña\n\n--  El equipo [site:name]','es','0','0','0'),('5402','Suba una imagen para acompañar este artículo.','es','0','0','0'),('5403','Perfil mínimo para hacer pruebas. Incluye sólo los módulos absolutamente necesarios.','es','0','0','0'),('5404','Se puede escribir en el archivo de configuración.','es','0','0','0'),('5405','El archivo de opciones es propiedad del servidor web.','es','0','0','0'),('5406','El instalador de @drupal no pudo crear un archivo de configuración con la propiedad de archivo correcta. Acceda a su servidor web, borre el archivo %file existente, y cree uno nuevo copiando el contenido del archivo %default_file a %file. Puede encontrar más detalles sobre la instalación de Drupal en <a href="@install_txt">INSTALL.txt</a>. Si tiene problemas con los permisos de archivo en su servidor, consulte la <a href="@handbook_url">documentación online</a>.','es','0','0','0'),('5407','Consulta de unión no válida: sin condiciones','es','0','0','0'),('5408','Peso del bloque @block','es','0','0','0'),('5409','Región del bloque @block','es','0','0','0'),('5410','Aprobación de comentario','es','0','0','0'),('5411','Los comentarios de usuarios con el permiso <em>Omitir aprobación de comentario</em> se publican de inmediato. Todos los demás comentarios se colocan en la cola de <a href=''@comment-approval''>Comentarios sin aprobar</a>, hasta que un usuario con el permiso de <em>Administrar comentarios</em> los publique o elimine. Los comentarios publicados se pueden gestionar al completo en la página de administración <a href=''@admin-comment''>Comentarios publicados</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5412','Publicar comentarios','es','0','0','0'),('5413','Omitir aprobación de comentario','es','0','0','0'),('5414','Ver y personalizar su cuadro de mandos.','es','0','0','0'),('5415','Personalice su cuadro de mandos.','es','0','0','0'),('5416','Esta función sólo se puede usar para eliminar campos sin datos.','es','0','0','0'),('5417','¿Seguro que quiere desactivar el formato %format?','es','0','0','0'),('5418','Los formatos de texto deshabilitados se eliminan completamente de la interfaz administrativa, y no se mostrará ningún contenido almacenado con ese formato. No se puede deshacer esta acción.','es','0','0','0'),('5419','Formato de texto %format desactivado.','es','0','0','0'),('5420','Formatos de texto','es','0','0','0'),('5421','Desactivar formato de texto','es','0','0','0'),('5422','Discusión candente, nuevos comentarios','es','0','0','0'),('5423','Discusión candente','es','0','0','0'),('5424','Discusión normal','es','0','0','0'),('5425','Discusión cerrada','es','0','0','0'),('5426','Referencia de uso, configuración, y módulos.','es','0','0','0'),('5427','y donde %property es %value','es','0','0','0'),('5428','donde %property es %value','es','0','0','0'),('5429','y donde','es','0','0','0'),('5430','El módulo RDF enriquece su contenido con metadatos que permiten a otras aplicaciones (e.g., motores de búsqueda, agregadores, y demás) entender mejor sus relaciones y atributos. Esta salida de datos de sistema enriquecida semánticamente para sitios Drupal usa la <a href="@rdfa">especificación RDFa</a> que permite a los datos RDF integrarse en código HTML. Otros módulos pueden definir correspondencias de sus datos con términos RDF, y el módulo RDF habilita estos datos RDF en el tema. Los módulos del núcleo de Drupal definen correspondencias RDF para su modelo de datos, y los temas del núcleo de Drupal muestran esta información de metadatos RDF junto con la información visual para los usuarios. Para más información, consulte la documentación en línea del <a href="@rdf">módulo RDF</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5431','La URL actual es @url.','es','0','0','0'),('5432','El título de página @actual es igual que @unexpected.','es','0','0','0'),('5433','El título de página @actual no es igual que @unexpected.','es','0','0','0'),('5434','Respuesta HTTP no esperada !code,  real !curl_code','es','0','0','0'),('5435','Configurar los permisos de @module','es','0','0','0'),('5436','Seleccionar y configurar sus temas.','es','0','0','0'),('5437','Administrar opciones.','es','0','0','0'),('5438','Ver informes, actualizaciones y errores.','es','0','0','0'),('5439','Guarda datos temporales de system_update_7061.','es','0','0','0'),('5440','barra de herramientas administrativa','es','0','0','0'),('5441','Instalar tema o módulo nuevo','es','0','0','0'),('5442','Instalar nuevo módulo','es','0','0','0'),('5443','Instalar nuevo tema','es','0','0','0'),('5444','%property es %value','es','0','0','0'),('5445','Gestionar las cuentas, roles y permisos de usuarios.','es','0','0','0'),('5446','El permiso ''publicar comentarios sin aprobación'' ha sido renombrado ''omitir aprobación de comentario''.','es','0','0','0'),('5447','Nada','es','0','0','0'),('5448','Lolspeak','es','0','0','0'),('5449','%type: !message en %function (línea %line de %file).','es','0','0','0'),('5450','Actualizar @title','es','0','0','0'),('5451','Un nombre único para el sistema. Debe estar compuesto por letras minúsculas, números y guiones bajos únicamente.','es','0','0','0'),('5452','El nombre de sistema debe contener caracteres únicos.','es','0','0','0'),('5453','El nombre de sistema debe contener únicamente letras minúsculas, números, y guiones.','es','0','0','0'),('5454','El nombre de sistema ya está en uso. Debe ser único','es','0','0','0'),('5455','Asturiano','es','0','0','0'),('5456','Ingles, Británico','es','0','0','0'),('5457','Criollo haitiano','es','0','0','0'),('5458','Portugués, internacional','es','0','0','0'),('5459','Peso para @title','es','0','0','0'),('5460','Peso para la fila @number','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5461','Padre de @title','es','0','0','0'),('5462','Etiqueta del nuevo campo','es','0','0','0'),('5463','Padre del nuevo campo','es','0','0','0'),('5464','Tipo de campo nuevo','es','0','0','0'),('5465','Control para campo nuevo','es','0','0','0'),('5466','Etiqueta para campo existente','es','0','0','0'),('5467','Padre del campo existente','es','0','0','0'),('5468','Campo existente para compartir','es','0','0','0'),('5469','Control para campo existente','es','0','0','0'),('5470','Presentación de etiqueta de @title','es','0','0','0'),('5471','Formateador para @title','es','0','0','0'),('5472','Padres de @title','es','0','0','0'),('5473','Visibilidad para @title','es','0','0','0'),('5474','Hay datos para este campo en la base de datos. Las opciones de este campo ya no se pueden cambiar.','es','0','0','0'),('5475','Peso del nuevo archivo','es','0','0','0'),('5476','Elija un archivo','es','0','0','0'),('5477','Peso para nuevo efecto','es','0','0','0'),('5478','Proveedor de idioma @title','es','0','0','0'),('5479','Activar el enlacé de menú de @title','es','0','0','0'),('5480','Un nombre único para construir la URL del menú. Debe contener únicamente letras minúsculas, números y guiones.','es','0','0','0'),('5481','Un nombre único de sistema para este tipo de contenido. Debe contener únicamente letras minúsculas, números y guiones bajos. Este nombre será usado para construir la URL de las páginas para agregar %node, en las que los guiones bajos serán convertidos a guiones.','es','0','0','0'),('5482','Etiqueta de opción','es','0','0','0'),('5483','Nueva etiqueta de opción','es','0','0','0'),('5484','Cantidad de votos para la opción @label','es','0','0','0'),('5485','Cantidad de votos para opción nueva','es','0','0','0'),('5486','Peso para la opción @label','es','0','0','0'),('5487','Peso para nueva opción','es','0','0','0'),('5488','Categoría para @title','es','0','0','0'),('5489','Módulos activos','es','0','0','0'),('5490','@original_title (@parent_title)','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5491','Su version de PHP Instalada es muy antigua. Drupal requiere al menos PHP 5.2.5, o PHP @version con el parche de seguridad para htmlspecialchars aplicado.','es','0','0','0'),('5492','Su servidor web parece no admitir PDO (Objetos de Datos de PHP). pregunte a su proveedor de alojamiento si admite la extension PDO nativa. Vea la página de <a href="@link">requisitos del sistema</a> para más información.','es','0','0','0'),('5493','Su servidor web parece tener una version de PDO incorrecta. Drupal 7 requiere la extensión original que vienen con PHP. Este sistema tiene la version de PECL anterior. Vea la página de <a href="@link">requisitos del sistema</a> para más información.','es','0','0','0'),('5494','Lista de acciones del disparador cuando !description','es','0','0','0'),('5495','La versión de base de datos %version es menor que la mínima requerida %minimum_version.','es','0','0','0'),('5496','!theme (tema predeterminado)','es','0','0','0'),('5497','!theme (tema de administración)','es','0','0','0'),('5498','El módulo Dashboard proporciona una <a href="@dashboard">página de Panel de control</a> en la interfaz administrativa para organizar las tareas administrativas y navegación, y monitorear información en su sitio. La página de Panel de control contiene bloques que se pueden agregar y organizar usando una interfaz de arrastrar y soltar que aparece cuando se hace clic en el enlace <em>Personalizar panel de control</em>. Dentro de esta interfaz, los bloques que no son utilizados principalmente para la administración del sitio no aparecen de forma predeterminada, pero se pueden agregar a través del enlace <em>Agregar otros bloques</em>. Para más información, consulte las páginas del manual en linea sobre el <a href="@handbook">módulo Dashboard</a>.','es','0','0','0'),('5499','Reacomodar bloques para desplegar en la <a href="@dashboard-url">página Dashboard</a>. Bloques ubicados en la región <em>Dashboard (inactiva)</em> no son mostrados al ver la página Dashboard, pero están disponibles dentro de la interfaz de <em>Personalizar dashboard</em>. Remover un bloque de el despliegue del dashboard activo lo hace disponible en la <a href="@blocks-url">página de administración de bloques</a> principal.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5500','Añadir otros bloques','es','0','0','0'),('5501','URL alternativa','es','0','0','0'),('5502','Utilizar un idioma ya detectado para las URLs si no se encuentra ninguno.','es','0','0','0'),('5503','%type_name: Crear contenido nuevo','es','0','0','0'),('5504','%type_name: Editar contenido propio','es','0','0','0'),('5505','%type_name: Editar cualquier contenido','es','0','0','0'),('5506','%type_name: Borrar contenido propio','es','0','0','0'),('5507','%type_name: Borrar cualquier contenido','es','0','0','0'),('5508','Si tiene problemas para acceder a las páginas de administración de este sitio, desactive la superposición en su página de perfil.','es','0','0','0'),('5509','Retirar este mensaje','es','0','0','0'),('5510','Opciones de la capa superpuesta de administración','es','0','0','0'),('5511','Siguientes pasos','es','0','0','0'),('5512','El archivo %file no pudo ser copiado, porque el directorio destino %destination no está configurado de forma correcta.','es','0','0','0'),('5513','opciones de @driver_name','es','0','0','0'),('5514','MySQL, MariaDB o equivalente','es','0','0','0'),('5515','SQLite','es','0','0','0'),('5516','Archivo de base de datos','es','0','0','0'),('5517','La ruta absoluta al archivo donde los datos de @drupal serán almacenados. Este debe ser tener permisos de escritura para el servidor web y debería existir fuera de la raíz web.','es','0','0','0'),('5518','El directorio que especificó no tiene permisos de escritura para el servidor web.','es','0','0','0'),('5519','Ventana emergente con autocompletado','es','0','0','0'),('5520','Buscando coincidencias','es','0','0','0'),('5521','El módulo Field permite definir campos personalizados de datos para tipos de <em>entidades</em> (las entidades incluyen elementos de contenido, cuentas de usuarios y términos de taxonomía). El módulo Field se encarga de almacenar, cargar, editar y mostrar datos de campos. La mayoría de los usuarios no interactuarán con el módulo Field directamente, sino que utilizarán la interfaz de usuario del <a href="@field-ui-help">módulo Field UI</a>. Los desarrolladores de módulos pueden utilizar el Field API para hacer que los nuevos tipos de entidades permitan que se les adjunte nuevos campos. Para más información, consulte el artículo en el manual acerca del <a href="@field"> módulo Field</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5522','No existen campos todavía.','es','0','0','0'),('5523','Negrita','es','0','0','0'),('5524','Leer más<span class="element-invisible"> sobre @title</span>','es','0','0','0'),('5525','De forma opcional, especifique un URL alternativo por el cuál se puede acceder a este contenido. Por ejemplo, escriba «acerca» cuando escriba una página acerca del sitio. Use una ruta relativa y no agregue la barra inclinada al final, de lo contrario el alias de URL no funcionará.','es','0','0','0'),('5526','El número de votos que se han emitido en una encuesta.','es','0','0','0'),('5527','La longitud de tiempo que la encuesta está configurada para ejecutarse.','es','0','0','0'),('5528','Desinstalar módulo @module','es','0','0','0'),('5529','Reunir y comprimir archivos CSS.','es','0','0','0'),('5530','Juntar los archivos JavaScript.','es','0','0','0'),('5531','Para desinstalar @module, debe desinstalar antes el siguiente módulo: @required_modules','es','0','0','0'),('5532','Para desinstalar @module, debe desinstalar antes los siguiente módulos: @required_modules','es','5531','1','0'),('5533','Activar los módulos agregados recientemente','es','0','0','0'),('5534','Activar los temas agregados recientemente','es','0','0','0'),('5535','El proceso de desinstalación elimina toda la información relacionada con un módulo. Para desinstalar un módulo primero tiene que deshabilitarlo en la <a href="@modules">página de módulos</a>.','es','0','0','0'),('5536','Ver el tema de administración','es','0','0','0'),('5537','Sistema de base de datos','es','0','0','0'),('5538','Versión del sistema de base de datos','es','0','0','0'),('5539','Indexados %count elementos del contenido para seguimiento.','es','0','0','0'),('5540','Notas de lanzamiento para @project_title','es','0','0','0'),('5541','Las opciones del rol se han actualizado.','es','0','0','0'),('5542','Desactivar la cuenta y mantener su contenido.','es','0','0','0'),('5543','Desactivar la cuenta y retirar de la publicación su contenido.','es','0','0','0'),('5544','Eliminar la cuenta y atribuir todo su contenido al usuario %anonymous-name.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5545','Eliminar la cuenta  y su contenido.','es','0','0','0'),('5546','Mostrar en el formulario de registro como usuario.','es','0','0','0'),('5547','Esto es obligatorio para los campos marcados como «requerido»','es','0','0','0'),('5548','Prueba compatible con el listado de sistema de Drupal','es','0','0','0'),('5549','Módulo de soporte para probar la función drupal_system_listing','es','0','0','0'),('5550','Prueba incompatible con el listado de sistema de Drupal','es','0','0','0'),('5551','Hay @count acciones huérfanas (%orphans) en la tabla de acciones. !link','es','0','0','0'),('5552','Borrado 1 comentario.','es','0','0','0'),('5553','Utilizar etiqueta de campo en lugar de «En valor» como etiqueta','es','0','0','0'),('5554','Eliminado un envío.','es','0','0','0'),('5555','seguimiento','es','0','0','0'),('5556','No existe soporte para la actualización automática del núcleo de Drupal. Consulte la <a href="@upgrade-guide">guía de actualización</a> para información acerca de cómo actualizar el núcleo de Drupal de forma manual.','es','0','0','0'),('5557','%archive_file contiene una versión de %names que no es compatible con Drupal !version.','es','0','0','0'),('5558','%archive_file contiene versiones de módulos o temas que no son compatibles con Drupal !version: %names','es','5557','1','0'),('5559','El ajuste de configuración %setting está actualmente en ''current_value%'', pero debe ser ''%needed_value''. Puede cambiarlo ejecutando la siguiente consulta: !query','es','0','0','0'),('5560','Lista (de números enteros)','es','0','0','0'),('5561','Este campo almacena valores enteros de una lista de valores permitidos en pares «valor => etiqueta», por ejemplo: «Período de tiempo en días»: 1 => 1 día, 7 => 1 semana, 31 => 1 mes.','es','0','0','0'),('5562','Lista (de números decimales)','es','0','0','0'),('5563','Este campo almacena valores reales de una lista de valores permitidos en pares «valor => etiqueta», por ejemplo: «Fracción»: 0 => 0, .25 => 1/4, .75 => 3/4, 1 => 1.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5564','Este campo almacena valores de texto de una lista de valores permitidos en pares «valor => etiqueta», por ejemplo: «Estados de EEUU»: IL => Illinois, IA => Iowa, IN => Indiana.','es','0','0','0'),('5565','Los valores posibles que puede contener este campo. Escriba un valor por línea, en el formato clave|etiqueta.','es','0','0','0'),('5566','La clave es el valor almacenado, y debe ser numérico. La etiqueta será usada en los valores mostrados y formularios de edición.','es','0','0','0'),('5567','La etiqueta es opcional: si una línea contiene un solo número, este será usado como clave y etiqueta.','es','0','0','0'),('5568','También se aceptan listas de etiquetas (una etiqueta por línea), pero sólo si el campo aun no contiene valor alguno. Se crearán automáticamente claves númericas a partir de las posiciones en la lista.','es','0','0','0'),('5569','La clave es el valor guardado. La etiqueta será usada en los valores mostrados y en formularios de edición.','es','0','0','0'),('5570','La etiqueta es opcional: si una línea contiene un solo texto, se usará como clave y etiqueta.','es','0','0','0'),('5571','Lista de valores permitidos: entrada no válida.','es','0','0','0'),('5572','Lista de valores permitidos: algunos valores han sido eliminados mientras estaban siendo usados.','es','0','0','0'),('5573','No se puede actualizar un campo de lista que no incluya claves de datos existentes.','es','0','0','0'),('5574','No se puede analizar archivo de información: %info_file.','es','0','0','0'),('5575','El archivo de información (%info_file) no tiene un atributo «nombre» definido.','es','0','0','0'),('5576','El entorno de pruebas necesita que el límite de memoria de PHP sea de %memory_minimum_limit como mínimo. Su valor actual es %memory_limit. <a href="@url">Siga estos pasos para continuar</a>.','es','0','0','0'),('5577','Puede encontrar <a href="@module_url">módulos</a> y <a href="@theme_url">temas</a> en <a href="@drupal_org_url">drupal.org</a>. Se permiten las siguientes extensiones: %extensions.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5578','Su servidor no permite actualizar módulos y temas desde esta interfaz. En su lugar, actualice los módulos y temas subiendo las versiones nuevas directamente al servidor, según se describe en el <a href="@handbook_url">manual</a>.','es','0','0','0'),('5579','Su servidor no soporta instalar módulos y temas desde esta interfaz. En cambio, instale módulos y temas subiéndolos diréctamente al servidor, como está descrito en el <a href="@handbook_url">manual</a>.','es','0','0','0'),('5580','La instalación de módulos y temas requiere de  <strong>acceso @backends</strong> a su servidor. Consulte el <a href="@handbook_url">manual</a> para otros métodos de instalación.','es','0','0','0'),('5581','La instalación de módulos y temas requiere de acceso a su servidor por medio de uno de los siguientes métodos: <strong>@backends</strong>. Consulte el <a href="@handbook_url">manual</a> para otros métodos de instalación.','es','5580','1','0'),('5582','%archive_file no contiene ningún archivo .info.','es','0','0','0'),('5583','Administrar contenido y comentarios.','es','0','0','0'),('5584','Campos de comentarios','es','0','0','0'),('5585','%name debe ser un valor hexadecimal de color CSS válido.','es','0','0','0'),('5586','No se puede renombrar el campo %id (%old_field_name) a %new_field_name porque no usa el tipo de almacenamiento field_sql_storage.','es','0','0','0'),('5587','Los cambios al estilo han sido guardados.','es','0','0','0'),('5588','Este bloque solamente se muestra si <a href="@languages">hay al menos dos idiomas habilitados</a> y <a href="@configuration">la negociación de idioma</a> está establecida en <em>URL</em> o <em>sesión</em>.','es','0','0','0'),('5589','(Nombre de sistema: @type)','es','0','0','0'),('5590','No optimizado','es','0','0','0'),('5591','OpenID sugiere el uso de la librería GMP Math de PHP para un rendimiento óptimo. Compruebe la <a href="@url">documentación de la librería GMP Math</a> para obtener instrucciones de instalación.','es','0','0','0'),('5592','Biblioteca Math OpenID','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5593','El módulo @module está ausente, entonces el siguiente módulo se desactivará: @depends.','es','0','0','0'),('5594','El módulo @module está ausente, entonces entonces los siguientes módulos se desactivarán: @depends.','es','5593','1','0'),('5595','El nombre de sistema no se puede «agregar» o «listar».','es','0','0','0'),('5596','Activa el soporte multi idioma para este tipo de contenido. Si se activa, un campo de selección de idioma se agregará al formulario de edición, permitiendole seleccionar uno de los <a href="!languages">idiomas activos</a>. Usted también puede activar las traducciones para este tipo de contenido, lo que le permite tener el contenido traducido a cualquiera de los idiomas instalados. Si se desactiva, los nuevos posts son guardados con el idioma por defecto. El contenido existente no se verá afectado al cambiar esta opción.','es','0','0','0'),('5597','Campo desconocido: @field_name','es','0','0','0'),('5598','%field: Solo debería haber un separador decimal (@separator).','es','0','0','0'),('5599','Activar !title','es','0','0','0'),('5600','Establecer !title poredeterminado','es','0','0','0'),('5601','Módulos habilitados: %modules','es','0','0','0'),('5602','El archivo %file no pudo ser copiado porque no existe.','es','0','0','0'),('5603','Curazao','es','0','0','0'),('5604','Tipo(s) de campo en uso - ver !link','es','0','0','0'),('5605','Tipo(s) de campo en uso','es','0','0','0'),('5606','Campos con eliminación pendiente','es','0','0','0'),('5607','(módulo: !module)','es','0','0','0'),('5608','Extender la funcionalidad del sitio.','es','0','0','0'),('5609','La página solicitada "@path" no se ha podido encontrar.','es','0','0','0'),('5610','El formulario se ha quedado obsoleto. Copie cualquier tarea no guardada en el formulario de abajo y <a href="@link">recargue esta página</a>.','es','0','0','0'),('5611','Hay varias decisiones que usted deberá tomar antes de definir un campo para el contenido, los comentarios, etc.:','es','0','0','0'),('5612','Módulos de búsqueda activos','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5613','No hay atajos disponibles. <a href="@link">Añadir un atajo</a>.','es','0','0','0'),('5614','Deje esto en blanco para eliminar tanto el nombre de usuario como la contraseña existentes.','es','0','0','0'),('5615','Para cambiar la contraseña, escriba aquí la nueva contraseña.','es','0','0','0'),('5616','Las credenciales de autentificación HTTP deben incluir un nombre de usuario además de una contraseña.','es','0','0','0'),('5617','Incompatible con esta versión del núcleo de Drupal.','es','0','0','0'),('5618','Cron se ocupa de ejecutar tareas periódicas como comprobar actualizaciones e indexar contenido para la búsqueda.','es','0','0','0'),('5619','Ha pasado el test de URL limpias.','es','0','0','0'),('5620','Las URLs limpias están activadas, pero ha fallado el test de URL limpia. Quite la marca de la casilla de abajo para desactivar las URLs limpias.','es','0','0','0'),('5621','Ha fallado el test de URL limpias.','es','0','0','0'),('5622','Nombre de usuario y contraseña','es','0','0','0'),('5623','Elementos de formulario en cuentas del módulo User.','es','0','0','0'),('5624','Ha habido un problema al crear el campo %label: !message','es','0','0','0'),('5625','@module (<span class="admin-missing">incompatible con</span> esta versión del núcleo de Drupal)','es','0','0','0'),('5626','Formularios','es','0','0','0'),('5627','Enlaces','es','0','0','0'),('5628','Diseño','es','0','0','0'),('5629','Seleccionar un diseño','es','0','0','0'),('5630','Enviado','es','0','0','0'),('5631','CSS ID','es','0','0','0'),('5632','Dos columnas','es','0','0','0'),('5633','Dos columnas apiladas','es','0','0','0'),('5634','Campos','es','0','0','0'),('5635','Otro','es','0','0','0'),('5636','Texto vacío','es','0','0','0'),('5637','Sin categorías','es','0','0','0'),('5638','Extras','es','0','0','0'),('5639','Búsqueda de usuario','es','0','0','0'),('5640','Medio','es','0','0','0'),('5641','Motor de búsqueda','es','0','0','0'),('5642','Fragmento','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5643','Periodo de vida','es','0','0','0'),('5644','Clases','es','0','0','0'),('5645','Sin configurar','es','0','0','0'),('5646','Editar contenido','es','0','0','0'),('5647','Cambiar diseño','es','0','0','0'),('5648','Un ID que puede ser utilizado por CSS para dar estilo al panel.','es','0','0','0'),('5649','Desactivar bloques/regiones de Drupal','es','0','0','0'),('5650','Elemento','es','0','0','0'),('5651','Nombre de región','es','0','0','0'),('5652','Apache Solr','es','0','0','0'),('5653','Mostrar título','es','0','0','0'),('5654','Fecha del envío','es','0','0','0'),('5655','Conjunto de campos','es','0','0','0'),('5656','Configurado','es','0','0','0'),('5657','Autor vinculado al perfil','es','0','0','0'),('5658','Las opciones de contenifo se dividen por categoría. Seleccione, por favor, una categoría de la izquierda para proceder.','es','0','0','0'),('5659','Seleccionar contenido','es','0','0','0'),('5660','Configurar opciones de búsqueda','es','0','0','0'),('5661','Seleccionar vista','es','0','0','0'),('5662','Establecido manualmente','es','0','0','0'),('5663','Entidades','es','0','0','0'),('5664','Presentaciones de vistas','es','0','0','0'),('5665','Suite de visualización','es','0','0','0'),('5666','Campo de código','es','0','0','0'),('5667','Campo de bloque','es','0','0','0'),('5668','Código de campo','es','0','0','0'),('5669','Mostrar sólo contenido de bloque','es','0','0','0'),('5670','H1 título','es','0','0','0'),('5671','H2 título','es','0','0','0'),('5672','Título del párrafo','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5673','Variables extra','es','0','0','0'),('5674','Envoltorio','es','0','0','0'),('5675','Región a bloque','es','0','0','0'),('5676','Encabezado de vistas','es','0','0','0'),('5677','Filtros expuestos','es','0','0','0'),('5678','Adjunto antes','es','0','0','0'),('5679','Adjunto después','es','0','0','0'),('5680','Pie de página de vistas','es','0','0','0'),('5681','Icono de canal de noticias','es','0','0','0'),('5682','Preprocesar campo','es','0','0','0'),('5683','Campos de la suite de visualización','es','0','0','0'),('5684','Mostrar campos a través del módulo de Suite de visualización.','es','0','0','0'),('5685','Estilos para campos','es','0','0','0'),('5686','Estilos para regiones','es','0','0','0'),('5687','Título de vistas','es','0','0','0'),('5688','Selector HTML','es','0','0','0'),('5689','Modo de visualización','es','0','0','0'),('5690','Datos de grupo','es','0','0','0'),('5691','Ningún campo se muestra en esta región.','es','0','0','0'),('5692','Diseño para !bundle en !view_mode','es','0','0','0'),('5693','Ha seleccionado el diseño %layout_label. La plantilla por defecto puede encontrarse en %path','es','0','0','0'),('5694','Ocultar regiones vacías','es','0','0','0'),('5695','Clases adicionales para las regiones','es','0','0','0'),('5696','Clase para @region','es','0','0','0'),('5697','Gestionar estilos de regiones','es','0','0','0'),('5698','No se han definido campos personalizados.','es','0','0','0'),('5699','Campo no encontrado','es','0','0','0'),('5700','Una columna','es','0','0','0'),('5701','Tres columnas - 25/50/25','es','0','0','0'),('5702','Tres columnas - mismo ancho','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5703','Tres columnas apiladas - 25/50/25','es','0','0','0'),('5704','Tres columnas apiladas - mismo ancho','es','0','0','0'),('5705','Tres columnas apiladas - 25/50/25 (HTML5)','es','0','0','0'),('5706','Cuatro columnas - mismo ancho','es','0','0','0'),('5707','No se han definido modos de visualización personalizados.','es','0','0','0'),('5708','Utilizando código personalizado con Display Suite','es','0','0','0'),('5709','Cambiar modo de visualización','es','0','0','0'),('5710','No hay vistas seleccionadas','es','0','0','0'),('5711','Regiones de bloques','es','0','0','0'),('5712','Escriba un nombre para crear una nueva región.','es','0','0','0'),('5713','Regiones de bloque existentes','es','0','0','0'),('5714','Gestionar sus plantillas de vistas.','es','0','0','0'),('5715','No ha definido ningún estilo que pueda usarse en las regiones.','es','0','0','0'),('5716','Gestionar diseño','es','0','0','0'),('5717','Fluido dos columnas apiladas','es','0','0','0'),('5718','Fluido tres columnas apiladas - 25 / 50 / 25','es','0','0','0'),('5719','Configurar estilos que puede añadir a las regiones en las páginas de "Gestionar presentación". Para añadir múltiples estilos, escriba uno en cada línea.<br />Si quiere disponer de un nombre descriptivo, separe la clase y el nombre descriptivo por |, pero no es obligatorio. Por ejemplo:<br /><em>clase_1<br />clase_2|Nombre descriptivo<br />clase_3</em>','es','0','0','0'),('5720','Presentación de campo','es','0','0','0'),('5721','Elija un estilo de campo','es','0','0','0'),('5722','Envoltorio externo','es','0','0','0'),('5723','Elementos de campo','es','0','0','0'),('5724','Elemento de campo','es','0','0','0'),('5725','Clases: !classes','es','0','0','0'),('5726','Experto','es','0','0','0'),('5727','Plantillas de campos','es','0','0','0'),('5728','Activar plantillas de campos','es','0','0','0'),('5729','Personalizar las etiquetas y el código HTML de sus campos.','es','0','0','0'),('5730','Campos adicionales','es','0','0','0'),('5731','Activar campos adicionales','es','0','0','0'),('5732','Hacer que los campos de otros módulos estén disponibles en las páginas de "Gestionar presentación".','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5733','Añadir enlaces contextuales (si es posible) para administrar el diseño.','es','0','0','0'),('5734','Crear regiones adicionales expuestas como bloques. Nota: ésto no funcionará con el modo de visualización por defecto.','es','0','0','0'),('5735','Administrar modos de visualización','es','0','0','0'),('5736','Marcar esta opción para que en la página se deshabiliten todas las regiones de barras laterales que se muestran en el tema. Tenga en cuenta que algunos temas de soportan esta opción mejor que otros. En caso de duda, pruebe con los temas básicos para comprobarlo.','es','0','0','0'),('5737','Tenga en cuenta que no todos los campos podrían estar disponibles.','es','0','0','0'),('5738','Añadir campos personalizados','es','0','0','0'),('5739','Añadir un campo de código','es','0','0','0'),('5740','Añadir un campo dinámico','es','0','0','0'),('5741','Añadir un campo de bloque','es','0','0','0'),('5742','Modo de visualización Revisión','es','0','0','0'),('5743','Hacer que esté disponible el nuevo modo de visualización "Revisión" que puede usarse para configurar el diseño de la revisión de un nodo.','es','0','0','0'),('5744','Opciones del título de la página','es','0','0','0'),('5745','Seleccionar una Vista que quiera gestionar con Display suite. Si una Vista usa campos también puede seleccionar esta vista con el fin de elegir el diseño y la posición de los campos. Tenga en cuenta que el html de la etiqueta y el campo están limitados.','es','0','0','0'),('5746','Multi idioma','es','0','0','0'),('5747','Método de actualización','es','0','0','0'),('5748','Actualizaciones de traducciones','es','0','0','0'),('5749','Actualizar traducciones','es','0','0','0'),('5750','Estado de la actualización de traducciones','es','0','0','0'),('5751','Hay actualizaciones disponibles','es','0','0','0'),('5752','Todas sus traducciones están actualizadas','es','0','0','0'),('5753','No hay proyectos o idiomas por actualizar','es','0','0','0'),('5754','Seleccione uno o más idiomas para descargar y actualizar. Si no selecciona ninguno, se actualizarán todos.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5755','Actualizar información','es','0','0','0'),('5756','No se encuentra ninguna actualización de traducción.','es','0','0','0'),('5757','Fuente de actualización','es','0','0','0'),('5758','Nunca (manualmente)','es','0','0','0'),('5759','Seleccione la frecuencia que desea para la verificación automática de traducciones actualizadas para módulos y temas instalados.','es','0','0','0'),('5760','Actualizar los módulos inactivos','es','0','0','0'),('5761','Actívelo  si desea que los módulos inactivos se actualicen también. Esto supone una importante merma de rendimiento, por lo que no se recomienda.','es','0','0','0'),('5762','Almacenar archivos descargados','es','0','0','0'),('5763','Las traducciones actualizadas reemplazan las existentes. Las nuevas se agregan.','es','0','0','0'),('5764','Las traducciones editadas se mantienen, solo las predeterminadas (previamente importadas) son sobrescritas, y las nuevas traducciones son agregadas.','es','0','0','0'),('5765','Archivos locales y servidor remoto.','es','0','0','0'),('5766','Sólo archivos locales','es','0','0','0'),('5767','Sólo servidor remoto.','es','0','0','0'),('5768','Disponible actualización remota','es','0','0','0'),('5769','Actualización local disponible','es','0','0','0'),('5770','No hay información','es','0','0','0'),('5771','Actualizando traducción.','es','0','0','0'),('5772','Descargando e importando archivos.','es','0','0','0'),('5773','Importando traducción descargada: %url.','es','0','0','0'),('5774','Ha fallado la descarga desde %url','es','0','0','0'),('5775','La traducción ha sido descargada e importada correctamente de %url','es','0','0','0'),('5776','Archivo de traducción %name importado.','es','0','0','0'),('5777','Ha fallado la importación del archivo de traducción %name.','es','0','0','0'),('5778','Traducciones importadas correctamente.','es','0','0','0'),('5779','Error al importar las traducciones.','es','0','0','0'),('5780','l10n_update','es','0','0','0'),('5781','%download_link descargado con éxito a %tmpfile','es','0','0','0'),('5782','No se ha podido descargar y guardar el archivo  %download_link en %tmpfile.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('5783','Error al crear el archivo temporal de descarga en %tmpdir. El archivo remoto es %download_link.','es','0','0','0'),('5784','Lista de las últimas traducciones importadas y de las actualizaciones disponibles para cada proyecto e idioma activos.','es','0','0','0'),('5785','Si hay actualizaciones disponibles puede hacer clic en Actualizar para descargarlas e importarlas ahora, o puede editar la configuración para que sean actualizadas de forma automática en la <a href="@update-settings">Página de configuración de actualizaciones</a>','es','0','0','0'),('5786','Estas son las opciones de configuración del sistema de actualización de traducciones. Para actualizar sus traducciones ahora, vea la <a href="@update-admin">Página de administración de la actualización de traducción</a>.','es','0','0','0'),('5787','@checked traducciones comprobadas automáticamente, @updated actualizadas.','es','0','0','0'),('5788','Configuración de actualización automática','es','0','0','0'),('5789','Hay traducciones nuevas o actualizadas disponibles para los módulos y los temas instalados actualmente. Para revisar si hay actualizaciones, puede visitar la <a href="@check_manually">página de actualización de traducciones</a>.','es','0','0','0'),('5790','Una ruta relativa al directorio de instalación de Drupal en la que los archivos de traducción serán almacenados, e.g. sites/all/translations. Los archivos de traducciones almacenados pueden ser reutilizados por otras instalaciones. Si se deja vacío, las traducciones descargadas no serán almacenadas.','es','0','0','0'),('5791','No se ha guardado localmente por contener HTML inválido.','es','0','0','0'),('5792','Traducción guardada localmente.','es','0','0','0'),('5793','La traducción se ha borrado localmente de forma correcta.','es','0','0','0'),('5794','Error desconocido mientras se guardaba localmente la traducción.','es','0','0','0'),('5795','No se ha guardado por no encontrar la cadena de origen.','es','0','0','0'),('5796','No se ha guardado por faltar valores en el formulario.','es','0','0','0');
