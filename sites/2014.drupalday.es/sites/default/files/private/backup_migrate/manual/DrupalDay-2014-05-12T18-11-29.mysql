INSERT INTO `locales_source` VALUES ('13404','/index.php','default','An array of projects already being processed','','7.12'),('13405','/index.php','default','Select output format. Available: csv, json, list, table, var_export, yaml. Default is key-value-list.','','7.12'),('13406','/index.php','default','Show a report of available minor updates to Drupal core and contrib projects.','','7.12'),('13407','/index.php','default','Optional. A list of installed projects to show.','','7.12'),('13408','/index.php','default','Return a list of the projects with any extensions enabled that need updating, one project per line.','','7.12'),('13409','/index.php','default','Only update modules that have security updates available.','','7.12'),('13410','/index.php','default','Check to see if an updatedb is needed after updating the code. Default is on; use --check-updatedb=0 to disable.','','7.12'),('13411','/index.php','default','Update contrib projects, but skip core.','','7.12'),('13412','/index.php','default','To show a list of projects with their update status, use pm-updatestatus instead of pm-updatecode.','','7.12'),('13413','/index.php','default','Create a new role.','','7.12'),('13414','/index.php','default','The symbolic machine name for the role. Required.','','7.12'),('13415','/index.php','default','A descriptive name for the role. Optional; Drupal 8 only.  Ignored in D6 and D7.','','7.12'),('13416','/index.php','default','Create a new role ''test role'' on D6 or D7; auto-assign the rid. On D8, ''test role'' is the rid, and the human-readable name is set to ''Test role''.','','7.12'),('13417','/index.php','default','Create a new role with a machine name of ''test role'', and a human-readable name of ''Test role''. On D6 and D7, behaves as the previous example.','','7.12'),('13418','/index.php','default','Delete a role.','','7.12'),('13419','/index.php','default','The symbolic machine name for the role. Required.  In D6 and D7, this may also be a numeric role ID.','','7.12'),('13420','/index.php','default','Delete the role ''test role''.','','7.12'),('13421','/index.php','default','Grant a specified permission to a role.','','7.12');
INSERT INTO `locales_source` VALUES ('13422','/index.php','default','The role to modify.  Required.','','7.12'),('13423','/index.php','default','The permission to grant. Required, unless the --module option is used.','','7.12'),('13424','/index.php','default','Select the permission to modify from an interactive list of all permissions available in the specified module.','','7.12'),('13425','/index.php','default','Allow anonymous users to put their own advertisements on your site.','','7.12'),('13426','/index.php','default','Select a permission from "node" permissions to add to authenticated users.','','7.12'),('13427','/index.php','default','Remove a specified permission from a role.','','7.12'),('13428','/index.php','default','The role to modify.','','7.12'),('13429','/index.php','default','The permission to remove. Required, unless the --module option is used.','','7.12'),('13430','/index.php','default','Hide content from anonymous users.','','7.12'),('13431','/index.php','default','Display a list of all roles defined on the system.  If a role name is provided as an argument, then all of the permissions of that role will be listed.  If a permission name is provided as an option, then all of the roles that have been granted that permission will be listed.','','7.12'),('13432','/index.php','default','The role to list.  Optional; if specified, lists all permissions assigned to that role.  If no role is specified, lists all of the roles available on the system.','','7.12'),('13433','/index.php','default','Limits the list of roles to only those that have been assigned the specified permission. Optional; may not be specified if a role argument is provided.','','7.12'),('13434','/index.php','default','Display a list of roles that have the administer nodes permission assigned.','','7.12'),('13435','/index.php','default','Display all of the permissions assigned to the anonymous user role.','','7.12'),('13436','/index.php','default','Start runserver on IPv6 localhost ::1, port 80.','','7.12'),('13437','/index.php','default','Select output format. Available: json, list, var_export, yaml. Default is message.','','7.12');
INSERT INTO `locales_source` VALUES ('13438','/index.php','default','Select output format. Available: config, csv, json, list, table, var_export, yaml. Default is config.','','7.12'),('13439','/index.php','default','Site specification to use, or "-" for previous site. Omit this argument to "unset"','','7.12'),('13440','/index.php','default','Without an argument, any existing site becomes unset.','','7.12'),('13441','/index.php','default','The name of a target within the specified database connection. Defaults to ''default''.','','7.12'),('13442','/index.php','default','A Drupal 6 style database URL.','','7.12'),('13443','/index.php','default','Select output format. Available: print-r, csv, json, list, string, table, var_export, yaml. Default is print-r.','','7.12'),('13444','/index.php','default','A database specification','','7.12'),('13445','/index.php','default','A key within the SOURCE database identifying a particular server in the database group.','','7.12'),('13446','/index.php','default','Oy. A key within the TARGET database identifying a particular server in the database group.','','7.12'),('13447','/index.php','default','Directory to store sql dump files in when --source-dump or --target-dump are not used.','','7.12'),('13448','/index.php','default','Skip reading table information. This gives a quicker start of mysql.','','7.12'),('13449','/index.php','default','Open a SQL command-line interface using Drupal''s credentials and skip reading table information.','','7.12'),('13450','/index.php','default','Directory to change to. Use a full path, TRUE for the site''s Drupal root directory, or FALSE for the remote user''s home directory. Defaults to the Drupal root.','','7.12'),('13451','/index.php','default','Run "git pull" on the Drupal root directory on the @prod site.','','7.12'),('13452','/index.php','default','Select output format. Available: labeled-export, csv, json, list, string, table, var_export, yaml. Default is labeled-export.','','7.12'),('13453','/index.php','default','Return extended information about each message.','','7.12');
INSERT INTO `locales_source` VALUES ('13454','/index.php','default','Calling hook !hook','','7.12'),('13455','/index.php','default','''!name'' cache was cleared.','','7.12'),('13456','/index.php','default','Returned from hook !hook','','7.12');
DROP TABLE IF EXISTS `locales_target`;
CREATE TABLE `locales_target` (   `lid` int(11) NOT NULL DEFAULT '0' COMMENT 'Source string ID. References locales_source.lid.',   `translation` blob NOT NULL COMMENT 'Translation string value in this language.',   `language` varchar(12) NOT NULL DEFAULT '' COMMENT 'Language code. References languages.language.',   `plid` int(11) NOT NULL DEFAULT '0' COMMENT 'Parent lid (lid of the previous string in the plural chain) in case of plural strings. References locales_source.lid.',   `plural` int(11) NOT NULL DEFAULT '0' COMMENT 'Plural index number in case of plural strings.',   `l10n_status` int(11) NOT NULL DEFAULT '0',   PRIMARY KEY (`language`,`lid`,`plural`),   KEY `lid` (`lid`),   KEY `plid` (`plid`),   KEY `plural` (`plural`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Stores translated versions of strings.';
