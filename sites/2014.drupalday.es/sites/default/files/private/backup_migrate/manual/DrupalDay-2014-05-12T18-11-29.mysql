INSERT INTO `locales_source` VALUES ('3816','','default','Theme key "@key" not found.','','none'),('3817','','default','Unable to determine the type of the source directory.','','none'),('3818','','default','Cannot determine the type of project.','','none'),('3819','','default','Fatal error in update, cowardly refusing to wipe out the install directory.','','none'),('3820','','default','File Transfer failed, reason: !reason','','none'),('3821','','default','Unable to create %directory due to the following: %reason','','none'),('3822','','default','Drupal could not be correctly setup with the existing database. Revise any errors.','','none'),('3823','','default','No feeds available. <a href="@link">Add feed</a>.','','none'),('3824','','default','No categories available. <a href="@link">Add category</a>.','','none'),('3825','','default','The length of time between feed updates. Requires a correctly configured <a href="@cron">cron maintenance task</a>.','','none'),('3826','','default','News items in block','','none'),('3827','','default','Drupal can make a block with the most recent news items of this feed. You can <a href="@block-admin">configure blocks</a> to be displayed in the sidebar of your page. This setting lets you configure the number of news items to show in this feed''s block. If you choose ''0'' this feed''s block will be disabled.','','none'),('3828','','default','The URL %url is invalid. Enter a fully-qualified URL, such as http://www.example.com/feed.xml.','','none'),('3829','','default','A feed named %feed already exists. Enter a unique title.','','none'),('3830','','default','A feed with this URL %url already exists. Enter a unique URL.','','none'),('3831','','default','Upload an OPML file containing a list of feeds to be imported.','','none'),('3832','','default','OPML Remote URL','','none'),('3833','','default','Enter the URL of an OPML file. This file will be downloaded and processed only once on submission of the form.','','none'),('3834','','default','Drupal can make a block with the most recent news items of a feed. You can <a href="@block-admin">configure blocks</a> to be displayed in the sidebar of your page. This setting lets you configure the number of news items to show in a feed''s block. If you choose ''0'' these feeds'' blocks will be disabled.','','none');
INSERT INTO `locales_source` VALUES ('3835','','default','You must <em>either</em> upload a file or enter a URL.','','none'),('3836','','default','This URL is not valid.','','none'),('3837','','default','No new feed has been added.','','none'),('3838','','default','The URL %url is invalid.','','none'),('3839','','default','A feed named %title already exists.','','none'),('3840','','default','A feed with the URL %url already exists.','','none'),('3841','','default','Fetchers download data from an external source. Choose a fetcher suitable for the external source you would like to download from.','','none'),('3842','','default','Parsers transform downloaded data into standard structures. Choose a parser suitable for the type of feeds you would like to aggregate.','','none'),('3843','','default','Processors act on parsed feed data, for example they store feed items. Choose the processors suitable for your task.','','none'),('3844','','default','For most aggregation tasks, the default settings are fine.','','none'),('3845','','default','A category named %category already exists. Enter a unique title.','','none'),('3846','','default','Default fetcher','','none'),('3847','','default','Downloads data from a URL using Drupal''s HTTP request handler.','','none'),('3848','','default','Default parser','','none'),('3849','','default','Parses RSS, Atom and RDF feeds.','','none'),('3850','','default','Default processor','','none'),('3851','','default','Creates lightweight records from feed items.','','none'),('3852','','default','Default processor settings','','none'),('3853','','default','Number of items shown in listing pages','','none'),('3854','','default','Requires a correctly configured <a href="@cron">cron maintenance task</a>.','','none'),('3855','','default','Select categories using','','none'),('3856','','default','For a small number of categories, checkboxes are easier to use, while a multiple selector works well with large numbers of categories.','','none'),('3857','','default','Length of trimmed description','','none'),('3858','','default','The maximum number of characters used in the trimmed version of content.','','none');
INSERT INTO `locales_source` VALUES ('3859','','default','The Aggregator module is an on-site syndicator and news reader that gathers and displays fresh content from RSS-, RDF-, and Atom-based feeds made available across the web. Thousands of sites (particularly news sites and blogs) publish their latest headlines in feeds, using a number of standardized XML-based formats. For more information, see the online handbook entry for <a href="@aggregator-module">Aggregator module</a>.','','none'),('3860','','default','Viewing feeds','','none'),('3861','','default','Feeds contain published content, and may be grouped in categories, generally by topic. Users view feed content in the <a href="@aggregator">main aggregator display</a>, or by <a href="@aggregator-sources">their source</a> (usually via an RSS feed reader). The most recent content in a feed or category can be displayed as a block through the <a href="@admin-block">Blocks administration page</a>.','','none'),('3862','','default','Adding, editing, and deleting feeds','','none'),('3863','','default','Administrators can add, edit, and delete feeds, and choose how often to check each feed for newly updated items on the <a href="@feededit">Feed aggregator administration page</a>.','','none'),('3864','','default','OPML integration','','none'),('3865','','default','A <a href="@aggregator-opml">machine-readable OPML file</a> of all feeds is available. OPML is an XML-based file format used to share outline-structured information such as a list of RSS feeds. Feeds can also be <a href="@import-opml">imported via an OPML file</a>.','','none'),('3866','','default','Configuring cron','','none'),('3867','','default','A correctly configured <a href="@cron">cron maintenance task</a> is required to update feeds automatically.','','none'),('3868','','default','<acronym title="Outline Processor Markup Language">OPML</acronym> is an XML format used to exchange multiple feeds between aggregators. A single OPML document may contain a collection of many feeds. Drupal can parse such a file and import all feeds at once, saving you the effort of adding them manually. You may either upload a local file from your computer or enter a URL where Drupal can download it.','','none');
INSERT INTO `locales_source` VALUES ('3869','','default','Administer news feeds','','none'),('3870','','default','View news feeds','','none'),('3871','','default','Configure the behavior of the feed aggregator, including when to discard feed items and how to present feed items and categories.','','none'),('3872','','default','Override the default title for the block. Use <em>!placeholder</em> to display no title, or leave blank to use the default block title.','','7.12'),('3873','','default','Specify in which themes and regions this block is displayed.','','7.12'),('3874','','default','All pages except those listed','','7.12'),('3875','','default','Only the listed pages','','7.12'),('3876','','default','Specify pages by using their paths. Enter one path per line. The ''*'' character is a wildcard. Example paths are %blog for the blog page and %blog-wildcard for every personal blog. %front is the front page.','','7.12'),('3877','','default','Pages on which this PHP code returns <code>TRUE</code> (experts only)','','none'),('3878','','default','Pages or PHP code','','none'),('3879','','default','If the PHP option is chosen, enter PHP code between %php. Note that executing incorrect PHP code can break your Drupal site.','','none'),('3880','','default','Customizable per user','','7.12'),('3881','; modules/block/block.js','default','Not customizable','','7.12'),('3882','','default','Customizable, visible by default','','7.12'),('3883','','default','Customizable, hidden by default','','7.12'),('3884','','default','Ensure that each block description is unique.','','7.12'),('3885','','default','The Block module allows you to create boxes of content, which are rendered into an area, or region, of one or more pages of a website. The core Seven administration theme, for example, implements the regions "Content", "Help", "Dashboard main", and "Dashboard sidebar", and a block may appear in any one of these regions. The <a href="@blocks">Blocks administration page</a> provides a drag-and-drop interface for assigning a block to a region, and for controlling the order of blocks within regions. For more information, see the online handbook entry for <a href="@block">Block module</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('3886','','default','Positioning content','','7.12'),('3887','','default','When working with blocks, remember that all themes do <em>not</em> implement the same regions, or display regions in the same way. Blocks are positioned on a per-theme basis. Users with the <em>Administer blocks</em> permission can disable blocks. Disabled blocks are listed on the <a href="@blocks">Blocks administration page</a>, but are not displayed in any region.','','7.12'),('3888','','default','Controlling visibility','','7.12'),('3889','','default','Blocks can be configured to be visible only on certain pages, only to users of certain roles, or only on pages displaying certain <a href="@content-type">content types</a>. Administrators can also allow specific blocks to be enabled or disabled by users when they edit their <a href="@user">My account</a> page. Some dynamic blocks, such as those generated by modules, will be displayed only on certain pages.','','7.12'),('3890','','default','Creating custom blocks','','7.12'),('3891','','default','Users with the <em>Administer blocks</em> permission can <a href="@block-add">add custom blocks</a>, which are then listed on the <a href="@blocks">Blocks administration page</a>. Once created, custom blocks behave just like default and module-generated blocks.','','7.12'),('3892','','default','This page provides a drag-and-drop interface for assigning a block to a region, and for controlling the order of blocks within regions. Since not all themes implement the same regions, or display regions in the same way, blocks are positioned on a per-theme basis. Remember that your changes will not be saved until you click the <em>Save blocks</em> button at the bottom of the page. Click the <em>configure</em> link next to each block to configure its specific title and visibility settings.','','7.12'),('3893','','default','Demonstrate block regions (@theme)','','7.12'),('3894','','default','Administer blocks','','7.12'),('3895','','default','A brief description of your block. Used on the <a href="@overview">Blocks administration page</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('3896','','default','Personalize blocks','','none'),('3897','','default','Blocks consist of content or information that complements the main content of the page. Enable or disable optional blocks using the checkboxes below.','','none'),('3898','','default','Cache blocks','','7.12'),('3899','','default','Block caching is inactive because you have enabled modules defining content access restrictions.','','none'),('3900','','default','Controls the visual building blocks a page is constructed with. Blocks are boxes of content rendered into an area, or region, of a web page.','','7.12'),('3901','; modules/block/block.js','default','Restricted to certain pages','','none'),('3902','; modules/block/block.js','default','The block cannot be placed in this region.','','none'),('3903','','default','Use for multi-user blogs. Every user gets a personal blog.','','none'),('3904','','default','Single-user blogs','','none'),('3905','','default','Each user''s blog entries are automatically displayed with a link to the user''s main blog page. You can create as many single-user blogs as you have site users with permission to create blog content.','','none'),('3906','','default','Multi-user blogs','','none'),('3907','','default','Blog entries from each single-user blog are also aggregated into one central multi-user blog, which displays the blog content of all users in a single listing.','','none'),('3908','','default','There is an optional <em>Blogs</em> menu item added to the Navigation menu, which displays all blogs available on your site, and a <em>My blog</em> item displaying the current user''s blog entries.','','none'),('3909','','default','The Blog module also creates a default <em>Recent blog posts</em> block that may be enabled at the <a href="@blocks">blocks administration page</a>.','','none'),('3910','','default','Create new blog entry','','none'),('3911','','default','Enables multi-user blogs.','','7.12'),('3912','','default','No books available.','','none'),('3913','','default','Content types allowed in book outlines','','none');
INSERT INTO `locales_source` VALUES ('3914','','default','Users with the %outline-perm permission can add all content types.','','none'),('3915','','default','Administer book outlines','','none'),('3916','','default','The Book module is used for creating structured, multi-page content, such as site resource guides, manuals, and wikis. It allows you to create content that has chapters, sections, subsections, or any similarly-tiered structure. For more information, see the online handbook entry for <a href="@book">Book module</a>.','','none'),('3917','','default','Adding and managing book content','','none'),('3918','','default','You can assign separate permissions for <em>creating</em>, <em>editing</em>, and <em>deleting</em> book content, as well as <em>adding content to books</em>, and <em>creating new books</em>. Users with the <em>Administer book outlines</em> permission can add <em>any</em> type of content to a book by selecting the appropriate book outline while editing the content. They can also view a list of all books, and edit and rearrange section titles on the <a href="@admin-book">Book administration page</a>.','','none'),('3919','','default','Book pages have a default book-specific navigation block. This navigation block contains links that lead to the previous and next pages in the book, and to the level above the current page in the book''s structure. This block can be enabled on the <a href=''@admin-block''>Blocks administration page</a>. For book pages to show up in the book navigation, they must be added to a book outline.','','none'),('3920','','default','Books can be created collaboratively, as they allow users with appropriate permissions to add pages into existing books, and add those pages to a custom table of contents menu.','','none'),('3921','','default','Printing books','','none'),('3922','','default','Users with the <em>View printer-friendly books</em> permission can select the <em>printer-friendly version</em> link visible at the bottom of a book page''s content to generate a printer-friendly display of the page and all of its subsections.','','none');
INSERT INTO `locales_source` VALUES ('3923','','default','The book module offers a means to organize a collection of related content pages, collectively known as a book. When viewed, this content automatically displays links to adjacent book pages, providing a simple navigation system for creating and reviewing structured content.','','none'),('3924','','default','The outline feature allows you to include pages in the <a href="@book">Book hierarchy</a>, as well as move them within the hierarchy or to <a href="@book-admin">reorder an entire book</a>.','','none'),('3925','','default','Create new books','','none'),('3926','','default','Add content and child pages to books','','none'),('3927','','default','View printer-friendly books','','none'),('3928','','default','View a book page and all of its sub-pages as a single document for ease of printing. Can be performance heavy.','','none'),('3929','','default','<em>Books</em> have a built-in hierarchical navigation. Use for handbooks or tutorials.','','none'),('3930','','default','Allows users to create and organize related content in an outline.','','7.12'),('3931','','default','The Color module allows users with the <em>Administer site configuration</em> permission to quickly and easily change the color scheme of themes that have been built to be compatible with it. For more information, see the online handbook entry for <a href="@color">Color module</a>.','','7.12'),('3932','','default','Changing colors','','7.12'),('3933','','default','Using the Color module allows you to easily change the color of links, backgrounds, text, and other theme elements. To change the color settings for a compatible theme, select the <em>Settings</em> link for your theme on the <a href=''@configure''>Themes administration page</a>. If you don''t see a color picker on that page, then your theme is not compatible with the color module. If you are sure that the theme does indeed support the color module, but the color picker does not appear, then <a href=''@troubleshoot''>follow these troubleshooting procedures</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('3934','','default','The Color module saves a modified copy of the theme''s specified stylesheets in the files directory. This means that if you make any manual changes to your theme''s stylesheet, <em>you must save your color settings again, even if they haven''t changed</em>. This step is required because the module stylesheets (in the files directory) need to be recreated to include your changes.','','7.12'),('3935','','default','The GD library for PHP is enabled, but was compiled without PNG support. Check the <a href="@url">PHP image documentation</a> for information on how to correct this.','','none'),('3936','','default','The GD library for PHP is missing or outdated. Check the <a href="@url">PHP image documentation</a> for information on how to correct this.','','none'),('3937','','default','Allows administrators to change the color scheme of compatible themes.','','7.12'),('3938','','default','Select one or more comments to perform the update on.','','none'),('3939','','default','There do not appear to be any comments to delete, or your selected comment was deleted by another administrator.','','none'),('3940','','default','Deleted @count comments.','','none'),('3941','','default','Deleted comment @cid and its replies.','','none'),('3942','','default','Comment approved.','','none'),('3943','','default','Tokens for comments posted on the site.','','7.12'),('3944','','default','The Comment module allows users to comment on site content, set commenting defaults and permissions, and moderate comments. For more information, see the online handbook entry for <a href="@comment">Comment module</a>.','','7.12'),('3945','','default','Default and custom settings','','7.12'),('3946','','default','Each <a href=''@content-type''>content type</a> can have its own default comment settings configured as: <em>Open</em> to allow new comments, <em>Hidden</em> to hide existing comments and prevent new comments, or <em>Closed</em> to view existing comments, but prevent new comments. These defaults will apply to all new content created (changes to the settings on existing content must be done manually). Other comment settings can also be customized per content type, and can be overridden for any given item of content. When a comment has no replies, it remains editable by its author, as long as the author has a user account and is logged in.','','7.12');
INSERT INTO `locales_source` VALUES ('3947','','default','Full comment','','7.12'),('3948','','default','Unapproved comments (@count)','','7.12'),('3949','','default','Administer comments and comment settings','','7.12'),('3950','','default','Edit own comments','','7.12'),('3951','','default','Number of recent comments','','none'),('3952','','default','Threading','','7.12'),('3953','','default','Show comment replies in a threaded list.','','7.12'),('3954','','default','Default comment setting for new content','','7.12'),('3955','','default','Allow comment title','','7.12'),('3956','','default','Show reply form on the same page as comments','','7.12'),('3957','','default','Users with the "Post comments" permission can post comments.','','7.12'),('3958','','default','Users cannot post comments, but existing comments will be displayed.','','7.12'),('3959','','default','Comments are hidden from view.','','7.12'),('3960','','default','Users cannot post comments.','','7.12'),('3961','','default','Your comment has been queued for review by site administrators and will be published after approval.','','none'),('3962','','default','Your comment has been posted.','','7.12'),('3963','','default','<a href="@login">Log in</a> or <a href="@register">register</a> to post comments','','7.12'),('3964','','default','<a href="@login">Log in</a> to post comments','','7.12'),('3965','','default','Flat list','','none'),('3966','','default','Threaded list','','none'),('3967','','default','Save comment','','7.12'),('3968','','default','The comment will be unpublished if it contains any of the phrases above. Use a case-sensitive, comma-separated list of phrases. Example: funny, bungee jumping, "Company, Inc."','','none'),('3969','','default','Published comment %subject.','','none'),('3970','','default','Saved comment %title','','none'),('3971','','default','List and edit site comments and the comment approval queue.','','7.12'),('3972','','default','Unapproved comments','','none'),('3973','','default','Example: ''webmaster@example.com'' or ''sales@example.com,support@example.com'' . To specify multiple recipients, separate each e-mail address with a comma.','','7.12');
INSERT INTO `locales_source` VALUES ('3974','','default','Category %category has been saved.','','7.12'),('3975','','default','You cannot send more than %limit messages in @interval. Try again later.','','none'),('3976','','default','Contact @username','','7.12'),('3977','','default','%sender-name (@sender-from) sent an e-mail regarding %category.','','none'),('3978','','default','%sender-name (@sender-from) sent %recipient-name an e-mail.','','none'),('3979','','default','The Contact module allows visitors to contact site administrators and other users. Users specify a subject, write their message, and can have a copy of their message sent to their own e-mail address. For more information, see the online handbook entry for <a href="@contact">Contact module</a>.','','7.12'),('3980','','default','User contact forms','','7.12'),('3981','','default','Site users can be contacted with a user contact form that keeps their e-mail address private. Users may enable or disable their personal contact forms by editing their <em>My account</em> page. If enabled, a <em>Contact</em> tab leads to a personal contact form displayed on their user profile. Site administrators are still able to use the contact form, even if has been disabled. The <em>Contact</em> tab is not shown when you view your own profile.','','7.12'),('3982','','default','Site-wide contact forms','','7.12'),('3983','','default','The <a href="@contact">Contact page</a> provides a simple form for users with the <em>Use the site-wide contact form</em> permission to send comments, feedback, or other requests. You can create categories for directing the contact form messages to a set of defined recipients. Common categories for a business site, for example, might include "Website feedback" (messages are forwarded to website administrators) and "Product information" (messages are forwarded to members of the sales department). E-mail addresses defined within a category are not displayed publicly.','','7.12'),('3984','','default','When the site-wide contact form is enabled, a link in the main <em>Navigation</em> menu is created, but the link is disabled by default. This menu link can be enabled on the <a href=''@menu''>Menus administration page</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('3985','','default','Customization','','7.12'),('3986','','default','If you would like additional text to appear on the site-wide or personal contact page, use a block. You can create and edit blocks on the <a href="@blocks">Blocks administration page</a>.','','7.12'),('3987','','default','Add one or more categories on this page to set up your site-wide <a href="@form">contact form</a>.','','7.12'),('3988','','default','A <em>Contact</em> menu item (disabled by default) is added to the Navigation menu, which you can modify on the <a href="@menu-settings">Menus administration page</a>.','','7.12'),('3989','','default','If you would like additional text to appear on the site-wide contact page, use a block. You can create and edit blocks on the <a href="@blocks">Blocks administration page</a>.','','7.12'),('3990','','default','Administer contact forms and contact form settings','','7.12'),('3991','','default','Use the site-wide contact form','','7.12'),('3992','','default','Use users'' personal contact forms','','7.12'),('3993','','default','!sender-name (!sender-url) sent a message using the contact form at !form-url.','','7.12'),('3994','','default','[!site-name] !subject','','7.12'),('3995','','default','!sender-name (!sender-url) has sent you a message via your contact form (!form-url) at !site-name.','','7.12'),('3996','','default','If you don''t want to receive such e-mails, you can change your settings at !recipient-edit-url.','','7.12'),('3997','','default','Allow other users to contact you via a <a href="@url">personal contact form</a> which keeps your e-mail address hidden. Note that some privileged users such as site administrators are still able to contact you even if you choose to disable this feature.','','7.12'),('3998','','default','Enable the personal contact form by default for new users.','','7.12'),('3999','','default','Changing this setting will not affect existing users.','','7.12'),('4000','','default','The Contextual links module displays links related to regions of pages on your site to users with <em>access contextual links</em> permission. For more information, see the online handbook entry for <a href="@contextual">Contextual links module</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('4001','','default','Displaying contextual links','','7.12'),('4002','','default','Contextual links are supplied by modules, to give you quick access to tasks associated with regions of pages on your site. For instance, if you have a custom menu block displayed in a sidebar of your site, the Blocks and Menus modules will supply links to configure the block and edit the menu. The Contextual links module collects these links into a list for display by your theme, and also adds JavaScript code to the page to hide the links initially, and display them when your mouse hovers over the block.','','7.12'),('4003','','default','Use contextual links','','7.12'),('4004','','default','Use contextual links to perform actions related to elements on a page.','','7.12'),('4005','','default','Contextual links','','7.10'),('4006','','default','Provides contextual links to perform actions related to elements on a page.','','7.12'),('4007','','default','Tracking user activity','','7.12'),('4008','','default','By enabling blocks such as <em>Who''s online</em> and <em>Who''s new</em>, site users can track who is logged in and new user signups at a centralized location.','','7.12'),('4009','','default','Tracking content activity','','7.12'),('4010','','default','By enabling blocks such as <em>Recent blog posts</em>, <em>New forum topics</em> and <em>Recent comments</em>, site users can view newly added site content at a glance.','','7.12'),('4011','','default','View the administrative dashboard','','7.12'),('4012','','default','This dashboard region is empty. Click <em>Customize dashboard</em> to add blocks to it.','','7.12'),('4013','','default','DRAG HERE','','7.12'),('4014','','default','Provides a dashboard page in the administrative interface for organizing administrative tasks and tracking information within your site.','','7.12'),('4015','; modules/dashboard/dashboard.js','default','Customize dashboard','','7.12'),('4016','','default','Clear log messages','','7.12'),('4017','','default','This will permanently remove the log messages from the database.','','7.12');
INSERT INTO `locales_source` VALUES ('4018','','default','Database log cleared.','','none'),('4019','','default','The Database logging module logs system events in the Drupal database. For more information, see the online handbook entry for the <a href="@dblog">Database logging module</a>.','','7.12'),('4020','','default','Monitoring your site','','7.12'),('4021','','default','Debugging site problems','','7.12'),('4022','','default','Field validation errors','','none'),('4023','','default','Attempt to create a field with a name longer than 32 characters: %name','','none'),('4024','','default','Attempt to create field name %name which already exists and is active.','','none'),('4025','','default','Attempt to create field name %name which already exists, although it is inactive.','','none'),('4026','','default','Attempt to create field name %name which is reserved by entity type %type.','','none'),('4027','','default','Attempt to create a field of unknown type %type.','','none'),('4028','','default','Attempt to create a field with unknown storage type %type.','','none'),('4029','','default','Attempt to create an instance of field @field_name without a bundle.','','none'),('4030','','default','Enabling field types','','7.12'),('4031','','default','The Field module provides the infrastructure for fields and field attachment; the field types and input widgets themselves are provided by additional modules. Some of the modules are required; the optional modules can be enabled from the <a href="@modules">Modules administration page</a>. Drupal core includes the following field type modules: Number (required), Text (required), List (required), Taxonomy (optional), Image (optional), and File (optional); the required Options module provides input widgets for other field modules. Additional fields and widgets may be provided by contributed modules, which you can find in the <a href="@contrib">contributed module section of Drupal.org</a>. Currently enabled field and input widget modules:','','7.12'),('4032','','default','Managing field data storage','','7.12');
INSERT INTO `locales_source` VALUES ('4033','','default','Developers of field modules can either use the default <a href="@sql-store">Field SQL storage module</a> to store data for their fields, or a contributed or custom module developed using the <a href="@storage-api">field storage API</a>.','','7.12'),('4034','','default','The Field SQL storage module stores field data in the database. It is the default field storage module; other field storage mechanisms may be available as contributed modules. See the <a href="@field-help">Field module help page</a> for more information about fields.','','7.12'),('4035','','default','Default SQL storage','','7.12'),('4036','','default','Stores fields in the local SQL database, using per-field tables.','','7.12'),('4037','','default','Field SQL storage','','none'),('4038','','default','Stores field data in an SQL database.','','7.12'),('4039','','default','The List module defines various fields for storing a list of items, for use with the Field module. Usually these items are entered through a select list, checkboxes, or radio buttons. See the <a href="@field-help">Field module help page</a> for more information about fields.','','7.12'),('4040','','default','This field stores simple on/off or yes/no options.','','7.12'),('4041','','default','List (text)','','7.12'),('4042','','default','Allowed HTML tags in labels: @tags','','7.12'),('4043','','default','The value of this field is being determined by the %function function and may not be changed.','','7.12'),('4044','','default','Allowed values list: each key must be a valid integer or decimal.','','none'),('4045','','default','Allowed values list: each key must be a string at most 255 characters long.','','none'),('4046','','default','Allowed values list: keys must be integers.','','none'),('4047','','default','Defines list field types. Use with Options to create selection lists.','','7.12'),('4048','','default','This field stores a number in the database as an integer.','','7.12'),('4049','','default','This field stores a number in the database in a fixed decimal format.','','7.12');
INSERT INTO `locales_source` VALUES ('4050','','default','This field stores a number in the database in a floating point format.','','7.12'),('4051','','default','The minimum value that should be allowed in this field. Leave blank for no minimum.','','none'),('4052','','default','The maximum value that should be allowed in this field. Leave blank for no maximum.','','none'),('4053','','default','Define a string that should be prefixed to the value, like ''$ '' or ''&euro; ''. Leave blank for none. Separate singular and plural values with a pipe (''pound|pounds'').','','none'),('4054','','default','Only numbers and the decimal separator (@separator) allowed in %field.','','none'),('4055','','default','The Options module defines checkbox, selection, and other input widgets for the Field module. See the <a href="@field-help">Field module help page</a> for more information about fields.','','7.12'),('4056','','default','This field stores varchar text in the database.','','7.12'),('4057','','default','Long text','','7.12'),('4058','','default','This field stores long text in the database.','','7.12'),('4059','','default','Long text and summary','','7.12'),('4060','','default','This field stores long text in the database along with optional summary text.','','7.12'),('4061','','default','Filtered text (user selects text format)','','7.12'),('4062','','default','Summary input','','7.12'),('4063','','default','This allows authors to input an explicit summary, to be displayed instead of the automatically trimmed text when using the "Summary or trimmed" display type.','','7.12'),('4064','','default','%name: the text may not be longer than %max characters.','','none'),('4065','','default','%name: the summary may not be longer than %max characters.','','none'),('4066','','default','Summary or trimmed','','7.12'),('4067','','default','Text area with a summary','','7.12'),('4068','','default','Leave blank to use trimmed value of full text as the summary.','','7.12'),('4069','; modules/field/modules/text/text.js','default','Hide summary','','none'),('4070','; modules/field/modules/text/text.js','default','Edit summary','','none');
INSERT INTO `locales_source` VALUES ('4071','','default','%field (@field_name) field requires the %widget_type widget provided by %widget_module module','','none'),('4072','','default','Inactive fields are not shown unless their providing modules are enabled. The following fields are not enabled: !list','','none'),('4073','','default','Edit field settings.','','7.12'),('4074','','default','Change widget type.','','7.12'),('4075','','default','Edit instance settings.','','7.12'),('4076','','default','Delete instance.','','7.12'),('4077','','default','The field %label cannot be added because it is locked.','','none'),('4078','','default','There was a problem creating field instance %label: @message.','','none'),('4079','','default','There are no fields yet added. You can add new fields on the <a href="@link">Manage fields</a> page.','','none'),('4080','','default','These settings apply to the %field field everywhere it is used. These settings impact the way that data is stored in the database and cannot be changed once data has been created.','','7.12'),('4081','','default','%field has no field settings.','','7.12'),('4082','','default','Updated field %label field settings.','','7.12'),('4083','','default','Attempt to update field %label failed: %message.','','none'),('4084','','default','Change widget','','7.12'),('4085','','default','The type of form element you would like to present to the user when creating this field in the %type type.','','7.12'),('4086','','default','Changed the widget for field %label.','','7.10'),('4087','','default','There was a problem changing the widget for field %label.','','none'),('4088','','default','This field is <strong>locked</strong> and cannot be deleted.','','none'),('4089','','default','The field %field has been deleted from the %type content type.','','7.12'),('4090','','default','There was a problem removing the %field from the %type content type.','','none'),('4091','','default','These settings apply only to the %field field when used in the %type type.','','7.12'),('4092','','default','Required field','','7.12'),('4093','','default','These settings apply to the %field field everywhere it is used. Because the field already has data, some settings can no longer be changed.','','7.12');
INSERT INTO `locales_source` VALUES ('4094','','default','These settings apply to the %field field everywhere it is used.','','7.12'),('4095','','default','%field field settings','','7.12'),('4096','','default','The default value for this field, used when creating new content.','','7.12'),('4097','','default','Saved %label configuration.','','7.12'),('4098','','default','This list shows all fields currently in use for easy reference.','','none'),('4099','','default','Save and add fields','','7.12'),('4100','','default','Field list','','7.12'),('4101','','default','Manage display','','7.12'),('4102','','default','Field UI','','none'),('4103','','default','This field stores the ID of a file as an integer value.','','7.12'),('4104','','default','Enable <em>Display</em> field','','7.12'),('4105','','default','The display option allows users to choose if a file should be shown when viewing the content.','','7.12'),('4106','','default','Files displayed by default','','7.12'),('4107','','default','This setting only has an effect if the display option is enabled.','','7.12'),('4108','','default','Upload destination','','7.12'),('4109','','default','Select where the final files should be stored. Private file storage has significantly more overhead than public files, but allows restricted access to files within this field.','','7.12'),('4110','','default','Optional subdirectory within the upload destination where files will be stored. Do not include preceding or trailing slashes.','','7.12'),('4111','','default','Enter a value like "512" (bytes), "80 KB" (kilobytes) or "50 MB" (megabytes) in order to restrict the allowed file size. If left empty the file sizes will be limited only by PHP''s maximum post and file upload sizes (current limit <strong>%limit</strong>).','','7.12'),('4112','','default','Enable <em>Description</em> field','','7.12'),('4113','','default','The description field allows users to enter a description about the uploaded file.','','7.12'),('4114','','default','The "!name" option must contain a valid value. You may either leave the text field empty or enter a string like "512" (bytes), "80 KB" (kilobytes) or "50 MB" (megabytes).','','none');
INSERT INTO `locales_source` VALUES ('4115','','default','The list of allowed extensions is not valid, be sure to exclude leading dots and to separate extensions with a comma or space.','','none'),('4116','','default','Generic file','','7.12'),('4117','','default','Table of files','','7.12'),('4118','','default','Add a new file','','7.12'),('4119','','default','Include file in display','','none'),('4120','','default','The description may be used as the label of the link to the file.','','7.12'),('4121','','default','Files must be less than !size.','','7.12'),('4122','','default','Allowed file types: !extensions.','','7.12'),('4123','','default','Images must be exactly !size pixels.','','none'),('4124','','default','Images must be between !min and !max pixels.','','none'),('4125','','default','Images must be larger than !min pixels.','','none'),('4126','','default','Images must be smaller than !max pixels.','','none'),('4127','','default','The File module defines a <em>File</em> field type for the Field module, which lets you manage and validate uploaded files attached to content on your site (see the <a href="@field-help">Field module help page</a> for more information about fields). For more information, see the online handbook entry for <a href="@file">File module</a>.','','7.12'),('4128','','default','Attaching files to content','','7.12'),('4129','','default','Managing attachment display','','7.12'),('4130','','default','When you attach a file to content, you can specify whether it is <em>listed</em> or not. Listed files are displayed automatically in a section at the bottom of your content; non-listed files are available for embedding in your content, but are not included in the list at the bottom.','','7.12'),('4131','','default','Managing file locations','','7.12'),('4132','','default','An unrecoverable error occurred. Use of this form has expired. Try reloading the page and submitting again.','','none'),('4133','','default','The file referenced by the !name field does not exist.','','none'),('4134','','default','The file in the !name field was unable to be uploaded.','','none');
INSERT INTO `locales_source` VALUES ('4135','','default','The upload directory %directory for the file field !name could not be created or is not accessible. A newly uploaded file could not be saved in this directory as a consequence, and the upload was canceled.','','none'),('4136','','default','Your server is not capable of displaying file upload progress. File upload progress requires an Apache server running PHP with mod_php.','','none'),('4137','','default','All roles may use this format','','7.10'),('4138','','default','The text format ordering has been saved.','','none'),('4139','','default','Add text format','','7.12'),('4140','','default','All roles for this text format must be enabled and cannot be changed.','','none'),('4141','','default','Filter processing order','','7.10'),('4142','','default','Text format names must be unique. A format named %name already exists.','','none'),('4143','','default','Added text format %format.','','none'),('4144','','default','The text format %format has been updated.','','7.10'),('4145','','default','Text formats','','7.12'),('4146','','default','The Filter module allows administrators to configure text formats. A text format defines the HTML tags, codes, and other input allowed in content and comments, and is a key feature in guarding against potentially damaging input from malicious users. For more information, see the online handbook entry for <a href="@filter">Filter module</a>.','','7.12'),('4147','','default','Applying filters to text','','7.12'),('4148','','default','Defining text formats','','7.12'),('4149','','default','One format is included by default: <em>Plain text</em> (which removes all HTML tags). Additional formats may be created by your installation profile when you install Drupal, and more can be created by an administrator on the <a href="@text-formats">Text formats page</a>.','','7.12'),('4150','','default','Choosing a text format','','7.12'),('4151','','default','A text format contains filters that change the user input, for example stripping out malicious HTML or making URLs clickable. Filters are executed from top to bottom and the order is important, since one filter may prevent another filter from doing its job. For example, when URLs are converted into links before disallowed HTML tags are removed, all links may be removed. When this happens, the order of filters may need to be re-arranged.','','7.10');
INSERT INTO `locales_source` VALUES ('4152','','default','Warning: This permission may have security implications depending on how the text format is configured.','','7.12'),('4153','','default','Use the !text_format text format','','7.12'),('4154','','default','More information about text formats','','7.12'),('4155','','default','Limit allowed HTML tags','','7.12'),('4156','','default','Convert line breaks into HTML (i.e. <code>&lt;br&gt;</code> and <code>&lt;p&gt;</code>)','','7.12'),('4157','','default','Convert URLs into links','','7.12'),('4158','','default','Correct faulty and chopped off HTML','','7.12'),('4159','','default','Display any HTML as plain text','','7.12'),('4160','','default','A list of HTML tags that can be used. JavaScript event attributes, JavaScript URLs, and CSS are always stripped.','','7.10'),('4161','','default','Display basic HTML help in long filter tips','','7.10'),('4162','','default','Add rel="nofollow" to all links','','7.10'),('4163','','default','This site allows HTML content. While learning all of HTML may feel intimidating, learning how to use a very small number of the most basic HTML "tags" is very easy. This table provides examples for each tag that is enabled on this site.','','7.12'),('4164','','default','For more information see W3C''s <a href="@html-specifications">HTML Specifications</a> or use your favorite search engine to find other sites that explain HTML.','','7.12'),('4165','','default','Most unusual characters can be directly entered without any problems.','','7.12'),('4166','','default','No HTML tags allowed.','','7.12'),('4167','','default','Filters content in preparation for display.','','7.12'),('4168','','default','By !author @time ago','','none'),('4169','','default','The forum %term and all sub-forums have been deleted.','','none'),('4170','','default','The number of replies a topic must have to be considered "hot".','','7.10'),('4171','','default','No containers or forums available. <a href="@container">Add container</a> or <a href="@forum">Add forum</a>.','','7.10'),('4172','','default','forum: deleted %term and all its sub-forums.','','none');
INSERT INTO `locales_source` VALUES ('4173','','default','The Forum module lets you create threaded discussion forums with functionality similar to other message board systems. Forums are useful because they allow community members to discuss topics with one another while ensuring those conversations are archived for later reference. In a forum, users post topics and threads in nested hierarchies, allowing discussions to be categorized and grouped. The forum hierarchy consists of:','','7.10'),('4174','','default','Optional containers (for example, <em>Support</em>), which can hold:','','7.10'),('4175','','default','Forums (for example, <em>Installing Drupal</em>), which can hold:','','7.10'),('4176','','default','Forum topics submitted by users (for example, <em>How to start a Drupal 6 Multisite</em>), which start discussions and are starting points for:','','7.10'),('4177','','default','Threaded comments submitted by users (for example, <em>You have these options...</em>).','','7.10'),('4178','','default','Setting up forum structure','','7.10'),('4179','','default','Visit the <a href="@forums">Forums page</a> to set up containers and forums to hold your discussion topics.','','7.10'),('4180','','default','Starting a discussion','','7.10'),('4181','','default','The <a href="@create-topic">Forum topic</a> link on the <a href="@content-add">Add new content</a> page creates the first post of a new threaded discussion, or thread.','','7.10'),('4182','','default','Enabling the Forum module provides a default <em>Forums</em> menu item in the navigation menu that links to the <a href="@forums">Forums page</a>.','','7.10'),('4183','','default','Moving forum topics','','7.10'),('4184','','default','A forum topic (and all of its comments) may be moved between forums by selecting a different forum while editing a forum topic. When moving a forum topic between forums, the <em>Leave shadow copy</em> option creates a link in the original forum pointing to the new location.','','7.10'),('4185','','default','Locking and disabling comments','','7.10'),('4186','','default','Selecting <em>Closed</em> under <em>Comment settings</em> while editing a forum topic will lock (prevent new comments on) the thread. Selecting <em>Hidden</em> under <em>Comment settings</em> while editing a forum topic will hide all existing comments on the thread, and prevent new ones.','','7.10');
INSERT INTO `locales_source` VALUES ('4187','','default','Forums contain forum topics. Use containers to group related forums.','','7.10'),('4188','','default','Use containers to group related forums.','','none'),('4189','','default','A forum holds related forum topics.','','none'),('4190','','default','Adjust the display of your forum topics. Organize the forums on the <a href="@forum-structure">forum structure page</a>.','','7.10'),('4191','','default','Add new @node_type','','7.10'),('4192','','default','<a href="@login">Log in</a> to post new content in the forum.','','7.10'),('4193','','default','The item %forum is a forum container, not a forum. Select one of the forums below instead.','','none'),('4194','','default','A <em>forum topic</em> starts a new discussion thread within a forum.','','7.10'),('4195','','default','Control forum hierarchy settings.','','7.10'),('4196','','default','Forum navigation vocabulary','','7.10'),('4197','','default','Provides discussion forums.','','7.12'),('4198','','default','Follow these steps to set up and start using your website:','','7.12'),('4199','','default','<strong>Start posting content</strong> Finally, you can <a href="@content">add new content</a> for your website.','','7.12'),('4200','','default','For more information, refer to the specific topics listed in the next section or to the <a href="@handbook">online Drupal handbooks</a>. You may also post at the <a href="@forum">Drupal forum</a> or view the wide range of <a href="@support">other support options</a> available.','','7.12'),('4201','','default','Providing a help reference','','7.12'),('4202','','default','The Help module displays explanations for using each module listed on the main <a href="@help">Help reference page</a>.','','7.12'),('4203','','default','Providing context-sensitive help','','7.12'),('4204','','default','The Help module displays context-sensitive advice and explanations on various pages.','','7.12'),('4205','','default','Edit %name style','','7.10'),('4206','','default','This image style is currently being provided by a module. Click the "Override defaults" button to change its settings.','','none');
INSERT INTO `locales_source` VALUES ('4207','','default','Image style name','','7.10'),('4208','','default','This image style is being provided by %module module and may not be renamed.','','none'),('4209','','default','The name is used in URLs for generated images. Use only lowercase alphanumeric characters, underscores (_), and hyphens (-).','','7.10'),('4210','','default','Select a new effect','','7.10'),('4211','','default','Override defaults','','7.10'),('4212','','default','Update style','','7.10'),('4213','','default','Select an effect to add.','','none'),('4214','','default','The image effect was successfully applied.','','7.10'),('4215','','default','The %style style has been overridden, allowing you to change its settings.','','none'),('4216','','default','Style name','','7.12'),('4217','','default','Create new style','','7.10'),('4218','','default','Style %name was created.','','7.10'),('4219','','default','The image style name %name is already in use.','','none'),('4220','','default','Please only use lowercase alphanumeric characters, underscores (_), and hyphens (-) for style names.','','none'),('4221','','default','No replacement, just delete','','none'),('4222','','default','Replacement style','','none'),('4223','','default','Optionally select a style before deleting %style','','none'),('4224','','default','If this style is in use on the site, you may select another style to replace it. All images that have been generated for this style will be permanently deleted.','','none'),('4225','','default','Style %name was deleted.','','none'),('4226','','default','Revert the %style style?','','none'),('4227','','default','Reverting this style will delete the customized settings and restore the defaults provided by the @module module.','','none'),('4228','','default','The %style style has been revert to its defaults.','','none'),('4229','','default','Edit %label effect','','7.10'),('4230','','default','Add %label effect','','7.10'),('4231','','default','Update effect','','7.10'),('4232','','default','Add effect','','7.10'),('4233','','default','Are you sure you want to delete the @effect effect from the %style style?','','none');
INSERT INTO `locales_source` VALUES ('4234','','default','The image effect %name has been deleted.','','none'),('4235','','default','!name must be an integer.','','none'),('4236','','default','!name must be a positive integer.','','none'),('4237','','default','!name must be a hexadecimal color value.','','none'),('4238','','default','Width and height can not both be blank.','','none'),('4239','','default','The part of the image that will be retained during the crop.','','7.10'),('4240','','default','The background color to use for exposed areas of the image. Use web-style hex colors (#FFFFFF for white, #000000 for black). Leave blank for transparency on image types that support it.','','none'),('4241','','default','There are currently no styles. <a href="!url">Add a new one</a>.','','none'),('4242','','default','There are currently no effects in this style. Add one by selecting an option below.','','7.10'),('4243','','default','view actual size','','7.10'),('4244','','default','Sample original image','','7.10'),('4245','','default','Sample modified image','','7.10'),('4246','','default','Resizing will make images an exact set of dimensions. This may cause images to be stretched or shrunk disproportionately.','','7.12'),('4247','','default','Scaling will maintain the aspect-ratio of the original image. If only a single dimension is specified, the other dimension will be calculated.','','7.12'),('4248','','default','Scale and crop','','7.12'),('4249','','default','Scale and crop will maintain the aspect-ratio of the original image, then crop the larger dimension. This is most useful for creating perfectly square thumbnails without stretching the image.','','7.12'),('4250','','default','Cropping will remove portions of an image to make it the specified dimensions.','','7.12'),('4251','','default','Desaturate','','7.12'),('4252','','default','Desaturate converts an image to grayscale.','','7.12'),('4253','','default','Rotating an image may cause the dimensions of an image to increase to fit the diagonal.','','7.12'),('4254','','default','Image resize failed using the %toolkit toolkit on %path (%mimetype, %dimensions)','','none');
INSERT INTO `locales_source` VALUES ('4255','','default','Image scale failed using the %toolkit toolkit on %path (%mimetype, %dimensions)','','none'),('4256','','default','Image crop failed using the %toolkit toolkit on %path (%mimetype, %dimensions)','','none'),('4257','','default','Image scale and crop failed using the %toolkit toolkit on %path (%mimetype, %dimensions)','','none'),('4258','','default','Image desaturate failed using the %toolkit toolkit on %path (%mimetype, %dimensions)','','none'),('4259','','default','Image rotate failed using the %toolkit toolkit on %path (%mimetype, %dimensions)','','none'),('4260','','default','This field stores the ID of an image file as an integer value.','','7.12'),('4261','','default','If no image is uploaded, this image will be shown on display.','','7.12'),('4262','','default','The maximum allowed image size expressed as WIDTHxHEIGHT (e.g. 640x480). Leave blank for no restriction. If a larger image is uploaded, it will be resized to reflect the given width and height. Resizing images on upload will cause the loss of <a href="http://en.wikipedia.org/wiki/Exchangeable_image_file_format">EXIF data</a> in the image.','','7.12'),('4263','','default','Minimum image resolution','','7.12'),('4264','','default','The minimum allowed image size expressed as WIDTHxHEIGHT (e.g. 640x480). Leave blank for no restriction. If a smaller image is uploaded, it will be rejected.','','7.12'),('4265','','default','Enable <em>Alt</em> field','','7.12'),('4266','','default','The alt attribute may be used by search engines, screen readers, and when the image cannot be loaded.','','7.12'),('4267','','default','Enable <em>Title</em> field','','7.12'),('4268','','default','The title attribute is used as a tooltip when the mouse hovers over the image.','','7.12'),('4269','','default','Height and width values must be numeric.','','none'),('4270','','default','Both a height and width value must be specified in the !name field.','','none'),('4271','','default','Preview image style','','7.12'),('4272','','default','no preview','','7.12'),('4273','','default','The preview image will be shown while editing the content.','','7.12');
INSERT INTO `locales_source` VALUES ('4274','','default','Manipulating images','','7.12'),('4275','','default','Based on where it will be used: eg. <em>profile-picture</em>','','7.12'),('4276','','default','Describing its appearance: eg. <em>square-85x85</em>','','7.12'),('4277','','default','Attaching images to content as fields','','7.12'),('4278','','default','Administer image styles','','7.12'),('4279','','default','Create and modify styles for generating image modifications such as thumbnails.','','7.12'),('4280','','default','No defined styles','','none'),('4281','','default','Image generation in progress. Try again shortly.','','none'),('4282','','default','Error generating image.','','7.12'),('4283','','default','Unable to generate the derived image located at %path.','','7.12'),('4284','','default','Failed to create style directory: %directory','','none'),('4285','','default','Generate image style','','7.12'),('4286','','default','Image styles','','7.12'),('4287','','default','Configure styles that can be used for resizing or adjusting images on display.','','7.12'),('4288','','default','List the current image styles on the site.','','7.12'),('4289','','default','Add style','','7.12'),('4290','','default','Add a new image style.','','7.12'),('4291','','default','Configure an image style.','','7.10'),('4292','','default','Delete an image style.','','none'),('4293','','default','Revert style','','none'),('4294','','default','Revert an image style.','','none'),('4295','','default','Edit image effect','','7.10'),('4296','','default','Delete image effect','','none'),('4297','','default','Add image effect','','7.10'),('4298','','default','Add a new effect to a style.','','7.10'),('4299','','default','Provides image manipulation tools.','','7.12'),('4300','','default','Use the <em>Custom language</em> section below if your desired language does not appear in this list.','','none'),('4301','','default','Path prefix language code','','7.12'),('4302','','default','Detection method','','7.10'),('4303','','default','Part of the URL that determines language','','none');
INSERT INTO `locales_source` VALUES ('4304','','default','<em>Path prefix</em>: URLs like http://example.com/de/contact set language to German (de). <em>Domain</em>: URLs like http://de.example.com/contact set the language to German. <strong>Warning: Changing this setting may break incoming URLs. Use with caution on a production site.</strong>','','none'),('4305','','default','Request/session parameter','','none'),('4306','','default','Name of the request/session parameter used to determine the desired language.','','none'),('4307','','default','Filter translatable strings','','none'),('4308','','default','Date type','','7.10'),('4309','','default','Are you sure you want to reset the date formats for %language to the global defaults?','','none'),('4310','','default','Resetting will remove all localized date formats for this language. This action cannot be undone.','','none'),('4311','','default','The Locale module allows your Drupal site to be presented in languages other than the default English, and to be multilingual. The Locale module works by maintaining a database of translations, and examining text as it is about to be displayed. When a translation of the text is available in the language to be displayed, the translation is displayed rather than the original text. When a translation is unavailable, the original text is displayed, and then stored for review by a translator. For more information, see the online handbook entry for <a href="@locale">Locale module</a>.','','7.12'),('4312','','default','Translating interface text','','7.12'),('4313','','default','Translations of text in the Drupal interface may be provided by:','','7.12'),('4314','','default','Translating within your site, using the Locale module''s integrated <a href=''@translate''>translation interface</a>.','','7.12'),('4315','','default','Configuring a multilingual site','','7.12'),('4316','','default','Language negotiation allows your site to automatically change language based on the domain or path used for each request. Users may (optionally) select their preferred language on their <em>My account</em> page, and your site can be configured to honor a web browser''s preferred language settings. Site content can be translated using the <a href=''@content-help''>Content translation module</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('4317','','default','With multiple languages enabled, interface text can be translated, registered users may select their preferred language, and authors can assign a specific language to content. <a href="@translations">Download contributed translations</a> from Drupal.org.','','7.12'),('4318','','default','Add a language to be supported by your site. If your desired language is not available in the <em>Language name</em> drop-down, click <em>Custom language</em> and provide a language code and other details manually. When providing a language code manually, be sure to enter a standardized language code, since this code may be used by browsers to determine an appropriate display language.','','none'),('4319','','default','Determine the language from a request/session parameter. Example: "http://example.com?language=de" sets language to German based on the use of "de" within the "language" parameter.','','none'),('4320','','default','See the <a href="@languages">Languages page</a> for more information on adding support for additional languages.','','none'),('4321','','default','This page imports the translated strings contained in an individual Gettext Portable Object (<em>.po</em>) file. Normally distributed as part of a translation package (each translation package may contain several <em>.po</em> files), a <em>.po</em> file may need to be imported after offline editing in a Gettext translation editor. Importing an individual <em>.po</em> file may be a lengthy process.','','none'),('4322','','default','This page allows a translator to search for specific translated and untranslated strings, and is used when creating or editing translations. (Note: For translation tasks involving many strings, it may be more convenient to <a href="@export">export</a> strings for offline editing in a desktop Gettext translation editor.) Searches may be limited to strings found within a specific text group or in a specific language.','','none'),('4323','','default','Administer languages','','7.12'),('4324','','default','Translate interface texts','','7.12');
INSERT INTO `locales_source` VALUES ('4325','','default','Order of language detection methods for content. If a version of content is available in the detected language, it will be displayed.','','7.12'),('4326','','default','Order of language detection methods for user interface text. If a translation of user interface text is available in the detected language, it will be displayed.','','7.12'),('4327','','default','Determine the language from the URL (Path prefix or domain).','','7.12'),('4328','','default','Determine the language from a request/session parameter.','','7.12'),('4329','','default','Follow the user''s language preference.','','7.12'),('4330','','default','Determine the language from the browser''s language settings.','','7.12'),('4331','','default','Language switcher (@type)','','7.12'),('4332','','default','Detection and selection','','7.12'),('4333','','default','URL language detection configuration','','7.12'),('4334','','default','Session language detection configuration','','7.12'),('4335','','default','Localize','','7.12'),('4336','','default','Localize date formats','','none'),('4337','','default','Reset date formats','','none'),('4338','','default','Reset localized date formats to global defaults','','none'),('4339','','default','January','Long month name','7.12'),('4340','','default','February','Long month name','7.12'),('4341','','default','March','Long month name','7.12'),('4342','','default','April','Long month name','7.12'),('4343','','default','May','Long month name','7.12'),('4344','','default','June','Long month name','7.12'),('4345','','default','July','Long month name','7.12'),('4346','','default','August','Long month name','7.12'),('4347','','default','September','Long month name','7.12'),('4348','','default','October','Long month name','7.12'),('4349','','default','November','Long month name','7.12'),('4350','','default','December','Long month name','7.12'),('4351','','default','add link','','7.12'),('4352','','default','There are no menu links yet. <a href="@link">Add link</a>.','','none'),('4353','','default','The text to be used for this link in the menu.','','7.12');
INSERT INTO `locales_source` VALUES ('4354','','default','The path for this menu link. This can be an internal Drupal path such as %add-node or an external URL such as %drupal. Enter %front to link to the front page.','','7.12'),('4355','','default','Menu links that are not enabled will not be listed in any menu.','','7.12'),('4356','','default','Show as expanded','','7.12'),('4357','','default','If selected and this menu link has children, the menu will always appear expanded.','','7.12'),('4358','','default','Parent link','','7.12'),('4359','','default','The maximum depth for a link and all its children is fixed at !maxdepth. Some menu links may not be available as parents if selecting them would exceed this limit.','','7.12'),('4360','','default','Optional. In the menu, the heavier links will sink and the lighter links will be positioned nearer the top.','','7.12'),('4361','','default','Are you sure you want to delete the custom menu link %item?','','7.10'),('4362','','default','The menu link %title has been deleted.','','7.10'),('4363','','default','Are you sure you want to reset the link %item to its default values?','','7.10'),('4364','','default','The menu link was reset to its default settings.','','7.10'),('4365','','default','No Main links','','none'),('4366','','default','Source for the Main links','','none'),('4367','','default','Select what should be displayed as the Main links (typically at the top of the page).','','none'),('4368','','default','No Secondary links','','none'),('4369','','default','Source for the Secondary links','','none'),('4370','','default','Select the source for the Secondary links. An advanced option allows you to use the same source for both Main links (currently %main) and Secondary links: if your source menu has two levels of hierarchy, the top level menu links will appear in the Main links, and the children of the active link will appear in the Secondary links.','','none'),('4371','','default','Deleted custom menu %title and all its menu links.','','none'),('4372','','default','Deleted menu link %title.','','none'),('4373','','default','<strong>Warning:</strong> There is currently 1 menu link in %title. It will be deleted (system-defined items will be reset).','','none');
INSERT INTO `locales_source` VALUES ('4374','','default','<strong>Warning:</strong> There are currently @count menu links in %title. They will be deleted (system-defined links will be reset).','','none'),('4375','','default','Managing menus','','7.12'),('4376','','default','Displaying menus','','7.12'),('4377','','default','After you have created a menu, you must enable and position the associated block on the <a href="@blocks">Blocks administration page</a>.','','7.12'),('4378','','default','You can enable the newly-created block for this menu on the <a href="@blocks">Blocks administration page</a>.','','none'),('4379','','default','Each menu has a corresponding block that is managed on the <a href="@blocks">Blocks administration page</a>.','','7.12'),('4380','','default','Administer menus and menu items','','7.12'),('4381','','default','Provide a menu link','','7.12'),('4382','','default','Menu links with smaller weights are displayed before links with larger weights.','','7.12'),('4383','','default','Available menus','','7.12'),('4384','','default','The menus available to place links in for this content type.','','7.12'),('4385','','default','Default parent item','','7.12'),('4386','','default','Choose the menu item to be the default parent for a new link in the content authoring form.','','7.12'),('4387','','default','Add new menus to your site, edit existing menus, and rename and reorganize menu links.','','7.12'),('4388','','default','Parent menu items','','7.12'),('4389','','default','Edit menu link','','7.12'),('4390','','default','Reset menu link','','7.10'),('4391','','default','Delete menu link','','7.10'),('4392','','default','The <em>Navigation</em> menu contains links intended for site visitors. Links are added to the <em>Navigation</em> menu automatically by some modules.','','none'),('4393','','default','The <em>User</em> menu contains links related to the user''s account, as well as the ''Log out'' link.','','none'),('4394','','default','The <em>Management</em> menu contains links for administrative tasks.','','none'),('4395','','default','The <em>Main</em> menu is used on many sites to show the major sections of the site, often in a top navigation bar.','','none');
INSERT INTO `locales_source` VALUES ('4396','','default','manage display','','7.12'),('4397','','default','No content types available. <a href="@link">Add content type</a>.','','7.12'),('4398','','default','The human-readable name of this content type. This text will be displayed as part of the list on the <em>Add new content</em> page. It is recommended that this name begin with a capital letter and contain only letters, numbers, and spaces. This name must be unique.','','7.12'),('4399','','default','Describe this content type. The text will be displayed on the <em>Add new content</em> page.','','7.12'),('4400','','default','Preview before submitting','','7.12'),('4401','','default','This text will be displayed at the top of the page when creating or editing content of this type.','','7.12'),('4402','','default','Users with the <em>Administer content</em> permission will be able to override these options.','','7.12'),('4403','','default','Display author and date information.','','7.12'),('4404','','default','Author username and publish date will be displayed.','','7.12'),('4405','','default','Invalid machine-readable name. Enter a name other than %invalid.','','none'),('4406','','default','%type is used by 1 piece of content on your site. If you remove this content type, you will not be able to edit the %type content and it may not display correctly.','','7.12'),('4407','','default','%type is used by @count pieces of content on your site. If you remove %type, you will not be able to edit the %type content and it may not display correctly.','','7.12'),('4408','','default','Publish selected content','','7.12'),('4409','','default','Unpublish selected content','','7.12'),('4410','','default','Promote selected content to front page','','7.12'),('4411','','default','Demote selected content from front page','','7.12'),('4412','','default','Make selected content sticky','','7.12'),('4413','','default','Make selected content not sticky','','7.12'),('4414','','default','Delete selected content','','7.12'),('4415','','default','Deleted @count posts.','','7.12'),('4416','','default','Are you sure you want to delete this item?','','7.12');
INSERT INTO `locales_source` VALUES ('4417','','default','Are you sure you want to delete these items?','','7.12'),('4418','','default','<em>Edit @type</em> @title','','7.12'),('4419','','default','You have not created any content types yet. Go to the <a href="@create-content">content type creation page</a> to add a new content type.','','none'),('4420','','default','Revision log message','','7.12'),('4421','','default','Provide an explanation of the changes you are making. This will help other authors understand your motivations.','','7.12'),('4422','','default','Tokens related to individual content items, or "nodes".','','7.12'),('4423','','default','The unique ID of the content item, or "node".','','7.12'),('4424','','default','The main body text of the node.','','7.12'),('4425','','default','The summary of the node''s main body text.','','7.12'),('4426','','default','The content access permissions need to be rebuilt. <a href="@node_access_rebuild">Rebuild permissions</a>.','','none'),('4427','','default','The Node module manages the creation, editing, deletion, settings, and display of the main site content. Content items managed by the Node module are typically displayed as pages on your site, and include a title, some meta-data (author, creation time, content type, etc.), and optional fields containing text or other data (fields are managed by the <a href="@field">Field module</a>). For more information, see the online handbook entry for <a href="@node">Node module</a>.','','7.12'),('4428','','default','Creating content','','7.12'),('4429','','default','When new content is created, the Node module records basic information about the content, including the author, date of creation, and the <a href="@content-type">Content type</a>. It also manages the <em>publishing options</em>, which define whether or not the content is published, promoted to the front page of the site, and/or sticky at the top of content lists. Default settings can be configured for each <a href="@content-type">type of content</a> on your site.','','7.12'),('4430','','default','Creating custom content types','','7.12');
INSERT INTO `locales_source` VALUES ('4431','','default','Administering content','','7.12'),('4432','','default','The <a href="@content">Content administration page</a> allows you to review and bulk manage your site content.','','7.12'),('4433','','default','Creating revisions','','7.12'),('4434','','default','The Node module also enables you to create multiple versions of any content, and revert to older versions using the <em>Revision information</em> settings.','','7.12'),('4435','','default','User permissions','','7.12'),('4436','','default','The Node module makes a number of permissions available for each content type, which can be set by role on the <a href="@permissions">permissions page</a>.','','7.12'),('4437','','default','Individual content types can have different fields, behaviors, and permissions assigned to them.','','7.12'),('4438','','default','Content items can be displayed using different view modes: Teaser, Full content, Print, RSS, etc. <em>Teaser</em> is a short format that is typically used in lists of multiple content items. <em>Full content</em> is typically used when the content is displayed on its own page.','','7.12'),('4439','','default','Here, you can define which fields are shown and hidden when %type content is displayed in each view mode, and define how the fields are displayed in each view mode.','','7.12'),('4440','','default','Revisions allow you to track differences between multiple versions of your content, and revert back to older versions.','','7.12'),('4441','','default','Full content','','7.12'),('4442','','default','Search result','','7.12'),('4443','','default','The content on this page has either been modified by another user, or you have already submitted modifications using this form. As a result, your changes cannot be saved.','','none'),('4444','','default','Administer content types','','7.12'),('4445','','default','Warning: Give to trusted roles only; this permission has security implications.','','7.12'),('4446','','default','View published content','','7.12'),('4447','','default','Access the content overview page','','7.12');
INSERT INTO `locales_source` VALUES ('4448','','default','Bypass content access control','','7.12'),('4449','','default','View content revisions','','7.12'),('4450','','default','Revert content revisions','','7.12'),('4451','','default','Delete content revisions','','7.12'),('4452','','default','View own unpublished content','','7.12'),('4453','','default','Content is sticky at top of lists','','none'),('4454','','default','Content is promoted to the front page','','none'),('4455','','default','Recent content','','7.12'),('4456','','default','Number of recent content items to display','','none'),('4457','','default','Show block for specific content types','','7.12'),('4458','','default','Show this block only on pages that display content of the given type(s). If you select no types, there will be no type-specific limitation.','','7.12'),('4459','','default','Welcome to @site-name','','7.10'),('4460','','default','No front page content has been created yet.','','7.10'),('4461','','default','Unpublish content','','7.12'),('4462','','default','Make content sticky','','7.12'),('4463','','default','Make content unsticky','','7.12'),('4464','','default','Promote content to front page','','7.12'),('4465','','default','Remove content from front page','','7.12'),('4466','','default','Change the author of content','','7.12'),('4467','','default','Save content','','7.12'),('4468','','default','Unpublish content containing keyword(s)','','7.12'),('4469','','default','The content will be unpublished if it contains any of the phrases above. Use a case-sensitive, comma-separated list of phrases. Example: funny, bungee jumping, "Company, Inc."','','none'),('4470','','default','If the site is experiencing problems with permissions to content, you may have to rebuild the permissions cache. Rebuilding will remove all privileges to content and replace them with permissions based on the current modules and settings. Rebuilding may take some time if there is a lot of content or complex permission settings. After rebuilding has completed, content will automatically use the new permissions.','','7.12');
INSERT INTO `locales_source` VALUES ('4471','','default','Node Access Permissions','','7.12'),('4472','','default','One permission in use','','none'),('4473','','default','@count permissions in use','','none'),('4474','','default','Find and manage content.','','none'),('4475','','default','Manage content types, including default status, front page promotion, comment settings, etc.','','7.12'),('4476','','default','Edit content type','','none'),('4477','; modules/node/content_types.js','default','Don''t display post information','','none'),('4478','','default','This site supports <a href="@openid-net">OpenID</a>, a secure way to log in to many websites using a single username and password. OpenID can reduce the necessity of managing many usernames and passwords for many websites.','','none'),('4479','','default','If you already have an OpenID, enter the URL to your OpenID server below (e.g. myusername.openidprovider.com). Next time you log in, you will be able to use this URL instead of a regular username and password. You can have multiple OpenID servers if you like; just keep adding them here.','','none'),('4480','','default','The OpenID module allows users to log in using the OpenID single sign on service. <a href="@openid-net">OpenID</a> is a secure method for logging into many websites with a single username and password. It does not require special software, and it does not share passwords with any site to which it is associated, including the site being logged into. The main benefit to users is that they can have a single password that they can use on many websites. This means they can easily update their single password from a centralized location, rather than having to change dozens of passwords individually. For more information, see the online handbook entry for <a href="@handbook">OpenID module</a>.','','none'),('4481','','default','Logging in with OpenID','','none'),('4482','','default','To log in using OpenID, a user must already have an OpenID account. Users can then create site accounts using their OpenID, assign one or more OpenIDs to an existing account, and log in using an OpenID. This lowers the barrier to registration, which helps increase the user base, and offers convenience and security to the users. Because OpenID cannot guarantee a user is legitimate, email verification is still necessary. When logging in, users are presented with the option of entering their OpenID URL, which will look like <em>myusername.openidprovider.com</em>. The site then communicates with the OpenID server, asking it to verify the identity of the user. If the user is logged into their OpenID server, the server communicates back to your site, verifying the user. If they are not logged in, the OpenID server will ask the user for their password. At no point does the site being logged into record the user''s OpenID password.','','none');
INSERT INTO `locales_source` VALUES ('4483','','default','Once you have verified your e-mail address, you may log in via OpenID.','','none'),('4484','','default','Sorry, that is not a valid OpenID. Ensure you have spelled your ID correctly.','','none'),('4485','','default','Complete the registration by filling out the form below. If you already have an account, you can <a href="@login">log in</a> now and add your OpenID under "My account".','','none'),('4486','','default','Account registration using the information provided by your OpenID provider failed due to the reasons listed below. Complete the registration by filling out the form below. If you already have an account, you can <a href="@login">log in</a> now and add your OpenID under "My account".','','none'),('4487','','default','The Overlay module makes the administration pages on your site display in a JavaScript overlay of the page you were viewing when you clicked the administrative link, instead of replacing the page in your browser window. Use the close link on the overlay to return to the page you were viewing when you clicked the link. For more information, see the online handbook entry for <a href="@overlay">Overlay module</a>.','','7.12'),('4488','','default','Access the administrative overlay','','7.12'),('4489','','default','View administrative pages in the overlay.','','7.12'),('4490','','default','Displays the Drupal administration interface in an overlay.','','7.12'),('4491','','default','Specify the existing path you wish to alias. For example: node/28, forum/1, taxonomy/term/1.','','none'),('4492','','default','Creating aliases','','7.12'),('4493','','default','Users with sufficient <a href="@permissions">permissions</a> can create aliases under the <em>URL path settings</em> section when they create or edit content. Some examples of aliases are: ','','7.12'),('4494','','default','<em>member/jane-smith</em> aliased to internal path <em>user/123</em>','','7.12'),('4495','','default','<em>about-us/team</em> aliased to internal path <em>node/456</em>','','7.12'),('4496','','default','Managing aliases','','7.12');
INSERT INTO `locales_source` VALUES ('4497','','default','The Path module provides a way to search and view a <a href="@aliases">list of all aliases</a> that are in use on your website. Aliases can be added, edited and deleted through this list.','','7.12'),('4498','','default','An alias defines a different name for an existing URL path - for example, the alias ''about'' for the URL path ''node/1''. A URL path can have multiple aliases.','','7.12'),('4499','','default','Administer URL aliases','','7.12'),('4500','','default','Create and edit URL aliases','','7.12'),('4501','','default','The alias is already in use.','','none'),('4502','','default','Optionally specify an alternative URL by which this term can be accessed. Use a relative path and don''t add a trailing slash or the URL alias won''t work.','','7.12'),('4503','','default','Enabling execution of PHP in text fields','','none'),('4504','','default','Use PHP for settings','','none'),('4505','','default','The PHP module has been disabled. Any existing content that was using the PHP filter will now be visible in plain text. This might pose a security risk by exposing sensitive information, if any, used in the PHP code.','','none'),('4506','','default','The Poll module can be used to create simple surveys or questionnaires that display cumulative results. A poll is a good way to receive feedback from site users and community members. For more information, see the online handbook entry for the <a href="@poll">Poll module</a>.','','none'),('4507','','default','Creating a poll','','none'),('4508','','default','Users can create a poll by clicking on Poll on the <a href="@add-content">Add new content</a> page, and entering the question being posed, the answer choices, and beginning vote counts for each choice. The status (closed or active) and duration (length of time the poll remains active for new votes) can also be specified.','','none'),('4509','','default','Viewing polls','','none'),('4510','','default','You can visit the <a href="@poll">Polls</a> page to view all current polls, or alternately enable the <em>Most recent poll</em> block on the <a href="@blocks">Blocks administration page</a>. To vote in or view the results of a specific poll, you can click on the poll itself.','','none');
INSERT INTO `locales_source` VALUES ('4511','','default','Vote on polls','','none'),('4512','','default','Cancel and change own votes','','none'),('4513','','default','View voting results','','none'),('4514','','default','Your vote was cancelled.','','none'),('4515','','default','The Profile module allows site administrators to define custom fields (such as country, full name, or age) for user profiles, which are then displayed in the <a href="@user">My Account</a> section. This permits users of a site to share more information about themselves, and can help community-based sites organize users around specific information. For more information, see the online handbook entry for <a href="@profile">Profile module</a>.','','none'),('4516','','default','Adding fields to the default profile','','none'),('4517','','default','To provide the ability for users to enter more information about themselves, the Profile module allows additional fields to be added to the default user profile. Examples of common additions would be <em>Location</em>, <em>Company</em>, <em>Age</em>, or <em>About me</em>.','','none'),('4518','','default','User information pages','','none'),('4519','','default','Author information block','','none'),('4520','','default','The <em>Author information block</em> is a default block created by the Profile module that can be enabled on the <a href="@blocks">Blocks administration page</a>. It shows visitors of your website information about the author of the page they are reading.','','none'),('4521','','default','This page displays a list of the existing custom profile fields to be displayed on a user''s <em>My account</em> page. To provide structure, similar or related fields may be placed inside a category. To add a new category (or edit an existing one), edit a profile field and provide a new category name.','','none'),('4522','','default','Enriches your content with metadata to let other applications (e.g. search engines, aggregators) better understand its relationships and attributes.','','7.12'),('4523','','default','The active search modules have been changed.','','none');
INSERT INTO `locales_source` VALUES ('4524','','default','You must include at least one positive keyword with 1 character or more.','','none'),('4525','','default','You must include at least one positive keyword with @count characters or more.','','none'),('4526','','default','The Search module provides the ability to index and search for content by exact keywords, and for users by username or e-mail. For more information, see the online handbook entry for <a href="@search-module">Search module</a>.','','7.12'),('4527','','default','Searching content and users','','7.12'),('4528','','default','Indexing content with cron','','7.12'),('4529','','default','Configuring search settings','','7.12'),('4530','','default','The Search module includes a default <em>Search form</em> block, which can be enabled and configured on the <a href="@blocks">Blocks administration page</a>. The block is available to users with the <em>Search content</em> permission.','','7.12'),('4531','','default','Extending Search module','','7.12'),('4532','','default','<ul>\n<li>Check if your spelling is correct.</li>\n<li>Remove quotes around phrases to search for each word individually. <em>bike shed</em> will often show more results than <em>&quot;bike shed&quot;</em>.</li>\n<li>Consider loosening your query with <em>OR</em>. <em>bike OR shed</em> will often show more results than <em>bike shed</em>.</li>\n</ul>','','none'),('4533','','default','Administer search','','7.12'),('4534','','default','Use search','','7.12'),('4535','','default','Use advanced search','','7.12'),('4536','','default','Configure relevance settings for search and other indexing options.','','7.12'),('4537','','default','Choose a set of shortcuts to use','','7.12'),('4538','','default','Choose a set of shortcuts for this user','','none'),('4539','','default','You are now using the new %set_name shortcut set. You can edit it from this page or <a href="@switch-url">switch back to a different one.</a>','','none'),('4540','','default','%user is now using a new shortcut set called %set_name. You can edit it from this page.','','none');
INSERT INTO `locales_source` VALUES ('4541','','default','You are now using the %set_name shortcut set.','','none'),('4542','','default','%user is now using the %set_name shortcut set.','','none'),('4543','','default','Change set','','7.12'),('4544','','default','The shortcut set has been updated.','','none'),('4545','','default','Add new shortcut','','none'),('4546','','default','Editing @shortcut','','none'),('4547','','default','The name of the shortcut.','','none'),('4548','','default','The path to the shortcut.','','none'),('4549','','default','The link must correspond to a valid path on the site.','','none'),('4550','','default','The shortcut %link has been updated.','','none'),('4551','','default','Added a shortcut for %title.','','none'),('4552','','default','Are you sure you want to delete the shortcut %title?','','none'),('4553','','default','The shortcut %title has been deleted.','','none'),('4554','','default','Unable to add a shortcut for %title.','','none'),('4555','','default','Adding and removing shortcuts','','7.12'),('4556','','default','Displaying shortcuts','','7.12'),('4557','','default','Administer shortcuts','','7.12'),('4558','','default','@shortcut_set shortcuts','','none'),('4559','','default','Add to %shortcut_set shortcuts','','7.12'),('4560','','default','Add to shortcuts','','none'),('4561','','default','Remove from %shortcut_set shortcuts','','7.12'),('4562','','default','Remove from shortcuts','','none'),('4563','','default','Edit shortcuts','','7.12'),('4564','','default','Add shortcut','','none'),('4565','','default','Edit shortcut','','none'),('4566','','default','Delete shortcut','','none'),('4567','','default','Allows users to manage customizable lists of shortcut links.','','7.12'),('4568','','default','Value @value is TRUE.','','none'),('4569','','default','Value @value is FALSE.','','none'),('4570','','default','Value @value is NULL.','','none');
INSERT INTO `locales_source` VALUES ('4571','','default','Value @value is not NULL.','','none'),('4572','','default','Value @first is equal to value @second.','','none'),('4573','','default','Value @first is not equal to value @second.','','none'),('4574','','default','Value @first is identical to value @second.','','none'),('4575','','default','Value @first is not identical to value @second.','','none'),('4576','','default','The test did not complete due to a fatal error.','','none'),('4577','','default','Link with label %label found.','','none'),('4578','','default','Link with label %label not found.','','none'),('4579','','default','Link containing href %href found.','','none'),('4580','','default','No link containing href %href found.','','none'),('4581','','default','Clicked link %label (@url_target) from @url_before','','none'),('4582','','default','Option @option for field @id is selected.','','none'),('4583','','default','Option @option for field @id is not selected.','','none'),('4584','','default','By default SimpleTest will clear the results after they have been viewed on the results page, but in some cases it may be useful to leave the results in the database. The results can then be viewed at <em>admin/config/development/testing/[test_id]</em>. The test ID can be found in the database, simpletest table, or kept track of when viewing the results the first time. Additionally, some modules may provide more analysis or features that require this setting to be disabled.','','none'),('4585','','default','GSS negotiate','','none'),('4586','','default','NTLM','','none'),('4587','','default','The Testing module provides a framework for running automated unit tests. It can be used to verify a working state of Drupal before and after any code changes, or as a means for developers to write and execute tests for their modules. For more information, see the online handbook entry for <a href="@simpletest">Testing module</a>.','','none'),('4588','','default','Running tests','','none'),('4589','','default','Visit the <a href="@admin-simpletest">Testing page</a> to display a list of available tests. For comprehensive testing, select <em>all</em> tests, or individually select tests for more targeted testing. Note that it might take several minutes for all tests to complete. For more information on creating and modifying your own tests, see the <a href="@simpletest-api">Testing API Documentation</a> in the Drupal handbook.','','none');
INSERT INTO `locales_source` VALUES ('4590','','default','Administer tests','','none'),('4591','','default','The test run finished in @elapsed.','','none'),('4592','','default','Use the <em>Clean environment</em> button to clean-up temporary files and tables.','','none'),('4593','','default','The testing framework requires the PHP <a href="@open_basedir-url">open_basedir</a> restriction to be disabled. Check your webserver configuration or contact your web host.','','none'),('4594','','default','The testing framework could not be installed because the PHP <a href="@curl_url">cURL</a> library is not available.','','none'),('4595','','default','The testing framework could not be installed because the PHP <a href="@hash_url">hash</a> extension is disabled.','','none'),('4596','','default','PHP open_basedir restriction','','none'),('4597','','default','unblock IP address','','none'),('4598','','default','block IP address','','none'),('4599','','default','Managing logs','','none'),('4600','','default','Viewing site usage','','none'),('4601','','default','The Statistics module can help you break down details about your users and how they are using the site. The module offers four reports:','','none'),('4602','','default','<a href="@recent-hits">Recent hits</a> displays information about the latest activity on your site, including the URL and title of the page that was accessed, the user name (if available) and the IP address of the viewer.','','none'),('4603','','default','<a href="@top-referrers">Top referrers</a> displays where visitors came from (referrer URL).','','none'),('4604','','default','<a href="@top-pages">Top pages</a> displays a list of pages ordered by how often they were viewed.','','none'),('4605','','default','<a href="@top-visitors">Top visitors</a> shows you the most active visitors for your site and allows you to ban abusive visitors.','','none'),('4606','','default','Displaying popular content','','none'),('4607','','default','Page view counter','','none'),('4608','','default','Administer statistics','','none'),('4609','','default','View content access statistics','','none');
INSERT INTO `locales_source` VALUES ('4610','','default','View content hits','','none'),('4611','','default','Control details about what and how your site logs access statistics.','','none'),('4612','','default','Logging for UNIX, Linux, and Mac OS X','','none'),('4613','','default','Logging for Microsoft Windows','','none'),('4614','','default','On Microsoft Windows, messages are always sent to the Event Log using the code <code>LOG_USER</code>.','','none'),('4615','','default','Depending on the system configuration, Syslog and other logging tools use this code to identify or filter messages from within the entire system log.','','none'),('4616','','default','The image %file could not be rotated because the imagerotate() function is not available in this PHP installation.','','none'),('4617','','default','The image %file could not be desaturated because the imagefilter() function is not available in this PHP installation.','','none'),('4618','','default','Screenshot for !theme theme','','7.12'),('4619','','default','Settings for !theme theme','','7.12'),('4620','','default','Disable !theme theme','','7.12'),('4621','','default','Set !theme as default theme','','7.12'),('4622','','default','Enable !theme theme','','7.12'),('4623','','default','Enable and set default','','7.12'),('4624','','default','Enable !theme as default theme','','7.12'),('4625','','default','default theme','','7.12'),('4626','','default','Choose "Default theme" to always use the same theme as the rest of the site.','','7.12'),('4627','','default','Use the administration theme when editing or creating content','','7.12'),('4628','','default','The %theme theme has been enabled.','','none'),('4629','','default','The %theme theme was not found.','','none'),('4630','','default','%theme is the default theme and cannot be disabled.','','none'),('4631','','default','The %theme theme has been disabled.','','none'),('4632','','default','%theme is now the default theme.','','none'),('4633','','default','User verification status in comments','','7.12'),('4634','','default','These settings only exist for the themes based on the %engine theme engine.','','none');
INSERT INTO `locales_source` VALUES ('4635','','default','The logo could not be uploaded.','','none'),('4636','','default','The favicon could not be uploaded.','','none'),('4637','','default','The custom logo path is invalid.','','none'),('4638','','default','The custom favicon path is invalid.','','none'),('4639','','default','@module (<span class="admin-missing">incompatible with</span> version @version)','','none'),('4640','','default','This version is not compatible with Drupal !core_version and should be replaced.','','none'),('4641','','default','Would you like to continue with the above?','','7.12'),('4642','','default','Enter a valid IP address.','','none'),('4643','','default','This IP address is already blocked.','','none'),('4644','','default','You may not block your own IP address.','','none'),('4645','','default','The IP address %ip has been blocked.','','none'),('4646','','default','Are you sure you want to delete %ip?','','none'),('4647','','default','The IP address %ip was deleted.','','none'),('4648','','default','How this is used depends on your site''s theme.','','7.12'),('4649','','default','Number of posts on front page','','7.12'),('4650','','default','The maximum number of posts displayed on overview pages such as the front page.','','7.12'),('4651','','default','This page is displayed when the requested document is denied to the current user. Leave blank to display a generic "access denied" page.','','7.12'),('4652','','default','This page is displayed when no other content matches the requested document. Leave blank to display a generic "page not found" page.','','7.12'),('4653','','default','Errors and warnings','','none'),('4654','','default','Clear all caches','','7.12'),('4655','','default','<strong class="error">Set up the <a href="!file-system">public files directory</a> to make these optimizations available.</strong>','','none'),('4656','','default','Bandwidth optimization','','7.12'),('4657','','default','Compress cached pages.','','7.12'),('4658','','default','Public file system path','','7.12'),('4659','','default','A local file system path where public files will be stored. This directory must exist and be writable by Drupal. This directory must be relative to the Drupal installation directory and be accessible over the web.','','7.12');
INSERT INTO `locales_source` VALUES ('4660','','default','Private file system path','','7.12'),('4661','','default','A local file system path where temporary files will be stored. This directory should not be accessible over the web.','','7.12'),('4662','','default','Default download method','','7.12'),('4663','','default','This setting is used as the preferred download method. The use of public files is more efficient, but does not provide any access control.','','7.12'),('4664','','default','Description of your site, included in each feed.','','none'),('4665','','default','Time zones','','7.10'),('4666','','default','Users may set their own time zone.','','7.10'),('4667','','default','Remind users at login if their time zone is not set.','','7.10'),('4668','','default','Only applied if users may set their own time zone.','','7.10'),('4669','','default','Time zone for new users','','7.10'),('4670','','default','Default time zone.','','7.10'),('4671','','default','Empty time zone.','','7.10'),('4672','','default','Users may set their own time zone at registration.','','7.10'),('4673','','default','No date types available. <a href="@link">Add date type</a>.','','7.10'),('4674','','default','Add date type','','7.12'),('4675','','default','The date type must contain only alphanumeric characters and underscores.','','none'),('4676','','default','This date type already exists. Enter a unique type.','','none'),('4677','','default','New date type added successfully.','','none'),('4678','','default','Put site into maintenance mode','','7.12'),('4679','','default','Maintenance mode message','','7.12'),('4680','','default','Message to show visitors when the site is in maintenance mode.','','7.12'),('4681','','default','Use URLs like <code>example.com/user</code> instead of <code>example.com/?q=user</code>.','','7.12'),('4682','','default','Requires: !module-list','','7.12'),('4683','','default','Required by: !module-list','','7.12'),('4684','','default','Are you sure you want to remove the date type %type?','','none'),('4685','','default','Removed date type %type.','','none'),('4686','','default','No custom date formats available. <a href="@link">Add date format</a>.','','none');
INSERT INTO `locales_source` VALUES ('4687','','default','Displayed as','','none'),('4688','','default','Displayed as %date','','none'),('4689','','default','A user-defined date format. See the <a href="@url">PHP manual</a> for available options.','','none'),('4690','','default','Save format','','none'),('4691','','default','This format already exists. Enter a unique format string.','','none'),('4692','','default','Custom date format updated.','','none'),('4693','','default','Custom date format added.','','none'),('4694','','default','Available actions:','','none'),('4695','','default','Create an advanced action','','none'),('4696','','default','A unique label for this advanced action. This label will be displayed in the interface of modules that integrate with actions, such as Trigger module.','','none'),('4697','','default','Deleted %ip','','none'),('4698','','default','Enabled theme','','none'),('4699','','default','Enabled themes','','7.12'),('4700','','default','Disabled theme','','none'),('4701','','default','You must enable the @required module to install @module.','','7.12'),('4702','','default','You must enable the @required modules to install @module.','','7.12'),('4703','','default','Tokens for site-wide settings and other global information.','','7.12'),('4704','','default','Tokens related to times and dates.','','7.12'),('4705','','default','Tokens related to uploaded files.','','7.12'),('4706','','default','URL (brief)','','7.12'),('4707','','default','The URL of the site''s front page without the protocol.','','7.12'),('4708','','default','Short format','','7.12'),('4709','','default','A date in ''short'' format. (%date)','','7.12'),('4710','','default','Medium format','','7.12'),('4711','','default','A date in ''medium'' format. (%date)','','7.12'),('4712','','default','Long format','','7.12'),('4713','','default','A date in ''long'' format. (%date)','','7.12'),('4714','','default','A date in a custom format. See !php-date for details.','','7.12'),('4715','','default','the PHP documentation','','7.12'),('4716','','default','Time-since','','7.12');
INSERT INTO `locales_source` VALUES ('4717','','default','Raw timestamp','','7.12'),('4718','','default','A date in UNIX timestamp format (%date)','','7.12'),('4719','','default','Managing modules','','7.12'),('4720','','default','Managing themes','','7.12'),('4721','','default','Managing caching','','7.12'),('4722','','default','Performing system maintenance','','7.12'),('4723','','default','Configuring basic site settings','','7.12'),('4724','','default','Configuring actions','','7.12'),('4725','','default','Actions are individual tasks that the system can do, such as unpublishing a piece of content or banning a user. Modules, such as the <a href="@trigger-help">Trigger module</a>, can fire these actions when certain system events happen; for example, when a new post is added or when a user logs in. Modules may also provide additional actions. Visit the <a href="@actions">Actions page</a> to configure actions.','','7.12'),('4726','','default','Set and configure the default theme for your website.  Alternative <a href="@themes">themes</a> are available.','','7.12'),('4727','','default','Download additional <a href="@modules">contributed modules</a> to extend Drupal''s functionality.','','7.12'),('4728','','default','Regularly review and install <a href="@updates">available updates</a> to maintain a secure and current site. Always run the <a href="@update-php">update script</a> each time a module is updated.','','7.12'),('4729','','default','If you are upgrading to a newer version of Drupal or upgrading contributed modules or themes, you may need to run the <a href="@update-php">update script</a>.','','7.12'),('4730','','default','There are two types of actions: simple and advanced. Simple actions do not require any additional configuration, and are listed here automatically. Advanced actions need to be created and configured before they can be used, because they have options that need to be specified; for example, sending an e-mail to a specified address, or unpublishing content containing certain words. To create an advanced action, select the action from the drop-down list in the advanced action section below and click the <em>Create</em> button.','','none');
INSERT INTO `locales_source` VALUES ('4731','','default','Administer modules','','7.12'),('4732','','default','Administer site configuration','','7.12'),('4733','','default','Administer themes','','7.12'),('4734','','default','Administer actions','','7.12'),('4735','','default','Use the administration pages and help','','7.12'),('4736','','default','Use the site in maintenance mode','','7.12'),('4737','','default','View site reports','','7.12'),('4738','','default','Block IP addresses','','7.12'),('4739','','default','Public files','','7.12'),('4740','','default','Public local files served by the webserver.','','7.12'),('4741','','default','Private local files served by Drupal.','','7.12'),('4742','','default','Temporary files','','7.12'),('4743','','default','Temporary local files for upload and previews.','','7.12'),('4744','','default','Update modules','','7.12'),('4745','','default','Update themes','','7.12'),('4746','','default','SSH','','none'),('4747','','default','Your password is not saved in the database and is only used to establish a connection.','','none'),('4748','','default','The connection will be created between your web server and the machine hosting the web server files. In the vast majority of cases, this will be the same machine, and "localhost" is correct.','','none'),('4749','','default','Configure your <a href="@user-edit">account time zone setting</a>.','','none'),('4750','','default','Select the desired local time and time zone. Dates and times throughout this site will be displayed using this time zone.','','7.12'),('4751','','default','Your time zone setting will be automatically detected if possible. Confirm the selection and click save.','','7.12'),('4752','','default','System help','','7.12'),('4753','','default','The directory %directory does not exist and could not be created.','','none'),('4754','','default','The directory %directory exists but is not writable and could not be made writable.','','none'),('4755','','default','The message to be displayed to the current user. You may include placeholders like [node:title], [user:name], and [comment:body] to represent data that will be different each time message is sent. Not all placeholders will be available in all contexts.','','none');
INSERT INTO `locales_source` VALUES ('4756','','default','@zone: @date','','7.12'),('4757','','default','Powered by <a href="@poweredby">Drupal</a>','','7.12'),('4758','','default','AHAH callback','','7.12'),('4759','','default','Administer blocks, content types, menus, etc.','','7.12'),('4760','','default','Select and configure your theme','','7.12'),('4761','','default','Enable theme','','none'),('4762','','default','Disable theme','','none'),('4763','','default','Set default theme','','none'),('4764','','default','Configure default and theme specific settings.','','7.12'),('4765','','default','IP address blocking','','7.12'),('4766','','default','Manage blocked IP addresses.','','7.12'),('4767','','default','Delete IP address','','none'),('4768','','default','Media tools.','','7.12'),('4769','','default','Tools related to web services.','','7.12'),('4770','','default','Configure the site description, the number of items per feed and whether feeds should be titles/teasers/full-text.','','7.12'),('4771','','default','Development tools.','','7.12'),('4772','','default','Maintenance mode','','7.12'),('4773','','default','Take the site offline for maintenance or bring it back online.','','7.12'),('4774','','default','Logging and errors','','7.12'),('4775','','default','Settings for logging and alerts modules. Various modules can route Drupal''s system events to different destinations, such as syslog, database, email, etc.','','7.12'),('4776','','default','Regional and language','','7.12'),('4777','','default','Regional settings, localization and translation.','','7.12'),('4778','','default','Settings for the site''s default time zone and country.','','7.12'),('4779','','default','Configure display formats for date and time.','','7.12'),('4780','','default','Add new date type.','','7.12'),('4781','','default','Delete date type','','none'),('4782','','default','Allow users to delete a configured date type.','','none'),('4783','','default','Configure display format strings for date and time.','','7.12'),('4784','','default','Edit date format','','none'),('4785','','default','Allow users to edit a configured date format.','','none');
INSERT INTO `locales_source` VALUES ('4786','','default','Search and metadata','','7.12'),('4787','','default','Local site search, metadata and SEO.','','7.12'),('4788','','default','General system related configuration.','','7.12'),('4789','','default','Tools that enhance the user interface.','','7.12'),('4790','','default','Content workflow, editorial workflow tools.','','7.12'),('4791','','default','Content authoring','','7.12'),('4792','','default','Settings related to formatting and authoring content.','','7.12'),('4793','','default','The host !host is no longer blocked because it is not a valid IP address.','','none'),('4794','','default','Inserted into {role_permission} the permissions for role ID !id','','none'),('4795','','default','%profile_name (%profile-%version)','','none'),('4796','','default','more information','','7.12'),('4797','','default','To run cron from outside the site, go to <a href="!cron">!cron</a>','','7.12'),('4798','','default','Your configuration has been saved.','','7.12'),('4799','','default','No vocabularies available. <a href="@link">Add vocabulary</a>.','','7.12'),('4800','','default','No terms available. <a href="@link">Add term</a>.','','7.12'),('4801','','default','There is currently no content classified with this term.','','7.12'),('4802','','default','Tokens related to taxonomy terms.','','7.12'),('4803','','default','Tokens related to taxonomy vocabularies.','','7.12'),('4804','','default','Creating vocabularies','','7.12'),('4805','','default','<em>vocabulary</em>: Music','','7.12'),('4806','','default','<em>term</em>: Jazz','','7.12'),('4807','','default','<em>sub-term</em>: Swing','','7.12'),('4808','','default','<em>sub-term</em>: Fusion','','7.12'),('4809','','default','<em>term</em>: Rock','','7.12'),('4810','','default','<em>sub-term</em>: Country rock','','7.12'),('4811','','default','<em>sub-term</em>: Hard rock','','7.12'),('4812','','default','You can assign a sub-term to multiple parent terms. For example, <em>fusion</em> can be assigned to both <em>rock</em> and <em>jazz</em>.','','7.12'),('4813','','default','Terms in a <em>free-tagging vocabulary</em> can be built gradually as you create or edit content. This is often done used for blogs or photo management applications.','','7.12');
INSERT INTO `locales_source` VALUES ('4814','','default','Assigning vocabularies to content types','','7.12'),('4815','','default','Classifying content','','7.12'),('4816','','default','After the vocabulary is assigned to the content type, you can start classifying content. The field with terms will appear on the content editing screen when you edit or <a href="@addnode">add new content</a>.','','7.12'),('4817','','default','Viewing listings and RSS feeds by term','','7.12'),('4818','','default','Each taxonomy term automatically provides a page listing content that has its classification, and a corresponding RSS feed. For example, if the taxonomy term <em>country rock</em> has the ID 123 (you can see this by looking at the URL when hovering on the linked term, which you can click to navigate to the listing page), then you will find this list at the path <em>taxonomy/term/123</em>. The RSS feed will use the path <em>taxonomy/term/123/feed</em> (the RSS icon for this term''s listing will automatically display in your browser''s address bar when viewing the listing page).','','7.12'),('4819','','default','Extending Taxonomy module','','7.12'),('4820','','default','There are <a href="@taxcontrib">many contributed modules</a> that extend the behavior of the Taxonomy module for both display and organization of terms.','','7.12'),('4821','','default','Taxonomy is for categorizing content. Terms are grouped into vocabularies. For example, a vocabulary called "Fruit" would contain the terms "Apple" and "Banana".','','7.12'),('4822','','default','You can reorganize the terms in %capital_name using their drag-and-drop handles, and group terms under a parent term by sliding them under and to the right of the parent.','','7.12'),('4823','','default','%capital_name contains terms grouped under parent terms. You can reorganize the terms in %capital_name using their drag-and-drop handles.','','7.12'),('4824','','default','Administer vocabularies and terms','','7.12'),('4825','','default','Edit terms in %vocabulary','','7.12'),('4826','','default','Delete terms from %vocabulary','','7.12');
INSERT INTO `locales_source` VALUES ('4827','','default','Taxonomy term page','','7.12'),('4828','','default','Term reference','','7.12'),('4829','','default','This field stores a reference to a taxonomy term.','','7.12'),('4830','','default','Autocomplete term widget (tagging)','','7.12'),('4831','','default','The vocabulary which supplies the options for this field.','','7.12'),('4832','','default','The Toolbar module displays links to top-level administration menu items and links from other modules at the top of the screen. For more information, see the online handbook entry for <a href="@toolbar">Toolbar module</a>.','','7.12'),('4833','','default','Displaying administrative links','','7.12'),('4834','','default','Use the administration toolbar','','7.12'),('4835','','default','Toggle drawer visibility','','none'),('4836','','default','Provides a toolbar that shows the top-level administration menu items and links from other modules.','','7.12'),('4837','','default','The Tracker module displays the most recently added and updated content on your site, and allows you to follow new content created by each user. This module has no configuration options. For more information, see the online handbook entry for <a href="@tracker">Tracker module</a>.','','7.12'),('4838','','default','The Tracker module adds a new menu item to the Navigation menu, called <em>Recent content</em>. You can configure menu items via the <a href="@menus">Menus administration page</a>.','','7.12'),('4839','','default','Tracking new and updated site content','','7.12'),('4840','','default','The <a href=''@recent''>Recent content</a> page shows new and updated content in reverse chronological order, listing the content type, title, author''s name, number of comments, and time of last update. Content is considered updated when changes occur in the text, or when new comments are added. The <em>My recent content</em> tab limits the list to the currently logged-in user.','','7.12'),('4841','','default','Tracking user-specific content','','7.12'),('4842','','default','To follow a specific user''s new and updated content, select the <em>Track</em> tab from the user''s profile page.','','7.12');
INSERT INTO `locales_source` VALUES ('4843','','default','All recent content','','7.12'),('4844','','default','My recent content','','7.12'),('4845','','default','Track content','','7.12'),('4846','','default','Enables tracking of recent content for users.','','7.12'),('4847','','default','The Content translation module allows content to be translated into different languages. Working with the <a href="@locale">Locale module</a> (which manages enabled languages and provides translation for the site interface), the Content translation module is key to creating and maintaining translated site content. For more information, see the online handbook entry for <a href="@translation">Content translation module</a>.','','none'),('4848','','default','Configuring content types for translation','','none'),('4849','','default','To configure a particular content type for translation, visit the <a href="@content-types">Content types</a> page, and click the <em>edit</em> link for the content type. In the <em>Publishing options</em> section, select <em>Enabled, with translation</em> under <em>Multilingual support</em>.','','none'),('4850','','default','Assigning a language to content','','none'),('4851','','default','Use the <em>Language</em> drop down to select the appropriate language when creating or editing content.','','none'),('4852','','default','Translating content','','none'),('4853','','default','Users with the <em>translate content</em> permission can translate content, if the content type has been configured to allow translations. To translate content, select the <em>Translation</em> tab when viewing the content, select the language for which you wish to provide content, and then enter the content.','','none'),('4854','','default','Maintaining translations','','none'),('4855','','default','If editing content in one language requires that translated versions also be updated to reflect the change, use the <em>Flag translations as outdated</em> check box to mark the translations as outdated and in need of revision. Individual translations may also be marked for revision by selecting the <em>This translation needs to be updated</em> check box on the translation editing form.','','none');
INSERT INTO `locales_source` VALUES ('4856','','default','Translate content','','none'),('4857','','default','There is already a translation in this language.','','none'),('4858','','default','Trigger: !description','','none'),('4859','','default','No actions available for this trigger. <a href="@link">Add action</a>.','','none'),('4860','','default','Missing/undefined save action (%save_aid) for %aid action.','','none'),('4861','','default','The %label action has been appended, which is required to save the property change.','','none'),('4862','','default','The %label action was moved to save the property change.','','none'),('4863','','default','The Trigger module provides the ability to cause <em>actions</em> to run when certain <em>triggers</em> take place on your site. Triggers are events, such as new content being added to your site or a user logging in, and actions are tasks, such as unpublishing content or e-mailing an administrator. For more information, see the online handbook entry for <a href="@trigger">Trigger module</a>.','','none'),('4864','','default','Configuring triggers and actions','','none'),('4865','','default','When either saving new content or updating existing content','','none'),('4866','','default','After saving updated content','','none'),('4867','','default','When either saving a new comment or updating an existing comment','','none'),('4868','','default','After creating a new user account','','none'),('4869','','default','After updating a user account','','none'),('4870','','default','Configure when to execute actions.','','none'),('4871','','default','Installing updates','','none'),('4872','','default','Preparing to update your site','','none'),('4873','','default','Installing %project','','none'),('4874','','default','Preparing to install','','none'),('4875','','default','Error installing / updating','','none'),('4876','','default','Installed %project_name successfully','','none'),('4877','','default','Update was completed successfully. Your site has been taken out of maintenance mode.','','none'),('4878','','default','Update was completed successfully.','','none');
INSERT INTO `locales_source` VALUES ('4879','','default','Update failed! See the log below for more information.','','none'),('4880','','default','Update failed! See the log below for more information. Your site is still in maintenance mode.','','none'),('4881','','default','Installation was completed successfully. Your site has been taken out of maintenance mode.','','none'),('4882','','default','Installation was completed successfully.','','none'),('4883','','default','Installation failed! See the log below for more information.','','none'),('4884','','default','Installation failed! See the log below for more information. Your site is still in maintenance mode.','','none'),('4885','','default','Failed to get available update data.','','none'),('4886','','default','No available update data','','7.12'),('4887','','default','Checking available update data','','7.10'),('4888','','default','Trying to check available update data ...','','7.10'),('4889','','default','Error checking available update data.','','7.10'),('4890','','default','Checking available update data ...','','7.10'),('4891','','default','Checked available update data for %title.','','7.10'),('4892','','default','Failed to check available update data for %title.','','none'),('4893','','default','An error occurred trying to get available update data.','','none'),('4894','','default','Checked available update data for one project.','','none'),('4895','','default','Checked available update data for @count projects.','','7.10'),('4896','','default','Failed to get available update data for one project.','','none'),('4897','','default','Failed to get available update data for @count projects.','','none'),('4898','','default','There was a problem getting update information. Try again later.','','none'),('4899','','default','(Theme)','','none'),('4900','','default','(Release notes)','','7.12'),('4901','','default','This update is a major version update which means that it may not be backwards compatible with your currently running version.  It is recommended that you read the release notes and proceed at your own risk.','','none');
INSERT INTO `locales_source` VALUES ('4902','','default','(Security update)','','7.12'),('4903','','default','(Unsupported)','','none'),('4904','','default','All of your projects are up to date.','','7.10'),('4905','','default','Download these updates','','7.12'),('4906','','default','Manual updates required','','7.10'),('4907','','default','Updates of Drupal core are not supported at this time.','','7.10'),('4908','','default','You must select at least one project to update.','','none'),('4909','','default','Downloading updates','','none'),('4910','','default','Preparing to download selected updates','','none'),('4911','','default','Downloading updates failed:','','none'),('4912','','default','Updates downloaded successfully.','','none'),('4913','','default','Fatal error trying to download.','','none'),('4914','','default','Back up your database and site before you continue. <a href="@backup_url">Learn how</a>.','','none'),('4915','','default','Perform updates with site in maintenance mode (strongly recommended)','','none'),('4916','','default','Install from a URL','','7.12'),('4917','','default','For example: %url','','7.12'),('4918','','default','Upload a module or theme archive to install','','7.12'),('4919','','default','For example: %filename from your local computer','','7.12'),('4920','','default','You must either provide a URL or upload an archive file to install.','','none'),('4921','','default','The provided URL is invalid.','','none'),('4922','','default','Unable to retrieve Drupal project from %url.','','none'),('4923','','default','Provided archive contains no files.','','none'),('4924','','default','Unable to determine %project name.','','none'),('4925','','default','%project is already installed.','','none'),('4926','','default','Cannot extract %file, not a valid archive.','','none'),('4927','','default','Downloading %project','','none'),('4928','','default','Failed to download %project from %url','','none'),('4929','','default','Includes:','','7.12'),('4930','','default','Enabled: %includes','','none'),('4931','','default','Disabled: %disabled','','none');
INSERT INTO `locales_source` VALUES ('4932','','default','%base_theme (!base_label)','','none'),('4933','','default','Depends on: !basethemes','','none'),('4934','','default','Required by: %subthemes','','none'),('4935','','default','The Update manager module periodically checks for new versions of your site''s software (including contributed modules and themes), and alerts administrators to available updates. In order to provide update information, anonymous usage statistics are sent to Drupal.org. If desired, you may disable the Update manager module from the <a href=''@modules''>Module administration page</a>. For more information, see the online handbook entry for <a href=''@update''>Update manager module</a>.','','7.12'),('4936','','default','The Update manager also allows administrators to update and install modules and themes through the administration interface.','','7.12'),('4937','','default','Checking for available updates','','7.12'),('4938','','default','A report of <a href="@update-report">available updates</a> will alert you when new releases are available for download. You may configure options for the frequency for checking updates (which are performed during <a href="@cron">cron</a> runs) and e-mail notifications at the <a href="@update-settings">Update manager settings</a>  page.','','7.12'),('4939','','default','Performing updates through the user interface','','7.12'),('4940','','default','The Update manager module allows administrators to perform updates directly through the administration interface. At the top of the <a href="@modules_page">modules</a> and <a href="@themes_page">themes</a> pages you will see a link to update to new releases. This will direct you to the <a href="@update-page">update page</a> where you see a listing of all the missing updates and confirm which ones you want to upgrade. From there, you are prompted for your FTP/SSH password, which then transfers the files into your Drupal installation, overwriting your old files. More detailed instructions can be found in the <a href="@update">online handbook</a>.','','7.12');
INSERT INTO `locales_source` VALUES ('4941','','default','Installing new modules and themes through the user interface','','7.12'),('4942','','default','You can also install new modules and themes in the same fashion, through the <a href="@install">install page</a>, or by clicking the <em>Install new module/theme</em> link at the top of the <a href="@modules_page">modules</a> and <a href="@themes_page">themes</a> pages. In this case, you are prompted to provide either the URL to the download, or to upload a packaged release file from your local computer.','','7.12'),('4943','','default','No update information available. <a href="@run_cron">Run cron</a> or <a href="@check_manually">check manually</a>.','','7.12'),('4944','','default','You can automatically install your missing updates using the Update manager:','','none'),('4945','','default','Your site is currently configured to send these emails when any updates are available. To get notified only for security updates, !url.','','none'),('4946','','default','Your site is currently configured to send these emails only when security updates are available. To get notified for any available updates, !url.','','none'),('4947','','default','The installed version of at least one of your modules or themes is no longer supported. Upgrading or disabling is strongly recommended. See the project homepage for more details.','','none'),('4948','','default','There was a problem checking <a href="@update-report">available updates</a> for Drupal.','','7.12'),('4949','','default','There was a problem checking <a href="@update-report">available updates</a> for your modules or themes.','','7.12'),('4950','','default','See the <a href="@available_updates">available updates</a> page for more information and to install your missing updates.','','7.12'),('4951','','default','Ready to update','','none'),('4952','','default','Update manager','','7.12'),('4953','','default','Checks for available updates, and can securely install or update modules and themes via a web interface.','','7.12'),('4954','','default','No people available.','','7.12');
INSERT INTO `locales_source` VALUES ('4955','','default','This role will be automatically assigned new permissions whenever a module is enabled. Changing this setting will not affect existing permissions.','','7.12'),('4956','','default','Registration and cancellation','','7.12'),('4957','','default','Who can register accounts?','','7.12'),('4958','','default','Administrators only','','7.12'),('4959','','default','Visitors, but administrator approval is required','','7.12'),('4960','','default','Require e-mail verification when a visitor creates an account.','','7.12'),('4961','','default','New users will be required to validate their e-mail address prior to logging into the site, and will be assigned a system-generated password. With this setting disabled, users will be logged in immediately upon registering, and may select their own passwords during registration.','','7.12'),('4962','','default','When cancelling a user account','','7.12'),('4963','','default','Users with the %select-cancel-method or %administer-users <a href="@permissions-url">permissions</a> can override this default method.','','7.12'),('4964','','default','Select method for cancelling account','','7.12'),('4965','','default','Administer users','','7.12'),('4966','','default','Personalization','','7.12'),('4967','','default','Enable signatures.','','7.12'),('4968','','default','The directory %directory does not exist or is not writable.','','none'),('4969','','default','Enable user pictures.','','7.12'),('4970','','default','Picture directory','','7.12'),('4971','','default','Picture display style','','7.12'),('4972','','default','The style selected will be used on display, while the original image is retained. Styles may be configured in the <a href="!url">Image styles</a> administration area.','','7.12'),('4973','','default','Picture upload dimensions','','7.12'),('4974','','default','Picture upload file size','','7.12'),('4975','','default','E-mails','','7.12'),('4976','','default','Welcome (new user created by administrator)','','7.12'),('4977','','default','Edit the welcome e-mail messages sent to new member accounts created by an administrator.','','7.12');
INSERT INTO `locales_source` VALUES ('4978','','default','Welcome (awaiting approval)','','7.12'),('4979','','default','Edit the welcome e-mail messages sent to new members upon registering, when administrative approval is required.','','7.12'),('4980','','default','Welcome (no approval required)','','7.12'),('4981','','default','Edit the welcome e-mail messages sent to new members upon registering, when no administrator approval is required.','','7.12'),('4982','','default','Password recovery','','7.12'),('4983','','default','Edit the e-mail messages sent to users who request a new password.','','7.12'),('4984','','default','Account activation','','7.12'),('4985','','default','Enable and edit e-mail messages sent to users upon account activation (when an administrator activates an account of a user who has already registered, on a site where administrative approval is required).','','7.12'),('4986','','default','Enable and edit e-mail messages sent to users when their accounts are blocked.','','7.12'),('4987','','default','Account cancellation confirmation','','7.12'),('4988','','default','Edit the e-mail messages sent to users when they attempt to cancel their accounts.','','7.12'),('4989','','default','Account canceled','','7.12'),('4990','','default','Enable and edit e-mail messages sent to users when their accounts are canceled.','','7.12'),('4991','','default','Notify user when account is canceled.','','7.12'),('4992','','default','The role name %name already exists. Choose another role name.','','none'),('4993','','default','You are logged in as %user. <a href="!user_edit">Change your password.</a>','','7.12'),('4994','','default','Another user (%other_user) is already logged into the site on this computer, but you tried to use a one-time link for user %resetting_user. Please <a href="!logout">logout</a> and try using the link again.','','7.12'),('4995','','default','The one-time login link you clicked is invalid.','','none'),('4996','','default','You have just used your one-time login link. It is no longer necessary to use this link to log in. Please change your password.','','7.12');
INSERT INTO `locales_source` VALUES ('4997','','default','<p>This is a one-time login for %user_name and will expire on %expiration_date.</p><p>Click on this button to log in to the site and change your password.</p>','','7.12'),('4998','','default','You have tried to use a one-time login link that has either been used or is no longer valid. Please request a new one using the form below.','','7.12'),('4999','','default','When cancelling your account','','7.12'),('5000','','default','When cancelling the account','','7.12'),('5001','','default','Require e-mail confirmation to cancel account.','','7.12'),('5002','','default','When enabled, the user must confirm the account cancellation via e-mail.','','7.12'),('5003','','default','When enabled, the user will receive an e-mail notification after the account has been cancelled.','','7.12'),('5004','','default','Are you sure you want to cancel your account?','','7.12'),('5005','','default','Are you sure you want to cancel the account %name?','','7.12'),('5006','','default','Select the method to cancel the account above.','','7.12'),('5007','','default','A confirmation request to cancel your account has been sent to your e-mail address.','','7.12'),('5008','','default','Your account will be blocked and you will no longer be able to log in. All of your content will remain attributed to your user name.','','7.12'),('5009','','default','Your account will be blocked and you will no longer be able to log in. All of your content will be hidden from everyone but administrators.','','7.12'),('5010','','default','Your account will be removed and all account information deleted. All of your content will be assigned to the %anonymous-name user.','','7.12'),('5011','','default','Your account will be removed and all account information deleted. All of your content will also be deleted.','','7.12'),('5012','','default','You have tried to use an account cancellation link that has expired. Please request a new one using the form below.','','none'),('5013','','default','Sent account cancellation request to %name %email.','','none');
INSERT INTO `locales_source` VALUES ('5014','','default','Tokens related to individual user accounts.','','7.12'),('5015','','default','Tokens related to the currently logged in user.','','7.12'),('5016','','default','The User module allows users to register, log in, and log out. It also allows users with proper permissions to manage user roles (used to classify users) and permissions associated with those roles. For more information, see the online handbook entry for <a href="@user">User module</a>.','','7.12'),('5017','','default','Creating and managing users','','7.12'),('5018','','default','The User module allows users with the appropriate <a href="@permissions">permissions</a> to create user accounts through the <a href="@people">People administration page</a>, where they can also assign users to one or more roles, and block or delete user accounts. If allowed, users without accounts (anonymous users) can create their own accounts on the <a href="@register">Create new account</a> page.','','7.12'),('5019','','default','User roles and permissions','','7.12'),('5020','','default','<em>Roles</em> are used to group and classify users; each user can be assigned one or more roles. By default there are two roles: <em>anonymous user</em> (users that are not logged in) and <em>authenticated user</em> (users that are registered and logged in). Depending on choices you made when you installed Drupal, the installation process may have defined more roles, and you can create additional custom roles on the <a href="@roles">Roles page</a>. After creating roles, you can set permissions for each role on the <a href="@permissions_user">Permissions page</a>. Granting a permission allows users who have been assigned a particular role to perform an action on the site, such as viewing a particular type of content, editing or creating content, administering settings for a particular module, or using a particular function of the site (such as search).','','7.12'),('5021','','default','The <a href="@accounts">Account settings page</a> allows you to manage settings for the displayed name of the anonymous user role, personal contact forms, user registration, and account cancellation. On this page you can also manage settings for account personalization (including signatures and user pictures), and adapt the text for the e-mail messages that are sent automatically during the user registration process.','','7.12');
INSERT INTO `locales_source` VALUES ('5022','','default','By default, Drupal comes with two user roles:','','7.12'),('5023','','default','Anonymous user: this role is used for users that don''t have a user account or that are not authenticated.','','7.12'),('5024','','default','Authenticated user: this role is automatically granted to all logged in users.','','7.12'),('5025','','default','This form lets administrators add, edit, and arrange fields for storing user data.','','7.12'),('5026','','default','This form lets administrators configure how fields should be displayed when rendering a user profile page.','','7.12'),('5027','','default','User module timezone form element.','','7.12'),('5028','','default','User module history view element.','','7.12'),('5029','','default','Administer permissions','','7.12'),('5030','','default','View user profiles','','7.12'),('5031','','default','Change own username','','7.12'),('5032','','default','Cancel own user account','','7.12'),('5033','','default','Note: content may be kept, unpublished, deleted or transferred to the %anonymous-name user depending on the configured <a href="@user-settings-url">user settings</a>.','','7.12'),('5034','','default','Select method for cancelling own account','','7.12'),('5035','','default','Spaces are allowed; punctuation is not allowed except for periods, hyphens, apostrophes, and underscores.','','7.12'),('5036','','default','The signature is too long: it must be %max characters or less.','','none'),('5037','','default','Sorry, too many failed login attempts from your IP address. This IP address is temporarily blocked. Try again later or <a href="@url">request a new password</a>.','','7.12'),('5038','','default','Cancelling account','','7.12'),('5039','','default','Cancelling user account','','7.12'),('5040','','default','%name has been disabled.','','none'),('5041','','default','Account details for [user:name] at [site:name]','','7.10'),('5042','','default','An administrator created an account for you at [site:name]','','7.10'),('5043','','default','Account details for [user:name] at [site:name] (pending admin approval)','','7.10');
INSERT INTO `locales_source` VALUES ('5044','','default','[user:name],\n\nThank you for registering at [site:name]. Your application for an account is currently pending approval. Once it has been approved, you will receive another e-mail containing information about how to log in, set your password, and other details.\n\n\n--  [site:name] team','','7.10'),('5045','','default','[user:name] has applied for an account.\n\n[user:edit-url]','','none'),('5046','','default','Replacement login information for [user:name] at [site:name]','','7.10'),('5047','','default','Account details for [user:name] at [site:name] (approved)','','7.10'),('5048','','default','Account details for [user:name] at [site:name] (blocked)','','7.10'),('5049','','default','Account cancellation request for [user:name] at [site:name]','','7.10'),('5050','','default','Account details for [user:name] at [site:name] (canceled)','','7.10'),('5051','','default','Cancel the selected user accounts','','7.12'),('5052','','default','The user account %name cannot be cancelled.','','none'),('5053','','default','When cancelling these accounts','','7.12'),('5054','','default','Are you sure you want to cancel these user accounts?','','7.12'),('5055','','default','Cancel accounts','','7.12'),('5056','','default','To make your password stronger:','','7.12'),('5057','','default','Make it at least 6 characters','','7.12'),('5058','','default','Add lowercase letters','','7.12'),('5059','','default','Add uppercase letters','','7.12'),('5060','','default','Add numbers','','7.12'),('5061','','default','Add punctuation','','7.12'),('5062','','default','Make it different from your username','','7.12'),('5063','','default','Weak','','7.12'),('5064','','default','Fair','','7.12'),('5065','','default','Blocked user: %name %email.','','none'),('5066','','default','There is currently 1 user online.','','7.12'),('5067','','default','There are currently @count users online.','','7.10'),('5068','','default','Sorry, there has been more than one failed login attempt for this account. It is temporarily blocked. Try again later or <a href="@url">request a new password</a>.','','none');
INSERT INTO `locales_source` VALUES ('5069','','default','Sorry, there have been more than @count failed login attempts for this account. It is temporarily blocked. Try again later or <a href="@url">request a new password</a>.','','7.12'),('5070','','default','Find and manage people interacting with your site.','','7.12'),('5071','','default','Confirm account cancellation','','7.12'),('5072','','default','User passwords rehashed to improve security','','none'),('5073','','default','Migrated user time zones','','none'),('5074','','default','Minimal','','7.10'),('5075','','default','Start with only a few modules enabled.','','none'),('5076','','default','Basic page','','7.12'),('5077','','default','Use <em>basic pages</em> for your static content, such as an ''About us'' page.','','7.12'),('5078','','default','Use tags to group articles on similar topics into categories.','','none'),('5079','','default','Enter a comma-separated list of words to describe your content.','','none'),('5080','','default','Install with commonly used features pre-configured.','','none'),('5081','','default','Content width','','none'),('5082','','default','Fluid width','','none'),('5083','','default','Fixed width','','none'),('5084','','default','Specify whether the content will wrap to a fixed width or will fluidly expand to the width of the browser window.','','none'),('5085','','default','A multi-column theme which can be configured to modify colors and switch between fixed and fluid width layouts.','','7.12'),('5086','','default','A simple one-column, tableless, fluid width administration theme.','','7.12'),('5087','','default','This theme demonstrates Drupal''s default HTML markup and CSS styles. To learn how to build your own theme and override Drupal''s default code, see the <a href="http://drupal.org/theme-guide">Theming Guide</a>.','','7.12'),('5088','','default','Image style','','7.12'),('5089','','default','1 pending update (@number_applied to be applied, @number_incompatible skipped)','','none'),('5090','','default','@count pending updates (@number_applied to be applied, @number_incompatible skipped)','','none');
INSERT INTO `locales_source` VALUES ('5091','','default','The Blog module allows registered users to maintain an online journal, or <em>blog</em>. Blogs are made up of individual <em>blog entries</em>. By default, the blog entries are displayed by creation time in descending order, with comments enabled, and are promoted to the site''s front page. For more information, see the online handbook entry for <a href=''@blog''>Blog module</a>.','','none'),('5092','','default','Author textfield','','7.12'),('5093','','default','Subject textfield','','7.12'),('5094','','default','A contact form with category %category already exists.','','none'),('5095','','default','Hello !recipient-name,','','7.12'),('5096','','default','Attempt to create an instance of a field @field_name that doesn''t exist or is currently inactive.','','none'),('5097','','default','Attempt to create an instance of field @field_name on bundle @bundle that already has an instance of that field.','','none'),('5098','','default','Field API to add fields to entities like nodes and users.','','7.12'),('5099','','default','Overview of fields on all entity types.','','7.12'),('5100','','default','Configuring text formats','','7.12'),('5101','','default','Show more content','','7.12'),('5102','','default','Collapse','','none'),('5103','','default','The testing framework requires the DOMDocument class to be available. Check the configure command at the <a href="@link-phpinfo">PHP info page</a>.','','none'),('5104','','default','Error messages to display','','none'),('5105','','default','It is recommended that sites running on production environments do not display any errors.','','none'),('5106','','default','Cannot open %file_path','','none'),('5107','','default','Term name textfield','','7.12'),('5108','','default','Term description textarea','','7.12'),('5109','','default','Password reset instructions will be mailed to %email. You must log out to use the password reset link in the e-mail.','','7.12'),('5110','','default','Enter your current password to change the %mail or %pass. !request_new.','','7.12');
INSERT INTO `locales_source` VALUES ('5111','','default','Current password','','7.12'),('5112','','default','Your current password is missing or incorrect; it''s required to change the %name.','','7.12'),('5113','','default','A welcome message with further instructions has been e-mailed to the new user <a href="@url">%name</a>.','','7.12'),('5114','','default','A welcome message with further instructions has been sent to your e-mail address.','','7.12'),('5115','','default','Configure user accounts.','','7.12'),('5116','','default','Configure default behavior of users, including registration requirements, e-mails, fields, and user pictures.','','7.12'),('5117','','default','%module module installed.','','none'),('5118','','default','Table %name already exists.','','none'),('5119','','default','Cannot rename %table to %table_new: table %table doesn''t exist.','','none'),('5120','','default','Cannot rename %table to %table_new: table %table_new already exists.','','none'),('5121','','default','Cannot add field %table.%field: table doesn''t exist.','','none'),('5122','','default','Cannot add field %table.%field: field already exists.','','none'),('5123','','default','Cannot set default value of field %table.%field: field doesn''t exist.','','none'),('5124','','default','Cannot remove default value of field %table.%field: field doesn''t exist.','','none'),('5125','','default','Cannot add primary key to table %table: table doesn''t exist.','','none'),('5126','','default','Cannot add primary key to table %table: primary key already exists.','','none'),('5127','','default','Cannot add unique key %name to table %table: table doesn''t exist.','','none'),('5128','','default','Cannot add unique key %name to table %table: unique key already exists.','','none'),('5129','','default','Cannot add index %name to table %table: table doesn''t exist.','','none'),('5130','','default','Cannot add index %name to table %table: index already exists.','','none'),('5131','','default','Cannot change the definition of field %table.%name: field doesn''t exist.','','none'),('5132','','default','Cannot rename field %table.%name to %name_new: target field already exists.','','none');
INSERT INTO `locales_source` VALUES ('5133','','default','Use this page to create a new custom block.','','7.12'),('5134','','default','Number of recent blog posts to display','','none'),('5135','','default','@node_type comment','','7.12'),('5136','','default','Edit comment %comment','','none'),('5137','','default','Planning fields','','7.12'),('5138','','default','What the field will be called','','7.12'),('5139','','default','A field has a <em>label</em> (the name displayed in the user interface) and a <em>machine name</em> (the name used internally). The label can be changed after you create the field, if needed, but the machine name cannot be changed after you have created the field.','','7.12'),('5140','','default','What type of data the field will store','','7.12'),('5141','','default','Each field can store one type of data (text, number, file, etc.). When you define a field, you choose a particular <em>field type</em>, which corresponds to the type of data you want to store. The field type cannot be changed after you have created the field.','','7.12'),('5142','','default','How the data will be input and displayed','','7.12'),('5143','','default','How many values the field will store','','7.12'),('5144','','default','Reusing fields','','7.12'),('5145','','default','Once you have defined a field, you can reuse it. For example, if you define a custom image field for one content type, and you need to have an image field with the same parameters on another content type, you can add the same field to the second content type, in the <em>Add existing field</em> area of the user interface. You could also add this field to a taxonomy vocabulary, comments, user accounts, etc.','','7.12'),('5146','','default','Some settings of a reused field are unique to each use of the field; others are shared across all places you use the field. For example, the label of a text field is unique to each use, while the setting for the number of values is shared.','','7.12'),('5147','','default','There are two main reasons for reusing fields. First, reusing fields can save you time over defining new fields. Second, reusing fields also allows you to display, filter, group, and sort content together by field across content types. For example, the contributed Views module allows you to create lists and tables of content. So if you use the same field on multiple content types, you can create a View containing all of those content types together displaying that field, sorted by that field, and/or filtered by that field.','','7.12');
INSERT INTO `locales_source` VALUES ('5148','','default','Fields on content items','','7.12'),('5149','','default','Fields on taxonomy terms','','7.12'),('5150','','default','Fields on user accounts','','7.12'),('5151','','default','Fields on user accounts are defined on a site-wide basis on the <a href="@fields">Manage fields tab</a> of the <a href="@accounts">Account settings</a> page. When you define a field for user accounts, each user account will have that field added to it. For example, you could add a long text field to allow users to include a biography.','','7.12'),('5152','','default','Fields on comments','','7.12'),('5153','','default','Administer text formats and filters','','7.12'),('5154','','default','@type language detection','','7.10'),('5155','','default','Strings in the uploaded file replace existing ones, new ones are added. The plural format is updated.','','none'),('5156','','default','Existing strings and the plural format are kept, only new strings are added.','','none'),('5157','','default','Define how to decide which language is used to display page elements (primarily text provided by Drupal and modules, such as field labels and help text). This decision is made by evaluating a series of detection methods for languages; the first detection method that gets a result will determine which language is used for that type of text. Define the order of evaluation of language detection methods on this page.','','7.10'),('5158','','default','User interface text','','7.12'),('5159','','default','Use the detected interface language.','','7.12'),('5160','','default','Add new %type','','none'),('5161','','default','The new set is created by copying items from your default shortcut set.','','7.12'),('5162','','default','The new set is created by copying items from the %default set.','','none'),('5163','','default','You are currently using the %set-name shortcut set.','','none'),('5164','','default','edit set name','','none'),('5165','','default','delete set','','none'),('5166','','default','Create new set','','none'),('5167','','default','The %set_name shortcut set has been created. You can edit it from this page.','','none');
INSERT INTO `locales_source` VALUES ('5168','','default','Updated set name to %set-name.','','none'),('5169','','default','If you have chosen this shortcut set as the default for some or all users, they may also be affected by deleting it.','','none'),('5170','','default','Are you sure you want to delete the shortcut set %title?','','none'),('5171','','default','The shortcut set %title has been deleted.','','none'),('5172','','default','1 user has chosen or been assigned to this shortcut set.','','none'),('5173','','default','@count users have chosen or been assigned to this shortcut set.','','none'),('5174','','default','The Shortcut module allows users to create sets of <em>shortcut</em> links to commonly-visited pages of the site. Shortcuts are contained within <em>sets</em>. Each user with <em>Select any shortcut set</em> permission can select a shortcut set created by anyone at the site. For more information, see the online handbook entry for <a href="@shortcut">Shortcut module</a>.','','7.12'),('5175','','default','Administering shortcuts','','7.12'),('5176','','default','Users with the <em>Administer shortcuts</em> permission can manage shortcut sets and edit the shortcuts within sets from the <a href="@shortcuts">Shortcuts administration page</a>.','','7.12'),('5177','','default','Choosing shortcut sets','','7.12'),('5178','','default','Users with permission to switch shortcut sets can choose a shortcut set to use from the Shortcuts tab of their user account page.','','7.12'),('5179','','default','Define which shortcut set you are using on the <a href="@shortcut-link">Shortcuts tab</a> of your account page.','','none'),('5180','','default','Edit current shortcut set','','7.12'),('5181','','default','Editing the current shortcut set will affect other users if that set has been assigned to or selected by other users. Granting "Select any shortcut set" permission along with this permission will grant permission to edit any shortcut set.','','7.12'),('5182','','default','Select any shortcut set','','7.12'),('5183','','default','From all shortcut sets, select one to be own active set. Without this permission, an administrator selects shortcut sets for users.','','7.12');
INSERT INTO `locales_source` VALUES ('5184','','default','Add and modify shortcut sets.','','7.12'),('5185','','default','Add shortcut set','','7.12'),('5186','','default','Edit set name','','none'),('5187','','default','Delete shortcut set','','none'),('5188','','default','@remote could not be saved to @path.','','none'),('5189','','default','Drupal requires you to enable the PHP extensions in the following list (see the <a href="@system_requirements">system requirements page</a> for more information):','','none'),('5190','','default','Database support','','7.12'),('5191','','default','Your web server does not appear to support any common PDO database extensions. Check with your hosting provider to see if they support PDO (PHP Data Objects) and offer any databases that <a href="@drupal-databases">Drupal supports</a>.','','none'),('5192','','default','Footer first column','','7.12'),('5193','','default','Footer second column','','7.12'),('5194','','default','Footer third column','','7.12'),('5195','','default','Footer fourth column','','7.12'),('5196','','default','Kyrgyz','','7.10'),('5197','','default','theme() may not be called until all modules are loaded.','','none'),('5198','','default','GD library PNG support','','7.12'),('5199','','default','The date the comment was most recently updated.','','7.12'),('5200','','default','Comment posted: %subject.','','none'),('5201','','default','On value','','7.12'),('5202','','default','If left empty, "1" will be used.','','7.12'),('5203','','default','Off value','','7.12'),('5204','','default','If left empty, "0" will be used.','','7.12'),('5205','','default','This field has been disabled because you do not have sufficient permissions to edit it.','','none'),('5206','','default','Select a forum.','','none'),('5207','','default','GD library rotate and desaturate effects','','7.12'),('5208','','default','View, edit and delete all content regardless of permission restrictions.','','7.12'),('5209','','default','You must validate your email address for this account before logging in via OpenID.','','none'),('5210','','default','The HTML ID %id is unique.','','none');
INSERT INTO `locales_source` VALUES ('5211','','default','Syslog format','','none'),('5212','','default','Specify the format of the syslog entry. Available variables are: <dl><dt><code>!base_url</code></dt><dd>Base URL of the site.</dd><dt><code>!timestamp</code></dt><dd>Unix timestamp of the log entry.</dd><dt><code>!type</code></dt><dd>The category to which this message belongs.</dd><dt><code>!ip</code></dt><dd>IP address of the user triggering the message.</dd><dt><code>!request_uri</code></dt><dd>The requested URI.</dd><dt><code>!referer</code></dt><dd>HTTP Referer if available.</dd><dt><code>!uid</code></dt><dd>User ID.</dd><dt><code>!link</code></dt><dd>A link to associate with the message.</dd><dt><code>!message</code></dt><dd>The message to store in the log.</dd></dl>','','none'),('5213','','default','External resources can be optimized automatically, which can reduce both the size and number of requests made to your website.','','7.12'),('5214','','default','A date in ''time-since'' format. (%date)','','7.12'),('5215','','default','The location of the file relative to Drupal root.','','7.12'),('5216','','default','HTTP error @errorcode occurred when trying to fetch @remote.','','none'),('5217','','default','Your system or network configuration does not allow Drupal to access web pages, resulting in reduced functionality. This could be due to your webserver configuration or PHP settings, and should be resolved in order to download information about available updates, fetch aggregator feeds, sign in via OpenID, or use other network-dependent services. If you are certain that Drupal can access web pages but you are still seeing this message, you may add <code>$conf[''drupal_http_request_fails''] = FALSE;</code> to the bottom of your settings.php file.','','7.10'),('5218','','default','A translation of %title in %language already exists, a new %type will be created instead of a translation.','','none'),('5219','','default','Your modules have been downloaded and updated.','','none'),('5220','','default','<a href="@update">Run database updates</a>','','none');
INSERT INTO `locales_source` VALUES ('5221','','default','@name <em>(locked)</em>','','7.12'),('5222','','default','Are you sure you want to delete the role %name ?','','none'),('5223','','default','Permissions let you control what users can do and see on your site. You can define a specific set of permissions for each role. (See the <a href="@role">Roles</a> page to create a role). Two important roles to consider are Authenticated Users and Administrators. Any permissions granted to the Authenticated Users role will be given to any user who can log into your site. You can make any role the Administrator role for the site, meaning this will be granted all new permissions automatically. You can do this on the <a href="@settings">User Settings</a> page. You should be careful to ensure that only trusted users are given this access and level of control of your site.','','7.12'),('5224','','default','Roles allow you to fine tune the security and administration of Drupal. A role defines a group of users that have certain privileges as defined on the <a href="@permissions">permissions page</a>. Examples of roles include: anonymous user, authenticated user, moderator, administrator and so on. In this area you will define the names and order of the roles on your site. It is recommended to order your roles from least permissive (anonymous user) to most permissive (administrator). To delete a role choose "edit role".','','7.12'),('5225','','default','Use <em>articles</em> for time-sensitive content like news, press releases or blog posts.','','7.12'),('5226','','default','Filipino','','7.10'),('5227','','default','Swiss German','','7.10'),('5228','','default','Scots','','7.10'),('5229','; modules/file/file.js','default','The selected file %filename cannot be uploaded. Only files with the following extensions are allowed: %extensions.','','none'),('5230','','default','Cache pages for anonymous users','','7.12'),('5231','','default','Bartik','','7.12'),('5232','','default','A flexible, recolorable theme with many regions.','','7.12'),('5233','','default','Highlighted','','7.12');
INSERT INTO `locales_source` VALUES ('5234','','default','Sidebar second','','7.12'),('5235','','default','Triptych first','','7.12'),('5236','','default','Triptych middle','','7.12'),('5237','','default','Triptych last','','7.12'),('5238','','default','Main background','','7.12'),('5239','','default','Sidebar background','','7.12'),('5240','','default','Sidebar borders','','7.12'),('5241','','default','Footer background','','7.12'),('5242','','default','Plum','','7.12'),('5243','','default','!local-task-title!active','','7.12'),('5244','','default','A space-separated list of HTML tags allowed in the content of feed items. Disallowed tags are stripped from the content.','','none'),('5245','','default','%field may only contain characters a-z, underscores, or hyphens.','','none'),('5246','','default','%field cannot contain any markup.','','none'),('5247','','default','No URL aliases available. <a href="@link">Add URL alias</a>.','','7.12'),('5248','','default','Content reindexing','','7.12'),('5249','','default','Cached pages will not be re-created until at least this much time has elapsed.','','7.12'),('5250','','default','Expiration of cached pages','','7.12'),('5251','','default','The maximum time an external cache can use an old version of a page.','','7.12'),('5252','','default','These options control the display settings for the %name theme. When your site is displayed using this theme, these settings will be used.','','7.12'),('5253','','default','Administer software updates','','7.12'),('5254','','default','Enter a valid email address or use a token e-mail address such as %author.','','none'),('5255','','default','@required_name (Missing)','','none'),('5256','','default','@required_name (Version @compatibility required)','','none'),('5257','','default','@name requires at least PHP @version.','','none'),('5258','','default','Unresolved dependency','','none'),('5259','','default','@name requires this module.','','none'),('5260','','default','@name requires this module and version. Currently using @required_name version @version','','none'),('5261','','default','Site details','','7.12');
INSERT INTO `locales_source` VALUES ('5262','','default','Title and slogan','','7.12'),('5263','','default','Firehouse','','7.12'),('5264','','default','Ice','','7.12'),('5265','','default','Can''t handle more than one field storage engine','','none'),('5266','','default','Field storage engine not found.','','none'),('5267','','default','For this query an entity type must be specified.','','none'),('5268','','default','Entity %entity has no base table.','','none'),('5269','','default','Do not know how to order on @key for @entity_type','','none'),('5270','','default','The database table prefix you have entered, %prefix, is invalid. The table prefix can only contain alphanumeric characters, periods, or underscores.','','none'),('5271','','default','Default settings file','','none'),('5272','','default','The default settings file does not exist.','','none'),('5273','','default','The @drupal installer requires that the %default-file file not be modified in any way from the original download.','','none'),('5274','','default','Māori','','7.10'),('5275','','default','Attempt to create an instance of field @field_name without an entity type.','','none'),('5276','','default','Attempt to create an instance of field @field_name on forbidden entity type @entity_type.','','none'),('5277','','default','Attempt to update an instance of a nonexistent field @field.','','none'),('5278','','default','Attempt to update an instance of field @field on bundle @bundle that doesn''t exist.','','none'),('5279','','default','Attempt to purge a field @field_name that still has instances.','','none'),('5280','','default','%name: the value may be no less than %min.','','none'),('5281','','default','%name: the value may be no greater than %max.','','none'),('5282','','default','No fields have been defined yet.','','none'),('5283','','default','Weight for new field','','7.12'),('5284','','default','Weight for added field','','7.12'),('5285','','default','Custom display settings','','7.12'),('5286','','default','Use custom display settings for the following view modes','','7.12'),('5287','','default','The %view_mode mode now uses custom display settings. You might want to <a href="@url">configure them</a>.','','7.10');
INSERT INTO `locales_source` VALUES ('5288','','default','User interface for the Field API.','','7.12'),('5289','','default','Separate extensions with a space or comma and do not include the leading dot.','','7.12'),('5290','','default','Edit an existing effect within a style.','','7.10'),('5291','','default','Delete an existing effect from a style.','','none'),('5292','','default','Node module element','','7.12'),('5293','','default','Close overlay','','7.12'),('5294','','default','Poll module settings','','none'),('5295','','default','Poll vote','','none'),('5296','','default','Poll results','','none'),('5297','','default','The new set name is required.','','none'),('5298','','default','The shortcut set %name already exists. Choose another name.','','none'),('5299','','default','Expected text found in @field of email message: "@expected".','','none'),('5300','','default','1 e-mail was sent during this test.','','none'),('5301','','default','@count e-mails were sent during this test.','','none'),('5302','','default','Blocked IP addresses','','none'),('5303','','default','IP addresses listed here are blocked from your site. Blocked addresses are completely forbidden from accessing the site and instead see a brief message explaining the situation.','','none'),('5304','','default','The content type %rowtype had uploads disabled but contained uploaded file data. Uploads have been re-enabled to migrate the existing data. You may delete the "File attachments" field in the %rowtype type if this data is not necessary.','','none'),('5305','','default','Upload module has been migrated to File module.','','none'),('5306','','default','Available variables are: [site:name], [site:url], [user:name], [user:mail], [site:login-url], [site:url-brief], [user:edit-url], [user:one-time-login-url], [user:cancel-url].','','7.12'),('5307','','default','not yet assigned','','none'),('5308','','default','not yet created','','none'),('5309','','default','[user:name],\n\nThank you for registering at [site:name]. You may now log in by clicking this link or copying and pasting it to your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password.\n\nAfter setting your password, you will be able to log in at [site:login-url] in the future using:\n\nusername: [user:name]\npassword: Your password\n\n--  [site:name] team','','7.10');
INSERT INTO `locales_source` VALUES ('5310','','default','[user:name],\n\nA site administrator at [site:name] has created an account for you. You may now log in by clicking this link or copying and pasting it to your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password.\n\nAfter setting your password, you will be able to log in at [site:login-url] in the future using:\n\nusername: [user:name]\npassword: Your password\n\n--  [site:name] team','','7.10'),('5311','','default','[user:name],\n\nA request to reset the password for your account has been made at [site:name].\n\nYou may now log in by clicking this link or copying and pasting it to your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password. It expires after one day and nothing will happen if it''s not used.\n\n--  [site:name] team','','7.10'),('5312','','default','[user:name],\n\nYour account on [site:name] has been blocked.\n\n--  [site:name] team','','7.10'),('5313','','default','[user:name],\n\nA request to cancel your account has been made at [site:name].\n\nYou may now cancel your account on [site:url-brief] by clicking this link or copying and pasting it into your browser:\n\n[user:cancel-url]\n\nNOTE: The cancellation of your account is not reversible.\n\nThis link expires in one day and nothing will happen if it is not used.\n\n--  [site:name] team','','7.10'),('5314','','default','[user:name],\n\nYour account on [site:name] has been canceled.\n\n--  [site:name] team','','7.10'),('5315','','default','The ability to send users their passwords in plain text has been removed in Drupal 7. Your existing email templates have been modified to remove it. You should <a href="@template-url">review these templates</a> to make sure they read properly.','','none'),('5316','','default','None (original image)','','7.12'),('5317','','default','The URL of the account edit page.','','7.12'),('5318','','default','Nonce from @endpoint rejected because it is not correctly formatted, nonce: @nonce.','','none');
INSERT INTO `locales_source` VALUES ('5319','','default','Nonce received from @endpoint is out of range (time difference: @intervals). Check possible clock skew.','','none'),('5320','','default','Nonce replay attempt blocked from @ip, nonce: @nonce.','','none'),('5321','','default','Comment display','','7.12'),('5322','','default','New field name','','7.12'),('5323','','default','Error opening socket @socket','','none'),('5324','','default','delivery callback not found','','none'),('5325','','default','callback %callback not found: %q.','','none'),('5326','','default','The specified file %file could not be copied, because the destination is invalid. More information is available in the system log.','','none'),('5327','','default','The specified file %file could not be copied, because the destination directory is not properly configured. This may be caused by a problem with file or directory permissions. More information is available in the system log.','','none'),('5328','','default','The file %file could not be copied because a file by that name already exists in the destination directory.','','none'),('5329','','default','The specified file %file could not be moved, because the destination is invalid. More information is available in the system log.','','none'),('5330','','default','The specified file %file could not be deleted, because it is not a valid URI. More information is available in the system log.','','none'),('5331','','default','The data could not be saved, because the destination is invalid. More information is available in the system log.','','none'),('5332','','default','File %file (%realpath) could not be copied, because the destination %destination is invalid. This is often caused by improper use of file_copy() or a missing stream wrapper.','','none'),('5333','','default','File %file (%realpath) could not be copied because it does not exist.','','none'),('5334','','default','File %file could not be copied because a file by that name already exists in the destination directory (%directory)','','none'),('5335','','default','File %file could not be copied because it would overwrite itself.','','none');
INSERT INTO `locales_source` VALUES ('5336','','default','The specified file %file could not be copied to %destination.','','none'),('5337','','default','File %file (%realpath) could not be moved, because the destination %destination is invalid. This may be caused by improper use of file_move() or a missing stream wrapper.','','none'),('5338','','default','File %file (%realpath) could not be deleted because it is not a valid URI. This may be caused by improper use of file_delete() or a missing stream wrapper.','','none'),('5339','','default','The data could not be saved because the destination %destination is invalid. This may be caused by improper use of file_save_data() or a missing stream wrapper.','','none'),('5340','','default','Your PHP configuration only supports a single database type, so it has been automatically selected.','','none'),('5341','','default','Failed to connect to your database server. The server reports the following message: %error.<ul><li>Is the database server running?</li><li>Does the database exist, and have you entered the correct database name?</li><li>Have you entered the correct username and password?</li><li>Have you entered the correct database hostname?</li></ul>','','none'),('5342','','default','The version of PHP you are using has known issues with PostgreSQL. You need to upgrade PHP to 5.2.11, 5.3.1 or greater.','','none'),('5343','','default','Exit block region demonstration','','7.12'),('5344','','default','Customizing the dashboard requires the !permission-name permission.','','7.12'),('5345','','default','To customize the dashboard page, move blocks to the dashboard regions on the <a href="@dashboard">Dashboard administration page</a>, or enable JavaScript on this page to use the drag-and-drop interface.','','7.12'),('5346','','default','Configure available dashboard blocks','','7.12'),('5347','','default','Drag and drop these blocks to the columns below. Changes are automatically saved. More options are available on the <a href="@dashboard-url">configuration page</a>.','','none'),('5348','','default','Configure which blocks can be shown on the dashboard.','','7.12');
INSERT INTO `locales_source` VALUES ('5349','','default','The Database logging module allows you to view an event log on the <a href="@dblog">Recent log messages</a> page. The log is a chronological list of recorded events containing usage data, performance data, errors, warnings and operational information. Administrators should check the log on a regular basis to ensure their site is working properly.','','7.12'),('5350','','default','In case of errors or problems with the site, the <a href="@dblog">Recent log messages</a> page can be useful for debugging, since it shows the sequence of events. The log messages include usage information, warnings, and errors.','','7.12'),('5351','','default','The Database logging module monitors your website, capturing system events in a log (shown here) to be reviewed by an authorized individual at a later time. This log is a list of recorded events containing usage data, performance data, errors, warnings and operational information. It is vital to check the Recent log messages report on a regular basis, as it is often the only way to tell what is going on.','','7.12'),('5352','','default','Database log messages to keep','','none'),('5353','','default','The maximum number of messages to keep in the database log. Requires a <a href="@cron">cron maintenance task</a>.','','none'),('5354','','default','Recent log messages','','7.12'),('5355','','default','Define a string that should be suffixed to the value, like '' m'', '' kb/s''. Leave blank for none. Separate singular and plural values with a pipe (''pound|pounds'').','','none'),('5356','','default','Thousand marker','','none'),('5357','','default','Display prefix and suffix.','','none'),('5358','','default','Display with prefix and suffix.','','none'),('5359','','default','- Select a value -','','7.12'),('5360','','default','Trim length','','7.12'),('5361','','default','No field is displayed.','','7.12'),('5362','','default','No field is hidden.','','7.12'),('5363','','default','Format settings:','','7.12'),('5364','','default','The file used in the !name field may not be referenced.','','none');
INSERT INTO `locales_source` VALUES ('5365','','default','Text formats are presented on content editing pages in the order defined on this page. The first format available to a user will be selected by default.','','7.10'),('5366','','default','Missing text format: %format.','','none'),('5367','','default','Link image to','','7.12'),('5368','','default','Image style: @style','','7.12'),('5369','','default','Linked to content','','7.12'),('5370','','default','Linked to file','','7.12'),('5371','','default','Shown when hovering over the menu link.','','7.12'),('5372','','default','The menu module allows on-the-fly creation of menu links in the content authoring forms. To configure these settings for a particular content type, visit the <a href="@content-types">Content types</a> page, click the <em>edit</em> link for the content type, and go to the <em>Menu settings</em> section.','','none'),('5373','','default','Undefined language (@langcode)','','none'),('5374','','default','Format: %time. The date format is YYYY-MM-DD and %timezone is the time zone offset from UTC. Leave blank to use the time of form submission.','','7.12'),('5375','','default','Administrative overlay','','7.12'),('5376','','default','Use the overlay for administrative pages.','','7.12'),('5377','','default','Show administrative pages on top of the page you started from.','','7.12'),('5378','','default','A <a href="@php-code">PHP code</a> text format has been created.','','none'),('5379','','default','Choose which search modules are active from the available modules.','','none'),('5380','','default','Default search module','','none'),('5381','','default','Choose which search module is the default.','','none'),('5382','','default','Your default search module is not selected as an active module.','','none'),('5383','','default','Search is currently disabled.','','none'),('5384','','default','... !excerpt ... !excerpt ...','','none'),('5385','','default','Syslog identity','','none'),('5386','','default','Optionally, specify a relative URL to display as the front page.  Leave blank to display the default content feed.','','7.12');
INSERT INTO `locales_source` VALUES ('5387','','default','Error pages','','7.12'),('5388','','default','The path ''%path'' is either invalid or you do not have access to it.','','7.12'),('5389','','default','Last run: %cron-last ago.','','7.12'),('5390','','default','Run cron every','','7.12'),('5391','','default','When enabled, only users with the "Use the site in maintenance mode" <a href="@permissions-url">permission</a> are able to access your site to perform maintenance; all other visitors see the maintenance mode message configured below. Authorized users can log in directly via the <a href="@user-login">user login</a> page.','','7.12'),('5392','','default','In order for the site and its modules to continue to operate well, a set of routine administrative operations must run on a regular basis. The System module manages this task by making use of a system cron job. You can verify the status of cron tasks by visiting the <a href="@status">Status report page</a>. For more information, see the online handbook entry for <a href="@handbook">configuring cron jobs</a>. You can set up cron job by visiting <a href="@cron">Cron configuration</a> page','','7.12'),('5393','','default','Change site name, e-mail address, slogan, default front page, and number of posts per page, error pages.','','7.12'),('5394','','default','Manage automatic site maintenance tasks.','','7.12'),('5395','','default','Did not delete temporary file "%path" during garbage collection, because it is in use by the following modules: %modules.','','none'),('5396','','default','Weight for added term','','7.12'),('5397','','default','Subdirectory in the file upload directory where pictures will be stored.','','7.12'),('5398','','default','Pictures larger than this will be scaled down to this size.','','7.12'),('5399','','default','Maximum allowed file size for uploaded pictures. Upload size is normally limited only by the PHP maximum post and file upload settings, and images are automatically scaled down to the dimensions specified above.','','7.12'),('5400','','default','Your virtual face or picture. Pictures larger than @dimensions pixels will be scaled down.','','7.12');
INSERT INTO `locales_source` VALUES ('5401','','default','[user:name],\n\nYour account at [site:name] has been activated.\n\nYou may now log in by clicking this link or copying and pasting it into your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password.\n\nAfter setting your password, you will be able to log in at [site:login-url] in the future using:\n\nusername: [user:name]\npassword: Your password\n\n--  [site:name] team','','7.10'),('5402','','default','Upload an image to go with this article.','','none'),('5403','','default','Minimal profile for running tests. Includes absolutely required modules only.','','none'),('5404','','default','The settings file is writable.','','none'),('5405','','default','The settings file is owned by the web server.','','none'),('5406','','default','The @drupal installer failed to create a settings file with proper file ownership. Log on to your web server, remove the existing %file file, and create a new one by copying the %default_file file to %file. More details about installing Drupal are available in <a href="@install_txt">INSTALL.txt</a>. If you have problems with the file permissions on your server, consult the <a href="@handbook_url">online handbook</a>.','','none'),('5407','','default','Invalid merge query: no conditions','','none'),('5408','','default','Weight for @block block','','7.12'),('5409','','default','Region for @block block','','7.12'),('5410','','default','Comment approval','','7.12'),('5411','','default','Comments from users who have the <em>Skip comment approval</em> permission are published immediately. All other comments are placed in the <a href=''@comment-approval''>Unapproved comments</a> queue, until a user who has permission to <em>Administer comments</em> publishes or deletes them. Published comments can be bulk managed on the <a href=''@admin-comment''>Published comments</a> administration page.','','7.12'),('5412','','default','Post comments','','7.12'),('5413','','default','Skip comment approval','','7.12');
INSERT INTO `locales_source` VALUES ('5414','','default','View and customize your dashboard.','','7.12'),('5415','','default','Customize your dashboard.','','7.12'),('5416','','default','This function can only be used to delete fields without data','','none'),('5417','','default','Are you sure you want to disable the text format %format?','','none'),('5418','','default','Disabled text formats are completely removed from the administrative interface, and any content stored with that format will not be displayed. This action cannot be undone.','','none'),('5419','','default','Disabled text format %format.','','none'),('5420','','default','Text Formats','','7.12'),('5421','','default','Disable text format','','none'),('5422','','default','Hot topic, new comments','','none'),('5423','','default','Hot topic','','none'),('5424','','default','Normal topic','','none'),('5425','','default','Closed topic','','none'),('5426','','default','Reference for usage, configuration, and modules.','','7.12'),('5427','','default','and where %property is %value','','none'),('5428','','default','where %property is %value','','7.12'),('5429','','default','and where','','7.12'),('5430','','default','The RDF module enriches your content with metadata to let other applications (e.g., search engines, aggregators, and so on) better understand its relationships and attributes. This semantically enriched, machine-readable output for Drupal sites uses the <a href="@rdfa">RDFa specification</a> which allows RDF data to be embedded in HTML markup. Other modules can define mappings of their data to RDF terms, and the RDF module makes this RDF data available to the theme. The core Drupal modules define RDF mappings for their data model, and the core Drupal themes output this RDF metadata information along with the human-readable visual information. For more information, see the online handbook entry for <a href="@rdf">RDF module</a>.','','7.12'),('5431','','default','Current URL is @url.','','none'),('5432','','default','Page title @actual is equal to @expected.','','none'),('5433','','default','Page title @actual is not equal to @unexpected.','','none');
INSERT INTO `locales_source` VALUES ('5434','','default','HTTP response not expected !code, actual !curl_code','','none'),('5435','','default','Configure @module permissions','','7.10'),('5436','','default','Select and configure your themes.','','7.12'),('5437','','default','Administer settings.','','7.12'),('5438','','default','View reports, updates, and errors.','','7.12'),('5439','','default','Stores temporary data for system_update_7061.','','none'),('5440','','default','Administrative toolbar','','7.12'),('5441','','default','Install new module or theme','','7.12'),('5442','','default','Install new module','','7.12'),('5443','','default','Install new theme','','7.12'),('5444','','default','%property is %value','','7.12'),('5445','','default','Manage user accounts, roles, and permissions.','','7.12'),('5446','','default','Renamed the ''post comments without approval'' permission to ''skip comment approval''.','','none'),('5447','','default','Nothing','','7.12'),('5448','','default','Lolspeak','','7.10'),('5449','','default','%type: !message in %function (line %line of %file).','','7.12'),('5450','','default','Update @title','','7.12'),('5451','','default','A unique machine-readable name. Can only contain lowercase letters, numbers, and underscores.','','7.12'),('5452','','default','The machine-readable name must contain unique characters.','','none'),('5453','','default','The machine-readable name must contain only lowercase letters, numbers, and hyphens.','','none'),('5454','','default','The machine-readable name is already in use. It must be unique.','','none'),('5455','','default','Asturian','','7.10'),('5456','','default','English, British','','7.10'),('5457','','default','Haitian Creole','','7.10'),('5458','','default','Portuguese, International','','7.10'),('5459','','default','Weight for @title','','7.12'),('5460','','default','Weight for row @number','','7.12'),('5461','','default','Parent for @title','','7.12'),('5462','','default','New field label','','7.12'),('5463','','default','Parent for new field','','7.12');
INSERT INTO `locales_source` VALUES ('5464','','default','Type of new field','','7.12'),('5465','','default','Widget for new field','','7.12'),('5466','','default','Existing field label','','7.12'),('5467','','default','Parent for existing field','','7.12'),('5468','','default','Existing field to share','','7.12'),('5469','','default','Widget for existing field','','7.12'),('5470','','default','Label display for @title','','7.12'),('5471','','default','Formatter for @title','','7.12'),('5472','','default','Parents for @title','','7.12'),('5473','','default','Visibility for @title','','7.12'),('5474','','default','There is data for this field in the database. The field settings can no longer be changed.','','7.12'),('5475','','default','Weight for new file','','7.12'),('5476','','default','Choose a file','','7.12'),('5477','','default','Weight for new effect','','7.10'),('5478','','default','@title language provider','','7.10'),('5479','','default','Enable @title menu link','','7.12'),('5480','','default','A unique name to construct the URL for the menu. It must only contain lowercase letters, numbers and hyphens.','','7.12'),('5481','','default','A unique machine-readable name for this content type. It must only contain lowercase letters, numbers, and underscores. This name will be used for constructing the URL of the %node-add page, in which underscores will be converted into hyphens.','','7.12'),('5482','','default','Choice label','','none'),('5483','','default','New choice label','','none'),('5484','','default','Vote count for choice @label','','none'),('5485','','default','Vote count for new choice','','none'),('5486','','default','Weight for choice @label','','none'),('5487','','default','Weight for new choice','','none'),('5488','','default','Category for @title','','none'),('5489','','default','Active modules','','none'),('5490','','default','@original_title (@parent_title)','','none'),('5491','','default','Your PHP installation is too old. Drupal requires at least PHP 5.2.5, or PHP @version with the htmlspecialchars security patch backported.','','none'),('5492','','default','Your web server does not appear to support PDO (PHP Data Objects). Ask your hosting provider if they support the native PDO extension. See the <a href="@link">system requirements</a> page for more information.','','none');
INSERT INTO `locales_source` VALUES ('5493','','default','Your web server seems to have the wrong version of PDO installed. Drupal 7 requires the PDO extension from PHP core. This system has the older PECL version. See the <a href="@link">system requirements</a> page for more information.','','none'),('5494','','default','List of trigger actions when !description','','none'),('5495','','default','The database version %version is less than the minimum required version %minimum_version.','','none'),('5496','','default','!theme (default theme)','','7.12'),('5497','','default','!theme (administration theme)','','7.12'),('5498','','default','The Dashboard module provides a <a href="@dashboard">Dashboard page</a> in the administrative interface for organizing administrative tasks and navigation, and tracking information within your site. The Dashboard page contains blocks, which you can add to and arrange using the drag-and-drop interface that appears when you click on the <em>Customize dashboard</em> link. Within this interface, blocks that are not primarily used for site administration do not appear by default, but can be added via the <em>Add other blocks</em> link. For more information, see the online handbook entry for <a href="@handbook">Dashboard module</a>.','','7.12'),('5499','','default','Rearrange blocks for display on the <a href="@dashboard-url">Dashboard page</a>. Blocks placed in the <em>Dashboard (inactive)</em> region are not displayed when viewing the Dashboard page, but are available within its <em>Customize dashboard</em> interface. Removing a block from active dashboard display makes it available on the main <a href="@blocks-url">blocks administration page</a>.','','none'),('5500','','default','Add other blocks','','none'),('5501','','default','URL fallback','','7.12'),('5502','','default','Use an already detected language for URLs if none is found.','','7.12'),('5503','','default','%type_name: Create new content','','7.12'),('5504','','default','%type_name: Edit own content','','7.12'),('5505','','default','%type_name: Edit any content','','7.12');
INSERT INTO `locales_source` VALUES ('5506','','default','%type_name: Delete own content','','7.12'),('5507','','default','%type_name: Delete any content','','7.12'),('5508','','default','If you have problems accessing administrative pages on this site, disable the overlay on your profile page.','','7.12'),('5509','','default','Dismiss this message.','','7.12'),('5510','','default','Options for the administrative overlay','','7.12'),('5511','','default','Next steps','','none'),('5512','','default','File %file could not be copied, because the destination directory %destination is not configured correctly.','','none'),('5513','','default','@driver_name settings','','none'),('5514','','default','MySQL, MariaDB, or equivalent','','none'),('5515','','default','SQLite','','none'),('5516','','default','Database file','','none'),('5517','','default','The absolute path to the file where @drupal data will be stored. This must be writable by the web server and should exist outside of the web root.','','none'),('5518','','default','The directory you specified is not writable by the web server.','','none'),('5519','; misc/autocomplete.js','default','Autocomplete popup','','none'),('5520','; misc/autocomplete.js','default','Searching for matches...','','none'),('5521','','default','The Field module allows custom data fields to be defined for <em>entity</em> types (entities include content items, comments, user accounts, and taxonomy terms). The Field module takes care of storing, loading, editing, and rendering field data. Most users will not interact with the Field module directly, but will instead use the <a href="@field-ui-help">Field UI module</a> user interface. Module developers can use the Field API to make new entity types "fieldable" and thus allow fields to be attached to them. For more information, see the online handbook entry for <a href="@field">Field module</a>.','','7.12'),('5522','','default','No fields are present yet.','','7.12'),('5523','','default','Strong','Font weight','7.12'),('5524','','default','Read more<span class="element-invisible"> about @title</span>','','7.12');
INSERT INTO `locales_source` VALUES ('5525','','default','Optionally specify an alternative URL by which this content can be accessed. For example, type "about" when writing an about page. Use a relative path and don''t add a trailing slash or the URL alias won''t work.','','7.12'),('5526','','default','The number of votes that have been cast on a poll.','','none'),('5527','','default','The length of time the poll is set to run.','','none'),('5528','','default','Uninstall @module module','','7.12'),('5529','','default','Aggregate and compress CSS files.','','7.12'),('5530','','default','Aggregate JavaScript files.','','7.12'),('5531','','default','To uninstall @module, the following module must be uninstalled first: @required_modules','','7.12'),('5532','','default','To uninstall @module, the following modules must be uninstalled first: @required_modules','','7.12'),('5533','','default','Enable newly added modules','','none'),('5534','','default','Enable newly added themes','','none'),('5535','','default','The uninstall process removes all data related to a module. To uninstall a module, you must first disable it on the main <a href="@modules">Modules page</a>.','','7.12'),('5536','','default','View the administration theme','','7.12'),('5537','','default','Database system','','7.12'),('5538','','default','Database system version','','7.12'),('5539','','default','Indexed %count content items for tracking.','','none'),('5540','','default','Release notes for @project_title','','7.12'),('5541','','default','The role settings have been updated.','','none'),('5542','','default','Disable the account and keep its content.','','7.12'),('5543','','default','Disable the account and unpublish its content.','','7.12'),('5544','','default','Delete the account and make its content belong to the %anonymous-name user.','','7.12'),('5545','','default','Delete the account and its content.','','7.12'),('5546','','default','Display on user registration form.','','7.12'),('5547','','default','This is compulsory for ''required'' fields.','','7.12'),('5548','','default','Drupal system listing compatible test','','none');
INSERT INTO `locales_source` VALUES ('5549','','default','Support module for testing the drupal_system_listing function.','','none'),('5550','','default','Drupal system listing incompatible test','','none'),('5551','','default','@count orphaned actions (%orphans) exist in the actions table. !link','','none'),('5552','','default','Deleted 1 comment.','','none'),('5553','','default','Use field label instead of the "On value" as label','','7.12'),('5554','','default','Deleted 1 post.','','7.12'),('5555','','default','tracker','','7.12'),('5556','','default','Automatic updating of Drupal core is not supported. See the <a href="@upgrade-guide">upgrade guide</a> for information on how to update Drupal core manually.','','none'),('5557','','default','%archive_file contains a version of %names that is not compatible with Drupal !version.','','none'),('5558','','default','%archive_file contains versions of modules or themes that are not compatible with Drupal !version: %names','','none'),('5559','','default','The %setting setting is currently set to ''%current_value'', but needs to be ''%needed_value''. Change this by running the following query: !query','','none'),('5560','','default','List (integer)','','7.12'),('5561','','default','This field stores integer values from a list of allowed ''value => label'' pairs, i.e. ''Lifetime in days'': 1 => 1 day, 7 => 1 week, 31 => 1 month.','','7.12'),('5562','','default','List (float)','','7.12'),('5563','','default','This field stores float values from a list of allowed ''value => label'' pairs, i.e. ''Fraction'': 0 => 0, .25 => 1/4, .75 => 3/4, 1 => 1.','','7.12'),('5564','','default','This field stores text values from a list of allowed ''value => label'' pairs, i.e. ''US States'': IL => Illinois, IA => Iowa, IN => Indiana.','','7.12'),('5565','','default','The possible values this field can contain. Enter one value per line, in the format key|label.','','7.12'),('5566','','default','The key is the stored value, and must be numeric. The label will be used in displayed values and edit forms.','','7.12'),('5567','','default','The label is optional: if a line contains a single number, it will be used as key and label.','','7.12');
INSERT INTO `locales_source` VALUES ('5568','','default','Lists of labels are also accepted (one label per line), only if the field does not hold any values yet. Numeric keys will be automatically generated from the positions in the list.','','7.12'),('5569','','default','The key is the stored value. The label will be used in displayed values and edit forms.','','7.12'),('5570','','default','The label is optional: if a line contains a single string, it will be used as key and label.','','7.12'),('5571','','default','Allowed values list: invalid input.','','none'),('5572','','default','Allowed values list: some values are being removed while currently in use.','','none'),('5573','','default','Cannot update a list field to not include keys with existing data.','','none'),('5574','','default','Unable to parse info file: %info_file.','','none'),('5575','','default','The info file (%info_file) does not define a ''name'' attribute.','','none'),('5576','','default','The testing framework requires the PHP memory limit to be at least %memory_minimum_limit. The current value is %memory_limit. <a href="@url">Follow these steps to continue</a>.','','none'),('5577','','default','You can find <a href="@module_url">modules</a> and <a href="@theme_url">themes</a> on <a href="@drupal_org_url">drupal.org</a>. The following file extensions are supported: %extensions.','','7.12'),('5578','','default','Your server does not support updating modules and themes from this interface. Instead, update modules and themes by uploading the new versions directly to the server, as described in the <a href="@handbook_url">handbook</a>.','','none'),('5579','','default','Your server does not support installing modules and themes from this interface. Instead, install modules and themes by uploading them directly to the server, as described in the <a href="@handbook_url">handbook</a>.','','none'),('5580','','default','Installing modules and themes requires <strong>@backends access</strong> to your server. See the <a href="@handbook_url">handbook</a> for other installation methods.','','7.12');
INSERT INTO `locales_source` VALUES ('5581','','default','Installing modules and themes requires access to your server via one of the following methods: <strong>@backends</strong>. See the <a href="@handbook_url">handbook</a> for other installation methods.','','none'),('5582','','default','%archive_file does not contain any .info files.','','none'),('5583','','default','Administer content and comments.','','7.12'),('5584','','default','Comment fields','','7.12'),('5585','','default','%name must be a valid hexadecimal CSS color value.','','none'),('5586','','default','Cannot rename field %id (%old_field_name) to %new_field_name because it does not use the field_sql_storage storage type.','','none'),('5587','','default','Changes to the style have been saved.','','7.10'),('5588','','default','This block is only shown if <a href="@languages">at least two languages are enabled</a> and <a href="@configuration">language negotiation</a> is set to <em>URL</em> or <em>Session</em>.','','none'),('5589','','default','(Machine name: @type)','','7.12'),('5590','','default','Not optimized','','none'),('5591','','default','OpenID suggests the use of the GMP Math library for PHP for optimal performance. Check the <a href="@url">GMP Math Library documentation</a> for installation instructions.','','none'),('5592','','default','OpenID Math library','','none'),('5593','','default','The @module module is missing, so the following module will be disabled: @depends.','','none'),('5594','','default','The @module module is missing, so the following modules will be disabled: @depends.','','none'),('5595','','default','The machine-readable name cannot be "add" or "list".','','none'),('5596','','default','Enable multilingual support for this content type. If enabled, a language selection field will be added to the editing form, allowing you to select from one of the <a href="!languages">enabled languages</a>. You can also turn on translation for this content type, which lets you have content translated to any of the installed languages. If disabled, new posts are saved with the default language. Existing content will not be affected by changing this option.','','none');
