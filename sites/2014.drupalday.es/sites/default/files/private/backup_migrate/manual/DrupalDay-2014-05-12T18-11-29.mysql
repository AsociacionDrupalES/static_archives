INSERT INTO `locales_source` VALUES ('9973','','default','Context menu','','7.12'),('9974','','default','Left-to-right','','7.12'),('9975','','default','Right-to-left','','7.12'),('9976','','default','Emotions','','7.12'),('9977','','default','HTML block format','','7.12'),('9978','','default','Font size','','7.12'),('9979','','default','Font style','','7.12'),('9980','','default','Fullscreen','','7.12'),('9981','','default','Inline popups','','7.12'),('9982','','default','Insert date','','7.12'),('9983','','default','Insert time','','7.12'),('9984','','default','Insert layer','','7.12'),('9985','','default','Move forward','','7.12'),('9986','','default','Move backward','','7.12'),('9987','','default','Absolute','','7.12'),('9988','','default','Paste text','','7.12'),('9989','','default','Paste from Word','','7.12'),('9990','','default','Replace','','7.12'),('9991','','default','Style properties','','7.12'),('9992','','default','Citation','','7.12'),('9993','','default','HTML attributes','','7.12'),('9994','','default','BBCode','','7.12'),('9995','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','Auto resize','','7.12'),('9996','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','Advanced list','','7.12'),('9997','','default','Word count','','7.12'),('9998','','default','Teaser break','','7.12'),('9999','','default','Separate the teaser and body of this content','','7.12'),('10000','','default','Editor appearance','','7.10'),('10001','','default','Toolbar location','','7.10'),('10002','','default','This option controls whether the editor toolbar is displayed above or below the editing area.','','7.10');
INSERT INTO `locales_source` VALUES ('10003','','default','Button alignment','','7.10'),('10004','','default','This option controls the alignment of icons in the editor toolbar.','','7.10'),('10005','','default','Path location','','7.10'),('10006','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','Where to display the path to HTML elements (i.e. <code>body > table > tr > td</code>).','','7.10'),('10007','','default','Enable resizing button','','7.10'),('10008','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','This option gives you the ability to enable/disable the resizing button. If enabled, the Path location toolbar must be set to "Top" or "Bottom" in order to display the resize icon.','','7.10'),('10009','','default','Cleanup and output','','7.10'),('10010','','default','Verify HTML','','7.10'),('10011','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','If enabled, potentially malicious code like <code>&lt;HEAD&gt;</code> tags will be removed from HTML contents.','','7.10'),('10012','','default','If enabled, the editor will insert TAB characters on tab and preserve other whitespace characters just like a PRE element in HTML does.','','7.10'),('10013','','default','Convert &lt;font&gt; tags to styles','','7.10'),('10014','','default','If enabled, HTML tags declaring the font size, font family, font color and font background color will be replaced by inline CSS styles.','','7.10'),('10015','','default','Remove linebreaks','','7.10'),('10016','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','If enabled, the editor will remove most linebreaks from contents. Disabling this option could avoid conflicts with other input filters.','','7.10'),('10017','','default','Apply source formatting','','7.10'),('10018','','default','If enabled, the editor will re-format the HTML source code. Disabling this option could avoid conflicts with other input filters.','','7.10'),('10019','','default','Force cleanup on standard paste','','7.10'),('10020','','default','If enabled, the default paste function (CTRL-V or SHIFT-INS) behaves like the "paste from word" plugin function.','','7.10');
INSERT INTO `locales_source` VALUES ('10021','','default','CSS','','7.10'),('10022','','default','Block formats','','7.10'),('10023','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','Comma separated list of HTML block formats. Possible values: <code>@format-list</code>.','','7.10'),('10024','','default','Editor CSS','','7.10'),('10025','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','Use theme CSS','','7.10'),('10026','','default','Define CSS','','7.10'),('10027','','default','Editor default CSS','','7.10'),('10028','','default','Defines the CSS to be used in the editor area.<br />Use theme CSS - loads stylesheets from current site theme.<br/>Define CSS - enter path for stylesheet files below.<br />Editor default CSS - uses default stylesheets from editor.','','7.10'),('10029','','default','CSS path','','7.10'),('10030','','default','If "Define CSS" was selected above, enter path to a CSS file or a list of CSS files separated by a comma.','','7.10'),('10031','','default','Available tokens: <code>%b</code> (base path, eg: <code>/</code>), <code>%t</code> (path to theme, eg: <code>themes/garland</code>)','','7.10'),('10032','','default','Example:','','7.10'),('10033','','default','CSS classes','','7.10'),('10034','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','Optionally define CSS classes for the "Font style" dropdown list.<br />Enter one class on each line in the format: !format. Example: !example<br />If left blank, CSS classes are automatically imported from all loaded stylesheet(s).','','7.10'),('10035','','default','Wysiwyg profile for %format has been saved.','','7.10'),('10036','/admin/config/content/formats','default','Text formats define the HTML tags, code, and other formatting that can be used when entering text. <strong>Improper text format configuration is a security risk</strong>. Learn more on the <a href="@filterhelp">Filter module help page</a>.','','7.10'),('10037','','default','Disable rich-text','','7.12'),('10038','','default','Enable rich-text','','7.12'),('10039','/admin/structure/types/manage/noticia','default','wysiwyg','','7.12');
INSERT INTO `locales_source` VALUES ('10040','/admin/structure/views/view/imagen/edit/block_4','default','Licencia960 first','','7.10'),('10041','/','default','Enlace licencia','','7.12'),('10042','/admin/structure/types/manage/noticia/fields','default','Licencia','','7.12'),('10043','/admin/structure/views/view/noticias/edit','default','Canal de noticias','','7.12'),('10044','/admin/structure/ds/view_modes/manage','default','The human-readable label of the view mode. This name must be unique.','','7.10'),('10045','/admin/structure/ds/view_modes/manage','default','The machine-readable name of this view mode. This name must contain only lowercase letters and underscores. This name must be unique.','','7.10'),('10046','/admin/structure/ds/view_modes/manage','default','Select the entities for which this view mode will be made available.','','7.10'),('10047','/admin/structure/ds/view_modes/manage','default','The view mode %view_mode has been saved','','7.10'),('10048','/admin/structure/ds/extras','default','Full Reset','','7.10'),('10049','/admin/structure/ds/extras','default','Default Field Template','','7.10'),('10050','/admin/structure/ds/extras','default','Default will output the field as defined in Drupal Core.<br />Reset will strip all HTML.<br />Minimal adds a simple wrapper around the field.<br/>There is also an Expert Field Template that gives full control over the HTML, but can only be set per field.<br /><br />You can override this setting per field on the "Manage display" screens or when creating fields on the instance level.<br /><br /><strong>Template suggestions</strong><br />You can create .tpl files as well for these field theme functions, e.g. field--reset.tpl.php, field--minimal.tpl.php<br /><br /><label>Styles</label>You can add custom styles on the <a href="!url">styles form</a>. These styles can be added to fields using the Default Field Template.<br /><br /><label>Advanced</label>You can create your own custom field templates which need to be defined with hook_ds_field_theme_functions_info(). See ds.api.php for an example.','','7.10');
INSERT INTO `locales_source` VALUES ('10051','/admin/structure/ds/extras','default','Hide colon','','7.10'),('10052','/admin/structure/ds/extras','default','Hide the colon on the reset field template.','','7.10'),('10053','/admin/structure/ds/extras','default','Enter fields line by line, where each line is a combination of entity type, bundle and field name. E.g. node|article|tweetbutton. It might be possible that the actual content of the field depends on configuration of that field/module.','','7.10'),('10054','/admin/structure/ds/extras','default','View mode per node','','7.10'),('10055','/admin/structure/ds/extras','default','Change view modes for individual nodes. A new tab ''Display settings'' will appear on the content create form.<br />You can also pass the name of a view mode through the URL, eg node/x?v=full.','','7.10'),('10056','/admin/structure/ds/extras','default','View mode switcher','','7.10'),('10057','','default','Adds a field with links to switch view modes inline with Ajax. Only works for nodes at this time.','','7.10'),('10058','/admin/structure/ds/extras','default','Hide or manually set the page title of the "Full content" view mode.','','7.10'),('10059','/admin/structure/ds/extras','default','Manage the layout of your Views layout with Field UI at !url.','','7.10'),('10060','/admin/structure/views/ajax/add-item/noticias/block/field','default','Body Teaser','','7.12'),('10061','/admin/structure/views/ajax/add-item/noticias/block/field','default','Tittulo Teaser','','7.10'),('10062','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Default view mode','','7.12'),('10063','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Select the default view mode for this view.','','7.12'),('10064','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Load comments for every node to display.','','7.12'),('10065','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Alternating view mode','','7.12'),('10066','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Use the changing view mode selector','','7.12');
INSERT INTO `locales_source` VALUES ('10067','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Use this configuration on every page. Otherwhise the default view mode is used as soon you browse away from the first page of this view.','','7.12'),('10068','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Item @nr','','7.12'),('10069','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Group data on a field. The value of this field will be displayed too.','','7.12'),('10070','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','The value of the field can be in a very raw format (eg, date created). Enter a custom function which you can use to format that value. The value and the object will be passed into that function eg. <em>custom_function($raw_value, $object);</em>','','7.12'),('10071','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Advanced view mode','','7.12'),('10072','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','Use the advanced view mode selector','','7.12'),('10073','/admin/structure/views/ajax/display/noticias/block/row_plugin','default','This gives you the opportunity to have full control of a list for really advanced features.<br /> There is no UI for this, you need to create a function named like this: <strong><em>ds_views_row_adv_@VIEWSNAME($entity, $view_mode, $load_comments)</em></strong>.<br />See <a href="http://drupal.org/node/697320#ds_views_row_adv_VIEWSNAME">http://drupal.org/node/697320#ds_views_row_adv_VIEWSNAME</a> for an example.','','7.12'),('10074','/admin/structure/types/manage/noticia/display','default','noticia teaser','','7.12'),('10075','/admin/structure/ds/extras','default','Display suite Views','','7.12'),('10076','/admin/structure/ds/vd','default','Bundle @label has been added.','','7.10'),('10077','/admin/structure/ds/vd/manage/noticias-block/display','default','Views content','','7.10'),('10078','/admin/structure/ds/vd/manage/noticias-block/remove','default','Are you sure you want to remove bundle @label ?','','7.10');
