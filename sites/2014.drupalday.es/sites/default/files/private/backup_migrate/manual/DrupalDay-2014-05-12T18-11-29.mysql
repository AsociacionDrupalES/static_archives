INSERT INTO `locales_source` VALUES ('8609','/index.php','default','Create fields and instances. Returns urls for field editing.','','7.12'),('8610','/index.php','default','Content type (for nodes). Name of bundle to attach fields to. Required.','','7.12'),('8611','/index.php','default','Comma delimited triple in the form: field_name,field_type,widget_name. If widget_name is omitted, the default widget will be used. Separate multiple fields by space. If omitted, a wizard will prompt you.','','7.12'),('8612','/index.php','default','Type of entity (e.g. node, user, comment). Defaults to node.','','7.12'),('8613','/index.php','default','Define new article fields via interactive prompts.','','7.12'),('8614','/index.php','default','Define new article fields and then open field edit form for refinement.','','7.12'),('8615','/index.php','default','Create two new fields.','','7.12'),('8616','/index.php','default','Return URL for field editing web page.','','7.12'),('8617','/index.php','default','Name of field that needs updating.','','7.12'),('8618','/index.php','default','Quickly navigate to a field edit web page.','','7.12'),('8619','/index.php','default','Delete a field and its instances.','','7.12'),('8620','/index.php','default','Name of field to delete.','','7.12'),('8621','/index.php','default','Only delete the instance attached to this bundle. If omitted, admin can choose to delete one instance or whole field.','','7.12'),('8622','/index.php','default','Disambiguate a particular bundle from identically named bundles. Usually not needed.','','7.12'),('8623','/index.php','default','Delete the city field and any instances it might have.','','7.12'),('8624','/index.php','default','Delete the city instance on the article bundle','','7.12'),('8625','/index.php','default','Clone a field and all its instances.','','7.12'),('8626','/index.php','default','Name of field that will be cloned','','7.12'),('8627','/index.php','default','Name of new, cloned field.','','7.12'),('8628','/index.php','default','Copy ''tags'' field into a new field ''labels'' field which has same instances.','','7.12');
INSERT INTO `locales_source` VALUES ('8629','/index.php','default','Clone field and then open field edit forms for refinement.','','7.12'),('8630','/index.php','default','View information about fields, field_types, and widgets.','','7.12'),('8631','/index.php','default','Recognized values: fields, types. If omitted, a choice list appears.','','7.12'),('8632','/index.php','default','Return field information table as CSV.','','7.12'),('8633','/index.php','default','Show a table which lists all field types and their available widgets','','7.12'),('8634','/index.php','default','Flush all derived images for a given style.','','7.12'),('8635','/index.php','default','An image style machine name. If not provided, user may choose from a list of names.','','7.12'),('8636','/index.php','default','Flush all derived images','','7.12'),('8637','/index.php','default','Pick an image style and then delete its images.','','7.12'),('8638','/index.php','default','Delete all thumbnail images.','','7.12'),('8639','/index.php','default','Flush all derived images. They will be regenerated on the fly.','','7.12'),('8640','/index.php','default','Refresh available information.','','7.12'),('8641','/index.php','default','Show translation status of available projects.','','7.12'),('8642','/index.php','default','Comma separated list of languages. Defaults to all available languages.','','7.12'),('8643','/index.php','default','Update translations.','','7.12'),('8644','/index.php','default','Allowed values: overwrite, keep. Default value: keep.','','7.12'),('8645','/index.php','default','Display releasenotes in HTML rather than plain text.','','7.12'),('8646','/index.php','default','Enable one or more extensions (modules or themes).','','7.12'),('8647','/index.php','default','A list of modules or themes. You can use the * wildcard at the end of extension names to enable all matches.','','7.12'),('8648','/index.php','default','Disable one or more extensions (modules or themes).','','7.12'),('8649','/index.php','default','A list of modules or themes. You can use the * wildcard at the end of extension names to disable multiple matches.','','7.12');
INSERT INTO `locales_source` VALUES ('8650','/index.php','default','Show detailed info for one or more extensions (modules or themes).','','7.12'),('8651','/index.php','default','A list of modules or themes. You can use the * wildcard at the end of extension names to show info for multiple matches. If no argument is provided it will show info for all available extensions.','','7.12'),('8652','/index.php','default','Uninstall one or more modules.','','7.12'),('8653','/index.php','default','A list of modules.','','7.12'),('8654','/index.php','default','Show a list of available extensions (modules and themes).','','7.12'),('8655','/index.php','default','Filter by extension type. Choices: module, theme.','','7.12'),('8656','/index.php','default','Filter by extension status. Choices: enabled, disable and/or ''not installed''. You can use multiple comma separated values. (i.e. --status="disabled,not installed").','','7.10'),('8657','/index.php','default','Filter by project packages. You can use multiple comma separated values. (i.e. --package="Core - required,Other").','','7.12'),('8658','/index.php','default','Filter out extensions that are not in drupal core.','','7.12'),('8659','/index.php','default','Filter out extensions that are provided by drupal core.','','7.12'),('8660','/index.php','default','Returns a space delimited list of the names of the resulting extensions.','','7.10'),('8661','/index.php','default','Refresh update status information.','','7.12'),('8662','/index.php','default','Update Drupal core and contrib projects to latest recommended releases.','','7.12'),('8663','/index.php','default','Optional. A list of installed projects to update.','','7.12'),('8664','/index.php','default','Returns a space delimited list of projects with any of its extensions enabled and their respective version and update information, one project per line. Order: project name, current version, recommended version, update status.','','7.10'),('8665','/index.php','default','Show release notes for each project to be updated.','','7.12'),('8666','/index.php','default','Only update modules and skip the core update.','','7.12');
INSERT INTO `locales_source` VALUES ('8667','/index.php','default','Only update modules that have security updates available. However, if there were other releases of a module between the installed version the security update, other changes to features or functionality may occur.','','7.12'),('8668','/index.php','default','Add a persistent lock to remove the specified projects from consideration during updates.  Locks may be removed with the --unlock parameter, or overridden by specifically naming the project as a parameter to pm-update or pm-updatecode.  The lock does not affect pm-download.  See also the update-advanced project for similar and improved functionality.','','7.12'),('8669','/index.php','default','Integration with VCS in order to easily commit your changes to projects.','','7.10'),('8670','/index.php','default','Determine how to download/checkout new projects and acquire updates to projects.','','7.10'),('8671','/index.php','default','Update Drupal core and contrib projects and apply any pending database updates (Same as pm-updatecode + updatedb).','','7.12'),('8672','/index.php','default','Notify of pending db updates.','','7.12'),('8673','/index.php','default','Print release notes for given projects.','','7.12'),('8674','/index.php','default','A list of drupal.org project names, with optional version. Defaults to ''drupal''','','7.10'),('8675','/index.php','default','Prints the release notes for the recommended version of CCK project.','','7.12'),('8676','/index.php','default','View release notes of a specfic version of the Token project for my version of Drupal.','','7.12'),('8677','/index.php','default','View release notes for the recommended version of Pathauto and Zen projects.','','7.12'),('8678','/index.php','default','Print release information for given projects.','','7.12'),('8679','/index.php','default','A list of drupal.org project names. Defaults to ''drupal''','','7.12'),('8680','/index.php','default','Show only development releases.','','7.10'),('8681','/index.php','default','Shows all available releases instead of the default short list of recent releases.','','7.10');
INSERT INTO `locales_source` VALUES ('8682','/index.php','default','View releases for cck and Zen projects for your Drupal version.','','7.12'),('8683','/index.php','default','Download projects from drupal.org or other sources.','','7.12'),('8684','/index.php','default','A comma delimited list of drupal.org project names, with optional version. Defaults to ''drupal''','','7.12'),('8685','/index.php','default','Path to which the project will be copied. If you''re providing a relative path, note it is relative to the drupal root (if bootstrapped).','','7.12'),('8686','/index.php','default','Force to use the site specific directory. It will create the directory if it doesn''t exist. If --destination is also present this option will be ignored.','','7.12'),('8687','/index.php','default','The base URL which provides project release history in XML. Defaults to http://updates.drupal.org/release-history.','','7.12'),('8688','/index.php','default','Show release notes after each project is downloaded.','','7.12'),('8689','/index.php','default','Only useful for install profiles. Possible values: ''full'', ''projects'', ''profile-only''.','','7.12'),('8690','/index.php','default','Download a development release.','','7.10'),('8691','/index.php','default','Select the version to download interactively from a list of available releases.','','7.12'),('8692','/index.php','default','Useful only with --select; shows all available releases instead of a short list of recent releases.','','7.10'),('8693','/index.php','default','Alternate name for "drupal-x.y" directory when downloading Drupal project. Defaults to "drupal".','','7.12'),('8694','/index.php','default','Specify the default major version of modules to download when there is no bootstrapped Drupal site.  Defaults to "7".','','7.12'),('8695','/index.php','default','Returns a list of the names of the extensions (modules and themes) contained in the downloaded projects.','','7.12'),('8696','/index.php','default','Download latest recommended release of Drupal core.','','7.12'),('8697','/index.php','default','Same as `drush dl`.','','7.10');
INSERT INTO `locales_source` VALUES ('8698','/index.php','default','Download latest 7.x development version of Drupal core.','','7.12'),('8699','/index.php','default','Download latest recommended release of Drupal 6.x.','','7.12'),('8700','/index.php','default','Download latest versions of CCK and Zen projects.','','7.12'),('8701','/index.php','default','Download a specfic version of Organic groups module for my version of Drupal.','','7.12'),('8702','/index.php','default','Download a specific development branch of diff module for a specific Drupal version.','','7.12'),('8703','/index.php','default','Show a list of recent releases of the views project, prompt for which one to download.','','7.12'),('8704','/index.php','default','Download the latest dev release of webform.','','7.12'),('8705','/index.php','default','Print site alias records for all known site aliases and local sites.','','7.12'),('8706','/index.php','default','Site specification alias to print','','7.10'),('8707','/index.php','default','Print the full alias record for each site.  Default when aliases are specified on the command line.','','7.12'),('8708','/index.php','default','Print only the specified element from the full alias record.','','7.12'),('8709','/index.php','default','Print only the site alias name.  Default when not command line arguments are specified.','','7.10'),('8710','/index.php','default','Print the long-form site specification for each site.','','7.12'),('8711','/index.php','default','Include the databases structure in the full alias record.','','7.12'),('8712','/index.php','default','Include the short-form db-url in the full alias record.','','7.12'),('8713','/index.php','default','Do not include the database record in the full alias record (default).','','7.12'),('8714','/index.php','default','Include optional default items.','','7.12'),('8715','/index.php','default','List all alias records known to drush.','','7.12'),('8716','/index.php','default','Print an alias record for the alias ''dev''.','','7.12'),('8717','/index.php','default','Drop all tables in a given database.','','7.12');
INSERT INTO `locales_source` VALUES ('8718','/index.php','default','Skip confirmation and proceed.','','7.12'),('8719','/index.php','default','Save to a file. The file should be relative to Drupal root. Recommended.','','7.12'),('8720','/index.php','default','The DB connection key if using multiple connections in settings.php.','','7.12'),('8721','/index.php','default','The name of a target within the specified database.','','7.12'),('8722','/index.php','default','Print database connection details using print_r().','','7.12'),('8723','/index.php','default','Show all database connections, instead of just one.','','7.12'),('8724','/index.php','default','A string for connecting to the DB.','','7.12'),('8725','/index.php','default','Import sql statements from a file into the current database.','','7.12'),('8726','/index.php','default','Exports the Drupal DB as SQL using mysqldump or equivalent.','','7.12'),('8727','/index.php','default','Save to a file. The file should be relative to Drupal root. If --result-file is provided with no value, then date based filename will be created under ~/drush-backups directory.','','7.12'),('8728','/index.php','default','A key in the $skip_tables array. @see example.drushrc.php. Optional.','','7.12'),('8729','/index.php','default','A key in the $structure_tables array. @see example.drushrc.php. Optional.','','7.12'),('8730','/index.php','default','A key in the $tables array. Optional.','','7.12'),('8731','/index.php','default','A comma-separated list of tables to transfer. Optional.','','7.12'),('8732','/index.php','default','Order by primary key and add line breaks for efficient diff in revision control. Also, faster rsync. Slows down the dump. Mysql only.','','7.12'),('8733','/index.php','default','Wipe existing tables.','','7.10'),('8734','/index.php','default','Omit CREATE TABLE statements. Postgres only.','','7.10'),('8735','/index.php','default','Compress the dump using the gzip program which must be in your $PATH.','','7.12'),('8736','/index.php','default','Save SQL dump to the directory above Drupal root.','','7.12'),('8737','/index.php','default','Skip standard tables. @see example.drushrc.com','','7.10');
INSERT INTO `locales_source` VALUES ('8738','/index.php','default','Execute a query against the site database.','','7.12'),('8739','/index.php','default','An SQL query. Ignored if ''file'' is provided.','','7.12'),('8740','/index.php','default','Save to a file. The file should be relative to Drupal root. Optional.','','7.12'),('8741','/index.php','default','Path to a file containing the SQL to be run.','','7.12'),('8742','/index.php','default','Add custom options to the mysql command.','','7.12'),('8743','/index.php','default','Browse user record. Table prefixes are honored.','','7.10'),('8744','/index.php','default','Alternate way to import sql statements from a file.','','7.12'),('8745','/index.php','default','Copy and import source database to target database. Transfers via rsync.','','7.12'),('8746','/index.php','default','Name of subdirectory within /sites or a site-alias.','','7.12'),('8747','/index.php','default','Skip dump if result file exists and is less than "cache" hours old. Optional; default is 24 hours.','','7.12'),('8748','/index.php','default','Do not cache the sql-dump file.','','7.12'),('8749','/index.php','default','Do not dump the sql database; always use an existing dump file.','','7.12'),('8750','/index.php','default','Database specification for source system to dump from.','','7.12'),('8751','/index.php','default','Override sql database port number in source-db-url. Optional.','','7.12'),('8752','/index.php','default','Remote machine to run sql-dump file on. Optional; default is local machine.','','7.12'),('8753','/index.php','default','Path to dump file. Optional; default is to create a temporary file.','','7.12'),('8754','/index.php','default','A key in the $db_url (D6) or $databases (D7+) array which shall receive the data.','','7.12'),('8755','/index.php','default','Oy. A key within the --target_database identifying a particular server in the database group.','','7.12'),('8756','/index.php','default','Use a temporary file to hold dump files.  Implies --no-cache.','','7.12'),('8757','/index.php','default','Directory to store sql dump files in when --source-dump or --target-dump are not used.  Takes precedence over --temp.','','7.12');
INSERT INTO `locales_source` VALUES ('8758','/index.php','default','Create a new database before importing the database dump on the target machine.','','7.12'),('8759','/index.php','default','Do not pass --ordered-dump to sql-dump.  sql-sync orders the dumpfile by default in order to increase the efficiency of rsync.','','7.12'),('8760','/index.php','default','Obscure email addresses and reset passwords in the user table post-sync. Optional.','','7.12'),('8761','/index.php','default','The name of a target within the specified DESTINATION database.','','7.12'),('8762','/index.php','default','Copy the DB defined in sites/dev to the DB in sites/prod.','','7.10'),('8763','/index.php','default','Open a SQL command-line interface using Drupal''s credentials.','','7.12'),('8764','/index.php','default','Run sanitization operations on the current database.','','7.12'),('8765','/index.php','default','The password to assign to all accounts in the sanitization operation, or "no" to keep passwords unchanged.  Default is "password".','','7.12'),('8766','/index.php','default','The username for test email addresses in the sanitization operation, or "no" to keep email addresses unchanged.  May contain replacement patterns %uid, %mail or %login.  Default is "user+%uid@localhost".','','7.10'),('8767','/index.php','default','Edit the style with your favorite Editor.','','7.12'),('8768','/index.php','default','A style ID','','7.12'),('8769','/index.php','default','Set variables for running Sweaver with drush.','','7.12'),('8770','/index.php','default','The type of variable to store. Currenlty only "editor" or "warning".','','7.12'),('8771','/index.php','default','The value of the variable. Currently your favorite editor command (+ any arguments if needed) or "true" or "false" for the warning message.','','7.12'),('8772','/index.php','default','Run tests. Note that you must use the --uri option.','','7.12'),('8773','/index.php','default','A test class, a test group. If omitted, a list of test classes and test groups is presented. Delimit multiple targets using commas.','','7.12');
INSERT INTO `locales_source` VALUES ('8774','/index.php','default','Run all available tests','','7.12'),('8775','/index.php','default','A comma delimited list of methods that should be run within the test class. Defaults to all methods.','','7.12'),('8776','/index.php','default','Skip cleanup of temporary tables and files. Helpful for reading debug() messages and other post-mortem forensics.','','7.12'),('8777','/index.php','default','Output verbose test results to a specified directory using the JUnit test reporting format. Useful for integrating with Jenkins.','','7.12'),('8778','/index.php','default','List all available classes and groups.','','7.12'),('8779','/index.php','default','Run all available tests. Avoid permission related failures by running as web server user.','','7.12'),('8780','/index.php','default','Run one test class.','','7.12'),('8781','/index.php','default','Run all classes in a XML-RPC group.','','7.12'),('8782','/index.php','default','Run all tests from multiple groups/classes.','','7.12'),('8783','/index.php','default','Run particular methods in the specified class or group.','','7.12'),('8784','/index.php','default','Clean temporary tables and files.','','7.12'),('8785','/index.php','default','Read detailed documentation on a given topic.','','7.12'),('8786','/index.php','default','The name of the topic you wish to view. If omitted, list all topic descriptions (and names in parenthesis).','','7.12'),('8787','/index.php','default','Show all available topics.','','7.12'),('8788','/index.php','default','Show documentation for the drush context API','','7.12'),('8789','/index.php','default','Run a major version upgrade for Drupal (e.g. Drupal 6 to Drupal 7).  A copy of the site is made, and then upgraded; the source site is not changed.','','7.10'),('8790','/index.php','default','The name of a sitealias, which points to the destination site. ''root'' and ''uri'' keys are required; db-url is recommended. See examples/aliases.drushrc.php for more information about creating a site alias.','','7.10'),('8791','/index.php','default','A key in the structure-tables array. @see example.drushrc.php. Defaults to ''common''.','','7.10');
INSERT INTO `locales_source` VALUES ('8792','/index.php','default','Path to dump file. Medium or large sized sites should set this. Optional; default is to create a temporary file.','','7.10'),('8793','/index.php','default','DB username to use when dropping and creating the target database. Optional.','','7.10'),('8794','/index.php','default','DB password to use when dropping and creating the target database. Optional.','','7.10'),('8795','/index.php','default','Transfer a fresh database from source site. Otherwise, DB dump is re-used for 24 hours.','','7.10'),('8796','/index.php','default','Stop after upgrading Drupal core; do not download and enable new versions of the site''s modules.','','7.10'),('8797','/index.php','default','Forces settings.php to be written in sites/default folder, even if source settings.php is not.','','7.10'),('8798','/index.php','default','Replace target if it already exists.  Default is to prompt.','','7.10'),('8799','/index.php','default','Reuse target if it already exists.  Default is to prompt.','','7.10'),('8800','/index.php','default','Comma-separated list of modules to uninstall in the target database prior to upgrade.  n.b. The source site is not affected.','','7.10'),('8801','/index.php','default','Upgrade from the current site to the site specified by @onward alias.','','7.10'),('8802','/index.php','default','Prior to running updatedb on Drupal core, disable all contrib modules and uninstall any module the user specified should be uninstalled.  Called automatically by site-upgrade.','','7.10'),('8803','/index.php','default','The modules to disable.','','7.10'),('8804','/index.php','default','Comma-separated list of modules to uninstall prior to upgrade.','','7.10'),('8805','/index.php','default','Download, enable, and run updatedb on all contrib modules after an upgrade.  Called automatically by site-upgrade.','','7.10'),('8806','/index.php','default','The modules to download and enable.','','7.10'),('8807','/index.php','default','The projects that must be downloaded to provide the specified module list.','','7.10');
