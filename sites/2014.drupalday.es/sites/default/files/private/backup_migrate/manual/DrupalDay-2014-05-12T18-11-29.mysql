INSERT INTO `locales_source` VALUES ('8870','/index.php','default','Reverts the "archive" and "frontpage" view.','','7.12'),('8871','/index.php','default','Will present you with a list of overridden views to choose from, and an option to revert all overridden views.','','7.12'),('8872','/index.php','default','Setup the views settings to a more developer oriented value..','','7.12'),('8873','/index.php','default','Get a list of all views in the system.','','7.12'),('8874','/index.php','default','String contained in view''s name by which filter the results.','','7.12'),('8875','/index.php','default','A comma-separated list of views tags by which to filter the results.','','7.12'),('8876','/index.php','default','Status of the views by which to filter the results. Choices: enabled, disabled.','','7.12'),('8877','/index.php','default','Type of the views by which to filter the results. Choices: normal, default or overridden.','','7.12'),('8878','/index.php','default','Show a list of all available views.','','7.12'),('8879','/index.php','default','Show a list of views which names contain "blog".','','7.12'),('8880','/index.php','default','Show a list of views tagged with "tag1" or "tag2".','','7.12'),('8881','/index.php','default','Show a list of enabled views.','','7.12'),('8882','/index.php','default','Show a list of overridden views.','','7.12'),('8883','/index.php','default','Get a list of all Views analyze warnings','','7.12'),('8884','/index.php','default','Enable the specified views.','','7.12'),('8885','/index.php','default','Enable the frontpage and taxonomy_term views.','','7.12'),('8886','/index.php','default','Disable the specified views.','','7.12'),('8887','/index.php','default','Disable the frontpage and taxonomy_term views.','','7.12'),('8888','/index.php','default','Show available message types and severity levels. A prompt will ask for a choice to show watchdog messages.','','7.12'),('8889','/index.php','default','Show watchdog messages.','','7.12'),('889