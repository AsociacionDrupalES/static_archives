INSERT INTO `locales_source` VALUES ('8978','/dday/admin/structure/types/manage/page/fields','default','Imagen','','7.12'),('8979','/dday/admin/config/media/image-styles','default','Image styles commonly provide thumbnail sizes by scaling and cropping images, but can also add various effects before an image is displayed. When an image is displayed with a style, a new file is created and the original image is left unchanged.','','7.12'),('8980','/dday/admin/structure/views/add','default','Unsorted','','7.12'),('8981','/dday/admin/structure/views/add','default','Use a pager','','7.12'),('8982','; sites/all/modules/views/js/views-admin.js','default','Apply (all displays)','','none'),('8983','; sites/all/modules/views/js/views-admin.js','default','Revert to default','','7.12'),('8984','; sites/all/modules/views/js/views-admin.js','default','Apply (this display)','','none'),('8985','/dday/admin/structure/views/add','default','imagen584','','7.12'),('8986','/dday/admin/structure/views/add','default','Título','','7.12'),('8987','','default','disable @display_title','','7.12'),('8988','/dday/admin/structure/views/view/imagen','default','Count DISTINCT','','7.12'),('8989','','default','Use aggregation','','7.12'),('8990','/dday/admin/structure/views/view/imagen','default','Specify which display or custom url this display will link to.','','7.12'),('8991','/dday/admin/structure/views/view/imagen','default','And/Or, Rearrange','','7.12'),('8992','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','You may use token substitutions from the rewriting section in this class.','','7.12'),('8993','','default','Customize label HTML','','7.12'),('8994','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','Customize field and label wrapper HTML','','7.12'),('8995','/dday/admin/structure/views/ajax/add-item/imagen/block/field','default','Choose the HTML element to wrap around this field and label, e.g. H1, H2, etc. This may not be used if the fiel