INSERT INTO `locales_source` VALUES ('6804','','default','File Usage','','7.12'),('6805','','default','A file that is associated with this node, usually because it is in a field on the node.','','7.12'),('6806','','default','A user that is associated with this file, usually because this file is in a field on the user.','','7.12'),('6807','','default','A file that is associated with this user, usually because it is in a field on the user.','','7.12'),('6808','','default','A comment that is associated with this file, usually because this file is in a field on the comment.','','7.12'),('6809','','default','A file that is associated with this comment, usually because it is in a field on the comment.','','7.12'),('6810','','default','A taxonomy term that is associated with this file, usually because this file is in a field on the taxonomy term.','','7.12'),('6811','','default','A file that is associated with this taxonomy term, usually because it is in a field on the taxonomy term.','','7.12'),('6812','','default','Taxonomy Vocabulary','','7.12'),('6813','','default','A taxonomy vocabulary that is associated with this file, usually because this file is in a field on the taxonomy vocabulary.','','7.12'),('6814','','default','A file that is associated with this taxonomy vocabulary, usually because it is in a field on the taxonomy vocabulary.','','7.12'),('6815','','default','The module managing this file relationship.','','7.12'),('6816','','default','The type of entity that is related to the file.','','7.12'),('6817','','default','The number of times the file is used by this entity.','','7.12'),('6818','','default','Machine-Name of the vocabulary a term is a member of. This will be the vocabulary that whichever term the "Taxonomy: Term" field is; and can similarly cause duplicates.','','7.12'),('6819','','default','term from !field_name','','7.12'),('6820','','default','Math expression','','7.12'),('6821','','default','Evaluates a mathematical expression and displays it.'