INSERT INTO `locales_target` VALUES ('1083','Merino','es','0','0','0'),('1084','Corriedale','es','0','0','0'),('1085','Corriedale','es','0','0','0'),('1086','Tiene una oveja @type llamada "@name".','es','0','0','0'),('1087','Venenoso','es','0','0','0'),('1088','no venenoso','es','0','0','0'),('1089','venenoso','es','0','0','0'),('1090','Águila','es','0','0','0'),('1091','Halcón','es','0','0','0'),('1092','Búho','es','0','0','0'),('1093','Buitre','es','0','0','0'),('1094','Domesticado','es','0','0','0'),('1095','salvaje','es','0','0','0'),('1096','domesticado','es','0','0','0'),('1097','¡Saltar!','es','0','0','0'),('1098','Volver a la página de ejemplos.','es','0','0','0'),('1099','¡Usted saltó con éxito! !return_link','es','0','0','0'),('1100','Demostración de AJAX de Chaos Tools','es','0','0','0'),('1101','Formulario Sencillo','es','0','0','0'),('1102','Animal','es','0','0','0'),('1103','Acción post inicio de sesión','es','0','0','0'),('1104','Salto exitoso','es','0','0','0'),('1105','Ejemplo de AJAX de Chaos Tools (CTools)','es','0','0','0'),('1106','Muestra cómo utilizar el poder de AJAX de Chaos.','es','0','0','0'),('1107','Administrar contenido personalizado','es','0','0','0'),('1108','Agregar, editar y eliminar contenido personalizado almacenado de CTools','es','0','0','0'),('1109','Si existe más de una variante en una página, cuando se visita la página a cada variante se le da la oportunidad de mostrarse. Empezando por la primera variante y avanzando hasta la última, cada una prueba para ver pasan si sus reglas de selección. La primera variante que cumpla con sus criterios (tal y como se especifica abajo) será utilizada.','es','0','0','0'),('1110','No hay asistentes disponibles en este momento.','es','0','0','0'),('1111','Configurar nuevo !plugin_title','es','0','0','0'),('1112','Configurar !plugin_title','es','0','0','0');
INSERT INTO `locales_target` VALUES ('1113','ctools','es','0','0','0'),('1114','Se solicitó una combinación de módulo/tipo de complemento no válida: módulo @module y tipo @type','es','0','0','0'),('1115','El complemento @plugin del tipo @owner:@type apunta al archivo no existente @file para el manejador de la clase @class.','es','0','0','0'),('1116','Utilizar Page Manager','es','0','0','0'),('1117','Permite a los usuarios utilizar la mayoría de las funcionalidades de Page Manager, aunque restringe algunas de las más poderosas y potencialmente perjudiciales para el sitio. Tenga en cuenta que incluso el conjunto reducido de funcionalidades permite un control enorme sobre su sitio.','es','0','0','0'),('1118','Administrar Page Manager','es','0','0','0'),('1119','Permite control completo sobre Page Manager, i.e., control completo sobre su sitio. Conceder con suma precaución.','es','0','0','0'),('1120','Contexto de Page Manager','es','0','0','0'),('1121','Cambiar opciones generales para esta variante.','es','0','0','0'),('1122','404 Página no encontrada','es','0','0','0'),('1123','403 Acceso denegado','es','0','0','0'),('1124','301 Redirigir','es','0','0','0'),('1125','Destino de la redirección','es','0','0','0'),('1126','Escriba la ruta a la cual redirigir. Puede utilizar sustituciones de palabras clave de contextos. Puede utilizar URL externas (http://www.example.com/foo) o internas (node/1).','es','0','0','0'),('1127','El primer elemento en una ruta puede no ser dinámico.','es','0','0','0'),('1128','Si se marca, las palabras clave de contexto serán sustituidas en este contenido. Tenga en cuenta que los campos CCK pueden utilizarse como palabras clave utilizando patrones como <em>%node:field_name-formatted</em>.','es','0','0','0'),('1129','Si se marca, las palabras clave de contexto serán sustituidas en este contenido. Tendrá más palabras clave  disponibles si instala el módulo Token, ver http://drupal.org/project/token.','es','0','0','0'),('1130','Firma del usuario','es','0','0','0'),('1131','La firma de un usuario.','es','0','0','0'),('1132','Firma del usuario "@s"','es','0','0','0');
INSERT INTO `locales_target` VALUES ('1133','Heredar ruta','es','0','0','0'),('1134','Borrar y guardar','es','0','0','0'),('1135','Activar y guardar','es','0','0','0'),('1136','Desactivar y guardar','es','0','0','0'),('1137','Revisión: ID','es','0','0','0'),('1138','Crea un contexto de nodo a partir de un argumento de ID de revisión.','es','0','0','0'),('1139','Escriba el ID de revisión de un nodo para este argumento','es','0','0','0'),('1140','Nombre del término, en minúsculas y los espacios convertidos en guiones','es','0','0','0'),('1141','Nombre del primer término, en minúsculas y con los espacios convertidos en guiones','es','0','0','0'),('1142','Entidad: ID','es','0','0','0'),('1143','Crea un contexto de entidad a partir de un argumento de ID de entidad.','es','0','0','0'),('1144','@entity: ID','es','0','0','0'),('1145','Crea un contexto de @entity a partir de un argumento de ID.','es','0','0','0'),('1146','Bloques personalizados','es','0','0','0'),('1147','Campo de entidad','es','0','0','0'),('1148','Campo en la entidad referenciada.','es','0','0','0'),('1149','Estilos de Formateador','es','0','0','0'),('1150','Seleccione un formateador','es','0','0','0'),('1151','Objeto de entidad.','es','0','0','0'),('1152','Escriba el ID de una entidad para este contexto.','es','0','0','0'),('1153','Crea un contexto @entity a partir de un ID de entidad.','es','0','0','0'),('1154','Información del Sitio','es','0','0','0'),('1155','Utilizar esta página en sobreposición de administración.','es','0','0','0'),('1156','Las sobreposiciones de administración son utilizadas en muchos lugares en Drupal 7 y las páginas administrativas personalizadas probablemente deberían utilizar esta función.','es','0','0','0'),('1157','un callback (llamada) desconocido','es','0','0','0'),('1158','El módulo Page Manager no puede habilitar taxonomy/term/%taxonomy_term porque algún otro módulo ya lo ha sobrescrito con %callback.','es','0','0','0'),('1159','Entidad: paquete','es','0','0','0'),('1160',