INSERT INTO `locales_source` VALUES ('9268','','default','Time grouping','','7.10'),('9269','','default','Group items together into time periods based on their start time.','','7.10'),('9270','','default','Half hour','','7.10'),('9271','','default','Custom time grouping','','7.10'),('9272','','default','When choosing the ''custom'' Time grouping option above, create custom time period groupings as a comma-separated list of 24-hour times in the format HH:MM:SS, like ''00:00:00,08:00:00,18:00:00''. Be sure to start with ''00:00:00''. All items after the last time will go in the final group.','','7.10'),('9273','','default','Field grouping','','7.10'),('9274','','default','All times','','none'),('9275','','default','Before @time','','7.12'),('9276','','default','Multi-day style','','7.10'),('9277','','default','Display multi-day item as a single column','','7.10'),('9278','','default','Display multi-day item as a multiple column row','','7.10'),('9279','','default','If selected, items which span multiple days will displayed as a multi-column row.  If not selected, items will be displayed as an individual column.','','7.10'),('9280','','default','Overlapping time style','','7.10'),('9281','','default','Do not display overlapping items','','7.10'),('9282','','default','All day','datetime','7.12'),('9283','','default','Maximum number of items to show in calendar cells, used to keep the calendar from expanding to a huge size when there are lots of items in one day.','','7.10'),('9284','/index.php','default','Present view results as a Calendar.','','7.12'),('9285','/index.php','default','Calendar Items','','7.12'),('9286','/index.php','default','Displays each selected node as a Calendar item.','','7.12'),('9287','/index.php','default','iCal Feed','','7.12'),('9288','/index.php','default','Generates an iCal VCALENDAR feed from a view.','','7.12'),('9289','/index.php','default','iCal Fields','','7.12'),('9290','/index.php','default','Display each node as an iCal VEVENT item.','','7.12'),('9291','','default','Date browser','','7.12'),('9292','','default','Date back/next navigation to attach to other displays. Requires the Date argument.','','7.12');
