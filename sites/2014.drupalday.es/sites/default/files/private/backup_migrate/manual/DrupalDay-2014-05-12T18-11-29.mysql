INSERT INTO `locales_target` VALUES ('2324','Permitir ampliaciones','es','0','0','0'),('2325','Permitir que la escala haga las imágenes más grandes que su tamaño original.','es','0','0','0'),('2326','Ángulo de rotación','es','0','0','0'),('2327','El número de grados en el que la imagen debería ser rotada. Los números positivos indican en sentido de las agujas del reloj, los negativos indican en sentido contrario.','es','0','0','0'),('2328','Cambiar aleatoriamente el ángulo de rotación de cada imagen. El ángulo especificado arriba es usado como ángulo máximo.','es','0','0','0'),('2329','Imprimir','es','0','0','0'),('2330','No se pudo crear el archivo.','es','0','0','0'),('2331','Se han enviado instrucciones para restablecer la contraseña de %name a %email.','es','0','0','0'),('2332','La dirección de correo electrónico %mail no es válida.','es','0','0','0'),('2333','Cuenta','es','0','0','0'),('2334','usuario registrado','es','0','0','0'),('2335','Cualquiera','es','0','0','0'),('2336','Direcciones de correo para avisar cuando haya actualizaciones disponibles','es','0','0','0'),('2337','Siempre que su sitio busque actualizaciones disponibles y encuentre nuevas versiones, puede avisar por correo a una lista de usuarios. Ponga cada dirección en una línea distinta. Si está en blanco, no se enviarán mensajes de correo.','es','0','0','0'),('2338','Comprobar si hay actualizaciones','es','0','0','0'),('2339','Todas las versiones más recientes','es','0','0','0'),('2340','Sólo actualizaciones de seguridad','es','0','0','0'),('2341','%email no es una dirección de correo electrónico válida.','es','0','0','0'),('2342','%emails no son direcciones de correo electrónico válidas.','es','0','0','0'),('2343','No hay datos de actualización disponibles','es','0','0','0'),('2344','¡No es seguro!','es','0','0','0'),('2345','¡Cancelado!','es','0','0','0'),('2346','Versión sin mantenimiento','es','0','0','0'),('2347','No se puede determinar el estado','es','0','0','0'),('2348','(versión @version disponible)','es','0','0','0'),('2349','Vea la página de actualizaciones disponibles para más información:','es','0','0','0');
INSERT INTO `locales_target` VALUES ('2350','Nueva(s) versión(es) disponible(s) para !site_name','es','0','0','0'),('2351','Hay una actualización de seguridad disponible para su versión de Drupal. Para garantizar la seguridad de su servidor, ¡debería actualizarla de inmediato!','es','0','0','0'),('2352','Su versión de Drupal ha sido rechazada y ya no está disponible para su descarga. ¡Es muy recomendable que la actualice!','es','0','0','0'),('2353','La versión instalada de al menos uno de sus módulos o temas gráficos ha sido revocada y ya no está disponible para su descarga. ¡Es muy recomendable su actualización o desactivación!','es','0','0','0'),('2354','Su versión de Drupal ya no tiene mantenimiento. ¡Es muy recomendable su actualización!','es','0','0','0'),('2355','Hay actualizaciones disponibles para su versión de Drupal. Para asegurar el funcionamiento apropiado de su sitio, debería actualizarlo tan pronto como sea posible.','es','0','0','0'),('2356','Vea la página de <a href="@available_updates">actualizaciones disponibles</a> para más información.','es','0','0','0'),('2357','Proyecto no seguro','es','0','0','0'),('2358','Este proyecto ha sido clasificado como inseguro por el equipo de seguridad de Drupal y ya no estará disponible para su descarga. ¡Es altamente recomendable desactivar inmediatamente todo lo que forma parte de este proyecto!','es','0','0','0'),('2359','Proyecto revocado','es','0','0','0'),('2360','Este proyecto ha sido revocado y ya no estará disponible para su descarga. ¡Es altamente recomendable desactivar todo lo que forma parte de este proyecto!','es','0','0','0'),('2361','Proyecto sin mantenimiento','es','0','0','0'),('2362','Para este proyecto ya no hay soporte, y tampoco estará disponible para su descarga. ¡Es altamente recomendable deshabilitar todo lo incluido por este proyecto!','es','0','0','0'),('2363','No se encontraron versiones disponibles','es','0','0','0'),('2364','Versión revocada','es','0','0','0'),('2365','La versión que tiene instalada ha sido revocada y ya no está disponible para su descarga. ¡Se recomienda encarecidamente desactivar todo lo que incluye esta versión o actualizarla!','es','0','0','0');
INSERT INTO `locales_target` VALUES ('2366','Versión no funcional','es','0','0','0'),('2367','Para la versión de su  instalación actual ya no hay mantenimiento, y no está disponible para su descarga. ¡Se le recomienda muy encarecidamente que desactive o actualice todo lo que forma parte de esta versión!','es','0','0','0'),('2368','Información no válida','es','0','0','0'),('2369','¡Se requiere una actualización de seguridad!','es','0','0','0'),('2370','¡Sin mantenimiento!','es','0','0','0'),('2371','Versión recomendada:','es','0','0','0'),('2372','Actualización de seguridad:','es','0','0','0'),('2373','Versión más reciente:','es','0','0','0'),('2374','Versión de desarrollo:','es','0','0','0'),('2375','También disponible:','es','0','0','0'),('2376','Cuenta de nodos','es','0','0','0'),('2377','Opciones del campo','es','0','0','0'),('2378','Pasar al contenido principal','es','0','0','0'),('2379','@title','es','0','0','0'),('2380','Editar foro','es','0','0','0'),('2381','Orden predefinido','es','0','0','0'),('2382','Este es el vocabulario diseñado para el foro. Se han eliminado algunas de las opciones habituales del vocabulario normal.','es','0','0','0'),('2383','Dejar una copia sombreada','es','0','0','0'),('2384','Si mueve este tema, puede dejar un enlace al nuevo foro en el foro anterior.','es','0','0','0'),('2385','Nombre del contenedor','es','0','0','0'),('2386','contenedor de foro','es','0','0','0'),('2387','Creado nuevo @type %term.','es','0','0','0'),('2388','Se ha actualizado el @type %term.','es','0','0','0'),('2389','Agregar nuevo campo','es','0','0','0'),('2390','Que contenga cualquiera de las palabras','es','0','0','0'),('2391','Que contenga la frase','es','0','0','0'),('2392','Que no contenga ninguna de las palabras','es','0','0','0'),('2393','Sólo de los tipos','es','0','0','0'),('2394','Ranking de contenido','es','0','0','0'),('2395','Los números siguientes controlan qué propiedades de la búsqueda de contenido deben definir la ordenación de los resultados. Los números mayores implican mayor influencia. Cero significa que la propiedad se ignora. Al cambiar estos números no es necesario reconstruir el índice de búsqueda. Los cambios surten efecto inmediatamente.','es','0','0','0');
