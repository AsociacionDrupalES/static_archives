INSERT INTO `locales_source` VALUES ('3020','','default','Kinyarwanda','','7.10'),('3021','','default','Sanskrit','','7.10'),('3022','','default','Sardinian','','7.10'),('3023','','default','Sindhi','','7.10'),('3024','','default','Northern Sami','','7.10'),('3025','','default','Sango','','7.10'),('3026','','default','Serbo-Croatian','','7.10'),('3027','','default','Sinhala','','7.10'),('3028','','default','Slovenian','','7.10'),('3029','','default','Samoan','','7.10'),('3030','','default','Shona','','7.10'),('3031','','default','Albanian','','7.10'),('3032','','default','Serbian','','7.10'),('3033','','default','Siswati','','7.10'),('3034','','default','Sesotho','','7.10'),('3035','','default','Sudanese','','7.10'),('3036','','default','Swahili','','7.10'),('3037','','default','Tamil','','7.10'),('3038','','default','Telugu','','7.10'),('3039','','default','Tajik','','7.10'),('3040','','default','Thai','','7.10'),('3041','','default','Tigrinya','','7.10'),('3042','','default','Turkmen','','7.10'),('3043','','default','Tagalog','','7.10'),('3044','','default','Setswana','','7.10'),('3045','','default','Tsonga','','7.10'),('3046','','default','Tatar','','7.10'),('3047','','default','Twi','','7.10'),('3048','','default','Tahitian','','7.10'),('3049','','default','Uighur','','7.10');
INSERT INTO `locales_source` VALUES ('3050','','default','Ukrainian','','7.10'),('3051','','default','Urdu','','7.10'),('3052','','default','Uzbek','','7.10'),('3053','','default','Venda','','7.10'),('3054','','default','Vietnamese','','7.10'),('3055','','default','Wolof','','7.10'),('3056','','default','Xhosa','','7.10'),('3057','','default','Yiddish','','7.10'),('3058','','default','Yoruba','','7.10'),('3059','','default','Zhuang','','7.10'),('3060','','default','Chinese, Simplified','','7.10'),('3061','','default','Chinese, Traditional','','7.10'),('3062','','default','Zulu','','7.10'),('3063','','default','Error sending e-mail (from %from to %to).','','none'),('3064','','default','sort ascending','','7.12'),('3065','','default','sort descending','','7.12'),('3066','','default','Operations on Unicode strings are emulated on a best-effort basis. Install the <a href="@url">PHP mbstring extension</a> for improved Unicode support.','','none'),('3067','','default','Multibyte string function overloading in PHP is active and must be disabled. Check the php.ini <em>mbstring.func_overload</em> setting. Please refer to the <a href="@url">PHP mbstring documentation</a> for more information.','','none'),('3068','','default','Multibyte string input conversion in PHP is active and must be disabled. Check the php.ini <em>mbstring.encoding_translation</em> setting. Please refer to the <a href="@url">PHP mbstring documentation</a> for more information.','','none'),('3069','','default','Multibyte string input conversion in PHP is active and must be disabled. Check the php.ini <em>mbstring.http_input</em> setting. Please refer to the <a href="@url">PHP mbstring documentation</a> for more information.','','none'),('3070','','default','Multibyte string output conversion in PHP is active and must be disabled. Check the php.ini <em>mbstring.http_output</em> setting. Please refer to the <a href="@url">PHP mbstring documentation</a> for more information.','','none'),('3071','','default','Standard PHP','','7.12'),('3072','','default','PHP Mbstring Extension','','7.12'),('3073','','default','Unicode library','','7.12');
INSERT INTO `locales_source` VALUES ('3074','','default','Could not convert XML encoding %s to UTF-8.','','none'),('3075','','default','Unsupported encoding %s. Please install iconv, GNU recode or mbstring for PHP.','','none'),('3076','','default','Parse error. Not well formed','','none'),('3077','','default','Parse error. Request not well formed.','','none'),('3078','','default','Server error. Invalid XML-RPC. Request must be a methodCall.','','none'),('3079','','default','Server error. Requested method @methodname not specified.','','none'),('3080','','default','Server error. Wrong number of method parameters.','','none'),('3081','','default','Server error. Invalid method parameters.','','none'),('3082','','default','Server error. Requested function @method does not exist.','','none'),('3083','','default','Invalid syntax for system.multicall.','','none'),('3084','','default','Recursive calls to system.multicall are forbidden.','','none'),('3085','','default','Server error. Requested method @methodname signature not specified.','','none'),('3086','','default','The name of the feed (or the name of the website providing the feed).','','none'),('3087','','default','Categorize news items','','none'),('3088','','default','Are you sure you want to remove all items from the feed %feed?','','none'),('3089','','default','checkboxes','','none'),('3090','','default','multiple selector','','none'),('3091','','default','Thousands of sites (particularly news sites and blogs) publish their latest headlines and posts in feeds, using a number of standardized XML-based formats. Formats supported by the aggregator include <a href="@rss">RSS</a>, <a href="@rdf">RDF</a>, and <a href="@atom">Atom</a>.','','none'),('3092','','default','Current feeds are listed below, and <a href="@addfeed">new feeds may be added</a>. For each feed or feed category, the <em>latest items</em> block may be enabled at the <a href="@block">blocks administration page</a>.','','none'),('3093','','default','Add a feed in RSS, RDF or Atom format. A feed may only have one entry.','','none'),('3094','','default','Categories allow feed items from different feeds to be grouped together. For example, several sport-related feeds may belong to a category named <em>Sports</em>. Feed items may be grouped automatically (by selecting a category when creating or editing a feed) or manually (via the <em>Categorize</em> page available from feed item listings). Each category provides its own feed page and block.','','none');
INSERT INTO `locales_source` VALUES ('3095','','default','Configure which content your site aggregates from other sites, how often it polls them, and how they''re categorized.','','none'),('3096','','default','Update items','','none'),('3097','','default','Edit feed','','none'),('3098','','default','No blocks in this region','','7.12'),('3099','','default','The block %info was assigned to the invalid region %region and has been disabled.','','none'),('3100','; modules/block/block.js','default','The changes to these blocks will not be saved until the <em>Save blocks</em> button is clicked.','','none'),('3101','','default','Post new blog entry.','','none'),('3102','','default','You are not allowed to post a new blog entry.','','none'),('3103','','default','You have not created any blog entries.','','none'),('3104','','default','!author has not created any blog entries.','','none'),('3105','','default','No blog entries have been created.','','none'),('3106','','default','Blog entry','','none'),('3107','','default','View recent blog entries','','none'),('3108','','default','Read !username''s latest blog entries.','','none'),('3109','','default','!username''s blog','','none'),('3110','','default','Read the latest blog entries.','','none'),('3111','','default','The content type for the %add-child link must be one of those selected as an allowed book outline type.','','none'),('3112','','default','Save book pages','','none'),('3113','','default','This book has been modified by another user, the changes could not be saved.','','none'),('3114','','default','Title changed from %original to %current.','','none'),('3115','','default','Updated book %title.','','none'),('3116','','default','book: updated %title.','','none'),('3117','','default','Update book outline','','none'),('3118','','default','Remove from book outline','','none'),('3119','','default','No changes were made','','none'),('3120','','default','The post has been added to the selected book. You may now position it relative to other pages.','','none'),('3121','','default','The book outline has been updated.','','none'),('3122','','default','There was an error adding the post to the book.','','none');
INSERT INTO `locales_source` VALUES ('3123','','default','%title has associated child pages, which will be relocated automatically to maintain their connection to the book. To recreate the hierarchy (as it was before removing this page), %title may be added again using the Outline tab, and each of its former child pages will need to be relocated manually.','','none'),('3124','','default','%title may be added to hierarchy again using the Outline tab.','','none'),('3125','','default','Are you sure you want to remove %title from the book hierarchy?','','none'),('3126','','default','The post has been removed from the book.','','none'),('3127','','default','Show a printer-friendly version of this book page and its sub-pages.','','none'),('3128','','default','Show block on all pages','','none'),('3129','','default','Show block only on book pages','','none'),('3130','','default','If <em>Show block on all pages</em> is selected, the block will contain the automatically generated menus for all of the site''s books. If <em>Show block only on book pages</em> is selected, the block will contain only the one menu corresponding to the current page''s book. In this case, if the current page is not in a book, no block will be displayed. The <em>Page specific visibility settings</em> or other visibility settings can be used in addition to selectively display this block.','','none'),('3131','','default','This is the top-level page in this book.','','none'),('3132','','default','No book selected.','','none'),('3133','','default','The parent page in the book. The maximum depth for a book and all child pages is !maxdepth. Some pages in the selected book may not be available as parents if selecting them would exceed this limit.','','none'),('3134','','default','%title is part of a book outline, and has associated child pages. If you proceed with deletion, the child pages will be relocated automatically.','','none'),('3135','','default','Re-order book pages and change titles','','none'),('3136','','default','Book page','','none'),('3137','','default','Base color','','none');
INSERT INTO `locales_source` VALUES ('3138','','default','Header top','','7.12'),('3139','','default','Header bottom','','7.12'),('3140','','default','There is not enough memory available to PHP to change this theme''s color scheme. You need at least %size more. Check the <a href="@url">PHP documentation</a> for more information.','','none'),('3141','','default','Delete the selected comments','','none'),('3142','','default','Allows users to comment on and discuss published content.','','7.12'),('3143','','default','Example: ''website feedback'' or ''product information''.','','7.12'),('3144','','default','When listing categories, those with lighter (smaller) weights get listed before categories with heavier (larger) weights. Categories with equal weights are sorted alphabetically.','','7.12'),('3145','','default','The contact form has not been configured. <a href="@add">Add one or more categories</a> to the form.','','none'),('3146','','default','Personal contact form','','7.12'),('3147','','default','Create a system contact form and set up categories for the form to use.','','7.12'),('3148','','default','Edit contact category','','7.10'),('3149','','default','Enables the use of both personal and site-wide contact forms.','','7.12'),('3150','','default','Database logging','','none'),('3151','','default','View events that have recently been logged.','','7.12'),('3152','','default','Top ''page not found'' errors','','7.12'),('3153','','default','View ''page not found'' errors (404s).','','7.12'),('3154','','default','Top ''access denied'' errors','','7.12'),('3155','','default','View ''access denied'' errors (403s).','','7.12'),('3156','','default','Logs and records system events to the database.','','7.12'),('3157','','default','No roles may use this format','','7.10'),('3158','','default','Allowed HTML tags: @tags','','7.12'),('3159','','default','Anchors are used to make links to other pages.','','7.12'),('3160','','default','By default line break tags are automatically added, so use this tag to add additional ones. Use of this tag is different because it is not used with an open/close pair like all the others. Use the extra " /" inside the tag to maintain XHTML 1.0 compatibility','','7.12');
INSERT INTO `locales_source` VALUES ('3161','','default','Text with <br />line break','','7.12'),('3162','','default','By default paragraph tags are automatically added, so use this tag to add additional ones.','','7.12'),('3163','','default','Paragraph one.','','7.12'),('3164','','default','Paragraph two.','','7.12'),('3165','','default','Strong','','7.12'),('3166','','default','Emphasized','','7.12'),('3167','','default','Cited','','7.12'),('3168','','default','Coded text used to show programming source code','','7.12'),('3169','','default','Coded','','7.12'),('3170','','default','Bolded','','7.12'),('3171','','default','Italicized','','7.12'),('3172','','default','Superscripted','','7.12'),('3173','','default','<sup>Super</sup>scripted','','7.12'),('3174','','default','Subscripted','','7.12'),('3175','','default','<sub>Sub</sub>scripted','','7.12'),('3176','','default','<abbr title="Abbreviation">Abbrev.</abbr>','','7.12'),('3177','','default','<acronym title="Three-Letter Acronym">TLA</acronym>','','7.12'),('3178','','default','Block quoted','','7.12'),('3179','','default','Quoted inline','','7.12'),('3180','','default','Table header','','7.12'),('3181','','default','Table cell','','7.12'),('3182','','default','Ordered list - use the &lt;li&gt; to begin each list item','','7.12'),('3183','','default','First item','','7.12'),('3184','','default','Second item','','7.12'),('3185','','default','Unordered list - use the &lt;li&gt; to begin each list item','','7.12'),('3186','','default','Definition lists are similar to other HTML lists. &lt;dl&gt; begins the definition list, &lt;dt&gt; begins the definition term and &lt;dd&gt; begins the definition description.','','7.12'),('3187','','default','First term','','7.12'),('3188','','default','First definition','','7.12'),('3189','','default','Second term','','7.12'),('3190','','default','Second definition','','7.12');
INSERT INTO `locales_source` VALUES ('3191','','default','Subtitle three','','7.12'),('3192','','default','Subtitle four','','7.12'),('3193','','default','Subtitle five','','7.12'),('3194','','default','Subtitle six','','7.12'),('3195','','default','Tag Description','','7.12'),('3196','','default','You Type','','7.12'),('3197','','default','You Get','','7.12'),('3198','','default','No help provided for tag %tag.','','7.12'),('3199','','default','Ampersand','','7.12'),('3200','','default','Quotation mark','','7.12'),('3201','','default','Character Description','','7.12'),('3202','','default','Lines and paragraphs break automatically.','','7.12'),('3203','','default','Lines and paragraphs are automatically recognized. The &lt;br /&gt; line break, &lt;p&gt; paragraph and &lt;/p&gt; close paragraph tags are inserted automatically. If paragraphs are not recognized simply add a couple blank lines.','','7.12'),('3204','','default','Web page addresses and e-mail addresses turn into links automatically.','','7.12'),('3205','','default','Configure how content input by users is filtered, including allowed HTML tags. Also allows enabling of module-provided filters.','','7.12'),('3206','','default','Compose tips','','7.12'),('3207','','default','Short but meaningful name for this collection of threaded discussions.','','7.10'),('3208','','default','Description and guidelines for discussions within this forum.','','7.10'),('3209','','default','Forums are displayed in ascending order by weight (forums with equal weights are displayed alphabetically).','','7.10'),('3210','','default','Short but meaningful name for this collection of related forums.','','none'),('3211','','default','Description and guidelines for forums within this container.','','none'),('3212','','default','Containers are displayed in ascending order by weight (containers with equal weights are displayed alphabetically).','','none'),('3213','','default','Deleting a forum or container will also delete its sub-forums, if any. To delete posts in this forum, visit <a href="@content">content administration</a> first. This action cannot be undone.','','none');
INSERT INTO `locales_source` VALUES ('3214','','default','Default number of forum topics displayed per page.','','7.10'),('3215','','default','Default display order for topics.','','7.10'),('3216','','default','Containers are usually placed at the top (root) level, but may also be placed inside another container or forum.','','none'),('3217','','default','Forums may be placed at the top (root) level, or inside another container or forum.','','7.10'),('3218','','default','For more information, see the online handbook entry for <a href="@forum">Forum module</a>.','','7.10'),('3219','','default','Forum topic','','7.10'),('3220','','default','You are not allowed to post new content in the forum.','','none'),('3221','','default','Manages the display of online help.','','7.12'),('3222','','default','This page provides an overview of available translatable strings. Drupal displays translatable strings in text groups; modules may define additional text groups containing other translatable strings. Because text groups provide a method of grouping related strings, they are often used to focus translation efforts on specific areas of the Drupal interface.','','none'),('3223','','default','Note that the <em>.po</em> files within a translation package are imported automatically (if available) when new modules or themes are enabled, or as new languages are added. Since this page only allows the import of one <em>.po</em> file at a time, it may be simpler to download and extract a translation package into your Drupal installation directory and <a href="@language-add">add the language</a> (which automatically imports all <em>.po</em> files within the package). Translation packages are available for download on the <a href="@translations">Drupal translation page</a>.','','none'),('3224','','default','This page exports the translated strings used by your site. An export file may be in Gettext Portable Object (<em>.po</em>) form, which includes both the original string and the translation (used to share translations with others), or in Gettext Portable Object Template (<em>.pot</em>) form, which includes the original strings only (used to create new translations with a Gettext translation editor).','','none');
INSERT INTO `locales_source` VALUES ('3225','','default','Built-in interface','','none'),('3226','','default','This account''s default language for e-mails, and preferred language for site presentation.','','none'),('3227','','default','This account''s default language for e-mails.','','none'),('3228','','default','A path alias set for a specific language will always be used when displaying this page in that language, and takes precedence over path aliases set for <em>All languages</em>.','','none'),('3229','','default','Enable multilingual support for this content type. If enabled, a language selection field will be added to the editing form, allowing you to select from one of the <a href="!languages">enabled languages</a>. If disabled, new posts are saved with the default language. Existing content will not be affected by changing this option.','','7.12'),('3230','','default','Configure languages for content and the user interface.','','7.12'),('3231','','default','Translate the built in interface and optionally other text.','','7.12'),('3232','','default','Adds language handling functionality and enables the translation of the user interface to languages other than English.','','7.12'),('3233','','default','Submission form settings','','7.12'),('3234','','default','This content type does not have a title field.','','none'),('3235','','default','The machine-readable name must contain only lowercase letters, numbers, and underscores.','','none'),('3236','','default','The human-readable name %name is already taken.','','none'),('3237','','default','Are you sure you want to delete the content type %type?','','7.12'),('3238','','default','Added content type %name.','','none'),('3239','','default','Changed the content type of 1 post from %old-type to %type.','','none'),('3240','','default','Changed the content type of @count posts from %old-type to %type.','','none'),('3241','','default','Are you sure you want to rebuild the permissions on site content?','','7.12'),('3242','','default','This action rebuilds all permissions on site content, and may be a lengthy process. This action cannot be undone.','','7.12');
INSERT INTO `locales_source` VALUES ('3243','','default','language','','7.12'),('3244','','default','An error occurred and processing did not complete.','','none'),('3245','','default','The trimmed version of your post shows what your post looks like when promoted to the main page or when exported for syndication.<span class="no-js"> You can insert the delimiter "&lt;!--break--&gt;" (without the quotes) to fine-tune where your post gets split.</span>','','7.12'),('3246','','default','Copy of the revision from %date.','','7.10'),('3247','','default','@type %title has been reverted back to the revision from %revision-date.','','7.10'),('3248','','default','Revision from %revision-date of @type %title has been deleted.','','7.10'),('3249','','default','@type: reverted %title revision %revision.','','none'),('3250','','default','The content access permissions need to be rebuilt.','','none'),('3251','','default','<strong>Configure your website</strong> Once logged in, visit the <a href="@admin">administration section</a>, where you can <a href="@config">customize and configure</a> all aspects of your website.','','7.12'),('3252','','default','<strong>Enable additional functionality</strong> Next, visit the <a href="@modules">module list</a> and enable features which suit your specific needs. You can find additional modules in the <a href="@download_modules">Drupal modules download section</a>.','','7.12'),('3253','','default','<strong>Customize your website design</strong> To change the "look and feel" of your website, visit the <a href="@themes">themes section</a>. You may choose from one of the included themes or download additional themes from the <a href="@download_themes">Drupal themes download section</a>.','','7.12'),('3254','','default','Rebuilding content access permissions','','none'),('3255','','default','Content permissions have been rebuilt.','','7.12'),('3256','','default','The content access permissions have not been properly rebuilt.','','none'),('3257','','default','Add content type','','7.12'),('3258','','default','Revert to earlier revision','','7.10');
INSERT INTO `locales_source` VALUES ('3259','','default','Delete earlier revision','','7.10'),('3260','','default','Allows content to be submitted to the site and displayed on pages.','','7.12'),('3261','','default','To use OpenID you must first establish an identity on a public or private OpenID server. If you do not have an OpenID and would like one, look into one of the <a href="@openid-providers">free public providers</a>. You can find out more about OpenID at <a href="@openid-net">this website</a>.','','none'),('3262','','default','OpenID identities','','none'),('3263','','default','Allows users to log into your site using OpenID.','','7.12'),('3264','','default','The alias %alias is already in use in this language.','','none'),('3265','','default','The alias has been saved.','','none'),('3266','','default','Are you sure you want to delete path alias %title?','','none'),('3267','','default','Filter aliases','','7.12'),('3268','','default','Enter the path you wish to create the alias for, followed by the name of the new alias.','','none'),('3269','','default','URL aliases','','7.12'),('3270','','default','Change your site''s URL paths by aliasing them.','','7.12'),('3271','','default','Edit alias','','none'),('3272','','default','Delete alias','','none'),('3273','','default','Add alias','','7.12'),('3274','','default','Allows users to rename URLs.','','7.12'),('3275','','default','<a href="@drupal">Drupal.org</a> offers <a href="@php-snippets">some example PHP snippets</a>, or you can create your own with some PHP experience and knowledge of the Drupal system.','','none'),('3276','','default','You may post PHP code. You should include &lt;?php ?&gt; tags.','','none'),('3277','','default','Using custom PHP code','','none'),('3278','','default','Custom PHP code may be embedded in some types of site content, including posts and blocks. While embedding PHP code inside a post or block is a powerful and flexible feature when used by a trusted user with PHP experience, it is a significant and dangerous security risk when used improperly. Even a small mistake when posting PHP code may accidentally compromise your site.','','none');
INSERT INTO `locales_source` VALUES ('3279','','default','If you are unfamiliar with PHP, SQL, or Drupal, avoid using custom PHP code within posts. Experimenting with PHP may corrupt your database, render your site inoperable, or significantly compromise security.','','none'),('3280','','default','Notes:','','none'),('3281','','default','Remember to double-check each line for syntax and logic errors <strong>before</strong> saving.','','none'),('3282','','default','Statements must be correctly terminated with semicolons.','','none'),('3283','','default','Global variables used within your PHP code retain their values after your script executes.','','none'),('3284','','default','<code>register_globals</code> is <strong>turned off</strong>. If you need to use forms, understand and use the functions in <a href="@formapi">the Drupal Form API</a>.','','none'),('3285','','default','Use a <code>print</code> or <code>return</code> statement in your code to output content.','','none'),('3286','','default','Develop and test your PHP code using a separate test script and sample database before deploying on a production site.','','none'),('3287','','default','Consider including your custom PHP code within a site-specific module or <code>template.php</code> file rather than embedding it directly into a post or block.','','none'),('3288','','default','Be aware that the ability to embed PHP code within content is provided by the PHP Filter module. If this module is disabled or deleted, then blocks and posts with embedded PHP may display, rather than execute, the PHP code.','','none'),('3289','','default','A basic example: <em>Creating a "Welcome" block that greets visitors with a simple message.</em>','','none'),('3290','','default','PHP evaluator','','none'),('3291','','default','Executes a piece of PHP code. The usage of this filter should be restricted to administrators only!','','none'),('3292','','default','Allows embedded PHP code/snippets to be evaluated.','','7.12'),('3293','','default','Total votes: @votes','','none'),('3294','','default','Most recent poll','','none');
INSERT INTO `locales_source` VALUES ('3295','','default','A <em>poll</em> is a question with a set of possible responses. A <em>poll</em>, once created, automatically provides a simple running count of the number of votes received for each response.','','none'),('3296','','default','Poll status','','none'),('3297','','default','When a poll is closed, visitors can no longer vote for it.','','none'),('3298','','default','After this period, the poll will be closed automatically.','','none'),('3299','','default','Negative values are not allowed.','','none'),('3300','','default','Your vote could not be recorded because you did not select any of the choices.','','none'),('3301','','default','Vote count','','none'),('3302','','default','Polls','','none'),('3303','','default','Profile fields have been updated.','','none'),('3304','','default','No fields in this category. If this category remains empty when saved, it will be removed.','','none'),('3305','','default','The name of the field. The form name is not shown to the user but used internally in the HTML code and URLs.\nUnless you know what you are doing, it is highly recommended that you prefix the form name with <code>profile_</code> to avoid name clashes with other fields. Spaces or any other special characters except dash (-) and underscore (_) are not allowed. An example name is "profile_favorite_color" or perhaps just "profile_color".','','none'),('3306','','default','A list of all options. Put each option on a separate line. Example options are "red", "blue", "green", etc.','','none'),('3307','','default','Hidden profile field, only accessible by administrators, modules and themes.','','none'),('3308','','default','Private field, content only available to privileged users.','','none'),('3309','','default','Public field, content shown on profile page but not used on member list pages.','','none'),('3310','','default','Public field, content shown on profile page and on member list pages.','','none'),('3311','','default','The weights define the order in which the form fields are shown. Lighter fields "float up" towards the top of the category.','','none');
INSERT INTO `locales_source` VALUES ('3312','','default','Form will auto-complete while user is typing.','','none'),('3313','','default','For security, auto-complete will be disabled if the user does not have access to user profiles.','','none'),('3314','','default','The specified form name contains one or more illegal characters. Spaces or any other special characters except dash (-) and underscore (_) are not allowed.','','none'),('3315','','default','The specified form name is reserved for use by Drupal.','','none'),('3316','','default','The specified category name is reserved for use by Drupal.','','none'),('3317','','default','The specified title is already in use.','','none'),('3318','','default','The specified name is already in use.','','none'),('3319','','default','A hidden field cannot be required.','','none'),('3320','','default','A hidden field cannot be set to visible on the user registration form.','','none'),('3321','','default','The field has been created.','','none'),('3322','','default','Are you sure you want to delete the field %field?','','7.12'),('3323','','default','This action cannot be undone. If users have entered values into this field in their profile, these entries will also be deleted. If you want to keep the user-entered data, instead of deleting the field you may wish to <a href="@edit-field">edit this field</a> and change it to a hidden profile field so that it may only be accessed by administrators.','','none'),('3324','','default','The field %field has been deleted.','','none'),('3325','','default','Profile field %field added under category %category.','','none'),('3326','','default','Profile field %field deleted.','','none'),('3327','','default','User list','','none'),('3328','','default','single-line textfield','','none'),('3329','','default','multi-line textfield','','none'),('3330','','default','checkbox','','none'),('3331','','default','list selection','','none'),('3332','','default','freeform list','','none'),('3333','','default','Author information','','none'),('3334','','default','Link to full user profile','','none'),('3335','','default','Profile fields to display','','none');
INSERT INTO `locales_source` VALUES ('3336','','default','Select which profile fields you wish to display in the block. Only fields designated as public in the <a href="@profile-admin">profile field configuration</a> are available.','','none'),('3337','','default','View full user profile','','none'),('3338','','default','About %name','','none'),('3339','','default','Put each item on a separate line or separate them by commas. No HTML allowed.','','none'),('3340','','default','The value provided for %field is not a valid URL.','','none'),('3341','','default','Create customizable fields for your users.','','none'),('3342','','default','Profile category autocomplete','','none'),('3343','','default','Edit field','','none'),('3344','','default','Delete field','','none'),('3345','','default','Profile autocomplete','','none'),('3346','','default','Supports configurable user profiles.','','none'),('3347','','default','The index will be rebuilt.','','none'),('3348','','default','Indexing status','','none'),('3349','','default','Indexing throttle','','none'),('3350','','default','Number of items to index per cron run','','none'),('3351','','default','The maximum number of items indexed in each pass of a <a href="@cron">cron maintenance task</a>. If necessary, reduce the number of items to prevent timeouts and memory errors while indexing.','','none'),('3352','','default','Indexing settings','','none'),('3353','','default','<p><em>Changing the settings below will cause the site index to be rebuilt. The search index is not cleared but systematically updated to reflect the new settings. Searching will continue to work but new content won''t be indexed until all existing content has been re-indexed.</em></p><p><em>The default settings should be appropriate for the majority of sites.</em></p>','','none'),('3354','','default','Minimum word length to index','','none'),('3355','','default','The number of characters a word has to be to be indexed. A lower setting means better search result ranking, but also a larger database. Each search query must contain at least one keyword that is this size (or longer).','','none');
INSERT INTO `locales_source` VALUES ('3356','','default','Simple CJK handling','','none'),('3357','','default','Whether to apply a simple Chinese/Japanese/Korean tokenizer based on overlapping sequences. Turn this off if you want to use an external preprocessor for this instead. Does not affect other languages.','','none'),('3358','','default','The search engine maintains an index of words found in your site''s content. To build and maintain this index, a correctly configured <a href="@cron">cron maintenance task</a> is required. Indexing behavior can be adjusted using the settings below.','','none'),('3359','','default','Top search phrases','','7.12'),('3360','','default','View most popular search phrases.','','7.12'),('3361','','default','Enables site-wide keyword searching.','','7.12'),('3362','','default','Total page generation time','','none'),('3363','','default','%time ms','','none'),('3364','','default','Top pages in the past %interval','','none'),('3365','','default','Top visitors in the past %interval','','none'),('3366','','default','Top referrers in the past %interval','','none'),('3367','','default','Log each page access. Required for referrer statistics.','','none'),('3368','','default','Older access log entries (including referrer statistics) will be automatically discarded. (Requires a correctly configured <a href="@cron">cron maintenance task</a>.)','','none'),('3369','','default','Content viewing counter settings','','none'),('3370','','default','Count content views','','none'),('3371','','default','Increment a counter each time content is viewed.','','none'),('3372','','default','Settings for the statistical information that Drupal will keep about the site. See <a href="@statistics">site statistics</a> for the actual information.','','none'),('3373','','default','This page displays the site''s most recent hits.','','none'),('3374','','default','This page displays all external referrers, or external references to your website.','','none'),('3375','','default','When you ban a visitor, you prevent the visitor''s IP address from accessing your site. Unlike blocking a user, banning a visitor works even for anonymous users. This is most commonly used to block resource-intensive bots or web crawlers.','','none');
INSERT INTO `locales_source` VALUES ('3376','','default','Popular content','','none'),('3377','','default','How many content items to display in "all time" list.','','none'),('3378','','default','How many content items to display in "recently viewed" list.','','none'),('3379','','default','Today''s:','','none'),('3380','','default','All time:','','none'),('3381','','default','Last viewed:','','none'),('3382','','default','View pages that have recently been visited.','','none'),('3383','','default','View pages that have been hit frequently.','','none'),('3384','','default','Top visitors','','none'),('3385','','default','View visitors that hit many pages.','','none'),('3386','','default','Top referrers','','none'),('3387','','default','View top referrers.','','none'),('3388','','default','View access log.','','none'),('3389','','default','Track page visits','','none'),('3390','','default','Logs access statistics for your site.','','7.12'),('3391','','default','Logs and records system events to syslog.','','7.12'),('3392','','default','User pictures in posts','','7.12'),('3393','','default','User pictures in comments','','7.12'),('3394','','default','Shortcut icon','','7.12'),('3395','','default','Logo image settings','','7.12'),('3396','','default','If toggled on, the following logo will be displayed.','','7.12'),('3397','','default','Use the default logo','','7.12'),('3398','','default','Check here if you want the theme to use the logo supplied with it.','','7.12'),('3399','','default','The path to the file you would like to use as your logo file instead of the default logo.','','7.12'),('3400','','default','Upload logo image','','7.12'),('3401','','default','Shortcut icon settings','','7.12'),('3402','','default','Your shortcut icon, or ''favicon'', is displayed in the address bar and bookmarks of most browsers.','','7.12'),('3403','','default','Use the default shortcut icon.','','7.12'),('3404','','default','Check here if you want the theme to use the default shortcut icon.','','7.12'),('3405','','default','The path to the image file you would like to use as your custom shortcut icon.','','7.12');
INSERT INTO `locales_source` VALUES ('3406','','default','Upload icon image','','7.12'),('3407','','default','If you don''t have direct file access to the server, use this field to upload your shortcut icon.','','7.12'),('3408','','default','@module (<span class="admin-missing">missing</span>)','','7.12'),('3409','','default','The following modules will be completely uninstalled from your site, and <em>all data from these modules will be lost</em>!','','7.12'),('3410','','default','Confirm uninstall','','7.12'),('3411','','default','Would you like to continue with uninstalling the above?','','7.12'),('3412','','default','No modules selected.','','none'),('3413','','default','The selected modules have been uninstalled.','','7.12'),('3414','','default','Default 403 (access denied) page','','7.12'),('3415','','default','Default 404 (not found) page','','7.12'),('3416','','default','Caches cleared.','','7.12'),('3417','','default','Select an image processing toolkit','','none'),('3418','','default','Number of items in each feed','','none'),('3419','','default','Default number of items to include in each feed.','','none'),('3420','','default','Feed content','','none'),('3421','','default','Titles plus teaser','','none'),('3422','','default','Global setting for the default display of content items in each feed.','','none'),('3423','','default','Cron ran successfully.','','7.12'),('3424','','default','Cron run failed.','','7.12'),('3425','','default','No modules are available to uninstall.','','7.12'),('3426','','default','This theme requires PHP version @php_required and is incompatible with PHP version !php_version.','','none'),('3427','','default','This page shows you all available administration tasks for each module.','','7.10'),('3428','','default','These options control the default display settings for your entire site, across all themes. Unless they have been overridden by a specific theme, these settings will be used.','','7.12'),('3429','','default','The <em>Powered by Drupal</em> block is an optional link to the home page of the Drupal project. While there is absolutely no requirement that sites feature this link, it may be used to show support for Drupal.','','none');
INSERT INTO `locales_source` VALUES ('3430','','default','Here you can find a short overview of your site''s parameters as well as any problems detected with your installation. It may be useful to copy and paste this information into support requests filed on drupal.org''s support forums and project issue queues.','','7.12'),('3431','','default','Powered by Drupal','','7.12'),('3432','','default','Could not delete temporary file "%path" during garbage collection','','none'),('3433','','default','Compact mode','','none'),('3434','','default','Tell Drupal where to store uploaded files and how they are accessed.','','7.12'),('3435','','default','Image toolkit','','7.12'),('3436','','default','Choose which image toolkit to use if you have installed optional toolkits.','','7.12'),('3437','','default','RSS publishing','','7.12'),('3438','','default','Date and time','','7.12'),('3439','','default','Date and time lookup','','none'),('3440','','default','Enable or disable clean URLs for your site.','','7.12'),('3441','','default','Clean URL check','','7.12'),('3442','','default','Get a status report about your site''s operation and any detected problems.','','7.12'),('3443','','default','-1 (Unlimited)','','none'),('3444','','default','Your PHP installation is too old. Drupal requires at least PHP %version.','','none'),('3445','','default','PHP register globals','','7.12'),('3446','','default','<em>register_globals</em> is enabled. Drupal requires this configuration directive to be disabled. Your site may not be secure when <em>register_globals</em> is enabled. The PHP manual has instructions for <a href="http://php.net/configuration.changes">how to change configuration settings</a>.','','none'),('3447','','default','Enabled (''@value'')','','none'),('3448','','default','PHP memory limit','','7.12'),('3449','','default','Consider increasing your PHP memory limit to %memory_minimum_limit to help prevent errors in the installation process.','','none'),('3450','','default','Consider increasing your PHP memory limit to %memory_minimum_limit to help prevent errors in the update process.','','none');
INSERT INTO `locales_source` VALUES ('3451','','default','Depending on your configuration, Drupal can run with a %memory_limit PHP memory limit. However, a %memory_minimum_limit PHP memory limit or above is recommended, especially if your site uses additional custom or contributed modules.','','none'),('3452','','default','Increase the memory limit by editing the memory_limit parameter in the file %configuration-file and then restart your web server (or contact your system administrator or hosting provider for assistance).','','none'),('3453','','default','Contact your system administrator or hosting provider for assistance with increasing your PHP memory limit.','','none'),('3454','','default','See the <a href="@url">Drupal requirements</a> for more information.','','none'),('3455','','default','Not protected','','7.12'),('3456','','default','The file %file is not protected from modifications and poses a security risk. You must change the file''s permissions to be non-writable.','','7.12'),('3457','','default','For more information, see the online handbook entry for <a href="@cron-handbook">configuring cron jobs</a>.','','7.12'),('3458','','default','Cron has not run recently.','','none'),('3459','','default','Cron maintenance tasks','','7.12'),('3460','','default','You can <a href="@cron">run cron manually</a>.','','7.12'),('3461','','default','The directory %directory is not writable.','','7.12'),('3462','','default','You may need to set the correct directory at the <a href="@admin-file-system">file system settings page</a> or change the current directory''s permissions so that it is writable.','','7.12'),('3463','','default','Writable (<em>public</em> download method)','','7.12'),('3464','','default','Writable (<em>private</em> download method)','','none'),('3465','','default','Database updates','','7.12'),('3466','','default','Some modules have database schema updates to install. You should run the <a href="@update">database update script</a> immediately.','','none'),('3467','','default','The update.php script is accessible to everyone without authentication check, which is a security risk. You must change the $update_free_access value in your settings.php back to FALSE.','','none');
INSERT INTO `locales_source` VALUES ('3468','','default','Access to update.php','','7.12'),('3469','','default','Handles general site configuration for administrators.','','7.12'),('3470','','default','Reset to alphabetical','','7.12'),('3471','','default','Terms are displayed in ascending order by weight.','','7.12'),('3472','','default','Weight value must be numeric.','','none'),('3473','','default','Are you sure you want to reset the vocabulary %title to alphabetical order?','','none'),('3474','','default','Resetting a vocabulary will discard all custom ordering and sort items alphabetically.','','none'),('3475','','default','Reset vocabulary %name to alphabetical order.','','none'),('3476','','default','Translations of a piece of content are managed with translation sets. Each translation set has one source post and any number of translations in any of the <a href="!languages">enabled languages</a>. All translations are tracked to be up to date or outdated based on whether the source post was modified significantly.','','none'),('3477','','default','Translation settings','','none'),('3478','','default','Flag translations as outdated','','none'),('3479','','default','If you made a significant change, which means translations should be updated, you can flag all translations of this post as outdated. This will not change any other property of those posts, like whether they are published or not.','','none'),('3480','','default','This translation needs to be updated','','none'),('3481','','default','When this option is checked, this translation needs to be updated because the source post has changed. Uncheck when the translation is up to date again.','','none'),('3482','','default','Content translation','','none'),('3483','','default','Allows content to be translated into different languages.','','7.12'),('3484','','default','Unknown release date','','none'),('3485','','default','Last checked: @time ago','','7.12'),('3486','','default','Last checked: never','','none'),('3487','','default','Includes: %includes','','7.12'),('3488','','default','Disabled modules','','7.12');
INSERT INTO `locales_source` VALUES ('3489','','default','Disabled themes','','7.12'),('3490','','default','Select how frequently you want to automatically check for new releases of your currently installed modules and themes.','','none'),('3491','','default','E-mail notification threshold','','none'),('3492','','default','You can choose to send e-mail only if a security update is available, or to be notified about all newer versions. If there are updates available of Drupal core or any of your installed modules and themes, your site will always print a message on the <a href="@status_report">status report</a> page, and will also display an error message on administration pages if there is a security update.','','none'),('3493','','default','Here you can find information about available updates for your installed modules and themes. Note that each module or theme is part of a "project", which may or may not have the same name, and might include multiple modules or themes within it.','','7.12'),('3494','','default','Module and theme update status','','7.12'),('3495','','default','There are security updates available for one or more of your modules or themes. To ensure the security of your server, you should update immediately!','','7.12'),('3496','','default','There are updates available for one or more of your modules or themes. To ensure the proper functioning of your site, you should update as soon as possible.','','7.12'),('3497','','default','Get a status report about available updates for your installed modules and themes.','','7.12'),('3498','','default','Notify user when account is activated.','','7.12'),('3499','','default','Notify user when account is blocked.','','7.12'),('3500','','default','Picture guidelines','','7.12'),('3501','','default','This text is displayed at the picture upload form in addition to the default guidelines. It''s useful for helping or instructing your users.','','7.12'),('3502','','default','The name for this role. Example: "moderator", "editorial board", "site architect".','','none'),('3503','','default','The role has been renamed.','','none');
INSERT INTO `locales_source` VALUES ('3504','','default','The role has been deleted.','','none'),('3505','','default','E-mail new password','','7.12'),('3506','','default','Sorry, %name is not recognized as a user name or an e-mail address.','','7.12'),('3507','','default','Further instructions have been sent to your e-mail address.','','7.12'),('3508','','default','%name has been deleted.','','7.12'),('3509','','default','You must enter a username.','','none'),('3510','','default','The username cannot begin with a space.','','none'),('3511','','default','The username cannot end with a space.','','none'),('3512','','default','The username cannot contain multiple spaces in a row.','','none'),('3513','','default','The username contains an illegal character.','','7.12'),('3514','','default','The username %name is too long: it must be %max characters or less.','','none'),('3515','','default','You must enter an e-mail address.','','none'),('3516','','default','Who''s online','','7.12'),('3517','','default','User list length','','none'),('3518','','default','Enter the password that accompanies your username.','','7.12'),('3519','','default','Signature settings','','7.12'),('3520','','default','Delete picture','','7.12'),('3521','','default','Check this box to delete your current picture.','','7.12'),('3522','','default','Unblock the selected users','','7.12'),('3523','','default','Block the selected users','','7.12'),('3524','','default','This web page allows administrators to register new users. Users'' e-mail addresses and usernames must be unique.','','7.12'),('3525','','default','Enter a simple pattern ("*" may be used as a wildcard match) to search for a username or e-mail address. For example, one may search for "br" and Drupal might return "brian", "brad", and "brenda@example.com".','','none'),('3526','','default','Deleted user: %name %email.','','7.12'),('3527','','default','Determine access to features by selecting permissions for roles.','','7.12'),('3528','','default','Edit role','','none'),('3529','','default','Manages the user registration and login system.','','7.12'),('3530','','default','Garland','','none');
INSERT INTO `locales_source` VALUES ('3531','','default','Run the clean URL test','','7.12'),('3532','','default','The title is used as a tool tip when the user hovers the mouse over the image.','','7.12'),('3533','','default','Progress indicator','','7.12'),('3534','','default','Bar with progress meter','','7.12'),('3535','','default','Throbber','','7.12'),('3536','','default','The file upload failed. %upload','','none'),('3537','','default','URL to file','','7.12'),('3538','','default','An unrecoverable error occurred. The uploaded file likely exceeded the maximum file size (@size) that this server supports.','','7.12'),('3539','','default','Starting upload...','','none'),('3540','','default','Uploading... (@current of @total)','','none'),('3541','','default','Your server is capable of displaying file upload progress, but does not have the required libraries. It is recommended to install the <a href="http://pecl.php.net/package/uploadprogress">PECL uploadprogress library</a> (preferred) or to install <a href="http://us2.php.net/apc">APC</a>.','','7.12'),('3542','','default','Your server is capable of displaying file upload progress using APC RFC1867. Note that only one upload at a time is supported. It is recommended to use the <a href="http://pecl.php.net/package/uploadprogress">PECL uploadprogress library</a> if possible.','','none'),('3543','','default','Your server is not capable of displaying file upload progress. File upload progress requires PHP be run with mod_php and not as FastCGI.','','none'),('3544','','default','Your server is capable of displaying file upload progress through APC, but it is not enabled. Add <code>apc.rfc1867 = 1</code> to your php.ini configuration. Alternatively, it is recommended to use <a href="http://pecl.php.net/package/uploadprogress">PECL uploadprogress</a>, which supports more than one simultaneous upload.','','none'),('3545','','default','Enabled (<a href="http://php.net/manual/en/apc.configuration.php#ini.apc.rfc1867">APC RFC1867</a>)','','none'),('3546','','default','Enabled (<a href="http://pecl.php.net/package/uploadprogress">PECL uploadprogress</a>)','','7.12');
