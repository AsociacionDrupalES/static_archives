INSERT INTO `locales_source` VALUES ('6731','','default','The unique authentication name.','','7.12'),('6732','','default','The name of the module managing the authentication entry.','','7.12'),('6733','','default','Use absolute link (begins with "http://")','','none'),('6734','','default','Output machine name','','none'),('6735','','default','Use Drupal''s taxonomy term path to create breadcrumb links','','none'),('6736','','default','If selected, the links in the breadcrumb trail will be created using the standard drupal method instead of the custom views method. This is useful if you are using modules like taxonomy redirect to modify your taxonomy term links.','','none'),('6737','','default','Change the CSS class name(s) that will be added to this display.','','7.12'),('6738','','default','The CSS class names will be added to the view. This enables you to use specific CSS code for each view. You may define multiples classes separated by spaces.','','none'),('6739','','default','CSS classes must be alphanumeric or dashes only.','','none'),('6740','','default','Choose text','','7.12'),('6741','','default','The text that will appear as the selected option in the jump menu.','','7.12'),('6742','','default','Term edit link','','7.12'),('6743','','default','Provide a simple link to edit the term.','','7.12'),('6744','','default','Set between which values the user can choose when determining the items per page. Separated by comma.','','7.12'),('6745','','default','When checked, users can determine how many items should be skipped at the beginning.','','7.12'),('6746','','default','Please insert a list of integer numeric values separated by commas: e.g: 10, 20, 50, 100','','none'),('6747','','default','Handler @handler tried to add additional_field @identifier but @table could not be added!','','none'),('6748','','default','Fill up single line','','7.12'),('6749','','default','Row class','','7.12'),('6750','','default','- Use default -','','7.12'),('6751','','default','U