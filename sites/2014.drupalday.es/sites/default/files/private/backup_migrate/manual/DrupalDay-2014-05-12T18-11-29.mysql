INSERT INTO `locales_target` VALUES ('2903','Importando traducciones de la interfaz','es','0','0','0'),('2904','Empezando la importación','es','0','0','0'),('2905','Error al importar las traducciones de la interfaz','es','0','0','0'),('2906','Se ha intentado enviar un texto de traducción con HTML no permitido:%string','es','0','0','0'),('2907','El idioma %language (%code) ha sido creado.','es','0','0','0'),('2908','Se ha importado %file en %locale: Añadidos %number textos nuevos, %update se han actualizado y se han borrado %delete.','es','0','0','0'),('2909','Se exportó el archivo de traducción de %locale con el nombre %filename.','es','0','0','0'),('2910','Se exportó el archivo de traducción: %filename.','es','0','0','0'),('2911','Archivo de traducción de JavaScript actualizado para el idioma %language.','es','0','0','0'),('2912','Creado archivo de traducción JavaScript para el idioma %language.','es','0','0','0'),('2913','Borrado archivo de traducción JavaScript para el idioma %language, porque actualmente no existen traducciones para ese idioma.','es','0','0','0'),('2914','Ocurrió un error durante la creación de la traducción de un archivo JavaScript para el idioma %language.','es','0','0','0'),('2915','Se ha descartado un texto de traducción porque contiene HTML no permitido.','es','0','0','0'),('2916','Se han descartado @count textos de traducción porque contienen HTML no permitido.','es','2915','1','0'),('2917','Se ha importado un documento de traducción para los módulos recién instalados.','es','0','0','0'),('2918','Se ha importado @count documentos de traducción para los módulos recién instalados.','es','2917','1','0'),('2919','Se han importado 1 documento de traducción para los módulos activados.','es','0','0','0'),('2920','Se han importado @count documentos de traducción para los módulos activados.','es','2919','1','0'),('2921','Abjasio','es','0','0','0'),('2922','Avéstico','es','0','0','0'),('2923','Afrikáans','es','0','0','0'),('2924','Akan','es','0','0'