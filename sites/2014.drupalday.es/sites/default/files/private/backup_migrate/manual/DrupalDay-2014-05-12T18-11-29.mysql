INSERT INTO `locales_source` VALUES ('11815','/admin/commerce/config/order/fields','default','Información de usuario','','7.12'),('11816','/admin/commerce/config/product-pricing','default','Enabled sell price calculation rules','','7.12'),('11817','/admin/commerce/config/product-pricing','default','There are no active sell price calculation rules.','','7.12'),('11818','/admin/commerce/config/product-pricing','default','Disabled sell price calculation rules','','7.12'),('11819','/admin/commerce/config/product-pricing','default','There are no disabled sell price calculation rules.','','7.12'),('11820','/admin/commerce/config/product-pricing','default','Prior to purchase, product sell prices are calculated using the rule configurations listed below. Pricing rules can be used for things like discounts, price lists, currency conversions, and tax application depending on the Rules elements defined by your enabled modules. To apply the enabled pricing rules on product display, you must ensure the display formatter settings for your product price fields are configured to display the <em>Calculated sell price for the current user</em>.','','7.12'),('11821','','default','Use replacement tokens from the first row','','7.12'),('11822','/admin/structure/views/ajax/add-item/tienda/page/header','default','The following tokens are available. If you would like to have the characters %5B and %5D please use the html entity codes ''%5B'' or  ''%5D'' or they will get replaced with empty space.)</p>','','7.12'),('11823','/admin/structure/views/view/tienda/edit','default','Incripción','','7.12'),('11824','/admin/structure/views/view/tienda/edit','default','Desde aquí puedes comprar tu entrada como asistente normal o colaborar un poco más allá comprando una entrada espacial que aportará una donación extra....\n\nBle ble ble','','7.12'),('11825','/admin/structure/views/view/tienda/edit','default','<p><strong>[title]</strong></p>\n<p>[body]</p>','','7.12'),('11826','/admin/structure/views/vi