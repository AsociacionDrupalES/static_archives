INSERT INTO `locales_source` VALUES ('13291','','default','Mail System Settings','','7.12'),('13292','','default','Email settings','','7.12'),('13293','/admin/modules','default','Mail System','','7.12'),('13294','/admin/modules','default','Configure per-module Mail System settings.','','7.12'),('13295','/admin/modules','default','Mime Mail','','7.12'),('13296','/admin/modules','default','Manage mime mail system settings.','','7.12'),('13297','/admin/config/system/mailsystem','default','!module module','','7.12'),('13298','/admin/config/system/mailsystem','default','Drupal provides a default <a href="!interface"><code>@interface</code></a> class called <a href="!default_class"><code>@default_class</code></a>. Modules may provide additional classes. Each <a href="!interface"><code>@interface</code></a> class may be associated with one or more identifiers, composed of a %module and an optional %key. Each email being sent also has a %module and a %key. To decide which class to use, Drupal uses the following search order: <ol><li>The class associated with the %module and %key, if any.</li><li>The class associated with the %module, if any.</li><li>The site-wide default <a href="!interface"><code>@interface</code></a> class.</li></ol>','','7.12'),('13299','/admin/config/system/mailsystem','default','Site-wide default <a href="!interface"><code>@interface</code></a> class','','7.12'),('13300','/admin/config/system/mailsystem','default','Remove this setting.','','7.12'),('13301','/admin/config/system/mailsystem','default','Theme to render the emails','','7.12'),('13302','/admin/config/system/mailsystem','default','Select the theme that will be used to render the emails. This can be either the current theme, the default theme, the domain theme or any active theme.','','7.12'),('13303','/admin/config/system/mailsystem','default','New Class','','7.12'),('13304','/admin/config/system/mailsystem','default','Create a new <a href="!interface"><code>@interface</code></a> that inherits its methods from other classes. The new class will be named after the other classes it uses.','','7.12');
INSERT INTO `locales_source` VALUES ('13305','/admin/config/system/mailsystem','default','Class to use for the <a href="!format"><code>@format</code></a> method','','7.12'),('13306','/admin/config/system/mailsystem','default','Class to use for the <a href="!mail"><code>@mail</code></a> method','','7.12'),('13307','/admin/config/system/mailsystem','default','New Setting','','7.12'),('13308','/admin/config/system/mailsystem','default','Add a new %module and %key to the settings list.','','7.12'),('13309','/admin/config/system/mailsystem','default','-- Select --','','7.12'),('13310','/admin/config/system/mimemail','default','The name that all site emails will be from when using default engine.','','7.12'),('13311','/admin/config/system/mimemail','default','The email address that all site e-mails will be from when using default engine.','','7.12'),('13312','/admin/config/system/mimemail','default','Use simple address format','','7.12'),('13313','/admin/config/system/mimemail','default','Use the simple format of user@example.com for all email addresses.','','7.12'),('13314','/admin/config/system/mimemail','default','Include site style sheets','','7.12'),('13315','/admin/config/system/mimemail','default','Gather all style sheets when no mail.css found in the default theme directory.','','7.12'),('13316','/admin/config/system/mimemail','default','Send plain text email only','','7.12'),('13317','/admin/config/system/mimemail','default','This option disables the use of email messages with graphics and styles. All messages will be converted to plain text.','','7.12'),('13318','/admin/config/system/mimemail','default','Link images only','','7.12'),('13319','/admin/config/system/mimemail','default','This option disables the embedding of images. All image will be available as external content. This can make email messages much smaller.','','7.12'),('13320','/admin/config/system/mimemail','default','E-mail format','','7.12'),('13321','/admin/config/system/mimemail','default','Process incoming messages posted to this site','','7.12'),('13322','/admin/config/system/mimemail','default','This is an advanced setting that should not be enabled unless you know what you are doing.','','7.12');
INSERT INTO `locales_source` VALUES ('13323','/admin/config/system/mimemail','default','Message validation string','','7.12'),('13324','/admin/config/system/mimemail','default','This string will be used to validate incoming messages. It can be anything, but must be used on both sides of the transfer.','','7.12'),('13325','/admin/config/system/mimemail','default','Default mailing engine.','','7.12'),('13326','/node/52/webform-results/download','default','Choose which part of options should be displayed from key|value pairs.','','7.12'),('13327','/node/52/webform-results/download','default','Separate','','7.12'),('13328','/node/52/webform-results/download','default','Submission Number','','7.12'),('13329','/node/52/webform-results/download','default','The selected components will be included in the export.','','7.12'),('13330','/node/52/webform-results/download','default','Download range options','','7.12'),('13331','/node/52/webform-results/download','default','All submissions','','7.12'),('13332','/node/52/webform-results/download','default','Only new submissions since your last download','','7.12'),('13333','/node/52/webform-results/download','default','Only the latest','','7.12'),('13334','/node/52/webform-results/download','default','All submissions starting from','','7.12'),('13335','/node/52/webform-results/download','default','Separate options are more suitable for building reports, graphs, and statistics in a spreadsheet application.','','7.12'),('13336','/node/52/webform-results/download','default','My select list','','7.12'),('13337','/node/52/webform-results/download','default','Compact options are more suitable for importing data into other systems.','','7.12'),('13338','/node/52/webform-results/download','default','@count total','','7.12'),('13339','/node/52/webform-results/download','default','@count new since @date','','7.12'),('13340','/node/52/webform-results/download','default','Only the latest !number submissions','','7.12'),('13341','/node/52/webf