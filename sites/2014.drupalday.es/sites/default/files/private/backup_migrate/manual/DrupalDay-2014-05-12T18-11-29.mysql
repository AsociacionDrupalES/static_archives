INSERT INTO `locales_source` VALUES ('12621','','default','A source cannot be backed up to itself. Please pick a different destination for this backup.','','none'),('12622','','default','Pick a name for the settings. Your settings will be saved as a profile and will appear in the <a href="!url">Profiles Tab</a>.','','none'),('12623','','default','Restore to','','none'),('12624','','default','<a href="!restoreurl">Restore again</a>','','none'),('12625','','default','The filter settings for the profile.','','none'),('12626','','default','The {backup_migrate_destination}.destination_id of the source to backup from.','','none'),('12627','','default','Default Schedule','','none'),('12628','','default','The db source to backup from.','','none'),('12629','','default','Unable to move the backups directory to your private folder, please check file permissions and move the directory %from to %to','','none'),('12630','','default','Subdirectory','','none'),('12631','','default','Due to drupal.org code hosting policies, the S3 library needed to use an S3 destination is no longer distributed with this module. You must download the library from !link and place it in the includes directory in the Backup and Migrate module directory.','','none'),('12632','','default','Title tag','','none'),('12633','','default','Inset','','none'),('12634','','default','Outset','','none'),('12635','','default','Node form file attachments','','none'),('12636','','default','File attachments on the Node form.','','none'),('12637','','default','Node form book options','','none'),('12638','','default','Sibling terms','','none'),('12639','','default','If checked, the terms are displayed in a tree, otherwise in a flat list.','','none'),('12640','','default','Input on pane config','','none'),('12641','','default','Adds a book parent from a node context.','','none'),('12642','','default','Adds a taxonomy term from a node context; if multiple terms are selected, this will get the "first" term only.','','none')