INSERT INTO `locales_source` VALUES ('9822','/dday/admin/structure/types/manage/page/fields','default','Perfil de Drupal.org','','7.12'),('9823','/dday/admin/structure/types/manage/page/fields','default','Twitter','','7.12'),('9824','/dday/admin/structure/types/manage/page/fields','default','LinkedIn','','7.12'),('9825','/dday/admin/structure/types/manage/page/fields','default','DNI','','7.12'),('9826','/dday/admin/config/regional/language/edit/es','default','Language code or other custom text to use as a path prefix for URL language detection, if your <em>Detection and selection</em> settings use URL path prefixes. For the default language, this value may be left blank. <strong>Modifying this value may break existing URLs. Use with caution in a production environment.</strong> Example: Specifying "deutsch" as the path prefix code for German results in URLs like "example.com/deutsch/contact".','','7.12'),('9827','/dday/admin/config/regional/language/edit/es','default','The domain name to use for this language if URL domains are used for <em>Detection and selection</em>. Leave blank for the default language. <strong>Changing this value may break existing URLs.</strong> Example: Specifying "de.example.com" as language domain for German will result in an URL like "http://de.example.com/contact".','','7.12'),('9828','/dday/admin/modules','default','Disables theme default system messages variable and creates a block to show them. The block then can be positioned in any theme region as usual.','','7.10'),('9829','/dday/admin/modules/list/confirm','default','System messages','','7.12'),('9830','/dday/admin/people','default','access backup and migrate','','7.12'),('9831','/dday/admin/people','default','access backup files','','7.12'),('9832','/dday/admin/people','default','administer backup and migrate','','7.12'),('9833','/dday/admin/people','default','delete backup files','','7.12'),('9834','/dday/admin/people','default','perform backup','','7.12'),('9835','/dday/admin/people','default','restore from backup','','7.12'),('9836','/dday/admin/structure/views/view/imagen/edit/block_1','default','Block960 random','','7.10');
INSERT INTO `locales_source` VALUES ('9837','/dday/admin/structure/types/manage/page/fields','default','Texto largo','','7.12'),('9838','/dday/admin/structure/types/manage/page/fields','default','Área de texto (varias filas)','','7.12'),('9839','/dday/filter/tips','default','If you do encounter problems, try using HTML character entities. A common example looks like &amp;amp; for an ampersand &amp; character. For a full list of entities see HTML''s <a href="@html-entities">entities</a> page. Some of the available characters include:','','7.12'),('9840','','default','Fieldgroup','','7.12'),('9841','/dday/admin/modules/list/confirm','default','Table that contains field group entries and settings.','','7.12'),('9842','/dday/admin/modules/list/confirm','default','Administer fieldgroups','','7.12'),('9843','/dday/admin/modules/list/confirm','default','Display the administration for fieldgroups.','','7.12'),('9844','/dday/admin/modules/list/confirm','default','Language settings for the user account.','','7.12'),('9845','/dday/admin/structure/types/manage/page/fields','default','Div','','7.12'),('9846','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders the inner content in a simple div with the titel as legend.','','7.12'),('9847','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders the inner content in a fieldset with the titel as legend.','','7.12'),('9848','/dday/admin/structure/types/manage/page/fields','default','Vertical tabs group','','7.12'),('9849','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders child groups in its own vertical tabs wrapper.','','7.12'),('9850','/dday/admin/structure/types/manage/page/fields','default','Vertical tab','','7.12'),('9851','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders the content in a fieldset, part of vertical tabs group.','','7.12'),('9852','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders child groups in its own horizontal tabs wrapper.','','7.12');
INSERT INTO `locales_source` VALUES ('9853','/dday/admin/structure/types/manage/page/fields','default','Horizontal tab item','','7.12'),('9854','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders the content in a fieldset, part of horizontal tabs group.','','7.12'),('9855','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders groups on separate pages.','','7.12'),('9856','/dday/admin/structure/types/manage/page/fields','default','Multipage','','7.12'),('9857','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders the content in a page.','','7.12'),('9858','/dday/admin/structure/types/manage/page/fields','default','Accordion group','','7.12'),('9859','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders child groups as jQuery accordion.','','7.12'),('9860','/dday/admin/structure/types/manage/page/fields','default','Accordion item','','7.12'),('9861','/dday/admin/structure/types/manage/page/fields','default','This fieldgroup renders the content in a div, part of accordion group.','','7.12'),('9862','','default','Add new group','','7.12'),('9863','/dday/admin/structure/types/manage/page/fields','default','Weight for new group','','7.12'),('9864','','default','Group name (a-z, 0-9, _)','','7.12'),('9865','','default','Fieldgroups','','7.12'),('9866','/dday/admin/structure/types/manage/page/fields','default','<p class="fieldgroup-help">Fields can be dragged into groups with unlimited nesting. Each fieldgroup format comes with a configuration form, specific for that format type.<br />Note that some formats come in pair. These types have a html wrapper to nest its fieldgroup children. E.g. Place accordion items into the accordion, vertical tabs in vertical tab group and horizontal tabs in the horizontal tab group. There is one exception to this rule, you can use a vertical tab without a wrapper when the additional settings tabs are available. E.g. node forms.</p>','','7.12'),('9867','/dday/admin/structure/types/manage/page/fields','default','Select source view mode or form','','7.12');
INSERT INTO `locales_source` VALUES ('9868','/dday/admin/structure/types/manage/page/fields','default','Clone fieldgroups from selected view mode to the current display','','7.12'),('9869','/dday/admin/structure/types/manage/page/fields','default','New group %label successfully created.','','7.12'),('9870','','default','Field group label','','7.12'),('9871','/dday/admin/structure/types/manage/page/fields','default','Fieldgroup settings','','7.12'),('9872','/dday/admin/structure/types/manage/page/fields','default','Mark group for required fields.','','7.12'),('9873','','default','Extra CSS classes','','7.12'),('9874','/dday/admin/structure/types/manage/page/fields','default','Attribución','','7.12'),('9875','/dday/admin/structure/views/ajax/add-item/imagen/block_3/field','default','Enlace','','7.12'),('9876','/dday/admin/structure/views/ajax/add-item/imagen/block_3/field','default','Enlace Licencia','','7.12'),('9877','/dday/admin/structure/views/ajax/add-item/imagen/block_3/field','default','Nombre Licencia','','7.12'),('9878','/dday/admin/structure/views/ajax/add-item/imagen/block_3/field','default','Título obra','','7.12'),('9879','/dday/admin/structure/views/ajax/add-item/imagen/block_3/field','default','Texto personalizado','','7.12'),('9880','/dday/admin/structure/views/view/imagen/edit/block_2','default','Block960 first','','7.10'),('9881','/dday/','default','La fotografía de la cabecera es una adaptación de la obra <a href="[field_attribution_link]" rel="nofollow">[field_attribution_title] por [field_attribution_name]</a>, disponible bajo licencia <a href="[field_attribution_license_link]" rel="nofollow">[field_attribution_license_name]</a>.','','7.12'),('9882','/dday/admin/structure/views/view/imagen/edit/block_3','default','Licencia960','','7.10'),('9883','/index.php','default','''!name'' cache was cleared','','7.12'),('9884','/admin/modules','default','Manage settings for how font providers work. (Apply site fonts <a href="/admin/appearance/fontyourface">under themes</a>.)','','7.12'),('9885','/admin/people','default','administer fieldgroups','','7.12');
INSERT INTO `locales_source` VALUES ('9886','/admin/modules','default','Disables theme default system messages variable and creates a block to show them. The block then can be positioned in any theme region as usual','','7.12'),('9887','/admin/modules/list/confirm','default','Contact user element','','7.12'),('9888','/admin/modules','default','Provides yet another tool in the arsenal against spam.','','7.12'),('9889','','default','Spam control','','7.12'),('9890','/admin/modules/list/confirm','default','Spamicide','','7.12'),('9891','/admin/modules/list/confirm','default','Already blocked @counter form submissions','','7.12'),('9892','/admin/modules/list/confirm','default','Administer Spamicide protection of Drupal''s forms','','7.12'),('9893','/admin/modules/list/confirm','default','Select the known forms to protect with spamicide, and make administration links available on other forms not yet known to spamicide','','7.12'),('9894','/admin/modules','default','Spamicide is intended to prevent spam without user interaction. Select the forms you''d like to attach spamicide to and a form field will be added but hidden by css. If the field is filled by anything (including humans that think they know better) it will prevent submission into you site.','','7.12'),('9895','/admin/modules','default','To add Spamicide to a form once you''ve enabled adding admin links, navigate to that form, and click the link "Add Spamicide protection to this form"','','7.12'),('9896','/admin/modules','default','Administer how and where Spamicide is used.','','7.12'),('9897','/admin/config/spamicide','default','Add Spamicide administration links to forms','','7.12'),('9898','/admin/config/spamicide','default','administer spamicide','','7.12'),('9899','/admin/config/spamicide','default','This option will allow enabling/disabling Spamicide on forms. When enabled, users with the ''%adminspamicide'' permission will see Spamicide administration links on all forms (except on administrative pages, which shouldn''t be accessible to untrusted users in the first place). These links make it possible to enable or disable it for the desired type.','','7.12');
INSERT INTO `locales_source` VALUES ('9900','/admin/config/spamicide','default','Log attempts','','7.12'),('9901','','default','log','','7.12'),('9902','/admin/config/spamicide','default','Report information about attempts to the !dblog.','','7.12'),('9903','/admin/config/spamicide','default','Spamicide Directory','','7.12'),('9904','/admin/config/spamicide','default','Set the spamicide directory name to further hide it''s signature.','','7.12'),('9905','/admin/config/spamicide','default','Add Spamicide to a form or remove an added form','','7.12'),('9906','/admin/config/spamicide','default','Select from the listed forms (identified by their <strong>form_id</strong>''s). You can easily add arbitrary forms with the help of the <strong>''Add Spamicide administration links to forms''</strong> option above then navigating to any form.','','7.12'),('9907','/admin/config/spamicide','default','The spamicide module provides the ability to prevent spam being submitted to your site on various drupal forms','','7.12'),('9908','/admin/config/spamicide','default','Form_id','','7.12'),('9909','/admin/config/spamicide','default','Form field name','','7.12'),('9910','/admin/people','default','administer contact forms','','7.12'),('9911','/admin/people','default','access site-wide contact form','','7.12'),('9912','/admin/people','default','access user contact forms','','7.12'),('9913','/','default','Add Spamicide protection to this form.','','7.12'),('9914','/','default','To prevent automated spam submissions leave this field empty.','','7.12'),('9915','/node/1/edit','default','spamicide','','7.12'),('9916','/admin/structure/views/add','default','Noticias','','7.12'),('9917','/admin/structure/views/add','default','Noticias destacadas','','7.12'),('9918','/admin/structure/views/add','default','Noticia','','7.12'),('9919','/admin/modules','default','Allows to edit content with client-side editors.','','7.12'),('9920','/admin/modules/list/confirm','default','Wysiwyg profile','','7.12'),('9921','/admin/modules/list/confirm','default','Wysiwyg status','','7.12'),('9922','/admin/modules/list/confirm','default','Text formats enabled for rich-text editing','','7.12');
INSERT INTO `locales_source` VALUES ('9923','/admin/modules','default','Wysiwyg profiles','','7.12'),('9924','','default','Configure client-side editors.','','7.12'),('9925','','default','No editor','','7.10'),('9926','','default','<a href="!vendor-url">@editor</a> (<a href="!download-url">Download</a>)','','7.10'),('9927','','default','Not installed.','','7.10'),('9928','','default','Extract the archive and copy its contents into a new folder in the following location:<br /><code>@editor-path</code>','','7.10'),('9929','/admin/config/content/wysiwyg','default','So the actual library can be found at:<br /><code>@library-filepath</code>','','7.10'),('9930','','default','Installation instructions','','7.10'),('9931','','default','There are no editor libraries installed currently. The following list contains a list of currently supported editors:','','7.10'),('9932','','default','A Wysiwyg profile is associated with an input format. A Wysiwyg profile defines which client-side editor is loaded with a particular input format, what buttons or themes are enabled for the editor, how the editor is displayed, and a few other editor-specific functions.','','7.10'),('9933','','default','To assign a different editor to a text format, click "delete" to remove the existing first.','','7.10'),('9934','','default','Input format','','7.10'),('9935','/admin/config/content/wysiwyg/profile/filtered_html/edit','default','%editor profile for %format','','7.10'),('9936','','default','Basic setup','','7.10'),('9937','','default','Enabled by default','','7.10'),('9938','','default','The default editor state for users having access to this profile. Users are able to override this state if the next option is enabled.','','7.10'),('9939','','default','Allow users to choose default','','7.10'),('9940','','default','If allowed, users will be able to choose their own editor default state in their user account settings.','','7.10'),('9941','','default','Show <em>enable/disable rich text</em> toggle link','','7.10'),('9942','','default','Whether or not to show the <em>enable/disable rich text</em> toggle link below a textarea. If disabled, the user setting or global default is used (see above).','','7.10');
