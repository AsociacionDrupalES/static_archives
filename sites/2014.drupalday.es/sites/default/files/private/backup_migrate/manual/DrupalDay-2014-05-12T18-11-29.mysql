INSERT INTO `locales_source` VALUES ('8848','/index.php','default','The name of the account to log in as. Leave it empty to log in as uid 1.','','7.12'),('8849','/index.php','default','Displays a one-time login link for the user ryan.','','7.12'),('8850','/index.php','default','Open web browser and login as user ryan.','','7.12'),('8851','/index.php','default','Get a list of some or all site variables and values.','','7.12'),('8852','/index.php','default','A string to filter the variables by.  Only variables beginning with the string will be listed.','','7.12'),('8853','/index.php','default','Use var_export() to emit executable PHP. Useful for pasting into code.','','7.10'),('8854','/index.php','default','List all variables and values.','','7.12'),('8855','/index.php','default','List all variables beginning with the string "user".','','7.12'),('8856','/index.php','default','Set a variable.','','7.12'),('8857','/index.php','default','The name of a variable or the first few letters of its name.','','7.12'),('8858','/index.php','default','The value to assign to the variable.','','7.10'),('8859','/index.php','default','Skip confirmation if only one variable name matches.','','7.12'),('8860','/index.php','default','Always skip confirmation.','','7.12'),('8861','/index.php','default','Set the preprocess_css variable to true. Skip confirmation if variable already exists.','','7.12'),('8862','/index.php','default','Take the site offline; Skips confirmation even if site_offline variable does not exist.','','7.10'),('8863','/index.php','default','Choose from a list of variables beginning with "pr" to set to true.','','7.10'),('8864','/index.php','default','Delete a variable.','','7.12'),('8865','/index.php','default','Delete the user_pictures variable.','','7.12'),('8866','/index.php','default','Choose from a list of variables beginning with "u" to delete.','','7.12'),('8867','/index.php','default','Revert overridden views to their default state. Make sure to backup first.','