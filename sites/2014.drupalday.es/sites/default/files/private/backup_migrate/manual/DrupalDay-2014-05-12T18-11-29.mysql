INSERT INTO `locales_source` VALUES ('8829','/index.php','default','Add the "power user" role to the accounts with name, id, or email 5 or user3, uids 2 and 3, names someguy and somegal, and email address of billgates@microsoft.com','','7.12'),('8830','/index.php','default','Remove a role from the specified user accounts.','','7.12'),('8831','/index.php','default','The name of the role to remove','','7.12'),('8832','/index.php','default','Remove the "power user" role from the accounts with name, id, or email 5 or user3, uids 2 and 3, names someguy and somegal, and email address of billgates@microsoft.com','','7.12'),('8833','/index.php','default','Create a user account with the specified name.','','7.12'),('8834','/index.php','default','The name of the account to add','','7.12'),('8835','/index.php','default','The password for the new account','','7.12'),('8836','/index.php','default','The email address for the new account','','7.12'),('8837','/index.php','default','Create a new user account with the name newuser, the email address person@example.com, and the password letmein','','7.12'),('8838','/index.php','default','Cancel a user account with the specified name.','','7.12'),('8839','/index.php','default','The name of the account to cancel','','7.12'),('8840','/index.php','default','Delete all content created by the user','','7.12'),('8841','/index.php','default','Cancel the user account with the name username and anonymize all content created by that user.','','7.12'),('8842','/index.php','default','Cancel the user account with the name username and delete all content created by that user.','','7.12'),('8843','/index.php','default','(Re)Set the password for the user account with the specified name.','','7.12'),('8844','/index.php','default','The name of the account to modify','','7.10'),('8845','/index.php','default','(required) The new password for the account','','7.10'),('8846','/index.php','default','Set the password for the username someuser to gr3@tP@$s.','