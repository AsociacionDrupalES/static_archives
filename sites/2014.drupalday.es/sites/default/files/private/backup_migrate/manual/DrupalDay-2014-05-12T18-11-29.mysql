INSERT INTO `locales_source` VALUES ('11916','/admin/commerce/customer-profiles/29/edit?destination=admin/commerce/customer-profiles','default','Disabled profiles will not be visible to customers in options lists.','','7.12'),('11917','/admin/commerce/customer-profiles/29/edit?destination=admin/commerce/customer-profiles','default','Because this profile is currently referenced by an order, if you change any field values it will save as a clone of the current profile instead of updating this profile itself. This is to maintain the integrity of customer data as entered on the order(s).','','7.12'),('11918','sites/all/modules/commerce/modules/customer/commerce_customer.js; sites/all/modules/commerce/modules/order/commerce_order.js','default','Owned by @name','','none'),('11919','/admin/commerce/orders/30/edit','default','Clear this profile','','7.12'),('11920','/admin/commerce/orders/30/edit','default','Provide an explanation of the changes you are making. This will provide a meaningful audit trail for updates to this order.','','7.12'),('11921','/admin/commerce/orders/30/edit','default','Order contact e-mail','','7.12'),('11922','/admin/commerce/orders/30/edit','default','Defaults to the owner account e-mail address if left blank. Used for order communication.','','7.12'),('11923','sites/all/modules/commerce/modules/order/commerce_order.js','default','Created @date','','none'),('11924','sites/all/modules/commerce/modules/order/commerce_order.js','default','Updated @date','','none'),('11925','/admin/commerce/orders/31/edit','default','Clear this profile','','7.12'),('11926','/admin/commerce/orders/31/edit','default','Provide an explanation of the changes you are making. This will provide a meaningful audit trail for updates to this order.','','7.12'),('11927','/admin/commerce/orders/31/edit','default','Order contact e-mail','','7.12'),('11928','/admin/commerce/orders/31/edit','default','Defaults to the owner account e-mail address if left blank. Used for order communic