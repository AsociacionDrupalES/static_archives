INSERT INTO `locales_source` VALUES ('12946','','default','A short description of the field used as help for the user when he/she uses the form.','','7.12'),('12947','','default','Check this option if the user must enter a value.','','7.12'),('12948','','default','The webform component of type @type does not have an edit function defined.','','none'),('12949','','default','The field key %field_key is invalid. Please include only lowercase alphanumeric characters and underscores.','','none'),('12950','','default','The field key %field_key is already in use by the field labeled %existing_field. Please use a unique key.','','none'),('12951','','default','Submission #@sid','','7.12'),('12952','','default','Previous submission','','7.12'),('12953','','default','Next submission','','7.12'),('12954','','default','Submitted by !name','','7.12'),('12955','','default','Next Page >','','none'),('12956','','default','< Previous Page','','none'),('12957','','default','The webform component @type is not able to be displayed','','none'),('12958','','default','Illegal information. Data not submitted.','','none'),('12959','','default','Go back to the form','','7.12'),('12960','','default','The default value of the field.','','7.12'),('12961','','default','Left Blank','','7.12'),('12962','','default','User entered value','','7.12'),('12963','','default','Width of the textfield.','','7.12'),('12964','','default','User email as default','','7.12'),('12965','','default','Set the default value of this field to the user email, if he/she is logged in.','','7.12'),('12966','','default','Make this field non-editable. Useful for setting an unchangeable default value.','','7.12'),('12967','','default','Average submission length in words (ex blanks)','','7.12'),('12968','','default','If this fieldset is collapsible, the user may open or close the fieldset.','','none'),('12969','','default','Collapsed by Default','','none'),('12970','','default','Collapsible fieldsets are "open" by default. Sele