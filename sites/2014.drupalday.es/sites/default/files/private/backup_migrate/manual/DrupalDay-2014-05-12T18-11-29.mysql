INSERT INTO `locales_source` VALUES ('11540','/admin/commerce/products/add/product','default','Change history','','7.12'),('11541','/admin/commerce/products/add/product','default','Creation log message','','7.12'),('11542','/admin/commerce/products/add/product','default','Provide an explanation of the changes you are making. This will provide a meaningful history of changes to this product.','','7.12'),('11543','/admin/commerce/products','default','@code_before@code_spacer@negative@symbol_before@price@symbol_spacer@symbol_after@code_spacer@code_after','','7.12'),('11544','/admin/commerce/config/payment-methods','default','Enabled payment method rules','','7.12'),('11545','/admin/commerce/config/payment-methods','default','Parameter','','7.12'),('11546','/admin/commerce/config/payment-methods','default','Unknown event "!event_name"','','7.12'),('11547','/admin/commerce/config/payment-methods','default','There are no active payment methods.','','7.12'),('11548','/admin/commerce/config/payment-methods','default','Disabled payment method rules','','7.12'),('11549','/admin/commerce/config/payment-methods','default','There are no disabled payment methods.','','7.12'),('11550','/admin/commerce/config/payment-methods','default','Add a payment method rule','','7.12'),('11551','/admin/commerce/config/payment-methods','default','Adds an additional payment method rule configuration.','','7.12'),('11552','/admin/commerce/config/payment-methods','default','Payment methods are enabled for use by the rule configurations listed below. An enabled payment rule can specify a payment method to enable using one of the available <em>Enable payment method</em> actions. The action''s settings form will contain any necessary settings for the payment method that must be configured before it may be used.','','7.12'),('11553','/admin/commerce/config/checkout','default','Add a checkout rule','','7.12'),('11554','/admin/commerce/config/checkout','default','Adds an additional checkout completion rule configuration.','','7.12'),('11555','/admin/commerce/config/checkout','default','Enable and configure checkout completion rules.','','7.12');
INSERT INTO `locales_source` VALUES ('11556','/admin/commerce/config/checkout','default','Use the table below to build your checkout form using the available checkout panes and pages defined by modules enabled on your site. You may configure the checkout pane settings using the operations links below.','','7.12'),('11557','sites/all/modules/commerce/modules/checkout/commerce_checkout_admin.js','default','Changes to the checkout panes will not be saved until the <em>Save configuration</em> button is clicked.','','none'),('11558','/admin/commerce/config/checkout/rules','default','Enabled checkout completion rules','','7.12'),('11559','/admin/commerce/config/checkout/rules','default','There are no active checkout completion rules.','','7.12'),('11560','/admin/commerce/config/checkout/rules','default','Disabled checkout completion rules','','7.12'),('11561','/admin/commerce/config/checkout/rules','default','There are no disabled checkout rules.','','7.12'),('11562','/admin/commerce/config/checkout/rules','default','When a customer advances to the checkout completion page, rules reacting on the <em>Completing the checkout process</em> are evaluated. Default rules handle standard tasks like updating the order status, sending order e-mails, and creating accounts for anonymous users. You can edit these or add additional rules to customize your checkout workflow.','','7.12'),('11563','/admin/commerce/config/checkout/rules/manage/6','default','Editing !plugin "!label"','','7.12'),('11564','','default','Elements','','7.12'),('11565','/admin/commerce/config/checkout/rules/manage/6','default','NOT @condition','','7.12'),('11566','','default','Add !name','','7.12'),('11567','/admin/commerce/config/checkout/rules/manage/6','default','If checked, the condition result is negated such that it returns TRUE if it evaluates to FALSE.','','7.12'),('11568','/admin/commerce/config/checkout/rules/manage/6','default','The machine-readable name of this configuration is used by rules internally to identify the configuration. This name must contain only lowercase letters, numbers, and underscores and must be unique.','','7.12');
