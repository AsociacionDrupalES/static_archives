DROP TABLE IF EXISTS `image_styles`;
CREATE TABLE `image_styles` (   `isid` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'The primary identifier for an image style.',   `name` varchar(255) NOT NULL COMMENT 'The style name.',   PRIMARY KEY (`isid`),   UNIQUE KEY `name` (`name`) ) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8 COMMENT='Stores configuration options for image styles.' AUTO_INCREMENT=5;
INSERT INTO `image_styles` VALUES ('4','n100'),('3','n50'),('1','w584'),('2','w960');
DROP TABLE IF EXISTS `imagepicker`;
CREATE TABLE `imagepicker` (   `img_id` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'The primary image identifier.',   `uid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The user identifier.',   `img_name` varchar(255) NOT NULL DEFAULT '' COMMENT 'The image name',   `img_title` varchar(255) NOT NULL DEFAULT '' COMMENT 'The image title',   `img_description` varchar(255) NOT NULL DEFAULT '' COMMENT 'The image description',   `img_date` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The image date',   PRIMARY KEY (`img_id`),   KEY `uid` (`uid`) ) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8 COMMENT='The image table' AUTO_INCREMENT=2;
INSERT INTO `imagepicker` VALUES ('1','8','twitter_newbird_blue120.png','ddayval2012','Sello twitter con hastag del drupal day valencia 2012','1326813442');
DROP TABLE IF EXISTS `imagepicker_group_images`;
CREATE TABLE `imagepicker_group_images` (   `gid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The group identifier.',   `img_id` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The image identifier.',   KEY `gid` (`gid`),   KEY `img_id` (`img_id`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
DROP TABLE IF EXISTS `imagepicker_user_groups`;
CREATE TABLE `imagepicker_user_groups` (   `gid` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'The primary group identifier.',   `uid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The user identifier.',   `group_name` varchar(255) NOT NULL DEFAULT '' COMMENT 'The group name.',   `group_description` varchar(255) NOT NULL DEFAULT '' COMMENT 'The group description.',   `state` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT 'The currently selected group.',   `public` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT 'The public flag.',   `avail_roles` varchar(255) NOT NULL DEFAULT 'all' COMMENT 'List of roles that may view this group.',   PRIMARY KEY (`gid`),   KEY `uid` (`uid`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='The groups table' AUTO_INCREMENT=1;
DROP TABLE IF EXISTS `imagepicker_variables`;
CREATE TABLE `imagepicker_variables` (   `name` varchar(128) NOT NULL DEFAULT '' COMMENT 'imagepicker variables.',   `value` text NOT NULL COMMENT 'imagepicker variable values.',   `uid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The user identifier.',   KEY `name` (`name`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
INSERT INTO `imagepicker_variables` VALUES ('imagepicker_browse_public','i:0;','0');
DROP TABLE IF EXISTS `l10n_update_file`;
CREATE TABLE `l10n_update_file` (   `project` varchar(50) NOT NULL COMMENT 'A unique short name to identify the project.',   `language` varchar(12) NOT NULL COMMENT 'Reference to the languages.language for this translation.',   `type` varchar(50) NOT NULL DEFAULT '' COMMENT 'File origin: download or localfile',   `filename` varchar(255) NOT NULL DEFAULT '' COMMENT 'Link to translation file for download.',   `fileurl` varchar(255) NOT NULL DEFAULT '' COMMENT 'Link to translation file for download.',   `uri` varchar(255) NOT NULL DEFAULT '' COMMENT 'File system path for importing the file.',   `timestamp` int(11) DEFAULT '0' COMMENT 'Unix timestamp of the last file downloaded.',   `version` varchar(128) NOT NULL DEFAULT '' COMMENT 'Version tag of the downloaded file.',   `status` int(11) NOT NULL DEFAULT '1' COMMENT 'Status flag. TBD',   `last_checked` int(11) DEFAULT '0' COMMENT 'Unix timestamp of last time project was updated.',   PRIMARY KEY (`project`,`language`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='File and download information for project translations.';
