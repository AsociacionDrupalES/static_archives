DROP TABLE IF EXISTS `rules_config`;
CREATE TABLE `rules_config` (   `id` int(11) NOT NULL AUTO_INCREMENT COMMENT 'The internal identifier for any configuration.',   `name` varchar(64) NOT NULL COMMENT 'The name of the configuration.',   `label` varchar(255) NOT NULL DEFAULT 'unlabeled' COMMENT 'The label of the configuration.',   `plugin` varchar(127) NOT NULL COMMENT 'The name of the plugin of this configuration.',   `active` int(11) NOT NULL DEFAULT '1' COMMENT 'Boolean indicating whether the configuration is active. Usage depends on how the using module makes use of it.',   `weight` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'Weight of the configuration. Usage depends on how the using module makes use of it.',   `status` tinyint(4) NOT NULL DEFAULT '1' COMMENT 'The exportable status of the entity.',   `dirty` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'Dirty configurations fail the integrity check, e.g. due to missing dependencies.',   `module` varchar(255) DEFAULT NULL COMMENT 'The name of the providing module if the entity has been defined in code.',   `data` longblob COMMENT 'Everything else, serialized.',   PRIMARY KEY (`id`),   UNIQUE KEY `name` (`name`),   KEY `plugin` (`plugin`) ) ENGINE=InnoDB AUTO_INCREMENT=27 DEFAULT CHARSET=utf8 AUTO_INCREMENT=27;
INSERT INTO `rules_config` VALUES ('16','commerce_checkout_order_email','Send an order notification e-mail','reaction rule','1','4','1','1','rules','O:17:"RulesReactionRule":14:{s:9:"\0*\0parent";N;s:2:"id";s:2:"16";s:12:"\0*\0elementId";i:1;s:6:"weight";s:1:"4";s:8:"settings";a:0:{}s:4:"name";s:29:"commerce_checkout_order_email";s:6:"module";s:5:"rules";s:6:"status";i:1;s:5:"label";s:33:"Send an order notification e-mail";s:4:"tags";a:0:{}s:11:"\0*\0children";a:1:{i:0;O:11:"RulesAction":6:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0elementId";i:3;s:6:"weight";i:0;s:8:"settings";a:4:{s:9:"to:select";s:19:"commerce-order:mail";s:7:"subject";s:33:"Confirmación pago del Drupal Day";s:7:"message";s:431:"Muchas gracias por comprar tu entrada para el Drupal Day Valencia 2012.\r\n\r\nEn breve, recibirás otro e-mail con los datos de acceso del sitio.\r\n\r\nPor favor, contacta con nosotros si tienes cualquier pregunta o sugerencia a través del formulario de contacto.\r\n\r\nMantente alerta de todas las novedades del Drupal Day a través de nuestro twitter @drupalval y a través de las noticias de la web.\r\n\r\nNos vemos en Valencia el día 28.";s:4:"from";N;}s:14:"\0*\0elementName";s:4:"mail";}}s:7:"\0*\0info";a:0:{}s:13:"\0*\0conditions";O:8:"RulesAnd":8:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0elementId";i:2;s:6:"weight";i:0;s:8:"settings";a:0:{}s:11:"\0*\0children";a:0:{}s:7:"\0*\0info";a:0:{}s:9:"\0*\0negate";b:0;}s:9:"\0*\0events";a:1:{i:0;s:26:"commerce_checkout_complete";}}'),('17','commerce_payment_commerce_payment_example','Pago de ejemplo','reaction rule','0','0','1','1','rules','O:17:"RulesReactionRule":14:{s:9:"\0*\0parent";N;s:2:"id";s:2:"17";s:12:"\0*\0elementId";i:1;s:6:"weight";s:1:"0";s:8:"settings";a:0:{}s:4:"name";s:41:"commerce_payment_commerce_payment_example";s:6:"module";s:5:"rules";s:6:"status";i:1;s:5:"label";s:15:"Pago de ejemplo";s:4:"tags";a:0:{}s:11:"\0*\0children";a:1:{i:0;O:11:"RulesAction":6:{s:9:"\0*\0parent";r:1;s:2:"id";N;s:12:"\0*\0ele