INSERT INTO `locales_target` VALUES ('6251','La fecha en la que el canal se comprobó por última vez en busca de nuevo contenido.','es','0','0','0'),('6252','La descripción del canal de agregador.','es','0','0','0'),('6253','El ID único de la categoría de agregador.','es','0','0','0'),('6254','El título de la categoría de agregador.','es','0','0','0'),('6255','Presenta el elemento de agregador usando los datos de la fuente original.','es','0','0','0'),('6256','El libro en el que está el nodo.','es','0','0','0'),('6257','El peso de la página del libro.','es','0','0','0'),('6258','La profundidad de la página del libro en la jerarquía. Los libros del nivel superior tienen 1 de profundidad.','es','0','0','0'),('6259','El nodo padre del libro.','es','0','0','0'),('6260','El ID de comentario del campo','es','0','0','0'),('6261','El nombre del autor del comentario. Se puede representar como enlace a la página del autor.','es','0','0','0'),('6262','El sitio web del autor del comentario. Se puede representar como enlace. estará vacío si el autor es un usuario registrado.','es','0','0','0'),('6263','Proporciona un enlace directo para ver el comentario.','es','0','0','0'),('6264','Proporciona un enlace directo para editar el comentario.','es','0','0','0'),('6265','Proporciona un enlace directo para borrar el comentatio.','es','0','0','0'),('6266','El ID de usuario del autor del comentario.','es','0','0','0'),('6267','CID padre','es','0','0','0'),('6268','El ID de comentario del comentario padre.','es','0','0','0'),('6269','Hora del último comentario','es','0','0','0'),('6270','Fecha y hora de la publicación del último comentario.','es','0','0','0'),('6271','Autor del último comentario','es','0','0','0'),('6272','El nombre del autor del último comentario publicado.','es','0','0','0'),('6273','El número de comentarios que tiene un nodo.','es','0','0','0'),('6274','Fecha de actualización o comentario','es','0','0','0'),('6275','El comentario último o más reciente enviado o la hora de actualización del nodo.','es','0','0','0'),('6276','El número de comentarios nuevos del nodo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6277','Estado del comentario','es','0','0','0'),('6278','Si los comentarios están permitidos o no en el nodo.','es','0','0','0'),('6279','Usuario envío o comentó','es','0','0','0'),('6280','Muestra los nodos sólamente si un usuario envío el nodo o lo comentó.','es','0','0','0'),('6281','Mostrar el comentario con la vista estándar de comentario.','es','0','0','0'),('6282','Exponer los comentarios como RSS.','es','0','0','0'),('6283','Víncular a la página de contacto','es','0','0','0'),('6284','Proporciona un enlace directo con la página de contacto del usuario.','es','0','0','0'),('6285','Origen de regionalización','es','0','0','0'),('6286','Un texto de origen para traducir, en inglés o en idioma predeterminado del sitio.','es','0','0','0'),('6287','LID','es','0','0','0'),('6288','El ID del texto de origen.','es','0','0','0'),('6289','Una descripción de la ubicación o el contexto de la cadena de texto.','es','0','0','0'),('6290','El grupo en el que está la traducción.','es','0','0','0'),('6291','El texto original completo.','es','0','0','0'),('6292','La versión del núcleo de Drupal para la que es este texto.','es','0','0','0'),('6293','Proporciona un enlace directo para editar las traducciones.','es','0','0','0'),('6294','Destino de regionalización','es','0','0','0'),('6295','El texto completo de traducción.','es','0','0','0'),('6296','El idioma en el que está esta traducción.','es','0','0','0'),('6297','LID singular','es','0','0','0'),('6298','El ID de la traducción madre.','es','0','0','0'),('6299','Si la traducción es plural o no.','es','0','0','0'),('6300','Publicado o administrado','es','0','0','0'),('6301','Creado el año + mes','es','0','0','0'),('6302','Año de creación','es','0','0','0'),('6303','Mes de creación','es','0','0','0'),('6304','Día de creación','es','0','0','0'),('6305','Semana de creación','es','0','0','0'),('6306','Año + mes de modificación','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6307','Año de modificación','es','0','0','0'),('6308','Mes de modificación','es','0','0','0'),('6309','Día de modificación','es','0','0','0'),('6310','Semana de modificación','es','0','0','0'),('6311','Vid','es','0','0','0'),('6312','El mensaje de registro que se hizo al crear la revisión.','es','0','0','0'),('6313','Invertir enlace','es','0','0','0'),('6314','Proporciona un enlace directo para volver a la revisión.','es','0','0','0'),('6315','Filtrar por acceso','es','0','0','0'),('6316','Tiene contenido nuevo','es','0','0','0'),('6317','La presentación %display no tiene control de acceso pero no contgiene filtro para nodos publicados.','es','0','0','0'),('6318','Si la encuesta permanece aun abierta para votar o no.','es','0','0','0'),('6319','Campo de texto de perfil','es','0','0','0'),('6320','Área de texto de perfil','es','0','0','0'),('6321','Casilla marcable de perfil','es','0','0','0'),('6322','URL del perfil','es','0','0','0'),('6323','Selección de perfil','es','0','0','0'),('6324','lista de perfil en formulario libre %field-name.','es','0','0','0'),('6325','Fecha de perfil %field-name.','es','0','0','0'),('6326','La puntuación del elemento de búsqueda. Esto no se usará si el filtro de búsqueda no está también presente.','es','0','0','0'),('6327','Enlaces desde','es','0','0','0'),('6328','Otros nodos a los que se enlaza desde el nodo.','es','0','0','0'),('6329','Enlaces a','es','0','0','0'),('6330','Otros nodos que enlazan al nodo.','es','0','0','0'),('6331','Buscar términos','es','0','0','0'),('6332','Los términos que se deben buscar.','es','0','0','0'),('6333','Presenta los resultados con la vista de búsqueda estándar.','es','0','0','0'),('6334','Total de vistas','es','0','0','0'),('6335','El número total de veces que se ha visitado un nodo.','es','0','0','0'),('6336','El número de veces que se ha visitado un nodo hoy.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6337','Vista más reciente','es','0','0','0'),('6338','El momento más reciente en el que se ha visitado el nodo.','es','0','0','0'),('6339','Almacena la información de accesos al sitio.','es','0','0','0'),('6340','ID de la sesión del navegador del usuario que visitó la página.','es','0','0','0'),('6341','Título de la página visitada.','es','0','0','0'),('6342','Ruta interna de la página visitada (relativa a la raiz de este sitio Drupal).','es','0','0','0'),('6343','URI de referencia','es','0','0','0'),('6344','Nombre del servidor del usuario que visitó la página','es','0','0','0'),('6345','El usuario que visitó el sitio.','es','0','0','0'),('6346','Tiempo en milisegundos que tardó la página en cargarse.','es','0','0','0'),('6347','Sello temporal de cuando se visitó la página.','es','0','0','0'),('6348','Documentos que Drupal y sus distintos módulos manejan.','es','0','0','0'),('6349','El ID del archivo.','es','0','0','0'),('6350','El nombre del documento.','es','0','0','0'),('6351','la ruta del archivo.','es','0','0','0'),('6352','El tipo MIME del documento.','es','0','0','0'),('6353','El estado del documento.','es','0','0','0'),('6354','La fecha en la que se subió el archivo.','es','0','0','0'),('6355','Nombre del vocabulario del que un término es miembro. Este será el vocabulario al que pertenecerá el campo "Taxonomía: Término" y también puede causar duplicados.','es','0','0','0'),('6356','Los términos de taxonomía se adjuntan a los nodos.','es','0','0','0'),('6357','Nombre de termino de taxonomía','es','0','0','0'),('6358','Campo de peso del término','es','0','0','0'),('6359','La descripción asociada con un término de taxonomía.','es','0','0','0'),('6360','Filtrar los resultados de "Taxonomía: Término" con un vocabulario concreto.','es','0','0','0'),('6361','Mostrar todos los términos de los vocabularios especificados asociados con un nodo.','es','0','0','0'),('6362','El término padre del término. Esto puede producir entradas duplicadas si está usando un vocabulario qie permita varios padres.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6363','El término padre del término.','es','0','0','0'),('6364','Traducción de nodo','es','0','0','0'),('6365','ID del conjunto de traducción del nodo','es','0','0','0'),('6366','El ID del conjunto de traducción al que pertenece el nodo.','es','0','0','0'),('6367','Origen de traducción','es','0','0','0'),('6368','El original del que se tradujo este contenido.','es','0','0','0'),('6369','Versiones del contenido en distintos idiomas.','es','0','0','0'),('6370','Traducción de hijo','es','0','0','0'),('6371','Desfasado','es','0','0','0'),('6372','ID del usuario','es','0','0','0'),('6373','El nombre de autor o usuario.','es','0','0','0'),('6374','Dirección de correo electrónico de un usuario concreto. Este campo no se suele mostrar a los usuarios, por lo que debe tener cuidado al usarlo.','es','0','0','0'),('6375','Idioma del usuario','es','0','0','0'),('6376','La imagen del usuario, si estuviera permitida.','es','0','0','0'),('6377','La fecha en la que se creó el usuario.','es','0','0','0'),('6378','La fecha del último acceso del usuario.','es','0','0','0'),('6379','La fecha de la última identificación en el sistema del usuario.','es','0','0','0'),('6380','Si un usuario está activo o bloqueado.','es','0','0','0'),('6381','La firma del usuario.','es','0','0','0'),('6382','Proporciona un enlace directo para editar al usuario.','es','0','0','0'),('6383','Roles a los que pertenece un usuario.','es','0','0','0'),('6384','La ID del usuario de la URL','es','0','0','0'),('6385','La ID de usuario del usuario identificado','es','0','0','0'),('6386','Mostrar en orden aleatorio.','es','0','0','0'),('6387','Nulo','es','0','0','0'),('6388','Porporcionar texto o enlace personalizado.','es','0','0','0'),('6389','Ver contador de resultados','es','0','0','0'),('6390','Muestra la posición actual del resultado de la vista.','es','0','0','0'),('6391','Enlazar este campo con su página de agregador de categoría','es','0','0','0'),('6392','Sin usuario','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6393','Enlazar este campo con su comentario','es','0','0','0'),('6394','Mostrar enlace al estilo de resumen','es','0','0','0'),('6395','Enlazar este campo con nuevos comentarios','es','0','0','0'),('6396','Tipo de enlace','es','0','0','0'),('6397','Contactar con %user','es','0','0','0'),('6398','Grupo desconocido','es','0','0','0'),('6399','Idioma no identificado','es','0','0','0'),('6400','El idioma del usuario actual','es','0','0','0'),('6401','Versión actualmente instalada','es','0','0','0'),('6402','Comprobar también si hay nuevos comentarios','es','0','0','0'),('6403','Los ID de los nodos separados por , o +','es','0','0','0'),('6404','Sin alternativa','es','0','0','0'),('6405','Orden alternativo','es','0','0','0'),('6406','Tipo de orden alternativo','es','0','0','0'),('6407','Si la entrada está vacía','es','0','0','0'),('6408','No mostrar ninguno','es','0','0','0'),('6409','Mostrar puntuación','es','0','0','0'),('6410','Vincule este campo para descargar el archivo','es','0','0','0'),('6411','Establecer los enlaces de ayuda a la navegación para los términos padre','es','0','0','0'),('6412','Si se selecciona, los enlaces de ayuda a la navegación incluirán todos los términos padre, cada uno enlazado a esta vista. Tenga en cuenta que esto sólo funciona si sólo se recibió un término.','es','0','0','0'),('6413','La profundidad encajará con los nodos marcados con términos en la jerarquía; por ejemplo: Si tiene el término "fruta" y el término hijo "manzana" con una profundidad de 1 (o mayor), entonces el filtrado por el término "fruta" llegará a los nodos marcados con "manzana" además de los de a "fruta". Si es negativo, lo contrario también es cierto: La búsqueda de "manzana" también alcanzará los términos marcados con "fruta" si la profundidad es -1 (o menor).','es','0','0','0'),('6414','Sin vocabulario','es','0','0','0'),('6415','Enlazar este campo con su página de término de taxonomía','es','0','0','0'),('6416','Enlazar este campo con su página de término','es','0','0','0'),('6417','Limitar los términos por vocabulario','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6418','Seleccionar para qué vocabulario mostrar los términos en las ocpciones regulares.','es','0','0','0'),('6419','Desplegable','es','0','0','0'),('6420','Mostrar jerarquía en desplegable','es','0','0','0'),('6421','Se ha seleccionado un vocabulario no válido. Por favor, cambielo en las opciones.','es','0','0','0'),('6422','Seleccionar términos para el vocabulario @voc','es','0','0','0'),('6423','Seleccionar términos','es','0','0','0'),('6424','No se pudo encontrar el término: @terms','es','0','0','0'),('6425','No se pudieron encontrar los términos: @terms','es','6424','1','0'),('6426','Si desea validar contra vocabularios específicos, márquelos. Si no se marca ninguno, pasarán todos los términos.','es','0','0','0'),('6427','Los ID de términos separados por , o +','es','0','0','0'),('6428','Idioma actual','es','0','0','0'),('6429','Opción de traducción','es','0','0','0'),('6430','La opción de traducción permite seleccionar sobre qué traducción o traducciones disponer la unión. Seleccione "idioma actual" o "idioma predeterminado" para unir sobre la traducción en idioma actual o predeterminado respectivamente. Seleccione un idioma específico para unir sobre una traducción en ese idioma. Si selecciona "Todos", cada traducción creará una nueva fila, lo que podría dar lugar a duplicados.','es','0','0','0'),('6431','Al usuario','es','0','0','0'),('6432','Con un enlace de enviar correo a:','es','0','0','0'),('6433','Es el usuario identificado','es','0','0','0'),('6434','Nombres de usuarios','es','0','0','0'),('6435','Indique una lista de nombres de usuarios separados por comas.','es','0','0','0'),('6436','No se pudo encontrar el usuario: @users','es','0','0','0'),('6437','No se pudieron encontrar los usuarios: @users','es','6436','1','0'),('6438','Buscar también un nodo y usar el autor del nodo','es','0','0','0'),('6439','Permitir sólo UID numéricos','es','0','0','0'),('6440','Permitir sólo nombres de usuario de texto','es','0','0','0'),('6441','Permitir UID numéricos y nombres de usuario de texto','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6442','Restringir usuario basándose en el rol','es','0','0','0'),('6443','Limitar a los roles seleccionados','es','0','0','0'),('6444','Si no se ha seleccionado ningún nodo, se permitirán los usuarios con cualquier rol.','es','0','0','0'),('6445','Sin restricciones','es','0','0','0'),('6446','Sólo los usuarios con la marca de permiso seleccionada podrán acceder a esta presentación. Tenga en cuenta que los usuarios con permiso para "acceder a todas las vistas"podrán ver cualquier vista sin importar otros permisos.','es','0','0','0'),('6447','No se han seleccionado roles','es','0','0','0'),('6448','Roles multiples','es','0','0','0'),('6449','Sólo los roles marcados podrán acceder a esta presentación. Tenga en cuenta que los usuarios con permiso de ''acceder a todas las vistas'' podrán acceder a cualquiera sin importar el rol.','es','0','0','0'),('6450','Debe seleccionar al menos un rol si el tipo es "por rol"','es','0','0','0'),('6451','Código de validación PHP','es','0','0','0'),('6452','No poner nunca en caché','es','0','0','0'),('6453','Resultados de consulta','es','0','0','0'),('6454','La cantidad de tiempo que la consulta sin modificar de los resultados se debería poner en caché.','es','0','0','0'),('6455','Salida final','es','0','0','0'),('6456','La cantidad de tiempo en el que la salida HTML se debe poner en caché.','es','0','0','0'),('6457','Campo deteriorado','es','0','0','0'),('6458','Cambiar el título que usará esta presentación.','es','0','0','0'),('6459','Usar AJAX','es','0','0','0'),('6460','Cambiar se esta presentación debe usar o no AJAX.','es','0','0','0'),('6461','Mini','es','0','0','0'),('6462','Cambia las opciones de paginador de esta presentación.','es','0','0','0'),('6463','Indique si esta presentación debe incluir un enlace de tipo "[más...]".','es','0','0','0'),('6464','Especificar el tipo de control de acceso para esta presentación.','es','0','0','0'),('6465','Cambiar la configuración de este tipo de acceso.','es','0','0','0'),('6466','Especificar el tipo de caché para esta presentación.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6467','Cambiar las opciones para este tipo de caché.','es','0','0','0'),('6468','Mostrar enlace','es','0','0','0'),('6469','Formulario expuesto en bloque','es','0','0','0'),('6470','Permite que el formulario expuesto aparezca en un bloque en vez de en la vista.','es','0','0','0'),('6471','Conseguir información se cómo aplicar un tema visual a esta presentación','es','0','0','0'),('6472','El título de esta vista','es','0','0','0'),('6473','Este título se mostrará con la vista donde se muestren usualmente los títulos; por ejemplo: como título de la página, como título de bloque, etc.','es','0','0','0'),('6474','Usar AJAX cuando sea posible para cargar esta vista','es','0','0','0'),('6475','Si se establece, esta vista usará un mecanismo AJAX para paginación, ordenación de tablas y filtros expuestos. Esto significa que no se actualizará toda la página. No se recomienda su uso si esta vista es el contenido principal de la página, ya que impedirá un enlazado profundo con páginas específicas, pero sí es muy útil para contenido secundario.','es','0','0','0'),('6476','A menos que esté experimentando problemas con los paginadores relacionados con esta vista, debería dejar esto en 0. Si usa varios paginadores en una página, podría necesitar establecer este número con un valor más alto para no entrar en conflicto con la matriz ?page=. Valores más altos añadirán una gran cantidad de comas a sus URL, por eso evítelo siempre que pueda.','es','0','0','0'),('6477','El número de elementos a mostrar por página. Ponga "0" para sin límite.','es','0','0','0'),('6478','Añadir un enlace de ''más...'' en la zona inferior de la presentación.','es','0','0','0'),('6479','Crear enlace de ''más...''','es','0','0','0'),('6480','El texto que mostrar con el enlace ''más...''','es','0','0','0'),('6481','Esto hará que la vista muestre sólo elementos únicos. Si hay varios elementos idénticos, sólo se mostrará uno una vez. Puede usar esta opción para eliminar duplicados de una vista, aunque no siempre funciona. Tenga en cuenta que esto puede reducir la velocidad de las consultas, por lo que debe usarse con precaución','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6482','Restricciones de acceso','es','0','0','0'),('6483','Opciones de acceso','es','0','0','0'),('6484','Opciones de caché','es','0','0','0'),('6485','Mostrar incluso si esta vista no tiene resultados','es','0','0','0'),('6486','Qué estilo debería tener esta vista','es','0','0','0'),('6487','Si el estilo elegido tiene opciones, asegúrese de hacer click en el botón de opciones que aparecerá a su lado en el resumen de vista.','es','0','0','0'),('6488','Opciones de estilo','es','0','0','0'),('6489','Opciones de estilo de fila','es','0','0','0'),('6490','Como debería ser el estilo de cada fila de esta vista','es','0','0','0'),('6491','Qué presentación usar para la ruta','es','0','0','0'),('6492','Qué presentación usar para la ruta de esta presentación para cosas como resúmenes de enlaces, enaces de canales RSS, enlaces de ''más...'', etc,','es','0','0','0'),('6493','Salida de presentación','es','0','0','0'),('6494','Salida alternativa de presentación','es','0','0','0'),('6495','Salida de estilo','es','0','0','0'),('6496','Estilo alternativo','es','0','0','0'),('6497','Salida de estilo de fila','es','0','0','0'),('6498','Estilo de fila alternativo','es','0','0','0'),('6499','Campo @field (ID: @id)','es','0','0','0'),('6500','Esta sección lista todas las plantilla posibles para el añadido de presentación y para los añadidos de estilo, ordenados aproximadamente desde el menos al más específico. La plantilla activa para cada añadido —que es la plantilla más específica hallada en el sistema— está resaltada en negrita.','es','0','0','0'),('6501','Cambiar tema','es','0','0','0'),('6502','Volver a explorar los archivos de plantilla','es','0','0','0'),('6503','<strong>¡Importante!</strong> Al añadir, eliminar o renombrar archivos de plantillas, es necesario alertar a Drupal de esos cambios haciéndole repasar los archivos de su sistema. Al hacer click en este botón, limpiará el registro de temas de Drupal y así activará este proceso de revisión. Las plantillas destacadas más arriba reflejarán entonces el nuevo estado de su sistema.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6504','Información de tema visual (presentación)','es','0','0','0'),('6505','Vuelta a !info','es','0','0','0'),('6506','Información de tema visual','es','0','0','0'),('6507','Esta presentación no tiene información de tema visual','es','0','0','0'),('6508','Esta es la plantilla de tema que se usa para esta presentación.','es','0','0','0'),('6509','Esta es una plantilla alternativa para esta presentación.','es','0','0','0'),('6510','Información de tema (estilo)','es','0','0','0'),('6511','esta presentación no tiene información de tema','es','0','0','0'),('6512','Esta es la plantilla predeterminada de tema que se usa para este estilo.','es','0','0','0'),('6513','Esta es una plantilla alternativa para este estilo.','es','0','0','0'),('6514','Información de tema visual (estilo de fila)','es','0','0','0'),('6515','Esta presentación no tiene información de tema de estilo de fila','es','0','0','0'),('6516','Esta es la plantilla de tema predefinida que se usa para este estilo de fila.','es','0','0','0'),('6517','Esta es una plantilla alternativa para este estilo de fila.','es','0','0','0'),('6518','Poner el formulario expuesto en un bloque','es','0','0','0'),('6519','Si se establece, ningún control expuesto aparecerá con esta vista. En su lugar, aparecerá disponible un bloque en el sistema de administración de bloques de Drupal y el formulario expuesto se aparecerá allí. Tenga en cuenta que este bloque se debe activar a mano y que las vistas no lo activarán por usted.','es','0','0','0'),('6520','Archivo hallado en el directorio @template-path','es','0','0','0'),('6521','(archivo no encontrado, en directorio @template-path)','es','0','0','0'),('6522','La presentación "@display" usa campos pero no hay ninguno definido o todos ellos están excluidos.','es','0','0','0'),('6523','La presentación "@display" usa una ruta pero la ruta no se ha definido.','es','0','0','0'),('6524','La presentación "@display" tiene una extensión de estilo no válida.','es','0','0','0'),('6525','Formulario expuesto: @view-@display_id','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6526','Opciones de adjuntos','es','0','0','0'),('6527','Heredar filtros expuestos','es','0','0','0'),('6528','Presentaciones multiples','es','0','0','0'),('6529','¿Debería esta presentación heredar los valores de su filtro expuesto de la presentación madre a la que está adjunta?','es','0','0','0'),('6530','¿Adjuntar antes o después de la presentaciójn madre?','es','0','0','0'),('6531','Seleccionar a qué presentación o presentaciones habría que adjuntar esto.','es','0','0','0'),('6532','Descripción del bloque de administración','es','0','0','0'),('6533','Tipo de caché del bloque','es','0','0','0'),('6534','Esto establece el estado predeterminado del método interno de Drupal de caché de bloques. Necesita que la caché esté activa en la administración de bloques. Debe tener cuidado, porque tiene usted muy poco control sobre cuando se vacía esta caché.','es','0','0','0'),('6535','Usando el nombre del sitio','es','0','0','0'),('6536','Usar el nombre del sitio para el título','es','0','0','0'),('6537','El icono de canal de noticias sólo estará disponible para las presentaciones seleccionadas.','es','0','0','0'),('6538','Sin menú','es','0','0','0'),('6539','Normal: @title','es','0','0','0'),('6540','Solapa: @title','es','0','0','0'),('6541','Cambiar opciones del menú padre','es','0','0','0'),('6542','La ruta de menú o URL de esta vista','es','0','0','0'),('6543','Entrada del elemento de menú','es','0','0','0'),('6544','Si se establece como normal o solapa, indique el texto que se usará para  la descripción del elemento de menú.','es','0','0','0'),('6545','Opciones predefinidas de solapa','es','0','0','0'),('6546','Cuando se proporciona un menú como solapa, Drupal necesita saber cuál será el elemento de menú padre de la solapa. A veces, ese padre ya existirá pero otras será necesario crearlo. La ruta de elemento padre siempre será la misma ruta con la última parte recortada; por ejemplo: Si la ruta a la vista es <em>foo/bar/baz</em>, la ruta madre será <em>foo/bar</em>.','es','0','0','0'),('6547','Ya existe','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6548','Si está creando un elemento de menú padre, escriba la descripción del elemento.','es','0','0','0'),('6549','"$arg" ya no se admite, use % en su lugar.','es','0','0','0'),('6550','"%" no se puede usar para el primer segmento de una ruta.','es','0','0','0'),('6551','Las vistas no pueden crear elementos de menú normales para rutas que tengan un %.','es','0','0','0'),('6552','Una presentación cuya ruta termine con un % no puede ser una solapa.','es','0','0','0'),('6553','El título es necesario para este tipo de menú.','es','0','0','0'),('6554','Campos en línea','es','0','0','0'),('6555','El separador se puede situar entre campos en línea para impedir que se empastelen entre si. Puede usar HTML en este campo.','es','0','0','0'),('6556','Agrupando campo.','es','0','0','0'),('6557','Opcionalmente puede especificar un campo por el que agrupar los registros. Dejar vacío para no agrupar.','es','0','0','0'),('6558','La extensión @style necesita un estilo de fila pero la extensión de fila no es válida.','es','0','0','0'),('6559','La alineación horizontal situará los elementos empezando desde arriba a la izquierda y desplazandose hacia la derecha. La alineación vertical situará los elementos empezando desde arriba a la izquierda y desplazandose hacia abajo.','es','0','0','0'),('6560','Descripción RSS','es','0','0','0'),('6561','Esto aparecerá en el Canal RSS mismo.','es','0','0','0'),('6562','Mostrar cuenta de registros con enlace','es','0','0','0'),('6563','Sobreescribir el número de elementos a mostrar','es','0','0','0'),('6564','Mostrar los elementos en línea','es','0','0','0'),('6565','Necesita al menos un campo antes de configurar las opciones de la tabla','es','0','0','0'),('6566','Sobrescribir el ordenamiento normal si se usa la ordenación mediante clicks.','es','0','0','0'),('6567','Activar encabezamientos de tablas fijos en cabeza de la listas de Drupal (JavaScript).','es','0','0','0'),('6568','(Los efectos del encabezamiento fijo en cabeza de de las listas no estarán activos en la vista previa de más abajo, pero sí en la presentación final)','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6569','Colocar campos en columnas. Puede combinar varios campos en la misma columna. Si lo hace, el separador en la columna especificada se usará para separar los campos. Marque la casilla de ordenable para que la columna sea ordenable por un click de ratón y escoja la opción de orden predeterminado para decidir qué columna marcará el orden en principio (si lo hay). Puede controlar el orden de las columnas y las etiquetas de campo en la sección de campos.','es','0','0','0'),('6570','El estilo seleccionado no utiliza ningún campo.','es','0','0','0'),('6571','Sin definir','es','0','0','0'),('6572','La vista está siendo editada por el usuario !user, y está bloqueada para los demás usuarios. Este bloqueo está desde hace !age. Haga click aquí para <a href="!break"> romper este bloqueo</a>.','es','0','0','0'),('6573','Nueva vista','es','0','0','0'),('6574','Vista cambiada','es','0','0','0'),('6575','Vista %name, mostrando los elementos de tipo <strong>@base</strong>.','es','0','0','0'),('6576','Vista previa','es','0','0','0'),('6577','‹‹','es','0','0','0'),('6578','››','es','0','0','0'),('6579','@current de @max','es','0','0','0'),('6580','Permitir múltiples valores','es','0','0','0'),('6581','Criterios de filtrado','es','0','0','0'),('6582','ID de elemento','es','0','0','0'),('6583','Ordenar descendente','es','0','0','0'),('6584','Ordenar ascendente','es','0','0','0'),('6585','Opciones de estilo','es','0','0','0'),('6586','Término de taxonomía','es','0','0','0'),('6587','@label (!name)','es','0','0','0'),('6588','(el primer elemento es 0)','es','0','0','0'),('6589','(comenzar desde los últimos valores)','es','0','0','0'),('6590','Número de páginas','es','0','0','0'),('6591','Estadísticas de contenido','es','0','0','0'),('6592','Objetivo (target) del enlace, como _blank, _parent o el nombre de un iframe. este campo se usa raramente.','es','0','0','0'),('6593','Título de @argument','es','0','0','0'),('6594','Entrada de @argument','es','0','0','0'),('6595','El número máximo de caracteres que puede tener este campo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6596','Contar el número 0 como vacío','es','0','0','0'),('6597','Ocultar si está vacío','es','0','0','0'),('6598','Valor inicial','es','0','0','0'),('6599','Especificar el numero con el que el contador debería comenzar.','es','0','0','0'),('6600','No comienza con','es','0','0','0'),('6601','not_begins','es','0','0','0'),('6602','No termina con','es','0','0','0'),('6603','not_ends','es','0','0','0'),('6604','La vista %name se ha guardado.','es','0','0','0'),('6605','Este filtro puede hacer que elementos que tengan más de una de las opciones seleccionadas aparezcan como resultados duplicados. Si este es el caso, esta casilla puede reducir esos duplicados. Sin embargo, cuantos más términos tiene para buscar, menos eficiente será la consulta, por lo que debe usarse con precaución. No debería usarse para campos de valor único, ya que puede hacer que algunos resultados desaparezcan de la presentación si se usa con un campo incompatible.','es','0','0','0'),('6606','Menú saltar','es','0','0','0'),('6607','Pone todos los resultados en una caja de selección y permite al usuario ir a una página distinta basándose en los resultados.','es','0','0','0'),('6608','Nombre de equipo del usuario que publicó el comentario.','es','0','0','0'),('6609','Correo electrónico del usuario que hizo el comentario. Estará vacío si el autor es un usuario registrado.','es','0','0','0'),('6610','Relacionar nodos con términos de taxonomía, especificando qué vocabulario(s) usar. Esta relación dará lugar a registros duplicados si hay varios términos.','es','0','0','0'),('6611','El texto del elemento de perfil.','es','0','0','0'),('6612','El ID de término de taxonomía del término.','es','0','0','0'),('6613','Eñ nombre de término de taxonomía del término.','es','0','0','0'),('6614','El nombre del vocabulario al que pertenece el término.','es','0','0','0'),('6615','Elija que vocabularios desea relacionar. Recuerde que cada término encontrado creará un nuevo registro, por lo que esta relación se usará mejor con un solo vocabulario que tenga sólo un término por nodo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6616','El nombre del rol.','es','0','0','0'),('6617','El ID de rol del rol.','es','0','0','0'),('6618','Ocultar campos vacíos','es','0','0','0'),('6619','No mostrar campos, etiquetas o marcas para campos que estén vacíos.','es','0','0','0'),('6620','Necesita al menos un campo antes de configurar las opciones de su menú de salto','es','0','0','0'),('6621','Para configurar apropiadamente un menú de salto, debe seleccionar un campo que representará la ruta a usar. Entonces debe disponer la exclusión de ese campo. Todos los demás campos mostrados serán parte del menú. Tenga en cuenta que cualquier HTML se eliminará de esta salida, ya que las cajas de selección no pueden mostrar HTML.','es','0','0','0'),('6622','Campo de ruta','es','0','0','0'),('6623','Si se oculta, este botón sólo quedará oculto para usuarios con JavaScript y la página saltará automáticamente cuanto la selección cambie.','es','0','0','0'),('6624','Archivo mensual','es','0','0','0'),('6625','Este identificador lo usa otro manejador.','es','0','0','0'),('6626','El largo es menor que','es','0','0','0'),('6627','más corto que','es','0','0','0'),('6628','El largo es mayor que','es','0','0','0'),('6629','más larga que','es','0','0','0'),('6630','Consulta SQL','es','0','0','0'),('6631','La consulta se creará y ejecutará usando la API de bases de datos de Drupal.','es','0','0','0'),('6632','Usuario revisor','es','0','0','0'),('6633','Formulario expuesto','es','0','0','0'),('6634','Esto mostrará el vínculo "más" incluso cuando no haya más elementos que mostrar.','es','0','0','0'),('6635','El órden de las páginas en la jerarquía del libro.','es','0','0','0'),('6636','Mostrar el vínculo estándar añadir comentario utilizado en nodos regulares, el cual solo se mostrará si el usuario que está viendo tiene acceso para añadir un comentario.','es','0','0','0'),('6637','Heredar paginador','es','0','0','0'),('6638','Visualizar paginador','es','0','0','0'),('6639','Visualizar','es','0','0','0'),('6640','ID de entidad','es','0','0','0'),('6641','La etiqueta para esta área que se mostrará solo de forma administrativa.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6642','Expuesto','es','0','0','0'),('6643','Muestra el reordenamiento','es','0','0','0'),('6644','Eliminar esta presentación','es','0','0','0'),('6645','Operador para usar en todos los grupos','es','0','0','0'),('6646','Ya sea «grupo 0 Y grupo 1 Y grupo 2» o «grupo 0 O grupo 1 O grupo 2», etc.','es','0','0','0'),('6647','Eliminar grupo @group','es','0','0','0'),('6648','Grupo predeterminado','es','0','0','0'),('6649','Grupo @group','es','0','0','0'),('6650','Filtros inagrupables','es','0','0','0'),('6651','Configurar opciones de grupo para @type %item','es','0','0','0'),('6652','Formulario básico expuesto','es','0','0','0'),('6653','Entrada requerida','es','0','0','0'),('6654','Un formulario expuesto que solamente produce una vista si el formulario contiene entradas de usuario.','es','0','0','0'),('6655','Mostrar todos los elementos','es','0','0','0'),('6656','Mostrar todos los elementos que esta vista pueda encontrar','es','0','0','0'),('6657','Mostrar un número específico de elementos','es','0','0','0'),('6658','Mostrar un número limitado de elementos que esta vista podría encontrar.','es','0','0','0'),('6659','Salida paginada, paginador completo','es','0','0','0'),('6660','Salida paginada, estilo Drupal completo','es','0','0','0'),('6661','Salida paginada, mini paginador','es','0','0','0'),('6662','Usar la salida de mini paginador.','es','0','0','0'),('6663','El nombre de vocabulario de taxonomía','es','0','0','0'),('6664','Nombre (sin filtrar)','es','0','0','0'),('6665','El nombre del usuario o del autor. Este filtro no verifica si el usuario existe y permite una coincidencia parcial. No utiliza autocompletado.','es','0','0','0'),('6666','Proporcionar el texto de marcado para el área.','es','0','0','0'),('6667','Nombre de sistema','es','0','0','0'),('6668','Cambiar el nombre de sistema de esta presentación.','es','0','0','0'),('6669','Cambiar opciones de configuración para este tipo de paginador.','es','0','0','0'),('6670','Permitir agrupamiento y agregación (cálculo) de campos.','es','0','0','0'),('6671','Estilo del formulario expuesto','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6672','Seleccionar el tipo de filtro expuesto a utilizar.','es','0','0','0'),('6673','Opciones de configuración de formulario expuesto para este estilo de formulario expuesto.','es','0','0','0'),('6674','El nombre interno del sistema de esta presentación','es','0','0','0'),('6675','Este es el nombre interno del sistema de esta presentación.','es','0','0','0'),('6676','Si se marca, algunos campos pueden quedar deshabilitados. Todos los campos que sean seleccionados para agrupamiento serán plegados a un registro para cada valor distinto. La función se ejecutará en otros campos que sean seleccionados para agregación. Por ejemplo, puede agrupar nodos por título y contar el número de nids para obtener una lista de títulos duplicados.','es','0','0','0'),('6677','<strong>¡Importante!</strong> Ha cambiado el nombre interno del sistema de la presentación. Cualquier cosa que se adjuntara a esta presentación específicamente, como temas, podría dejar de funcionar hasta que sea actualizado. Para ver sugerencias de temas para ella, debe guardar la vista.','es','0','0','0'),('6678','Formulario expuesto','es','0','0','0'),('6679','Opciones del formulario expuesto','es','0','0','0'),('6680','Elija cuál paginador utilizar para esta vista, si es que se utiliza alguno','es','0','0','0'),('6681','Opciones de paginador','es','0','0','0'),('6682','El ID de presentación debería ser único.','es','0','0','0'),('6683','Texto a mostrar en el botón de envío del formulario expuesto.','es','0','0','0'),('6684','Incluir botón de reinicio','es','0','0','0'),('6685','Si se marca, el formulario expuesto proporcionará un botón para limpiar todos los filtros expuestos aplicados','es','0','0','0'),('6686','Etiqueta del botón de reinicio','es','0','0','0'),('6687','Texto a mostrar en el botón de limpiado del formulario expuesto.','es','0','0','0'),('6688','Etiqueta de ordenamiento expuesto','es','0','0','0'),('6689','Texto a mostrar como la etiqueta de la caja de selección de ordenamiento expuesto.','es','0','0','0'),('6690','Texto a utilizar cuando el ordenamiento expuesto sea ascendente.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6691','Texto a utilizar cuando el ordenamiento expuesto sea descendente.','es','0','0','0'),('6692','Seleccione cualquier filtro y haga clic en Aplicar para ver los resultados','es','0','0','0'),('6693','Texto por pedido','es','0','0','0'),('6694','El número de artículos a omitir. Por ejemplo, si este campo es 3, los primeros 3 elementos serán omitidos y no se mostrarán.','es','0','0','0'),('6695','El número total de páginas. Déjelo vacío para mostrar todas las páginas.','es','0','0','0'),('6696','Opciones expuestas','es','0','0','0'),('6697','Exponer esta opción permite a los usuarios definir sus valores en un formulario expuesto cuando se muestra la vista','es','0','0','0'),('6698','Exponer artículos por página','es','0','0','0'),('6699','Si se marca, los usuarios pueden determinar cuántos elementos mostrar por página en una vista','es','0','0','0'),('6700','Etiqueta de elementos por página','es','0','0','0'),('6701','Etiqueta a utilizar en el elemento expuesto de formulario de elementos por página.','es','0','0','0'),('6702','Opciones de elementos expuestos por página','es','0','0','0'),('6703','Exponer desplazamiento','es','0','0','0'),('6704','Etiqueta de desplazamiento','es','0','0','0'),('6705','Etiqueta a usar en el elemento de formulario de desplazamiento expuesto.','es','0','0','0'),('6706','El desplazamiento debe ser un número mayor o igual a 0.','es','0','0','0'),('6707','Mini paginador, @count elemento, saltar @skip','es','0','0','0'),('6708','Mini paginador, @count elementos, saltar @skip','es','6707','1','0'),('6709','Mini paginador, @count elemento','es','0','0','0'),('6710','Mini paginador, @count elementos','es','6709','1','0'),('6711','Todos los elementos, omitir @skip','es','0','0','0'),('6712','Todos los elementos','es','0','0','0'),('6713','@count elemento, saltar @skip','es','0','0','0'),('6714','@count elementos, omitir @skip','es','6713','1','0'),('6715','@count elemento','es','0','0','0'),('6716','Agrupar resultados','es','0','0','0'),('6717','Módulo de autentificación','es','0','0','0'),('6718','En la base de datos','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6719','Vista previa de la actualización','es','0','0','0'),('6720','@entity:@bundle','es','0','0','0'),('6721','No está vacío (NOT NULL)','es','0','0','0'),('6722','Esa vista fue creada para la version @import_version de vistas, pero ud. solo tiene @api_version','es','0','0','0'),('6723','Manejador roto/no encontrado: @table > @field','es','0','0','0'),('6724','La visualizacion %display ha establecido node/% como la ruta. Esto no va a producir lo que usted desea. Si usted desea tener varias versiones de la vista de nodo, use paneles.','es','0','0','0'),('6725','@category: @field-name','es','0','0','0'),('6726','Traducir enlace','es','0','0','0'),('6727','Proporciona un enlace directo para traducir el nodo.','es','0','0','0'),('6728','ID Authmap','es','0','0','0'),('6729','El ID del Authmap.','es','0','0','0'),('6730','Nombre de Autentificación','es','0','0','0'),('6731','El nombre de autentificación único.','es','0','0','0'),('6732','El nombre del módulo que administra la entrada de autenticación.','es','0','0','0'),('6733','Utilizar enlace absoluto (empieza con «http://»)','es','0','0','0'),('6734','Mostrar nombre interno del sistema','es','0','0','0'),('6735','Usar la ruta de término de taxonomía de Drupal para crear enlaces de ayuda a la  navegación.','es','0','0','0'),('6736','Si se marca, los enlaces de ayuda a la navegación serán creados utilizando el método estándar de Drupal en lugar del método personalizado de Views. Esto es útil si está utilizando módulos como Taxonomy Redirect para modificar sus enlaces a términos de taxonomía.','es','0','0','0'),('6737','Cambiar los nombres de clase CSS que serán agregados a esta presentación.','es','0','0','0'),('6738','Los nombres de clases CSS serán agregados a la vista. Esto le permite utilizar código CSS específico para cada vista. Puede definir múltiples clases separadas por espacios.','es','0','0','0'),('6739','Las clases CSS deben ser solo alfanuméricas o guiones.','es','0','0','0'),('6740','Elegir texto','es','0','0','0'),('6741','El texto que aparecerá como la opción seleccionada en el menú de salto.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6742','Enlace de edición de término','es','0','0','0'),('6743','Proporciona un enlace sencillo para editar el término.','es','0','0','0'),('6744','Especifique entre cuales valores puede elegir el usuario al determinar los elementos por página. Separados por comas.','es','0','0','0'),('6745','Si se marca, los usuarios pueden determinar cuántos elementos deberían ser omitidos al principio.','es','0','0','0'),('6746','Por favor escriba una lista de valores numéricos enteros separados por comas: e.g: 10, 20, 50, 100','es','0','0','0'),('6747','¡El controlador @handler intentó agregar el campo adicional @identifier pero @table no pudo ser añadido!','es','0','0','0'),('6748','Llenar una sola línea','es','0','0','0'),('6749','Clase de fila','es','0','0','0'),('6750','- Usar predeterminado -','es','0','0','0'),('6751','Tipo de contenido desconocido','es','0','0','0'),('6752','La ruta del archivo primario para este elemento, relativa a la raíz de Drupal; e.g. modules/node/node.module.','es','0','0','0'),('6753','El nombre del elemento; por ejemplo: nodo.','es','0','0','0'),('6754','El tipo de elemento, ya sea módulo, tema o motor de temas.','es','0','0','0'),('6755','Valor booleano que indica si este elemento está activo o no.','es','0','0','0'),('6756','Versión del esquema','es','0','0','0'),('6757','El número de versión del esquema de base de datos del módulo. -1 si el módulo no está instalado (sus tablas no existen); 0 o el N más grande de la función hook_update_N() del módulo que haya sido ejecutado o haya existido cuando el módulo fue instalado originalmente.','es','0','0','0'),('6758','Nombre interno para el sistema','es','0','0','0'),('6759','Valor fijo','es','0','0','0'),('6760','Ascendente','es','0','0','0'),('6761','Acceder a las páginas de administración de vistas.','es','0','0','0'),('6762','Saltar el control de acceso al accesar las vistas.','es','0','0','0'),('6763','Agregar nueva vista','es','0','0','0'),('6764','- Validación básica -','es','0','0','0'),('6765','Elemento HTML','es','0','0','0'),('6766','Elemento HTML de etiqueta','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6767','Colocar dos puntos después de la etiqueta','es','0','0','0'),('6768','Elemento HTML de envoltorio','es','0','0','0'),('6769','Clase del envoltorio','es','0','0','0'),('6770','Agregar clases predefinidas','es','0','0','0'),('6771','Utilizar clases predefinidas de Views para identificar el campo, la etiqueta del campo, y el contenido del campo.','es','0','0','0'),('6772','Usar ruta absoluta','es','0','0','0'),('6773','Texto «Rel»','es','0','0','0'),('6774','Incluir el atributo «Rel» para uso en lightbox2 u otra utilidad javascript.','es','0','0','0'),('6775','Preservar ciertas etiquetas','es','0','0','0'),('6776','Lista de las etiquetas que deben ser conservados durante el proceso de extracción. ejemplo  &quot;&lt;p&gt; &lt;br&gt;&quot; que preserven todos los elementos p y br','es','0','0','0'),('6777','Escriba expresiones matemáticas tales como 2 + 2 o sqrt(5). Puede asignar variables y crear funciones matemáticas y evaluarlas. Utilice el ; para separarlas. Por ejemplo: f(x) = x + 2; f(2).','es','0','0','0'),('6778','Formatear plural','es','0','0','0'),('6779','Si se marca, se utilizará un manejo especial para la pluralidad.','es','0','0','0'),('6780','Forma singular','es','0','0','0'),('6781','Texto a utilizar para la forma singular.','es','0','0','0'),('6782','Forma plural','es','0','0','0'),('6783','Texto a utilizar para la forma plural, @count será reemplazado por el valor.','es','0','0','0'),('6784','Un desplazamiento de la hora actual, tal como «!example1» o «example2»','es','0','0','0'),('6785','Un nombre interno del sistema único para este View. Debe contener únicamente letras minúsculas, números y guiones bajos.','es','0','0','0'),('6786','Peso para @display','es','0','0','0'),('6787','Método de traducción','es','0','0','0'),('6788','Seleccione un método de traducción para usar en datos de Views como encabezado, pie de página y texto vacío.','es','0','0','0'),('6789','Este título se mostrará en la página de edición de vistas en lugar del predefinido. Esto puede ser útil si tiene el mismo elemento dos veces.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6790','No pasar las cadenas administrativas para su traducción.','es','0','0','0'),('6791','Utilzar la función t() del núcleo de Drupal. No es recomendable, ya que no es compatible con las actualizaciones a las cadenas existentes.','es','0','0','0'),('6792','ID de elemento de canal','es','0','0','0'),('6793','El guid del elemento importado originalmente.','es','0','0','0'),('6794','Fecha y hora de cuando el comentario fue creado.','es','0','0','0'),('6795','Fecha y hora de cuando el comentario fue actualizado por última vez.','es','0','0','0'),('6796','Si el comentario fue aprobado (o aún está en la cola de moderación).','es','0','0','0'),('6797','Comentario aprobado','es','0','0','0'),('6798','CID del último comentario','es','0','0','0'),('6799','Mostrar el último comentario de un nodo','es','0','0','0'),('6800','Último Comentario','es','0','0','0'),('6801','El último comentario de un nodo.','es','0','0','0'),('6802','Algunos roles carecen de permiso para acceder al contenido, pero la presentación %display no tiene ningún control de acceso.','es','0','0','0'),('6803','La extensión del archivo.','es','0','0','0'),('6804','Uso del Archivo','es','0','0','0'),('6805','Un archivo que está asociado con este nodo, usualmente debido a que está en un campo en el nodo.','es','0','0','0'),('6806','Un usuario que está asociado con este archivo, usualmente porque este archivo está en un campo en el usuario.','es','0','0','0'),('6807','Un archivo que está asociado con este usuario, usualmente debido a que está en un campo en el usuario.','es','0','0','0'),('6808','Un comentario que está asociado con este archivo, usualmente debido a que este archivo está en un campo en el comentario.','es','0','0','0'),('6809','Un archivo que está asociado con este comentario, usualmente porque está en un campo en el comentario.','es','0','0','0'),('6810','Un término de taxonomía que está asociado con este archivo, usualmente debido a que este archivo está en un campo en el término de taxonomía.','es','0','0','0'),('6811','Un archivo que está asociado con este término de taxonomía, usualmente debido a que está en un campo en el término de taxonomía.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6812','Vocabulario de taxonomía','es','0','0','0'),('6813','Un vocabulario de taxonomía que está asociado con este archivo, usualmente debido a que este archivo está en un campo en el vocabulario de taxonomía.','es','0','0','0'),('6814','Un archivo que está asociado con este vocabulario de taxonomía, usualmente debido a que está en un campo en el vocabulario de taxonomía.','es','0','0','0'),('6815','El módulo que maneja esta relación de archivos.','es','0','0','0'),('6816','El tipo de entidad que está relacionado con el archivo.','es','0','0','0'),('6817','La cantidad de veces que el archivo es utilizado por esta entidad.','es','0','0','0'),('6818','Nombre interno del sistema del vocabulario al cual pertenece un término. Este será el vocabulario del que será cualquier término del campo «Taxonomía: Término»; y de forma similar puede causar duplicados.','es','0','0','0'),('6819','término de !field_name','es','0','0','0'),('6820','Expresión matemática','es','0','0','0'),('6821','Evalúa una expresión matemática y la muestra.','es','0','0','0'),('6822','Usar destino','es','0','0','0'),('6823','Agregar destino al enlace','es','0','0','0'),('6824','Mostar el enlace de comentarios en el formulario utilizado en los resúmenes estándar de nodos, en lugar de en el formulario del nodo completo.','es','0','0','0'),('6825','Columna de ordenamiento por clic','es','0','0','0'),('6826','Utilizado por Estilo: Tabla para determinar la columna actual por la cual ordenar el campo por clic. El valor predeterminado está bien usualmente.','es','0','0','0'),('6827','Columna de agrupación','es','0','0','0'),('6828','Elija la columna de este campo a la cual aplicar la función de agrupación seleccionada arriba.','es','0','0','0'),('6829','Columnas de agrupación (adicionales)','es','0','0','0'),('6830','Elija columnas adicionales de este campo para incluir en la consulta y utilizar para agrupar.','es','0','0','0'),('6831','Mostrar la ruta de descarga en lugar del URI del almacenamiento del archivo','es','0','0','0'),('6832','Esto proporcionará la URL completa de descarga en lugar de la dirección interna del archivo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6833','El nombre interno del sistema para el vocabulario al cual pertenece el término.','es','0','0','0'),('6834','Mostrar mensaje de error','es','0','0','0'),('6835','Nombre de término convertido a ID de término','es','0','0','0'),('6836','No hay comentarios','es','0','0','0'),('6837','Comentar o documentar esta presentación.','es','0','0','0'),('6838','Opciones de configuración de consulta','es','0','0','0'),('6839','Permitir establecer algunas opciones avanzadas para la extensión de consulta','es','0','0','0'),('6840','El nombre y la descripción de esta presentación','es','0','0','0'),('6841','Este nombre sólo aparecerá en la interfaz administrativa de la Vista.','es','0','0','0'),('6842','Esta descripcion sólo aparecerá en la interfaz administrativa de la Vista.','es','0','0','0'),('6843','Los comentarios de esta presentación','es','0','0','0'),('6844','Este valor será visto y usado solo dentro de la interfaz de Views y puede ser utilizado para documentar esta presentación. Puede utilizar esto para proporcionar notas para otros o futuros mantenedores de su sitio acerca de cómo o por qué está configurada esta presentación.','es','0','0','0'),('6845','Opciones de consulta','es','0','0','0'),('6846','El nombre de la presentación debe contener solo letras, números o guiones bajos.','es','0','0','0'),('6847','¿Debería esta presentación heredar sus valores de paginación de la presentación padre a la que está adjunta?','es','0','0','0'),('6848','¿Debería esta presentación mostrar los valores de paginador? Esto solo es relevante si se está heredando un paginador.','es','0','0','0'),('6849','Esto aparecerá como el nombre de este bloque en administrar >> estructura >> bloques.','es','0','0','0'),('6850','Texto a mostrar en lugar de los resultados si el usuario selecciona y aplica un filtro expuesto.','es','0','0','0'),('6851','Opción de incluir todos los elementos','es','0','0','0'),('6852','Si se marca, un elemento adicional será incluido a los elementos por página para mostrar todos los elementos','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6853','Etiqueta de todos los elementos','es','0','0','0'),('6854','Cuál etiqueta se utilizará para mostrar todos los elementos','es','0','0','0'),('6855','Desactivar reescritura de SQL','es','0','0','0'),('6856','ADVERTENCIA: Desactivar sobrescritura de SQL significa que la seguridad de acceso a nodos queda desactivada. Esto puede permitir que los usuarios vean datos que no deberían poder ver si su vista está mal configurada. Por favor utilice esta opción solo si entiende y acepta este riesgo de seguridad.','es','0','0','0'),('6857','Usar servidor esclavo','es','0','0','0'),('6858','Esto hará que la consulta intente conectarse a un servidor esclavo si está disponible. Si no hay ningún servidor esclavo definido o disponible, se replegará al servidor predeterminado.','es','0','0','0'),('6859','Idioma de campo','es','0','0','0'),('6860','Todos los campos que soportan traducciones serán mostrados en el idioma seleccionado.','es','0','0','0'),('6861','La clase a proporcionar en cada fila.','es','0','0','0'),('6862','Resumen de la tabla','es','0','0','0'),('6863','Este valor se mostrará como atributo table-summary en el HTML. Active esto para una mejor accesibilidad en su sitio.','es','0','0','0'),('6864','Si se marca, se mostrará la ruta actual como la opción predeterminada en el menú de salto, si es aplicable.','es','0','0','0'),('6865','La clase a proporcionar al contenedor, afuera de la lista.','es','0','0','0'),('6866','Clase del listado','es','0','0','0'),('6867','La clase a proporcionar al elemento de la lista propiamente.','es','0','0','0'),('6868','Defina la ruta base para los enlaces en esta vista de resumen, por ejemplo: http://ejemplo.com/<strong>su_ruta_de_vista/archivo</strong>.\r\n        No incluya barras inclinadas al principio ni al final. Si este valor está vacío, las vistas usarán la primera ruta que se encuentre como la ruta base, en presentaciones de páginas, si no se puede encontrar ninguna ruta.','es','0','0','0'),('6869','Acceso al contenido','es','0','0','0'),('6870','Revisiones de contenido','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6871','Nombre de sistema: ','es','0','0','0'),('6872','Saltar el control de acceso de las vistas','es','0','0','0'),('6873','Comportamiento si no hay resultados','es','0','0','0'),('6874','Editar @section','es','0','0','0'),('6875','Edite esta vista para agregar una visualización.','es','0','0','0'),('6876','Agregar vista desde plantilla','es','0','0','0'),('6877','Vista a insertar','es','0','0','0'),('6878','La vista a insertar en esta área.','es','0','0','0'),('6879','Heredar filtros contextuales','es','0','0','0'),('6880','Si se marca, esta vista recibirá los mismos filtros contextuales que su padre.','es','0','0','0'),('6881','Recursividad detectada en la vista @view presentación @display.','es','0','0','0'),('6882','Cuando el valor del filtro <em>NO</em> está en la URL','es','0','0','0'),('6883','Valor de la excepción','es','0','0','0'),('6884','Si se recibe este valor, el filtro será ignorado; i.e, «todos los valores»','es','0','0','0'),('6885','Sobrescribir la vista y otros títulos de argumento. Utilice «%1» para el primer argumento, «%2» para el segundo, etc.','es','0','0','0'),('6886','Cuando el valor del filtro <em>SÍ</em> está en la URL o se proporciona un valor predeterminado','es','0','0','0'),('6887','Proporcionar título','es','0','0','0'),('6888','Sobrescribir enlaces de ayuda a la navegación','es','0','0','0'),('6889','Proporcionar enlaces de ayuda a la navegación','es','0','0','0'),('6890','Escriba un nombre que le gustaría usar para los enlaces de ayuda a la navegación. Véase «Título» para sustituciones de porcentajes.','es','0','0','0'),('6891','Especificar criterios de validación','es','0','0','0'),('6892','Acción a tomar si el valor del filtro no pasa la validación','es','0','0','0'),('6893','Muestra todos los resultados para el campo especificado','es','0','0','0'),('6894','Proporcionar valor predeterminado','es','0','0','0'),('6895','Mostrar «Página no encontrada»','es','0','0','0'),('6896','Mostrar un resumen','es','0','0','0'),('6897','Mostrar contenido de «No se encontraron resultados»','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6898','Saltar argumento predeterminado para la URL de la vista','es','0','0','0'),('6899','Seleccionar si se incluye este argumento predeterminado al construir la URL para esta vista. Saltar argumentos predeterminados es útil e.g. en caso de fuentes web.','es','0','0','0'),('6900','Número de registros','es','0','0','0'),('6901','Orden predeterminado en contexto: Orden','es','0','0','0'),('6902','Fecha en contexto: Orden','es','0','0','0'),('6903','Numérico en contexto: Orden','es','0','0','0'),('6904','Si se marca, los usuarios pueden escribir múltiples valores en el formato 1+2+3 (para O) o 1,2,3 (para Y).','es','0','0','0'),('6905','Si se marca, múltiples instancias de este filtro pueden trabajar juntas, como si se proporcionaran múltiples valores al mismo filtro. Esta opción no es compatible con la opción «Reducir duplicados».','es','0','0','0'),('6906','Si se marca, los números indicados para el filtro serán excluidos en lugar de limitar la vista.','es','0','0','0'),('6907','El modo glosario aplica un límite al número de caracteres utilizados en el valor del filtro, lo cual permite que la vista de resumen funcione como un glosario.','es','0','0','0'),('6908','Alfabético en contexto: Orden','es','0','0','0'),('6909','Crear una etiqueta','es','0','0','0'),('6910','Active para crear una etiqueta para este campo.','es','0','0','0'),('6911','Active para cargar este campo como oculto. Con frecuencia utilizado para agrupar campos, o para usar como un «token» en otro campo.','es','0','0','0'),('6912','Seleccione el elemento HTML a colocar alrededor de este campo, e.g. H1, H2, etc.','es','0','0','0'),('6913','Crear una clase CSS','es','0','0','0'),('6914','Seleccione el elemento HTML a colocar alrededor de esta etiqueta, e.g. H1, H2, etc.','es','0','0','0'),('6915','Reescribir resultados','es','0','0','0'),('6916','Active para sobrescribir la salida de este campo con texto personalizado o «tokens» de remplazo.','es','0','0','0'),('6917','Remplazar espacios con guiones','es','0','0','0'),('6918','URL de servidor externo','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6919','Enlaces a un servidor externo utilizando una URL completa: e.g. «http://www.ejemplo.com» o «www.ejemplo.com».','es','0','0','0'),('6920','Active para recortar el campo a una longitud máxima de caracteres','es','0','0','0'),('6921','Si se selecciona, todos los caracteres de salto de línea (p.e. \\n) se convertirán en etiquetas HTML &lt;br&gt.','es','0','0','0'),('6922','Texto de «no hay resultados»','es','0','0','0'),('6923','Active para mostrar el texto de «no hay resultados» si el campo contiene el número 0.','es','0','0','0'),('6924','Datos completos (no en serie)','es','0','0','0'),('6925','Datos completos (en serie)','es','0','0','0'),('6926','Cuántas unidades diferentes mostrar en la cadena.','es','0','0','0'),('6927','Este filtro no está expuesto. Expóngalo para permitir a los usuarios cambiarlo.','es','0','0','0'),('6928','Exponer filtro','es','0','0','0'),('6929','Este filtro está expuesto. Si lo oculta, los usuarios no podrán cambiarlo.','es','0','0','0'),('6930','Ocultar filtro','es','0','0','0'),('6931','Exponer operador','es','0','0','0'),('6932','Permitir al usuario elegir el operador.','es','0','0','0'),('6933','Permitir selecciones múltiples','es','0','0','0'),('6934','Active para permitir a los usuarios seleccionar múltiples elementos.','es','0','0','0'),('6935','Recordar la última selección','es','0','0','0'),('6936','Active para recordar la última selección hecha por el usuario.','es','0','0','0'),('6937','Debe seleccionar un valor a menos que este sea un filtro expuesto no obligatorio.','es','0','0','0'),('6938','Active para ocultar elementos que no contienen esta relación','es','0','0','0'),('6939','Este orden no está expuesto. Expóngalo para permitir a los usuarios cambiarlo.','es','0','0','0'),('6940','Exponer orden','es','0','0','0'),('6941','Este orden está expuesto. Si lo oculta, los usuarios no podrán cambiarlo.','es','0','0','0'),('6942','Ocultar orden','es','0','0','0'),('6943','Proporcionar descripción','es','0','0','0'),('6944','Guardar y salir','es','0','0','0'),('6945','Continuar y editar','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6946','Actualizar opción «@title»','es','0','0','0'),('6947','Actualizar opción «@title» (@number)','es','0','0','0'),('6948','Su vista fue guardada. Puede editarla de la lista abajo.','es','0','0','0'),('6949','Código de sobreescritura de base de datos','es','0','0','0'),('6950','* Todos los cambios son almacenados temporalmente. Haga click en Guardar para hacer permanentes sus cambios. Haga clic en Cancelar para descartar la vista.','es','0','0','0'),('6951','* Todos los cambios son almacenados de forma temporal. Haga clic en Guardar para hacer sus cambios permanentes. Haga clic en Cancelar para descartar sus cambios.','es','0','0','0'),('6952','Modificar las visualizaciones de su vista abajo o agregar nuevas visualizaciones.','es','0','0','0'),('6953','editar nombre/descripción de la vista','es','0','0','0'),('6954','analizar vista','es','0','0','0'),('6955','clonar vista','es','0','0','0'),('6956','exportar vista','es','0','0','0'),('6957','deshacer vista','es','0','0','0'),('6958','eliminar vista','es','0','0','0'),('6959','Agregar !display','es','0','0','0'),('6960','Detalles de @display_title','es','0','0','0'),('6961','Previsualización automática','es','0','0','0'),('6962','Previsualización con filtros contextuales:','es','0','0','0'),('6963','Separe los valores de los filtros contextuales con un «/». Por ejemplo, %example.','es','0','0','0'),('6964',':','es','0','0','0'),('6965','Aplicar y continuar','es','0','0','0'),('6966','@current de @total','es','0','0','0'),('6967','Todas las presentaciones (excepto las sobrescritas)','es','0','0','0'),('6968','Todas las presentaciones','es','0','0','0'),('6969','Este @display_type (sobrescribir)','es','0','0','0'),('6970','Nombre y descripción de la vista','es','0','0','0'),('6971','Un nombre para esta vista que sea descriptivo para los usuarios. Los espacios están permitidos.','es','0','0','0'),('6972','Crear nuevo grupo de filtros','es','0','0','0'),('6973','No se ha agregado ningún filtro.','es','0','0','0'),('6974','Arrastre para agregar filtros.','es','0','0','0'),('6975','Agregar y configurar @types','es','0','0','0');
INSERT INTO `locales_target` VALUES ('6976','Configurar @type: @item','es','0','0','0'),('6977','Mostrar filtros en el listado de vistas','es','0','0','0'),('6978','Mostrar advertencia de ayuda avanzada','es','0','0','0'),('6979','Siempre mostar la presentación principal','es','0','0','0'),('6980','Usuarios avanzados de Views pueden optar por ver la presentación principal (i.e. predeterminada).','es','0','0','0'),('6981','Siempre mostrar las opciones avanzadas de presentación','es','0','0','0'),('6982','Mostrar por defecto las opciones avanzadas de presentación, tales como relaciones y filtros contextuales.','es','0','0','0'),('6983','Etiqueta para «Cualquier» valor en filtros expuestos no obligatorios de selección única','es','0','0','0'),('6984','Configuración de vista previa en vivo','es','0','0','0'),('6985','Actualizar la vista previa automáticamente en cada cambio','es','0','0','0'),('6986','Mostrar información y estadísticas acerca de la vista durante la vista previa en vivo','es','0','0','0'),('6987','Arriba de la vista previa','es','0','0','0'),('6988','Abajo de la vista previa','es','0','0','0'),('6989','Mostrar la consulta SQL','es','0','0','0'),('6990','Mostrar estadísticas de desempeño','es','0','0','0'),('6991','Deshabilitar JavaScript con Views','es','0','0','0'),('6992','Si está teniendo problemas con JavaScript, puede deshabilitarlo aquí. La interfaz de Views debería degradarse y todavía ser utilizable sin JavaScript; pero no es tan buena.','es','0','0','0'),('6993','No hay plantillas disponibles.','es','0','0','0'),('6994','Lista sin formato','es','0','0','0'),('6995','Lista HTML','es','0','0','0'),('6996','Filtros contextuales','es','0','0','0'),('6997','filtros contextuales','es','0','0','0'),('6998','Filtro contextual','es','0','0','0'),('6999','filtro contextual','es','0','0','0'),('7000','criterio de filtrado','es','0','0','0'),('7001','Criterios de filtrado','es','0','0','0'),('7002','criterios de filtrado','es','0','0','0'),('7003','comportamiento si no hay resultados','es','0','0','0'),('7004','El contenido para el cual el comentario es una respuesta.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7005','El ID del nodo.','es','0','0','0'),('7006','El título del contenido.','es','0','0','0'),('7007','La fecha en que el contenido fue enviado.','es','0','0','0'),('7008','La fecha en que el contenido fue actualizado por última vez.','es','0','0','0'),('7009','El tipo de contenido (por ejemplo, «entrada de blog», «envío de foro», «artículo», etc).','es','0','0','0'),('7010','Si el contenido está publicado o no.','es','0','0','0'),('7011','Ignora el contenido sin publicar si el usuario actual no puede verlo.','es','0','0','0'),('7012','Si el contenido está promocionado a la página principal o no.','es','0','0','0'),('7013','Si el contenido está fijo en la cabeza de las listas o no.','es','0','0','0'),('7014','Si el contenido está fijo en la cabeza de las listas o no. Para listar primero el contenido que está fijo en la cabeza de las listas, establezca esto a descendente.','es','0','0','0'),('7015','Proporcionar un enlace sencillo al contenido.','es','0','0','0'),('7016','Proporcionar un enlace sencillo para editar el contenido.','es','0','0','0'),('7017','Proporciona un enlace simple para eliminar el contenido.','es','0','0','0'),('7018','La ruta con alias a este contenido.','es','0','0','0'),('7019','Relacionar el contenido con el usuario que lo creo.','es','0','0','0'),('7020','El usuario tiene una revisión','es','0','0','0'),('7021','Todos los nodos donde un usuario concreto tiene una revisión','es','0','0','0'),('7022','Revisión del contenido','es','0','0','0'),('7023','Revisión de contenido es un historial de cambios al contenido.','es','0','0','0'),('7024','Relacionar una revisión de contenido con el usuario que creó la revisión.','es','0','0','0'),('7025','El ID de revisión de la revisión del contenido.','es','0','0','0'),('7026','Obtener el contenido real de una revisión de contenido.','es','0','0','0'),('7027','Proporciona un enlace simple para eliminar la revisión del contenido.','es','0','0','0'),('7028','Filtrar para contenido por acceso a la vista.  <strong>No es necesario si está usando nodo como su tabla base.</strong>','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7029','Mostrar un marcador si el contenido es nuevo o actualizado.','es','0','0','0'),('7030','Mostrar sólo el contenido nuevo o actualizado.','es','0','0','0'),('7031','Mostrar el contenido con la vista estándar de nodo.','es','0','0','0'),('7032','ID de contenido desde URL','es','0','0','0'),('7033','Contenido asociado con este archivo, usualmente porque este archivo está en un campo con el contenido.','es','0','0','0'),('7034','Módulo/Tema/Motor de tema','es','0','0','0'),('7035','Módulos/Temas/Motores de temas en su base de código.','es','0','0','0'),('7036','Nombre de archivo de Módulo/Tema/Motor de temas','es','0','0','0'),('7037','Nombre del Módulo/Tema/Motor de temas','es','0','0','0'),('7038','Permite que la «profundidad» para Taxonomía: ID de término (con profundidad) pueda ser modificada por medio de un valor adicional de filtro contextual.','es','0','0','0'),('7039','Contenido que no se ha traducido o que es la versión original de un conjunto de traducción.','es','0','0','0'),('7040','Contenido que es una traducción de una traducción de la fuente.','es','0','0','0'),('7041','El estado de traducción del contenido - si la traducción debe ser actualizada o no.','es','0','0','0'),('7042','Contenido generado','es','0','0','0'),('7043','Relacionar el contenido con el usuario que lo creo. Esta relación creará un registro para cada elemento de contenido creado por el usuario.','es','0','0','0'),('7044','Proporcionar un enlace sencillo para cancelar el usuario.','es','0','0','0'),('7045','Proporcionar datos serializados del usuario','es','0','0','0'),('7046','Permitir que un valor de filtro contextual sea ignorado. La consulta no será alterada por este valor de filtro contextual. Puede ser utilizado cuando los valores de filtros contextuales vengan de la URL, y una parte de la URL deba ser ignorada.','es','0','0','0'),('7047','Área de vista','es','0','0','0'),('7048','Insertar una vista dentro de un área.','es','0','0','0'),('7049','Active para sobrescribir los enlaces de este campo.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7050','Utilizar plantilla de campo','es','0','0','0'),('7051','Si se marca, las clases de la API de campos serán agregadas utilizando field.tpl.php (o su equivalente). Esto no es recomendado a menos que su CSS dependa de estas clases. Si no se marca, la plantilla no será utilizada.','es','0','0','0'),('7052','Marcar esta opción hará que se ignoren los valores de agrupar Tipo de Presentación y Separadores.','es','0','0','0'),('7053','Configuración de campos múltiples','es','0','0','0'),('7054','Mostrar todos los valores en la misma fila','es','0','0','0'),('7055','Mostrar @count valor(es)','es','0','0','0'),('7056','@column sin filtrar','es','0','0','0'),('7057','Idioma nativo','es','0','0','0'),('7058','Si se activa, se mostrará el nombre nativo del idioma','es','0','0','0'),('7059','Enlazar este campo a la pieza original de contenido','es','0','0','0'),('7060','Active esta opción para mostrar un enlace absoluto. Es requerido si quiere utilizar la ruta como un destino de enlace (como en «mostrar este campo como un enlace» arriba).','es','0','0','0'),('7061','Enlazar este campo a su revisión de contenido','es','0','0','0'),('7062','Mostrar campo como el nombre interno del sistema del tipo de contenido.','es','0','0','0'),('7063','Elija uno o más tipos de contenido con los cuales validar.','es','0','0','0'),('7064','Verificar que el usuario tenga acceso al contenido','es','0','0','0'),('7065','Acceder a la operación a revisar','es','0','0','0'),('7066','Formato del valor del filtro','es','0','0','0'),('7067','Mostrar comentarios','es','0','0','0'),('7068','Elija un campo predeterminado de orden de tabla alternativo para utilizar cuando el campo de calificación de búsqueda no esté disponible.','es','0','0','0'),('7069','Si se marca, los usuarios pueden escribir múltiples valores en la forma 1+2+3. Debido al número de consultas «JOIN» que requeriría, «Y» será tratado como «O» con este filtro.','es','0','0','0'),('7070','Cargar filtro predeterminado de página de término','es','0','0','0'),('7071','Tipo de valor de filtro','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7072','Seleccione la forma de este valor de filtro; si se está utilizando el nombre de un término, es generalmente más eficiente convertirlo a un ID de término y utilizar «Taxonomía: ID de Término» en lugar de «Taxonomía: Nombre de Término» como el filtro.','es','0','0','0'),('7073','Transformar guiones en la URL a espacios en los valores de filtro del nombre del término','es','0','0','0'),('7074','Incluir contenido no traducido','es','0','0','0'),('7075','Active para mostrar un texto distinto para usuarios anónimos.','es','0','0','0'),('7076','Tipo de valor de filtro de usuario a permitir','es','0','0','0'),('7077','Tenga en cuenta que usted no tiene permiso para modificar esto. Si cambia el tipo de filtro predeterminado, esta opción se perderá y usted NO podrá recuperarla.','es','0','0','0'),('7078','Código del filtro contextual de PHP','es','0','0','0'),('7079','Cambiar la manera en que se da formato al contenido.','es','0','0','0'),('7080','Cambiar opciones de configuración para este formato','es','0','0','0'),('7081','Cambiar la forma en que se estiliza cada fila en la vista.','es','0','0','0'),('7082','Ocultar adjuntos en el resumen','es','0','0','0'),('7083','Cambiar si se muestran o no los adjuntos cuando se muestra un resumen de filtro contextual.','es','0','0','0'),('7084','Ocultar adjuntos al desplegar un resumen de filtro contextual','es','0','0','0'),('7085','También puede ajustar las !settings para la restricción de acceso seleccionada actualmente.','es','0','0','0'),('7086','También puede ajustar las !settings para el mecanismo de caché seleccionado actualmente.','es','0','0','0'),('7087','También puede ajustar las !settings para el estilo seleccionado actualmente.','es','0','0','0'),('7088','También puede ajustar las !settings para el estilo de fila seleccionado actualmente.','es','0','0','0'),('7089','También puede ajustar las !settings para el paginador seleccionado actualmente.','es','0','0','0'),('7090','Posición del adjunto','es','0','0','0'),('7091','¿Debería esta presentación heredar sus valores de filtros contextuales de la presentación padre a la que está adjunta?','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7092','Caché de bloques','es','0','0','0'),('7093','Esta vista se mostrará al visitar esta ruta en su sitio. Se recomienda que la ruta sea algo similar a "ruta/%/%/feed" or "ruta/%/%/rss.xml", escribiendo un % en la ruta para cada filtro contextual que se haya definido en la vista.','es','0','0','0'),('7094','Esta vista se mostrará al visitar esta ruta en el sitio. Puede utilizar «%» en la URL para representar valores que serán utilizados para filtros contextuales: Por ejemplo, «node/%/feed»','es','0','0','0'),('7095','La presentación @display está configurada para usar un menú pero el texto del enlace del menú no está definido.','es','0','0','0'),('7096','La presentación @display está configurada para usar un menú padre pero el texto del enlace del menú padre no está definido.','es','0','0','0'),('7097','Paginado, @count elementos, saltar @skip','es','6713','1','0'),('7098','Paginado, @count elementos','es','6715','1','0'),('7099','Desactivar sobrescritura de SQL desactivará las revisiones de node_access, así como otros módulos que implementan hook_query_alter().','es','0','0','0'),('7100','Si desactiva esta opción, una cuadrícula con una sola fila tendrá el mismo número de celdas de tabla (<TD>) que elementos. Desactivarla puede ocasionar problemas con su CSS.','es','0','0','0'),('7101','Si se marca, se mostrará el valor de filtro contextual actual como la opción predeterminada en el menú de salto, si es aplicable.','es','0','0','0'),('7102','Por defecto la tabla se oculta para una vista vacía. Con esta opción, es posible mostrar una tabla vacía con el texto adentro.','es','0','0','0'),('7103','Todo el almacenamiento','es','0','0','0'),('7104','Todos los estados','es','0','0','0'),('7105','Sin etiquetas','es','0','0','0'),('7106','Ninguna vista coincide con los criterios de búsqueda.','es','0','0','0'),('7107','Crear vista de la plantilla @template','es','0','0','0'),('7108','Clon de','es','0','0','0'),('7109','Clon @count de','es','7108','1','0'),('7110','Esta acción eliminará permanentemente cualquier personalización que se haya hecho a esta vista.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7111','Esta vista ha sido revertida.','es','0','0','0'),('7112','Esta acción eliminará permanentemente la vista de su base de datos.','es','0','0','0'),('7113','Crear una página','es','0','0','0'),('7114','Crear un enlace de menú','es','0','0','0'),('7115','Incluir un Feed RSS','es','0','0','0'),('7116','Ruta de la fuente web','es','0','0','0'),('7117','Estilo de fila del canal de noticias','es','0','0','0'),('7118','Crear un bloque','es','0','0','0'),('7119','de campos','es','0','0','0'),('7120','de tipo','es','0','0','0'),('7121','etiquetado con','es','0','0','0'),('7122','Se intentó create_view con valores que no han sido validados','es','0','0','0'),('7123','Determina si se debería mostrar enlaces debajo de cada comentario','es','0','0','0'),('7124','con enlaces (permitir que los usuarios respondan al comentario, etc.)','es','0','0','0'),('7125','sin enlaces','es','0','0','0'),('7126','resúmenes','es','0','0','0'),('7127','envíos completos','es','0','0','0'),('7128','títulos','es','0','0','0'),('7129','títulos (con enlace)','es','0','0','0'),('7130','Debería o no mostrarse enlaces debajo de cada nodo','es','0','0','0'),('7131','con enlaces (permitiendo a los usuarios escribir comentarios, etc.)','es','0','0','0'),('7132','Debería o no mostrarse comentarios debajo de cada nodo','es','0','0','0'),('7133','Número de visitas','es','0','0','0'),('7134','Ocultar vista','es','0','0','0'),('7135','@group (datos históricos)','es','0','0','0'),('7136','Permitir que funcionen a la vez múltiples valores de filtros.','es','0','0','0'),('7137','Personaliza el campo HTML','es','0','0','0'),('7138','reordernar vistas','es','0','0','0'),('7139','habilitar @display_title','es','0','0','0'),('7140','clonar @display_title','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7141','eliminar @display_title','es','0','0','0'),('7142','El estilo o formato de fila seleccionado no utiliza campos.','es','0','0','0'),('7143','@group: @field','es','0','0','0'),('7144','@group (datos históricos): @field','es','0','0','0'),('7145','También conocido como: !also.','es','0','0','0'),('7146','@label (!name:!column)','es','0','0','0'),('7147','@label:!column','es','0','0','0'),('7148','@label (!name:delta)','es','0','0','0'),('7149','@label:delta','es','0','0','0'),('7150','Contenido popular de hoy','es','0','0','0'),('7151','@entity usando @field','es','0','0','0'),('7152','!field_name','es','0','0','0'),('7153','La descripción de la vista.','es','0','0','0'),('7154','El nombre de sistema de la vista.','es','0','0','0'),('7155','El título de la presentación actual de la vista.','es','0','0','0'),('7156','La URL de la vista.','es','0','0','0'),('7214','Cada tipo de campo tiene uno o más <em>widgets</em> asociados; cada widget proporciona un mecanismo para la entrada de datos cuando se edita (campo de texto, lista de selección, subida de archivos, etc.). Cada tipo de campo también tiene una o más opciones de visualización, que determinan cómo se muestra a los visitantes del sitio. El widget y las opciones de visualización se pueden modificar tras haber creado el campo.','es','0','0','0'),('7215','Puedes almacenar un valor, un número máximo específico de valores, o un número ilimitado de valores en cada campo. Por ejemplo, un campo para el número de identificación de un empleado debería almacenar un único número, mientras que un campo para número de teléfono debería almacenar múltiples números de teléfono. Estas opciones se pueden cambiar tras haber creado el campo, pero si se reduce el número máximo de valores, se podría perder información.','es','0','0','0'),('7219','El módulo File permite a los usuarios adjuntar archivos al contenido (por ejemplo, archivos PDF, hojas de cálculo, etc.), cuando un campo de tipo <em>Archivo</em> se añade a un tipo de contenido utilizando el <a href="@fieldui-help">módulo Field UI</a>. Puedes añadir opciones de validación a tu campo de tipo Archivo, como especificar un tamaño máximo de archivo o las extensiones de archivo permitidas.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7220','Cuando Ud. crea un campo de tipo Archivo (File), puede especificar un directorio donde los archivos serán almacenados, que pueda estar tanto dentro del directorio de archivos <em>público</em> o <em>privado</em>. Los archivos en el directorio público pueden ser accedidos directamente a través del servidor web. Cuando se listan archivos públicos, se utilizan vínculos directos a los archivos, y cualquiera que conozca la URL de un archivo puede descargarlo. Los archivos en el directorio privado no son accesibles directamente a través del servidor web. Cuando se listan los archivos privados, los vínculos son pedidos de ubicación a Drupal. Esto le agrega al servidor tiempo de carga y descarga, dado que Drupal debe iniciar y resolver la ubicación para cada pedido de descarga de archivo, pero permite restricciones de acceso.','es','0','0','0'),('7221','Configura los formatos de texto en la <a href="@formats">Página de formatos de texto</a>. <strong>Una configuración incorrecta de los formatos de texto implica un riesgo de seguridad</strong>. Para garantizar la seguridad, los usuarios sin confianza deberían tener acceso únicamente a formatos de texto que les restrijan a usar o texto plano o un conjunto seguro de etiquetas HTML, ya que ciertas etiquetas HTML permiten embeber enlaces malintencionados o scripts en el texto. Los usuarios con más confianza deberían tener permiso para utilizar formatos de texto menos restrictivos, para poder crear contenido enriquecido.','es','0','0','0'),('7223','Los usuarios con acceso a más de un formato de texto pueden usar el campo <em>formato de texto</em> para seleccionar entre los formatos de texto disponibles al momento de crear o editar contenido multi-línea. Los administradores pueden definir los formatos de texto disponibles para cada rol de usuario, y controlar el órden de los formatos en el campo <em>formato de texto</em> on la <a href="@text-formats">página de formatos de texto</a>.','es','0','0','0'),('7225','Este módulo efectuará una redirección 301 de todos los nodos que  tengan un alias de URL pero no lo estén usando.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7227','Permite que su sitio sea rastreado por Google Analytics agregando un código de rastreo Javascript a todas las páginas.','es','0','0','0'),('7229','El módulo de imagen le permite manipular las imágenes en su sitio web. Muestra un conjunto de configuraciones para usar las <em>Herramientas</em>, le permite configurar <em>Estilos</em> que se pueden utilizar para cambiar el tamaño o ajustar las imágenes en la pantalla, y proporciona un <em>Campo</em> de imagen para adjuntar imágenes al contenido. Para obtener más información, vea la entrada del manual on line para <a href="@image">Módulo de Imagen</a>.','es','0','0','0'),('7230','Con el módulo de imagen puede cortar, cambiar el tamaño, rotar y desaturar imágenes sin afectar la imagen original, usando <a href="@image">Estilos de Imagen</a>. Cuando cambia un estilo de imagen, el módulo automáticamente refresca las imágenes creadas. Cada estilo de imagen debe tener un nombre, que es usado en la URL de la imagen generada. Hay dos aproximaciones de nombres de estilos de imagen (de su uso depende cómo el estilo de imagen se aplicará):','es','0','0','0'),('7231','Después de crear un estilo de imagen, puede añadir efectos: cortar, escalar, cambiar el tamaño, rotar y desaturar (otros módulos contribuídos proveen efectos adicionales). Por ejemplo, mediante la combinación de efectos como cortar, escalar y desaturar puede crear miniaturas en tonos de gris.','es','0','0','0'),('7232','El módulo de imagen también le permite adjuntar imágenes al contenido como campos. Para agregar un campo de imagen a los <a href=''@content-type''>tipos de contenido</a>, visite la página <em>gestionar campos</em> y agregue uno nuevo del tipo <em>Imagen</em>. Adjuntar las imágenes al contenido por este medio permite mantener y aplicar los distintos estílos de imagen, a la vez que brinda mayor flexibilidad cuando crea un tema visual.','es','0','0','0'),('7239','El módulo Path permite especificar un alias, o una URL personalizada, para cualquier path interno del sistema. Los aliases no deben ser confundidos con las re-direcciones de URL, que permiten re-dirigir una URL modificada o inactiva a una nueva URL. Además de hacer las URLs mas legibles, los aliases tambien ayudan a los motores de búsqueda a indexar el contenido mas efectivamente. Múltiples aliases pueden ser utilizados para un único path  interno del sistema.\nPara automatizar el proceso de asignar aliases a los paths, puede instalar el módulo contribuido <a href="@pathauto">Pathauto</a>. Para mas información vea la entrada del <a href="@path">módule Path</a> en la guía en línea.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7240','Los usuarios con el permiso de <em>usar el buscador</em> pueden utilizar el bloque de búsqueda y la <a href="@search">página de búsqueda</a>. Los usuarios con el permiso de <em>ver el contenido publicado</em> pueden buscar por contenido que contenga palabras clave exactas. Los usuarios con el permiso de <em>ver perfiles de usuario</em> pueden buscar por usuarios que contengan la clave en cualquier parte del nombre de usuario, y usuarios con el permiso de <em>administrar usuarios</em> pueden buscar usuarios por su dirección de correo electrónico.\nAdicionalmente, los usuarios con el permiso de <em>usar búsqueda avanzada</em> pueden encontrar contenido usando métodos de búsqueda más complejos y aplicar filtros seleccionando la opción de <em>búsqueda avanzada</em> en la <a href="@search">página de búsqueda</a>.','es','0','0','0'),('7241','Para proveer búsqueda por palabras clave, el motor de búsqueda mantiene un índice de palabras encontradas en el contenido y sus campos, junto con el texto agregado al contenido por otros módulos (tales como comentarios del módulo Comment del nucleo y términos de taxonomía del módulo Taxonomy del nucleo). Para construir y mantener este índice, es requerida una  <a href="@cron">tarea de mantenimiento de cron</a> correctamente configurada. Los usuarios con el permiso de <em>administrar búsqueda</em> pueden configurar las opciones de cron en la <a href="@searchsettings">página de configuración de búsqueda</a>.','es','0','0','0'),('7243','El comportamiento de la indexación puede ser ajustado utilizando la <a href="@searchsettings">Página de opciones de búsquedas</a>. Los usuarios con permisos de <em>Administrar búsquedas</em> pueden controlar parámetros como el <em>Número de elementos a indexar en cada ejecución de cron</em>, <em>Opciones de indexación</em> (word length), <em>Módulos de búsqueda activos</em>, y <em>Ranking de contenido</em>, que le permite ajustar la prioridad con la que se devuelve el contenido indexado en los resultados.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7244','Por defecto, el módulo de búsqueda (Search) soporta únicamente coincidencias exactas de claves en las búsquedas de contenido. Ud. puede modificar este comportamiento instalando un módulo de derivados específicos de lenguaje (como <a href="http://drupal.org/project/porterstemmer">Porter Stemmer</a> para Inglés Americano), que permite palabras tales como caminar, caminando y caminado sean consideradas en el módulo Search.\nOtra alternativa es utilizar una tecnología de búsqueda de terceros con capacidades de "derivado" o coincidencia parcial de palabras, como <a href="http://drupal.org/project/apachesolr">Apache Solr</a> o <a href="http://drupal.org/project/sphinx">Sphinx</a>. Estos y otros <a href="@contrib-search">módulos contribuidos de búsqueda</a> pueden ser descargados visitando Drupal.org.','es','0','0','0'),('7246','El módulo Shortcut (atajo) crea un link de agregar/remover para cada página en su sitio. El link le permite agregar o remover la página actual del set de atajos actualmente habilitados (si su tema los muestra y tiene permiso para editar su set de atajos). El tema de administración del core Seven muestra este link luego del título de la página, como un pequeño signo de + o -. Si Ud. hace clic en el signo +, agregará la pagina a su set de atajos preferidos. Si la página ya es parte de su set de atajos, el link será un signo -, y le permitirá remover la página actual de su set de atajos.','es','0','0','0'),('7247','Puedes mostrar tus atajos activando el bloque Atajos en la <a href="@blocks">Página de administración de bloques</a>. Ciertos módulos administrativos también muestran tus atajos; por ejemplo, el <a href="@toolbar-help">módulo Toolbar</a> los muestra cerca de la parte superior de la página, junto a un enlace para <em>Editar atajos</em>.','es','0','0','0'),('7249','El módulo System permite a los usuarios con los permisos adecuados activar o desactivar otros módulos en la <a href="@modules">Página de administración de módulos</a>. Drupal lleva incorporado un número de módulos en el núcleo, y cada módulo proporciona un conjunto de características, y pueden ser activados o desactivados según las necesidades del sitio. Muchos módulos adicionales creados por los miembros de la comunidad de Drupal están disponibles para descargar en la <a href="@drupal-modules">Página de módulos de Drupal.org</a>.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7255','Antes de poder usar un nuevo vocabulario para clasificar su contenido, se debe agregar un nuevo término de Taxonomía a un <a href="@ctedit">tipo de contenido</a> en su página <em>Gestionar campos</em>. Cuando agregue un nuevo campo de taxonomía elija un <em>control</em> a utilizar para ingresar la información de taxonomía en la página de edición del contenido: una lista de selección, casillas de selección, botones de opción, o un campo auto-completar (para construir un vocabulario de etiquetado libre). Luego de elegir el tipo de campo y el control, puede elegir el vocabulario deseado en las páginas siguientes de <em>configuración de campos</em>, ya sea que se puedan elegir uno o múltiples términos del vocabulario, y otras configuraciones. Se puede agregar el mismo vocabulario a múltiples tipos de contenido utilizando la sección "Agregar campo existente" en la página de Gestionar campos.','es','0','0','0'),('7259','Permite que el contenido de las visitas pueda ser utilizado en los paneles, dashboards y otros módulos que usan la API de contenido CTools.','es','0','0','0'),('7260','Guardar configuración','es','0','0','0'),('7261','Activado para todas las páginas','es','0','0','0'),('7262','Comprobación de acceso al menú','es','0','0','0'),('7263','Redirección global','es','0','0','0'),('7264','Elija qué características desea activar para la redirección global','es','0','0','0'),('7265','Comprobación de ruta de idioma','es','0','0','0'),('7266','Agregar enlace canónico','es','0','0','0'),('7267','Establecer el encabezamiento de ubicación de contenido','es','0','0','0'),('7268','Si se marca, con cualquier petición de una página taxonomia/termino/[tid] se comprobará que la ruta correcta se usa para el vocabulario del término.','es','0','0','0'),('7269','Las opciones de redirección global se han guardado.','es','0','0','0'),('7270','ID de término de taxonomía desde la URL','es','0','0','0'),('7272','Extensor  de visualización vacía','es','0','0','0'),('7273','Valor en bruto desde el URL','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7275','Página de galería','es','0','0','0'),('7276','Responder a','es','0','0','0'),('7277',' nuevo','es','0','0','0'),('7279','Páginas que enlazan con %1','es','0','0','0'),('7280','Opciones generales','es','0','0','0'),('7281','Rango','es','0','0','0'),('7282','Privacidad','es','0','0','0'),('7283','Si se ha elegido el modo PHP, introduzca el código PHP entre %php.  Tenga en cuenta que ejecutar código PHP incorrecto puede destrozar su sitio Drupal.','es','0','0','0'),('7284','Añadir si el código siguiente devuelve <code>VERDADERO</code> (modo PHP, solo para expertos).','es','0','0','0'),('7285','Dominios','es','0','0','0'),('7286','Depende de: !dependencies','es','0','0','0'),('7287','Roles de usuario','es','0','0','0'),('7288','Añadir en todas las páginas salvo en las que se listan.','es','0','0','0'),('7289','Agregar solamente a las páginas en la lista.','es','0','0','0'),('7290','Agregar el seguimiento a páginas particulares','es','0','0','0'),('7291','Configuración de seguimiento específica por usuario','es','0','0','0'),('7292','Opciones de seguimiento personalizado','es','0','0','0'),('7293','Los usuarios no pueden controlar si son seguidos o no.','es','0','0','0'),('7294','Seguir los usuarios de forma predefinida, pero permitir a los usuarios individuales no participar.','es','0','0','0'),('7295','No seguir a los usuarios de forma predeterminada, pero permitir a los usuarios individuales a participar.','es','0','0','0'),('7296','Permitir a los usuarios personalizar la visibilidad del seguimiento en la configuración de sus cuentas. Sólo los usuarios que tengan permiso %permission pueden establecer sus preferencias.','es','0','0','0'),('7297','Participar o no en el seguimiento','es','0','0','0'),('7298','Configuración de seguimiento específica por roles','es','0','0','0'),('7299','Añadir seguimiento para roles específicos','es','0','0','0'),('7300','Opciones de seguimiento de páginas concretas','es','0','0','0'),('7301','Opciones de segmentación de usuarios','es','0','0','0'),('7302','Agregar información de segmentación al código de seguimiento','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7303','Segmentar usuarios basándose en distintas propiedades además del seguimiento básico basado en la dirección de IP brindado por Google Analytics.','es','0','0','0'),('7304','Opciones de seguimiento de enlaces','es','0','0','0'),('7305','Activa el seguimiento de <em>clicks</em> en los enlaces de salida.','es','0','0','0'),('7306','Seguimiento de enlaces de ''enviar correo a''','es','0','0','0'),('7307','Activa el seguimiento de clics en los enlaces ''enviar correo a''.','es','0','0','0'),('7308','Seguimiento de enlaces de descarga','es','0','0','0'),('7309','Activa el seguimiento de clics en los enlaces de archivos basandose en las extensiones que se muestran más abajo.','es','0','0','0'),('7310','Extensiones de documentos que se deben seguir','es','0','0','0'),('7311','Una lista separada por barras verticales de las extensiones de archivo que deben ser seguidas cuando se hace clic, con soporte de expresiones regulares. Ejemplo: !extensions.','es','0','0','0'),('7312','<a href="@url">La transferencia pública de archivos</a> debe estar activada para permitir la caché local.','es','0','0','0'),('7313','Seguir conjuntos de traducciones como si fueran una unidad','es','0','0','0'),('7314','Hacer seguimiento de las búsquedas internas','es','0','0','0'),('7315','Si está activado, las palabras clave de la búsqueda interna son monitorizados. Debe configurar su cuenta de Google para usar el parámetro <strong>search</strong> de la búsqueda interna. Para más información vea <a href="@url">¿Cómo puedo configurar la búsqueda del sitio de mi perfil?</a>.','es','0','0','0'),('7316','Seguimiento de los anuncios de Adsense','es','0','0','0'),('7317','Si se activa, sus anuncios AdSense tendrán seguimiento desde su cuenta de Google Analytics.','es','0','0','0'),('7318','Código JavaScript personalizado','es','0','0','0'),('7319','Fragmento de código (antes)','es','0','0','0'),('7320','Fragmento de código (después)','es','0','0','0'),('7321','Alcance de JavaScript','es','0','0','0'),('7322','No añada el código de seguimiento proporcionado por Google en los fragmentos de código javascript! Este módulo generará el código de seguimiento basado en el número su cuenta de Google Analytics y en las configuraciones.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7323','No incluir etiquetas &lt;script&gt; en los fragmentos de código JavaScript.','es','0','0','0'),('7324','Configuración de Google Analytics','es','0','0','0'),('7325','Los usuarios son seguidos de forma predeterminada, pero usted puede desactivar el seguimiento.','es','0','0','0'),('7326','Activar seguimiento de usuarios','es','0','0','0'),('7327','Módulo de Google Analytics','es','0','0','0'),('7328','El módulo Google Analytics no ha sido configurado todavía. Por favor configure sus opciones desde la <a href="@url">página de configuración de Google Analytics</a>','es','0','0','0'),('7329','Administrar Google Analytics','es','0','0','0'),('7330','Usar PHP para la visibilidad de seguimiento','es','0','0','0'),('7331','Google Analytics','es','0','0','0'),('7332','Configure las opciones para generar su código de seguimiento de Google Analytics.','es','0','0','0'),('7333','Añade el código de seguimiento de Google Analytics a todas las páginas de su sitio.','es','0','0','0'),('7334','ID de propiedad web','es','0','0','0'),('7335','Este ID es único para cada sitio que quiera monitorizar, y tiene la forma UA-xxxxxxx-yy. Para obtener un ID de Propiedad Web, <a href="@analytics">registre su sitio con Google Analytics</a>, o si ya ha registrado su sitio, vaya a su página de configuración de Google Analytics para ver el ID junto a cada perfil de sitio. <a href="@webpropertyid">Encuentre más información en la documentación</a>.','es','0','0','0'),('7336','Puede seleccionar multiples valores.','es','0','0','0'),('7337','Mantener anónima la dirección IP de los visitantes','es','0','0','0'),('7338','Indicar a Google Analytics que mantenga anónima la información enviada por los objetos de monitorización eliminando el último octeto de la dirección IP antes de su almacenamiento. Tenga en cuenta que esto reduce ligeramente la precisión de las estadísticas geográficas. En algunos países no se permite recolectar información personal por razones de privacidad y esta opción puede ayudarle a cumplir con las leyes locales.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7339','Almacenar localmente el archivo de código de monitorización','es','0','0','0'),('7340','Si está activado, el archivo del código de monitorización se importa desde Google Analytics y se almacena localmente. Se actualiza a diario desde los servidores de Google para asegurar que las actualizaciones en el código de monitorización tienen efecto en la copia local. ¡No activar esto hasta que Google Analytics haya confirmado que la monitorización del sitio está funcionando!','es','0','0','0'),('7341','El código en este área de texto se añadirá <strong>antes</strong> _gaq.push([''_trackPageview'']).','es','0','0','0'),('7342','El código de esta caja de texto se agregará <strong>después de </strong> _gaq.push([''_trackPageview'']). Es útil si desea hacer seguimiento de un sitio con dos cuentas.','es','0','0','0'),('7343','<a href="@ga_url">Google Analytics</a> es un servicio gratuito de seguimiento del tráfico de sitios web y de análisis de la efectividad de su marketing (requiere registrarse).','es','0','0','0'),('7344','Puede añadir <a href="!custom_var_documentation">variables personalizadas</a> de Google Analytics aquí. Éstas se añadirán a cada página en la que aparezca el código de seguimiento de Google Analytics. Google Analytics sólo aceptará variables personalizadas si el nombre y el valor combinados son menores de 64 bytes después de la codificación URL. Mantenga los nombres tan cortos como sea posible y prevea que los valores largos serán recortados. Puede usar reemplazos en los valores de las variables personalizadas. Están disponibles siempre los reemplazos globales y de usuario; en los nodos también están disponibles los reemplazos de nodo.','es','0','0','0'),('7345','Variables personalizadas','es','0','0','0'),('7346','Número de slot','es','0','0','0'),('7347','El nombre de la variable personalizada.','es','0','0','0'),('7348','El valor de la variable personalizada. Puede usar reemplazos en este campo.','es','0','0','0'),('7349','El valor de la variable personalizada.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7350','El alcance de la variable personalizada.','es','0','0','0'),('7351','googleanalytics','es','0','0','0'),('7352','La caché local se ha purgado.','es','0','0','0'),('7353','Permitir a los usuarios personalizar la monitorización de su página de cuenta de usuario','es','0','0','0'),('7354','No se permite ninguna personalización','es','0','0','0'),('7355','Monitorizar por defecto, los usuarios con el permiso %permissions pueden elegir no monitorizar','es','0','0','0'),('7356','No monitorizar por defecto, los usuarios con el permiso %permission pueden elegir sí monitorizar','es','0','0','0'),('7357','Cualquier página salvo las de la lista','es','0','0','0'),('7358','Sólo las páginas señaladas','es','0','0','0'),('7359','Enlaces y descargas','es','0','0','0'),('7360','Monitorizar clics en los enlaces de correo electrónico','es','0','0','0'),('7361','Monitorizar descargas (clics en enlaces a archivos) para las siguientes extensiones','es','0','0','0'),('7362','Una lista de extensiones separadas por el carácter | será monitorizada como descargas cuando se haga clic en el enlace. Se permiten expresiones regulares. Por ejemplo: !extensions','es','0','0','0'),('7363','Búsqueda y AdSense','es','0','0','0'),('7364','Información adicional del usuario','es','0','0','0'),('7365','Puede complementar la monitorización básica de dirección IP de los visitantes de Google Analytics organizando los usuarios basándose en las variables personalizadas. La sección 8.1 de los <a href="@ga_tos">términos de uso de Google Analytics</a> exige que se asegure de que no asociará (o permitirá que terceros puedan asociar) ninguna información recolectada desde sus sitios web (o sitios web de terceros) con ninguna información personal de identificación de ninguna fuente para su uso propio (o el uso de terceros) del servicio de Google Analytics.','es','0','0','0'),('7366','Puede añadir <a href="@snippets">porciones de código</a> de Google Analytics aquí. Éstos se añadirán siempre que la monitorización esté en funcionamiento. Antes de añadir su código personalizado, debe leer la documentación de <a href="@ga_concepts_overview">Visión general del código de seguimiento de Google Analytics</a> y la <a href="@ga_js_api">API de seguimiento de Google Analytics</a>. <strong>No incluya las etiquetas &lt;script&gt</strong>, y termine siempre su código con un punto y coma (;).','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7367','Nombres de rol de usuario','es','0','0','0'),('7368','Activado por defecto con opción de desactivar','es','0','0','0'),('7369','Desactivado por defecto con elección de activar','es','0','0','0'),('7370','No monitorizado','es','0','0','0'),('7371','@items monitorizados','es','0','0','0'),('7372','¿Qué está monitorizando?','es','0','0','0'),('7373','Un único dominio (predeterminado)','es','0','0','0'),('7374','Dominio: @domain','es','0','0','0'),('7375','Un dominio con múltiples subdominios','es','0','0','0'),('7376','Ejemplos: @domains','es','0','0','0'),('7377','Múltiples dominios de nivel superior','es','0','0','0'),('7378','Lista de dominios de nivel superior','es','0','0','0'),('7379','Si ha seleccionado "Múltiples dominios de nivel superior" arriba, introduzca todos estos dominios de nivel superior. Añada un dominio por línea. Por defecto, los datos en sus reportes sólo incluyen la ruta y el nombre de la página, y no el nombre del dominio. Para más información vea la sección <em>Mostrar nombres de dominios separados</em> en <a href="http://www.google.com/support/analytics/bin/answer.py?answer=175538">Monitorizando múltiples dominios</a>.','es','0','0','0'),('7380','Únicamente añadir a los roles seleccionados','es','0','0','0'),('7381','Añadir a todos los roles excepto a los seleccionados','es','0','0','0'),('7382','Si no se selecciona ningún rol, todos los usuarios serán monitorizados. Si un usuario tiene uno de los roles seleccionados, este usuario será monitorizado (o excluido, dependiendo de la opción superior).','es','0','0','0'),('7383','Hacer seguimiento de los clics en los enlaces externos','es','0','0','0'),('7384','Monitorizar clics en los enlaces externos como páginas vistas','es','0','0','0'),('7385','Por defecto los enlaces externos se monitorizan como <em>Eventos</em>. En extrañas situaciones como la monitorización de <em>Objetivos</em> podría ser necesario monitorizar los enlaces externos como páginas vistas.','es','0','0','0'),('7386','Google recomienda añadir los ficheros externos JavaScript en la cabecera por razones de rendimiento. Si se ha elegido <em>Múltiples dominios de nivel superior</em>, esta opción se fijará a encabezado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('7387','Todas las páginas con excepciones','es','0','0','0'),('7388','Exceptuando: @roles','es','0','0','0'),('7389','Un único dominio','es','0','0','0'),('7390','Hacer seguimiento de los enlaces salientes','es','0','0','0'),('7391','Desactivación universal de monitorización web','es','0','0','0'),('7392','@items activado','es','0','0','0'),('7393','Si está activado y su servidor recibe el encabezado <a href="http://donottrack.us/">Do-Not-Track</a> del navegador del cliente, el módulo Google Analytics no insertará ningún código de monitorización en su sitio. El cumplimiento con Do Not Track es puramente voluntario, fomentado por la propia regulación de la industria, u ordenado por las leyes estatales o federales. Por favor, respete la privacidad de sus visitantes. Si ellos han desactivado la monitorización, debe aceptar su decisión personal. Esta característica está actualmente limitada a los usuarios autenticados y con la caché de páginas desactivada.','es','0','0','0'),('7408','Agregar el secondary_links (tareas locales) como contenido.','es','0','0','0'),('7409','Añade la declaración del sitio como feed_icons contenido.','es','0','0','0'),('7410','Agregar primary_links (tareas locales) como contenido.','es','0','0','0'),('7411','Agregar la ruta de navegación como contenido.','es','0','0','0'),('7413','Mensajes de estado','es','0','0','0'),('7414','Añadir los mensajes de estado de la página actual como contenido.','es','0','0','0'),('7415','Agregar el texto de ayuda de la página actual como contenido.','es','0','0','0'),('7416','Los resultados de una búsqueda utilizando palabras clave.','es','0','0','0'),('7417','Términos relacionados con un término existente; pueden ser hijos, hermanos o de nivel superior.','es','0','0','0'),('7420','Información del autor en el formulario de nodo.','es','0','0','0'),('7423','El mensaje de registro que se hizo al crear la revisión.','es','0','0','0'),('7424','Botones de envio del formulario de edición del nodo','es','0','0','0'),('7425','Botones de envío para el formulario de edición del nodo.','es','0','0','0');
