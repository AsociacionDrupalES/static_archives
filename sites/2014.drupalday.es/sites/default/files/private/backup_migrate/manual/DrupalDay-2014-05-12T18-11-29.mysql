INSERT INTO `locales_target` VALUES ('3712','El correo electrónico de administración del sitio.','es','0','0','0'),('3713','La URL de la página principal del sitio.','es','0','0','0'),('3714','Página de inicio de sesión','es','0','0','0'),('3715','La URL de la página de inicio de sesión en el sitio.','es','0','0','0'),('3716','El ID único del archivo subido al servidor.','es','0','0','0'),('3717','El nombre del archivo en el disco.','es','0','0','0'),('3718','La URL del archivo accesible a través de la web.','es','0','0','0'),('3719','La fecha de la alteración más reciente del archivo.','es','0','0','0'),('3720','El usuario que subió el archivo originalmente.','es','0','0','0'),('3721','El ID único del término de taxonomía.','es','0','0','0'),('3722','El nombre del término de taxonomía.','es','0','0','0'),('3723','La descripción opcional del término de taxonomía.','es','0','0','0'),('3724','El número de nodos etiquetados con el término de taxonomía.','es','0','0','0'),('3725','La URL del término de taxonomía.','es','0','0','0'),('3726','El vocabulario de taxonomía al que pertenece el término.','es','0','0','0'),('3727','El término padre del término de taxonomía, si existiera.','es','0','0','0'),('3728','El ID único del vocabulario de taxonomía','es','0','0','0'),('3729','El nombre del vocabulario de taxonomía.','es','0','0','0'),('3730','La descripción opcional del vocabulario de taxonomía.','es','0','0','0'),('3731','La cantidad de nodos etiquetados con términos que pertenecen al vocabulario de taxonomía.','es','0','0','0'),('3732','Conteo de términos','es','0','0','0'),('3733','La cantidad de términos que pertenecen al vocabulario de taxonomía.','es','0','0','0'),('3734','El ID único de la cuenta de usuario.','es','0','0','0'),('3735','El nombre de inicio de sesión de la cuenta de usuario.','es','0','0','0'),('3736','La dirección de correo electrónico de la cuenta de usuario.','es','0','0','0'),('3737','La URL de la página del perfil de la cuenta.','es','0','0','0