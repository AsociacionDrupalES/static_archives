INSERT INTO `locales_source` VALUES ('9731','','default','Restore the site','','7.12'),('9732','','default','Restore the site''s database from a backup file.','','7.12'),('9733','','default','Administer Backup and Mirgate','','7.12'),('9734','','default','Edit Backup and Migrate profiles, schedules and destinations.','','7.12'),('9735','','default','Destinations','','7.12'),('9736','','default','Destination','','7.12'),('9737','','default','No Compression','','7.12'),('9738','','default','GZip','','7.12'),('9739','','default','BZip','','7.12'),('9740','','default','Zip','','7.12'),('9741','','default','file system settings','','7.10'),('9742','','default','Save the backup files to any directory on the server which the web-server can write to.','','7.12'),('9743','','default','Server Directory','','7.12'),('9744','','default','Database','','7.12'),('9745','','default','Import the backup directly into another database. Database destinations can also be used as a source to backup from.','','7.12'),('9746','','default','MySQL Database','','7.12'),('9747','','default','Import the backup directly into another MySQL database. Database destinations can also be used as a source to backup from.','','7.12'),('9748','','default','Save the backup files to any a directory on an FTP server.','','7.12'),('9749','','default','FTP Directory','','7.12'),('9750','','default','Amazon S3 account','','7.12'),('9751','','default','Save the backup files to a bucket on your !link.','','7.12'),('9752','/dday/admin/modules/list/confirm','default','Amazon S3 Bucket','','7.12'),('9753','','default','Send the backup as an email attachment to the specified email address.','','7.12'),('9754','','default','Manual Backups Directory','','7.12'),('9755','','default','Scheduled Backups Directory','','7.12'),('9756','','default','Default Database','','7.12'),('9757','','default','Untitled Profile','','7.12'),('9758','','default','Untitled Schedule','','7.12'),('9759','','default','Schedules','','7.12'),('9760','','default','Schedule','','7.12');
INSERT INTO `locales_source` VALUES ('9761','','default','restore feature','','7.12'),('9762','','default','Backup and Migrate makes the task of backing up your Drupal database and migrating data from one Drupal install to another easier. It provides a function to backup the entire database to file or download, and to restore from a previous backup. You can also schedule the backup operation. Compression of backup files is also supported.  The database backup files created with this module can be imported into this or any other Drupal installation with the !restorelink, or you can use a database tool such as <a href="!phpmyadminurl">phpMyAdmin</a> or the mysql command line command.','','7.12'),('9763','','default','Quick Backup Tab','','7.12'),('9764','','default','help page','','7.12'),('9765','','default','Use this form to run simple manual backups of your database. Visit the !helppage for more help using this module','','7.12'),('9766','','default','Advanced Backup Tab','','7.12'),('9767','','default','settings profiles','','7.12'),('9768','','default','Use this form to run manual backups of your database with more advanced options. If you have any !profilelink saved you can load those settings. You can save any of the changes you make to these settings as a new settings profile.','','7.12'),('9769','','default','Restore Tab','','7.12'),('9770','','default','Upload a backup and migrate backup file. The restore function will not work with database dumps from other sources such as phpMyAdmin.','','7.12'),('9771','','default','Destinations are the places you can save your backup files to or them load from.','','7.12'),('9772','','default','Files can be saved to a directory on your web server, downloaded to your desktop or emailed to a specified email account. From the Destinations tab you can create, delete and edit destinations or list the files which have already been backed up to the available destinations.','','7.12'),('9773','','default','schedules','','7.12'),('9774','','default','manual backups','','7.12'),('9775','','default','Profiles are saved backup settings. Profiles store your table exclusion settings as well as your backup file name, compression and timestamp settings. You can use profiles in !schedulelink and for !manuallink.','','7.12');
INSERT INTO `locales_source` VALUES ('9776','','default','You can create new profiles using the add profiles tab or by checking the "Save these settings" button on the advanced backup page.','','7.12'),('9777','','default','Scheduling','','7.12'),('9778','','default','Automatically backup up your database on a regular schedule using <a href="!cronurl">cron</a>.','','7.12'),('9779','','default','Each schedule will run a maximum of once per cron run, so they will not run more frequently than your cron is configured to run. If you specify a number of backups to keep for a schedule, old backups will be deleted as new ones created. <strong>If specifiy a number of files to keep other backup files in that schedule''s destination will get deleted</strong>.','','7.12'),('9780','','default','Backup and Migrate','','7.12'),('9781','','default','Backup/restore your database or migrate data to or from another Drupal site.','','7.12'),('9782','','default','Quick Backup','','7.12'),('9783','/dday/admin/config/system/backup_migrate','default','You must specify a private file system path in the !settings to backup to the server.','','7.10'),('9784','','default','Backup Source','','7.12'),('9785','','default','Default Settings','','7.12'),('9786','','default','Settings Profile','','7.12'),('9787','','default','Backup now','','7.12'),('9788','','default','For more backup options, try the <a href="!advancedurl">advanced backup page</a>.','','7.12'),('9789','','default','Backup','','7.12'),('9790','','default','Backup the database.','','7.12'),('9791','/dday/admin/config/system/backup_migrate','default','Destination Files','','7.12'),('9792','','default','Advanced Backup','','7.12'),('9793','','default','List !type','','7.12'),('9794','','default','Restore','','7.12'),('9795','','default','Restore the database from a previous backup','','7.12'),('9796','/dday/admin/config/system/backup_migrate','default','Add !type','','7.12'),('9797','','default','Backup from !from to !to using !profile !submit','','7.12'),('9798','','default','override','','7.12'),('9799','','default','list files','','7.12');
INSERT INTO `locales_source` VALUES ('9800','','default','download','','7.12'),('9801','','default','restore','','7.12'),('9802','/dday/admin/config/system/backup_migrate','default','%source backed up successfully to %file in destination %dest in !time ms. !action (!links)','','7.12'),('9803','/dday/admin/config/people/accounts/fields','default','Lista (de números decimales)','','7.12'),('9804','/index.php','default','Defines a NIF/CIF/NIE field','','7.12'),('9805','/index.php','default','NIF/CIF/NIE','','7.12'),('9806','/index.php','default','Stores and validates an NIF/CIF/NIE field.','','7.12'),('9807','/dday/','default','NIF Field formatter','','7.12'),('9808','/dday/admin/config/people/accounts/fields/field_dni?destinations[0]=admin/config/people/accounts/fields','default','Supported id number types','','7.12'),('9809','/dday/admin/config/people/accounts/fields/field_dni?destinations[0]=admin/config/people/accounts/fields','default','NIF','','7.12'),('9810','/dday/admin/config/people/accounts/fields/field_dni?destinations[0]=admin/config/people/accounts/fields','default','CIF','','7.12'),('9811','/dday/admin/config/people/accounts/fields/field_dni?destinations[0]=admin/config/people/accounts/fields','default','NIE','','7.12'),('9812','/dday/admin/config/system/googleanalytics','default','Tracking scope','','7.10'),('9813','/dday/admin/config/system/googleanalytics','default','List of download file extensions','','7.10'),('9814','/dday/admin/config/system/googleanalytics','default','Custom variable slot #@slot','','7.10'),('9815','/dday/admin/config/system/googleanalytics','default','Custom variable name #@slot','','7.10'),('9816','/dday/admin/config/system/googleanalytics','default','Custom variable value #@slot','','7.10'),('9817','','default','Slot','','7.10'),('9818','sites/all/modules/google_analytics/googleanalytics.admin.js','default','No privacy','','none'),('9819','/dday/node/7/edit','default','backup_migrate','','7.12'),('9820','/dday/admin/structure/t