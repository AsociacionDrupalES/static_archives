INSERT INTO `locales_target` VALUES ('427','Minúsculas','es','0','0','0'),('428','Justificado','es','0','0','0'),('429','Términos padre','es','0','0','0'),('430','Desbloquear','es','0','0','0'),('431','Idioma predeterminado del sitio','es','0','0','0'),('432','Sin idioma','es','0','0','0'),('433','Construir modo','es','0','0','0'),('434','Elementos por página','es','0','0','0'),('435','Sin entrada de menú','es','0','0','0'),('436','Entrada normal de menú','es','0','0','0'),('437','Solapa de menú','es','0','0','0'),('438','Solapa de menú predefinida','es','0','0','0'),('439','Si se establece como normal o solapa, indique el texto que se usará para el elemento de menú.','es','0','0','0'),('440','Insertar elemento en un menú disponible.','es','0','0','0'),('441','La selección de menú necesita la activación del módulo de menús.','es','0','0','0'),('442','Cuanto más bajo sea el peso, más a la izquierda o más arriba aparecerá.','es','0','0','0'),('443','Si está creando un elemento de menú padre, escriba el título del elemento.','es','0','0','0'),('444','Si el elemento de menú padre es una solapa, indique el peso de la solapa. Cuanto más reducido, más a la izquierda estará.','es','0','0','0'),('445','- Todos -','es','0','0','0'),('446','Importar código','es','0','0','0'),('447','Formulario de contacto','es','0','0','0'),('448','Igual','es','0','0','0'),('449','Código de respuesta HTTP','es','0','0','0'),('450','Formulario de búsqueda','es','0','0','0'),('451','Estilos','es','0','0','0'),('452','¡Hola mundo!','es','0','0','0'),('453','El elemento ha sido eliminado.','es','0','0','0'),('454','Mayor o igual que','es','0','0','0'),('455','Menor o igual que','es','0','0','0'),('456','El nombre del sitio.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('457','Caché de CSS de CTools','es','0','0','0'),('458','El CTools CSS directorio caché, %path no se pudo crear debido a un directorio de archivos mal configurado. Asegúrese de que el directorio de archivos está configurado correctamente y que el servidor web tiene permisos para crear directorios.','es','0','0','0'),('459','No se ha podido crear','es','0','0','0'),('460','Una caché especial para almacenar objetos que se estén editando. Sirve para guardar estados en un entorno ordinariamente sin estado.','es','0','0','0'),('461','Herramientas de Chaos (Chaos tools)','es','0','0','0'),('462','Una biblioteca de herramientas útiles hecha por Merlin of Chaos.','es','0','0','0'),('463','Resultados de la exportación en masa.','es','0','0','0'),('464','Ponga esto en @file','es','0','0','0'),('465','No hay objetos para exportar en este momento.','es','0','0','0'),('466','Exportador en masa','es','0','0','0'),('467','Exportar en masa múltiples objetos de datos manejados por CTools a código.','es','0','0','0'),('468','Exportación en masa','es','0','0','0'),('469','Realiza exportación en masa de objetos de datos conocidos por Chaos tools.','es','0','0','0'),('470','@type:@subtype no se mostrará debido a la falta de contexto','es','0','0','0'),('471','No hay información','es','0','0','0'),('472','No hay información disponible.','es','0','0','0'),('473','Configurar !subtype_title nuevo','es','0','0','0'),('474','Todos los criterios deben cumplirse.','es','0','0','0'),('475','Ha de ser verificado un sólo un criterio.','es','0','0','0'),('476','Acceso roto/ausente a la extensión %plugin','es','0','0','0'),('477','Configurar opciones para este elemento.','es','0','0','0'),('478','Eliminar este elemento.','es','0','0','0'),('479','No hay criterios seleccionados, esta prueba pasará.','es','0','0','0'),('480','Hooks de callbacks ausentes.','es','0','0','0'),('481','Editar criterios','es','0','0','0'),('482','Nombre de objeto no válido.','es','0','0','0'),('483','Tipo de contexto no válido','es','0','0','0'),('484','Mostrar «no se encontró la página» o no mostrar nada en absoluto.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('485','Escriba un título para utilizar cuando este argumento está presente. Puede utilizar sustitución de %KEYWORD, donde la palabra clave se especifica abajo.','es','0','0','0'),('486','¡No se puede eliminar el elemento ausente!','es','0','0','0'),('487','Editar @type','es','0','0','0'),('488','Resumen de contextos','es','0','0','0'),('489','Por favor elija cuál contexto y cómo le gustaría que se convierta.','es','0','0','0'),('490','@identifier (@keyword)','es','0','0','0'),('491',', y ','es','0','0','0'),('492',', o ','es','0','0','0'),('493','Contexto interno','es','0','0','0'),('494','Palabra clave: %@keyword','es','0','0','0'),('495','@keyword --&gt; @title','es','0','0','0'),('496','From "@title"','es','0','0','0'),('497','No se puede crear el directorio de caché de CSS de CTools. Revise los permisos de su directorio de archivos.','es','0','0','0'),('498','Actualizar y volver','es','0','0','0'),('499','En código','es','0','0','0'),('500','Activado, título','es','0','0','0'),('501','Obtener un resumen de la información acerca de esta página.','es','0','0','0'),('502','Active esta página para que esté en uso en su sistema.','es','0','0','0'),('503','Desactivar esta página. La información se mantendrá, pero la página no se utilizará en su sistema.','es','0','0','0'),('504','Agregar variante','es','0','0','0'),('505','Agregar una nueva variante a esta página.','es','0','0','0'),('506','Crear variante','es','0','0','0'),('507','Importar variante','es','0','0','0'),('508','Añadir una variante a esta página desde código exportado desde otra página.','es','0','0','0'),('509','Reordenar variantes','es','0','0','0'),('510','Cambie la prioridad de las variantes para asegurar que se seleccione la correcta.','es','0','0','0'),('511','Configure una variante recién creada antes de añadirla realmente a la página.','es','0','0','0'),('512','Romper el bloqueo de esta página para poder editarla.','es','0','0','0'),('513','Operaciones de variante','es','0','0','0'),('514','Obtener un resumen de la información acerca de esta variante.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('515','Crear una copia exacta de esta variante.','es','0','0','0'),('516','Exportar esta variante a código para importarla en otra página.','es','0','0','0'),('517','Eliminar todos los cambios de esta variante y volver a la versión en el código.','es','0','0','0'),('518','Eliminar esta variante de la página completamente.','es','0','0','0'),('519','Activar esta variante para que pueda ser utilizada en su sistema.','es','0','0','0'),('520','Desactivar esta variante. La información se mantendrá, pero la variante no se utilizará en su sistema.','es','0','0','0'),('521','No hay variantes','es','0','0','0'),('522','El rastro de esta operación no existe.','es','0','0','0'),('523','La página ha sido actualizada. Los cambios no serán permanentes hasta que guarde.','es','0','0','0'),('524','No se ha podido actualizar los cambios debido a un bloqueo.','es','0','0','0'),('525','Esta opción contiene cambios no guardados.','es','0','0','0'),('526','Tiene cambios no guardados en esta página. Debe seleccionar Guardar para almacenarlos en la base de datos, o Cancelar para descartar estos cambios. Tenga en cuenta que si ha cambiado algún formulario, debe enviarlo antes de guardar.','es','0','0','0'),('527','Todos los cambios pendientes han sido descartados, y la página está ahora desbloqueda.','es','0','0','0'),('528','El título administrativo de esta variante. Si lo deja en blanco, se asignará automáticamente.','es','0','0','0'),('529','Tipo de variante','es','0','0','0'),('530','Características opcionales','es','0','0','0'),('531','Marque las características opcionales que necesite que aparezcan con los formularios para configurarlos. Si no los marca aquí todavía podrá utilizar estas caracteríscticas una vez que la página se ha creado. Si no está seguro, déjelas desmarcadas.','es','0','0','0'),('532','Nombre de variante','es','0','0','0'),('533','Escribir el nombre de la nueva variante','es','0','0','0'),('534','Pegar aquí el código de la variante','es','0','0','0'),('535','No s eha encontrado variante.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('536','No ha sido posible obtener una variante de la importación. Errores reportados: @errors','es','0','0','0'),('537','Revertir la variante eliminará la variante que está en la base de datos, volviendo a la variante original predeterminada. Esta eliminación no se hará permanente hasta que haga clic en Guardar.','es','0','0','0'),('538','¿Está seguro de que desea eliminar esta variante? Esta eliminación no se hará permanente hasta que haga clic en Guardar.','es','0','0','0'),('539','Esta variante está actualmente desactivada. Activarla la hará disponible en su sitio. Esto no tendrá efecto hasta que guarde esta página.','es','0','0','0'),('540','Esta variante está actualmente activada. Desactivarla hará que no esté disponible en su sistema y no se utilizará. Esto no tendrá efecto hasta que se guarde esta página.','es','0','0','0'),('541','Romper el bloqueo en esta página <strong>descartará</strong> cualquier cambio pendiente hecho por el usuario que estableció el bloqueo. ¿Está realmente seguro de que desea hacer esto?','es','0','0','0'),('542','El bloqueo ha sido eliminado y todos los cambios descartados. Ahora puede hacer cambios a esta página.','es','0','0','0'),('543','Activar esta página hará que esté disponible en su sistema inmediatamente (no hace falta esperar a guardar).','es','0','0','0'),('544','Desactivar esta página hará que deje de estar disponible en su sistema inmediatamente (no hace falta esperar a guardar).','es','0','0','0'),('545','Esta página no tiene variantes y por lo tanto no tiene salida por si misma.','es','0','0','0'),('546','Agregar una nueva variante','es','0','0','0'),('547','No se puede desactivar debido al bloqueo.','es','0','0','0'),('548','No se puede activar debido al bloqueo.','es','0','0','0'),('549','Añada, edite y borre del sistema páginas del sistema sobreescritas y páginas definidas por usuarios.','es','0','0','0'),('550','Gestor de página','es','0','0','0'),('551','Proporciona una API e interfaz de usuario para gestionar páginas en el sitio.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('552','Formulario de creación o edición de nodo','es','0','0','0'),('553','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal para agregar o editar nodos en <em>node/%node/edit</em> y <em>node/add/%node_type</em>. Si agrega variantes, usted puede utilizar criterios de selección tales como tipo de nodo o idioma, o acceso de usuario para proporcionar diferentes formularios de edición para nodos. Si no se selecciona ninguna variante, se utilizará el formulario de edición predeterminado de Drupal.','es','0','0','0'),('554','El nodo se está editando','es','0','0','0'),('555','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal al mostrar nodos en <em>node/%node</em>. Si agrega variantes, usted puede usar criterios de selección tales como tipo o idioma de nodo o acceso de usuario para proveer diferentes vistas de nodo. Si no se seleccionan variantes, se utilizará la vista predeterminada de nodo de Drupal. Esta página sólo afecta a los nodos vistos como páginas; no afectará los nodos vistos en listas en listas o en otros lugares. También tenga en cuenta que si está usando Pathauto, los aliases pueden hacer que un nodo esté en otro lugar, pero para Drupal siguen estando en node/%node.','es','0','0','0'),('556','El nodo se está viendo','es','0','0','0'),('557','Opciones de argumento','es','0','0','0'),('558','Una segunda página sin sentido','es','0','0','0'),('559','Título administrativo','es','0','0','0'),('560','El nombre de esta página. Aparecerá en la interfaz administrativa para identificarla fácilmente.','es','0','0','0'),('561','El nombre de sistema de esta página. Debe ser único, y sólo puede contener caracteres alfanuméricos y guiones bajos. ¡Una vez creado, usted no será capaz de cambiar este valor!','es','0','0','0'),('562','Descripción administrativa','es','0','0','0'),('563','Una descripción de lo que es esta página, lo que hace o para qué es, para uso administrativo.','es','0','0','0'),('564','La ruta URL para llegar a esta página. Usted puede crear marcadores de posición nombrados de partes variables de la ruta, usando %name para elementos requeridos y !name para elementos opcionales. Por ejemplo: «node/%node/foo», «forum/%forum» o «dashboard/!input». Estos marcadores de posición nombrados pueden convertirse en contextos en el formulario de argumentos.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('565','Hacer de ésta la página principal de su sitio.','es','0','0','0'),('566','Elemento visible de menú','es','0','0','0'),('567','Hace falta un nombre','es','0','0','0'),('568','Este nombre está siendo utilizado por otra página: @page','es','0','0','0'),('569','El nombre de la página sólo puede contener caracteres alfanúmericos y guiones bajos.','es','0','0','0'),('570','Esta ruta está siendo utilizada por otra página: @page','es','0','0','0'),('571','No puede tener un elemento de ruta dinámico después de un elemento de ruta opcional.','es','0','0','0'),('572','No puede tener un elemento estático de ruta después de un elemento opcional.','es','0','0','0'),('573','Esa ruta está asignada actualmente como un alias de @alias. El sistema no puede sobrescribir aliases existentes.','es','0','0','0'),('574','Usted no puede hacer esta la página principal de su sitio si utiliza marcadores %.','es','0','0','0'),('575','Argumento duplicado %arg','es','0','0','0'),('576','Argumento <em>%</em> no válido. Todos los argumetos deben nombrarse con palabras clave.','es','0','0','0'),('577','Cuando se proporcione un elemneto de menú como una pestaña predeterminada, Drupal necesita saber cuál será el elemento padre del menú de esa pestaña. Algunas veces el padre ya existirá, pero otras veces se debe crear uno. La ruta de un elemento padre siempre será la misma ruta, dejando por fuera la última parte. i.e, si la ruta de esta vista es <em>foo/bar/baz</em>, la ruta del padre sería <em>foo/bar</em>.','es','0','0','0'),('578','Título del elemento padre','es','0','0','0'),('579','Las reglas de acceso se utilizan para probar si la página es accesible y si los elementos de menú asociados a ella son visibles.','es','0','0','0'),('580','No hay contexto asignado','es','0','0','0'),('581','Posición en la ruta','es','0','0','0'),('582','Contexto asignado','es','0','0','0'),('583','La ruta %path no tiene argumentos que configurar.','es','0','0','0'),('584','Palabra clave no válida.','es','0','0','0'),('585','Cambiar tipo de contexto','es','0','0','0');
INSERT INTO `locales_target` VALUES ('586','Cambiar argumento','es','0','0','0'),('587','No hay contexto seleccionado','es','0','0','0'),('588','Error: Falta argumento.','es','0','0','0'),('589','Identificador de contexto','es','0','0','0'),('590','Este es el título del contexto usado para identificarlo más tarde en el proceso administrativo. Esto nunca se mostrará a un usuario.','es','0','0','0'),('591','Error: complemento de argumento %argument ausente o no válido','es','0','0','0'),('592','Importar página','es','0','0','0'),('593','Escriba el nombre que utilizará para esta página si es diferente a la página de origen. Dejar en blanco para usar el nombre original de la página.','es','0','0','0'),('594','Escriba la ruta a utilizar para esta página si es diferente a la página de origen. Dejar en blanco para utilizar la ruta original de la página.','es','0','0','0'),('595','Permitir la sobreescritura de una página existente','es','0','0','0'),('596','Si el nombre que usted seleccionó ya existe en la base de datos, esta página se le permitirá sobreescribir la página existente.','es','0','0','0'),('597','Pegar aquí el código de la página','es','0','0','0'),('598','No se encontró ningún manejador.','es','0','0','0'),('599','No ha sido posible obtener una página de la importación. Errores reportados: @errors','es','0','0','0'),('600','Ese nombre de página está en uso y está bloqueado por otro usuario. Usted debe <a href="!break">romper el bloqueo</a> en la página antes de continuar, o elegir un nombre diferente.','es','0','0','0'),('601','Escriba el nombre para la nueva página. Debe ser único y contener solo caracteres alfanuméricos y guiones bajos.','es','0','0','0'),('602','La ruta de acceso URL para acceder a esta página. Puede crear marcadores de posición nombrados para las partes variables de la ruta usando %name para elementos requeridos y !name para elementos opcionales. Por ejemplo: «node/%node/foo», «forum/%forum» o «dashboard/!input». Estos marcadores de posición nombrados pueden convertirse en contextos en el formulario de argumentos. No puede utilizar la misma ruta que la página original.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('603','Clonar variantes','es','0','0','0'),('604','Si se marca, se clonarán también todas las variantes asociadas con la página. Si no se marca, la página será clonada sin variantes.','es','0','0','0'),('605','Si se revierte la página, se borrará la página que está en la base de datos, devolviéndola a la página original predeterminada. Cualquier cambio que haya hecho se perderá y no se podrá recuperar.','es','0','0','0'),('606','La página ha sido revertida.','es','0','0','0'),('607','Páginas creadas por un administrador, que tienen una ruta de URL, control de acceso y entradas en el sistema de menús de Drupal.','es','0','0','0'),('608','Crear nueva página','es','0','0','0'),('609','Editar nombre, ruta y otras opciones básicas para la página.','es','0','0','0'),('610','Configurar contextos para los argumentos en esta página.','es','0','0','0'),('611','Controlar cuáles usuarios pueden acceder a esta página.','es','0','0','0'),('612','Proporcione a esta página un menú visible o una pestaña de menú.','es','0','0','0'),('613','Hacer una copia de esta página','es','0','0','0'),('614','Exportar esta página como código que puede ser importado o incluido en un módulo.','es','0','0','0'),('615','Eliminar todos los cambios a esta página y volver a la versión en el código.','es','0','0','0'),('616','Eliminar esta página de su sistema completamente.','es','0','0','0'),('617','Esta es la página inicial de su sitio.','es','0','0','0'),('618','Esta página se ha configurado como página inicial de su sitio.','es','0','0','0'),('619','Sólo será accesible si @conditions.','es','0','0','0'),('620','Esta página es accesible públicamente.','es','0','0','0'),('621','Sin entrada de menú.','es','0','0','0'),('622','Entrada normal de menú.','es','0','0','0'),('623','Solapa de menú.','es','0','0','0'),('624','Solapa de menú predeterminada.','es','0','0','0'),('625','Título: %title.','es','0','0','0'),('626','Título del elemento padre: %title.','es','0','0','0'),('627','Bloque de menú: %title.','es','0','0','0'),('628','Plantilla de término de taxonomía','es','0','0','0');
INSERT INTO `locales_target` VALUES ('629','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal para mostrar términos de taxonomía en <em>taxonomy/term/%term</em>. Si usted añade variantes, puede usar criterios de seleccion tales como vocabulario o acceso de usuario para proveer diferentes visualizaciones del término de taxonomía y nodos asociados. Si no se selecciona ninguna variante, se usará la visualización predeterminada de Drupal para términos de taxonomía. Esta página solo afecta los elementos mostrados en taxonomy/term/%term. Algunos términos de taxonomía, tales como foros, tienen sus visualizaciones en otros lugares. Además, por favor tenga en cuenta que si usted está usando Pathauto, los aliases pueden hacer que los términos de taxonomía aparezcan en otra ruta, pero para Drupal siguen estando en taxonomy/termi%term.','es','0','0','0'),('630','Términos que están siendo vistos','es','0','0','0'),('631','Término que está siendo visto','es','0','0','0'),('632','Permitir varios términos en taxonomy/term/%term','es','0','0','0'),('633','Término único','es','0','0','0'),('634','Varios términos','es','0','0','0'),('635','Por defecto, Drupal permite múltiples términos como argumentos separándolos con comas o signos más. Si usted establece esto como uno solo, esa función se desactivará.','es','0','0','0'),('636','Inyectar la jerarquía del primer término dentro de los enlaces de ayuda a la navegación','es','0','0','0'),('637','Si se marca, los padres de términos de taxonomía aparecerán en los enlaces de ayuda a la navegación.','es','0','0','0'),('638','Se pueden utilizar varios términos separados por , o +.','es','0','0','0'),('639','Sólo se puede utilizar un único término.','es','0','0','0'),('640','%term','es','0','0','0'),('641','Los enlaces de ayuda a la navegación contendrán la jerarquía de términos de taxonomía','es','0','0','0'),('642','Los enlaces de ayuda a la navegación no contendrán la jerarquía de términos de taxonomía.','es','0','0','0'),('643','Plantilla de perfil de usuario','es','0','0','0');
INSERT INTO `locales_target` VALUES ('644','Cuando se activa, esto sobreescribe el comportamiento predeterminado de Drupal para mostrar perfiles de usuario en <em>user/%user</em>. Si usted agrega variantes, es posible utilizar criterios de selección tales como roles o acceso de usuarios para proporcionar diferentes vistas de perfiles de usuarios. Si no se selecciona ninguna variante, se utilizará la vista predeterminada de usuarios de Drupal. Tenga en cuenta que si usted está usando Pathauto, los aliases pueden hacer que un nodo esté en otra ruta, pero para Drupal siguen estando en user/%user.','es','0','0','0'),('645','Usuario que está siendo visto','es','0','0','0'),('646','Esta página está siendo editada por otro usuario y no puede hacer cambios en ella.','es','0','0','0'),('647','Esta página está recién creada y aún no se ha guardado en la base de datos. No estará disponible hasta que la guarde.','es','0','0','0'),('648','Esta página ha sido modificada, pero estas modificaciones aún no están en uso. Mientras se modifica esta página, está bloqueada para que otros usuarios no puedan modificarla.','es','0','0','0'),('649','No hay manejadores de tareas definidos para esta tarea.','es','0','0','0'),('650','Variante','es','0','0','0'),('651','Esta página está siendo editada por el usuario !user, y está bloqueada para los demás usuarios. Este bloqueo está desde hace !age. Haga clic aquí para <a href="!break"> romper este bloqueo</a>.','es','0','0','0'),('652','Usuario: Comparar','es','0','0','0'),('653','Comparar dos usuarios (usuario que inició sesión y usuario que está siendo visto, por ejemplo)','es','0','0','0'),('654','Primer usuario','es','0','0','0'),('655','Segundo usuario','es','0','0','0'),('656','Conceder acceso basado en la comparación de los dos contextos de usuario. Por ejemplo, para conceder acceso a un usuario para ver su propio perfil, seleccione «usuario que ha iniciado sesión» y «usuario que está siendo visto» y especifique «conceder acceso si es igual». Cuando son el mismo, se concederá acceso.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('657','Conceder accesos si los contextos del usuario son','es','0','0','0'),('658','No igual','es','0','0','0'),('659','@id1 @comp @id2','es','0','0','0'),('660','Nodo: Accesible','es','0','0','0'),('661','Control de acceso con la prueba de acceso de nodos que viene con Drupal.','es','0','0','0'),('662','Crear nodos del mismo tipo','es','0','0','0'),('663','Utilizando las reglas de acceso a nodos que vienen con Drupal, determinar si el usuario puede realizar la operación seleccionada en el nodo.','es','0','0','0'),('664','@user puede ver @node.','es','0','0','0'),('665','@user puede editar @node.','es','0','0','0'),('666','@user puede eliminar @node.','es','0','0','0'),('667','@user puede crear nodos del mismo tipo que @node.','es','0','0','0'),('668','Nodo: Idioma','es','0','0','0'),('669','Control de acceso por idioma del nodo.','es','0','0','0'),('670','Idioma actual del sitio','es','0','0','0'),('671','Pasa sólo si el nodo está en uno de los idiomas elegidos.','es','0','0','0'),('672','@identifier está en cualquier idioma','es','0','0','0'),('673','@identifier lenguaje es «@languages»','es','0','0','0'),('674','@identifier lenguaje de uno de «@languages»','es','673','1','0'),('675','Nodo: Tipo','es','0','0','0'),('676','Sólo serán válidos los tipos de nodo marcados.','es','0','0','0'),('677','@identifier es cualquier tipo de nodo','es','0','0','0'),('678','@identifier es de tipo «@types»','es','0','0','0'),('679','El tipo de @identifier es uno de «@types»','es','678','1','0'),('680','Usuario: permiso','es','0','0','0'),('681','Control de acceso por cadena de permisos.','es','0','0','0'),('682','Error, permiso no establecido','es','0','0','0'),('683','@identifier tiene «@perm»','es','0','0','0'),('684','Control de acceso a través de código PHP arbitrario.','es','0','0','0'),('685','Descripción administrativa','es','0','0','0'),('686','Una descripción de esta prueba, con fines administrativos.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('687','El acceso será concedido si el siguiente código PHP devuelve <code>VERDADERO</code>. No incluya &lt;?php ?&gt;. Tenga en cuenta que la ejecución de código PHP incorrecto puede dañar su sitio Drupal. Todos los contextos estarán disponibles en la variable <em>$contexts</em>.','es','0','0','0'),('688','Usted no tiene los permisos suficientes para editar el código PHP.','es','0','0','0'),('689','Usuario: rol','es','0','0','0'),('690','Control de acceso por rol.','es','0','0','0'),('691','Solo los roles marcados tendrán acceso.','es','0','0','0'),('692','@identifier puede tener cualquier rol','es','0','0','0'),('693','@identifier tiene un rol «@roles»','es','0','0','0'),('694','@identifier tiene uno de «@roles»','es','693','1','0'),('695','Usuario: idioma','es','0','0','0'),('696','Control de acceso por el idioma que utiliza actualmente el usuario o el sitio.','es','0','0','0'),('697','Pasar solo si el idioma actual del sitio es uno de los idiomas seleccionados.','es','0','0','0'),('698','El idioma del sitio es cualquier idioma','es','0','0','0'),('699','El idioma del sitio es «@languages»','es','0','0','0'),('700','El idioma del sitio es uno de «@languages»','es','699','1','0'),('701','Taxonomía: vocabulario','es','0','0','0'),('702','@identifier es cualquier vocabulario','es','0','0','0'),('703','El vocabulario @identifier es «@vids»','es','0','0','0'),('704','El vocabulario @identifier es uno de «@vids»','es','703','1','0'),('705','Crea un contexto de nodo a partir de un argumento de ID de nodo.','es','0','0','0'),('706','Escriba ID del nodo de un nodo para este argumento','es','0','0','0'),('707','Crea un contexto de formulario de añadir nodo a partir de un argumento de tipo de nodo.','es','0','0','0'),('708','Crea un contexto de formulario de edición de nodo a partir de un argumento de ID de nodo.','es','0','0','0'),('709','Una cadena es un contexto mínimo que simplemente guarda una cadena que puede ser utilizada para otro propósito.','es','0','0','0'),('710','Escriba un valor para este argumento','es','0','0','0');
INSERT INTO `locales_target` VALUES ('711','Crea un único término de taxonomía desde un ID de taxonomía o el nombre de un término de taxonomía.','es','0','0','0'),('712','Inyectar jerarquía dentro de los enlaces de ayuda a la  navegación','es','0','0','0'),('713','Escriba un ID de término de taxonomía.','es','0','0','0'),('714','Escriba un nombre de término de taxonomía.','es','0','0','0'),('715','Crea un grupo de términos de taxonomía a partir de una lista de tids separada por comas o por un signo más. En general, el primer término de la lista se utilizará en los paneles.','es','0','0','0'),('716','Escriba un ID de término o una lista de IDs de términos separados por un «+» o una «,»','es','0','0','0'),('717','Crea un contexto de usuario a partir de un argumento de ID de usuario.','es','0','0','0'),('718','Escriba el ID de usuario de un usuario para este argumento','es','0','0','0'),('719','Crea un contexto de vocabulario a partir de un argumento de ID de vocabulario.','es','0','0','0'),('720','Escriba el ID de vocabulario para este argumento','es','0','0','0'),('721','Usar palabras clave de contexto','es','0','0','0'),('722','Si se marca, las palabras claves de contexto serán sustituidas en este contenido.','es','0','0','0'),('723','Sustituciones','es','0','0','0'),('724','@identifier: @title','es','0','0','0'),('725','Todo lo que esté en el formulario que no esté siendo mostrado por otro contenido.','es','0','0','0'),('726','El autor del nodo referenciado.','es','0','0','0'),('727','Enlazar al perfil del autor','es','0','0','0'),('728','Marque aquí para enlazar al perfil del autor del nodo.','es','0','0','0'),('729','"@s" autor','es','0','0','0'),('730','El cuerpo del nodo referenciado.','es','0','0','0'),('731','"@s" cuerpo','es','0','0','0'),('732','Hacer todas las vistas disponibles como paneles','es','0','0','0'),('733','Si está activado, todas las vistas estarán disponibles como paneles de contenido para ser añadidos a los tipos de contenido. Si no está activado, sólo las vistas que tengan presentaciones de ''Panel de contenido'' estarán disponibles como paneles de contenido. Desmarque esto si quiere ser capaz de tener un mayor control sobre qué contenido está disponible para los usuarios cuando utilizan la interfaz de usuario de los paneles.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('734','Seleccionar presentación','es','0','0','0'),('735','Elija la presentación de esta vista que desea usar.','es','0','0','0'),('736','Configurar la vista @view (@display)','es','0','0','0'),('737','Vista: @name','es','0','0','0'),('738','Usando presentación @display.','es','0','0','0'),('739','Con paginador.','es','0','0','0'),('740','Sin paginador','es','0','0','0'),('741','Con ícono de canal de noticias','es','0','0','0'),('742','Utilizando argumentos: @args','es','0','0','0'),('743','Enlazar el título a la página','es','0','0','0'),('744','Proporcionar un enlace ''más...''','es','0','0','0'),('745','Número de elementos','es','0','0','0'),('746','Panel de contenido','es','0','0','0'),('747','Opciones de panel','es','0','0','0'),('748','Usar nombre de la vista','es','0','0','0'),('749','Descripción administrativa','es','0','0','0'),('750','Entrada de argumentos','es','0','0','0'),('751','Permitir ajustes','es','0','0','0'),('752','Desplazamiento del paginador','es','0','0','0'),('753','Los paneles de página se pueden usar como páginas de entrada. Tienen una ruta URL, aceptan argumentos y pueden tener entradas en los menús.','es','0','0','0'),('754','Panel de página','es','0','0','0'),('755','Ir a lista','es','0','0','0'),('756','Reglas de selección','es','0','0','0'),('757','Controlar los criterios para decidir si esta variante se usa o no.','es','0','0','0'),('758','Añadir objetos de contexto condicional que pueda usar el contenido a esta variante.','es','0','0','0'),('759','Este panel se seleccionará si @conditions.','es','0','0','0'),('760','Este panel estará siempre seleccionado.','es','0','0','0'),('761','Regla de selección','es','0','0','0'),('762','Panel: @title','es','0','0','0'),('763','Título administrativo de esta variante.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('764','Código de demostración, ayuda avanzada, y un panel de desmostración para mostrar cómo construir complementos de CTools.','es','0','0','0'),('765','El ejemplo de complemento de CTools es simplemente una demostración para desarrolladores de cómo crear complementos para CTools. No proporciona ninguna funcionalidad útil para usuarios normales.','es','0','0','0'),('766','Hay un panel de demostración que demuestra gran parte de la funcionalidad proporcionada en el\r\n   <a href="@demo_url">Panel de demostración CTools</a>, y se puede encontrar documentación de los ejemplos en\r\n   !ctools_plugin_example_help.\r\n   CTools por sí mismo proporciona documentación en !ctools_help. Principalmente, sin embargo, la intención es que el código por sí mismo sea el maestro.\r\n   Puede encontrarlo en %path.','es','0','0','0'),('767','Ejemplo de complemento de CTools','es','0','0','0'),('768','Ejemplo de complemento de Chaos Tools (CTools)','es','0','0','0'),('769','Muestra como un módulo externo puede proporcionar complementos de CTools (para Panels, etc.)','es','0','0','0'),('770','Longitud del argumento','es','0','0','0'),('771','Control de acceso según la longitud del argumento de contexto simple.','es','0','0','0'),('772','Conceder el acceso si la longitud del argumento de contexto simple es','es','0','0','0'),('773','Longitud del argumento de contexto simple','es','0','0','0'),('774','El acceso/visibilidad se concederá con base en la longitud del argumento.','es','0','0','0'),('775','El argumento de texto simple debe tener !comp @length caracteres','es','0','0','0'),('776','Ejemplo CTools: rol','es','0','0','0'),('777','@identifier debe tener el rol "@roles"','es','0','0','0'),('778','@identifier debe ser uno de estos "@roles"','es','777','1','0'),('779','Crea un "simplecontext" desde el argumento.','es','0','0','0'),('780','Introduzca el argumento simplecontext','es','0','0','0'),('781','CTools ejemplo sin ningún tipo de contenido contexto','es','0','0','0'),('782','No hay ningún tipo de contenido de contexto - no requiere ni utiliza ningún contexto.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('783','Ejemplos de CTools','es','0','0','0'),('784','El ajuste para el elemento 1.','es','0','0','0'),('785','La configuración para el elemento 2','es','0','0','0'),('786','Configurar elemento 1 (relcontext)','es','0','0','0'),('787','Ajuste para relcontext.','es','0','0','0'),('788','Ajuste relcontext','es','0','0','0'),('789','Solo un ejemplo de configuración.','es','0','0','0'),('790','Un ejemplo de configuración que podría ser utilizado para configurar un contexto','es','0','0','0'),('791','Lea la guía de inicio para más información.','es','0','0','0'),('792','Antes de que se pueda agregar esta variante, debe ser configurada. Cuando termine, haga clic en «Crear variante» al final de este asistente para agregarla a su página.','es','0','0','0'),('793','El módulo Page manager no puede activar node/%node/edit porque algún otro módulo lo ha sobrescrito con %callback.','es','0','0','0'),('794','El módulo Page manager no puede sobrescribir @path porque algún otro módulo lo ha sobrescrito con %callback. La edición de nodos será activada, pero la ruta de edición no será sobrescrita.','es','0','0','0'),('795','El módulo Page manager no puede activar node/%node porque algún otro módulo lo ha sobrescrito con %callback.','es','0','0','0'),('796','Las rutas con marcadores de posición no opcionales no pueden ser utilizadas como elementos normales de menú a menos que el manejador de argumentos seleccionado proporcione un argumento predeterminado para utilizar para el elemento del menú.','es','0','0','0'),('797','El módulo admiinistrador de páginas no es capaz de habilitar user/%user porque algún otro módulo ya ha sobreescrito con %callback.','es','0','0','0'),('798','Nodo existente','es','0','0','0'),('799','Escriba el título o NID de un nodo','es','0','0','0'),('800','Incluir enlance de nodo para «agregar comentario», «leer más», etc.','es','0','0','0'),('801','Identificador de la plantilla','es','0','0','0'),('802','Agregar el lema como contenido.','es','0','0','0'),('803','Añade las pestañas (tareas locales) cómo contenido.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('804','Añadir el título de la página como contenido.','es','0','0','0'),('805','Administrar páginas','es','0','0','0'),('806','Esta página está bloqueada por usted para la edición. Nadie más podrá editar esta página hasta que estos cambios se guarden o se cancelen.','es','0','0','0'),('807','Esta página está bloqueada para edición por otro usuario. No puede editar esta página sin romper el bloqueo.','es','0','0','0'),('808','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal para todos los blogs en <em>/blog</em>. Si no se selecciona ninguna variante, se mostrarán los envíos de blog más recientes predeterminados de Drupal.','es','0','0','0'),('809','El módulo Page manager no puede habilitar el blog porque algún otro módulo ya lo ha sobrescrito con %callback.','es','0','0','0'),('810','Blog de usuario','es','0','0','0'),('811','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal para mostrar blogs de usuarios en <em>/blog/%user</em>. Si no se selecciona ninguna variante, se utlizará el blog predeterminado de usuario de Drupal.','es','0','0','0'),('812','El módulo Page manager no puede habilitar blog/%user porque algún otro módulo ya lo ha sobrescrito con %callback.','es','0','0','0'),('813','Página de contacto del sitio','es','0','0','0'),('814','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal para la página de contacto del sitio en <em>/contact</em>. Si no se selecciona ninguna variante, se utilizará el formulario predeterminado de contacto de Drupal.','es','0','0','0'),('815','El módulo Page manager no puede activar el contacto porque algún otro módulo ya lo ha sobrescrito con %callback.','es','0','0','0'),('816','Contacto con el usuario','es','0','0','0'),('817','Cuando se activa, esto sobrescribe el comportamiento predeterminado de Drupal al mostrar el formulario de contacto de usuario en <em>user/%user/contact</em>. Si no se selecciona ninguna variante, se utilizará el formulario predeterminado de contacto de usuario de Drupal.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('818','El módulo Page manager no puede habilitar user/%user/contact porque algún otro módulo ya lo ha sobrescrito con %callback.','es','0','0','0'),('819','No se puede tener un marcador de posición sin nombre (% o ! por sí mismo). Por favor póngale nombre a su marcador de posición agregando un pequeño fragmento descriptivo de texto  al % o !, tal como %user o %node.','es','0','0','0'),('820','Todas las encuestas','es','0','0','0'),('821','Cuando se activa, esto sobreescribe el comportamiento predeterminado de Drupal para las encuestas en <em>/poll</em>. Si no se selecciona ninguna variante, se mostrará la vista predeterminada de Drupal para las encuestas más recientes.','es','0','0','0'),('822','El módulo Page manager no pudo habilitar la encuesta porque algún otro módulo ya sobrescribió con %callback.','es','0','0','0'),('823','Buscar @type','es','0','0','0'),('824','Taxonomía: término','es','0','0','0'),('825','Control de acceso por un término específico.','es','0','0','0'),('826','Seleccione uno o varios términos de @vocabulary.','es','0','0','0'),('827','@term puede ser el término «@terms»','es','0','0','0'),('828','@term puede ser uno de estos términos: @terms','es','827','1','0'),('829','Formulario de adición de nodo: tipo de nodo','es','0','0','0'),('830','Formulario de edición de nodo: ID del nodo','es','0','0','0'),('831','Obtener todos los argumentos después de éste','es','0','0','0'),('832','Si se marca, esta cadena incluirá todos los argumentos. Por ejemplo, si la ruta es «path/%» y el usuario visita «path/foo/bar», si no se marca esta casilla, la cadena será «foo». Si sí se marca, la cadena será «foo/bar».','es','0','0','0'),('833','Término de taxonomía: ID','es','0','0','0'),('834','Término de taxonomía (múltiple): ID','es','0','0','0'),('835','Usuario: nombre','es','0','0','0'),('836','Crea un contexto de usuario a partir de un nombre de usuario.','es','0','0','0'),('837','Escriba un nombre de usuario para este argumento','es','0','0','0'),('838','Vocabulario: ID','es','0','0','0');
INSERT INTO `locales_target` VALUES ('839','El formulario de contacto del sitio que permite a los usuarios enviar un mensaje a los administradores del sitio.','es','0','0','0'),('840','El formulario de contacto del sitio que permite a los usuarios contactar a otros usuarios.','es','0','0','0'),('841','Contactar con @name','es','0','0','0'),('842','Personalizado: @title','es','0','0','0'),('843','Este título se utilizará administrativamente para identificar este panel. Si lo deja en blanco se utilizará el título normal.','es','0','0','0'),('844','Formulario de búsqueda avanzada','es','0','0','0'),('845','Un formulario de búsqueda con opciones avanzadas.','es','0','0','0'),('846','La misma página','es','0','0','0'),('847','Formulario de búsqueda @type','es','0','0','0'),('848','Sobreescribir el texto de "sin resultados"','es','0','0','0'),('849','Resultado de la búsqueda @type','es','0','0','0'),('850','Cadena con HTML seguro','es','0','0','0'),('851','Ajustes del paginador personalizado','es','0','0','0'),('852','Usar opciones de paginador diferentes de las establecidas en la vista','es','0','0','0'),('853','El número de elementos que se omiten y no se muestran.','es','0','0','0'),('854','Seleccione ésto para enviar todos los argumentos desde el panel directamente a la vista. Si está marcado, los argumentos del panel se considerarán después de los argumentos de contexto anteriores y antes de cualquier argumento adicional pasado a través del campo Argumentos a continuación. Nótese que los argumentos no incluyen la URL base; sólo los valores después de la URL ó establecidos como reemplazos se consideran argumentos.','es','0','0','0'),('855','Los argumentos adicionales para enviar a la vista tal como son parte de la URL en la forma arg1/arg2/arg3. Puede usar %0, %1, ..., %N para especificar argumentos de la URL. O utilizar @0, @1, @2, ..., @N para usar argumentos pasados al panel. Nota: use estos valores sólo como última opción. En futuras versiones de Panels pueden eliminarse.','es','0','0','0'),('856','El contexto es opcional','es','0','0','0');
INSERT INTO `locales_target` VALUES ('857','estilos','es','0','0','0'),('858','Grosor','es','0','0','0'),('859','Extrafina','es','0','0','0'),('860','Supernegra','es','0','0','0'),('861','Se ha buscado en %type para %keys.','es','0','0','0'),('862','No se ha podido completar la operación. Error fatal en @file en la línea @line: @message','es','0','0','0'),('863','No hay contexto real','es','0','0','0'),('864','- Elegir -','es','0','0','0'),('865','Actualizar y guardar','es','0','0','0'),('866','La página se ha actualizado y guardado.','es','0','0','0'),('867','Actualmente no hay variantes disponibles y no se puede agregar una página. ¿Tal vez usted necesite instalar el módulo Panels para obtener una variante?','es','0','0','0'),('868','Para establecer este panel como su página de inicio, debe  crear un nombre de ruta único, sin variables % en la ruta. La página principal del sitio es actualmente %homepage, según el formulario de configuración !siteinfo.','es','0','0','0'),('869','Esta página está configurada actualmente como página principal de su sitio. Esto puede ser modificado en el formulario de configuración !siteinfo.','es','0','0','0'),('870','Esta ruta ya está en uso. El sistema no puede sobrescribir rutas existentes.','es','0','0','0'),('871','El contexto existe','es','0','0','0'),('872','Verificar si existe el contexto (contiene datos) o no existe (no contiene datos). Por ejemplo, si un contexto es opcional y la ruta no contiene un argumento para ese contexto, no existirá.','es','0','0','0'),('873','No existe','es','0','0','0'),('874','@identifier existe','es','0','0','0'),('875','@identifier no existe','es','0','0','0'),('876','Cadena: comparación','es','0','0','0'),('877','Control de acceso por comparación de cadenas.','es','0','0','0'),('878','No es igual a la expresión regular','es','0','0','0'),('879','Si se usa una expresion regular, se debería encerrar el patrón en barras inclinadas como: <em>/foo/</em>. Si necesita comparar contra barras inclinadas, que puede utilizar otro caracter para encerrar el patrón, como @. Ver la <a href="http://www.php.net/manual/en/reference.pcre.pattern.syntax.php">documentación de expresiones regulares de PHP</a> para más información.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('880','@identifier es "@value"','es','0','0','0'),('881','@identifier no es "@value"','es','0','0','0'),('882','@identifier coincide con "@value"','es','0','0','0'),('883','el @identifier no concuerda con "@valor"','es','0','0','0'),('884','Cadena: longitud','es','0','0','0'),('885','Control de acesso por longitud del contexto de cadena.','es','0','0','0'),('886','No es igual a','es','0','0','0'),('887','Longitud de la cadena','es','0','0','0'),('888','El acceso/visibilidad será concedido con base en la longitud del contexto de cadena.','es','0','0','0'),('889','@identifier debe tener @comp @leng caracteres','es','0','0','0'),('890','Un contexto que contiene comodines reemplazantes del módulo Comodín (token.module).','es','0','0','0'),('891','Especifique el tipo de contexto','es','0','0','0'),('892','Especifique un nombre de usuario','es','0','0','0'),('893','Restablecer el nombre de usuario como identificador','es','0','0','0'),('894','El usuario seleccionado no es válido','es','0','0','0'),('895','Puede utilizar sustituciones en esta ruta.','es','0','0','0'),('896','Requerimientos PHP de CTools','es','0','0','0'),('897','PHP !version','es','0','0','0'),('898','No se puede crear un directorio de caché de estilos de CTools @path. Revise los permisos en su directorio de archivos.','es','0','0','0'),('899','Seleccionar el estilo base','es','0','0','0'),('900','Caché de opciones ausente.','es','0','0','0'),('901','Arial, Helvetica, sans-serif','es','0','0','0'),('902','Times New Roman, Times, serif','es','0','0','0'),('903','Courier New, Courier, monospace','es','0','0','0'),('904','Georgia, Times New Roman, Times, serif','es','0','0','0'),('905','Verdana, Arial, Helvetica, sans-serif','es','0','0','0'),('906','Geneva, Arial, Helvetica, sans-serif','es','0','0','0'),('907','Trebuchet MS, Trebuchet, Verdana, sans-serif','es','0','0','0'),('908','Extra pequeña','es','0','0','0'),('909','Muy pequeña','es','0','0','0');
INSERT INTO `locales_target` VALUES ('910','Muy grande','es','0','0','0'),('911','Extra grande','es','0','0','0'),('912','Espacio entre caracteres','es','0','0','0'),('913','Espacio entre palabras','es','0','0','0'),('914','Decoración','es','0','0','0'),('915','Tachado','es','0','0','0'),('916','Oblicua','es','0','0','0'),('917','Versalitas','es','0','0','0'),('918','Poner la primera letra en mayúscula','es','0','0','0'),('919','Usted no tiene suficientes permisos para realizar esta acción.','es','0','0','0'),('920','Los permisos de su cuenta no le permiten importar.','es','0','0','0'),('921','Texto: Ruta de la URL','es','0','0','0'),('922','Controlar el acceso a través de la ruta actual.','es','0','0','0'),('923','Nota: Si no se elige contexto, se usará la ruta de la página actual.','es','0','0','0'),('924','Permitir el acceso en las siguientes páginas','es','0','0','0'),('925','Permitir el acceso en todas las páginas excepto en las siguientes','es','0','0','0'),('926','Ruta de acceso actual','es','0','0','0'),('927','@identifier es "@paths"','es','0','0','0'),('928','@identifier es uno de "@paths"','es','927','1','0'),('929','@identifier no es «@paths»','es','0','0','0'),('930','@identifier el tipo no es uno de «@paths»','es','929','1','0'),('931','taxonomia: término padre','es','0','0','0'),('932','Control de acceso por la existencia de un término padre.','es','0','0','0'),('933','Seleccione el vocabulario para este formulario. Si existe un término padre en ese vocabulario, esta verificación de acceso tendrá éxito.','es','0','0','0'),('934','«@term» tiene padres en el vocabulario «@vocab»','es','0','0','0'),('935','Control de acceso por vocabulario.','es','0','0','0'),('936','Sólo los vocabularios marcados serán válidos.','es','0','0','0'),('937','Tema actual','es','0','0','0'),('938','Controlar el acceso comprobando qué tema está en uso.','es','0','0','0'),('939','Sólo se accederá a esto si el tema actual es el tema seleccionado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('940','Error, desconfigurar tema','es','0','0','0'),('941','El tema actual es "@theme"','es','0','0','0'),('942','Nodo sin publicar @nid','es','0','0','0'),('943','Hijos del libro','es','0','0','0'),('944','Hijos del libro "@s"','es','0','0','0'),('945','Términos de nodo','es','0','0','0'),('946','- Todo los vocabularios -','es','0','0','0'),('947','En línea, delimitado','es','0','0','0'),('948','Enlazar con los términos','es','0','0','0'),('949','Delimitador de término','es','0','0','0'),('950','Iconos de canal de noticias','es','0','0','0'),('951','Logo del sitio','es','0','0','0'),('952','Enlaces de navegación primaria','es','0','0','0'),('953','Enlaces de navegación secundaria','es','0','0','0'),('954','Descripción del término','es','0','0','0'),('955','Concatenador','es','0','0','0'),('956','Estilizador','es','0','0','0'),('957','Acción local','es','0','0','0'),('958','Conjunto de reglas personalizado','es','0','0','0'),('959','Los conjuntos de reglas personalizadas son combinaciones de complementos de acceso, que se pueden utilizar para control de acceso, criterios de selección y visibilidad de paneles.','es','0','0','0'),('960','No hay conjuntos de reglas personalizados.','es','0','0','0'),('961','Administrar los conjuntos de reglas personalizados','es','0','0','0'),('962','Conjuntos de reglas personalizadas','es','0','0','0'),('963','conjunto de reglas','es','0','0','0'),('964','Conjunto de reglas','es','0','0','0'),('965','conjuntos de reglas','es','0','0','0'),('966','Conjuntos de reglas','es','0','0','0'),('967','Contenido personalizado','es','0','0','0'),('968','Los paneles de contenido personalizado son HTML básico que usted escribe y que puede ser reutilizado en todos sus paneles.','es','0','0','0'),('969','No hay paneles de contenido personalizado.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('970','Gestionar el contenido personalizado','es','0','0','0'),('971','Paneles de contenido personalizado','es','0','0','0'),('972','Crear paneles personalizados, exportables y reutilizables para aplicaciones como Panels.','es','0','0','0'),('973','En cuál categoría debería aparecer este contenido. Si se deja en blanco, la categoria será «Misceláneo».','es','0','0','0'),('974','panel de contenido','es','0','0','0'),('975','paneles de contenido','es','0','0','0'),('976','Paneles de contenido','es','0','0','0'),('977','@type no será mostrado debido a la falta de contexto','es','0','0','0'),('978','Inverso (NEGACIÓN)','es','0','0','0'),('979','A la definición de complemento de @plugin le falta la clave %key.','es','0','0','0'),('980','La definición de complemento de @plugin no puede encontrar el esquema %schema.','es','0','0','0'),('981','La definición de complemento de @plugin usa %schema, pero no tiene sección de exportación.','es','0','0','0'),('982','Agregar un nuevo @plugin','es','0','0','0'),('983','Editar %title de  %plugin','es','0','0','0'),('984','Clonar @plugin %title','es','0','0','0'),('985','Importar @plugin','es','0','0','0'),('986','Exportar @plugin %title','es','0','0','0'),('987','¿Está seguro de que quiere revertir %title?','es','0','0','0'),('988','Esta acción eliminará de forma permanente cualquier personalización que se haya hecho a este elemento.','es','0','0','0'),('989','El elemento se ha revertido.','es','0','0','0'),('990','Esta acción eliminará el elemento de su base de datos de forma permanente.','es','0','0','0'),('991','%title ha sido creado.','es','0','0','0'),('992','%title no pudo ser creado.','es','0','0','0'),('993','%title ha sido actualizado.','es','0','0','0'),('994','%title no pudo ser actualizado.','es','0','0','0'),('995','Puede importar una definición exportada pegando en el campo siguiente el código de objeto exportado.','es','0','0','0'),('996','Se activo @plugin %title','es','0','0','0'),('997','@plugin %title ha sido deshabilitado.','es','0','0','0'),('998','Error en la configuración. No se encontró ningún manejador.','es','0','0','0');
INSERT INTO `locales_target` VALUES ('999','No se encontró ningún elemento.','es','0','0','0'),('1000','A la definición de exportación de la @table le falta la propiedad de «clave primaria».','es','0','0','0'),('1001','Configurar estilo','es','0','0','0'),('1002','Limitar a estos vocabularios','es','0','0','0'),('1003','Si no se marca ningún vocabulario, se aceptarán términos de todos los vocabularios.','es','0','0','0'),('1004','Contenido ausente/eliminado','es','0','0','0'),('1005','Hacer una copia de esta página','es','0','0','0'),('1006','El nombre de sistema de este contenido. Debe ser único, y debe contener solo caracteres alfanuméricos y guiones bajos. ¡Una vez creado, no será capaz de cambiar este valor!','es','0','0','0'),('1007','Una descripción de lo que es este contenido, lo que hace o para qué se usa; para uso administrativo.','es','0','0','0'),('1008','El nombre sólo puede consistir de letras minúsculas, guiones y números.','es','0','0','0'),('1009','Ya existe contenido con este nombre. Por favor elija otro nombre o elimine el elemento existente antes de crear uno nuevo.','es','0','0','0'),('1010','Vincular el título del nodo con el nodo','es','0','0','0'),('1011','Seleccione un modo de construcción para este nodo.','es','0','0','0'),('1012','Mostrar los enlaces para registrarse o iniciar sesion.','es','0','0','0'),('1013','Si no se permiten comentarios anónimos, esto mostrará los  enlaces de registro e inicio de sesión.','es','0','0','0'),('1014','- Sin etiqueta -','es','0','0','0'),('1015','div','es','0','0','0'),('1016','Clase CSS para usar','es','0','0','0'),('1017','Activado, nombre','es','0','0','0'),('1018','Tiene cambios sin guardar. Estos cambios no serán permanentes hasta que haga clic en <em>Guardar</em>.','es','0','0','0'),('1019','Ésto aparecerá en la interfaz de administración para identificarlo fácilmente.','es','0','0','0'),('1020','No hay estilos personalizados.','es','0','0','0'),('1021','Administrar estilos','es','0','0','0'),('1022','Crear estilos personalizados para aplicaciones tales como los paneles.','es','0','0','0');
