DROP TABLE IF EXISTS `tracker_user`;
CREATE TABLE `tracker_user` (   `nid` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The node.nid this record tracks.',   `uid` int(11) NOT NULL DEFAULT '0' COMMENT 'The users.uid of the node author or commenter.',   `published` tinyint(4) DEFAULT '0' COMMENT 'Boolean indicating whether the node is published.',   `changed` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'The Unix timestamp when the node was most recently saved or commented on.',   PRIMARY KEY (`nid`,`uid`),   KEY `tracker` (`uid`,`published`,`changed`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='Tracks when nodes were last changed or commented on, for...';
