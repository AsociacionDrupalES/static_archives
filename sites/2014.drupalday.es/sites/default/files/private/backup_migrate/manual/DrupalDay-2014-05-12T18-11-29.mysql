INSERT INTO `locales_source` VALUES ('11875','/admin/config/workflow/rules/components','default','Components are stand-alone sets of Rules configuration that can be used by Rules and other modules on your site. Components are for example useful if you want to use the same conditions, actions or rules in multiple places, or call them from your custom module. You may also export each component separately. See <a href="@url2">the online documentation</a> for more information about how to use components.','','7.12'),('11876','/admin/config/workflow/rules/components','default','Filter by plugin','','7.12'),('11877','/admin/config/workflow/rules/components','default','There are no rule components.','','7.12'),('11878','/admin/structure/types/manage/productos-vp/display','default','Quantity widget: !status','','7.12'),('11879','/admin/structure/types/manage/productos-vp/display','default','Default quantity: @quantity','','7.12'),('11880','/admin/structure/types/manage/productos-vp/display','default','Combine like items: !status','','7.12'),('11881','/admin/structure/types/manage/productos-vp/display','default','The visibility of this field may also need to be toggled in the <a href="!url">product display configuration</a>.','','7.12'),('11882','/admin/structure/types/manage/productos-vp/display','default','Modify the settings for this field on the <a href="!url">product display configuration</a>.','','7.12'),('11883','','default','Upload a Backup File','','7.12'),('11884','','default','Upload a backup file created by this version of this module. For other database backups please use another tool for import. Max file size: %size','','7.12'),('11885','','default','Restoring will delete some or all of your data and cannot be undone. <strong>Always test your backups on a non-production server!</strong>','','7.12'),('11886','','default','Take site offline','','7.12'),('11887','','default','Take the site offline during restore and show a maintenance message. Site will be taken back online once the restore is complete.','','7.12'),('11888','','default','Site off-line message','','7.12');
INSERT INTO `locales_source` VALUES ('11889','','default','Message to show visitors when the site is in off-line mode.','','7.12'),('11890','','default','Advanced Options','','7.12'),('11891','','default','Restore now','','7.12'),('11892','','default','<p>Or you can restore one of the files in your <a href="!url">saved backup destinations.</a></p>','','7.12'),('11893','/admin/commerce/config/order/fields','default','Datos de usuario','','7.12'),('11894','/checkout/18/review','default','Customer returned to the previous checkout page via a submit button.','','7.12'),('11895','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=admin/commerce/config/order/fields%3Frender%3Doverlay&render=overlay','default','Override the input format selected above. Define a php date format string like ''m-d-Y H:i'' (see <a href="@link">http://php.net/date</a> for more details).','','7.12'),('11896','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=admin/commerce/config/order/fields%3Frender%3Doverlay&render=overlay','default','The location of date part labels, like ''Year'', ''Month'', or ''Day'' . ''Above'' displays the label as titles above each date part. ''Within'' inserts the label as the first option in the select list and in blank textfields. ''None'' doesn''t label any of the date parts. Theme functions like ''date_part_label_year'' and ''date_part_label_month'' control label text.','','7.12'),('11897','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=admin/commerce/config/order/fields%3Frender%3Doverlay&render=overlay','default','Cache dates','','7.12'),('11898','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=admin/commerce/config/order/fields%3Frender%3Doverlay&render=overlay','default','Date objects can be created and cached as date fields are loaded rather than when they are displayed to improve performance.','','7.12'),('11899','/admin/commerce/config/order/fields/field_hora/edit?destinations[0]=ad