INSERT INTO `locales_source` VALUES ('351','','default','Ignore it; content that requires this context will not be available.','','none'),('352','','default','If the argument is missing or is not valid, select how this should behave.','','none'),('353','','default','Argument @count','','none'),('354','','default','Context @count','','none'),('355','','default','Configure !subtype_title','','none'),('356','','default','Panel settings','','none'),('357','','default','Unknown context','','none'),('358','','default','No context','','none'),('359','','default','You may use %keywords from contexts, as well as %title to contain the original title.','','none'),('360','','default','Context %count','','none'),('361','','default','Module name','','none'),('362','','default','Enter the module name to export code to.','','none'),('363','','default','Local','','none'),('364','','default','Panel','','none'),('365','','default','Add a node from your site as content.','','7.12'),('366','','default','To use a NID from the URL, you may use %0, %1, ..., %N to get URL arguments. Or use @0, @1, @2, ..., @N to use arguments passed into the panel.','','none'),('367','','default','Leave node title','','none'),('368','','default','Advanced: if checked, do not touch the node title; this can cause the node title to appear twice unless your theme is aware of this.','','none'),('369','','default','Invalid node','','none'),('370','','default','Node loaded from @var','','none'),('371','','default','Deleted/missing node @nid','','none'),('372','','default','Path is required.','','none'),('373','','default','Argument wildcard','','none'),('374','','default','No argument','','none'),('375','','default','From context','','none'),('376','','default','From panel argument','','none'),('377','','default','Required context','','none'),('378','','default','Panel argument','','none'),('379','','default','Sixth','','none'),('380','','default','Fixed argument','','none');
