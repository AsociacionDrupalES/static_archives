INSERT INTO `locales_source` VALUES ('10797','/admin/modules/list/confirm','default','Fetched account','','7.12'),('10798','/admin/modules/list/confirm','default','Create a new account for an anonymous order','','7.12'),('10799','','default','Created account','','7.12'),('10800','/admin/modules/list/confirm','default','Send an order notification e-mail','','7.12'),('10801','/admin/modules/list/confirm','default','Order [commerce-order:order-number] at [site:name]','','7.12'),('10802','/admin/modules/list/confirm','default','Thanks for your order [commerce-order:order-number] at [site:name].\n\nIf this is your first order with us, you will receive a separate e-mail with login instructions. You can view your order history with us at any time by logging into our website at:\n\n[site:login-url]\n\nYou can find the status of your current order at:\n\n[commerce-order:customer-url]\n\nPlease contact us if you have any questions about your order.','','7.12'),('10803','','default','Payment settings','','7.12'),('10804','','default','price','','7.12'),('10805','/admin/modules/list/confirm','default','Order is a shopping cart','','7.12'),('10806','','default','Commerce Cart','','7.12'),('10807','/admin/modules/list/confirm','default','Entity exists by property','','7.12'),('10808','/admin/modules/list/confirm','default','Order address component comparison','','7.12'),('10809','/admin/modules/list/confirm','default','The order containing the profile reference with the address in question.','','7.12'),('10810','/admin/modules/list/confirm','default','The address associated with this order whose component you want to compare.','','7.12'),('10811','/admin/modules/list/confirm','default','Address component','','7.12'),('10812','/admin/modules/list/confirm','default','The actual address component you want to compare. Common names of address components are given in parentheses.','','7.12'),('10813','/admin/modules/list/confirm','default','The value to compare against the address component. Bear in mind that addresses using select lists for various components may use a value different from the option you select. For example, countries are selected by name, but the value is the two letter abbreviation.','','7.12');
INSERT INTO `locales_source` VALUES ('10814','/admin/modules/list/confirm','default','Order contains a particular product','','7.12'),('10815','/admin/modules/list/confirm','default','The order whose line items should be checked for the specified product. If the specified order does not exist, the comparison will act as if it is against a quantity of 0.','','7.12'),('10816','/admin/modules/list/confirm','default','The SKU of the product to look for on the order.','','7.12'),('10817','/admin/modules/list/confirm','default','The operator used with the quantity value below to compare the quantity of the specified product on the order.','','7.12'),('10818','/admin/modules/list/confirm','default','The value to compare against the quantity of the specified product on the order.','','7.12'),('10819','/admin/modules/list/confirm','default','Total product quantity comparison','','7.12'),('10820','/admin/modules/list/confirm','default','The order whose product line item quantities should be totalled. If the specified order does not exist, the comparison will act as if it is against a quantity of 0.','','7.12'),('10821','/admin/modules/list/confirm','default','The comparison operator to use against the total number of products on the order.','','7.12'),('10822','/admin/modules/list/confirm','default','The value to compare against the total quantity of products on the order.','','7.12'),('10823','/admin/modules/list/confirm','default','Order balance comparison','','7.12'),('10824','/admin/modules/list/confirm','default','The order whose balance should be compared (calculated as the order total minus completed payment amounts).','','7.12'),('10825','/admin/modules/list/confirm','default','The value to compare against the order balance. An order balance less than or equal to 0 indicates the order has been paid in full.','','7.12'),('10826','/admin/modules/list/confirm','default','Commerce Payment','','7.12'),('10827','/admin/modules/list/confirm','default','Selected payment method comparison','','7.12'),('10828','/admin/modules/list/confirm','default','The order whose selected payment method (if any) should be compared against the method specified below.','','7.12');
INSERT INTO `locales_source` VALUES ('10829','/admin/modules/list/confirm','default','This condition will perform a simple equivalency check to see if the payment method you specify matches what a customer selected on the checkout form.','','7.12'),('10830','/admin/modules/list/confirm','default','Remove all products from an order','','7.12'),('10831','/admin/modules/list/confirm','default','Order to empty','','7.12'),('10832','/admin/modules/list/confirm','default','Display a translatable Add to Cart message','','7.12'),('10833','/admin/modules/list/confirm','default','Product added to the cart','','7.12'),('10834','/admin/modules/list/confirm','default','Add a product to the cart','','7.12'),('10835','/admin/modules/list/confirm','default','Specify the user whose shopping cart order the product will be added to, typically <em>site:current-user</em>.','','7.12'),('10836','/admin/modules/list/confirm','default','The SKU of the product to add to the cart.','','7.12'),('10837','/admin/modules/list/confirm','default','Combine similar items in the cart','','7.12'),('10838','/admin/modules/list/confirm','default','If checked, the product will be combined added to an existing similar product line item in the cart by incrementing its quantity.','','7.12'),('10839','/admin/modules/list/confirm','default','Added product line item','','7.12'),('10840','/admin/modules/list/confirm','default','Send account e-mail','','7.12'),('10841','','default','E-mail type','','7.12'),('10842','/admin/modules/list/confirm','default','Select the e-mail based on your site''s account settings to send to the user.','','7.12'),('10843','/admin/modules/list/confirm','default','Complete checkout for an order','','7.12'),('10844','','default','Order in checkout','','7.12'),('10845','/admin/modules/list/confirm','default','Commerce Checkout','','7.12'),('10846','/admin/modules/list/confirm','default','Add an amount to the unit price','','7.12'),('10847','/admin/modules/list/confirm','default','Specify a numeric amount to add to the unit price.','','7.12'),('10848','/admin/modules/list/confirm','default','Subtract an amount from the unit price','','7.12');
INSERT INTO `locales_source` VALUES ('10849','/admin/modules/list/confirm','default','Specify a numeric amount to subtract from the price.','','7.12'),('10850','/admin/modules/list/confirm','default','Multiply the unit price by some amount','','7.12'),('10851','/admin/modules/list/confirm','default','Specify the numeric amount by which to multiply the price.','','7.12'),('10852','/admin/modules/list/confirm','default','Divide the unit price by some amount','','7.12'),('10853','/admin/modules/list/confirm','default','Specify a numeric amount by which to divide the price.','','7.12'),('10854','/admin/modules/list/confirm','default','Set the unit price to a specific amount','','7.12'),('10855','/admin/modules/list/confirm','default','Specify the numeric amount to set the price to.','','7.12'),('10856','/admin/modules/list/confirm','default','Price component type','','7.12'),('10857','/admin/modules/list/confirm','default','Price components track changes to prices made during the price calculation process, and they are carried over from the unit price to the total price of a line item. When an order total is calculated, it combines all the components of every line item on the order. When the unit price is altered by this action, the selected type of price component will be added to its data array and reflected in the order total display when it is formatted with components showing. Defaults to base price, which displays as the order Subtotal.','','7.12'),('10858','/admin/modules/list/confirm','default','Price rounding mode','','7.12'),('10859','/admin/modules/list/confirm','default','Round the resulting price amount after performing this operation.','','7.12'),('10860','/admin/modules/list/confirm','default','Set the unit price''s currency code','','7.12'),('10861','/admin/modules/list/confirm','default','Convert the unit price to a different currency','','7.12'),('10862','','default','Update the order state','','7.12'),('10863','/admin/modules/list/confirm','default','