INSERT INTO `locales_source` VALUES ('3751','','default','In your %settings_file file you have configured @drupal to use a %driver server, however your PHP installation currently does not support this database type.','','none'),('3752','','default','Sorry, you must select a language to continue the installation.','','none'),('3753','','default','We were unable to find any installation profiles. Installation profiles tell us what modules to enable and what schema to install in the database. A profile is necessary to continue with the installation process.','','none'),('3754','','default','Sorry, the profile you have chosen cannot be loaded.','','none'),('3755','','default','All necessary changes to %dir and %file have been made, so you should remove write permissions to them now in order to avoid security risks. If you are unsure how to do so, consult the <a href="@handbook_url">online handbook</a>.','','none'),('3756','','default','Congratulations, you installed @drupal!','','none'),('3757','','default','Review the messages above before visiting <a href="@url">your new site</a>.','','none'),('3758','','default','<a href="@url">Visit your new site</a>.','','none'),('3759','','default','Settings file','','none'),('3760','','default','The settings file does not exist.','','none'),('3761','','default','The @drupal installer requires that you create a settings file as part of the installation process. Copy the %default_file file to %file. More details about installing Drupal are available in <a href="@install_txt">INSTALL.txt</a>.','','none'),('3762','','default','The %file file exists.','','none'),('3763','','default','The settings file is not writable.','','none'),('3764','','default','The @drupal installer requires write permissions to %file during the installation process. If you are unsure how to grant file permissions, consult the <a href="@handbook_url">online handbook</a>.','','none'),('3765','','default','Automated e-mails, such as registration information, will be sent from this address. Use an address ending in your site''s domain to help prevent these e-mails from being flagged as spam.','','none');
INSERT INTO `locales_source` VALUES ('3766','','default','Site maintenance account','','none'),('3767','','default','Select the default country for the site.','','none'),('3768','','default','Receive e-mail notifications','','none'),('3769','','default','The system will notify you when updates and important security releases are available for installed components. Anonymous information about your site is sent to <a href="@drupal">Drupal.org</a>.','','none'),('3770','','default','No pending updates.','','7.12'),('3771','','default','1 pending update','','none'),('3772','','default','@count pending updates','','7.12'),('3773','','default','An error occurred while handling the request: The server received invalid input.','','none'),('3774','','default','Invalid form POST data.','','none'),('3775','','default','Unable to continue, no available methods of file transfer','','none'),('3776','','default','WARNING: You are not using an encrypted connection, so your password will be sent in plain text. <a href="@https-link">Learn more</a>.','','none'),('3777','','default','To continue, provide your server connection details','','none'),('3778','','default','Connection method','','none'),('3779','','default','Enter connection settings','','none'),('3780','','default','@backend connection settings','','none'),('3781','','default','Change connection type','','none'),('3782','','default','Error, this type of connection protocol (%backend) does not exist.','','none'),('3783','','default','No active batch.','','7.12'),('3784','','default','Site under maintenance','','7.12'),('3785','','default','Archivers can only operate on local files: %file not supported','','none'),('3786','','default','The file could not be uploaded, because the destination %destination is invalid.','','none'),('3787','','default','The file %source could not be uploaded because a file by that name already exists in the destination %directory.','','none'),('3788','','default','The file''s name exceeds the 240 c