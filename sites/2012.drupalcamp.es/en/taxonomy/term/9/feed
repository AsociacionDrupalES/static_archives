&lt;ul class=&quot;field-session-audience inline&quot;&gt;

      &lt;li&gt;
      &lt;a href=&quot;/en/audience/developers&quot; typeof=&quot;skos:Concept&quot; property=&quot;rdfs:label skos:prefLabel&quot;&gt;Developers&lt;/a&gt;    &lt;/li&gt;
