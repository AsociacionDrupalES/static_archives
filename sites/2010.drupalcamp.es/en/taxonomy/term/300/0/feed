<item>
 <title>Construyendo una red social con Drupal</title>
 <link>http://2010.drupalcamp.es/en/sessions/construyendo-una-red-social-con-drupal</link>
 <description>&lt;fieldset class=&quot;fieldgroup group-session-logistics&quot;&gt;&lt;legend&gt;Logística&lt;/legend&gt;&lt;div class=&quot;field field-type-text field-field-session-day&quot;&gt;
