            &lt;div class=&quot;field-item odd&quot;&gt;
                    &lt;div class=&quot;filefield-file clear-block&quot;&gt;&lt;div class=&quot;filefield-icon field-icon-application-pdf&quot;&gt;&lt;img class=&quot;field-icon-application-pdf&quot;  alt=&quot;application/pdf icon&quot; src=&quot;http://2010.drupalcamp.es/sites/all/modules/filefield/icons/protocons/16x16/mimetypes/application-pdf.png&quot; /&gt;&lt;/div&gt;&lt;a href=&quot;http://2010.drupalcamp.es/sites/drupalcamp.es/files/Drupalcamp.pdf&quot; type=&quot;application/pdf; length=1614403&quot;&gt;Drupalcamp.pdf&lt;/a&gt;&lt;/div&gt;        &lt;/div&gt;
