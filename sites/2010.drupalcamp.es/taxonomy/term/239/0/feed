        &lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;field field-type-text field-field-session-time&quot;&gt;
    &lt;div class=&quot;field-items&quot;&gt;
            &lt;div class=&quot;field-item odd&quot;&gt;
