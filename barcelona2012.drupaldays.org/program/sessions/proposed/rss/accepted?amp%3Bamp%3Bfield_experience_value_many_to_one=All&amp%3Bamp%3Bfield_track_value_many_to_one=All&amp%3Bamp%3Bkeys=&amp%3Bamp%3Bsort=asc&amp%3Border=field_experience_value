    <title>Drupal 8&#039;s Multilingual Wonderland</title>
    <link>https://barcelona2012.drupaldays.org/sessions/drupal-8s-multilingual-wonderland</link>
    <description>&lt;div class=&quot;field field-type-userreference field-field-speakers&quot;&gt;
